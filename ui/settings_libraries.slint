import { Theme } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";
import { ScrollView, ComboBox } from "std-widgets.slint";

export struct LibraryRow {
    id: string,
    path: string,
    section: string,
    last-scan: string,
    item-count: int,
    size-pretty: string,
    cadence: string,
    // For music rows: the human label of the assigned music section
    // (My Music / Podcasts / Audiobooks / Radio / YouTube). "" elsewhere.
    music-section: string,
}

component Btn inherits Skin {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> primary: false;
    callback clicked();
    height: 30px;
    border-radius: Surface.rr(8px, self.width, self.height);
    background: touch.has-hover
        ? (danger ? #b91c1c : (primary ? #6d28d9 : Theme.panel-2))
        : (danger ? #7f1d1d : (primary ? Theme.brand : Theme.panel));
    border-color: danger ? #b91c1c : Theme.outline;
    border-width: 1px;
    horizontal-stretch: 0;
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        Text {
            text: label;
            color: (primary || danger) ? #ffffff : Theme.text;
            font-size: 11px; font-weight: 600;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}

component RowItem inherits Skin {
    in property <LibraryRow> data;
    callback rescan();
    callback rethumb();
    callback edit-exclude();
    callback remove-lib();
    callback save-section(string); // music rows: persist the chosen section
    height: 80px;
    border-radius: Theme.radius-md;
    background: Surface.body(Theme.panel-2);
    border-color: Surface.hairline;
    border-width: 1px;

    HorizontalLayout {
        padding: 14px; spacing: 10px; alignment: stretch;
        VerticalLayout {
            alignment: center; spacing: 3px;
            horizontal-stretch: 1;
            Text { text: data.path; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
            Text {
                text: data.section + " · " + data.item-count + " items · last scan " + data.last-scan + " · " + data.cadence;
                color: Theme.text-dim; font-size: 11px; overflow: elide;
            }
        }
        // Music rows get a 5-section selector + Save so a folder can be routed
        // to one of the 5 music sections from Settings (np.p5.atmusic.folder-sections).
        if data.section == "music": VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 6px;
                sec-cb := ComboBox {
                    width: 124px; height: 30px;
                    model: ["My Music", "Podcasts", "Audiobooks", "Radio", "YouTube"];
                    current-value: data.music-section == "" ? "My Music" : data.music-section;
                }
                Btn { label: "Save"; primary: true; width: 56px; clicked => { root.save-section(sec-cb.current-value); } }
            }
        }
        VerticalLayout { alignment: center; Btn { label: "Rescan";     clicked => { root.rescan(); } } }
        VerticalLayout { alignment: center; Btn { label: "Thumbnails"; clicked => { root.rethumb(); } } }
        VerticalLayout { alignment: center; Btn { label: "Exclusions"; clicked => { root.edit-exclude(); } } }
        VerticalLayout { alignment: center; Btn { label: "Remove";     danger: true; clicked => { root.remove-lib(); } } }
    }
}

export component SettingsLibraries inherits Rectangle {
    in property <[LibraryRow]> rows;
    // Maintenance progress driven from Rust: busy-task is the human label of
    // the running op ("" = idle); busy-frac is 0..1 (negative = indeterminate).
    in property <string> busy-task;
    in property <float> busy-frac;
    // In-app confirmation for the destructive full reset (native rfd dialogs
    // don't render on some Linux WMs, so the confirm lives in-app).
    property <bool> reset-confirm-open: false;
    callback add-location();
    callback rescan-all();
    callback clear-thumb-cache();
    callback rebuild-fts();
    callback reset-app();
    callback row-rescan(int);
    callback row-rethumb(int);
    callback row-edit-exclude(int);
    callback row-remove(int);
    callback row-save-section(int, string);
    background: transparent;

    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px; alignment: stretch;
            VerticalLayout {
                spacing: 2px; horizontal-stretch: 1; alignment: center;
                Text { text: "Watched folders"; color: Theme.text; font-size: 20px; font-weight: 700; }
                Text { text: "Folders Tulipix watches for photos, videos, music, and books."; color: Theme.text-dim; font-size: 12px; }
            }
            VerticalLayout { alignment: center; Btn { label: "+ Add folder"; primary: true; width: 120px; clicked => { root.add-location(); } } }
        }
        HorizontalLayout {
            spacing: 8px; alignment: start;
            Btn { label: "Rescan everything"; width: 130px; clicked => { root.rescan-all(); } }
            Btn { label: "Clear thumbnails"; width: 130px; clicked => { root.clear-thumb-cache(); } }
            Btn { label: "Rebuild search index"; width: 150px; clicked => { root.rebuild-fts(); } }
            Rectangle { horizontal-stretch: 1; }
            // Wipes every section DB, watched folders, tags + thumb cache to
            // start the app completely fresh.
            Btn { label: "Reset app…"; danger: true; width: 100px; clicked => { root.reset-confirm-open = true; } }
        }
        // Maintenance progress bar — shows what Rescan All / Clear Thumb Cache /
        // Rebuild FTS is currently doing. Hidden while idle.
        if root.busy-task != "": VerticalLayout {
            spacing: 5px;
            HorizontalLayout {
                Text { text: root.busy-task; color: Theme.text; font-size: 11px; font-weight: 600;
                    horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: root.busy-frac >= 0 ? Math.round(root.busy-frac * 100) + "%" : "working…";
                    color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
            }
            Rectangle {
                height: 6px; border-radius: Surface.rr(3px, self.width, self.height); background: Surface.body(Theme.panel); clip: true;
                border-width: 1px; border-color: Surface.hairline;
                // Determinate fill when busy-frac >= 0; a soft full bar otherwise.
                Rectangle {
                    x: 0; y: 0; height: parent.height;
                    width: root.busy-frac >= 0 ? parent.width * Math.max(0, Math.min(1, root.busy-frac)) : parent.width;
                    border-radius: Surface.rr(3px, self.width, self.height);
                    background: @linear-gradient(90deg, Theme.brand, #8b5cf6);
                    animate width { duration: 180ms; easing: ease-out; }
                }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                for r[i] in root.rows: RowItem {
                    data: r;
                    rescan => { root.row-rescan(i); }
                    rethumb => { root.row-rethumb(i); }
                    edit-exclude => { root.row-edit-exclude(i); }
                    remove-lib => { root.row-remove(i); }
                    save-section(s) => { root.row-save-section(i, s); }
                }
                if root.rows.length == 0: Rectangle {
                    height: 80px;
                    border-radius: Theme.radius-md;
                    background: Surface.body(Theme.panel);
                    border-color: Surface.hairline; border-width: 1px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "No folders yet. Click + Add folder to bring in your media.";
                            color: Theme.text-dim; font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    // ── Destructive-reset confirmation (in-app) ──────────────────────────────
    if root.reset-confirm-open: Rectangle {
        width: 100%; height: 100%;
        background: #000000aa;
        // Swallow clicks behind the dialog; clicking the scrim cancels.
        TouchArea { clicked => { root.reset-confirm-open = false; } }
        Rectangle {
            width: 460px;
            height: dlg.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-md;
            background: Surface.body(Theme.panel);
            border-width: 1px; border-color: #7f1d1d;
            drop-shadow-blur: Surface.cast(40px); drop-shadow-color: #000000cc;
            TouchArea {} // keep clicks on the card from closing the dialog
            dlg := VerticalLayout {
                padding: 22px; spacing: 12px;
                Text { text: "Reset Tulipix?"; color: Theme.text; font-size: 18px; font-weight: 800; }
                Text {
                    text: "This erases ALL app data — the library index, download & YouTube history, tags, watched folders, settings and thumbnails — then restarts the app fresh with onboarding.\n\nYour actual media files are NOT touched. This cannot be undone.";
                    color: Theme.text-dim; font-size: 12px; wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px; alignment: end;
                    Btn { label: "Cancel"; width: 90px; clicked => { root.reset-confirm-open = false; } }
                    Btn { label: "Reset everything"; danger: true; width: 140px;
                        clicked => { root.reset-confirm-open = false; root.reset-app(); } }
                }
            }
        }
    }
}
