import { Theme, Section, Accent } from "tokens.slint";
import { PanelFrost } from "frost.slint";
import { UserCard, UserState } from "user_card.slint";
import { Mode } from "mode_pill.slint";
import { AppIcon, Icons } from "icons.slint";
import { Ripple } from "ripple.slint";

// Single navigation row. Modern + solid (no glass/translucency): the active row
// is a SOLID section-accent pill with white icon + white bold label and a soft
// accent-coloured shadow for depth. Hover is a solid neutral surface. A second
// inset ring appears on hover and stays on the active row. High contrast in both
// themes; press ripple stays.
component NavRow inherits Rectangle {
    in property <image> icon-img;
    in property <string> label;
    in property <color> accent;
    in property <bool> active;
    in property <bool> collapsed: false;
    callback clicked();
    min-height: 44px; max-height: 44px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    // Solid fills — accent pill when active, neutral surface on hover, flat else.
    background: active ? accent
              : (touch.has-hover ? Theme.panel-2 : transparent);
    border-width: 1px;
    border-color: active ? accent : (touch.has-hover ? accent.with-alpha(0.5) : Theme.outline);
    // Soft coloured elevation under the active row (shadow is the element's own,
    // unaffected by `clip`).
    drop-shadow-blur: active ? 15px : 0px;
    drop-shadow-color: active ? accent.with-alpha(0.5) : #00000000;
    drop-shadow-offset-y: active ? 4px : 0px;
    // No clip — the second outline sits OUTSIDE the row.
    clip: false;
    animate background { duration: 130ms; easing: ease-out; }
    animate border-color { duration: 130ms; easing: ease-out; }
    animate drop-shadow-blur { duration: 130ms; easing: ease-out; }

    touch := TouchArea { clicked => { root.clicked(); } }

    // Press ripple — white on the active pill, accent otherwise.
    Ripple {
        width: 100%; height: 100%;
        border-radius: parent.border-radius;
        accent: active ? #ffffff : accent;
        triggered: touch.pressed;
    }

    // Second outline — OUTSET ring around the row. Appears on hover, stays on
    // active (accent so it reads against the panel).
    if (active || touch.has-hover): Rectangle {
        x: -3px; y: -3px;
        width: parent.width + 6px; height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        background: transparent;
        border-width: 1.5px;
        border-color: accent.with-alpha(active ? 0.85 : 0.5);
    }

    HorizontalLayout {
        padding-left: root.collapsed ? 0px : 14px; padding-right: root.collapsed ? 0px : 14px;
        spacing: 12px;
        alignment: root.collapsed ? center : start;
        Rectangle {
            width: 28px; height: 28px;
            horizontal-stretch: 0; vertical-stretch: 0;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: active ? #ffffff.with-alpha(0.20) : accent.with-alpha(0.14);
            animate background { duration: 130ms; easing: ease-out; }
            AppIcon {
                source: icon-img;
                tint: active ? #ffffff : accent;
                width: 16px; height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        // Label always visible when expanded; white on active, brightens on hover.
        if !root.collapsed: Text {
            text: label;
            color: active ? #ffffff : (touch.has-hover ? Theme.text : Theme.text-dim);
            font-size: 13px;
            font-weight: active ? 700 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Icon-only round button used in the footer dock (Settings / Lock / Theme).
component IconButton inherits Rectangle {
    in property <image> icon-img;
    in property <bool> active;
    in property <color> accent: Theme.brand;
    callback clicked();
    min-width: 38px; max-width: 38px;
    min-height: 38px; max-height: 38px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 12px;
    background: active ? accent : (touch.has-hover ? Theme.panel-2 : transparent);
    border-width: 1px;
    border-color: active ? accent : (touch.has-hover ? accent.with-alpha(0.5) : Theme.outline);
    clip: false;
    animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }
    touch := TouchArea { clicked => { root.clicked(); } }
    Ripple {
        width: 100%; height: 100%;
        border-radius: parent.border-radius;
        accent: active ? #ffffff : accent;
        triggered: touch.pressed;
    }
    // OUTSET double outline on hover/active (visible in both themes).
    if (active || touch.has-hover): Rectangle {
        x: -3px; y: -3px;
        width: parent.width + 6px; height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        background: transparent;
        border-width: 1.5px;
        border-color: accent.with-alpha(active ? 0.85 : 0.5);
    }
    AppIcon {
        source: icon-img;
        tint: active ? #ffffff : (touch.has-hover ? Theme.text : Theme.text-dim);
        width: 17px; height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// Rectangular dock button — stretches to fill its grid cell (less empty space)
// with an OUTSET double outline on hover and active; solid accent fill on active.
component DockBtn inherits Rectangle {
    in property <image> icon-img;
    in property <bool> active;
    in property <color> accent: Theme.brand;
    callback clicked();
    min-height: 36px; max-height: 36px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: active ? accent : (touch.has-hover ? Theme.panel-2 : transparent);
    border-width: 1px;
    border-color: active ? accent : (touch.has-hover ? accent.with-alpha(0.5) : Theme.outline);
    clip: false;
    animate background { duration: 130ms; easing: ease-out; }
    animate border-color { duration: 130ms; easing: ease-out; }
    touch := TouchArea { clicked => { root.clicked(); } }
    Ripple {
        width: 100%; height: 100%;
        border-radius: parent.border-radius;
        accent: active ? #ffffff : accent;
        triggered: touch.pressed;
    }
    // OUTSET double outline on hover/active.
    if (active || touch.has-hover): Rectangle {
        x: -3px; y: -3px;
        width: parent.width + 6px; height: parent.height + 6px;
        border-radius: parent.border-radius + 3px;
        background: transparent;
        border-width: 1.5px;
        border-color: accent.with-alpha(active ? 0.85 : 0.5);
    }
    AppIcon {
        source: icon-img;
        tint: active ? #ffffff : (touch.has-hover ? Theme.text : Theme.text-dim);
        width: 16px; height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// Sidebar section header used to label nav groups.
component GroupHeader inherits Rectangle {
    in property <string> label;
    in property <bool> collapsed: false;
    height: root.collapsed ? 8px : 22px;
    horizontal-stretch: 1;
    HorizontalLayout {
        padding-left: 18px;
        if !root.collapsed: Text {
            text: label;
            color: Theme.text-dim;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            vertical-alignment: bottom;
        }
    }
}

// Brand row at the top — logo mark + wordmark. The mark is one of the four
// bundled Tulipix logos, picked in Settings → Profile → Appearance
// (np.p1.profile.logo); persisted by Rust, restored on boot.
component BrandHeader inherits Rectangle {
    in property <bool> collapsed: false;
    in property <int> logo-choice: 0; // 0 default · 1 color · 2 dark · 3 white
    height: 48px;
    horizontal-stretch: 1;
    HorizontalLayout {
        padding-left: root.collapsed ? 0px : 10px; padding-right: root.collapsed ? 0px : 10px; spacing: 12px;
        alignment: root.collapsed ? center : start;
        Rectangle {
            width: 36px; height: 36px;
            horizontal-stretch: 0; vertical-stretch: 0;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            clip: true;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.brand.with-alpha(0.45);
            Image {
                source: root.logo-choice == 1 ? @image-url("../resources/appicons/sidebar-color.png")
                      : root.logo-choice == 2 ? @image-url("../resources/appicons/sidebar-dark.png")
                      : root.logo-choice == 3 ? @image-url("../resources/appicons/sidebar-white.png")
                      :                         @image-url("../resources/appicons/sidebar-default.png");
                image-fit: cover;
                width: 100%; height: 100%;
            }
        }
        if !root.collapsed: VerticalLayout {
            alignment: center; spacing: 0px;
            Text {
                text: "Tulipix";
                color: Theme.text;
                font-size: 17px;
                font-weight: 700;
                letter-spacing: -0.1px;
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in-out property <string> active-section: "home";
    in property <UserState> user: { display-name: "Local user", secondary: "0 items · 0 B", mode: Mode.local };
    in property <int> logo-choice: 0;
    in-out property <bool> collapsed: true;
    callback section-changed(string);
    callback user-action(string);

    property <length> w-collapsed: 68px;
    min-width: root.collapsed ? root.w-collapsed : Theme.sidebar-w * 0.66;
    max-width: root.collapsed ? root.w-collapsed : Theme.sidebar-w * 0.66;
    horizontal-stretch: 0;
    animate min-width { duration: 160ms; easing: ease-out; }
    animate max-width { duration: 160ms; easing: ease-out; }

    border-radius: Theme.radius-lg;
    // Solid panel (no frosted translucency) for a clean, modern surface.
    background: Theme.dark ? #161827 : #ffffff;
    border-color: Theme.outline;
    border-width: 1px;
    drop-shadow-blur: 28px;
    drop-shadow-color: #00000040;

    VerticalLayout {
        padding: root.collapsed ? 10px : 14px;
        spacing: 6px;

        BrandHeader { collapsed: root.collapsed; logo-choice: root.logo-choice; }

        Rectangle { height: 10px; horizontal-stretch: 1; background: transparent; }
        NavRow { icon-img: Icons.home; label: "Home"; accent: Theme.sec-home; collapsed: root.collapsed;
            active: root.active-section == "home";
            clicked => { root.active-section = "home"; root.section-changed("home"); }
        }
        Rectangle { height: 4px; horizontal-stretch: 1; background: transparent; }
        GroupHeader { label: "LIBRARY"; collapsed: root.collapsed; }
        Rectangle { height: 4px; horizontal-stretch: 1; background: transparent; }

        NavRow { icon-img: Icons.image; label: "Photos"; accent: Theme.sec-photos; collapsed: root.collapsed;
            active: root.active-section == "photos";
            clicked => { root.active-section = "photos"; root.section-changed("photos"); }
        }
        NavRow { icon-img: Icons.film; label: "Videos"; accent: Theme.sec-videos; collapsed: root.collapsed;
            active: root.active-section == "videos";
            clicked => { root.active-section = "videos"; root.section-changed("videos"); }
        }
        NavRow { icon-img: Icons.music; label: "Music"; accent: Theme.sec-music; collapsed: root.collapsed;
            active: root.active-section == "music";
            clicked => { root.active-section = "music"; root.section-changed("music"); }
        }
        NavRow { icon-img: Icons.book-open; label: "Books"; accent: Theme.sec-books; collapsed: root.collapsed;
            active: root.active-section == "books";
            clicked => { root.active-section = "books"; root.section-changed("books"); }
        }

        Rectangle { height: 10px; horizontal-stretch: 1; background: transparent; }
        GroupHeader { label: "STORAGE"; collapsed: root.collapsed; }
        Rectangle { height: 4px; horizontal-stretch: 1; background: transparent; }

        NavRow { icon-img: Icons.cloud; label: "Cloud"; accent: Theme.sec-cloud; collapsed: root.collapsed;
            active: root.active-section == "cloud";
            clicked => { root.active-section = "cloud"; root.section-changed("cloud"); }
        }

        Rectangle { height: 10px; horizontal-stretch: 1; background: transparent; }
        GroupHeader { label: "UTILITIES"; collapsed: root.collapsed; }
        Rectangle { height: 4px; horizontal-stretch: 1; background: transparent; }

        NavRow { icon-img: Icons.wrench; label: "Tools"; accent: Theme.sec-tools; collapsed: root.collapsed;
            active: root.active-section == "tools";
            clicked => { root.active-section = "tools"; root.section-changed("tools"); }
        }

        // Bottom spacer pushes user card + footer dock to the bottom.
        Rectangle { vertical-stretch: 1; horizontal-stretch: 1; background: transparent; }

        // Separator above the bottom block.
        Rectangle {
            height: 1px; horizontal-stretch: 1;
            background: Theme.outline;
        }
        Rectangle { height: 8px; horizontal-stretch: 1; background: transparent; }

        // Footer dock — Settings · Lock · Theme · Collapse-toggle. Horizontal
        // when expanded, stacked vertically when collapsed. (Replaced the old
        // sync status dot with the collapse toggle.)
        if !root.collapsed: GridLayout {
            spacing: 8px;
            padding-left: 4px; padding-right: 4px;
            Row {
                DockBtn {
                    icon-img: Icons.settings;
                    active: root.active-section == "settings";
                    accent: #6366f1;
                    clicked => { root.active-section = "settings"; root.section-changed("settings"); }
                }
                DockBtn {
                    icon-img: Icons.lock;
                    accent: #f59e0b;
                    clicked => { root.user-action("lock"); }
                }
            }
            Row {
                DockBtn {
                    icon-img: Theme.dark ? Icons.sun : Icons.moon;
                    accent: #14b8a6;
                    clicked => { Theme.dark = !Theme.dark; }
                }
                DockBtn {
                    icon-img: Icons.chevron-left;
                    accent: #ec4899;
                    clicked => { root.collapsed = true; }
                }
            }
        }
        if root.collapsed: VerticalLayout {
            spacing: 8px; alignment: center;
            IconButton {
                icon-img: Icons.settings;
                active: root.active-section == "settings";
                accent: #6366f1;
                clicked => { root.active-section = "settings"; root.section-changed("settings"); }
            }
            IconButton {
                icon-img: Icons.lock;
                accent: #f59e0b;
                clicked => { root.user-action("lock"); }
            }
            IconButton {
                icon-img: Theme.dark ? Icons.sun : Icons.moon;
                accent: #14b8a6;
                clicked => { Theme.dark = !Theme.dark; }
            }
            IconButton {
                icon-img: Icons.chevron-right;
                accent: #ec4899;
                clicked => { root.collapsed = false; }
            }
        }
    }
}
