import { Theme, Section, Accent } from "tokens.slint";
import { Surface, Rim } from "surface.slint";
import { PanelFrost } from "frost.slint";
import { UserCard, UserState } from "user_card.slint";
import { Mode } from "mode_pill.slint";
import { AppIcon, Icons } from "icons.slint";
import { Ripple } from "ripple.slint";

// Single navigation row. Frosted glass: hover is a light glass wash; the
// ACTIVE row drops the old inner-highlight/icon-glass "shadow" for a clean
// DOUBLE OUTLINE — outer ring in the section accent, inner ring in the neutral
// glass border — so the active state reads crisply in both themes and at both
// sidebar widths. Expanded rows are taller with bigger glyphs (big tiles).
component NavRow inherits Rectangle {
    in property <image> icon-img;
    in property <string> label;
    in property <color> accent;
    in property <bool> active;
    in property <bool> collapsed: false;
    // Count of things wanting attention in this section. 0 hides the badge.
    // Only Finances sets it today; it lives on NavRow rather than on that one
    // row so a second section wanting a count does not need a second mechanism.
    in property <int> badge: 0;
    // Whether that count contains something already late. An overdue bill and a
    // bill due on Friday are not the same news, and one dot colour for both
    // teaches the user to ignore the colour.
    in property <bool> badge-alarm: false;
    callback clicked();
    property <length> row-h: root.collapsed ? 46px : 58px;
    min-height: root.row-h; max-height: root.row-h;
    horizontal-stretch: 1;
    border-radius: Surface.row-radius;
    background: Surface.row-bg(root.active, touch.has-hover, root.accent);
    // Outer ring — section accent when active.
    border-width: Surface.row-border-w(root.active);
    border-color: Surface.row-border(root.active, touch.has-hover, root.accent);
    // No cast under a nav row in any language. Clay's active row is pressed
    // *into* the shell and the moulded one is a key pushed down — both are
    // recesses, and a recess that also floats is a recess that reads as neither.
    animate background { duration: 130ms; easing: ease-out; }
    animate border-color { duration: 130ms; easing: ease-out; }

    touch := TouchArea { clicked => { root.clicked(); } }

    Ripple {
        width: 100%; height: 100%;
        border-radius: parent.border-radius;
        accent: root.accent;
        triggered: touch.pressed;
    }

    // Inner ring — second colour of the double outline, clearly separated
    // from the accent ring (3–4px gap) and animated: it fades in and settles
    // inward when the section activates. Persistent element (not `if`) so the
    // entry animation actually plays.
    ring := Rectangle {
        property <length> inset: root.active ? 5px : 10px;
        x: ring.inset; y: ring.inset;
        width: parent.width - 2 * ring.inset; height: parent.height - 2 * ring.inset;
        border-radius: Math.max(4px, parent.border-radius - 4px);
        background: transparent;
        border-width: 1px;
        border-color: Theme.text.with-alpha(0.38);
        opacity: (root.active && Surface.nav-ring) ? 1 : 0;
        animate inset { duration: 220ms; easing: ease-out; }
        animate opacity { duration: 220ms; easing: ease-out; }
    }

    // Rim light. Stands in for the inner highlight neither clay nor a moulded
    // plate can do without and Slint has no primitive for. On OLED it is the
    // only thing telling one black box from the black box behind it.
    if Surface.rim && (root.active || touch.has-hover): Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, parent.border-radius - 1px);
        // The active row is a key that has been pushed in, so its sheen runs
        // the other way: shade along the top edge, light along the bottom.
        pressed: root.active;
    }

    HorizontalLayout {
        padding-left: root.collapsed ? 0px : 14px; padding-right: root.collapsed ? 0px : 14px;
        spacing: 12px;
        alignment: root.collapsed ? center : start;
        Rectangle {
            width: root.collapsed ? 28px : 40px; height: self.width;
            horizontal-stretch: 0; vertical-stretch: 0;
            y: (parent.height - self.height) / 2;
            border-radius: Surface.glyph-radius;
            // Standard: no glass box behind the active icon — the double
            // outline carries the active state and hover keeps its light wash.
            // The other two make the tile itself the object: a clay lump with
            // the accent mixed in, or a moulded key lit from the top edge. This
            // is the most-looked-at surface in the sidebar, and leaving it empty
            // is most of why the languages read as the same page before.
            background: Surface.glyph-bg(root.accent, root.active, touch.has-hover);
            border-width: Surface.glyph-border-w();
            border-color: Surface.glyph-border(root.accent, root.active);
            animate background { duration: 130ms; easing: ease-out; }
            if Surface.rim: Rim {
                x: 1px; y: 1px;
                width: parent.width - 2px; height: parent.height - 2px;
                radius: Math.max(2px, parent.border-radius - 1px);
                // A tile on an active row has gone down with the row it is on.
                pressed: root.active;
            }
            AppIcon {
                source: icon-img;
                tint: accent;
                // Expanded glyphs run clearly bigger than the 14px label so the
                // icon leads each tile.
                width: root.collapsed ? 16px : 26px; height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        // Label always visible when expanded; brightens on hover/active.
        if !root.collapsed: Text {
            text: label;
            color: (active || touch.has-hover) ? Theme.text : Theme.text-dim;
            font-size: 14px;
            font-weight: active ? 700 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    // The alert dot, both widths: tucked just inside the row's own outline at
    // the top-right. Placed by hand rather than in the layout — in the layout it
    // was a count pill wide enough to push the row's content past the border and
    // spill outside it, and the corner is where a badge is looked for anyway.
    // `error` when something is actually late — the one thing on the row meant
    // to interrupt. Otherwise the section's own accent, which says "there is
    // something here" without claiming anything is wrong.
    if root.badge > 0: Rectangle {
        x: parent.width - self.width - (root.collapsed ? 9px : 8px);
        y: root.collapsed ? 9px : 8px;
        width: 9px; height: 9px;
        border-radius: 4.5px;
        background: root.badge-alarm ? Theme.error : root.accent;
        // A ring in the shell colour on the rail, where the dot sits over the
        // glyph tile and needs cutting out of it. Expanded it sits on the row's
        // own empty corner, so the ring would only be a second outline.
        border-width: root.collapsed ? 1.5px : 0px;
        border-color: Theme.dark ? #161827 : #ffffff;
    }
}

// Icon-only round button used in the footer dock (Settings / Lock / Theme).
component IconButton inherits Rectangle {
    in property <image> icon-img;
    in property <bool> active;
    in property <color> accent: Theme.brand;
    callback clicked();
    min-width: 38px; max-width: 38px;
    min-height: 38px; max-height: 38px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: Surface.btn-radius;
    background: Surface.key-bg(root.active, touch.has-hover);
    border-width: Surface.panel-border-w;
    border-color: Surface.key-border(root.active, touch.has-hover);
    animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }
    touch := TouchArea { clicked => { root.clicked(); } }
    Ripple {
        width: 100%; height: 100%;
        border-radius: parent.border-radius;
        accent: root.accent;
        triggered: touch.pressed;
    }
    // Faint inner highlight — frost recipe, Standard only. The other two get
    // the full rim instead: at this size the lit top edge is the only thing
    // saying "key" rather than "swatch".
    if (!Surface.rim && (active || touch.has-hover)): Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        border-radius: parent.border-radius - 1px;
        background: transparent;
        border-width: 1px;
        border-color: Theme.highlight-inner;
    }
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, parent.border-radius - 1px);
        pressed: root.active || touch.pressed;
    }
    AppIcon {
        source: icon-img;
        tint: (active || touch.has-hover) ? Theme.text : Theme.text-dim;
        width: 17px; height: 17px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// Rectangular dock button — stretches to fill its grid cell (less empty space)
// with an OUTSET double outline on hover and active; solid accent fill on active.
component DockBtn inherits Rectangle {
    in property <image> icon-img;
    in property <bool> active;
    in property <color> accent: Theme.brand;
    callback clicked();
    min-height: 36px; max-height: 36px;
    horizontal-stretch: 1;
    border-radius: Surface.btn-radius;
    background: Surface.key-bg(root.active, touch.has-hover);
    border-width: Surface.panel-border-w;
    border-color: Surface.key-border(root.active, touch.has-hover);
    animate background { duration: 130ms; easing: ease-out; }
    animate border-color { duration: 130ms; easing: ease-out; }
    touch := TouchArea { clicked => { root.clicked(); } }
    Ripple {
        width: 100%; height: 100%;
        border-radius: parent.border-radius;
        accent: root.accent;
        triggered: touch.pressed;
    }
    // Faint inner highlight — frost recipe, Standard only; the other two take
    // the rim, which is what makes a key look pressable at 36px.
    if (!Surface.rim && (active || touch.has-hover)): Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        border-radius: parent.border-radius - 1px;
        background: transparent;
        border-width: 1px;
        border-color: Theme.highlight-inner;
    }
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, parent.border-radius - 1px);
        pressed: root.active || touch.pressed;
    }
    AppIcon {
        source: icon-img;
        tint: (active || touch.has-hover) ? Theme.text : Theme.text-dim;
        width: 16px; height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// Sidebar section header used to label nav groups.
component GroupHeader inherits Rectangle {
    in property <string> label;
    in property <bool> collapsed: false;
    height: root.collapsed ? 8px : 22px;
    horizontal-stretch: 1;
    HorizontalLayout {
        padding-left: 18px;
        if !root.collapsed: Text {
            text: label;
            color: Theme.text-dim;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            vertical-alignment: bottom;
        }
    }
}

// Brand row at the top — logo mark + wordmark. The mark is one of the four
// bundled Tulipix logos, picked in Settings → Profile → Appearance
// (np.p1.profile.logo); persisted by Rust, restored on boot.
component BrandHeader inherits Rectangle {
    in property <bool> collapsed: false;
    in property <int> logo-choice: 0; // 0 default · 1 color · 2 dark · 3 white
    // Seasonal India branding — swaps the DEFAULT mark only (explicit picks win).
    in property <bool> festival: false;
    // Clicking the mark toggles logo-fullscreen mode (main.slint).
    callback logo-clicked();
    height: 48px;
    horizontal-stretch: 1;
    HorizontalLayout {
        padding-left: root.collapsed ? 0px : 10px; padding-right: root.collapsed ? 0px : 10px; spacing: 12px;
        alignment: root.collapsed ? center : start;
        Rectangle {
            width: 36px; height: 36px;
            horizontal-stretch: 0; vertical-stretch: 0;
            y: (parent.height - self.height) / 2;
            border-radius: Surface.glyph-radius;
            clip: true;
            TouchArea { mouse-cursor: pointer; clicked => { root.logo-clicked(); } }
            Image {
                source: root.logo-choice == 1 ? @image-url("../resources/appicons/sidebar-color.png")
                      : root.logo-choice == 2 ? @image-url("../resources/appicons/sidebar-dark.png")
                      : root.logo-choice == 3 ? @image-url("../resources/appicons/sidebar-white.png")
                      : root.festival        ? @image-url("../resources/appicons/logo_india.png")
                      :                         @image-url("../resources/appicons/sidebar-default.png");
                image-fit: cover;
                width: 100%; height: 100%;
            }
            // The mark is a physical object in both languages — a clay disc, or
            // a lens with a specular top edge. Drawn over the image, which is
            // what makes it read as glazed rather than printed.
            if Surface.rim: Rim {
                width: 100%; height: 100%;
                radius: parent.border-radius;
            }
        }
        if !root.collapsed: VerticalLayout {
            alignment: center; spacing: 0px;
            Text {
                text: "Tulipix";
                color: Theme.text;
                font-size: 17px;
                font-weight: 700;
                letter-spacing: -0.1px;
            }
        }
    }
}

export component Sidebar inherits Rectangle {
    in-out property <string> active-section: "home";
    in property <UserState> user: { display-name: "Local user", secondary: "0 items · 0 B", mode: Mode.local };
    in property <int> logo-choice: 0;
    in property <bool> festival: false;
    in-out property <bool> collapsed: true;
    // Bills and subscriptions coming due inside the alert lead. Set by
    // tulipix-sec-finances on every tick.
    in property <int> finances-badge: 0;
    in property <bool> finances-badge-overdue: false;
    callback section-changed(string);
    callback user-action(string);
    callback theme-cycled();   // fired after the theme toggle cycles light/dark/OLED (persist)
    callback logo-clicked();   // logo mark → toggle logo-fullscreen mode

    // Cycle the app theme light → dark → OLED → light and persist it.
    function cycle-theme() {
        if (!Theme.dark) { Theme.dark = true; Theme.oled = false; }
        else if (!Theme.oled) { Theme.oled = true; }
        else { Theme.dark = false; Theme.oled = false; }
        root.theme-cycled();
    }

    property <length> w-collapsed: 68px;
    // +10px over the old 0.66 fraction: the nav rows were running out of room
    // for a full label plus anything after it.
    property <length> w-expanded: Theme.sidebar-w * 0.66 + 10px;
    min-width: root.collapsed ? root.w-collapsed : root.w-expanded;
    max-width: root.collapsed ? root.w-collapsed : root.w-expanded;
    horizontal-stretch: 0;
    animate min-width { duration: 160ms; easing: ease-out; }
    animate max-width { duration: 160ms; easing: ease-out; }

    border-radius: Surface.panel-radius;
    // Solid panel (no frosted translucency) for a clean, modern surface. The
    // moulded language turns it into a lit plate; clay drops the hairline and
    // widens the cast instead.
    background: Surface.shell();
    border-color: Surface.panel-border;
    border-width: Surface.panel-border-w;
    drop-shadow-blur: Surface.panel-shadow;
    drop-shadow-color: Surface.shadow-ink;
    drop-shadow-offset-y: Surface.panel-shadow-y;

    // Rim light along the shell edge — what separates the sidebar from the page
    // once clay has taken its border away, and the only separation there is on
    // OLED, where the cast shadow lands on black and disappears.
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Surface.panel-radius - 1px;
    }

    VerticalLayout {
        padding: root.collapsed ? 10px : 14px;
        // Roomier gap between nav tiles — keeps the collapsed icon stack airy.
        spacing: root.collapsed ? 10px : 8px;

        BrandHeader { collapsed: root.collapsed; logo-choice: root.logo-choice; festival: root.festival;
            logo-clicked => { root.logo-clicked(); } }

        Rectangle { height: 10px; horizontal-stretch: 1; background: transparent; }
        NavRow { icon-img: Icons.home; label: "Home"; accent: Theme.sec-home; collapsed: root.collapsed;
            active: root.active-section == "home";
            clicked => { root.active-section = "home"; root.section-changed("home"); }
        }
        // Single nav group — every section lives under one "Applications" label.
        GroupHeader { label: "APPLICATIONS"; collapsed: root.collapsed; }

        NavRow { icon-img: Icons.image; label: "Photos"; accent: Theme.sec-photos; collapsed: root.collapsed;
            active: root.active-section == "photos";
            clicked => { root.active-section = "photos"; root.section-changed("photos"); }
        }
        NavRow { icon-img: Icons.film; label: "Videos"; accent: Theme.sec-videos; collapsed: root.collapsed;
            active: root.active-section == "videos";
            clicked => { root.active-section = "videos"; root.section-changed("videos"); }
        }
        NavRow { icon-img: Icons.music; label: "Music"; accent: Theme.sec-music; collapsed: root.collapsed;
            active: root.active-section == "music";
            clicked => { root.active-section = "music"; root.section-changed("music"); }
        }
        NavRow { icon-img: Icons.book-open; label: "Books"; accent: Theme.sec-books; collapsed: root.collapsed;
            active: root.active-section == "books";
            clicked => { root.active-section = "books"; root.section-changed("books"); }
        }
        NavRow { icon-img: Icons.cloud; label: "Cloud"; accent: Theme.sec-cloud; collapsed: root.collapsed;
            active: root.active-section == "cloud";
            clicked => { root.active-section = "cloud"; root.section-changed("cloud"); }
        }
        NavRow { icon-img: Icons.wrench; label: "Tools"; accent: Theme.sec-tools; collapsed: root.collapsed;
            active: root.active-section == "tools";
            clicked => { root.active-section = "tools"; root.section-changed("tools"); }
        }
        NavRow { icon-img: Icons.share; label: "Transfer"; accent: Theme.sec-transfer; collapsed: root.collapsed;
            active: root.active-section == "transfer";
            clicked => { root.active-section = "transfer"; root.section-changed("transfer"); }
        }
        NavRow { icon-img: Icons.wallet; label: "Finances"; accent: Theme.sec-finances; collapsed: root.collapsed;
            active: root.active-section == "finances";
            badge: root.finances-badge;
            badge-alarm: root.finances-badge-overdue;
            clicked => { root.active-section = "finances"; root.section-changed("finances"); }
        }

        // Bottom spacer pushes user card + footer dock to the bottom.
        Rectangle { vertical-stretch: 1; horizontal-stretch: 1; background: transparent; }

        // Separator above the bottom block. Clay has no rules — a line ruled
        // across a lump is a line ruled across a lump — so there it is nothing
        // and the gap does the separating on its own.
        Rectangle {
            height: 1px; horizontal-stretch: 1;
            background: Surface.hairline;
        }
        Rectangle { height: 8px; horizontal-stretch: 1; background: transparent; }

        // Footer dock — Settings · Lock · Theme · Collapse-toggle. Horizontal
        // when expanded, stacked vertically when collapsed. (Replaced the old
        // sync status dot with the collapse toggle.)
        if !root.collapsed: GridLayout {
            spacing: 8px;
            padding-left: 4px; padding-right: 4px;
            Row {
                DockBtn {
                    icon-img: Icons.settings;
                    active: root.active-section == "settings";
                    accent: #6366f1;
                    clicked => { root.active-section = "settings"; root.section-changed("settings"); }
                }
                DockBtn {
                    icon-img: Icons.lock;
                    accent: #f59e0b;
                    clicked => { root.user-action("lock"); }
                }
            }
            Row {
                DockBtn {
                    icon-img: !Theme.dark ? Icons.sun : (Theme.oled ? Icons.star : Icons.moon);
                    accent: #14b8a6;
                    clicked => { root.cycle-theme(); }
                }
                DockBtn {
                    icon-img: Icons.chevron-left;
                    accent: #ec4899;
                    clicked => { root.collapsed = true; }
                }
            }
        }
        if root.collapsed: VerticalLayout {
            spacing: 8px; alignment: center;
            IconButton {
                icon-img: Icons.settings;
                active: root.active-section == "settings";
                accent: #6366f1;
                clicked => { root.active-section = "settings"; root.section-changed("settings"); }
            }
            IconButton {
                icon-img: Icons.lock;
                accent: #f59e0b;
                clicked => { root.user-action("lock"); }
            }
            IconButton {
                icon-img: !Theme.dark ? Icons.sun : (Theme.oled ? Icons.star : Icons.moon);
                accent: #14b8a6;
                clicked => { root.cycle-theme(); }
            }
            IconButton {
                icon-img: Icons.chevron-right;
                accent: #ec4899;
                clicked => { root.collapsed = false; }
            }
        }
    }
}
