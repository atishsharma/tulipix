// Pan+zoom cropper for the profile cover/avatar (np.p1.profile.cover).
// Drag repositions, scroll zooms; the mask is always fully covered (zoom
// floors at 1.0, pan clamps to the slack). The confirm() payload carries the
// display-space transform — Rust inverts it against the full-res source in
// profile_image::crop_rect so the saved PNG is cropped from the original.
import { Theme, Accent } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";

export component CropDialog inherits Rectangle {
    in property <image> source-image;
    in property <string> mode: "cover"; // "cover" | "avatar"
    in property <int> nat-w: 1;
    in property <int> nat-h: 1;
    // The cover mask is 4:1, and the well it lands in on the You & Home page is
    // 4:1 too (its height is derived from its width there). That is the whole
    // fix for "the crop does not match the preview": the page used to show a
    // fixed-height well of whatever proportion the window gave it, and
    // `image-fit: cover` trimmed the difference off the top and bottom of every
    // cover after the fact. Change one of these two and change the other.
    property <length> mask-w: mode == "avatar" ? 220px : 560px;
    property <length> mask-h: mode == "avatar" ? 220px : 140px;

    callback confirm(string, float, length, length, length, length); // mode, zoom, pan-x, pan-y, mask-w, mask-h
    callback cancel();

    width: 100%; height: 100%;

    // Scrim — click-through blocked; Cancel is the only way out.
    Rectangle { background: #000000aa; TouchArea {} }

    Rectangle {
        width: mask-w + 80px; height: mask-h + 168px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        border-radius: Surface.rr(16px, self.width, self.height); background: Surface.body(Theme.panel-2);
        border-width: 1px; border-color: Surface.hairline;
        drop-shadow-blur: Surface.cast(30px); drop-shadow-color: #000000aa;

        VerticalLayout {
            padding: 20px; spacing: 14px; alignment: center;

            Text {
                text: mode == "avatar" ? "Crop avatar" : "Crop cover photo";
                color: Theme.text; font-size: 15px; font-weight: 700;
                horizontal-alignment: center;
            }

            stage := Rectangle {
                width: mask-w; height: mask-h;
                horizontal-stretch: 0; vertical-stretch: 0;
                clip: true; background: #0e0f10;
                border-radius: mode == "avatar" ? mask-h / 2 : 8px;

                property <float> base-scale: Math.max(
                    (mask-w / 1px) / Math.max(1, root.nat-w),
                    (mask-h / 1px) / Math.max(1, root.nat-h));
                property <float> zoom: 1.0;
                property <length> img-w: (root.nat-w * 1px) * stage.base-scale * stage.zoom;
                property <length> img-h: (root.nat-h * 1px) * stage.base-scale * stage.zoom;
                property <length> max-pan-x: Math.max(0px, (stage.img-w - stage.width) / 2);
                property <length> max-pan-y: Math.max(0px, (stage.img-h - stage.height) / 2);
                property <length> pan-x: 0;
                property <length> pan-y: 0;
                property <length> down-x: 0;
                property <length> down-y: 0;

                Image {
                    source: root.source-image;
                    image-fit: fill;
                    width: stage.img-w; height: stage.img-h;
                    x: (stage.width - self.width) / 2 + stage.pan-x;
                    y: (stage.height - self.height) / 2 + stage.pan-y;
                }

                TouchArea {
                    mouse-cursor: MouseCursor.grab;
                    scroll-event(e) => {
                        stage.zoom = Math.max(1.0, Math.min(4.0, stage.zoom + (e.delta-y > 0 ? 0.1 : -0.1)));
                        stage.pan-x = Math.clamp(stage.pan-x, -stage.max-pan-x, stage.max-pan-x);
                        stage.pan-y = Math.clamp(stage.pan-y, -stage.max-pan-y, stage.max-pan-y);
                        return accept;
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            stage.down-x = stage.pan-x; stage.down-y = stage.pan-y;
                        }
                    }
                    moved => {
                        stage.pan-x = Math.clamp(stage.down-x + (self.mouse-x - self.pressed-x), -stage.max-pan-x, stage.max-pan-x);
                        stage.pan-y = Math.clamp(stage.down-y + (self.mouse-y - self.pressed-y), -stage.max-pan-y, stage.max-pan-y);
                    }
                }
            }

            Text { text: "Drag to reposition · scroll to zoom"; color: Theme.text-dim; font-size: 11px; horizontal-alignment: center; }

            HorizontalLayout {
                spacing: 10px; alignment: center;
                Rectangle {
                    width: 100px; height: 34px; border-radius: Surface.rr(8px, self.width, self.height);
                    background: cnl.has-hover ? Theme.panel : Theme.panel-2;
                    border-width: 1px; border-color: Surface.hairline;
                    cnl := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(); } }
                    Text { text: "Cancel"; color: Theme.text; font-size: 12px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 120px; height: 34px; border-radius: Surface.rr(8px, self.width, self.height);
                    background: ok.has-hover ? Accent.color.with-alpha(0.85) : Accent.color;
                    ok := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.confirm(root.mode, stage.zoom, stage.pan-x, stage.pan-y, mask-w, mask-h); }
                    }
                    Text { text: "Use photo"; color: #ffffff; font-weight: 700; font-size: 12px; width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
