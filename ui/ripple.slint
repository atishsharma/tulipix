import { Theme } from "tokens.slint";
import { Surface } from "surface.slint";

// Press-ripple stand-in. Real wgpu shader (np.p1.ds.ripple GPU variant) ships later.
// This is an animated radial-gradient + outline-pulse + accent crest fallback that
// already respects the reduce-motion flag (np.p1.ds.ripple-fallback).

export component Ripple inherits Rectangle {
    in property <color> accent: Theme.brand;
    in-out property <bool> triggered: false;
    in property <bool> reduce-motion: Theme.reduce-motion;

    // animation progress 0..1
    property <float> t: 0;
    animate t {
        duration: reduce-motion ? 120ms : 600ms;
        easing: ease-out;
    }
    states [
        idle when !triggered: { t: 0; }
        firing when triggered: { t: 1; }
    ]

    // How lit the effect is, right now.
    //
    // Standard reads `1 - t`: full strength at rest, fading out while held.
    // That is backwards for a press effect, but it is also the shipped look of
    // the sidebar — the accent outline and wash on every nav row come from
    // here, not from NavRow — so Standard keeps it to the pixel.
    //
    // The other two languages paint their own surfaces, and an accent outline
    // laid over every one of them from underneath is exactly what made them
    // look like Standard with rounder corners. There it runs the way the name
    // promises: nothing at rest, a swell while the row is held.
    property <float> lit:  Surface.ripple-at-rest ? 1 - t : t;
    property <float> echo: Surface.ripple-at-rest ? max(0, 1 - t * 1.5) : min(1, t * 1.5);

    // GPU-cheap radial wave
    if !reduce-motion: Rectangle {
        border-radius: parent.border-radius;
        background: @radial-gradient(circle, accent.with-alpha(0.28 * lit) 0%, transparent 60%);
        opacity: lit;
    }
    // Damped echo
    if !reduce-motion: Rectangle {
        border-radius: parent.border-radius;
        background: @radial-gradient(circle, accent.with-alpha(0.14 * lit) 0%, transparent 70%);
        opacity: echo;
    }
    // Outline pulse + accent crest — used in both motion modes
    Rectangle {
        border-radius: parent.border-radius;
        background: accent;
        opacity: (reduce-motion ? 0.18 : 0.10) * lit;
    }
    Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: accent;
        opacity: lit * 0.6;
    }
}

export component RippleButton inherits Rectangle {
    in property <color> accent: Theme.brand;
    in property <string> label: "";
    callback clicked();

    border-radius: Theme.radius-md;
    background: Theme.panel-2;
    border-color: Theme.outline; border-width: 1px;

    touch := TouchArea {
        clicked => {
            ripple.triggered = false;
            ripple.triggered = true;
            root.clicked();
        }
    }
    ripple := Ripple { accent: accent; width: parent.width; height: parent.height; }

    Text {
        text: label; color: Theme.text;
        font-size: 13px; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
    }
}
