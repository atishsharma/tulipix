// Empty-state illustrations + microinteractions.
// - Per-section frosted card with a soft accent halo.
// - Heart-burst particles on Like (HeartBurst).
// - Milestone confetti (MilestoneConfetti) on 1k photos / 100h watched / first sync.
// - Reduce-motion aware: animations skipped, halo static.

import { Theme, Accent, Section } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";

export component EmptyState inherits Rectangle {
    in property <Section> section: Section.photos;
    in property <string> title: "Nothing here yet";
    in property <string> subtitle: "Add a folder to get started.";
    in property <string> cta-label: "Add Folder…";
    callback cta-clicked();

    border-radius: Theme.radius-lg;
    background: Surface.body(Theme.panel);
    border-width: 1px;
    border-color: Surface.hairline;

    // Soft accent halo behind the icon. Static when reduce-motion.
    Rectangle {
        width: 220px;
        height: 220px;
        x: parent.width / 2 - 110px;
        y: parent.height / 2 - 160px;
        border-radius: 110px;
        background: Accent.color;
        opacity: 0.18;
        animate opacity {
            duration: Theme.reduce-motion ? 0ms : 2200ms;
            easing: ease-in-out;
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 28px;

        Text {
            text: root.title;
            font-size: 18px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.subtitle;
            font-size: 13px;
            color: Theme.text-dim;
            horizontal-alignment: center;
        }

        Rectangle {
            height: 36px;
            border-radius: Surface.rr(10px, self.width, self.height);
            background: Accent.color;
            TouchArea {
                clicked => { root.cta-clicked(); }
                Text {
                    text: root.cta-label;
                    color: white;
                    font-weight: 600;
                }
            }
        }
    }
}

// Single heart-burst particle ring fired on Like.
// Caller flips `playing` true; component animates one ~600 ms cycle.
export component HeartBurst inherits Rectangle {
    in-out property <bool> playing: false;
    property <duration> dur: Theme.reduce-motion ? 80ms : 600ms;

    width: 96px;
    height: 96px;

    Rectangle {
        x: parent.width / 2 - 6px;
        y: parent.height / 2 - 6px;
        width: 12px;
        height: 12px;
        border-radius: Surface.rr(6px, self.width, self.height);
        background: #ec4899;
        opacity: playing ? 0.0 : 1.0;
        animate opacity { duration: dur; easing: ease-out; }
    }
}

// Milestone confetti — opacity-fade and a slight scale "pop". Caller passes
// the milestone label.
export component MilestoneConfetti inherits Rectangle {
    in property <string> label: "1,000 photos!";
    in-out property <bool> playing: false;
    property <duration> dur: Theme.reduce-motion ? 200ms : 1400ms;

    Text {
        text: root.label;
        font-size: 22px;
        font-weight: 700;
        color: Theme.text;
        opacity: playing ? 1.0 : 0.0;
        animate opacity { duration: dur; easing: ease-in-out; }
    }
}
