import { Theme } from "tokens.slint";

export enum PanelState { idle, hover, pressed, focus, disabled }

export component OutlinedPanel inherits Rectangle {
    in property <color> accent: Theme.brand;
    in property <PanelState> state: PanelState.idle;
    in property <bool> elevated: false;

    border-radius: Theme.radius-md;
    background:
        state == PanelState.disabled ? Theme.panel.with-alpha(0.5) :
        state == PanelState.pressed  ? Theme.panel-2 :
                                       Theme.panel;
    border-width: state == PanelState.focus ? 2px : 1px;
    border-color:
        state == PanelState.focus    ? accent :
        state == PanelState.hover    ? Theme.outline-strong :
        state == PanelState.disabled ? Theme.outline.with-alpha(0.5) :
                                       Theme.outline;
    drop-shadow-blur: elevated ? 24px : 0;
    drop-shadow-color: #00000066;

    // Inner highlight — raised-glass illusion.
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: parent.border-radius;
        border-width: 1px;
        border-color: state == PanelState.disabled
            ? Theme.highlight-inner.with-alpha(0.3)
            : Theme.highlight-inner;
    }

    // Subtle accent crest on hover/focus
    if state == PanelState.hover || state == PanelState.focus: Rectangle {
        border-radius: parent.border-radius;
        background: accent;
        opacity: state == PanelState.focus ? 0.08 : 0.04;
    }
}
