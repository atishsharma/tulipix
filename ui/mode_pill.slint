import { Theme } from "tokens.slint";
import { AppIcon, Icons } from "icons.slint";

// Local-only app: no account mode. The pill is 🏠 Local or 🔒 Locked.
export enum Mode { local, locked }

export component ModePill inherits Rectangle {
    in property <Mode> mode: Mode.local;
    height: 20px;
    border-radius: 10px;
    background:
        mode == Mode.local ? @linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%)
                           : @linear-gradient(135deg, #475569 0%, #1f2937 100%);
    HorizontalLayout {
        padding-left: 8px; padding-right: 10px; spacing: 5px;
        alignment: center;
        VerticalLayout { alignment: center; AppIcon {
            source: mode == Mode.local ? Icons.home : Icons.lock;
            width: 12px; height: 12px;
        } }
        Text {
            text: mode == Mode.local ? "Local" : "Locked";
            font-size: 10px; font-weight: 600;
            color: #ffffff;
            vertical-alignment: center;
        }
    }
}
