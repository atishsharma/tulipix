    // YouTube — single-entry delete confirm (cached / downloads). Enter = delete.
    if root.yt-del-open: Rectangle {
        width: 100%; height: 100%; background: #000000aa;
        TouchArea { clicked => { root.yt-del-open = false; } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Return) {
                    if (root.yt-del-kind == "cached") { root.yt-remove-cached(root.yt-del-id); } else { root.yt-remove-download(root.yt-del-id); }
                    root.yt-del-open = false; return accept;
                }
                if (e.text == Key.Escape) { root.yt-del-open = false; return accept; }
                return reject;
            }
        }
        Rectangle { width: 440px; height: 196px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            border-radius: 16px; background: MusicTheme.surf-pop; border-width: 1px; border-color: MusicTheme.line;
            drop-shadow-blur: 48px; drop-shadow-color: #000000ee; clip: true;
            TouchArea {}
            VerticalLayout { padding: 24px; spacing: 12px; alignment: start;
                Text { text: root.yt-del-kind == "cached" ? "Remove from cache?" : "Delete this download?"; color: MusicTheme.fg; font-size: 18px; font-weight: 800; }
                Text { text: root.yt-del-title; color: MusicTheme.fg-dim; font-size: 13px; wrap: word-wrap; overflow: elide; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { spacing: 10px; alignment: end;
                    Rectangle { width: 100px; height: 38px; border-radius: 19px; background: ydn.has-hover ? MusicTheme.hov2 : MusicTheme.surf1; border-width: 1px; border-color: MusicTheme.line;
