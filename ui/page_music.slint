                Text { text: "Refresh all stations?"; color: MusicTheme.fg; font-size: 18px; font-weight: 800; }
                Text { text: "This re-fetches every category from radio-browser and replaces the whole station cache. Needs network and takes a moment."; color: MusicTheme.fg-dim; font-size: 13px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { spacing: 10px; alignment: end;
