    // Transcript / show-notes panel (np.p5.music.podcast-feeds) — reuses the
    // lyrics-panel reading layout for episode notes.
    if root.podcast-transcript-open: Rectangle {
        width: 100%; height: 100%; background: #000000aa;
        TouchArea { clicked => { root.podcast-transcript-open = false; } }
        // Card height tracks the note length (capped at 82% of the window) so
        // short show-notes don't leave a tall empty box.
        Rectangle { width: 600px; height: Math.min(parent.height * 0.82, ntx.preferred-height + 148px);
            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            border-radius: 16px; background: MusicTheme.surf-pop; border-width: 1px; border-color: MusicTheme.line;
            drop-shadow-blur: 48px; drop-shadow-color: #000000ee;
            TouchArea {} // swallow clicks inside the card
            VerticalLayout { padding: 24px; spacing: 14px;
                HorizontalLayout { spacing: 10px;
                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                        Text { text: "Transcript"; color: MusicTheme.fg-mute; font-size: 11px; font-weight: 700; }
                        Text { text: root.podcast-transcript-title; color: MusicTheme.fg; font-size: 17px; font-weight: 800; overflow: elide; } }
                    PlayerBtn { icon: Icons.x; size: 30px; isz: 14px; clicked => { root.podcast-transcript-open = false; } } }
                Rectangle { height: 1px; background: MusicTheme.line; }
                ScrollView { vertical-stretch: 1;
                    VerticalLayout { padding-right: 8px;
                        ntx := Text { text: root.podcast-transcript-text == "" ? "No show notes for this episode." : root.podcast-transcript-text;
                            width: 544px; color: MusicTheme.fg3; font-size: 14px; wrap: word-wrap; } } }
            }
        }
    }

    // Podcast info card (Trends → click / right-click → Podcast info). Read-only
    // metadata; never loads the episode list — just count + latest date. Lets you
    // edit the category (Save) and replace the thumbnail, and Subscribe.
    if root.podcast-info-open: Rectangle {
        width: 100%; height: 100%; background: #000000aa;
        TouchArea { clicked => { root.podcast-info-open = false; } }
        FocusScope { width: 560px;
            // Dynamic height (user request 2026-06-12): size to the summary —
            // ~70 chars/line at 13px in a 510px column — so short summaries get
            // a tight card and long ones grow to a 640px cap (then scroll).
            property <int> desc-lines: Math.ceil(root.podcast-info-desc.character-count / 70);
            height: Math.clamp(300px + self.desc-lines * 18px, 360px, 640px);
            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            init => { self.focus(); }
            key-pressed(e) => { if (e.text == Key.Escape) { root.podcast-info-open = false; return accept; } return reject; }
            Rectangle { width: 100%; height: 100%; border-radius: 16px; background: MusicTheme.surf-pop;
                border-width: 1px; border-color: MusicTheme.line; drop-shadow-blur: 48px; drop-shadow-color: #000000ee; clip: true;
                TouchArea {}
                VerticalLayout { padding: 22px; spacing: 14px;
                    HorizontalLayout { spacing: 16px; alignment: start;
                        // Cover — click overlay to update the DB/cache thumbnail.
                        Rectangle { width: 132px; height: 132px; border-radius: 12px; clip: true; background: MusicTheme.surf-thumb;
                            border-width: 1px; border-color: MusicTheme.line;
                            if root.podcast-info-image.width == 0: AppIcon { source: Icons.mic; width: 44px; height: 44px; }
                            if root.podcast-info-image.width > 0: Image { source: root.podcast-info-image; image-fit: cover; width: 100%; height: 100%; }
                            ich := TouchArea { mouse-cursor: pointer; clicked => { root.podcast-info-set-thumb(); } }
                            Rectangle { width: 100%; height: 30px; y: parent.height - self.height; background: #000000bb; opacity: ich.has-hover ? 1 : 0; animate opacity { duration: 120ms; }
                                HorizontalLayout { alignment: center; spacing: 6px; VerticalLayout { alignment: center; AppIcon { source: Icons.pencil; tint: #ffffff; width: 10px; height: 10px; } } Text { text: "Update thumb"; color: #ffffff; font-size: 10px; font-weight: 700; vertical-alignment: center; } } } }
                        VerticalLayout { alignment: start; spacing: 6px; horizontal-stretch: 1;
                            Text { text: root.podcast-info-title; color: MusicTheme.fg; font-size: 20px; font-weight: 800; wrap: word-wrap; }
                            if root.podcast-info-author != "": Text { text: root.podcast-info-author; color: MusicTheme.fg2; font-size: 13px; overflow: elide; }
                            HorizontalLayout { spacing: 8px; alignment: start;
                                Rectangle { height: 24px; border-radius: 12px; background: MusicTheme.surf1; border-width: 1px; border-color: MusicTheme.line; horizontal-stretch: 0;
                                    HorizontalLayout { padding-left: 10px; padding-right: 10px;
                                        Text { text: root.podcast-info-loading ? "…" : (root.podcast-info-episodes + " episodes"); color: MusicTheme.fg2; font-size: 12px; font-weight: 700; vertical-alignment: center; } } }
                                if root.podcast-info-latest != "": Rectangle { height: 24px; border-radius: 12px; background: MusicTheme.surf1; border-width: 1px; border-color: MusicTheme.line; horizontal-stretch: 0;
                                    HorizontalLayout { padding-left: 10px; padding-right: 10px;
                                        Text { text: "Latest " + root.podcast-info-latest; color: MusicTheme.fg2; font-size: 12px; font-weight: 700; vertical-alignment: center; } } } }
                            // Editable category + Save.
                            Text { text: "Category"; color: MusicTheme.fg2; font-size: 12px; font-weight: 700; }
                            HorizontalLayout { spacing: 8px;
                                Rectangle { height: 34px; border-radius: 9px; background: MusicTheme.hov; border-width: 1px; border-color: cin.has-focus ? #8b5cf6 : MusicTheme.line; clip: true; horizontal-stretch: 1;
                                    HorizontalLayout { padding-left: 12px; padding-right: 12px;
                                        cin := TextInput { color: MusicTheme.fg; font-size: 13px; vertical-alignment: center; single-line: true; text <=> root.podcast-info-category;
                                            accepted => { root.podcast-info-save-category(); } } }
                                    if root.podcast-info-category == "": Text { text: "e.g. News"; color: MusicTheme.fg-mute; font-size: 13px; x: 12px; height: 100%; vertical-alignment: center; visible: !cin.has-focus; } }
                                Rectangle { width: 78px; height: 34px; border-radius: 17px; background: csv.has-hover ? #7c3aed : #8b5cf6;
                                    csv := TouchArea { mouse-cursor: pointer; clicked => { root.podcast-info-save-category(); } }
                                    Text { text: "Save"; color: #ffffff; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } } } }
                    if root.podcast-info-desc != "": ScrollView { vertical-stretch: 1;
                        VerticalLayout { padding-right: 6px;
                            Text { text: root.podcast-info-desc; width: 510px; color: MusicTheme.fg2; font-size: 13px; wrap: word-wrap; } } }
                    if root.podcast-info-desc == "": Rectangle { vertical-stretch: 1; }
                    HorizontalLayout { spacing: 10px; alignment: end;
                        Rectangle { width: 100px; height: 40px; border-radius: 20px; background: icc.has-hover ? MusicTheme.hov2 : MusicTheme.surf1; border-width: 1px; border-color: MusicTheme.line;
                            icc := TouchArea { mouse-cursor: pointer; clicked => { root.podcast-info-open = false; } }
                            Text { text: "Close"; color: MusicTheme.fg; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 150px; height: 40px; border-radius: 20px; clip: true;
                            background: root.podcast-info-subscribed ? #22c55e22 : (isb.has-hover ? #7c3aed : #8b5cf6);
                            border-width: root.podcast-info-subscribed ? 1px : 0px; border-color: #22c55e;
                            // Progress fill while subscribing.
                            if root.podcast-subscribing: Rectangle { x: 0; width: parent.width * Math.clamp(root.podcast-subscribe-frac, 0, 1); height: 100%;
                                background: @linear-gradient(90deg, #22c55e, #16a34a); }
                            isb := TouchArea { mouse-cursor: (root.podcast-info-subscribed || root.podcast-subscribing) ? default : pointer; clicked => { if (!root.podcast-info-subscribed && !root.podcast-subscribing) { root.podcast-info-subscribe(); } } }
                            HorizontalLayout { alignment: center; spacing: 6px; if !root.podcast-subscribing: VerticalLayout { alignment: center; AppIcon { source: root.podcast-info-subscribed ? Icons.check : Icons.plus; tint: root.podcast-info-subscribed ? #22c55e : #ffffff; width: 13px; height: 13px; } } Text { text: root.podcast-subscribing ? ("Adding… " + Math.round(root.podcast-subscribe-frac * 100) + "%") : (root.podcast-info-subscribed ? "Subscribed" : "Subscribe");
                                color: root.podcast-info-subscribed ? #22c55e : #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center; } } } }
                }
            }
        }
    }
}

// ── Full-screen player page ───────────────────────────────────────────────
// Left: large art + metadata + all transport/seek/volume controls.
// Right: tabbed Lyrics + Queue.
export component MusicFullscreen inherits Rectangle {
    in property <image> art;
    in property <color> accent: #ec4899;   // art-derived accent (vinyl fill, all themes)
    in property <string> title;
    in property <string> sub;
    in property <bool> playing;
    in property <float> pos;
    in property <float> dur;
    in property <string> pos-label;
    in property <string> dur-label;
    in property <float> volume;
    in property <bool> muted;
    in property <string> repeat;
    in property <bool> shuffle;
    in property <bool> np-loved;
    in property <int> np-stars;
    in property <[MusicSongRow]> queue-rows: [];
    in property <[MusicLyricLine]> lyrics-rows: [];
    in property <int> lyrics-active: -1;
    in-out property <string> tab: "lyrics";   // lyrics | queue
    in-out property <bool> flipped: false;     // art ↔ lyrics flip (np.p5.atmusic.art-flip-lyrics)
    in property <[float]> vis-bars: [];        // zen visualizer spectrum
    in-out property <int> vis-style: 0;        // shared visualizer style
    callback vis-style-changed(int);           // persist the chosen visualizer style
    in property <string> album: "";
    in-out property <string> zen-panel: "";    // "" | queue  (slide-in)
    in-out property <bool> zen-lyrics: false;  // inline 3-line synced lyrics
    // Podcast playback in the zen player — show a speed control.
    in property <bool> podcast-mode: false;
    in property <float> speed: 1.0;
    callback set-speed(float);
    callback open-now-album();
    callback open-now-artist();
    callback close();
    callback playpause();
    callback next();
    callback prev();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback play-queue(int);
    callback love();
    callback rate(int);
    // YouTube: current audio has a video → "Watch video" button.
    in property <bool> yt-now-video: false;
    callback watch-video();

    background: MusicTheme.surf-zen;
    // Ambient blurred art wash behind everything — stronger in light mode so it
    // still reads through the pale gradient (user request 2026-06-13).
    Image { source: art; image-fit: cover; width: 100%; height: 100%; opacity: MusicTheme.light ? 0.89 : 0.59; }
    Rectangle { width: 100%; height: 100%; background: @linear-gradient(180deg, MusicTheme.surf-zen-w1, MusicTheme.surf-zen-w2); }
    // Escape closes the queue panel / lyrics, then exits zen.
    zfs := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                // Single Esc always exits zen (closing any open panel with it).
                root.zen-panel = "";
                root.close();
                return accept;
            }
            // Playback shortcuts (player in focus).
            if (e.text == " ")             { root.playpause(); return accept; }
            if (e.text == Key.LeftArrow)   { root.seek(Math.max(0, root.pos - 5)); return accept; }
            if (e.text == Key.RightArrow)  { root.seek(Math.min(root.dur, root.pos + 5)); return accept; }
            if (e.text == Key.UpArrow)     { root.set-volume(Math.min(130, root.volume + 5)); return accept; }
            if (e.text == Key.DownArrow)   { root.set-volume(Math.max(0, root.volume - 5)); return accept; }
            if (e.text == "n")             { root.next(); return accept; }
            if (e.text == "p")             { root.prev(); return accept; }
            if (e.text == "m")             { root.toggle-mute(); return accept; }
            if (e.text == "l")             { root.zen-lyrics = !root.zen-lyrics; return accept; }
            if (e.text == "q")             { root.zen-panel = root.zen-panel == "queue" ? "" : "queue"; return accept; }
            return reject;
        }
    }

    // Main zen column.
    VerticalLayout {
        padding: 48px; spacing: 0px;
        // Top bar — exit + small now-playing tag.
        HorizontalLayout { height: 80px;
            VerticalLayout { alignment: center; PlayerBtn { icon: Icons.chevron-left; size: 80px; isz: 44px; clicked => { root.close(); } } }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout { alignment: center; Text { text: MusicTheme.light ? "ZEN · LIGHT" : (MusicTheme.oled ? "ZEN · OLED" : "ZEN · DARK"); color: MusicTheme.fg-dim; font-size: 13px; font-weight: 700; letter-spacing: 3px; } }
            Rectangle { horizontal-stretch: 1; }
            // Theme cycle — light → dark → OLED → light (np.p5.atmusic.oled).
            VerticalLayout { alignment: center; PlayerBtn {
                icon: MusicTheme.light ? Icons.sun : (MusicTheme.oled ? Icons.star : Icons.moon); size: 80px; isz: 40px;
                active: MusicTheme.oled;
                clicked => {
                    if (MusicTheme.light) { MusicTheme.light = false; }
                    else if (!MusicTheme.oled) { MusicTheme.oled = true; }
                    else { MusicTheme.light = true; MusicTheme.oled = false; }
                } } }
        }
        Rectangle { height: 24px; }
        // Title block — click title → album page, subtitle → artist page (the
        // middle visualizer/lyrics area stays non-clickable).
        VerticalLayout { spacing: 6px;
            Rectangle { height: 50px;
                tta := TouchArea { mouse-cursor: pointer; clicked => { if (!root.yt-now-video) { root.open-now-album(); } } }
                // Song art beside the title (user request 2026-06-12).
                HorizontalLayout { alignment: center; spacing: 14px;
                    if root.art.width > 0: VerticalLayout { alignment: center;
                        Rectangle { width: 46px; height: 46px; border-radius: 10px; clip: true;
                            horizontal-stretch: 0; vertical-stretch: 0;
                            Image { source: root.art; image-fit: cover; width: 100%; height: 100%; } } }
                    VerticalLayout { alignment: center;
                        Text { text: title == "" ? "Nothing playing" : title; color: tta.has-hover ? #ec4899 : MusicTheme.fg; font-size: 40px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } } } }
            Rectangle { height: 22px;
                sta := TouchArea { mouse-cursor: pointer; clicked => { if (!root.yt-now-video) { root.open-now-artist(); } } }
                Text { text: album == "" ? sub : sub + "   ·   " + album; color: sta.has-hover ? #ec4899 : MusicTheme.fg-dim; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; } } }
        // Big visualizer — selectable style, ~2× wide, centred.
        Rectangle { vertical-stretch: 1;
            VizView { width: Math.min(root.width - 120px, 1800px); height: parent.height - 20px;
                x: (parent.width - self.width) / 2; y: 10px;
                bars: root.vis-bars; style: root.vis-style; active: root.vis-bars.length > 0; } }
        // Inline 3-line synced lyrics (toggled by the lyrics control) — visualizer
        // compresses above to make room; current line big, neighbours dimmed.
        if root.zen-lyrics && !root.yt-now-video: VerticalLayout { spacing: 8px; padding-top: 10px; padding-bottom: 10px;
            Text { text: root.lyrics-active > 0 ? root.lyrics-rows[root.lyrics-active - 1].text : "";
                color: MusicTheme.fg-faint; font-size: 18px; horizontal-alignment: center; overflow: elide; }
            Text { text: (root.lyrics-active >= 0 && root.lyrics-rows.length > 0) ? root.lyrics-rows[root.lyrics-active].text : (root.lyrics-rows.length == 0 ? "No synced lyrics — use the lyrics button in the bottom player" : "");
                color: #ec4899; font-size: 28px; font-weight: 700; horizontal-alignment: center; overflow: elide;
                animate color { duration: 200ms; } }
            Text { text: (root.lyrics-active >= 0 && root.lyrics-active + 1 < root.lyrics-rows.length) ? root.lyrics-rows[root.lyrics-active + 1].text : "";
                color: MusicTheme.fg-faint; font-size: 18px; horizontal-alignment: center; overflow: elide; } }
        Rectangle { height: 24px; }
        // Seekbar.
        HorizontalLayout { spacing: 14px;
            VerticalLayout { alignment: center; Text { text: pos-label; color: MusicTheme.fg-dim; font-size: 13px; width: 48px; horizontal-alignment: right; } }
            VerticalLayout { alignment: center; horizontal-stretch: 1; Scrubber { value: pos; maximum: dur > 0 ? dur : 1.0; wiggle: true; changed(v) => { root.seek(v); } } }
            VerticalLayout { alignment: center; Text { text: dur-label; color: MusicTheme.fg-dim; font-size: 13px; width: 48px; } } }
        Rectangle { height: 16px; }
        // Media controls — lyrics (left) and queue (right) flank the transport.
        HorizontalLayout { alignment: center; spacing: 20px;
            if !root.yt-now-video: VerticalLayout { alignment: center; PlayerBtn { icon: Icons.lyrics; size: 44px; isz: 20px; active: root.zen-lyrics; clicked => { root.zen-lyrics = !root.zen-lyrics; } } }
            // Visualizer style selector — lives beside the lyrics toggle.
            VerticalLayout { alignment: center; Rectangle { width: 44px; height: 44px;
                PlayerBtn { icon: Icons.waveform; isz: 18px; size: 44px; clicked => { zvizpop.show(); } }
                zvizpop := PopupWindow { x: -64px; y: -156px; width: 168px; height: 138px; close-policy: close-on-click-outside;
                    Rectangle { width: 100%; height: 100%; border-radius: 14px; background: MusicTheme.surf-pop; border-width: 1px; border-color: MusicTheme.line;
                        drop-shadow-blur: 36px; drop-shadow-color: #000000e6;
                        VerticalLayout { padding: 8px; spacing: 2px;
                            for vs[i] in ["Bars", "Mirror", "Dots", "Levels", "Line"]: Rectangle { height: 24px; border-radius: 6px;
                                background: root.vis-style == i ? #ec489933 : (zvrow.has-hover ? MusicTheme.hov : transparent);
                                zvrow := TouchArea { mouse-cursor: pointer; clicked => { root.vis-style = i; root.vis-style-changed(i); zvizpop.close(); } }
                                HorizontalLayout { padding-left: 10px; padding-right: 10px;
                                    Text { text: vs; color: root.vis-style == i ? #ec4899 : MusicTheme.fg3; font-size: 12px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.vis-style == i: AppIcon { source: Icons.check; tint: #ec4899; width: 12px; height: 12px; } } } } } } } }
            if !root.yt-now-video: VerticalLayout { alignment: center; PlayerBtn { icon: Icons.heart; isz: 19px; active: np-loved; clicked => { root.love(); } } }
            VerticalLayout { alignment: center; PlayerBtn { icon: Icons.shuffle; isz: 20px; active: shuffle; clicked => { root.toggle-shuffle(); } } }
            VerticalLayout { alignment: center; PlayerBtn { icon: Icons.skip-back; isz: 26px; size: 50px; clicked => { root.prev(); } } }
            VerticalLayout { alignment: center;
                Rectangle { width: 70px; height: 70px; horizontal-stretch: 0; vertical-stretch: 0;
                    // Android-17 morph — circle squircles + glows on press.
                    border-radius: pbf.pressed ? 22px : 35px;
                    background: pbf.has-hover || pbf.pressed ? #ec4899 : #f0f0f3;
                    drop-shadow-blur: pbf.pressed ? 36px : 24px; drop-shadow-color: #ec489988;
                    animate background, border-radius, drop-shadow-blur { duration: 150ms; easing: ease-in-out; }
                    pbf := TouchArea { mouse-cursor: pointer; clicked => { root.playpause(); } }
                    AppIcon { source: playing ? Icons.pause : Icons.play; tint: #14141b; width: 28px; height: 28px; } } }
            VerticalLayout { alignment: center; PlayerBtn { icon: Icons.skip-forward; isz: 26px; size: 50px; clicked => { root.next(); } } }
            VerticalLayout { alignment: center; PlayerBtn { icon: repeat == "one" ? Icons.repeat-1 : Icons.repeat; isz: 20px; active: repeat != "off"; clicked => { root.cycle-repeat(); } } }
            if root.yt-now-video: VerticalLayout { alignment: center;
                YtWatchBtn { uiscale: 1.2; clicked => { root.watch-video(); } } }
            VerticalLayout { alignment: center; PlayerBtn { icon: muted ? Icons.volume-x : Icons.volume; isz: 17px; active: muted; clicked => { root.toggle-mute(); } } }
            VerticalLayout { alignment: center; Rectangle { width: 120px; height: 36px;
                Scrubber { y: (parent.height - self.height)/2; width: 120px; value: volume; maximum: 130.0; fill-color: MusicTheme.fg3; changed(v) => { root.set-volume(v); } } } }
            // Podcast playback speed cycle (zen player).
            if root.podcast-mode: VerticalLayout { alignment: center; Rectangle { width: 58px; height: 36px; border-radius: 18px;
                background: zsp.has-hover ? MusicTheme.surf1 : MusicTheme.surf0; border-width: 1px; border-color: MusicTheme.line;
                zsp := TouchArea { mouse-cursor: pointer; clicked => {
                    root.set-speed(root.speed >= 2.0 ? 1.0 : (root.speed >= 1.5 ? 2.0 : (root.speed >= 1.25 ? 1.5 : 1.25))); } }
                Text { text: root.speed + "×"; color: MusicTheme.fg2; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } }
            VerticalLayout { alignment: center; PlayerBtn { icon: Icons.list-music; isz: 20px; size: 44px; active: root.zen-panel == "queue"; clicked => { root.zen-panel = root.zen-panel == "queue" ? "" : "queue"; } } }
        }
    }

    // Slide-in Queue panel (lyrics are now inline; queue stays a side panel).
    // Click outside the zen queue panel closes it.
    if root.zen-panel != "": TouchArea {
        x: 0; y: 0; width: parent.width - 400px; height: parent.height;
        clicked => { root.zen-panel = ""; }
    }
    if root.zen-panel == "queue": Rectangle {
        width: 400px; height: parent.height; x: parent.width - self.width; y: 0;
        background: MusicTheme.surf-pop; border-width: 1px; border-color: MusicTheme.line;
        drop-shadow-blur: 50px; drop-shadow-color: #000000e6;
        TouchArea { width: 100%; height: 100%; }
        VerticalLayout { padding: 24px; spacing: 14px;
            HorizontalLayout {
                Text { text: root.zen-panel == "queue" ? "Up next" : "Lyrics"; color: MusicTheme.fg; font-size: 20px; font-weight: 700; }
                Rectangle { horizontal-stretch: 1; }
                PlayerBtn { icon: Icons.x; size: 32px; isz: 16px; clicked => { root.zen-panel = ""; } } }
            if root.zen-panel == "lyrics": ScrollView { vertical-stretch: 1;
                VerticalLayout { spacing: 5px;
                    if root.lyrics-rows.length == 0: Text { text: "No synced lyrics for this track."; color: MusicTheme.fg-dim; font-size: 14px; }
                    for l[i] in root.lyrics-rows: Text { text: l.text == "" ? "" : l.text;
                        color: i == root.lyrics-active ? #ec4899 : MusicTheme.fg-dim;
                        font-size: i == root.lyrics-active ? 20px : 15px;
                        font-weight: i == root.lyrics-active ? 700 : 400; wrap: word-wrap;
                        animate color, font-size { duration: 180ms; } } } }
            if root.zen-panel == "queue": ScrollView { vertical-stretch: 1;
                VerticalLayout { spacing: 2px;
                    if root.queue-rows.length == 0: Text { text: "Queue is empty."; color: MusicTheme.fg-dim; font-size: 14px; }
                    for s[i] in root.queue-rows: TrackRow { track: s; clicked => { root.play-queue(s.index); } } } }
        }
    }
}

// ── App-wide floating mini-player (draggable) ─────────────────────────────
// Seekbar + volume + transport + expandable queue. Bound to the same music
// state so it works on every section, not just the music page.
export component MusicMini inherits Rectangle {
    in property <image> art;
    in property <color> accent: #ec4899;   // art-derived accent (vinyl fill, all themes)
    in property <string> title;
    in property <string> sub;          // artist
    in property <string> album;
    in property <bool> playing;
    in property <float> pos;
    in property <float> dur;
    in property <string> pos-label;
    in property <string> dur-label;
    in property <bool> shuffle;
    in property <float> volume;
    in property <bool> muted;
    in property <[MusicSongRow]> queue-rows: [];
    in property <[MusicLyricLine]> lyrics-rows: [];
    in property <int> lyrics-active: -1;
    in-out property <string> face: "";   // "" art | queue | lyrics  (queue/lyrics buttons flip the art)
    callback close();
    callback minimise();                  // dock as a side bubble
    callback playpause();
    callback next();
    callback prev();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    in property <string> repeat: "off";
    callback play-queue(int);
    in property <bool> yt-now-video: false;
    callback watch-video();
    // Uniform content scale (1.0–3.0) so everything resizes with the window.
    in property <float> uiscale: 1.0;
    // Radio mode (np.p4.music.radio) — live stream: no queue/lyrics, and the
    // vinyl label becomes the station's letter tile when there's no favicon.
    in property <bool> radio-mode: false;
    in property <string> radio-initial: "";
    // Audiobook mode — the second line carries the book title (set as `sub`).
    in property <bool> book-mode: false;
    callback open-zen();                  // full-screen zen player
    in property <bool> bold-outline: true;   // thick gradient ring for visibility (toggle)

    width: 300px; height: 488px; border-radius: 18px;
    background: MusicTheme.surf-player;
    border-width: root.bold-outline ? 2px : 1px;
    border-color: root.bold-outline ? @linear-gradient(135deg, #ec4899, #8b5cf6 55%, #06b6d4) : MusicTheme.line;
    drop-shadow-blur: 42px; drop-shadow-color: #000000e6;
    VerticalLayout {
        // alignment:start collects any slack at the very bottom instead of
        // scattering uneven gaps between rows (np.p5.music.mini-uniform).
        padding: 14px * root.uiscale; spacing: 10px * root.uiscale; alignment: start;
        // 1. Close (left edge) · centered song title · bubble (right edge).
        HorizontalLayout { spacing: 4px * root.uiscale;
            PlayerBtn { icon: Icons.x; size: 26px * root.uiscale; isz: 13px * root.uiscale; clicked => { root.close(); } }
            VerticalLayout { alignment: center; horizontal-stretch: 1;
                Marquee { height: 20px * root.uiscale; centered: true; text: title == "" ? "Nothing playing" : title; fg: MusicTheme.fg; font-size: 15px * root.uiscale; weight: 700; } }
            PlayerBtn { icon: Icons.chevron-right; size: 26px * root.uiscale; isz: 14px * root.uiscale; clicked => { root.minimise(); } } }
        // 2. Second line by mode — music: artist · album; audiobook: book title;
        //    radio: a gradient LIVE pill (no song metadata leaks in).
        if root.radio-mode: HorizontalLayout { alignment: center;
            // Pill takes the art-derived thumb fill colour; shows the playing channel + Live.
            Rectangle { height: 18px * root.uiscale; border-radius: 9px * root.uiscale; horizontal-stretch: 0;
                background: @linear-gradient(120deg, root.accent.brighter(0.15), root.accent.darker(0.2));
                HorizontalLayout { padding-left: 9px * root.uiscale; padding-right: 10px * root.uiscale; spacing: 5px * root.uiscale;
                    VerticalLayout { alignment: center; Rectangle { width: 6px * root.uiscale; height: 6px * root.uiscale; border-radius: 3px * root.uiscale; background: #ffffff; } }
                    Text { text: (title == "" ? "Live" : title + "  ·  Live"); color: #ffffff; font-size: 10px * root.uiscale; font-weight: 800;
                        vertical-alignment: center; overflow: elide; } } } }
        if !root.radio-mode: Text {
            text: title == "" ? "Pick a track"
                : (root.book-mode ? sub : (album != "" ? sub + "  ·  " + album : sub));
            color: MusicTheme.fg3; font-size: 12px * root.uiscale; overflow: elide; horizontal-alignment: center; }
        // 3. Square art — flips to reveal the queue / 3-line lyrics panel. Radio
        //    drops the transport row below, so the art grows to fill that space
        //    and the mini keeps its exact frame size.
        Rectangle { height: (root.radio-mode ? 272px : 230px) * root.uiscale; border-radius: 12px * root.uiscale; clip: true; background: MusicTheme.surf-pop2;
            border-width: 1px; border-color: MusicTheme.surf1;
            // front — spinning vinyl record (art = center label) + sweeping tonearm.
            vinyl := Rectangle { width: 100%; height: 100%; visible: root.face == "";
                background: MusicTheme.surf-pop2;
                // Tonearm geometry — square coord system over the 222-unit disc; the
                // needle sweeps inward (12°→34°) as the track plays, parks at 2° idle.
                property <float> frac: root.dur > 0 ? Math.clamp(root.pos / root.dur, 0, 1) : 0;
                property <float> armdeg: root.playing ? (12 + 22 * self.frac) : 2;
                property <float> nx: 210 - 150 * Math.sin(self.armdeg * 1deg);
                property <float> ny: 16 + 150 * Math.cos(self.armdeg * 1deg);
                property <length> side: 222px * root.uiscale;
                property <length> offx: (self.width - self.side) / 2;
                property <length> offy: (self.height - self.side) / 2;
                // vinyl disc — concentric grooves (rotation-invariant); the art
                // label spins (rotation only works on Image in this Slint version).
                Rectangle { width: 222px * root.uiscale; height: self.width; border-radius: self.width / 2; clip: true;
                    // Remaining vinyl space tinted from the song-art accent (all themes):
                    // transparent under the centre art label, deepening to the rim.
                    background: @radial-gradient(circle, root.accent.with-alpha(0.22) 30%, root.accent.with-alpha(0.6) 62%, root.accent.with-alpha(0.92) 100%);
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    // groove rings
                    Rectangle { width: 202px * root.uiscale; height: self.width; border-radius: self.width / 2; border-width: 1px; border-color: MusicTheme.hov;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    Rectangle { width: 154px * root.uiscale; height: self.width; border-radius: self.width / 2; border-width: 1px; border-color: MusicTheme.line;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    // center label — circular album art, spinning (artwork +30%).
                    Rectangle { width: 146px * root.uiscale; height: self.width; border-radius: self.width / 2; clip: true;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        // Radio with no favicon — the station's letter tile is the label.
                        if root.radio-mode && art.width == 0: Rectangle {
                            background: @linear-gradient(135deg, #14b8a6, #0ea5e9);
                            Text { text: root.radio-initial; color: #ffffffd0; font-size: 52px * root.uiscale; font-weight: 800;
                                horizontal-alignment: center; vertical-alignment: center; } }
                        Image { source: art; image-fit: cover; width: 100%; height: 100%;
                            transform-rotation: root.playing ? Math.mod(animation-tick() / 1ms / 16, 360) * 1deg : 0deg; }
                        if title == "" && !root.radio-mode: AppIcon { source: Icons.music; tint: #ec4899; width: 44px * root.uiscale; height: 44px * root.uiscale; } }
                }
                // spindle hub (static center)
                Rectangle { width: 10px * root.uiscale; height: self.width; border-radius: self.width / 2; background: MusicTheme.surf-pop2; border-width: 1.5px; border-color: MusicTheme.fg-faint;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                // tonearm — the arm line from the pivot to the needle. Radio is
                // an endless live stream: no tonearm, the record just spins.
                if !root.radio-mode: Path { x: vinyl.offx; y: vinyl.offy; width: vinyl.side; height: vinyl.side;
                    viewbox-width: 222; viewbox-height: 222; stroke: MusicTheme.fg3; stroke-width: 3px;
                    MoveTo { x: 210; y: 16; } LineTo { x: vinyl.nx; y: vinyl.ny; } }
                // pivot base (counterweight) — top-right of the disc.
                if !root.radio-mode: Rectangle { width: 18px * root.uiscale; height: self.width; border-radius: self.width / 2;
                    background: MusicTheme.fg-mute; border-width: 2px; border-color: MusicTheme.surf-pop2;
                    x: vinyl.offx + 210 * root.uiscale * 1px - self.width / 2;
                    y: vinyl.offy + 16 * root.uiscale * 1px - self.height / 2; }
                // needle head (cartridge) — rides the groove.
                if !root.radio-mode: Rectangle { width: 13px * root.uiscale; height: self.width; border-radius: self.width / 2;
                    background: #ec4899; drop-shadow-blur: 6px; drop-shadow-color: #ec489988;
                    x: vinyl.offx + vinyl.nx * root.uiscale * 1px - self.width / 2;
                    y: vinyl.offy + vinyl.ny * root.uiscale * 1px - self.height / 2;
                    animate x, y { duration: 400ms; easing: ease-out; } }
                animate opacity { duration: 160ms; } }
            // back — queue (rows show their own thumb under the ▶ overlay;
            // audiobook chapters get the book cover filled in by the queue
            // builder on the Rust side).
            if root.face == "queue": ScrollView { width: 100%; height: 100%;
                VerticalLayout { spacing: 2px; padding: 6px;
                    if queue-rows.length == 0: Text { text: "Queue empty."; color: MusicTheme.fg-dim; font-size: 12px; }
                    for s[i] in queue-rows: TrackRow { track: s; clicked => { root.play-queue(s.index); } } } }
            // back — 3-line synced lyrics (prev / current / next).
            if root.face == "lyrics": VerticalLayout { spacing: 14px; padding: 18px; alignment: center;
                Text { text: lyrics-active > 0 ? lyrics-rows[lyrics-active - 1].text : ""; color: MusicTheme.fg-faint; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: (lyrics-active >= 0 && lyrics-rows.length > 0) ? lyrics-rows[lyrics-active].text : (lyrics-rows.length == 0 ? "No synced lyrics" : "");
                    color: #ec4899; font-size: 20px; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: (lyrics-active >= 0 && lyrics-active + 1 < lyrics-rows.length) ? lyrics-rows[lyrics-active + 1].text : ""; color: MusicTheme.fg-faint; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; } }
            // little flip hint
            if root.face != "": AppIcon { source: Icons.refresh-cw; tint: #ffffff66; width: 14px; height: 14px; x: parent.width - 24px; y: 8px; }
            // YouTube "watch video" — blinking red round button, stuck to the
            // bottom-right edge of the vinyl card (no padding).
            if root.yt-now-video && !root.radio-mode: YtWatchBtn { uiscale: root.uiscale;
                x: parent.width - self.width; y: parent.height - self.height;
                clicked => { root.watch-video(); } } }
        // 4. Seekbar with elapsed / total time, then music controls.
        Scrubber { value: pos; maximum: dur > 0 ? dur : 1.0; wiggle: true; changed(v) => { root.seek(v); } }
        HorizontalLayout {
            Text { text: pos-label; color: MusicTheme.fg-dim; font-size: 10px * root.uiscale; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: dur-label; color: MusicTheme.fg-dim; font-size: 10px * root.uiscale; } }
        if !root.radio-mode: HorizontalLayout { alignment: center; spacing: 12px * root.uiscale;
            PlayerBtn { icon: Icons.shuffle; size: 32px * root.uiscale; isz: 16px * root.uiscale; active: root.shuffle; clicked => { root.toggle-shuffle(); } }
            PlayerBtn { icon: Icons.skip-back; size: 38px * root.uiscale; isz: 19px * root.uiscale; clicked => { root.prev(); } }
            Rectangle { width: 48px * root.uiscale; height: self.width; border-radius: self.width / 2; horizontal-stretch: 0; vertical-stretch: 0;
                background: mpb.has-hover ? #ec4899 : #f0f0f3; animate background { duration: 150ms; }
                mpb := TouchArea { mouse-cursor: pointer; clicked => { root.playpause(); } }
                AppIcon { source: playing ? Icons.pause : Icons.play; tint: #14141b; width: 20px * root.uiscale; height: 20px * root.uiscale; } }
            PlayerBtn { icon: Icons.skip-forward; size: 38px * root.uiscale; isz: 19px * root.uiscale; clicked => { root.next(); } }
            PlayerBtn { icon: root.repeat == "one" ? Icons.repeat-1 : Icons.repeat; size: 32px * root.uiscale; isz: 16px * root.uiscale; active: root.repeat != "off"; clicked => { root.cycle-repeat(); } } }
        // 5. Queue · volume · lyrics (queue/lyrics flip the art above) · zen at
        // the right edge. Live radio runs a SINGLE control row instead:
        // play · volume · zen (no transport — streams have no prev/next/seek).
        HorizontalLayout { alignment: center; spacing: 8px * root.uiscale;
            if root.radio-mode: VerticalLayout { alignment: center;
                Rectangle { width: 48px * root.uiscale; height: self.width; border-radius: self.width / 2; horizontal-stretch: 0; vertical-stretch: 0;
                    background: (playing || rpb.has-hover) ? #ef4444 : #f0f0f3; animate background { duration: 150ms; }
                    rpb := TouchArea { mouse-cursor: pointer; clicked => { root.playpause(); } }
                    AppIcon { source: playing ? Icons.pause : Icons.play; tint: (playing || rpb.has-hover) ? #ffffff : #14141b; width: 20px * root.uiscale; height: 20px * root.uiscale; } } }
            if !root.radio-mode: VerticalLayout { alignment: center; PlayerBtn { icon: Icons.list-music; size: 32px * root.uiscale; isz: 16px * root.uiscale; active: root.face == "queue"; clicked => { root.face = root.face == "queue" ? "" : "queue"; } } }
            VerticalLayout { alignment: center; PlayerBtn { icon: muted ? Icons.volume-x : Icons.volume; size: 30px * root.uiscale; isz: 15px * root.uiscale; active: muted; clicked => { root.toggle-mute(); } } }
            VerticalLayout { alignment: center; Rectangle { width: 96px * root.uiscale; height: 30px * root.uiscale;
                Scrubber { y: (parent.height - self.height)/2; width: 96px * root.uiscale; value: volume; maximum: 130.0; fill-color: MusicTheme.fg3; changed(v) => { root.set-volume(v); } } } }
            if !root.radio-mode && !root.yt-now-video: VerticalLayout { alignment: center; PlayerBtn { icon: Icons.lyrics; size: 32px * root.uiscale; isz: 16px * root.uiscale; active: root.face == "lyrics"; clicked => { root.face = root.face == "lyrics" ? "" : "lyrics"; } } }
            VerticalLayout { alignment: center; PlayerBtn { icon: Icons.maximize; size: 32px * root.uiscale; isz: 16px * root.uiscale; clicked => { root.open-zen(); } } } }
    }
}

// Podcast-centric bottom player (np.p5.music.podcast-feeds). Same floating frame
// as MusicMini but tuned for spoken word: square cover (no vinyl), -15s / +30s
// skips, playback-speed cycle, and an episodes/notes flip instead of lyrics.
export component PodcastMini inherits Rectangle {
    in property <image> art;
    in property <color> accent: #8b5cf6;
    in property <string> title;
    in property <string> sub;            // owning show
    in property <bool> playing;
    in property <float> pos;
    in property <float> dur;
    in property <string> pos-label;
    in property <string> dur-label;
    in property <float> speed: 1.0;
    in property <float> volume: 100;
    in property <bool> muted;
    in property <string> summary: "";       // podcast description (scrollable show notes)
    in property <[PodcastEpisodeRow]> episodes: [];
    in-out property <string> face: "";   // "" disc | episodes | summary
    in property <float> uiscale: 1.0;
    callback close();
    callback minimise();
    callback playpause();
    callback skip(int);                  // seconds, +/-
    callback seek(float);
    callback set-speed(float);
    callback set-volume(float);
    callback toggle-mute();
    callback play-episode(int);
    callback open-zen();                 // full-screen zen player
    in property <bool> bold-outline: true;   // thick gradient ring for visibility (toggle)

    width: 300px; height: 442px; border-radius: 18px;
    background: MusicTheme.surf-player;
    border-width: root.bold-outline ? 2px : 1px;
    border-color: root.bold-outline ? @linear-gradient(135deg, #8b5cf6, #ec4899 55%, #06b6d4) : MusicTheme.line;
    drop-shadow-blur: 42px; drop-shadow-color: #000000e6;
    VerticalLayout {
        padding: 14px * root.uiscale; spacing: 8px * root.uiscale;
        // 1. Close · title · minimise.
        HorizontalLayout { spacing: 4px * root.uiscale;
            PlayerBtn { icon: Icons.x; size: 26px * root.uiscale; isz: 13px * root.uiscale; clicked => { root.close(); } }
            VerticalLayout { alignment: center; horizontal-stretch: 1;
                Marquee { height: 20px * root.uiscale; centered: true; text: title == "" ? "Nothing playing" : title; fg: MusicTheme.fg; font-size: 15px * root.uiscale; weight: 700; } }
            PlayerBtn { icon: Icons.chevron-right; size: 26px * root.uiscale; isz: 14px * root.uiscale; clicked => { root.minimise(); } } }
        // 2. Show name.
        Text { text: title == "" ? "Pick an episode" : sub; color: MusicTheme.fg3; font-size: 12px * root.uiscale; overflow: elide; horizontal-alignment: center; }
        // 3. Spinning vinyl disc (podcast thumb as the centre label); flips to
        //    episodes / summary. WIDE full-width box so the episode/summary faces
        //    read well (not cramped in a small square); the vinyl stays centred.
        Rectangle { height: 200px * root.uiscale; border-radius: 12px * root.uiscale; clip: true; background: MusicTheme.surf-pop2;
            border-width: 1px; border-color: MusicTheme.surf1;
            if root.face == "": Rectangle { width: 100%; height: 100%;
                // vinyl disc
                Rectangle { width: 172px * root.uiscale; height: self.width; border-radius: self.width / 2; clip: true;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    background: @radial-gradient(circle, root.accent.with-alpha(0.22) 30%, root.accent.with-alpha(0.6) 62%, root.accent.with-alpha(0.92) 100%);
                    Rectangle { width: 120px * root.uiscale; height: self.width; border-radius: self.width / 2; clip: true;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        if art.width > 0: Image { source: art; image-fit: cover; width: 100%; height: 100%;
                            transform-rotation: root.playing ? Math.mod(animation-tick() / 1ms / 16, 360) * 1deg : 0deg; }
                        if art.width == 0: AppIcon { source: Icons.mic; tint: #ffffff; width: 40px * root.uiscale; height: 40px * root.uiscale; } }
                    // spindle hub
                    Rectangle { width: 10px * root.uiscale; height: self.width; border-radius: self.width / 2; background: MusicTheme.surf-pop2; border-width: 1.5px; border-color: MusicTheme.fg-faint;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } } }
            if root.face == "episodes": ScrollView { width: 100%; height: 100%;
                VerticalLayout { spacing: 2px; padding: 6px;
                    if episodes.length == 0: Text { text: "No episodes."; color: MusicTheme.fg-dim; font-size: 12px; }
                    for e[i] in episodes: Rectangle { height: 40px; border-radius: 8px;
                        background: erow.has-hover ? MusicTheme.hov : transparent;
                        erow := TouchArea { mouse-cursor: pointer; clicked => { root.play-episode(e.id); } }
                        HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px;
                            VerticalLayout { alignment: center; AppIcon { source: e.played ? Icons.check : Icons.play; tint: e.played ? #22c55e : MusicTheme.fg3; width: 12px; height: 12px; } }
                            VerticalLayout { alignment: center; horizontal-stretch: 1;
                                Text { text: e.title; color: MusicTheme.fg; font-size: 12px; overflow: elide; } } } } } }
            // Summary — full show notes, wrapped line-by-line + vertically scrollable.
            if root.face == "summary": VerticalLayout { padding: 12px; spacing: 8px;
                Text { text: "SHOW SUMMARY"; color: MusicTheme.fg-mute; font-size: 10px; font-weight: 700; horizontal-alignment: center; }
                ScrollView { vertical-stretch: 1; horizontal-stretch: 1;
                    VerticalLayout { width: root.width - 64px; alignment: start;
                        Text { text: summary == "" ? "No summary available." : summary; color: MusicTheme.fg3;
                            font-size: 12px; wrap: word-wrap; } } } }
            if root.face != "": AppIcon { source: Icons.refresh-cw; tint: #ffffff66; width: 14px; height: 14px; x: parent.width - 24px; y: 8px; } }
        // Flexible gap — drops the seek + both control rows to the bottom so they
        // always sit together and fit, whatever the mini's height.
        Rectangle { vertical-stretch: 1; }
        // 4. Seekbar.
        Scrubber { value: pos; maximum: dur > 0 ? dur : 1.0; changed(v) => { root.seek(v); } }
        HorizontalLayout {
            Text { text: pos-label; color: MusicTheme.fg-dim; font-size: 10px * root.uiscale; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: dur-label; color: MusicTheme.fg-dim; font-size: 10px * root.uiscale; } }
        // 5. Transport — -15s · play/pause · +30s · speed. All same height
        //    (level), each with a 1px outline so they read as a matched set of 4.
        HorizontalLayout { alignment: center; spacing: 14px * root.uiscale;
            VerticalLayout { alignment: center;
                Rectangle { width: 48px * root.uiscale; height: 48px * root.uiscale; border-radius: self.height / 2; horizontal-stretch: 0;
                    background: b15.has-hover ? MusicTheme.surf1 : transparent;
                    border-width: 1px; border-color: MusicTheme.line;
                    b15 := TouchArea { mouse-cursor: pointer; clicked => { root.skip(-15); } }
                    HorizontalLayout { alignment: center; spacing: 1px; VerticalLayout { alignment: center; AppIcon { source: Icons.rotate-ccw; tint: MusicTheme.fg2; width: 13px * root.uiscale; height: 13px * root.uiscale; } } Text { text: "15"; color: MusicTheme.fg2; font-size: 13px * root.uiscale; font-weight: 700; vertical-alignment: center; } } } }
            VerticalLayout { alignment: center;
                Rectangle { width: 56px * root.uiscale; height: 48px * root.uiscale; border-radius: self.height / 2; horizontal-stretch: 0;
                    background: ppb.has-hover ? root.accent : #f0f0f3; animate background { duration: 150ms; }
                    border-width: 1px; border-color: MusicTheme.line;
                    ppb := TouchArea { mouse-cursor: pointer; clicked => { root.playpause(); } }
                    AppIcon { source: playing ? Icons.pause : Icons.play; tint: #14141b; width: 22px * root.uiscale; height: 22px * root.uiscale; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; } } }
            VerticalLayout { alignment: center;
                Rectangle { width: 48px * root.uiscale; height: 48px * root.uiscale; border-radius: self.height / 2; horizontal-stretch: 0;
                    background: b30.has-hover ? MusicTheme.surf1 : transparent;
                    border-width: 1px; border-color: MusicTheme.line;
                    b30 := TouchArea { mouse-cursor: pointer; clicked => { root.skip(30); } }
                    HorizontalLayout { alignment: center; spacing: 1px; Text { text: "30"; color: MusicTheme.fg2; font-size: 13px * root.uiscale; font-weight: 700; vertical-alignment: center; } VerticalLayout { alignment: center; AppIcon { source: Icons.rotate-cw; tint: MusicTheme.fg2; width: 13px * root.uiscale; height: 13px * root.uiscale; } } } } }
            // Speed cycle — promoted from the bottom bar so the 4 transport
            // controls sit centered as one set.
            VerticalLayout { alignment: center;
                Rectangle { width: 48px * root.uiscale; height: 48px * root.uiscale; border-radius: self.height / 2; horizontal-stretch: 0;
                    background: spc.has-hover ? MusicTheme.surf1 : transparent;
                    border-width: 1px; border-color: MusicTheme.line;
                    spc := TouchArea { mouse-cursor: pointer; clicked => {
                        root.set-speed(root.speed >= 2.0 ? 0.75 : (root.speed >= 1.5 ? 2.0 : (root.speed >= 1.25 ? 1.5 : (root.speed >= 1.0 ? 1.25 : 1.0)))); } }
                    Text { text: root.speed + "×"; color: MusicTheme.fg2; font-size: 13px * root.uiscale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } } }
        // 6. Bottom bar — episodes · mute+volume · summary · zen.
        HorizontalLayout { alignment: center; spacing: 8px * root.uiscale;
            PlayerBtn { icon: Icons.list-music; size: 32px * root.uiscale; isz: 16px * root.uiscale; active: root.face == "episodes"; clicked => { root.face = root.face == "episodes" ? "" : "episodes"; } }
            PlayerBtn { icon: muted ? Icons.volume-x : Icons.volume; size: 30px * root.uiscale; isz: 15px * root.uiscale; active: muted; clicked => { root.toggle-mute(); } }
            Rectangle { width: 76px * root.uiscale; height: 30px * root.uiscale;
                Scrubber { y: (parent.height - self.height)/2; width: 76px * root.uiscale; value: volume; maximum: 130.0; fill-color: MusicTheme.fg3; changed(v) => { root.set-volume(v); } } }
            PlayerBtn { icon: Icons.lyrics; size: 32px * root.uiscale; isz: 16px * root.uiscale; active: root.face == "summary"; clicked => { root.face = root.face == "summary" ? "" : "summary"; } }
            PlayerBtn { icon: Icons.maximize; size: 32px * root.uiscale; isz: 16px * root.uiscale; clicked => { root.open-zen(); } } }
    }
}
