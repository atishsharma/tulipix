                        Text { text: "Cancel"; color: MusicTheme.fg; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { width: 110px; height: 38px; border-radius: 19px; background: ydy.has-hover ? #dc2626 : #ef4444;
                        ydy := TouchArea { mouse-cursor: pointer; clicked => { if (root.yt-del-kind == "cached") { root.yt-remove-cached(root.yt-del-id); } else { root.yt-remove-download(root.yt-del-id); } root.yt-del-open = false; } }
                        Text { text: "Delete"; color: #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } }
            }
        }
