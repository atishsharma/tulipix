                Text { text: "Removes every subscription, all episodes and downloaded files. This cannot be undone."; color: MusicTheme.fg-dim; font-size: 13px; wrap: word-wrap; }
                Text { text: "Type yes to confirm:"; color: MusicTheme.fg-mute; font-size: 12px; }
                Rectangle { height: 42px; border-radius: 10px; background: MusicTheme.hov; border-width: 1px;
                    border-color: rcin.has-focus ? #ef4444 : MusicTheme.line; clip: true;
                    HorizontalLayout { padding-left: 14px; padding-right: 14px;
                        rcin := TextInput { color: MusicTheme.fg; font-size: 13px; vertical-alignment: center; single-line: true; text <=> root.reset-confirm-text;
                            accepted => { if (root.reset-confirm-text == "yes") { root.reset-confirm-open = false; root.podcast-reset-all(); } } } }
                    if root.reset-confirm-text == "": Text { text: "yes"; color: MusicTheme.fg-mute; font-size: 13px; x: 14px; height: 100%; vertical-alignment: center; visible: !rcin.has-focus; } }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { spacing: 10px; alignment: end;
                    Rectangle { width: 100px; height: 40px; border-radius: 20px; background: rcc.has-hover ? MusicTheme.hov2 : MusicTheme.surf1; border-width: 1px; border-color: MusicTheme.line;
                        rcc := TouchArea { mouse-cursor: pointer; clicked => { root.reset-confirm-open = false; } }
                        Text { text: "Cancel"; color: MusicTheme.fg; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { width: 140px; height: 40px; border-radius: 20px; opacity: root.reset-confirm-text == "yes" ? 1.0 : 0.5;
                        background: rcy.has-hover && root.reset-confirm-text == "yes" ? #dc2626 : #ef4444;
                        rcy := TouchArea { mouse-cursor: pointer; clicked => { if (root.reset-confirm-text == "yes") { root.reset-confirm-open = false; root.podcast-reset-all(); } } }
                        Text { text: "Clear all"; color: #ffffff; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } } }
            }
            }
        }
    }

