                        HorizontalLayout { alignment: center; spacing: 6px; VerticalLayout { alignment: center; AppIcon { source: Icons.refresh-cw; tint: #ffffff; width: 13px; height: 13px; } } Text { text: "Refresh"; color: #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center; } } } }
