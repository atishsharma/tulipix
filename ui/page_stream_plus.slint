// Videos → Stream Plus. The anime lane and the second provider stack.
//
// Deliberately NOT a second app: the tokens, the tab component and the kind
// row all come from page_videos.slint, so the chrome is the videos section's
// chrome and only the body below it is new. Live TV set this precedent — a
// page that replaces the Videos body has to carry the kind tabs itself, or
// there is no way back to the library.
//
// No logic lives here. Every list is pushed from tulipix_sec_videos::splus and
// every action is a callback out.

import { Theme } from "tokens.slint";
import { Surface, Skin } from "surface.slint";
import { Icons, AppIcon } from "icons.slint";
import { VP, VideoTab, SortChip } from "page_videos.slint";

// ── rows the backend pushes ───────────────────────────────────────────────

// One poster in any grid or shelf. `badge` is the format ("TV" / "MOVIE"),
// `note` the line under the title.
export struct SPlusCard {
    key: string,
    title: string,
    note: string,
    poster: image,
    badge: string,
    progress: float,
    saved: bool,
    blocked: bool,   // hidden by the age gate — drawn as a locked card
}

export struct SPlusEpisode {
    number: int,
    title: string,
    thumb: image,
    progress: float,
}

// One resolved file. `index` maps back to the list held in Rust.
export struct SPlusFile {
    index: int,
    label: string,      // "1080p · AllManga"
    sub: string,        // "412 MB · h264"
    uploader: string,
    subs: string,       // "3 subs" / "No subs"
    has-subs: bool,
    failed: bool,       // the source answered, with nothing
    note: string,       // why, when it failed
}

export struct SPlusChip { id: string, label: string, active: bool }

export struct SPlusHistory {
    key: string,
    title: string,
    kind: string,      // "Series · S02E07" / "Movie"
    state: string,     // "62% · 18 min left" / "Watched"
    when: string,
    detail: string,    // "AllManga · dub · 1080p"
    poster: image,
    progress: float,
    finished: bool,
}

export struct SPlusDownload {
    id: int,
    title: string,     // "Frieren · S01E14 · 1080p"
    state: string,     // Downloading / Waiting / Saved / Failed / Missing
    detail: string,
    progress: float,
    active: bool,
    done: bool,
    failed: bool,
}

export struct SPlusHealth {
    source: string,
    label: string,
    note: string,      // "1.1 s" / "403 forbidden"
    ok: bool,
    enabled: bool,
    sunk: bool,        // serving its hour at the bottom
}

// ── local pieces ──────────────────────────────────────────────────────────

component ShelfHead inherits Rectangle {
    in property <string> label;
    in property <string> note;
    height: 22px;
    background: transparent;
    HorizontalLayout {
        spacing: 10px; alignment: start;
        VerticalLayout { alignment: center;
            Text { text: root.label; color: VP.text-mute; font-size: 10.5px;
                font-weight: 800; letter-spacing: 1.4px; } }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout { alignment: center;
            Text { text: root.note; color: VP.text-mute; font-size: 11px; } }
    }
}

// The poster used by every grid and shelf on this page.
component SPlusPoster inherits Skin {
    in property <SPlusCard> card;
    in property <length> w: 146px;
    callback clicked();
    width: root.w;
    height: root.w * 1.5 + 42px;
    background: transparent;
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: root.w * 1.5;
            border-radius: Surface.rr(9px, self.width, self.height);
            background: VP.well;
            border-width: 1px;
            border-color: ta.has-hover ? VP.accent-66 : VP.hair;
            clip: true;
            if root.card.poster.width > 0: Image {
                source: root.card.poster; image-fit: cover;
                width: 100%; height: 100%;
            }
            if root.card.poster.width == 0: AppIcon {
                source: root.card.blocked ? Icons.lock : Icons.film;
                tint: VP.ph-icon; width: 26px; height: 26px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            if root.card.badge != "": Rectangle {
                x: 7px; y: 7px; width: bl.preferred-width + 14px; height: 19px;
                border-radius: Surface.rr(5px, self.width, self.height);
                background: root.card.badge == "MOVIE" ? VP.c-back : VP.c-info;
                bl := Text { text: root.card.badge; color: #ffffff;
                    font-size: 9px; font-weight: 800; letter-spacing: 0.6px;
                    width: 100%; height: 100%;
                    horizontal-alignment: center; vertical-alignment: center; }
            }
            if root.card.saved: Rectangle {
                x: parent.width - self.width - 7px; y: 7px;
                width: 22px; height: 22px;
                border-radius: Surface.rr(6px, self.width, self.height);
                background: VP.c-save;
                AppIcon { source: Icons.bookmark; tint: #ffffff;
                    width: 11px; height: 11px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2; }
            }
            if root.card.progress > 0.01: Rectangle {
                x: 0; y: parent.height - 3px; width: parent.width; height: 3px;
                background: #00000073;
                Rectangle { x: 0; y: 0; height: parent.height;
                    width: parent.width * Math.clamp(root.card.progress, 0, 1);
                    background: VP.c-play; }
            }
            ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
        }
        Text { text: root.card.title; color: VP.text; font-size: 13px;
            font-weight: 600; wrap: word-wrap; overflow: elide; height: 17px; }
        Text { text: root.card.note; color: VP.text-mute; font-size: 11.5px;
            overflow: elide; height: 15px; }
    }
}

component SPlusToggle inherits Skin {
    in property <string> label;
    in property <string> note;
    in property <bool> on;
    callback toggled(bool);
    height: 46px;
    background: transparent;
    HorizontalLayout {
        spacing: 14px; alignment: stretch;
        VerticalLayout {
            alignment: center; horizontal-stretch: 1; spacing: 2px;
            Text { text: root.label; color: VP.text; font-size: 13.5px; font-weight: 600; }
            if root.note != "": Text { text: root.note; color: VP.text-mute;
                font-size: 11.5px; overflow: elide; }
        }
        VerticalLayout { alignment: center; horizontal-stretch: 0;
            Rectangle {
                width: 40px; height: 22px;
                border-radius: Surface.rr(11px, self.width, self.height);
                background: root.on ? VP.accent : VP.well;
                border-width: 1px; border-color: root.on ? transparent : VP.hair;
                animate background { duration: 120ms; easing: ease-out; }
                Rectangle {
                    x: root.on ? parent.width - self.width - 3px : 3px;
                    y: 3px; width: 16px; height: 16px;
                    border-radius: Surface.rr(8px, self.width, self.height);
                    background: root.on ? #ffffff : VP.ph-icon;
                    animate x { duration: 120ms; easing: ease-out; }
                }
                TouchArea { mouse-cursor: pointer;
                    clicked => { root.toggled(!root.on); } }
            }
        }
    }
}

// A small labelled action, in the section's language.
component SPlusBtn inherits Skin {
    in property <string> label;
    in property <image> icon;
    in property <color> hue: VP.accent;
    in property <bool> filled: true;
    in property <bool> compact: false;
    callback clicked();
    height: root.compact ? 32px : 38px;
    width: lay.preferred-width + (root.compact ? 22px : 30px);
    border-radius: Surface.rr(9px, self.width, self.height);
    background: root.filled
        ? (ta.has-hover ? root.hue.brighter(0.18) : root.hue)
        : (ta.has-hover ? VP.glass-2 : VP.glass);
    border-width: root.filled ? 0px : 1px;
    border-color: VP.hair-2;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    lay := HorizontalLayout {
        alignment: center; spacing: 7px;
        if root.icon.width > 0: VerticalLayout { alignment: center;
            AppIcon { source: root.icon; tint: root.filled ? #ffffff : VP.text;
                width: 15px; height: 15px; } }
        VerticalLayout { alignment: center;
            Text { text: root.label; color: root.filled ? #ffffff : VP.text;
                font-size: root.compact ? 12.5px : 13.5px; font-weight: 700; } }
    }
}

component SPlusChipView inherits Skin {
    in property <string> label;
    in property <bool> active;
    in property <color> hue: VP.accent;
    callback clicked();
    height: 28px;
    width: t.preferred-width + 24px;
    border-radius: Surface.rr(14px, self.width, self.height);
    background: root.active ? root.hue.with-alpha(0.16)
        : (ta.has-hover ? VP.glass-2 : VP.glass);
    border-width: 1px;
    border-color: root.active ? root.hue.with-alpha(0.5) : VP.hair;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    t := Text {
        text: root.label; color: root.active ? root.hue : VP.text-dim;
        font-size: 12.5px; font-weight: 600;
        width: 100%; height: 100%;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <color> hue: VP.c-dl;
    height: 5px;
    border-radius: Surface.rr(3px, self.width, self.height);
    background: VP.well;
    clip: true;
    Rectangle {
        x: 0; y: 0; height: parent.height;
        width: parent.width * Math.clamp(root.value, 0, 1);
        border-radius: parent.border-radius;
        background: root.hue;
    }
}

// ── the page ──────────────────────────────────────────────────────────────

export component StreamPlusPage inherits Rectangle {
    background: VP.bg;

    // Which video kind is on screen. Carried so this page can draw the kind row
    // itself — it replaces the whole Videos body, exactly like Live TV.
    in property <string> kind: "splus";
    callback set-kind(string);

    // home | search | detail | library | downloads | settings
    in-out property <string> view: "home";
    // The Servers modal floats over whatever view is on.
    in-out property <bool> servers-open: false;

    in property <bool> busy: false;
    in property <string> status: "";

    // ── search ──
    in-out property <string> query: "";
    in property <[SPlusCard]> results: [];
    in property <int> results-total: 0;
    in property <bool> results-more: false;
    in property <[string]> suggestions: [];
    in property <[string]> recent: [];
    in-out property <string> lane: "anime";   // anime | movie | tv
    callback search(string);
    callback suggest(string);
    callback load-more();
    callback recent-clear();

    // ── home shelves ──
    in property <[SPlusCard]> featured: [];
    in-out property <int> featured-idx: 0;
    in property <[SPlusHistory]> continue-rows: [];
    in property <[SPlusCard]> trending: [];
    in property <[SPlusCard]> seasonal: [];
    in property <string> season-label: "";
    callback home-load();

    // ── detail ──
    in property <string> d-title: "";
    in property <string> d-meta: "";
    in property <string> d-overview: "";
    in property <image> d-cover;
    in property <string> d-badge: "TV";
    in property <bool> d-saved: false;
    in property <string> d-skip-note: "";
    in property <[SPlusChip]> d-audio: [];
    in property <[SPlusChip]> d-seasons: [];
    in property <[SPlusEpisode]> d-episodes: [];
    in property <[SPlusFile]> d-files: [];
    in property <[SPlusChip]> d-subs: [];
    in property <int> d-episode: 1;
    in property <int> d-file: 0;
    in property <string> d-resolved: "";
    in property <bool> d-resolving: false;
    callback open-card(string);
    callback back();
    callback set-audio(string);
    callback set-season(string);
    callback set-episode(int);
    callback set-file(int);
    callback set-sub(string);
    callback play();
    callback download();
    callback download-season();
    callback toggle-save();
    callback copy-link();
    callback cast();
    callback add-to-library();
    callback retry-source(string);

    // ── library ──
    in property <[SPlusCard]> saved: [];
    in property <[SPlusHistory]> history: [];
    in-out property <string> sort: "added";
    in-out property <string> lib-tab: "saved";
    callback library-load();
    callback set-sort(string);
    callback saved-remove(string);
    callback history-play(string);
    callback history-remove(string);
    callback history-clear();

    // ── downloads ──
    in property <[SPlusDownload]> downloads: [];
    in property <int> dl-active: 0;
    in property <string> dl-rate: "";
    callback downloads-load();
    callback dl-cancel(int);
    callback dl-retry(int);
    callback dl-play(int);
    callback dl-reveal(int);
    callback dl-delete(int);
    callback dl-cancel-all();
    callback dl-clear();

    // ── settings ──
    in property <[SPlusHealth]> health: [];
    in-out property <string> audio-pref: "sub_then_dub";
    in-out property <bool> skip-op-ed: true;
    in-out property <int> watched-pct: 90;
    in-out property <int> autoplay-secs: 10;
    in-out property <bool> hide-finished: false;
    in-out property <bool> subs-wyzie: true;
    in-out property <bool> subs-subdl: false;
    in-out property <string> subs-lang: "en";
    in-out property <bool> subs-with-file: true;
    in-out property <int> quality: 1080;
    in-out property <bool> into-library: true;
    in-out property <int> slots: 2;
    in-out property <bool> notify-download: true;
    in-out property <bool> notify-episode: true;
    in property <string> download-dir: "";
    callback settings-load();
    callback set-source-enabled(string, bool);
    callback move-source(string, int);
    callback source-test();
    callback source-reset();
    callback set-flag(string, bool);
    callback set-text(string, string);
    callback set-num(string, int);
    callback pick-download-dir();

    // ── servers modal ──
    in-out property <string> hosts-text: "";
    in property <bool> hosts-checking: false;
    in property <bool> hosts-saved: false;
    callback servers-opened();
    callback hosts-save(string);
    callback hosts-reset();
    callback hosts-check();

    property <length> pad: 26px;

    VerticalLayout {
        spacing: 0;

        // Row 1 — the videos kind row. Identical to the one page_videos draws,
        // because it IS the same component: a tab that looked different here
        // would be the tell that this is a second app.
        Rectangle {
            height: 56px; horizontal-stretch: 1; background: VP.header;
            HorizontalLayout {
                padding-left: root.pad; padding-right: root.pad; spacing: 8px;
                alignment: start;
                VideoTab { hue: VP.c-info; label: "TV";
                    clicked => { root.set-kind("tv"); } }
                VideoTab { hue: VP.c-save; label: "Movies";
                    clicked => { root.set-kind("movies"); } }
                VideoTab { hue: VP.c-dl; label: "Local";
                    clicked => { root.set-kind("local"); } }
                VideoTab { hue: VP.c-back; label: "Discover";
                    clicked => { root.set-kind("discover"); } }
                VideoTab { hue: VP.c-copy; label: "Live TV";
                    clicked => { root.set-kind("livetv"); } }
                VideoTab { hue: VP.c-play; label: "Stream";
                    clicked => { root.set-kind("stream"); } }
                VideoTab { hue: VP.accent; label: "Stream Plus";
                    active: true; clicked => { root.set-kind("splus"); } }
                Rectangle { horizontal-stretch: 1; }
                VideoTab { hue: VP.c-info; icon: Icons.settings; label: "Stream Setting";
                    active: root.servers-open;
                    clicked => {
                        root.servers-open = !root.servers-open;
                        if (root.servers-open) { root.servers-opened(); }
                    } }
            }
        }

        // Row 2 — this tab's own surfaces.
        Rectangle {
            height: 52px; horizontal-stretch: 1; background: VP.header-2;
            HorizontalLayout {
                padding-left: root.pad; padding-right: root.pad; spacing: 8px;
                alignment: start;
                VideoTab { hue: VP.accent; icon: Icons.home; label: "Home";
                    active: root.view == "home";
                    clicked => { root.view = "home"; root.home-load(); } }
                VideoTab { hue: VP.accent; icon: Icons.search; label: "Search";
                    active: root.view == "search" || root.view == "detail";
                    clicked => { root.view = "search"; } }
                VideoTab { hue: VP.c-save; icon: Icons.bookmark; label: "Library & History";
                    active: root.view == "library";
                    clicked => { root.view = "library"; root.library-load(); } }
                VideoTab { hue: VP.c-dl; icon: Icons.download;
                    label: root.dl-active > 0
                        ? "Downloads (" + root.dl-active + ")" : "Downloads";
                    active: root.view == "downloads";
                    clicked => { root.view = "downloads"; root.downloads-load(); } }
                VideoTab { hue: VP.c-info; icon: Icons.settings; label: "Settings";
                    active: root.view == "settings";
                    clicked => { root.view = "settings"; root.settings-load(); } }
                Rectangle { horizontal-stretch: 1; }
                // Live source health, so a dead provider is visible without
                // opening Settings.
                for h[i] in root.health: VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    if h.enabled && i < 4: SPlusChipView {
                        label: h.label;
                        hue: h.ok ? VP.c-play : (h.sunk ? VP.c-save : VP.c-back);
                        active: true;
                    }
                }
            }
        }

        // Status strip — one line, only when there is something to say.
        if root.status != "": Rectangle {
            height: 30px; horizontal-stretch: 1; background: VP.header-2;
            HorizontalLayout {
                padding-left: root.pad; spacing: 8px; alignment: start;
                VerticalLayout { alignment: center;
                    Text { text: root.status; color: VP.text-mute; font-size: 12px; } }
            }
        }

        // ── body ──
        Rectangle {
            horizontal-stretch: 1; vertical-stretch: 1; background: VP.bg;

            if root.view == "home": Flickable {
                width: 100%; height: 100%;
                viewport-width: self.width;
                viewport-height: home-col.preferred-height;
                home-col := VerticalLayout {
                    x: root.pad; y: 20px;
                    width: parent.width - 2 * root.pad;
                    spacing: 22px; alignment: start;

                    // Featured — the hero, one of six, stepped by the timer at
                    // the page root.
                    ShelfHead { label: "Featured";
                        note: root.featured.length > 0
                            ? "" + (root.featured-idx + 1) + " / " + root.featured.length : ""; }
                    if root.featured.length > 0: Rectangle {
                        height: 246px;
                        border-radius: Surface.rr(13px, self.width, self.height);
                        background: VP.surface;
                        border-width: 1px; border-color: VP.hair;
                        clip: true;
                        HorizontalLayout {
                            padding: 24px; spacing: 22px; alignment: start;
                            Rectangle {
                                width: 132px; horizontal-stretch: 0;
                                border-radius: Surface.rr(9px, self.width, self.height);
                                background: VP.well; clip: true;
                                if root.featured[root.featured-idx].poster.width > 0: Image {
                                    source: root.featured[root.featured-idx].poster;
                                    image-fit: cover; width: 100%; height: 100%; }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 7px; horizontal-stretch: 1;
                                Text { text: root.featured[root.featured-idx].title;
                                    color: VP.text; font-size: 25px; font-weight: 800;
                                    overflow: elide; }
                                Text { text: root.featured[root.featured-idx].note;
                                    color: VP.text-dim; font-size: 13px; overflow: elide; }
                                HorizontalLayout {
                                    spacing: 10px; alignment: start; padding-top: 8px;
                                    SPlusBtn { label: "Play"; icon: Icons.play; hue: VP.c-play;
                                        clicked => { root.open-card(root.featured[root.featured-idx].key); } }
                                    SPlusBtn { label: "Details"; icon: Icons.info; filled: false;
                                        clicked => { root.open-card(root.featured[root.featured-idx].key); } }
                                }
                            }
                        }
                    }

                    if root.continue-rows.length > 0: ShelfHead {
                        label: "Continue watching";
                        note: "" + root.continue-rows.length + " titles"; }
                    if root.continue-rows.length > 0: Flickable {
                        height: 96px; viewport-width: cont.preferred-width;
                        viewport-height: self.height;
                        cont := HorizontalLayout {
                            spacing: 13px; alignment: start;
                            for h in root.continue-rows: Rectangle {
                                width: 300px; height: 88px;
                                border-radius: Surface.rr(11px, self.width, self.height);
                                background: VP.surface;
                                border-width: 1px; border-color: VP.hair;
                                HorizontalLayout {
                                    padding: 11px; spacing: 13px;
                                    Rectangle {
                                        width: 104px; horizontal-stretch: 0;
                                        border-radius: Surface.rr(7px, self.width, self.height);
                                        background: VP.well; clip: true;
                                        if h.poster.width > 0: Image { source: h.poster;
                                            image-fit: cover; width: 100%; height: 100%; }
                                    }
                                    VerticalLayout {
                                        alignment: center; spacing: 4px; horizontal-stretch: 1;
                                        Text { text: h.title; color: VP.text; font-size: 14px;
                                            font-weight: 700; overflow: elide; }
                                        Text { text: h.state; color: VP.text-mute;
                                            font-size: 12px; overflow: elide; }
                                        ProgressBar { value: h.progress; hue: VP.c-play; }
                                    }
                                }
                                TouchArea { mouse-cursor: pointer;
                                    clicked => { root.history-play(h.key); } }
                            }
                        }
                    }

                    if root.trending.length > 0: ShelfHead { label: "Trending"; }
                    if root.trending.length > 0: Flickable {
                        height: 258px; viewport-width: trend.preferred-width;
                        viewport-height: self.height;
                        trend := HorizontalLayout {
                            spacing: 14px; alignment: start;
                            for c in root.trending: SPlusPoster { card: c;
                                clicked => { root.open-card(c.key); } }
                        }
                    }

                    if root.seasonal.length > 0: ShelfHead {
                        label: "This season"; note: root.season-label; }
                    if root.seasonal.length > 0: Flickable {
                        height: 258px; viewport-width: seas.preferred-width;
                        viewport-height: self.height;
                        seas := HorizontalLayout {
                            spacing: 14px; alignment: start;
                            for c in root.seasonal: SPlusPoster { card: c;
                                clicked => { root.open-card(c.key); } }
                        }
                    }
                    Rectangle { height: 24px; background: transparent; }
                }
            }

            // ── search ──
            if root.view == "search": VerticalLayout {
                x: root.pad; y: 20px;
                width: parent.width - 2 * root.pad;
                height: parent.height - 30px;
                spacing: 14px; alignment: start;

                Rectangle {
                    height: 48px; vertical-stretch: 0;
                    border-radius: Surface.rr(11px, self.width, self.height);
                    background: VP.surface;
                    border-width: 1px;
                    border-color: qin.has-focus ? VP.accent : VP.hair-2;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 14px; spacing: 11px;
                        VerticalLayout { alignment: center;
                            AppIcon { source: Icons.search; tint: VP.accent;
                                width: 18px; height: 18px; } }
                        VerticalLayout { alignment: center; horizontal-stretch: 1;
                            qin := TextInput {
                                text <=> root.query;
                                color: VP.text; font-size: 15px;
                                single-line: true;
                                edited => { root.suggest(self.text); }
                                accepted => { root.search(self.text); }
                            }
                        }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            SPlusChipView { label: "Anime"; active: root.lane == "anime";
                                clicked => { root.lane = "anime"; root.search(root.query); } } }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            SPlusChipView { label: "Movies"; active: root.lane == "movie";
                                clicked => { root.lane = "movie"; root.search(root.query); } } }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            SPlusChipView { label: "TV"; active: root.lane == "tv";
                                clicked => { root.lane = "tv"; root.search(root.query); } } }
                    }
                }

                if root.suggestions.length > 0 && qin.has-focus: Rectangle {
                    height: Math.min(root.suggestions.length, 5) * 38px;
                    vertical-stretch: 0;
                    border-radius: Surface.rr(11px, self.width, self.height);
                    background: VP.modal;
                    border-width: 1px; border-color: VP.hair;
                    clip: true;
                    VerticalLayout {
                        spacing: 0; alignment: start;
                        for s[i] in root.suggestions: Rectangle {
                            height: 38px;
                            background: sta.has-hover ? VP.accent-1a : transparent;
                            HorizontalLayout {
                                padding-left: 16px; spacing: 11px;
                                VerticalLayout { alignment: center;
                                    AppIcon { source: Icons.search; tint: VP.icon-dim;
                                        width: 13px; height: 13px; } }
                                VerticalLayout { alignment: center;
                                    Text { text: s; color: VP.text; font-size: 13.5px; } }
                            }
                            sta := TouchArea { mouse-cursor: pointer;
                                clicked => { root.query = s; root.search(s); } }
                        }
                    }
                }

                if root.recent.length > 0: HorizontalLayout {
                    spacing: 8px; alignment: start; vertical-stretch: 0; height: 28px;
                    VerticalLayout { alignment: center;
                        Text { text: "RECENT"; color: VP.text-mute; font-size: 10.5px;
                            font-weight: 800; letter-spacing: 1.4px; } }
                    for r in root.recent: SPlusChipView { label: r;
                        clicked => { root.query = r; root.search(r); } }
                    Rectangle { horizontal-stretch: 1; }
                    SPlusChipView { label: "Clear"; clicked => { root.recent-clear(); } }
                }

                ShelfHead {
                    label: "Results"; vertical-stretch: 0;
                    note: root.busy ? "searching…"
                        : (root.results.length > 0
                            ? "" + root.results.length + " of " + root.results-total
                            : "");
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: grid.preferred-height;
                    grid := VerticalLayout {
                        spacing: 16px; alignment: start;
                        // The poster is a fixed width, so the grid re-flows
                        // with the window and the rhythm never changes.
                        HorizontalLayout {
                            spacing: 16px; alignment: start;
                            for c in root.results: SPlusPoster { card: c;
                                clicked => { root.open-card(c.key); } }
                        }
                        if root.results-more: HorizontalLayout {
                            alignment: center; padding-top: 6px;
                            SPlusBtn { label: "Load more"; filled: false;
                                clicked => { root.load-more(); } }
                        }
                        if root.results.length == 0 && !root.busy: VerticalLayout {
                            alignment: center; spacing: 8px; padding-top: 40px;
                            Text { text: root.query == ""
                                    ? "Search for a show, a film, or an anime."
                                    : "Nothing matched that.";
                                color: VP.text-mute; font-size: 13.5px;
                                horizontal-alignment: center; }
                        }
                        Rectangle { height: 20px; background: transparent; }
                    }
                }
            }

            // ── detail ──
            if root.view == "detail": Flickable {
                width: 100%; height: 100%;
                viewport-width: self.width;
                viewport-height: dcol.preferred-height;
                dcol := VerticalLayout {
                    x: root.pad; y: 18px;
                    width: parent.width - 2 * root.pad;
                    spacing: 18px; alignment: start;

                    HorizontalLayout {
                        spacing: 8px; alignment: start; height: 34px;
                        SPlusBtn { compact: true; filled: false; icon: Icons.chevron-left;
                            label: "Results"; clicked => { root.back(); } }
                        SPlusBtn { compact: true; filled: false; icon: Icons.home;
                            label: "Home"; clicked => { root.view = "home"; } }
                    }

                    HorizontalLayout {
                        spacing: 22px; alignment: start;
                        Rectangle {
                            width: 186px; height: 279px; horizontal-stretch: 0;
                            border-radius: Surface.rr(11px, self.width, self.height);
                            background: VP.well;
                            border-width: 1px; border-color: VP.hair;
                            clip: true;
                            if root.d-cover.width > 0: Image { source: root.d-cover;
                                image-fit: cover; width: 100%; height: 100%; }
                        }
                        VerticalLayout {
                            spacing: 9px; alignment: start; horizontal-stretch: 1;
                            Text { text: root.d-title; color: VP.text;
                                font-size: 27px; font-weight: 800; wrap: word-wrap; }
                            Text { text: root.d-meta; color: VP.text-mute;
                                font-size: 13px; overflow: elide; }

                            if root.d-audio.length > 0: HorizontalLayout {
                                spacing: 8px; alignment: start; height: 28px;
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    Text { text: "AUDIO"; color: VP.text-mute;
                                        font-size: 10px; font-weight: 800;
                                        letter-spacing: 1.2px; } }
                                for a in root.d-audio: SPlusChipView {
                                    label: a.label; active: a.active;
                                    clicked => { root.set-audio(a.id); } }
                            }
                            if root.d-seasons.length > 1: HorizontalLayout {
                                spacing: 8px; alignment: start; height: 28px;
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    Text { text: "SEASON"; color: VP.text-mute;
                                        font-size: 10px; font-weight: 800;
                                        letter-spacing: 1.2px; } }
                                for s in root.d-seasons: SPlusChipView {
                                    label: s.label; active: s.active;
                                    clicked => { root.set-season(s.id); } }
                            }

                            if root.d-overview != "": Text {
                                text: root.d-overview; color: VP.text-dim;
                                font-size: 13.5px; wrap: word-wrap; }

                            HorizontalLayout {
                                spacing: 9px; alignment: start; padding-top: 6px;
                                SPlusBtn { label: "Play"; icon: Icons.play; hue: VP.c-play;
                                    clicked => { root.play(); } }
                                SPlusBtn { label: "Download"; icon: Icons.download;
                                    hue: VP.c-dl; clicked => { root.download(); } }
                                SPlusBtn { label: "Season"; icon: Icons.download;
                                    filled: false; clicked => { root.download-season(); } }
                                SPlusBtn { label: root.d-saved ? "Saved" : "Save";
                                    icon: Icons.bookmark; hue: VP.c-save;
                                    filled: root.d-saved;
                                    clicked => { root.toggle-save(); } }
                                SPlusBtn { label: "Copy link"; icon: Icons.link;
                                    filled: false; clicked => { root.copy-link(); } }
                                SPlusBtn { label: "Cast"; icon: Icons.monitor-play;
                                    filled: false; clicked => { root.cast(); } }
                                SPlusBtn { label: "Add to library"; icon: Icons.plus;
                                    filled: false; clicked => { root.add-to-library(); } }
                            }
                        }
                    }

                    if root.d-episodes.length > 0: ShelfHead {
                        label: "Episodes";
                        note: root.d-skip-note; }
                    if root.d-episodes.length > 0: Flickable {
                        height: 132px; viewport-width: eps.preferred-width;
                        viewport-height: self.height;
                        eps := HorizontalLayout {
                            spacing: 9px; alignment: start;
                            for e in root.d-episodes: Rectangle {
                                width: 168px; height: 124px;
                                border-radius: Surface.rr(9px, self.width, self.height);
                                background: VP.surface;
                                border-width: 1px;
                                border-color: e.number == root.d-episode
                                    ? VP.accent-88 : VP.hair;
                                clip: true;
                                VerticalLayout {
                                    spacing: 0;
                                    Rectangle {
                                        height: 84px; background: VP.well; clip: true;
                                        if e.thumb.width > 0: Image { source: e.thumb;
                                            image-fit: cover; width: 100%; height: 100%; }
                                        if e.progress > 0.01: Rectangle {
                                            x: 0; y: parent.height - 3px;
                                            width: parent.width; height: 3px;
                                            background: #00000073;
                                            Rectangle { x: 0; height: parent.height;
                                                width: parent.width * Math.clamp(e.progress, 0, 1);
                                                background: VP.c-play; }
                                        }
                                    }
                                    VerticalLayout {
                                        padding: 8px; spacing: 2px;
                                        Text { text: "E" + e.number; color: VP.accent;
                                            font-size: 11px; font-weight: 700; }
                                        Text { text: e.title == "" ? "Episode " + e.number : e.title;
                                            color: VP.text; font-size: 12px;
                                            font-weight: 600; overflow: elide; }
                                    }
                                }
                                TouchArea { mouse-cursor: pointer;
                                    clicked => { root.set-episode(e.number); } }
                            }
                        }
                    }

                    ShelfHead {
                        label: "Sources";
                        note: root.d-resolving ? "resolving…" : root.d-resolved; }
                    Rectangle {
                        height: Math.max(60px, root.d-files.length * 60px + 2px);
                        border-radius: Surface.rr(11px, self.width, self.height);
                        background: VP.surface;
                        border-width: 1px; border-color: VP.hair;
                        clip: true;
                        VerticalLayout {
                            spacing: 0; alignment: start;
                            for f in root.d-files: Rectangle {
                                height: 60px;
                                background: f.index == root.d-file && !f.failed
                                    ? VP.accent-1a : transparent;
                                HorizontalLayout {
                                    padding-left: 15px; padding-right: 12px; spacing: 14px;
                                    VerticalLayout {
                                        alignment: center; spacing: 2px; horizontal-stretch: 1;
                                        Text { text: f.label;
                                            color: f.failed ? VP.text-mute : VP.text;
                                            font-size: 14px; font-weight: 700; overflow: elide; }
                                        Text { text: f.failed ? f.note : f.sub;
                                            color: f.failed ? VP.c-save : VP.text-mute;
                                            font-size: 12px; overflow: elide; }
                                    }
                                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                                        Text { text: f.subs;
                                            color: f.has-subs ? VP.c-play : VP.text-mute;
                                            font-size: 12px; } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                                        if !f.failed: SPlusBtn { compact: true; label: "Play";
                                            icon: Icons.play; hue: VP.c-play;
                                            clicked => { root.set-file(f.index); root.play(); } } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                                        if f.failed: SPlusBtn { compact: true; label: "Retry";
                                            icon: Icons.refresh-cw; filled: false;
                                            clicked => { root.retry-source(f.uploader); } } }
                                }
                                Rectangle { x: 0; y: parent.height - 1px;
                                    width: parent.width; height: 1px; background: VP.hair; }
                            }
                            if root.d-files.length == 0: VerticalLayout {
                                alignment: center; padding: 18px;
                                Text { text: root.d-resolving
                                        ? "Asking each source in turn…"
                                        : "No source carried this episode.";
                                    color: VP.text-mute; font-size: 13px;
                                    horizontal-alignment: center; } }
                        }
                    }

                    if root.d-subs.length > 0: ShelfHead { label: "Subtitles"; }
                    if root.d-subs.length > 0: HorizontalLayout {
                        spacing: 8px; alignment: start; height: 28px;
                        for s in root.d-subs: SPlusChipView { label: s.label;
                            active: s.active; clicked => { root.set-sub(s.id); } }
                    }
                    Rectangle { height: 24px; background: transparent; }
                }
            }

            // ── library & history ──
            if root.view == "library": VerticalLayout {
                x: root.pad; y: 20px;
                width: parent.width - 2 * root.pad;
                height: parent.height - 30px;
                spacing: 14px; alignment: start;

                HorizontalLayout {
                    spacing: 8px; alignment: start; height: 30px; vertical-stretch: 0;
                    SPlusChipView { label: "Saved"; active: root.lib-tab == "saved";
                        clicked => { root.lib-tab = "saved"; } }
                    SPlusChipView { label: "History"; active: root.lib-tab == "history";
                        clicked => { root.lib-tab = "history"; } }
                    Rectangle { horizontal-stretch: 1; }
                    SPlusChipView { label: "Recently added"; active: root.sort == "added";
                        clicked => { root.set-sort("added"); } }
                    SPlusChipView { label: "Recently watched"; active: root.sort == "watched";
                        clicked => { root.set-sort("watched"); } }
                    SPlusChipView { label: "Title"; active: root.sort == "title";
                        clicked => { root.set-sort("title"); } }
                    SPlusChipView { label: "Year"; active: root.sort == "year";
                        clicked => { root.set-sort("year"); } }
                    SPlusChipView { label: "Progress"; active: root.sort == "progress";
                        clicked => { root.set-sort("progress"); } }
                }

                if root.lib-tab == "saved": ShelfHead {
                    label: "Saved"; vertical-stretch: 0;
                    note: "" + root.saved.length + " titles"; }
                if root.lib-tab == "saved": Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: savedcol.preferred-height;
                    savedcol := VerticalLayout {
                        spacing: 16px; alignment: start;
                        HorizontalLayout {
                            spacing: 16px; alignment: start;
                            for c in root.saved: SPlusPoster { card: c;
                                clicked => { root.open-card(c.key); } }
                        }
                        if root.saved.length == 0: VerticalLayout {
                            alignment: center; padding-top: 40px;
                            Text { text: "Nothing saved yet — the bookmark on a title puts it here.";
                                color: VP.text-mute; font-size: 13.5px;
                                horizontal-alignment: center; } }
                        Rectangle { height: 20px; background: transparent; }
                    }
                }

                if root.lib-tab == "history": ShelfHead {
                    label: "History"; vertical-stretch: 0;
                    note: "newest first · " + root.history.length + " entries"; }
                if root.lib-tab == "history": Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: histcol.preferred-height;
                    histcol := VerticalLayout {
                        spacing: 0; alignment: start;
                        for h in root.history: Rectangle {
                            height: 72px; background: hta.has-hover ? VP.surface-2 : VP.surface;
                            hta := TouchArea { mouse-cursor: default; }
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 14px; spacing: 14px;
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    Rectangle {
                                        width: 56px; height: 36px;
                                        border-radius: Surface.rr(6px, self.width, self.height);
                                        background: VP.well; clip: true;
                                        if h.poster.width > 0: Image { source: h.poster;
                                            image-fit: cover; width: 100%; height: 100%; } } }
                                VerticalLayout {
                                    alignment: center; spacing: 3px; horizontal-stretch: 1;
                                    Text { text: h.title; color: VP.text; font-size: 14px;
                                        font-weight: 600; overflow: elide; }
                                    Text { text: h.kind + " · " + h.detail;
                                        color: VP.text-mute; font-size: 12px; overflow: elide; } }
                                VerticalLayout {
                                    alignment: center; spacing: 4px;
                                    horizontal-stretch: 0; width: 130px;
                                    Text { text: h.state;
                                        color: h.finished ? VP.c-play : VP.text-dim;
                                        font-size: 12px; }
                                    ProgressBar { value: h.progress;
                                        hue: h.finished ? VP.c-play : VP.c-dl; } }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0; width: 100px;
                                    Text { text: h.when; color: VP.text-mute;
                                        font-size: 12px; horizontal-alignment: right; } }
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    SPlusBtn { compact: true; icon: Icons.play; label: "";
                                        hue: VP.c-play;
                                        clicked => { root.history-play(h.key); } } }
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    SPlusBtn { compact: true; icon: Icons.x; label: "";
                                        filled: false;
                                        clicked => { root.history-remove(h.key); } } }
                            }
                            Rectangle { x: 0; y: parent.height - 1px;
                                width: parent.width; height: 1px; background: VP.hair; }
                        }
                        HorizontalLayout {
                            padding-top: 14px; spacing: 10px; alignment: start;
                            Rectangle { horizontal-stretch: 1; }
                            SPlusBtn { label: "Clear history"; icon: Icons.trash;
                                filled: false; clicked => { root.history-clear(); } }
                        }
                        Rectangle { height: 20px; background: transparent; }
                    }
                }
            }

            // ── downloads ──
            if root.view == "downloads": VerticalLayout {
                x: root.pad; y: 20px;
                width: parent.width - 2 * root.pad;
                height: parent.height - 30px;
                spacing: 14px; alignment: start;

                HorizontalLayout {
                    spacing: 10px; alignment: start; height: 30px; vertical-stretch: 0;
                    VerticalLayout { alignment: center;
                        Text { text: root.dl-active > 0
                                ? "" + root.dl-active + " running · " + root.dl-rate
                                : "Nothing downloading";
                            color: VP.text-dim; font-size: 12.5px; } }
                    Rectangle { horizontal-stretch: 1; }
                    SPlusBtn { compact: true; filled: false; label: "Cancel all";
                        clicked => { root.dl-cancel-all(); } }
                    SPlusBtn { compact: true; filled: false; label: "Clear finished";
                        clicked => { root.dl-clear(); } }
                }

                Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: dlcol.preferred-height;
                    dlcol := VerticalLayout {
                        spacing: 0; alignment: start;
                        for d in root.downloads: Rectangle {
                            height: 74px; background: VP.surface;
                            HorizontalLayout {
                                padding-left: 16px; padding-right: 14px; spacing: 14px;
                                VerticalLayout {
                                    alignment: center; spacing: 3px; horizontal-stretch: 1;
                                    Text { text: d.title; color: VP.text; font-size: 14px;
                                        font-weight: 600; overflow: elide; }
                                    Text { text: d.detail;
                                        color: d.failed ? VP.c-save : VP.text-mute;
                                        font-size: 12px; overflow: elide; } }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0; width: 200px;
                                    ProgressBar { value: d.progress;
                                        hue: d.failed ? VP.c-save
                                            : (d.done ? VP.c-play : VP.c-dl); } }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0; width: 104px;
                                    Rectangle {
                                        height: 24px;
                                        border-radius: Surface.rr(5px, self.width, self.height);
                                        background: d.failed ? VP.c-save
                                            : (d.done ? VP.c-play
                                            : (d.active ? VP.c-dl : VP.text-mute));
                                        Text { text: d.state; color: #ffffff;
                                            font-size: 10.5px; font-weight: 800;
                                            letter-spacing: 0.6px;
                                            width: 100%; height: 100%;
                                            horizontal-alignment: center;
                                            vertical-alignment: center; } } }
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    if d.done: SPlusBtn { compact: true; icon: Icons.play;
                                        label: ""; hue: VP.c-play;
                                        clicked => { root.dl-play(d.id); } } }
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    if d.done: SPlusBtn { compact: true; icon: Icons.folder;
                                        label: ""; filled: false;
                                        clicked => { root.dl-reveal(d.id); } } }
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    if d.failed: SPlusBtn { compact: true; icon: Icons.refresh-cw;
                                        label: ""; filled: false;
                                        clicked => { root.dl-retry(d.id); } } }
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    if d.done: SPlusBtn { compact: true; icon: Icons.trash;
                                        label: ""; filled: false;
                                        clicked => { root.dl-delete(d.id); } } }
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    if !d.done: SPlusBtn { compact: true; icon: Icons.x;
                                        label: ""; filled: false;
                                        clicked => { root.dl-cancel(d.id); } } }
                            }
                            Rectangle { x: 0; y: parent.height - 1px;
                                width: parent.width; height: 1px; background: VP.hair; }
                        }
                        if root.downloads.length == 0: VerticalLayout {
                            alignment: center; padding-top: 40px;
                            Text { text: "Nothing queued. Download on a title puts it here.";
                                color: VP.text-mute; font-size: 13.5px;
                                horizontal-alignment: center; } }
                        Rectangle { height: 20px; background: transparent; }
                    }
                }
            }

            // ── settings ──
            if root.view == "settings": Flickable {
                width: 100%; height: 100%;
                viewport-width: self.width;
                viewport-height: setcol.preferred-height;
                setcol := VerticalLayout {
                    x: root.pad; y: 20px;
                    width: parent.width - 2 * root.pad;
                    spacing: 20px; alignment: start;

                    ShelfHead { label: "Sources";
                        note: "tried top to bottom · three failures in a row sinks one for an hour"; }
                    Rectangle {
                        height: Math.max(56px, root.health.length * 52px + 62px);
                        border-radius: Surface.rr(11px, self.width, self.height);
                        background: VP.surface;
                        border-width: 1px; border-color: VP.hair;
                        VerticalLayout {
                            padding: 14px; spacing: 6px; alignment: start;
                            for h[i] in root.health: Rectangle {
                                height: 46px;
                                border-radius: Surface.rr(8px, self.width, self.height);
                                background: VP.surface-2;
                                border-width: 1px; border-color: VP.hair;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 10px; spacing: 11px;
                                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                                        Text { text: "" + (i + 1); color: VP.accent;
                                            font-size: 12px; font-weight: 700; width: 16px; } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                                        Text { text: h.label; color: VP.text;
                                            font-size: 13.5px; font-weight: 600; } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                                        SPlusChipView { label: h.note; active: true;
                                            hue: h.ok ? VP.c-play
                                                : (h.sunk ? VP.c-save : VP.c-back); } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                                        SPlusBtn { compact: true; filled: false;
                                            icon: Icons.chevron-up; label: "";
                                            clicked => { root.move-source(h.source, -1); } } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                                        SPlusBtn { compact: true; filled: false;
                                            icon: Icons.chevron-down; label: "";
                                            clicked => { root.move-source(h.source, 1); } } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                                        SPlusToggle { label: ""; on: h.enabled; width: 46px;
                                            toggled(v) => { root.set-source-enabled(h.source, v); } } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 9px; alignment: start; padding-top: 6px;
                                SPlusBtn { compact: true; filled: false; icon: Icons.refresh-cw;
                                    label: "Test all"; clicked => { root.source-test(); } }
                                SPlusBtn { compact: true; filled: false; icon: Icons.rotate-ccw;
                                    label: "Reset"; clicked => { root.source-reset(); } }
                                SPlusBtn { compact: true; filled: false; icon: Icons.settings;
                                    label: "Servers…";
                                    clicked => { root.servers-open = true; root.servers-opened(); } }
                            }
                        }
                    }

                    ShelfHead { label: "Anime";
                        note: "AniList metadata · TMDB numbering correction"; }
                    Rectangle {
                        height: 232px;
                        border-radius: Surface.rr(11px, self.width, self.height);
                        background: VP.surface;
                        border-width: 1px; border-color: VP.hair;
                        VerticalLayout {
                            padding-left: 16px; padding-right: 16px; spacing: 0;
                            HorizontalLayout {
                                height: 46px; spacing: 14px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1;
                                    Text { text: "Preferred audio"; color: VP.text;
                                        font-size: 13.5px; font-weight: 600; } }
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    SPlusChipView { label: "Sub first";
                                        active: root.audio-pref == "sub_then_dub";
                                        clicked => { root.set-text("audio_pref", "sub_then_dub"); } } }
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    SPlusChipView { label: "Dub first";
                                        active: root.audio-pref == "dub_then_sub";
                                        clicked => { root.set-text("audio_pref", "dub_then_sub"); } } }
                            }
                            SPlusToggle { label: "Skip opening and ending";
                                note: "AniSkip timestamps, keyed by MyAnimeList id";
                                on: root.skip-op-ed;
                                toggled(v) => { root.set-flag("skip_op_ed", v); } }
                            HorizontalLayout {
                                height: 46px; spacing: 10px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text { text: "Autoplay next episode"; color: VP.text;
                                        font-size: 13.5px; font-weight: 600; }
                                    Text { text: "countdown before the next one starts";
                                        color: VP.text-mute; font-size: 11.5px; } }
                                for s in [0, 5, 10, 20]: VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    SPlusChipView { label: s == 0 ? "Off" : "" + s + " s";
                                        active: root.autoplay-secs == s;
                                        clicked => { root.set-num("autoplay_seconds", s); } } }
                            }
                            HorizontalLayout {
                                height: 46px; spacing: 10px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text { text: "Mark watched at"; color: VP.text;
                                        font-size: 13.5px; font-weight: 600; }
                                    Text { text: "progress past this point counts as finished";
                                        color: VP.text-mute; font-size: 11.5px; } }
                                for p in [80, 85, 90, 95]: VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    SPlusChipView { label: "" + p + "%";
                                        active: root.watched-pct == p;
                                        clicked => { root.set-num("watched_threshold", p); } } }
                            }
                            SPlusToggle { label: "Hide episodes you have finished";
                                note: "the strip starts at the first unwatched one";
                                on: root.hide-finished;
                                toggled(v) => { root.set-flag("hide_finished", v); } }
                        }
                    }

                    ShelfHead { label: "Subtitles";
                        note: "two more sources behind the video section's subtitle search"; }
                    Rectangle {
                        height: 232px;
                        border-radius: Surface.rr(11px, self.width, self.height);
                        background: VP.surface;
                        border-width: 1px; border-color: VP.hair;
                        VerticalLayout {
                            padding-left: 16px; padding-right: 16px; spacing: 0;
                            SPlusToggle { label: "Wyzie"; note: "no key needed";
                                on: root.subs-wyzie;
                                toggled(v) => { root.set-flag("subs_wyzie", v); } }
                            SPlusToggle { label: "SubDL";
                                note: "API key stored in the system keychain";
                                on: root.subs-subdl;
                                toggled(v) => { root.set-flag("subs_subdl", v); } }
                            HorizontalLayout {
                                height: 46px; spacing: 10px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1;
                                    Text { text: "Preferred language"; color: VP.text;
                                        font-size: 13.5px; font-weight: 600; } }
                                for l in ["en", "de", "es", "fr", "ja"]: VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    SPlusChipView { label: l; active: root.subs-lang == l;
                                        clicked => { root.set-text("subs_lang", l); } } }
                            }
                            SPlusToggle { label: "Download subtitles with the file";
                                note: "written beside the video as .srt";
                                on: root.subs-with-file;
                                toggled(v) => { root.set-flag("subs_with_file", v); } }
                        }
                    }

                    ShelfHead { label: "Player & downloads"; }
                    Rectangle {
                        height: 186px;
                        border-radius: Surface.rr(11px, self.width, self.height);
                        background: VP.surface;
                        border-width: 1px; border-color: VP.hair;
                        VerticalLayout {
                            padding-left: 16px; padding-right: 16px; spacing: 0;
                            HorizontalLayout {
                                height: 46px; spacing: 10px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text { text: "Preferred quality"; color: VP.text;
                                        font-size: 13.5px; font-weight: 600; }
                                    Text { text: "picks the closest available, never higher";
                                        color: VP.text-mute; font-size: 11.5px; } }
                                for q in [480, 720, 1080, 2160]: VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    SPlusChipView { label: "" + q + "p"; active: root.quality == q;
                                        clicked => { root.set-num("quality", q); } } }
                            }
                            SPlusToggle { label: "Download into the library";
                                note: "finished files appear under Videos → Library";
                                on: root.into-library;
                                toggled(v) => { root.set-flag("into_library", v); } }
                            HorizontalLayout {
                                height: 46px; spacing: 10px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text { text: "Download folder"; color: VP.text;
                                        font-size: 13.5px; font-weight: 600; }
                                    Text { text: root.download-dir; color: VP.text-mute;
                                        font-size: 11.5px; overflow: elide; } }
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    SPlusBtn { compact: true; filled: false; label: "Change";
                                        clicked => { root.pick-download-dir(); } } }
                            }
                            HorizontalLayout {
                                height: 46px; spacing: 10px;
                                VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text { text: "Simultaneous downloads"; color: VP.text;
                                        font-size: 13.5px; font-weight: 600; }
                                    Text { text: "more slots is not faster on one host";
                                        color: VP.text-mute; font-size: 11.5px; } }
                                for n in [1, 2, 3, 4]: VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    SPlusChipView { label: "" + n; active: root.slots == n;
                                        clicked => { root.set-num("slots", n); } } }
                            }
                        }
                    }

                    ShelfHead { label: "Notifications"; }
                    Rectangle {
                        height: 108px;
                        border-radius: Surface.rr(11px, self.width, self.height);
                        background: VP.surface;
                        border-width: 1px; border-color: VP.hair;
                        VerticalLayout {
                            padding-left: 16px; padding-right: 16px; spacing: 0;
                            SPlusToggle { label: "Download finished";
                                note: "one per file, none for a season batch";
                                on: root.notify-download;
                                toggled(v) => { root.set-flag("notify_download", v); } }
                            SPlusToggle { label: "New episode of a saved show";
                                note: "checked when the app is idle, at most once an hour";
                                on: root.notify-episode;
                                toggled(v) => { root.set-flag("notify_episode", v); } }
                        }
                    }
                    Rectangle { height: 26px; background: transparent; }
                }
            }
        }
    }

    // ── Servers modal ─────────────────────────────────────────────────────
    if root.servers-open: Rectangle {
        width: 100%; height: 100%;
        background: VP.scrim;
        TouchArea { clicked => { root.servers-open = false; } }
        Rectangle {
            width: Math.min(700px, parent.width - 60px);
            height: Math.min(560px, parent.height - 60px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Surface.rr(14px, self.width, self.height);
            background: VP.modal;
            border-width: 1px; border-color: VP.hair-2;
            // Swallow clicks so the scrim behind does not close the modal when
            // the user reaches for the text box.
            TouchArea { }
            VerticalLayout {
                padding: 22px; spacing: 12px;
                HorizontalLayout {
                    alignment: start; spacing: 10px; vertical-stretch: 0; height: 22px;
                    Rectangle { width: 4px; height: 18px; y: 1px;
                        border-radius: Surface.rr(2px, self.width, self.height);
                        background: VP.accent; horizontal-stretch: 0; }
                    VerticalLayout { alignment: center;
                        Text { text: "Stream Plus Setting"; color: VP.text;
                            font-size: 16px; font-weight: 800; } }
                    Rectangle { horizontal-stretch: 1; }
                    SPlusBtn { compact: true; filled: false; icon: Icons.x; label: "";
                        clicked => { root.servers-open = false; } }
                }
                Text { text: "One server per line · tried top to bottom. Only change these if every source started failing after a site moved.";
                    color: VP.text-mute; font-size: 11.5px; wrap: word-wrap;
                    vertical-stretch: 0; }
                Rectangle {
                    vertical-stretch: 1; horizontal-stretch: 1;
                    border-radius: Surface.rr(10px, self.width, self.height);
                    background: VP.field;
                    border-width: 1px;
                    border-color: hostin.has-focus ? VP.accent : VP.field-edge;
                    clip: true;
                    hostin := TextInput {
                        x: 12px; y: 10px;
                        width: parent.width - 24px; height: parent.height - 20px;
                        text <=> root.hosts-text;
                        color: VP.text; font-size: 13px; font-family: "monospace";
                        single-line: false; wrap: no-wrap;
                    }
                }
                HorizontalLayout {
                    spacing: 10px; alignment: start; vertical-stretch: 0;
                    SPlusBtn {
                        label: root.hosts-saved ? "Applied" : "Save";
                        icon: root.hosts-saved ? Icons.check : Icons.save;
                        hue: VP.c-play;
                        clicked => { root.hosts-save(root.hosts-text); } }
                    SPlusBtn { filled: false; icon: Icons.rotate-ccw; label: "Reset";
                        clicked => { root.hosts-reset(); } }
                    SPlusBtn { filled: false; icon: Icons.refresh-cw;
                        label: root.hosts-checking ? "Testing…" : "Test";
                        clicked => { root.hosts-check(); } }
                }
                // The same health list the Settings page shows, so a Test here
                // and a Test there mean the same thing.
                Rectangle {
                    height: Math.min(160px, root.health.length * 34px + 4px);
                    vertical-stretch: 0;
                    border-radius: Surface.rr(9px, self.width, self.height);
                    background: VP.surface-2;
                    border-width: 1px; border-color: VP.hair;
                    clip: true;
                    VerticalLayout {
                        padding: 2px; spacing: 0; alignment: start;
                        for h in root.health: HorizontalLayout {
                            height: 34px; padding-left: 11px; padding-right: 11px; spacing: 10px;
                            VerticalLayout { alignment: center; horizontal-stretch: 0;
                                Rectangle { width: 7px; height: 7px;
                                    border-radius: 4px;
                                    background: h.ok ? VP.c-play
                                        : (h.sunk ? VP.c-save : VP.c-back); } }
                            VerticalLayout { alignment: center; horizontal-stretch: 1;
                                Text { text: h.label; color: VP.text; font-size: 12.5px;
                                    font-family: "monospace"; } }
                            VerticalLayout { alignment: center; horizontal-stretch: 0;
                                Text { text: h.note; color: VP.text-mute; font-size: 12px; } }
                        }
                    }
                }
            }
        }
    }

    // The featured hero steps every ten seconds, the same clock the other
    // shelves in this app keep.
    //
    // Declared at the page root, NOT inside the `if root.view == "home"` that
    // draws it: a timer inside a conditional is rebuilt every time the
    // condition re-evaluates, and a timer that is rebuilt never fires. The
    // callback below exists for the same family of reasons — see `feat-kick`.
    feat := Timer {
        interval: 10s;
        running: root.view == "home" && root.featured.length > 1;
        triggered => {
            root.featured-idx = Math.mod(root.featured-idx + 1, root.featured.length);
        }
    }
    // Restarting from a nested scope resolves the timer field against the
    // calling sub-component and fails to compile (E0609). A callback declared
    // here compiles in root's scope, where the timer actually lives.
    callback feat-kick();
    feat-kick => { feat.restart(); }
}
