// First-run onboarding (np.p1.auth-shell). Stepped overlay: Welcome → Theme →
// Mode → Library → Done. Shown once; on finish the app persists an "onboarded"
// flag. Reuses ThemePicker; mode + add-folder bubble to the existing handlers.
import { Theme, Accent } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";
import { ThemePicker, ThemeChoice } from "theme_picker.slint";
import { ModalFrost } from "frost.slint";

component WizBtn inherits Skin {
    in property <string> label;
    in property <bool> primary: true;
    in property <bool> ghost: false;
    callback clicked();
    height: 38px; min-width: 110px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: Surface.rr(10px, self.width, self.height);
    background: ghost ? transparent : (primary ? Theme.brand : Theme.panel-2);
    border-width: 1px;
    border-color: ghost ? transparent : (primary ? Theme.brand : Theme.outline);
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        text: label; color: ghost ? Theme.text-dim : (primary ? #ffffff : Theme.text);
        font-size: 13px; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

component ChoiceCard inherits Skin {
    in property <bool> active;
    in property <string> title;
    in property <string> sub;
    in property <color> grad-a;
    in property <color> grad-b;
    callback clicked();
    width: 220px; height: 96px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: Theme.radius-md;
    background: active ? @linear-gradient(135deg, grad-a, grad-b) : Theme.panel-2;
    border-width: 1px;
    border-color: active ? grad-a.with-alpha(0.6) : Theme.outline;
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    VerticalLayout {
        padding: 14px; spacing: 5px;
        Text { text: title; color: active ? #ffffff : Theme.text; font-size: 14px; font-weight: 700; }
        Text { text: sub; color: active ? #ffffffcc : Theme.text-dim; font-size: 11px; wrap: word-wrap; }
    }
}

export component OnboardingWizard inherits Rectangle {
    in-out property <int> step: 0;          // 0=welcome 1=theme 2=mode 3=library 4=done
    in-out property <ThemeChoice> theme-choice;
    in property <string> mode: "local";     // always "local" — local-only app
    in property <bool> library-added: false;
    callback theme-changed(ThemeChoice);
    callback choose-mode(string);
    callback add-library();
    callback finished();

    property <int> last-step: 4;
    width: 100%; height: 100%;
    background: #050614e0;

    ModalFrost {
        accent: Accent.color;
        x: parent.width / 2 - 320px;
        y: parent.height / 2 - 230px;
        width: 640px; height: 460px;
        z: 600;

        VerticalLayout {
            padding: 30px; spacing: 16px;

            // Step dots.
            HorizontalLayout {
                alignment: center; spacing: 8px;
                for i in [0, 1, 2, 3, 4]: Rectangle {
                    width: i == root.step ? 22px : 8px; height: 8px; border-radius: Surface.rr(4px, self.width, self.height);
                    background: i == root.step ? Accent.color : Theme.outline;
                    animate width { duration: 160ms; easing: ease-out; }
                }
            }

            // Stage.
            Rectangle {
                vertical-stretch: 1; horizontal-stretch: 1;

                if root.step == 0: VerticalLayout {
                    alignment: center; spacing: 12px;
                    Text { text: "Welcome to Tulipix"; color: Theme.text; font-size: 26px; font-weight: 800; horizontal-alignment: center; }
                    Text { text: "Your photos, videos, music, books and cloud — one private, local-first library.";
                        color: Theme.text-dim; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                }

                if root.step == 1: VerticalLayout {
                    alignment: center; spacing: 12px;
                    Text { text: "Pick a theme"; color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                    ThemePicker {
                        choice <=> root.theme-choice;
                        changed(c) => { root.theme-changed(c); }
                    }
                }

                if root.step == 2: VerticalLayout {
                    alignment: center; spacing: 14px;
                    Text { text: "Local at heart"; color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Everything stays on this device — no accounts, no servers, full access.";
                        color: Theme.text-dim; font-size: 12px; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center; spacing: 14px;
                        ChoiceCard {
                            active: true; title: "Local";
                            sub: "Your library, your machine."; grad-a: #4f46e5; grad-b: #7c3aed;
                            clicked => { root.choose-mode("local"); }
                        }
                    }
                }

                if root.step == 3: VerticalLayout {
                    alignment: center; spacing: 12px;
                    Text { text: "Add your first folder"; color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Tulipix indexes in place — your files never move.";
                        color: Theme.text-dim; font-size: 12px; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        WizBtn { label: root.library-added ? "Folder added" : "Choose folder…"; primary: !root.library-added;
                            clicked => { root.add-library(); } }
                    }
                }

                if root.step == 4: VerticalLayout {
                    alignment: center; spacing: 12px;
                    Text { text: "You're all set"; color: Theme.text; font-size: 24px; font-weight: 800; horizontal-alignment: center; }
                    Text { text: "Press Cmd/Ctrl + K any time for the command palette, or ? for shortcuts.";
                        color: Theme.text-dim; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                }
            }

            // Nav.
            HorizontalLayout {
                spacing: 10px;
                WizBtn { label: "Back"; ghost: true; primary: false;
                    clicked => { if root.step > 0 { root.step -= 1; } } }
                Rectangle { horizontal-stretch: 1; }
                if root.step < root.last-step: WizBtn { label: root.step == 3 ? "Skip" : "Next"; primary: root.step != 3;
                    clicked => { root.step += 1; } }
                if root.step == root.last-step: WizBtn { label: "Get started"; clicked => { root.finished(); } }
            }
        }
    }
}
