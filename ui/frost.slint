import { Theme } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";

// Slint can't truly blur the OS desktop without raw window handle integration.
// We approximate with layered translucent fills + faint inner-highlight + outline.
// Per-depth alpha tuned so the visual weight matches a real backdrop-filter.

export component AtmosphereFrost inherits Rectangle {
    background: Theme.atmosphere;
    Rectangle {
        background: @radial-gradient(circle, rgba(124, 58, 237, 0.10) 0%, transparent 60%);
    }
}

export component PanelFrost inherits Rectangle {
    in property <color> accent: Theme.brand;
    border-radius: Theme.radius-md;
    background: Surface.body(Theme.panel);
    border-color: Surface.hairline;
    border-width: 1px;
    Rectangle { // 5% accent wash
        border-radius: parent.border-radius;
        background: accent;
        opacity: 0.05;
    }
    Rectangle { // inner highlight
        border-radius: parent.border-radius;
        border-width: 1px;
        border-color: Theme.highlight-inner;
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
    }
}

// The backdrop behind a modal.
//
// Same caveat as the rest of this file: there is no backdrop-filter to blur what
// is behind it, so the frosting is layered instead — a dense atmosphere fill
// that washes the page out, a soft accent bloom under the panel, and a vignette
// that darkens the edges. The page behind reads as pushed back and out of focus
// rather than merely dimmed, which is what a flat black scrim gets wrong.
export component ScrimFrost inherits Rectangle {
    in property <color> accent: Theme.brand;
    background: Theme.dark ? #05070c.with-alpha(0.80) : #eef0f4.with-alpha(0.78);
    Rectangle {
        background: @radial-gradient(circle, root.accent.with-alpha(0.10) 0%, transparent 62%);
    }
    Rectangle {
        background: @radial-gradient(circle, #00000000 40%, #00000059 100%);
    }
}

export component ModalFrost inherits Rectangle {
    in property <color> accent: Theme.brand;
    border-radius: Theme.radius-lg;
    background: Theme.modal;
    border-color: Theme.outline-strong;
    border-width: 1px;
    drop-shadow-blur: Surface.cast(48px);
    drop-shadow-color: #00000099;
    Rectangle { // 12% accent wash
        border-radius: parent.border-radius;
        background: accent;
        opacity: 0.12;
    }
    Rectangle { // inner highlight
        border-radius: parent.border-radius;
        border-width: 1px;
        border-color: Theme.highlight-inner;
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
    }
}
