// Finances — the ninth section: everything touching money.
//
// One `tab` string drives which view renders, rather than ten booleans that can
// disagree with each other. Same shape as Genesis's `phase`.
//
//   overview  — liquid/spent/saved/debt strip, spend breakdown, what needs you
//   txns      — the ledger, 25 rows a page, sorted in SQL
//   accounts  — balances and reconcile; loans with amortisation
//   planning  — what to do next: health, cash flow, timeline, what needs you,
//               envelopes, predictions, trends, habits, review, advice. One
//               scroll, no sub-tabs, and no link off it to another tab. The
//               tables it summarises open as modals off `plan-modal` —
//               calendar, flow, budgets, trends, review, subs — which is where
//               the Plan, Budgets, Calendar and Insights tabs went.
//   bills     — estimate vs actual, mark paid, overdue
//   subs      — fixed recurring charges, price history, pause, cancel
//   dues      — "Lending": money between you and named people, both directions
//
// Every amount arriving here is already a formatted string. Money is `i64` minor
// units everywhere in `tulipix-finances`, and the only place a decimal point is
// allowed to exist is the formatting helper the glue crate calls — so this file
// never does arithmetic on money and cannot introduce a rounding bug.
//
// Where a figure is an estimate rather than a fact it arrives with its `~`
// already on it, because that distinction is a rule of the design and not a
// styling choice this file gets to make.
import { Theme } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";
import { ScrollView, LineEdit, ComboBox, Switch } from "std-widgets.slint";
import { AppIcon, Icons } from "icons.slint";
import { ScrimFrost } from "frost.slint";
// The same header primitives Photos · Videos · Music · Books · Cloud · Tools use.
// This section had its own chip and its own search box; two headers built from one
// set of parts is the reason every page in the app reads as the same app.
import { HdrChip, HdrSearch } from "section_header.slint";

// ── section surface tokens ──────────────────────────────────────────────────
// Derived from the app theme rather than hardcoded, so light/dark/OLED all work
// without a second palette to keep in step.
export global FinTheme {
    out property <color> accent:   Theme.finances-accent;
    out property <color> accent-2: Theme.finances-accent-2;
    // The section's identity gradient: lime → yellow at 135°, on every active tab,
    // primary button and filled bar. One brush rather than each site composing its
    // own, so the ramp cannot drift between the header and the body.
    out property <brush> accent-grad: @linear-gradient(135deg, Theme.finances-accent, Theme.finances-accent-2);
    // Ink for text sitting *on* the accent. Lime is a light hue: white on it fails
    // contrast, so anything filled with the gradient gets this instead.
    out property <color> on-accent: #1a2e05;
    out property <bool>  light:     !Theme.dark;
    out property <color> canvas:   Theme.atmosphere;
    // Material, and only material: the lime ramp, the ink and the good/warn/bad
    // status colours stay exactly where they are in every language. A finances
    // page whose alarm colours moved with the skin is a page you cannot read.
    out property <color> card:     Surface.clay ? Surface.card-ink
        : (Surface.skeuo ? Surface.plate-ink : Theme.panel);
    out property <color> card-2:   Surface.clay ? Surface.clay-key
        : (Surface.skeuo ? Surface.key-top : Theme.panel-2);
    out property <color> hairline: Surface.hairline;
    out property <color> ink:      Theme.text;
    out property <color> ink-dim:  Theme.text-dim;
    out property <color> pill-bg:  Surface.clay ? Surface.clay-key
        : (Surface.skeuo ? Surface.key-top : Theme.glass);
    out property <color> good:     Theme.ok;
    out property <color> warn:     Theme.warn;
    out property <color> bad:      Theme.error;

    // Row tint for a transfer. Transfers are shown but must read as obviously
    // different from spending, since they are excluded from every spend total.
    out property <color> transfer-ink: Theme.text-dim;
}

// ── data shapes ─────────────────────────────────────────────────────────────

// One tile in the Overview strip. `tone` is ok | warn | bad | flat.
//
// `delta` is a change against the previous month, shown as a pill instead of the
// `sub` line when there is one. Empty when there is no month to compare against —
// a first-month "+100%" is arithmetic, not information.
export struct FinStat {
    label: string,
    value: string,
    sub: string,
    tone: string,
    delta: string,
    delta-up: bool,
    // Non-empty when the card opens something. Only the health score does: the
    // rest are single figures off the ledger with nothing more to say.
    action: string,
}

// One component of the health score, for the popup behind it.
export struct FinHealthPart {
    label: string,
    points: string,        // "18 / 25", or "not measured"
    pct: int,              // 0-100 of what this part was worth
    detail: string,
    measured: bool,
    tone: string,
}

export struct FinAccountRow {
    id: int,
    name: string,
    kind: string,          // bank|cash|card|wallet|loan|virtual
    // The badge: one glyph — the account's initial, or the currency symbol when
    // it holds cash — on a colour picked from its own name, so the same account
    // keeps the same badge however the list reorders.
    badge: string,
    hue: color,
    balance: string,
    sub: string,           // "•••• 4471 · 25% of limit" or the account kind
    util-pct: int,         // 0 when there is no credit limit
    negative: bool,
    closed: bool,
    txn-count: int,
    // The card's detail lines. Each is empty when it does not apply to this kind
    // of account, and the card simply leaves it out — a bank account has a
    // reconcile and a month's flow, a card has a statement, a wallet has a
    // top-up, and none of them should show the others' blanks.
    reconciled: string,    // "21 Jul · matched" or "never checked"
    in-month: string,
    out-month: string,
    limit-note: string,    // "9.5% of ₹2,00,000 limit"
    statement: string,
    minimum-due: string,
    drift: string,         // cash only; empty when it has not drifted
    drift-bad: bool,
    topped-from: string,
    last-topup: string,
    // The merged holding card only. Lent out and Borrowed are two halves of one
    // fact — what is outstanding between you and other people — so they are one
    // card with both figures rather than two cards with one each.
    lent: string,
    borrowed: string,
}

export struct FinTxnRow {
    id: int,
    date: string,
    description: string,
    category: string,
    // The colour this category has in the donut. Carried per row so a tag in the
    // ledger and a slice in the chart are visibly the same category.
    cat-hue: color,
    account: string,
    source: string,        // Manual | CSV | OFX | OCR | Recurrence
    amount: string,
    running: string,       // empty unless one account is filtered
    kind: string,          // expense|income|transfer
}

// A recurrence: subscription or bill. One struct, because they are one table.
export struct FinRecurRow {
    id: int,
    name: string,
    kind: string,          // subscription|bill
    amount: string,        // already carries "~" when it is an estimate
    is-estimate: bool,
    cycle: string,
    next-due: string,
    // The same date as `next-due` without its year, for the table column. Slint
    // cannot slice a string, so both forms are built in Rust.
    next-short: string,
    days: int,             // negative when overdue
    status: string,        // active|paused|cancelled
    account: string,
    category: string,
    // First letter of the name, and the colour of the square it sits on.
    badge: string,
    hue: color,
    // What the service charges under its own name — its note, or its own-currency
    // price, and the currency code. The columns beside it are base-currency.
    plan: string,
    // Whole percent above the oldest recorded price. 0 when it has never risen.
    hike-pct: int,
    yearly: string,
    // The same commitment as `yearly`, per month. Both are shown: a monthly figure
    // is what someone feels and a yearly one is what they cancel on.
    monthly: string,
    hike-from: string,     // empty when the price has never risen
    auto-post: bool,
    last-paid: string,
    cat-hue: color,
    // Days since anything was played, for a video subscription Videos says has
    // not been opened. 0 when it does not apply — the one thing a generic
    // finance app cannot tell you.
    // The amount as the service charges it, when that is not the base currency.
    // The stored figure is the truth; the converted one is always derived.
    original: string,
}

// A materialised instance: dated money that is owed but has not moved.
export struct FinObligationRow {
    id: int,
    name: string,
    kind: string,          // subscription|bill|one-off
    due: string,
    // Day of the month, so the calendar's agenda can pick one day's rows out of
    // the month it already has rather than asking SQL again on every click.
    day: int,
    days: int,
    estimate: string,
    actual: string,
    variance: string,      // empty until both are known
    over: bool,            // actual came in above the estimate
    status: string,        // upcoming|due|overdue|paid|skipped
    is-estimate: bool,
    category: string,
    cat-hue: color,
    account: string,       // which account pays it
    // Posts itself on its due date. The Bills table separates these out, because a
    // bill that needs no action is not on the same footing as one that does.
    auto-post: bool,
}

export struct FinDueRow {
    id: int,
    person: string,
    direction: string,     // owed_to_me|i_owe
    amount: string,
    original: string,
    settled: string,
    opened: string,
    age-days: int,
    status: string,        // open|settled|written_off
    note: string,
    part-paid: bool,
}

export struct FinBudgetRow {
    category-id: int,
    name: string,
    budget: string,
    spent: string,
    remaining: string,
    used-pct: int,
    projected: string,
    projected-pct: int,
    over: bool,
    off-pace: bool,
    rollover: bool,
    carried: string,
    unset: bool,           // spending with no envelope: worth setting one on
    // "14 transactions · biggest ₹1,240 Toit". An envelope broken by one
    // purchase is a different problem from one broken by forty.
    detail: string,
    // How far over, as words, when it is over. Empty otherwise.
    over-by: string,
}

export struct FinLoanRow {
    account-id: int,
    name: string,
    badge: string,
    hue: color,
    balance: string,
    principal: string,
    emi: string,
    rate: string,
    progress-pct: int,
    remaining-months: int,
    tenure-months: int,
    next-due: string,
    // How the next instalment divides, which is the number that tells someone
    // why a loan they have paid for five years has barely moved.
    emi-principal: string,
    emi-interest: string,
    // When it closes, and what the rest of it costs in interest from here.
    closes: string,
    interest-left: string,
    interest-free: bool,
}

export struct FinInstalment {
    n: int,
    due: string,
    emi: string,
    principal: string,
    interest: string,
    balance: string,
    interest-pct: int,     // share of this instalment that is interest
}

// One slice of the spend breakdown. `path` is its ring segment as SVG commands,
// computed in Rust because Slint has no trigonometry and no way to express an
// arc without it.
//
// `start` is where the segment begins, in the same percent-of-the-circle units
// as `pct`. A Path cannot be hit-tested, so hovering the ring works by turning
// the pointer into an angle and asking each slice whether it covers it.
// One disc in the actions popup. A model rather than four hand-written orbs,
// because what the button offers now depends on which tab you pressed it from.
export struct FinAction {
    key: string,
    label: string,
    label-2: string,
    icon: image,
    hue: color,
    hue-2: color,
    ink: color,
}

export struct FinCatSlice {
    name: string,
    amount: string,
    pct: int,
    start: int,
    path: string,
    hue: color,
}

// One bar in the twelve-month chart. `expense-pct` is of the heaviest month's
// spending, which is what the chart's axis is topped with.
//
// Spending only. The bars are also the month picker for the breakdown above
// them, so `long` carries the month and its year ("Jul 2026") for the card's
// heading — the bar's own label has no room for a year.
export struct FinMonthBar {
    label: string,
    long: string,
    expense: string,
    expense-pct: int,
}

export struct FinCalDay {
    day: int,
    in-month: bool,
    today: bool,
    count: int,
    amount: string,        // money owed on the day, empty when none is
    income: string,        // money arriving on the day, empty when none does
    money-out: bool,
    overdue: bool,
    // Up to four category dots, so a day reads as "loan and two bills" before
    // any figure is looked at. Four fixed slots rather than a nested model: a
    // `[color]` inside a struct is an `Rc` and cannot cross to the event loop,
    // and a fifth dot on a six-by-seven grid is not legible anyway.
    pip-count: int,
    pip1: color,
    pip2: color,
    pip3: color,
    pip4: color,
}

/// One month of the Year view: twelve of these instead of a day grid.
export struct FinCalMonth {
    label: string,
    out: string,
    income: string,
    pct: int,              // share of the busiest month, for the bar
    current: bool,
    count: int,
}

/// A label and a figure. Used wherever the mockup shows a list of them —
/// the cash-flow walk, the fixed obligations no envelope covers, the position
/// summary — rather than four near-identical structs.
export struct FinKv {
    label: string,
    value: string,
    tone: string,          // flat|ok|warn|bad
    strong: bool,
}

/// One envelope's row in the six-month discipline grid. `cells` is one string
/// per month, empty for a month the envelope did not exist in.
export struct FinEnvelopeHistory {
    name: string,
    cells: [string],
    over: [bool],
    avg-delta: string,
    avg-over: bool,
}

// A claim with a number behind it, and something to do about it.
export struct FinFlag {
    severity: string,      // bad|warn|info|good
    title: string,
    detail: string,
    action-label: string,  // empty means there is nothing to press
    action: string,        // routed back to Rust verbatim
}

export struct FinDiscipline { period: string, budget: string, spent: string, within: bool, pct: int }

// One month of one category's six-month trend. `pct` is a share of that category's
// own worst month, not of the whole ledger — otherwise every category but the
// largest is a flat line at the bottom.

/// One month of the savings-rate chart. `known` is false for a month with no
/// income at all — drawn as a gap rather than as a zero, because "the salary
/// landed late" and "nothing was saved" are not the same claim.
export struct FinSavingsMonth {
    label: string,
    pct: int,
    known: bool,
    current: bool,
    amount: string,
}

/// One month of the Trends popup, as a ring. Built by the same `slices` that
/// draws the Overview's donut, so the two cannot disagree about a month.
export struct FinTrendPie {
    /// "Mar", for the month picker.
    label: string,
    /// "March 2026", for the heading over the ring.
    long: string,
    total: string,
    slices: [FinCatSlice],
}


// ── Planning ────────────────────────────────────────────────────────────────

/// One card on the Planning timeline: a day this month does something.
///
/// A day, not an obligation. Three bills on the 8th are one thing that happens
/// on the 8th, and drawing them as three cards makes a busy day look like a busy
/// week.
export struct FinTimelineEvent {
    day: int,
    // Where that day sits in `cal-days`, so clicking a card can hand the calendar
    // the cell itself rather than a number it would have to search for.
    // -1 when the day is not on the grid, which nothing built from the same
    // month can be.
    idx: int,
    name: string,
    amount: string,
    sub: string,
    hue: color,
    income: bool,
    // The closing balance. Not an event — it is where the row leads, and the
    // design puts it at the end of the row for exactly that reason.
    closing: bool,
    count: int,
}

/// An envelope and the date it runs out on at the pace it is going.
export struct FinPrediction {
    name: string,
    finish: string,
    note: string,
    hue: color,
    // Runs out before the month does. The whole point of the card.
    soon: bool,
    // Daily spend, each a share of this envelope's own worst day. Its own worst
    // day rather than the month's, so a small envelope still shows its shape.
    points: [int],
}

/// One row of the habits list. `pct` is only drawn when `bar` is set — two of
/// the four are counts, and a bar under a count would be measuring nothing.
export struct FinHabit {
    label: string,
    value: string,
    pct: int,
    hue: color,
    bar: bool,
    action-label: string,
    action: string,
}

/// One metric of the six-month chart. The chart shows one at a time and the
/// selector picks which, so all of them travel and the switch costs no query.
export struct FinTrendSeries {
    name: string,
    months: [FinSavingsMonth],
}

// One row of the exchange-rate editor. `live` is false when the user typed the
// rate, which is also what stops the daily refresh replacing it.
// One line of the exchange-rate monitor.
export struct FinRate {
    code: string,
    // "US dollar" — a code alone is a puzzle for eight of the ten.
    name: string,
    rate: string,
    // The same rate the other way round, so the pair converts in both directions
    // without anyone dividing in their head.
    inverse: string,
    edited: string,
    live: bool,
    // Watched, but nothing fetched for it yet.
    known: bool,
}

export struct FinPrice { amount: string, from: string }

// A detected recurring charge, awaiting confirmation. Nothing is created until
// the user presses Add.
export struct FinProposal {
    idx: int,
    name: string,
    kind: string,          // subscription|bill
    amount: string,
    cycle: string,
    next-due: string,
    occurrences: int,
    confidence: string,    // high|low
}

export struct FinImportRow { date: string, description: string, amount: string, credit: bool }

// One field of whichever sheet is open. The form is built in Rust and rendered
// generically here — the same approach the Tools section uses, and the reason
// this file does not contain thirteen hand-built dialogs.
export struct FinField {
    key: string,
    label: string,
    kind: string,          // text|number|money|date|dropdown|toggle|static|note
    value: string,
    hint: string,
    options: [string],
    required: bool,
}

// ── small parts ─────────────────────────────────────────────────────────────

// A local empty state. `empty_state.slint`'s component is keyed to a `Section`
// enum and its own accent halo; this one takes an icon and a tint directly,
// which is what a nine-tab section with nine different blank states needs.
component Blank inherits Skin {
    in property <string> title;
    in property <string> body;
    in property <image> icon;
    in property <color> tint: FinTheme.accent;
    min-height: 190px;
    background: transparent;
    VerticalLayout {
        alignment: center; spacing: 10px; padding: 24px;
        Rectangle {
            min-height: 48px; max-height: 48px;
            background: transparent;
            Rectangle {
                width: 48px; height: 48px; border-radius: Surface.rr(15px, self.width, self.height);
                x: (parent.width - self.width) / 2;
                background: root.tint.with-alpha(0.14);
                AppIcon {
                    source: root.icon; tint: root.tint;
                    width: 24px; height: 24px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        Text {
            text: root.title; color: FinTheme.ink; font-size: 15px; font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.body; color: FinTheme.ink-dim; font-size: 12px;
            horizontal-alignment: center; wrap: word-wrap;
        }
    }
}

component Pill inherits Skin {
    in property <string> label;
    in property <color> hue: FinTheme.ink-dim;
    in property <bool> solid: false;
    // A status pill leads with a filled dot in its own colour — the difference
    // between "this is a tag" and "this is a state right now".
    in property <bool> dot: false;
    // Section headings wear the same pill at a larger size, so a tag on a row
    // and the title above a grid cannot drift into two different shapes.
    in property <length> h: 22px;
    // Fixed width instead of hugging its own label. A column of these — the days
    // left in "Needs you" — reads as a column only if every pill is the same block;
    // hugging makes "today" and "12d late" two different shapes at two different
    // widths, which no amount of centring the box fixes.
    in property <length> w: 0px;
    property <length> lead: root.dot ? root.h * 0.3 + 5px : 0px;
    property <length> hug: t.width + root.h * 0.82 + root.lead;
    horizontal-stretch: 0;
    // `height` and `width`, not min/max: several of these are placed by hand inside
    // a plain Rectangle, where layout constraints do nothing — the pill stretched to
    // the cell it was centred in, which put its label back on the left. An explicit
    // size is honoured in a layout as well, and Slint will not take both.
    height: root.h;
    width: root.w > 0px ? root.w : root.hug;
    border-radius: Surface.r(root.h / 2);
    background: root.solid ? root.hue : root.hue.with-alpha(0.15);
    if root.dot: Rectangle {
        x: root.h * 0.41;
        y: (parent.height - self.height) / 2;
        width: root.h * 0.3; height: self.width;
        border-radius: self.width / 2;
        background: root.solid ? #ffffff : root.hue;
    }
    t := Text {
        // Centred without a dot (`lead` is 0, and the padding either side is the
        // same 0.41h), pushed off the dot with one. On a fixed-width pill the label
        // is centred in what it was given rather than sitting on the left padding.
        x: root.w > 0px
            ? (parent.width - self.width + root.lead) / 2
            : root.h * 0.41 + root.lead;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.solid ? #ffffff : root.hue;
        font-size: root.h * 0.5;
        font-weight: 700;
    }
}

// The 32px rounded square that opens a list row — the mockup's `.logo`.
//
// The lettered version of this — a name's initial on its own colour — is
// `AccountBadge`, fed from Rust because Slint cannot take the first character of
// a string. Use that where the row is a *named* thing (an account, a service).
// This one is for rows that are not: a transaction has a merchant, not an
// identity, so it carries what the section does know — what kind of thing the
// row is — as an icon on a wash of its meaning colour.
component Tile inherits Skin {
    in property <image> icon;
    in property <color> hue: FinTheme.accent;
    in property <length> size: 32px;
    // Filled with the hue and a white glyph, instead of a wash of the hue and a
    // glyph in it. Used where a list wants its rows told apart at a glance rather
    // than tinted alike — so `hue` must be a colour white actually reads on, which
    // the section's lime ramp is not.
    in property <bool> solid: false;
    horizontal-stretch: 0; vertical-stretch: 0;
    min-width: root.size; max-width: root.size;
    min-height: root.size; max-height: root.size;
    border-radius: root.size / 3.2;
    background: root.solid ? root.hue
        : root.hue.with-alpha(FinTheme.light ? 0.20 : 0.16);
    AppIcon {
        source: root.icon;
        tint: root.solid ? #ffffff
            : (FinTheme.light ? root.hue.darker(0.25) : root.hue);
        width: root.size / 2; height: root.size / 2;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// Pulsing warning pill. Amber, outlined, and breathing — for the one notice in
// this section that must not be possible to overlook or dismiss by ignoring.
//
// The pulse is a triangle wave off `animation-tick()` rather than a `Timer`: it
// needs no state, cannot drift, and stops costing anything the moment the element
// is not instantiated.
component WarnPulse inherits Skin {
    in property <string> label;
    // Quiet: there is no sample data on screen, so this is not a warning — it is the
    // way back to the explainer. Same chip, no heartbeat, no alarm colour.
    in property <bool> quiet: false;
    in property <image> icon: Icons.triangle-alert;
    callback clicked();
    horizontal-stretch: 0; vertical-stretch: 0;
    min-height: 44px; max-height: 44px;
    min-width: l.width + 60px; max-width: l.width + 60px;
    border-radius: 22px;
    property <color> tone: root.quiet ? FinTheme.ink-dim : FinTheme.warn;
    // 1.4s there and back. Slow enough to read as a heartbeat rather than a
    // hazard light, which would be unusable to sit next to.
    property <float> beat: root.quiet
        ? 0.0
        : Math.abs(Math.mod(animation-tick() / 700ms, 2.0) - 1.0);
    background: root.tone.with-alpha(0.10 + 0.16 * root.beat);
    border-width: 1.5px;
    border-color: root.tone.with-alpha(0.45 + 0.4 * root.beat);
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    AppIcon {
        source: root.icon; tint: root.tone;
        width: 16px; height: 16px;
        x: 16px; y: (parent.height - self.height) / 2;
    }
    l := Text {
        x: 40px; y: (parent.height - self.height) / 2;
        text: root.label; color: root.tone;
        font-size: 13px; font-weight: 700;
    }
}

// The same chip while the sample data is being written or cleared.
//
// Seeding a year of accounts, postings, bills and budgets takes long enough to
// look like nothing happened, and the button that started it had already closed
// its own popup. An indeterminate sweep rather than a percentage: the work is a
// few hundred inserts of wildly different cost, and a progress bar that jumps
// from 4% to 90% is a worse lie than no number at all.
component BusyPill inherits Skin {
    in property <string> label;
    horizontal-stretch: 0; vertical-stretch: 0;
    min-height: 44px; max-height: 44px;
    min-width: bl.width + 60px; max-width: bl.width + 60px;
    border-radius: 22px;
    background: FinTheme.accent.with-alpha(0.12);
    border-width: 1.5px;
    border-color: FinTheme.accent.with-alpha(0.45);
    clip: true;
    Rectangle {
        width: parent.width * 0.4;
        height: parent.height;
        // One pass every 1.1s, entering from the left edge and leaving past the
        // right, so the chip reads as working rather than as merely tinted.
        x: (parent.width + self.width) * Math.mod(animation-tick() / 1100ms, 1.0) - self.width;
        background: @linear-gradient(90deg,
            #ffffff00 0%, FinTheme.accent.with-alpha(0.28) 50%, #ffffff00 100%);
    }
    AppIcon {
        source: Icons.refresh-cw; tint: FinTheme.accent;
        width: 16px; height: 16px;
        x: 16px; y: (parent.height - self.height) / 2;
        transform-rotation: (Math.mod(animation-tick() / 1100ms, 1.0) * 360) * 1deg;
    }
    bl := Text {
        x: 40px; y: (parent.height - self.height) / 2;
        text: root.label; color: FinTheme.accent;
        font-size: 13px; font-weight: 700;
    }
}

// A 30px filter chip with an optional count — the mockup's `.chip.sm`. Filters are
// not tabs, so these are quieter than `FinTab`: accent fill when on, glass when not,
// and no gradient.
component FilterChip inherits HdrChip {
    in property <bool> on: false;
    active: root.on;
    accent: FinTheme.accent;
    active-text: FinTheme.on-accent;
    dark: !FinTheme.light;
    dk-idle: FinTheme.pill-bg;
    dk-hover: FinTheme.card-2;
    dk-text: FinTheme.ink-dim;
    dk-border: FinTheme.hairline;
    // A fixed width when the caller asks for one. Chips that each size to their
    // own label make a ragged row, and the counts inside them change length as
    // the data does — so the row reflows while it is being read.
    in property <length> w: 0px;
    height: 30px;
    min-width: root.w > 0px ? root.w : 72px;
    max-width: root.w > 0px ? root.w : 100000px;
}

// Section tab — the shared header chip with this section's gradient baked in.
//
// All seven carry the same lime→yellow ramp rather than a colour each: the accent
// is the section's identity, and seven hues in one row would compete with the
// category colours in the charts below, which *are* meaningful.
//
// `collapsible` is what keeps the row on one line at any width: icon-only at
// rest, expanding to icon + name on hover or when active. Same behaviour as the
// Music header, which solved this first.
component FinTab inherits HdrChip {
    in property <bool> compact: false;
    has-grad: true;
    tint: FinTheme.accent;
    grad: FinTheme.accent-grad;
    active-text: FinTheme.on-accent;
    dark: !FinTheme.light;
    light-theme: FinTheme.light;
    collapsible: root.compact;
    min-width: root.compact ? (self.revealed ? root.wide : 44px) : root.wide;
    animate min-width { duration: 200ms; easing: ease-out; }
    // Width when the label is showing. Per-tab because "Subscriptions" and "Lending"
    // do not want the same pill.
    in property <length> wide: 104px;
}

// Pill button. Secondary is a glass fill with a hairline border, primary is the
// section gradient — the mockup's `.hbtn` / `.hbtn.solid` pair. An optional
// leading icon, because a header button with a label and no icon reads as a link.
component Btn inherits Skin {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <length> h: 38px;
    // A primary button whose gradient never settles. Slint cannot animate a
    // gradient's stops, but it can animate the colours the gradient is built from —
    // so the two ends swap, easing, forever. For the one button on a screen that is
    // the point of the screen; anywhere else it is a distraction.
    in property <bool> pulse: false;
    property <bool> flip: false;
    Timer {
        interval: 1600ms;
        running: root.pulse && root.enabled;
        triggered => { root.flip = !root.flip; }
    }
    property <color> pa: root.flip ? FinTheme.accent-2 : FinTheme.accent;
    property <color> pb: root.flip ? FinTheme.accent : FinTheme.accent-2;
    animate pa, pb { duration: 1550ms; easing: ease-in-out; }
    callback clicked();
    horizontal-stretch: 0;
    min-height: root.h; max-height: root.h;
    border-radius: root.h / 2;
    property <color> hue: root.danger ? FinTheme.bad : FinTheme.accent;
    background: !root.enabled ? FinTheme.pill-bg
              : root.pulse
                ? (ta.has-hover ? FinTheme.accent
                                : @linear-gradient(125deg, root.pa, root.pb))
              : root.primary
                ? (root.danger
                    ? (ta.has-hover ? root.hue.darker(0.12) : root.hue)
                    // Hover deepens to the flat accent, so the press has feedback
                    // the gradient alone cannot give.
                    : (ta.has-hover ? FinTheme.accent : FinTheme.accent-grad))
              : (ta.has-hover ? FinTheme.pill-bg.with-alpha(0.95) : FinTheme.pill-bg);
    border-width: root.primary ? 0px : 1px;
    border-color: root.primary ? transparent
                : (root.danger ? root.hue.with-alpha(0.45) : FinTheme.hairline);
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    // Lime is a light accent, so a primary button needs dark ink on it to stay
    // readable — white on #84cc16 fails contrast.
    property <color> ink: !root.enabled ? FinTheme.ink-dim
        : root.primary ? (root.danger ? #ffffff : FinTheme.on-accent)
        : (root.danger ? root.hue : (ta.has-hover ? FinTheme.ink : FinTheme.ink-dim));
    HorizontalLayout {
        padding-left: root.icon.width > 0 ? 14px : 16px;
        padding-right: 16px;
        spacing: 8px; alignment: center;
        if root.icon.width > 0: VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon { source: root.icon; tint: root.ink; width: 16px; height: 16px; }
        }
        Text {
            text: root.label; color: root.ink;
            font-size: 13px; font-weight: 700; vertical-alignment: center;
        }
    }
    animate background { duration: 120ms; }
}

component IconBtn inherits Skin {
    in property <image> icon;
    in property <string> tip;
    in property <color> hue: FinTheme.ink-dim;
    // Greyed and inert rather than hidden, so a pager keeps its shape at the
    // ends of the range instead of shuffling the row about.
    in property <bool> enabled: true;
    callback clicked();
    horizontal-stretch: 0;
    min-width: 30px; max-width: 30px;
    min-height: 30px; max-height: 30px;
    border-radius: Surface.rr(9px, self.width, self.height);
    opacity: root.enabled ? 1.0 : 0.35;
    background: root.enabled && ta.has-hover ? FinTheme.pill-bg : transparent;
    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    AppIcon {
        source: root.icon;
        tint: root.enabled && ta.has-hover ? FinTheme.ink : root.hue;
        width: 16px; height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component Card inherits Skin {
    border-radius: Surface.rr(16px, self.width, self.height);
    background: FinTheme.card;
    border-width: 1px;
    border-color: FinTheme.hairline;
}

// A card that is also a way in to the tab it summarises.
//
// The touch area is declared before `@children`, so it sits underneath them: a
// click on a heading, a row or the empty space below the last row falls through
// to it, while anything the contents make interactive keeps its own click.
component LinkCard inherits Card {
    callback opened();
    border-color: lta.has-hover ? FinTheme.accent.with-alpha(0.45) : FinTheme.hairline;
    animate border-color { duration: 120ms; }
    lta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.opened(); }
    }
    @children
}

// One label-and-figure line. Used by every card the mockup draws as a list of
// them — the position walk, the cash-flow walk, the fixed obligations, the
// savings summary, the projection — so they share one set of type sizes and one
// hairline rule instead of five hand-built copies drifting apart.
component KvRow inherits Rectangle {
    in property <FinKv> kv;
    in property <bool> rule: true;
    min-height: 30px;
    background: transparent;
    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.kv.label; color: FinTheme.ink-dim;
            font-size: 12px; vertical-alignment: center;
            horizontal-stretch: 1; overflow: elide;
        }
        Text {
            text: root.kv.value;
            color: root.kv.tone == "bad"  ? FinTheme.bad
                 : root.kv.tone == "warn" ? FinTheme.warn
                 : root.kv.tone == "ok"   ? FinTheme.good
                                          : FinTheme.ink;
            font-size: 12.5px;
            font-weight: root.kv.strong ? 800 : 600;
            vertical-alignment: center; horizontal-stretch: 0;
        }
    }
    if root.rule: Rectangle {
        y: parent.height - 1px;
        height: 1px; width: parent.width;
        background: FinTheme.hairline;
    }
}

// The frame the account and loan detail popups share: scrim, centred panel,
// title block, big figure, close button, and whatever the caller puts inside.
//
// Same geometry and chrome as the edit sheet on purpose — pressing Edit swaps
// one for the other, and a panel that jumped size or position between the two
// would read as a second dialog rather than as the same one changing mode.
// An account's mark: one glyph on a solid colour. A letter beats an icon here —
// four accounts of the same kind get four identical wallet icons, and the thing
// being told apart is the bank, not the kind.
component AccountBadge inherits Rectangle {
    in property <string> glyph;
    in property <color> hue;
    in property <length> side: 30px;
    width: root.side; height: root.side;
    border-radius: Surface.rr(root.side / 3.3, self.width, self.height);
    background: root.hue;
    Text {
        text: root.glyph;
        // White on every hue in the palette, which is what keeps a badge legible
        // when the theme flips: the square brings its own background.
        color: #ffffff;
        font-size: root.side * 0.46; font-weight: 800;
        width: 100%; height: 100%;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// Escape closes it, Enter takes the primary action, a click on the backdrop
// closes it. Same three keys as every other modal in the app.
component DetailModal inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> amount;
    in property <bool> amount-bad;
    in property <string> badge;
    in property <color> hue;
    callback closed();
    callback confirmed();
    width: 100%; height: 100%;
    background: transparent;
    ScrimFrost { width: 100%; height: 100%; accent: FinTheme.accent; }
    TouchArea { clicked => { root.closed(); } }

    FocusScope {
        width: 100%; height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.closed(); return accept; }
            if (e.text == Key.Return) { root.confirmed(); return accept; }
            reject
        }

        Rectangle {
            width: Math.min(root.width - 64px, 560px);
            height: Math.min(root.height - 64px, Math.max(220px, dbody.preferred-height));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Surface.rr(20px, self.width, self.height);
            background: Theme.modal;
            border-width: 1px;
            border-color: FinTheme.hairline;
            drop-shadow-blur: Surface.cast(40px);
            drop-shadow-color: #00000070;
            // Swallows clicks inside the panel so they never reach the scrim.
            TouchArea { }

            dbody := VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        AccountBadge { glyph: root.badge; hue: root.hue; side: 38px; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 2px; alignment: center;
                        Text { text: root.title; color: FinTheme.ink;
                            font-size: 17px; font-weight: 800; overflow: elide; }
                        if root.subtitle != "": Text { text: root.subtitle;
                            color: FinTheme.ink-dim; font-size: 11.5px; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        IconBtn { icon: Icons.x; clicked => { root.closed(); } }
                    }
                }
                Text {
                    text: root.amount;
                    color: root.amount-bad ? FinTheme.bad : FinTheme.ink;
                    font-size: 26px; font-weight: 800;
                }
                ScrollView {
                    vertical-stretch: 1;
                    preferred-height: dinner.preferred-height;
                    dinner := VerticalLayout {
                        padding-right: 6px; spacing: 10px; alignment: start;
                        @children
                    }
                }
            }
        }
    }
}

// A read-only drill-down: a title, a close, and whatever the caller puts in it.
//
// Planning is one page, which is the whole point of it — so the tables the page
// was summarised from live behind the links the design puts on each section
// rather than in tabs of their own. Escape and the backdrop both close it, like
// every other modal in the app; there is nothing to confirm, so Enter does not.
component PlanModal inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    callback closed();
    width: 100%; height: 100%;
    background: transparent;
    ScrimFrost { width: 100%; height: 100%; accent: FinTheme.accent; }
    TouchArea { clicked => { root.closed(); } }

    FocusScope {
        width: 100%; height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.closed(); return accept; }
            reject
        }

        Rectangle {
            width: Math.min(root.width - 64px, 980px);
            // Ends where its contents do, up to the window — the same measure
            // the sheet uses. A fixed slab the height of the screen left a short
            // drill-down, four flags and a table, above a hand's width of empty
            // card, and the emptiest ones were the ones that needed no scroll.
            height: Math.min(root.height - 72px, Math.max(220px, body.preferred-height));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Surface.rr(20px, self.width, self.height);
            background: Theme.modal;
            border-width: 1px;
            border-color: FinTheme.hairline;
            drop-shadow-blur: Surface.cast(40px);
            drop-shadow-color: #00000070;
            // Swallows clicks inside the panel so they never reach the scrim.
            TouchArea { }

            body := VerticalLayout {
                padding: 20px; spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 2px; alignment: center;
                        Text { text: root.title; color: FinTheme.ink;
                            font-size: 17px; font-weight: 800; overflow: elide; }
                        if root.hint != "": Text { text: root.hint;
                            color: FinTheme.ink-dim; font-size: 11.5px; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        IconBtn { icon: Icons.x; clicked => { root.closed(); } }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    // A ScrollView's own `preferred-height` is 100% of whatever
                    // holds it, so a panel measured through one measures nothing.
                    // Reporting what is inside makes the panel as tall as its
                    // content and hands scrolling back when there is too much.
                    preferred-height: inner.preferred-height;
                    inner := VerticalLayout {
                        alignment: start;
                        padding-right: 6px; spacing: 14px;
                        @children
                    }
                }
            }
        }
    }
}

// One of the four things the header used to spend a button on. A disc, because
// four discs in a row read as a choice you make once, where four rectangles read
// as a toolbar you have to keep past.
//
// `sel` is the keyboard's idea of which one is chosen and hover is the pointer's;
// they light the same way, so Enter always fires whatever is currently glowing.
component ActionOrb inherits Rectangle {
    // Two lines, given rather than wrapped. Wrapping "Import Bank Statements" to a
    // width takes three lines where "Scan Bill" takes one, and four labels of
    // different heights put four discs at four different places up the row.
    in property <string> label;
    in property <string> label-2;
    in property <image> icon;
    in property <color> hue;
    in property <color> hue-2;
    // Ink for the glyph. Lime and amber are light accents — white on either fails
    // contrast — so the two that use them ask for the dark ink instead.
    in property <color> ink: #ffffff;
    in property <bool> sel: false;
    callback clicked();
    callback hovered();
    // Fixed, not stretched: two discs sharing a row built for four would sit at
    // opposite ends of it. The row centres them instead.
    horizontal-stretch: 0;
    min-width: 150px; max-width: 150px;
    background: transparent;
    property <bool> on: root.sel || ta.has-hover;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        // Pointing at one selects it, so the mouse and the arrow keys cannot end
        // up disagreeing about what Enter would do.
        changed has-hover => { if (self.has-hover) { root.hovered(); } }
    }
    VerticalLayout {
        spacing: 12px; alignment: center;
        // Exactly the disc, with no room around it. Nothing about the selected state
        // changes a size or a position — it is drawn inside the disc — so the row
        // cannot shift when the selection moves along it.
        Rectangle {
            min-height: 96px; max-height: 96px;
            background: transparent;
            Rectangle {
                width: 96px; height: 96px;
                x: (parent.width - self.width) / 2;
                border-radius: self.width / 2;
                background: @linear-gradient(140deg, root.hue, root.hue-2);
                // Dimmed rather than emptied. The fill is the button's identity, so
                // an unselected one is the same disc turned down, not a hollow ring.
                opacity: root.on ? 1.0 : 0.62;
                drop-shadow-blur: root.on ? Surface.cast(26px) : 0px;
                drop-shadow-color: root.hue.with-alpha(0.5);
                animate opacity, drop-shadow-blur { duration: 170ms; easing: ease-out; }
                // The selected mark, drawn inside the fill.
                if root.on: Rectangle {
                    x: 6px; y: 6px;
                    width: parent.width - 12px; height: parent.height - 12px;
                    border-radius: self.width / 2;
                    border-width: 2px;
                    border-color: root.ink.with-alpha(0.85);
                }
                AppIcon {
                    source: root.icon;
                    tint: root.ink;
                    width: 34px; height: 34px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        VerticalLayout {
            spacing: 1px;
            Text {
                text: root.label;
                color: root.on ? FinTheme.ink : FinTheme.ink-dim;
                font-size: 12.5px; font-weight: 700;
                horizontal-alignment: center;
                animate color { duration: 140ms; }
            }
            Text {
                text: root.label-2;
                color: root.on ? FinTheme.ink : FinTheme.ink-dim;
                font-size: 12.5px; font-weight: 700;
                horizontal-alignment: center;
                animate color { duration: 140ms; }
            }
        }
    }
}

// Everything the header used to hold, as one row of discs.
//
// No panel at all: the discs and the close button sit straight on the scrim. Slint
// has no backdrop-filter — see frost.slint — so a translucent panel over a washed
// backdrop is two layers of haze rather than one, and the outline round it drew a
// box the content did not need.
//
// Esc closes, arrows and Tab move, Enter fires whatever is lit, and anything that
// is not a disc closes it. None of that is printed: a modal that has to explain its
// own keys is a modal with too much on it, and these are the same keys every other
// modal here uses.
component ActionsModal inherits Rectangle {
    in property <[FinAction]> actions;
    callback closed();
    callback act(string);
    property <int> n: Math.max(1, root.actions.length);
    property <int> sel: 0;
    width: 100%; height: 100%;
    background: transparent;
    // Neutral, not the section's accent. `ScrimFrost` blooms whatever colour it is
    // handed under the panel, and the section's accent is lime — which is what was
    // putting a yellow cast on what is meant to read as plain glass.
    ScrimFrost {
        width: 100%; height: 100%;
        accent: FinTheme.light ? #ffffff : #c3c9d6;
    }
    // A second neutral veil on top, because there is no backdrop-filter to turn up:
    // depth of frost here is layers of haze, and one was not enough to stop the
    // page reading through the gaps between the discs.
    Rectangle {
        width: 100%; height: 100%;
        background: FinTheme.light ? #f7f5f0.with-alpha(0.62) : #cdd3e0.with-alpha(0.09);
    }
    TouchArea { clicked => { root.closed(); } }

    FocusScope {
        width: 100%; height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.closed(); return accept; }
            if (e.text == Key.LeftArrow) { root.sel = Math.max(0, root.sel - 1); return accept; }
            if (e.text == Key.RightArrow) {
                root.sel = Math.min(root.n - 1, root.sel + 1); return accept;
            }
            // Wraps, where the arrows stop at the ends: Tab is "the next one", and
            // a Tab that does nothing on the last disc reads as a dead key.
            if (e.text == Key.Tab) { root.sel = Math.mod(root.sel + 1, root.n); return accept; }
            if (e.text == Key.Backtab) {
                root.sel = Math.mod(root.sel + root.n - 1, root.n); return accept;
            }
            if (e.text == Key.Return && root.sel < root.actions.length) {
                root.act(root.actions[root.sel].key);
                return accept;
            }
            reject
        }

        Rectangle {
            width: Math.min(root.width - 80px, 680px);
            height: abody.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: transparent;
            // No close button and nothing swallowing clicks: anywhere that is not a
            // disc is the way out, which is what the backdrop already was.
            abody := VerticalLayout {
                HorizontalLayout {
                    spacing: 10px; alignment: center;
                    for a[i] in root.actions: ActionOrb {
                        label: a.label; label-2: a.label-2;
                        icon: a.icon;
                        hue: a.hue; hue-2: a.hue-2; ink: a.ink;
                        sel: root.sel == i;
                        hovered => { root.sel = i; }
                        clicked => { root.act(a.key); }
                    }
                }
            }
        }
    }
}

// A Rectangle rather than the layout it used to be, so the whole heading row —
// hint included — can carry a touch area *underneath* its text.
//
// `LinkCard` already puts one under the whole card, but the lists in those cards
// now scroll, and a Flickable is entitled to keep the clicks that land inside it.
// The heading is the one part of the card nothing can come between.
// The heading sits on a tinted pill of its own, and each card picks the tint:
// a page of identical headings is a page where nothing tells you which card you
// are looking at. Two inks inside it — the title in the page's own ink, whatever
// else the row carries in the pill's colour — so the label and its figure never
// read as one run of text.
//
// The pill spans the heading rather than hugging the words. A hugging chip would
// have to let a long hint push past its own edge; a band can elide inside it.
component CardTitle inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <bool> link: false;
    in property <color> hue: FinTheme.accent;
    callback clicked();
    background: transparent;
    vertical-stretch: 0;
    min-height: pill.preferred-height;
    lta := TouchArea {
        enabled: root.link;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    pill := Rectangle {
        border-radius: Surface.rr(9px, self.width, self.height);
        background: root.hue.with-alpha(root.link && lta.has-hover ? 0.26
            : (FinTheme.light ? 0.14 : 0.13));
        border-width: 1px;
        border-color: root.hue.with-alpha(0.24);
        animate background { duration: 120ms; }
        row := HorizontalLayout {
            padding-left: 10px; padding-right: 10px;
            padding-top: 6px; padding-bottom: 6px;
            spacing: 10px;
            Text {
                text: root.title;
                color: FinTheme.ink;
                font-size: 13.5px; font-weight: 700;
                vertical-alignment: center;
            }
            // The hue is darkened for the light theme for the same reason the
            // tiles darken theirs: a tint that reads on black is a smear on white.
            if root.hint != "": Text {
                text: root.hint;
                color: FinTheme.light ? root.hue.darker(0.35) : root.hue;
                font-size: 11.5px; font-weight: 600;
                vertical-alignment: center; horizontal-stretch: 1;
                horizontal-alignment: right; overflow: elide;
            }
            if root.hint == "": Rectangle { horizontal-stretch: 1; background: transparent; }
        }
    }
}

// A progress bar that can go past 100%. Over-budget has to be visible, so the
// overflow is drawn in the alarm colour rather than clamped away.
//
// The fill picks its own tone from how full it is — over 100% alarms, 85% and up
// warns, below that it is the caller's hue. A bar at 93% that looks identical to
// one at 40% is a bar that failed to say the only thing it was drawn to say.
// `toned: false` opts out, for the bars that measure progress rather than burn
// (loan repayment, where 93% paid off is good news).
component Bar inherits Skin {
    in property <int> pct: 0;
    in property <color> hue: FinTheme.accent;
    // Set it and the fill becomes a gradient from `hue` to this. Left transparent
    // by default, because a bar that is only reporting a number does not need two
    // colours to do it.
    in property <color> hue-2: transparent;
    in property <length> thickness: 8px;
    in property <bool> toned: true;
    min-height: root.thickness; max-height: root.thickness;
    horizontal-stretch: 1;
    border-radius: root.thickness / 2;
    background: FinTheme.pill-bg;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * Math.min(100, Math.max(0, root.pct)) / 100;
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.pct > 100 ? FinTheme.bad
                  : (root.toned && root.pct >= 85) ? FinTheme.warn
                  : root.hue-2 == transparent ? root.hue
                  : @linear-gradient(90deg, root.hue, root.hue-2);
        animate width { duration: 260ms; easing: ease-out; }
    }
}

// The mockup's `.delta` — a signed change on a tinted ground, with an arrow.
// Up is red and down is green because this only ever labels spending: an arrow
// that means "more" is bad news here, and colouring by direction rather than by
// meaning is how a dashboard ends up congratulating you for overspending.
component Delta inherits Skin {
    in property <string> label;
    in property <bool> up: false;
    horizontal-stretch: 0; vertical-stretch: 0;
    min-height: 22px; max-height: 22px;
    // Sized off the label with no layout in between, like `Pill`: a layout would
    // set `l.width` from this width and this width from `l.width`, which is the
    // binding loop this file is one wrong line away from at all times.
    min-width: l.width + 33px; max-width: l.width + 33px;
    border-radius: Surface.rr(11px, self.width, self.height);
    property <color> hue: root.up ? FinTheme.bad : FinTheme.good;
    background: root.hue.with-alpha(0.16);
    AppIcon {
        source: root.up ? Icons.trending-up : Icons.trending-down;
        tint: root.hue; width: 13px; height: 13px;
        x: 8px; y: (parent.height - self.height) / 2;
    }
    l := Text {
        x: 25px; y: (parent.height - self.height) / 2;
        text: root.label; color: root.hue;
        font-size: 11.5px; font-weight: 700;
    }
}

// A row of headline figures. One component rather than one per tab: Overview, Bills
// and Dues all show four numbers above their content, and four copies of this drift.
//
// A card whose tone is not flat is outlined in its tone as well as coloured — the
// mockup's red-bordered Overdue card. Colour alone carries it for most people and
// an outline carries it for the rest.
component StatStrip inherits Rectangle {
    in property <[FinStat]> stats;
    // Fired by a card that carries an action. Nothing happens for the rest.
    callback picked(string);
    property <length> gap: 12px;
    property <int> n: Math.max(1, root.stats.length);
    // Hand-placed rather than laid out. A HorizontalLayout hands out only the
    // *leftover* width, so a card whose text happens to be longer starts wider
    // and stays wider, and equalising the bases only ever got them close. Divided
    // from the strip's own width, every card is exactly the same and the row is
    // exactly filled. Nothing inside is allowed to influence the strip's width,
    // which is what keeps this out of the binding loop the layout version hit.
    property <length> cell: (root.width - root.gap * (root.n - 1)) / root.n;
    // Absolute children give a Rectangle no height of its own.
    height: 96px;
    for s[i] in root.stats: sc := Card {
        x: i * (root.cell + root.gap);
        y: 0;
        width: root.cell;
        height: parent.height;
        property <color> tone-hue: s.tone == "bad"  ? FinTheme.bad
                                : s.tone == "warn" ? FinTheme.warn
                                : s.tone == "ok"   ? FinTheme.good : FinTheme.ink;
        border-color: s.action != "" && scta.has-hover
                        ? sc.tone-hue.with-alpha(0.75)
                        : s.tone == "flat" ? FinTheme.hairline
                                           : sc.tone-hue.with-alpha(0.4);
        animate border-color { duration: 120ms; easing: ease-out; }
        // Declared before the content so nothing inside loses its own clicks.
        // A card with no action still gets the area; it just has nothing to fire.
        scta := TouchArea {
            mouse-cursor: s.action == "" ? MouseCursor.default : MouseCursor.pointer;
            clicked => { if (s.action != "") { root.picked(s.action); } }
        }
        VerticalLayout {
            padding: 14px; spacing: 4px; alignment: center;
            Text {
                text: s.label;
                color: s.tone == "flat" ? FinTheme.ink-dim : sc.tone-hue;
                font-size: 11px; font-weight: 700;
                overflow: elide;
            }
            Text {
                text: s.value; color: sc.tone-hue;
                font-size: 22px; font-weight: 800; overflow: elide;
            }
            if s.delta == "": Text {
                text: s.sub; color: FinTheme.ink-dim; font-size: 11px; overflow: elide;
            }
            if s.delta != "": HorizontalLayout {
                alignment: start;
                Delta { label: s.delta; up: s.delta-up; }
            }
        }
    }
}

// One of the four cards Planning opens with.
//
// The same `FinStat` the strips elsewhere carry, drawn larger and with an icon
// on a wash of its own colour. Those four are the first thing on the page and
// the design gives them a colour each; every strip below them stays uncoloured,
// which is what keeps these four reading as the headline rather than as the
// first of nine equal rows.
//
// The tone still wins over the hue for the figure itself: a "Month status" card
// that is red because the month is at risk must not be lime because Planning is.
component PlanCard inherits Card {
    in property <FinStat> stat;
    in property <image> icon;
    in property <color> hue: FinTheme.accent;
    property <color> tone: root.stat.tone == "bad"  ? FinTheme.bad
                         : root.stat.tone == "warn" ? FinTheme.warn
                         : root.stat.tone == "ok"   ? FinTheme.good
                         : FinTheme.ink;
    min-height: 104px; max-height: 104px;
    background: root.hue.with-alpha(FinTheme.light ? 0.07 : 0.11);
    border-color: root.hue.with-alpha(0.28);
    HorizontalLayout {
        padding: 16px; spacing: 10px;
        VerticalLayout {
            spacing: 3px; horizontal-stretch: 1; alignment: center;
            Text {
                text: root.stat.label; color: FinTheme.ink-dim;
                font-size: 10.5px; font-weight: 700; overflow: elide;
            }
            Text {
                text: root.stat.value; color: root.tone;
                font-size: 21px; font-weight: 800; overflow: elide;
            }
            Text {
                text: root.stat.sub; color: FinTheme.ink-dim;
                font-size: 11px; wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: start; horizontal-stretch: 0;
            Rectangle {
                width: 34px; height: 34px;
                border-radius: Surface.rr(11px, self.width, self.height);
                background: root.hue.with-alpha(0.18);
                AppIcon {
                    source: root.icon; tint: root.hue;
                    width: 17px; height: 17px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}

// A fixed-width table cell.
//
// `min-width == max-width` on purpose: nested layouts distribute only leftover
// width, so a stretch factor does not size a column — it just makes every table
// in this file drift out of alignment with its own header.
component Cell inherits Rectangle {
    in property <string> text;
    in property <length> w: 120px;
    in property <bool> dim: false;
    in property <bool> strong: false;
    in property <bool> right: false;
    in property <bool> centre: false;
    in property <color> ink: FinTheme.ink;
    in property <bool> flex: false;
    horizontal-stretch: root.flex ? 1 : 0;
    min-width: root.flex ? 80px : root.w;
    max-width: root.flex ? 100000px : root.w;
    // The cell's own text is positioned by hand, so it contributes nothing to
    // the layout's height. Every table that wraps its rows in a fixed-height
    // Rectangle got away with that; the one that did not stacked all ten of its
    // rows on top of each other at y=0.
    min-height: 28px;
    background: transparent;
    Text {
        x: root.right ? parent.width - self.width : 0px;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        text: root.text;
        color: root.dim ? FinTheme.ink-dim : root.ink;
        font-size: 12.5px;
        font-weight: root.strong ? 700 : 500;
        horizontal-alignment: root.right ? TextHorizontalAlignment.right
            : root.centre ? TextHorizontalAlignment.center
                          : TextHorizontalAlignment.left;
        overflow: elide;
    }
}

// A sortable column header.
component HeadCell inherits Rectangle {
    in property <string> label;
    in property <length> w: 120px;
    in property <bool> right: false;
    in property <bool> centre: false;
    in property <bool> flex: false;
    in property <bool> sorted: false;
    in property <bool> desc: false;
    in property <bool> sortable: true;
    callback clicked();
    horizontal-stretch: root.flex ? 1 : 0;
    min-width: root.flex ? 80px : root.w;
    max-width: root.flex ? 100000px : root.w;
    background: transparent;
    ta := TouchArea {
        mouse-cursor: root.sortable ? pointer : default;
        clicked => { if (root.sortable) { root.clicked(); } }
    }
    HorizontalLayout {
        alignment: root.right ? end : root.centre ? center : start;
        spacing: 4px;
        Text {
            text: root.label;
            color: root.sorted ? FinTheme.accent : (ta.has-hover ? FinTheme.ink : FinTheme.ink-dim);
            font-size: 11px; font-weight: 700; vertical-alignment: center;
        }
        if root.sorted: VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon {
                source: root.desc ? Icons.trending-down : Icons.trending-up;
                tint: FinTheme.accent; width: 12px; height: 12px;
            }
        }
    }
}

// ── the spend breakdown ─────────────────────────────────────────────────────
// A donut with a legend. Slint has no arc primitive, so each segment is a `Path`
// whose SVG commands are computed in Rust (`view::arc_path`) — one stroked arc
// per category, with the stroke width making the ring. A filled wedge would need
// an inner arc, two radial lines and a fill rule for the same picture.
//
// Ring on the left at three tenths of the width, legend beside it in the other
// seven: the card also carries the twelve-month picker now, and stacking the
// legend under the ring made it tall enough to push the bars off the card.
//
// `avail` is passed in rather than read off `root.width`. Reading it back is a
// binding loop — the card sits in a ScrollView whose viewport width is computed
// *from* the minimum width of its contents, so a ring sized from the width it
// helps determine never resolves. Only the ring square is sized from it; the
// legend takes the remainder by stretch, so an `avail` a few pixels out cannot
// overflow the card.
component SpendBreakdown inherits VerticalLayout {
    in property <[FinCatSlice]> slices;
    in property <string> total;
    // What the ring is a total *of*. The bars below select a month, so "this
    // month" is only true for one of the twelve and cannot be hardcoded.
    in property <string> caption: "spent";
    // Which month has nothing in it, for the empty case. Empty string suppresses.
    in property <string> empty-label: "";
    // The width the card has for its contents, handed down from the page.
    in property <length> avail;
    // Four tenths for the ring, six for the legend. The ring fills its column
    // rather than sitting in the middle of it — capped only so a maximised window
    // does not turn it into a dinner plate, floored so a narrow one keeps a ring
    // rather than a dot.
    property <length> ring-col: root.avail * 0.4;
    // Never floored, only capped. A floor larger than the column it sits in is a
    // ring that overflows into the legend on a narrow window, which is worse than
    // a small ring.
    property <length> ring-size: Math.min(root.ring-col, 340px);
    // A little air at each edge of the legend column — not enough to pull the names
    // and the figures apart again, which is what the wider gutter was doing.
    property <length> legend-pad: root.avail * 0.02;
    // Which point of the circle the pointer is over, 0–99 clockwise from twelve
    // o'clock, or -1 when it is not over the ring's band at all.
    property <int> hover-pct: ring-ta.over ? ring-ta.pct : -1;
    // The other direction: which legend row the pointer is on, as an index, or -1.
    // Index rather than the slice's `start`, because two categories that both
    // round to 0% share a start and would light each other up.
    property <int> legend-hover: -1;
    // Whether a given slice is the one under the pointer, from either end. Written
    // as a question each slice asks rather than an index the ring resolves,
    // because finding the index would need a loop and Slint expressions have none.
    pure function lit(i: int, start: int, pct: int) -> bool {
        return root.legend-hover == i
            || (root.hover-pct >= start && root.hover-pct < start + pct);
    }
    // Which slice the hole in the ring is currently reporting, or -1 for the whole
    // month. Written to by the legend rows rather than derived here: the ring's own
    // hover is an angle, and turning an angle back into an index needs the loop
    // Slint expressions do not have. Each row already answers `lit`, so each row
    // says so when its answer changes.
    property <int> shown: -1;
    // What the hole says. The two are bound together so the figure and the label
    // can never end up describing different things.
    property <string> hole-value: root.shown >= 0 ? root.slices[root.shown].amount : root.total;
    property <string> hole-label: root.shown >= 0 ? root.slices[root.shown].name : root.caption;
    property <color> hole-hue: root.shown >= 0 ? root.slices[root.shown].hue : FinTheme.accent;
    spacing: 12px;

    // The total used to be printed again on a row of its own above the ring. It
    // is in the middle of the ring, which is where a ring puts its total.

    // No spacing: the two columns are 40 and 60 of the whole, and the legend's
    // own left padding is the gap between them.
    HorizontalLayout {
        spacing: 0px;

        // Centred in its column both ways. The inner HorizontalLayout is what does
        // the horizontal half: a VerticalLayout puts a child narrower than itself
        // against its left edge.
        VerticalLayout {
            width: root.ring-col;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: root.ring-size; height: root.ring-size;
                    // The track, so a part-categorised month reads as a ring with a gap
                    // rather than as several disconnected arcs.
                    Path {
                        width: 100%; height: 100%;
                        viewbox-width: 100; viewbox-height: 100;
                        commands: "M 50 10 A 40 40 0 0 1 50 90 A 40 40 0 0 1 50 10";
                        stroke: FinTheme.pill-bg; stroke-width: 16px;
                    }
                    for s[si] in root.slices: Path {
                        width: 100%; height: 100%;
                        viewbox-width: 100; viewbox-height: 100;
                        commands: s.path;
                        stroke: s.hue;
                        // The hovered segment thickens outward rather than changing
                        // colour: the colour is the only thing tying it to its legend
                        // row, so it is the one property that must not move.
                        stroke-width: root.lit(si, s.start, s.pct) ? 20px : 16px;
                        opacity: (root.hover-pct < 0 && root.legend-hover < 0)
                            || root.lit(si, s.start, s.pct) ? 1.0 : 0.45;
                        animate stroke-width, opacity { duration: 110ms; easing: ease-out; }
                    }
                    // A Path cannot be hit-tested, so the whole ring square takes the
                    // pointer and works out which segment it is over from the angle.
                    ring-ta := TouchArea {
                        width: 100%; height: 100%;
                        // Pointer relative to the centre, in units of the radius, with
                        // y flipped so that up is positive.
                        property <float> nx: (self.mouse-x - self.width / 2) / (self.width / 2);
                        property <float> ny: (self.height / 2 - self.mouse-y) / (self.height / 2);
                        property <float> rad: Math.sqrt(self.nx * self.nx + self.ny * self.ny);
                        // Clockwise from twelve o'clock. atan2 is measured from its
                        // second argument towards its first, so passing (east, north)
                        // gives exactly that, in -180°..180°.
                        property <angle> theta: Math.atan2(self.nx, self.ny);
                        property <float> deg: (self.theta / 1deg) + (self.theta < 0deg ? 360 : 0);
                        property <int> pct: Math.floor(self.deg / 3.6);
                        // Only the band the stroke actually covers counts. The hole in
                        // the middle holds the total, and lighting a slice up from over
                        // that text would point at nothing.
                        property <bool> over: self.has-hover && self.rad > 0.6 && self.rad < 1.02;
                    }
                    // The hole in the ring, on a ground of its own. Sized to its own
                    // text rather than to a share of the ring: a fixed box would
                    // either clip a large total or hold open a gap around a small
                    // one, and the hole it sits in is round either way.
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: hole.preferred-width;
                        height: hole.preferred-height;
                        border-radius: Surface.rr(12px, self.width, self.height);
                        background: root.hole-hue.with-alpha(FinTheme.light ? 0.15 : 0.16);
                        border-width: 1px;
                        border-color: root.hole-hue.with-alpha(0.26);
                        animate background, border-color { duration: 110ms; }
                        hole := VerticalLayout {
                            padding-left: 12px; padding-right: 12px;
                            padding-top: 7px; padding-bottom: 7px;
                            spacing: 1px;
                            Text {
                                text: root.hole-value; color: FinTheme.ink;
                                font-size: 16px; font-weight: 800;
                                horizontal-alignment: center;
                            }
                            // Capped and elided rather than wrapped: the box hugs its
                            // own text, and a long category name would otherwise widen
                            // the pill straight out through the ring it sits inside.
                            Text {
                                text: root.hole-label;
                                color: FinTheme.light ? root.hole-hue.darker(0.35) : root.hole-hue;
                                font-size: 10px; font-weight: 600;
                                horizontal-alignment: center;
                                max-width: root.ring-size * 0.44; overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            width: root.avail * 0.6;
            padding-left: root.legend-pad; padding-right: root.legend-pad;
            // The gap between the legend and the year below it, and the only slack
            // in this column that is fixed. All the rest of it goes inside the group
            // below, which is what centres the entries in whatever is left over.
            spacing: 10px;
            VerticalLayout {
                vertical-stretch: 1;
                alignment: center; spacing: 2px;
                if root.slices.length == 0 && root.empty-label != "": Text {
                    text: "Nothing spent in " + root.empty-label + ".";
                    color: FinTheme.ink-dim; font-size: 12.5px;
                }
                for s[si] in root.slices: Rectangle {
                    height: 26px;
                    // Each row reports its own state up, which is what gives the hole
                    // in the ring an index to read whichever end the pointer came from.
                    // The leave is guarded the same way the hover below is, and for the
                    // same reason: the next row lights before this one goes out.
                    property <bool> is-lit: root.lit(si, s.start, s.pct);
                    changed is-lit => {
                        if (self.is-lit) { root.shown = si; }
                        else if (root.shown == si) { root.shown = -1; }
                    }
                    // The highlight is the full width of the legend column, so that
                    // hovering a thin slice still lands on something the eye catches.
                    border-radius: Surface.rr(7px, self.width, self.height);
                    background: root.lit(si, s.start, s.pct) ? FinTheme.pill-bg : transparent;
                    animate background { duration: 110ms; }
                    // Lights the arc from this end. The leave is guarded against
                    // arriving after the next row's enter, which is the order the two
                    // fire in when the pointer slides straight from one row to the
                    // next — without the guard that stale leave clears the new row.
                    TouchArea {
                        changed has-hover => {
                            if (self.has-hover) { root.legend-hover = si; }
                            else if (root.legend-hover == si) { root.legend-hover = -1; }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 6px; spacing: 8px;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Rectangle { width: 10px; height: 10px; border-radius: Surface.rr(3px, self.width, self.height); background: s.hue; }
                        }
                        Text {
                            text: s.name; color: FinTheme.ink; font-size: 12.5px;
                            font-weight: root.lit(si, s.start, s.pct) ? 700 : 400;
                            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                        }
                        // Sized to their own text rather than to a fixed column. The
                        // figures still line up on their right edge, but the name is no
                        // longer holding open a gap the width of the widest amount that
                        // could ever appear here.
                        Text {
                            text: s.amount; color: FinTheme.ink; font-size: 12.5px; font-weight: 700;
                            vertical-alignment: center; horizontal-stretch: 0;
                            horizontal-alignment: right;
                        }
                        Text {
                            text: "\{s.pct}%"; color: FinTheme.ink-dim; font-size: 11.5px;
                            vertical-alignment: center; horizontal-stretch: 0; min-width: 32px;
                            horizontal-alignment: right;
                        }
                    }
            }
            }
            @children
        }
    }
}

// ── twelve months of spending, and the picker for the ring above ────────────
//
// Spending only. The income bar was dropped when these bars became the month
// picker: a column that means "click me to see where this month went" cannot
// also be half made of a bar that has no breakdown behind it, and a legend
// explaining two colours is noise once there is only one.
component MonthBars inherits VerticalLayout {
    in property <[FinMonthBar]> months;
    // Index into `months`. The caller resolves "latest" before it gets here.
    in property <int> selected: -1;
    callback picked(int);

    // Drives the selected bar's inner outline. A ping-ponged bool rather than a
    // looping animation because Slint has no repeat count: the timer flips it and
    // the `animate` below eases between the two states forever.
    property <bool> pulse: false;
    Timer {
        interval: 1100ms;
        running: root.selected >= 0;
        triggered => { root.pulse = !root.pulse; }
    }

    spacing: 0px;
    // Shorter than it was, because it moved out of the full width of the card and
    // into the legend's column: the whole year has to fit under six categories now,
    // not beside them. The bars still fill their columns — the row is narrower, so
    // thinning them as well left twelve slivers in a lot of empty space.
    Rectangle {
        min-height: 92px; max-height: 92px;
        background: transparent;
        HorizontalLayout {
            spacing: 4px;
            for m[i] in root.months: Rectangle {
                horizontal-stretch: 1;
                background: transparent;
                ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(i); }
                }
                // The plot area is a plain Rectangle, not a layout: the bars
                // size themselves from it, and a layout's own size depends on
                // its children, so doing this inside one would not resolve.
                plot := Rectangle {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height - 16px;
                    background: transparent;
                    bar := Rectangle {
                        width: parent.width;
                        // A month with nothing spent still gets a stub, so the
                        // year reads as twelve months and every column stays a
                        // target.
                        height: Math.max(6px, parent.height * Math.max(1, m.expense-pct) / 100);
                        y: parent.height - self.height;
                        border-radius: Surface.rr(5px, self.width, self.height);
                        // Every month carries the section's ramp, the unpicked
                        // ones softened. They used to be `pill-bg`, which on the
                        // light theme is a hairline tint of the card — eleven
                        // invisible bars beside one lime one.
                        background: i == root.selected
                            ? FinTheme.accent-grad
                            : @linear-gradient(135deg,
                                FinTheme.accent.with-alpha(ta.has-hover ? 0.72 : 0.5),
                                FinTheme.accent-2.with-alpha(ta.has-hover ? 0.72 : 0.5));

                        // The picked month is marked by a double rule drawn
                        // inside it, breathing, rather than by being the only
                        // coloured bar. Skipped on a bar too short to hold two
                        // insets, where it would just be a smudge.
                        if i == root.selected && bar.height > 22px: Rectangle {
                            x: 3px; y: 3px;
                            width: parent.width - 6px; height: parent.height - 6px;
                            border-radius: Surface.rr(4px, self.width, self.height);
                            border-width: 1px;
                            border-color: FinTheme.on-accent.with-alpha(0.55);
                        }
                        if i == root.selected && bar.height > 22px: Rectangle {
                            x: 6px; y: 6px;
                            width: parent.width - 12px; height: parent.height - 12px;
                            border-radius: Surface.rr(3px, self.width, self.height);
                            border-width: 1px;
                            border-color: FinTheme.on-accent;
                            opacity: root.pulse ? 0.9 : 0.15;
                            animate opacity { duration: 1050ms; easing: ease-in-out; }
                        }
                    }
                }
                Text {
                    text: m.label;
                    color: i == root.selected ? FinTheme.ink : FinTheme.ink-dim;
                    font-size: 10px;
                    font-weight: i == root.selected ? 700 : 400;
                    width: parent.width;
                    horizontal-alignment: center;
                    y: parent.height - self.height;
                }
            }
        }
    }
}

// ── one row of the "needs you" list ─────────────────────────────────────────
component NeedsRow inherits Skin {
    in property <FinObligationRow> item;
    callback pay(int);
    callback skip(int);
    callback opened();
    min-height: 56px; max-height: 56px;
    horizontal-stretch: 1;
    border-radius: Surface.rr(12px, self.width, self.height);
    background: ta.has-hover ? FinTheme.card-2 : transparent;
    // The row opens the same thing its button does. The button stays because it
    // is one click instead of two for the common case; the row is the target for
    // anyone who wants to look before agreeing to it.
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.opened(); }
    }
    // The pill and the due line carry the urgency. The tile carries *what kind of
    // thing* this is, in its own colour, so a list of eight is scannable by shape
    // rather than being eight tiles of the same amber.
    //
    // These are not the section's lime ramp: they are filled behind a white glyph,
    // and white on lime is unreadable.
    property <color> hue:
        root.item.kind == "subscription" ? #7c3aed :
        root.item.kind == "bill"         ? #2563eb : #0d9488;
    // Overdue still overrides. A red tile is the one thing in this row that must
    // win over the taxonomy.
    property <color> tile-hue:
        root.item.status == "overdue" ? #dc2626 : root.hue;
    property <color> pill-hue:
        root.item.status == "overdue" ? FinTheme.bad :
        root.item.days <= 0          ? FinTheme.warn : FinTheme.ink-dim;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 12px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Tile {
                solid: true;
                hue: root.tile-hue;
                icon: root.item.kind == "subscription" ? Icons.repeat
                    : root.item.kind == "bill" ? Icons.receipt : Icons.calendar-clock;
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 1; spacing: 2px;
            Text {
                text: root.item.name; color: FinTheme.ink; font-size: 13px; font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.status == "overdue"
                        ? "was due \{root.item.due} · unpaid"
                        : (root.item.days == 0 ? "\{root.item.due} · due today"
                        : (root.item.days == 1 ? "\{root.item.due} · due tomorrow"
                        : "\{root.item.due} · mark paid"));
                color: FinTheme.ink-dim; font-size: 11px;
            }
        }
        // The three columns after the name are fixed width rather than sized to
        // their own contents. This is a table: a row whose amount column is as wide
        // as its amount puts every figure at a different place down the list, and
        // the column you scan is the one that has to hold still.
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            min-width: 100px; max-width: 100px;
            Text {
                text: root.item.estimate;
                color: FinTheme.ink; font-size: 13.5px; font-weight: 700;
                horizontal-alignment: right;
                overflow: elide;
                // Italic marks the figure as a guess as well as the tilde does,
                // for anyone who reads shape before punctuation.
                font-italic: root.item.is-estimate;
            }
        }
        // How long there is, as a pill rather than prose — the whole point of the
        // list is scanning down this column. The pill sizes to its own label, so it
        // is centred inside a fixed cell rather than being a cell itself.
        Rectangle {
            horizontal-stretch: 0;
            min-width: 76px; max-width: 76px;
            background: transparent;
            Pill {
                w: 70px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                hue: root.pill-hue;
                label: root.item.status == "overdue" ? "\{-root.item.days}d late"
                     : (root.item.days == 0 ? "today" : "\{root.item.days}d");
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            min-width: 136px; max-width: 136px;
            HorizontalLayout {
                spacing: 6px; alignment: end;
                Btn { label: "Mark paid"; h: 30px; clicked => { root.pay(root.item.id); } }
                IconBtn { icon: Icons.x; hue: FinTheme.ink-dim;
                    clicked => { root.skip(root.item.id); } }
            }
        }
    }
}

// ── form field ──────────────────────────────────────────────────────────────
component FinFieldRow inherits VerticalLayout {
    in property <FinField> field;
    callback set(string, string);
    // Enter inside a field. A LineEdit consumes the key itself, so it never
    // reaches the panel's key handler and has to be forwarded from here.
    callback confirm();
    spacing: 6px;
    if root.field.kind != "note": Text {
        text: root.field.label + (root.field.required ? "  *" : "");
        color: FinTheme.ink; font-size: 12.5px; font-weight: 600;
    }
    if root.field.kind == "text": LineEdit {
        text: root.field.value; placeholder-text: root.field.hint;
        edited(t) => { root.set(root.field.key, t); }
        accepted(t) => { root.set(root.field.key, t); root.confirm(); }
    }
    // Money and number both take a number; they are separate kinds so the hint
    // can say which unit is expected without the caller composing labels.
    if root.field.kind == "number" || root.field.kind == "money": LineEdit {
        text: root.field.value;
        placeholder-text: root.field.hint;
        edited(t) => { root.set(root.field.key, t); }
        accepted(t) => { root.set(root.field.key, t); root.confirm(); }
    }
    if root.field.kind == "date": LineEdit {
        text: root.field.value;
        placeholder-text: root.field.hint == "" ? "YYYY-MM-DD" : root.field.hint;
        edited(t) => { root.set(root.field.key, t); }
        accepted(t) => { root.set(root.field.key, t); root.confirm(); }
    }
    if root.field.kind == "dropdown": ComboBox {
        model: root.field.options; current-value: root.field.value;
        selected(v) => { root.set(root.field.key, v); }
    }
    if root.field.kind == "toggle": HorizontalLayout {
        alignment: start;
        Switch {
            checked: root.field.value == "true"; text: root.field.hint;
            toggled => { root.set(root.field.key, self.checked ? "true" : "false"); }
        }
    }
    if root.field.kind == "static": Text {
        text: root.field.value; color: FinTheme.ink; font-size: 13px; font-weight: 700;
    }
    if root.field.kind == "note": Text {
        text: root.field.value; color: FinTheme.ink-dim; font-size: 11.5px; wrap: word-wrap;
    }
    if root.field.hint != "" && root.field.kind != "toggle" && root.field.kind != "note"
        && root.field.kind != "text" && root.field.kind != "number"
        && root.field.kind != "money" && root.field.kind != "date": Text {
        text: root.field.hint; color: FinTheme.ink-dim; font-size: 11px;
    }
}

// ── the month grid ──────────────────────────────────────────────────────────
// Seven columns, and as many rows as the month actually occupies — five for most
// of them, six for a long month that starts near the weekend. Rendering six
// always left an empty row on screen two months in three; rendering five always
// would drop the last days of the months that need the sixth.
//
// Every cell is the same size, padding days included, so the block reads as one
// table rather than as a ragged run of tiles. Rows share whatever height the
// block has, which is how the grid ends flush above the legend.
//
// A component rather than markup, because the year view sits beside it under the
// same selector and both are reached from the same drill-down. `selected` is 0
// when no day has been picked, and nothing is highlighted then.
component CalGrid inherits VerticalLayout {
    in property <[FinCalDay]> days;
    in property <int> selected: 0;
    // The floor a row will not go below. A caller that lays the grid out at its
    // own preferred height gets this; one that gives it a fixed block to fill
    // divides that between the rows instead.
    in property <length> row-min: 62px;
    callback picked(FinCalDay);
    // Days are contiguous, so the sixth row is in use exactly when its first cell
    // is — no need to look at the other six.
    property <int> rows: root.days.length > 35 && root.days[35].in-month ? 6 : 5;
    spacing: 6px;

    HorizontalLayout {
        spacing: 6px; vertical-stretch: 0;
        for wd in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: Text {
            text: wd; color: FinTheme.ink-dim; font-size: 10.5px;
            font-weight: 700; horizontal-stretch: 1;
            horizontal-alignment: center;
        }
    }

    for row in root.rows: HorizontalLayout {
        spacing: 6px; vertical-stretch: 1;
        for col in 7: cell := Rectangle {
            property <int> idx: row * 7 + col;
            // Named `cell`, not reached via `self`: inside the Text elements
            // below `self` is that Text.
            property <FinCalDay> d:
                root.days.length > cell.idx
                ? root.days[cell.idx]
                : { day: 0, in-month: false, today: false,
                    count: 0, amount: "", income: "",
                    money-out: false, overdue: false,
                    pip-count: 0 };
            property <bool> on:
                root.selected > 0 && cell.d.in-month && cell.d.day == root.selected;
            horizontal-stretch: 1;
            min-height: root.row-min;
            border-radius: Surface.rr(10px, self.width, self.height);
            // A padding day is dimmer than a real one but still drawn: an
            // invisible cell leaves a hole in the table where the eye expects a
            // square, and the row above it stops reading as a week.
            background: cell.on
                ? FinTheme.accent.with-alpha(0.22)
                : (cell.d.today
                   ? FinTheme.accent.with-alpha(0.16)
                   : (cell.d.in-month
                      ? (cta.has-hover ? FinTheme.card-2.darker(0.12) : FinTheme.card-2)
                      : FinTheme.card-2.with-alpha(0.35)));
            border-width: cell.on || cell.d.today ? 1.5px : 1px;
            border-color: cell.on
                ? FinTheme.accent
                : (cell.d.today
                   ? FinTheme.accent.with-alpha(0.6)
                   : (cell.d.in-month ? FinTheme.hairline
                                      : FinTheme.hairline.with-alpha(0.45)));
            animate background, border-color { duration: 110ms; easing: ease-out; }
            // Declared before the content so nothing inside steals its clicks.
            // Dead on the padding days, and on the tab that has no agenda beside
            // it: a day that lights up under the pointer and does nothing when
            // clicked is a broken button.
            cta := TouchArea {
                enabled: cell.d.in-month && root.selected > 0;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.picked(cell.d); }
            }
            VerticalLayout {
                padding: 6px; spacing: 2px;
                Text {
                    text: cell.d.day == 0 ? "" : "\{cell.d.day}";
                    color: cell.d.in-month ? FinTheme.ink : FinTheme.ink-dim;
                    font-size: 11.5px;
                    font-weight: cell.d.today || cell.on ? 800 : 600;
                }
                // A dot per thing due, coloured by its category. Reads as "a loan
                // and two bills" before any figure is looked at, which is what a
                // grid is for and what a list of amounts cannot do.
                if cell.d.pip-count > 0: HorizontalLayout {
                    spacing: 3px; alignment: start;
                    Rectangle {
                        width: 6px; height: 6px;
                        border-radius: 3px; background: cell.d.pip1;
                    }
                    if cell.d.pip-count > 1: Rectangle {
                        width: 6px; height: 6px;
                        border-radius: 3px; background: cell.d.pip2;
                    }
                    if cell.d.pip-count > 2: Rectangle {
                        width: 6px; height: 6px;
                        border-radius: 3px; background: cell.d.pip3;
                    }
                    if cell.d.pip-count > 3: Rectangle {
                        width: 6px; height: 6px;
                        border-radius: 3px; background: cell.d.pip4;
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                if cell.d.amount != "": Text {
                    text: cell.d.amount;
                    color: cell.d.overdue ? FinTheme.bad : FinTheme.ink;
                    font-size: 10.5px; font-weight: 700;
                    overflow: elide;
                }
                // Income on its own line, in the good hue. A day with money in and
                // money out shows both figures: netting them would call a payday
                // with rent due on it a quiet day.
                if cell.d.income != "": Text {
                    text: "+" + cell.d.income;
                    color: FinTheme.good;
                    font-size: 10.5px; font-weight: 700;
                    overflow: elide;
                }
                if cell.d.count > 1: Text {
                    text: "\{cell.d.count} items";
                    color: FinTheme.ink-dim; font-size: 9.5px;
                }
            }
        }
    }

    // What the dots mean, in the order they appear.
    HorizontalLayout {
        spacing: 14px; alignment: start; vertical-stretch: 0;
        for l in [
            { t: "Income",        c: FinTheme.good },
            { t: "Loans & EMI",   c: #f472b6 },
            { t: "Bills",         c: #facc15 },
            { t: "Subscriptions", c: #fb923c },
        ]: HorizontalLayout {
            spacing: 6px; horizontal-stretch: 0;
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    width: 6px; height: 6px;
                    border-radius: 3px; background: l.c;
                }
            }
            Text { text: l.t; color: FinTheme.ink-dim;
                font-size: 10.5px; vertical-alignment: center; }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
    }
}

// Twelve bars instead of a grid. The question changes with the zoom: a month
// asks "can I cover the 5th", a year asks "which months are the heavy ones".
component CalYear inherits VerticalLayout {
    in property <[FinCalMonth]> months;
    spacing: 8px;
    for m in root.months: VerticalLayout {
        spacing: 3px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: m.label; color: FinTheme.ink;
                font-size: 12px;
                font-weight: m.current ? 800 : 500;
                vertical-alignment: center;
                horizontal-stretch: 1; }
            if m.income != "": Text {
                text: "+" + m.income; color: FinTheme.good;
                font-size: 11.5px; vertical-alignment: center; }
            Text {
                text: m.out == "" ? "—" : m.out;
                color: FinTheme.ink; font-size: 12px;
                font-weight: 700; vertical-alignment: center;
                min-width: 110px; horizontal-alignment: right;
            }
        }
        Bar {
            pct: m.pct; thickness: 8px; toned: false;
            hue: m.current ? FinTheme.accent : FinTheme.accent.with-alpha(0.45);
        }
    }
    if root.months.length == 0: Text {
        text: "Nothing dated in this year.";
        color: FinTheme.ink-dim; font-size: 12.5px;
    }
}

// ── the page ────────────────────────────────────────────────────────────────
export component FinancesPage inherits Rectangle {
    // Which of the seven sections is showing.
    in-out property <string> tab: "overview";

    // Half-window guard: below this the tabs collapse to icon-only and expand on
    // hover. The row is 854px of chips since Plan went, and the guard has to sit
    // far enough above that for the header's own contents — the search box and
    // the Add button — to still have room beside it.
    property <bool> tabs-compact: root.width < 1024px;

    // Strip + charts
    in property <[FinStat]> stats;
    // The health score, and everything that was added up to reach it. The strip
    // carries the total; this is what the card opens.
    in property <[FinHealthPart]> health-parts;
    in property <string> health-score: "";
    in property <string> health-band: "";
    property <bool> health-open: false;
    in property <[FinCatSlice]> slices;
    in property <string> spent-total;
    in property <[FinMonthBar]> months;
    in property <[FinObligationRow]> needs-you;
    in property <string> month-label;
    // Which month the breakdown is showing, as an index into `months`. -1 is the
    // latest, which is what the section opens on; the section writes back the
    // real index when a bar is clicked so the two cannot drift apart.
    in property <int> month-pick: -1;
    callback pick-month(int);

    // Both cards on the Overview's top row are pinned to this. They used to size
    // themselves to their contents, so stepping to a month with fewer categories
    // shortened one card and moved everything below it up the page.
    //
    // Six rows of 56 with 6 between them, plus the heading, the pager and the
    // padding — the tallest the "Needs you" side can be. "Where it went" is pinned
    // to the same number so the two cards are one band across the page.
    property <length> overview-h: 478px;
    // What one of those two cards has for its contents: the page's own width less
    // the body padding, the scrollbar gutter, the gap between the cards and the
    // card's own padding. Computed downwards from the width the window hands this
    // page, never read back off the layout — see `SpendBreakdown.avail`.
    property <length> overview-card-w: Math.max(240px, (root.width - 56px) / 2 - 32px);

    // The one row under it — accounts, loans and the short ledger. Nothing is cut
    // to fit it: a card with more than the row is tall scrolls inside itself, so
    // the row keeps one height while every card still shows everything it has.
    property <length> row2-h: 336px;
    property <int> needs-per-page: 6;
    property <int> needs-page: 0;
    // Rounded up by adding one page less than a page, then flooring — which is
    // the right answer whether the division above truncates or not, and so does
    // not rest on which of those Slint does.
    property <int> needs-pages: Math.max(1, Math.floor(
        (root.needs-you.length + root.needs-per-page - 1) / root.needs-per-page));
    // Clamped rather than trusted: paying the last obligation on page three
    // leaves the page index pointing past a list that is now two pages long.
    property <int> needs-first:
        Math.min(root.needs-page, root.needs-pages - 1) * root.needs-per-page;
    property <int> needs-watch: root.needs-you.length;
    changed needs-watch => { root.needs-page = 0; }
    // The obligation the confirm modal is about. Held whole rather than by id, so
    // the modal reads from the row that was clicked instead of searching a model
    // that the act of paying is about to rebuild underneath it.
    property <bool> needs-open: false;
    property <FinObligationRow> needs-sel;
    // Skipping is not undoable from anywhere in this section, so it asks first.
    property <bool> needs-skip-open: false;
    // The Subscriptions table's ten columns. Service takes a quarter of the room
    // and the other nine share the rest equally, which is what makes it read as a
    // table rather than as nine columns each sized to whatever happened to be in
    // it. Computed from the page's own width, never read back off the layout — a
    // cell whose min-width came from the width it helps decide is the binding loop
    // this file has hit before.
    //
    // 28px of table padding and nine 10px gaps come off the top.
    property <length> subs-body: Math.max(760px, root.width - 42px) - 118px;
    // Floored so the actions column can always hold its three buttons.
    property <length> subs-col: Math.max(96px, root.subs-body * 0.75 / 9);
    // The row number is two or three digits, never a figure or a pill, so it gets
    // less than a third of a column. What it gives up goes to Service.
    property <length> subs-num: Math.max(30px, root.subs-col * 0.3);
    property <length> subs-name:
        Math.max(200px, root.subs-body - root.subs-num - root.subs-col * 8);
    // The row the remove confirmation is about, held whole rather than by id: the
    // act is about to rebuild the model the row came from.
    property <bool> subs-del-open: false;
    property <FinRecurRow> subs-del;
    // Whether the X on that row means "for good". Resolved once, because the modal
    // asks it five times and the two answers must not be able to differ.
    property <bool> subs-gone: root.subs-del.status == "removed";

    // The header's one button, and what it offers. Per tab, because "add" means a
    // different thing on each of them and a popup that offered all of everything
    // would be the four-button header again with an extra click in front of it.
    property <bool> actions-open: false;
    property <[FinAction]> acts-ledger: [
        { key: "txn", label: "Add", label-2: "Transaction", icon: Icons.plus,
          hue: FinTheme.accent, hue-2: FinTheme.accent-2, ink: FinTheme.on-accent },
        { key: "import", label: "Import Bank", label-2: "Statements", icon: Icons.upload,
          hue: FinTheme.accent-2, hue-2: FinTheme.accent, ink: #ffffff },
        // Not the receipt icon: that one is the Bills tab, and two different things
        // wearing one icon is worse than either wearing a slightly loose one.
        { key: "scan", label: "Scan", label-2: "Bill", icon: Icons.image,
          hue: FinTheme.good, hue-2: FinTheme.accent-2, ink: #ffffff },
        { key: "rates", label: "Exchange", label-2: "Rates", icon: Icons.settings,
          hue: FinTheme.warn, hue-2: FinTheme.bad, ink: FinTheme.on-accent },
    ];
    property <[FinAction]> acts-accounts: [
        { key: "account", label: "New", label-2: "Account", icon: Icons.credit-card,
          hue: FinTheme.accent, hue-2: FinTheme.accent-2, ink: FinTheme.on-accent },
        { key: "loan", label: "New", label-2: "Loan", icon: Icons.receipt,
          hue: FinTheme.bad, hue-2: FinTheme.warn, ink: #ffffff },
    ];
    property <[FinAction]> acts-bills: [
        { key: "bill", label: "New", label-2: "Bill", icon: Icons.receipt,
          hue: FinTheme.accent, hue-2: FinTheme.accent-2, ink: FinTheme.on-accent },
        { key: "one-off", label: "One-off", label-2: "Bill", icon: Icons.calendar-clock,
          hue: FinTheme.accent-2, hue-2: FinTheme.good, ink: #ffffff },
    ];
    // Planning is about the month ahead, so its four are the four things that
    // put something into one: an envelope, a bill, a one-off, a payment.
    property <[FinAction]> acts-plan: [
        { key: "budget", label: "Set an", label-2: "Envelope", icon: Icons.pie-chart,
          hue: FinTheme.accent, hue-2: FinTheme.accent-2, ink: FinTheme.on-accent },
        { key: "bill", label: "New", label-2: "Bill", icon: Icons.receipt,
          hue: FinTheme.accent-2, hue-2: FinTheme.good, ink: #ffffff },
        { key: "one-off", label: "One-off", label-2: "Bill", icon: Icons.calendar-clock,
          hue: FinTheme.good, hue-2: FinTheme.accent-2, ink: #ffffff },
        { key: "txn", label: "Add", label-2: "Transaction", icon: Icons.plus,
          hue: FinTheme.warn, hue-2: FinTheme.bad, ink: FinTheme.on-accent },
    ];
    property <[FinAction]> acts: root.tab == "accounts" ? root.acts-accounts
        : root.tab == "bills" ? root.acts-bills
        : root.tab == "planning" ? root.acts-plan
        : root.acts-ledger;
    // Two tabs have exactly one thing to add, and a popup offering one choice is a
    // dialog asking you to confirm that you meant the button you just pressed.
    property <string> acts-direct: root.tab == "subs" ? "sub"
        : root.tab == "dues" ? "due" : "";
    // Resolved once here rather than at each of the four sites that need it. The
    // length guard matters: `months` arrives empty on the first paint, and -1
    // stays out of range until it fills.
    property <int> picked: root.months.length == 0 ? -1
        : (root.month-pick < 0 || root.month-pick >= root.months.length
            ? root.months.length - 1 : root.month-pick);
    property <string> picked-label:
        root.picked >= 0 ? root.months[root.picked].long : root.month-label;
    property <string> picked-total:
        root.picked >= 0 ? root.months[root.picked].expense : root.spent-total;

    // Ledger
    in property <[FinTxnRow]> txns;
    // The overview's short ledger. A separate model from `txns`, which carries
    // the Transactions tab's filters and paging.
    in property <[FinTxnRow]> recent;
    in property <int> txn-page: 0;
    in property <int> txn-pages: 1;
    in property <int> txn-total: 0;
    in-out property <string> subs-sort: "name";
    in-out property <bool> subs-desc: false;
    in-out property <string> txn-sort: "date";
    in-out property <bool> txn-desc: true;
    in-out property <string> txn-search: "";
    in property <[string]> account-names;
    in-out property <string> txn-account: "All accounts";
    in property <[string]> category-names;
    in-out property <string> txn-category: "All categories";
    in-out property <string> txn-kind: "All";
    in property <bool> running-shown: false;
    in property <string> txn-spent: "";
    in property <string> txn-income: "";
    // Which month the ledger is showing, and where a row came from. Both are
    // filters the mockup puts on the table and both are answered in SQL, so
    // paging and the totals under the tabs stay true to what is on screen.
    in property <[string]> txn-periods;
    in-out property <string> txn-period: "Every month";
    in property <[string]> source-names;
    in-out property <string> txn-source: "Any source";

    // Recurrences
    in property <[FinObligationRow]> bills;
    // The four figures above the Bills table, and the counts on its filter chips.
    // Counts are of the whole month, not of the filtered list — a filter that hid
    // its own count would be unusable.
    in property <[FinStat]> bill-stats;
    in-out property <string> bills-filter: "all";
    in property <int> bills-all: 0;
    in property <int> bills-needs: 0;
    in property <int> bills-auto: 0;
    in property <int> bills-paid: 0;
    in property <int> bills-oneoff: 0;
    in property <[FinRecurRow]> subs;
    in property <[FinRecurRow]> bill-templates;
    in property <string> subs-yearly: "";
    in property <[FinStat]> sub-stats;
    in-out property <string> subs-filter: "all";
    in property <int> subs-all: 0;
    in property <int> subs-active: 0;
    in property <int> subs-paused: 0;
    in property <int> subs-cancelled: 0;
    in property <int> subs-removed: 0;
    in property <[string]> subs-categories;
    in-out property <string> subs-category: "Every category";
    in property <[string]> subs-currencies;
    in-out property <string> subs-currency: "Every currency";
    // Which page of the subscription table is on screen. Held here rather than in
    // Rust: the rows are already all in the model, so paging is a matter of which
    // of them are drawn, and a round trip to the database to draw fewer rows of
    // the same list would buy nothing.
    property <int> subs-page: 0;
    property <int> subs-per-page: 11;
    property <int> subs-pages: Math.max(1, Math.ceil(root.subs.length / root.subs-per-page));
    // Clamped rather than assigned, so a filter that shrinks the list under the
    // current page lands on the last one instead of on nothing at all.
    property <int> subs-pg: Math.min(root.subs-page, root.subs-pages - 1);
    property <int> subs-from: root.subs-pg * root.subs-per-page;
    // Which month the bills table is showing. The list is dated, so without this
    // it is whatever window the loader happened to ask for.
    in property <string> bills-period: "";

    // Dues, accounts, budgets, loans, calendar, insights
    in property <[FinDueRow]> dues;
    in property <[FinStat]> due-stats;
    in-out property <string> dues-filter: "all";
    // Which of the five cards over the Accounts grid is selected. "" is all of them.
    in-out property <string> account-filter: "";
    in property <int> dues-all: 0;
    in property <int> dues-to-me: 0;
    in property <int> dues-i-owe: 0;
    in property <int> dues-closed: 0;
    // Everything settled or written off in the last six months. Shown as its own
    // card rather than only behind the Closed filter: the useful question is
    // "does this get paid back", and that needs the history visible next to the
    // open rows, not one click away.
    in property <[FinDueRow]> dues-settled;
    in property <[FinAccountRow]> accounts;
    in property <string> liquid-total: "";
    in property <string> debt-total: "";
    // Loans only. `debt-total` is every negative balance including the credit
    // card, which is not a loan and must not head the Loans grid.
    in property <string> loans-total: "";
    // The five cards over the Accounts grid: liquid, cash, cards, loans, lending.
    // Never summed into a net worth — that would need the market value of things
    // the app can only ask you to guess at.
    in property <[FinStat]> account-stats;
    in property <[FinLoanRow]> loans;
    // The detail popup a card opens. Purely local: the row is already on the
    // page, so nothing has to be fetched to show it in full — the grid card is
    // a square with a fixed height and clips whatever does not fit, and this is
    // where the rest of it lives.
    property <bool> detail-open: false;
    property <bool> detail-loan-open: false;
    property <FinAccountRow> detail-account;
    property <FinLoanRow> detail-loan;
    in property <[FinBudgetRow]> budgets;
    in property <string> budget-period: "";
    in property <string> budget-income: "";
    in property <string> budget-allocated: "";
    in property <string> budget-unallocated: "";
    // Spending this month that no envelope is watching, and how much of it there is.
    in property <string> budget-unbudgeted: "";
    in property <string> budget-unbudgeted-sub: "";
    // Where the month's income is committed before any discretionary spending:
    // loans, rent, subscriptions, then what is left.
    in property <[FinCatSlice]> commitments;
    in property <int> budget-allocated-pct: 0;
    // What leaves every month whatever the user decides — EMIs, bills, subs —
    // itemised. Shown so the page adds up: you cannot overspend a bill, you can
    // only fail to pay it, and hiding it makes the envelopes look like the
    // whole month.
    in property <[FinKv]> fixed-items;
    in property <string> fixed-total: "";
    in property <string> fixed-share: "";
    in property <[FinDiscipline]> discipline;
    // The same six months, one row per envelope, which is where a habit shows.
    in property <[string]> discipline-months;
    in property <[FinEnvelopeHistory]> envelope-history;
    in property <[FinCalDay]> cal-days;
    in property <string> cal-label: "";
    // ── the month being planned ─────────────────────────────────────────────
    // Budgets and Calendar were the same month seen twice: one said what was
    // decided, the other when it lands. Planning is both, and owns nothing of
    // its own — every figure below already existed.
    //
    // The day the agenda opens on. Rust picks it, because "today, unless you have
    // stepped away from this month" is a claim about a date and not a layout.
    in property <FinCalDay> cal-focus;
    // The committed share of income, for the allocation bar. Envelopes are
    // `budget-allocated-pct`; whatever is left over is spoken for by nothing.
    in property <int> fixed-pct: 0;
    in property <string> envelopes-spent: "";
    // Which day the agenda is showing, and that day's own cell — the cell carries
    // the totals and the count, so selecting one is a single assignment and the
    // agenda header never has to re-derive what the grid already knew.
    property <int> plan-day: root.cal-focus.day;
    property <FinCalDay> plan-sel: root.cal-focus;
    // Zero when today is not in the month on screen, which is also when there is
    // no "in three days" to say.
    property <int> plan-today: root.cal-focus.today ? root.cal-focus.day : 0;
    property <int> plan-delta: root.plan-day - root.plan-today;
    function plan-reset() {
        root.plan-day = root.cal-focus.day;
        root.plan-sel = root.cal-focus;
    }
    // Two triggers, because neither is enough on its own: the label changes when
    // the month steps, and the focus arrives one refresh later than the first paint.
    changed cal-label => { root.plan-reset(); }
    changed cal-focus => { root.plan-reset(); }

    // ── Planning · the dashboard ────────────────────────────────────────────
    // The one view in this section that is not a table of what happened. Every
    // block below either decides something, predicts something or offers a
    // button — a statistic with none of the three belongs on Overview.
    in property <[FinStat]> plan-health;
    in property <[FinTimelineEvent]> timeline;
    in property <[FinFlag]> attention;
    in property <[FinFlag]> recos;
    in property <[FinPrediction]> predictions;
    in property <[FinHabit]> habits;
    in property <[FinStat]> review;
    in property <[FinTrendSeries]> trends;
    // Which of the four six-month metrics the chart is drawing. Local: all four
    // series are already here, so switching between them is a redraw and not a
    // reason to go back to the database.
    property <int> trend-metric: 0;
    // Which of Planning's five drill-downs is open, "" for none. The page holds
    // the answer to "what should I do next"; the tables the answer came out of
    // are one link away rather than one tab away, because a tab beside this one
    // is a tab that has to be read to be dismissed.
    // `in-out` rather than private: an insight opened from Overview routes here,
    // and the route is a modal now that nothing on this section links to a tab.
    in-out property <string> plan-modal: "";
    // The month statement: what came in, less what has a claim on it. Not the
    // bank walk in `cal-flow` — that one carries every month before this one.
    in property <[FinKv]> plan-statement;
    // Income less commitments less envelopes. The slice the bar draws, so the
    // number under it cannot be a different subtraction.
    in property <string> plan-free: "";
    // Which month the Trends drill-down is reading, one selector per chart
    // because the two series are built from different windows: the category
    // trend always has six months, the savings history only has the months that
    // had a transaction in them. −1 means "the latest", which is what a chart
    // shows before anyone has picked anything and what it falls back to when the
    // month that was picked is no longer in the series.
    property <int> trend-month: -1;
    property <int> sav-month: -1;
    property <int> trend-n: root.trend-pies.length;
    property <int> tm: root.trend-month < 0 || root.trend-month >= root.trend-n
        ? Math.max(0, root.trend-n - 1) : root.trend-month;
    property <int> sm: root.sav-month < 0 || root.sav-month >= root.savings.length
        ? Math.max(0, root.savings.length - 1) : root.sav-month;
    property <int> trend-count: root.trends.length;
    // A shorter list of metrics cannot leave the selector pointing past its end.
    changed trend-count => { root.trend-metric = 0; }
    callback plan-goto(int);
    // What no one has claimed. Floored at zero: a month whose commitments and
    // envelopes together come to more than its income has nothing free, and a
    // negative slice would be drawn as a bar running backwards.
    property <int> plan-free-pct:
        Math.max(0, 100 - root.fixed-pct - root.budget-allocated-pct);
    in property <[FinObligationRow]> cal-agenda;
    in property <string> cal-low-point: "";
    // Month grid or twelve-month summary.
    in-out property <string> cal-view: "month";
    in property <[FinCalMonth]> cal-months;
    // The cash-flow walk: what is in the bank, what leaves, where it bottoms
    // out, what lands, where it closes.
    in property <[FinKv]> cal-flow;
    // What actually falls on the heaviest day, not just its total.
    in property <[FinObligationRow]> cal-heaviest-items;
    // The cash-flow sentence, empty when the month is covered. Written in Rust
    // because it is a claim about someone's money, not a label.
    in property <string> cal-warning: "";
    in property <string> cal-heaviest: "";
    in property <string> cal-heaviest-label: "";
    in property <string> cal-heaviest-sub: "";
    in property <[FinFlag]> flags;
    in property <[FinStat]> insight-stats;
    in property <[FinTrendPie]> trend-pies;
    // Savings rate month by month, and the three figures under it.
    in property <[FinSavingsMonth]> savings;
    in property <[FinKv]> savings-summary;
    // Where the last few months lead if nothing changes, and what acting on
    // every flag above would be worth.
    in property <[FinKv]> projection;
    in property <string> projection-note: "";
    // Nothing has been entered yet — no account, no transaction, nothing. The
    // first-run door, shown in place of an Overview full of zeroes.
    in property <bool> empty: false;
    // Sample data is still on screen. Never hidden: invented money that does not
    // announce itself is the one thing this section must not do.
    in property <bool> demo: false;
    // The sample-data explainer. Local to this file — it has no form to fill in and
    // nothing to fetch, so routing it through `sheet` would mean building a form in
    // Rust to say two paragraphs.
    in-out property <bool> demo-open: false;
    // Non-empty while the sample data is being written or cleared, and what to
    // call it. A string rather than a bool: the two operations take about the same
    // time and look identical, so the chip has to say which one is running.
    in property <string> demo-busy: "";
    // Clearing the sample data removes the warning chip, and the chip was the only
    // door to the "add it again" button — so the header logo opens the explainer too,
    // and leaves the chip on screen afterwards as a quiet way back in.
    property <bool> demo-peek: false;

    // Sheet — one modal at a time, named by a string for the same reason `tab`
    // is a string: two booleans can be true at once and a name cannot.
    in-out property <string> sheet: "";
    in property <string> sheet-title: "";
    in property <string> sheet-hint: "";
    in property <[FinField]> form;
    in property <string> sheet-primary: "Save";
    in property <string> sheet-error: "";
    // An answer rather than a complaint: what an envelope has left, what OCR read.
    in property <string> sheet-note: "";
    in property <bool> sheet-busy: false;
    // What Enter does in a sheet. A function rather than the callback itself, so
    // the two places that fire it — the panel's key handler and a field's own
    // Enter — cannot disagree about when a submit is allowed. A sheet with no
    // primary action (the schedule, the rate list) is read-only, and one that is
    // already saving must not be told to save again.
    function sheet-confirm() {
        if (root.sheet-primary != "" && !root.sheet-busy) { root.submit-sheet(); }
    }
    // Extra content some sheets show alongside the form.
    in property <[FinPrice]> prices;
    in property <[FinInstalment]> schedule;
    // Which slice of the amortisation the sheet is showing. The whole schedule
    // stays in Rust; only ten instalments cross into the UI at a time.
    in property <int> schedule-page: 1;
    in property <int> schedule-pages: 1;
    in property <[FinImportRow]> import-rows;
    in property <string> import-summary: "";
    in property <bool> import-needs-format: false;
    // Which file column became which field, as label/value pairs.
    in property <[FinField]> import-map;
    in property <[FinProposal]> proposals;
    in property <[FinRate]> rates;
    // A rate fetch is in flight. Only ever true from the Refresh button: the daily
    // one happens on section open and has nothing to report.
    in property <bool> rates-busy: false;

    callback set-tab(string);
    callback set-field(string, string);
    callback open-sheet(string, int);
    callback close-sheet();
    callback submit-sheet();
    callback flag-action(string);

    callback subs-sort-by(string);
    callback txn-sort-by(string);
    callback txn-goto(int);
    callback txn-filter();
    callback txn-open(int);
    callback txn-delete(int);

    callback pay-obligation(int);
    callback skip-obligation(int);
    callback unpay-obligation(int);
    callback recur-status(int, string);
    callback recur-delete(int);
    callback due-settle(int);
    callback due-write-off(int);
    callback due-delete(int);
    callback account-reconcile(int);
    callback account-close(int, bool);
    callback account-delete(int);
    callback loan-schedule(int);
    callback schedule-step(int);
    callback loan-prepay(int);
    callback budget-remove(int);
    callback budget-copy-forward();
    callback cal-step(int);
    callback budget-step(int);
    callback accept-proposal(int);
    callback import-pick();
    callback scan-receipt();
    callback demo-remove();
    callback demo-add();
    callback rates-refresh();
    callback set-bills-filter(string);
    callback set-subs-filter(string);
    callback set-dues-filter(string);
    callback set-account-filter(string);
    callback subs-filter-changed();
    // Which month the Bills table covers.
    callback bills-step(int);
    // Month grid or year summary.
    callback set-cal-view(string);
    // Recount a cash account: a reconcile by another name, and the word the
    // physical act actually has.
    callback account-recount(int);
    // Pay a card statement off in full. Posts a transfer, never an expense.
    callback account-pay-card(int);
    // Opens the ledger filtered to the account being reconciled.
    callback find-missing();
    // Saves and reopens a blank form of the same kind, for entering several
    // things in a row.
    callback submit-again();
    callback refresh();
    // One selector over envelopes and due dates alike, so Planning's blocks are
    // always talking about the same month.
    callback plan-step(int);

    // What the header button and Ctrl+N both do, so the two cannot drift apart.
    function add-new() {
        if (root.acts-direct != "") { root.open-sheet(root.acts-direct, 0); }
        else { root.actions-open = true; }
    }

    background: FinTheme.canvas;

    // Ctrl+N opens the actions popup from anywhere on the section. It wraps the
    // whole page rather than sitting beside it, so the key is caught wherever the
    // focus happens to be — a control that handles the key itself still wins, which
    // is why this is Ctrl+N and not a bare letter.
    keys := FocusScope {
        width: 100%; height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == "n" && e.modifiers.control) {
                root.add-new();
                return accept;
            }
            reject
        }

    // ── header ──────────────────────────────────────────────────────────────
    VerticalLayout {
        padding: 18px;
        spacing: 14px;

        // ── row 1 · badge · title · search · actions ────────────────────────
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                // Gradient-filled, like every other section's header badge. The
                // icon is dark-on-accent rather than accent-on-wash: it is the one
                // place the section states its colour at full strength.
                Rectangle {
                    width: 44px; height: 44px; border-radius: Surface.rr(13px, self.width, self.height);
                    background: FinTheme.accent-grad;
                    // Also the way back to the sample-data explainer: see `demo-peek`.
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.demo-peek = true; root.demo-open = true; }
                    }
                    AppIcon {
                        source: Icons.wallet; tint: FinTheme.on-accent;
                        width: 23px; height: 23px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Text { text: "Finances"; color: FinTheme.ink; font-size: 21px; font-weight: 800; }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }

            // ── sample-data warning ─────────────────────────────────────────
            // Money the app invented has to announce itself wherever the user is,
            // so this sits in the header rather than on one tab, and it pulses
            // because a static notice beside eight other controls is a notice
            // nobody reads. It disappears for good once the last sample is gone.
            if root.demo-busy != "": VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                BusyPill { label: root.demo-busy; }
            }
            if root.demo-busy == "" && (root.demo || root.demo-peek): VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                WarnPulse {
                    label: root.demo ? "Sample data" : "Add sample data";
                    quiet: !root.demo;
                    icon: root.demo ? Icons.triangle-alert : Icons.plus;
                    clicked => { root.demo-open = true; }
                }
            }
            // Search is the ledger's search wherever it is typed: there is one
            // table underneath every tab, so a second "search everything" box
            // would be the same query with a different name. Typing here goes to
            // the tab that can show the answer.
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                HdrSearch {
                    width: 260px;
                    dark: !FinTheme.light;
                    outline: true;
                    tint: FinTheme.accent.with-alpha(0.55);
                    placeholder: "Search transactions";
                    query <=> root.txn-search;
                    edited(q) => {
                        if (root.tab != "txns") { root.set-tab("txns"); }
                        root.txn-filter();
                    }
                    cleared => { root.txn-filter(); }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                // One button where there were four. Import, Scan, Add and the rates
                // sheet are all "put something into the ledger", and four buttons
                // spent the widest part of the header making you choose before you
                // had read any of it.
                Btn { label: "Add New"; icon: Icons.plus; h: 44px; primary: true; pulse: true;
                    clicked => { root.add-new(); } }
            }
        }

        // ── row 2 · the seven sections, on one row ──────────────────────────
        // Seven, not ten. Plan, Budgets, Calendar and Insights were four answers
        // to one question — what should I do next — and four tabs asking it meant
        // the answer was only ever a quarter visible. They are one page and its
        // drill-downs now; none of what they showed was deleted.
        //
        // Ordered as the design states it: what happened, where it happened,
        // where the money is, what to do next, then the three lists of things
        // that repeat.
        HorizontalLayout {
            spacing: 8px; alignment: start;
            FinTab { label: "Overview"; icon: Icons.pie-chart; wide: 110px;
                compact: root.tabs-compact; active: root.tab == "overview";
                clicked => { root.set-tab("overview"); } }
            FinTab { label: "Transactions"; icon: Icons.trending-up; wide: 134px;
                compact: root.tabs-compact; active: root.tab == "txns";
                clicked => { root.set-tab("txns"); } }
            FinTab { label: "Accounts"; icon: Icons.credit-card; wide: 112px;
                compact: root.tabs-compact; active: root.tab == "accounts";
                clicked => { root.set-tab("accounts"); } }
            FinTab { label: "Planning"; icon: Icons.calendar-clock; wide: 112px;
                compact: root.tabs-compact; active: root.tab == "planning";
                clicked => { root.set-tab("planning"); } }
            // No counts on any of the seven. Each tab's own filter row carries
            // them, and a number on a tab is a number you have to read past to
            // find the name of the thing you wanted. The Bills badge is still on
            // the sidebar, which is where a thing that needs you belongs.
            FinTab { label: "Bills"; icon: Icons.receipt; wide: 88px;
                compact: root.tabs-compact; active: root.tab == "bills";
                clicked => { root.set-tab("bills"); } }
            FinTab { label: "Subscriptions"; icon: Icons.repeat; wide: 138px;
                compact: root.tabs-compact; active: root.tab == "subs";
                clicked => { root.set-tab("subs"); } }
            // 84px was the width "Dues" needed. The label grew and this did not.
            FinTab { label: "Lending"; icon: Icons.users; wide: 104px;
                compact: root.tabs-compact; active: root.tab == "dues";
                clicked => { root.set-tab("dues"); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }

        // ── body ────────────────────────────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            background: transparent;

            // ══ FIRST RUN ═══════════════════════════════════════════════════
            // Nothing entered yet. An Overview of nine zeroes is not a dashboard,
            // it is a wall — and it does not say which of the three ways in is
            // the cheap one. The importer is: one statement gives the ledger, the
            // recurring bills and the subscriptions in a single pass.
            if root.empty && root.tab == "overview": VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        spacing: 14px; max-width: 460px;
                        Rectangle {
                            width: 58px; height: 58px;
                            border-radius: Surface.rr(18px, self.width, self.height);
                            background: FinTheme.accent-grad;
                            x: (parent.width - self.width) / 2;
                            AppIcon {
                                source: Icons.wallet; tint: FinTheme.on-accent;
                                width: 28px; height: 28px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Text {
                            text: "Nothing tracked yet";
                            color: FinTheme.ink; font-size: 17px; font-weight: 800;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Start with an account and last month's statement — the importer will find the recurring bills and subscriptions on its own. Or add one expense and grow from there.";
                            color: FinTheme.ink-dim; font-size: 12.5px;
                            wrap: word-wrap; horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 8px; alignment: center;
                            Btn { label: "Add an account"; icon: Icons.credit-card;
                                h: 36px; primary: true;
                                clicked => { root.open-sheet("account", 0); } }
                            Btn { label: "Import a statement"; icon: Icons.upload; h: 36px;
                                clicked => { root.import-pick(); } }
                            Btn { label: "Add an expense"; icon: Icons.plus; h: 36px;
                                clicked => { root.open-sheet("txn", 0); } }
                        }
                        if !root.demo: Text {
                            text: "Or press Add sample data in the header to see the section with a month of invented money in it. It is labelled everywhere it appears and removes cleanly.";
                            color: FinTheme.ink-dim; font-size: 11px;
                            wrap: word-wrap; horizontal-alignment: center;
                        }
                    }
                }
            }

            // ══ OVERVIEW ════════════════════════════════════════════════════
            if !root.empty && root.tab == "overview": ScrollView {
                // Every tab in this section resets its scroll. A ScrollView keeps
                // its viewport-y across a model swap, so without this the page
                // opens halfway down wherever it was left.
                property <int> watch: root.stats.length + root.needs-you.length + root.recent.length;
                changed watch => { self.viewport-y = 0; }
                init => { self.viewport-y = 0; }
                VerticalLayout {
                    alignment: start;
                    padding-right: 6px; spacing: 14px;

                    StatStrip {
                        stats: root.stats;
                        picked(what) => { if (what == "health") { root.health-open = true; } }
                    }

                    // breakdown + needs-you
                    HorizontalLayout {
                        spacing: 14px;
                        // Breakdown and the year, one card. The bars are the
                        // month picker for the ring above them, so splitting
                        // them across two cards put the control and the thing it
                        // controls in different boxes.
                        Card {
                            horizontal-stretch: 1;
                            min-height: root.overview-h; max-height: root.overview-h;
                            VerticalLayout {
                                padding: 16px; spacing: 12px;
                                CardTitle { title: "Where it went"; hint: root.picked-label; }
                                // The heading names the month rather than saying
                                // "this month": the bars select one, and the newest
                                // bar is not always the current month.
                                //
                                // The year hangs inside the breakdown rather than
                                // under it, which puts it in the legend's column —
                                // the ring gets its own forty percent to be centred
                                // in, and the bars get a width they fit.
                                SpendBreakdown {
                                    vertical-stretch: 1;
                                    slices: root.slices;
                                    total: root.picked-total;
                                    caption: "spent";
                                    empty-label: root.picked-label;
                                    avail: root.overview-card-w;
                                    if root.months.length == 0: Text {
                                        text: "Not enough history yet.";
                                        color: FinTheme.ink-dim; font-size: 12.5px;
                                    }
                                    if root.months.length > 0: MonthBars {
                                        months: root.months;
                                        selected: root.picked;
                                        picked(i) => { root.pick-month(i); }
                                    }
                                }
                            }
                        }
                        // Seven rows and a pager, at the same fixed height as the
                        // card beside it. Paging rather than growing: this list is
                        // however long the fortnight makes it, and a card that
                        // changed height with it dragged the whole page around.
                        Card {
                            horizontal-stretch: 1;
                            min-height: root.overview-h; max-height: root.overview-h;
                            VerticalLayout {
                                padding: 16px; spacing: 10px;
                                CardTitle {
                                    title: "Needs you";
                                    hint: root.needs-you.length > 0
                                        ? "next 14 days · \{root.needs-you.length}" : "";
                                    hue: FinTheme.warn;
                                }
                                if root.needs-you.length == 0: Text {
                                    text: "Nothing due in the next fortnight.";
                                    color: FinTheme.ink-dim; font-size: 12.5px;
                                }
                                VerticalLayout {
                                    vertical-stretch: 1;
                                    alignment: start; spacing: 6px;
                                    // `if` inside a `for` needs an element of its
                                    // own to hang off, and that wrapper is what
                                    // collapses to nothing for an off-page row.
                                    for item[i] in root.needs-you: Rectangle {
                                        height: i >= root.needs-first
                                            && i < root.needs-first + root.needs-per-page
                                            ? 56px : 0px;
                                        background: transparent;
                                        clip: true;
                                        if i >= root.needs-first
                                            && i < root.needs-first + root.needs-per-page: NeedsRow {
                                            width: parent.width;
                                            item: item;
                                            pay(id) => { root.pay-obligation(id); }
                                            // Asks rather than acts. `item` is
                                            // captured here rather than looked up
                                            // by id later, because confirming is
                                            // about to rebuild the model this row
                                            // came from.
                                            skip(id) => {
                                                root.needs-sel = item;
                                                root.needs-skip-open = true;
                                            }
                                            opened => {
                                                root.needs-sel = item;
                                                root.needs-open = true;
                                            }
                                        }
                                    }
                                }
                                if root.needs-pages > 1: HorizontalLayout {
                                    spacing: 8px; alignment: center;
                                    Btn {
                                        label: "Previous"; h: 30px;
                                        enabled: root.needs-page > 0;
                                        clicked => { root.needs-page -= 1; }
                                    }
                                    Text {
                                        text: "Page \{root.needs-page + 1} of \{root.needs-pages}";
                                        color: FinTheme.ink-dim; font-size: 11.5px;
                                        vertical-alignment: center;
                                    }
                                    Btn {
                                        label: "Next"; h: 30px;
                                        enabled: root.needs-page + 1 < root.needs-pages;
                                        clicked => { root.needs-page += 1; }
                                    }
                                }
                            }
                        }
                    }

                    // Accounts, loans and the short ledger in one row, each card a
                    // way in to the tab it summarises.
                    //
                    // The row is a fixed height and every list inside it scrolls,
                    // rather than each card growing to its own contents — which is
                    // what left the row with two ragged holes in it. Scrolling and
                    // not capping, so a card is never quietly showing you a subset
                    // of your own money.
                    HorizontalLayout {
                        spacing: 14px;
                        LinkCard {
                            horizontal-stretch: 1;
                            min-height: root.row2-h; max-height: root.row2-h;
                            opened => { root.set-tab("accounts"); }
                            VerticalLayout {
                                padding: 16px; spacing: 10px;
                                CardTitle {
                                    title: "Accounts";
                                    hint: root.liquid-total + " liquid";
                                    hue: FinTheme.accent-2;
                                    link: true;
                                    clicked => { root.set-tab("accounts"); }
                                }
                                ScrollView {
                                    vertical-stretch: 1;
                                    // A ScrollView keeps its viewport-y across a
                                    // model swap, so without this a refresh leaves
                                    // the list parked halfway down a shorter list.
                                    property <int> watch: root.accounts.length;
                                    changed watch => { self.viewport-y = 0; }
                                    init => { self.viewport-y = 0; }
                                    VerticalLayout {
                                        alignment: start; spacing: 8px; padding-right: 6px;
                                        for a in root.accounts: HorizontalLayout {
                                            spacing: 10px;
                                            // The same mark the Accounts tab gives
                                            // this account, not a kind icon: four
                                            // banks were four identical wallets
                                            // here, and the thing being told apart
                                            // is the bank.
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                AccountBadge { glyph: a.badge; hue: a.hue; }
                                            }
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 1; spacing: 1px;
                                                Text {
                                                    text: a.name; color: FinTheme.ink; font-size: 12.5px;
                                                    font-weight: 600; overflow: elide;
                                                }
                                                if a.sub != "": Text {
                                                    text: a.sub; color: FinTheme.ink-dim;
                                                    font-size: 10.5px; overflow: elide;
                                                }
                                            }
                                            Text {
                                                text: a.balance;
                                                color: a.negative ? FinTheme.bad : FinTheme.ink;
                                                font-size: 12.5px; font-weight: 700;
                                                vertical-alignment: center; horizontal-stretch: 0;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        LinkCard {
                            horizontal-stretch: 1;
                            min-height: root.row2-h; max-height: root.row2-h;
                            // Loans live on the Accounts tab, which is where a loan
                            // that needs looking at is actually worked on.
                            opened => { root.set-tab("accounts"); }
                            VerticalLayout {
                                padding: 16px; spacing: 10px;
                                CardTitle {
                                    title: "Loans";
                                    hint: root.loans.length > 0 ? root.debt-total + " owed" : "";
                                    hue: FinTheme.bad;
                                    link: true;
                                    clicked => { root.set-tab("accounts"); }
                                }
                                if root.loans.length == 0: Text {
                                    text: "No loans tracked.";
                                    color: FinTheme.ink-dim; font-size: 12.5px;
                                }
                                if root.loans.length > 0: ScrollView {
                                    vertical-stretch: 1;
                                    property <int> watch: root.loans.length;
                                    changed watch => { self.viewport-y = 0; }
                                    init => { self.viewport-y = 0; }
                                    VerticalLayout {
                                        alignment: start; spacing: 10px; padding-right: 6px;
                                        // Same mark as the Loans grid on the Accounts
                                        // tab. The badge spans both lines of the
                                        // entry, so the bar and its caption sit in
                                        // one indented column under the name.
                                        for l in root.loans: HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: start; horizontal-stretch: 0;
                                                AccountBadge { glyph: l.badge; hue: l.hue; }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1; spacing: 4px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: l.name; color: FinTheme.ink; font-size: 12px;
                                                        vertical-alignment: center; horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: l.balance; color: FinTheme.bad;
                                                        font-size: 12px; font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                // Repayment, not burn: 90% paid off is the good end of
                                                // this bar, so it carries a gradient rather than the
                                                // burn tones — nothing here is ever a warning.
                                                Bar { pct: l.progress-pct; thickness: 9px;
                                                    hue: FinTheme.accent-2; hue-2: FinTheme.good;
                                                    toned: false; }
                                                Text {
                                                    text: "\{l.remaining-months} of \{l.tenure-months} left · " + l.emi + " a month";
                                                    color: FinTheme.ink-dim; font-size: 10.5px;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        LinkCard {
                            horizontal-stretch: 1;
                            min-height: root.row2-h; max-height: root.row2-h;
                            opened => { root.set-tab("txns"); }
                            VerticalLayout {
                                padding: 16px; spacing: 10px;
                                CardTitle {
                                    title: "Recent transactions";
                                    hint: root.recent.length > 0 ? "newest first" : "";
                                    hue: FinTheme.good;
                                    link: true;
                                    clicked => { root.set-tab("txns"); }
                                }
                                if root.recent.length == 0: Text {
                                    text: "Nothing posted yet. Add one, or import a statement.";
                                    color: FinTheme.ink-dim; font-size: 12.5px;
                                }
                                if root.recent.length > 0: ScrollView {
                                    vertical-stretch: 1;
                                    property <int> watch: root.recent.length;
                                    changed watch => { self.viewport-y = 0; }
                                    init => { self.viewport-y = 0; }
                                    VerticalLayout {
                                        alignment: start; spacing: 8px; padding-right: 6px;
                                        for t in root.recent: HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                // Direction, as a tile: money in, money out, or
                                                // money that only moved between your own
                                                // accounts and is not spending at all.
                                                Tile {
                                                    size: 30px;
                                                    hue: t.kind == "income" ? FinTheme.good
                                                       : t.kind == "transfer" ? FinTheme.ink-dim
                                                       : FinTheme.accent;
                                                    icon: t.kind == "income" ? Icons.arrow-down
                                                        : t.kind == "transfer" ? Icons.refresh-cw
                                                        : Icons.arrow-up;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 1; spacing: 1px;
                                                Text {
                                                    text: t.description;
                                                    // A transfer is greyed back here for the same
                                                    // reason it is in the ledger: visible, but not
                                                    // reading as spending.
                                                    color: t.kind == "transfer" ? FinTheme.transfer-ink : FinTheme.ink;
                                                    font-size: 12.5px; font-weight: 600; overflow: elide;
                                                }
                                                Text {
                                                    text: t.date + " · " + t.category;
                                                    color: FinTheme.ink-dim; font-size: 10.5px;
                                                    overflow: elide;
                                                }
                                            }
                                            Text {
                                                text: t.amount;
                                                color: t.kind == "income"   ? FinTheme.good
                                                     : t.kind == "transfer" ? FinTheme.transfer-ink
                                                     : FinTheme.ink;
                                                font-size: 12.5px; font-weight: 700;
                                                vertical-alignment: center; horizontal-stretch: 0;
                                                min-width: 84px; horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ══ TRANSACTIONS ════════════════════════════════════════════════
            if root.tab == "txns": VerticalLayout {
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        placeholder-text: "Search description or merchant…";
                        text: root.txn-search;
                        horizontal-stretch: 1;
                        edited(t) => { root.txn-search = t; root.txn-filter(); }
                    }
                    ComboBox {
                        model: root.account-names; current-value: root.txn-account;
                        min-width: 170px; horizontal-stretch: 0;
                        selected(v) => { root.txn-account = v; root.txn-filter(); }
                    }
                    ComboBox {
                        model: root.category-names; current-value: root.txn-category;
                        min-width: 170px; horizontal-stretch: 0;
                        selected(v) => { root.txn-category = v; root.txn-filter(); }
                    }
                    // Month and provenance. Both narrow in SQL, so the row count,
                    // the totals and the pager under the table all stay true to
                    // what is actually on screen.
                    ComboBox {
                        model: root.txn-periods; current-value: root.txn-period;
                        min-width: 150px; horizontal-stretch: 0;
                        selected(v) => { root.txn-period = v; root.txn-filter(); }
                    }
                    ComboBox {
                        model: root.source-names; current-value: root.txn-source;
                        min-width: 140px; horizontal-stretch: 0;
                        selected(v) => { root.txn-source = v; root.txn-filter(); }
                    }
                }

                // Direction chips. The combo boxes above narrow *what*; these
                // narrow which way the money went, which is the filter people
                // actually reach for.
                HorizontalLayout {
                    spacing: 8px; alignment: start;
                    FilterChip { label: "Everything";
                        min-width: 108px;
                        on: root.txn-kind == "All";
                        clicked => { root.txn-kind = "All"; root.txn-filter(); } }
                    FilterChip { label: "Money out"; icon: Icons.arrow-up;
                        min-width: 116px;
                        on: root.txn-kind == "Expense";
                        clicked => { root.txn-kind = "Expense"; root.txn-filter(); } }
                    FilterChip { label: "Money in"; icon: Icons.arrow-down;
                        min-width: 112px;
                        on: root.txn-kind == "Income";
                        clicked => { root.txn-kind = "Income"; root.txn-filter(); } }
                    // Transfers are shown but never counted as spending, which is
                    // the whole reason they get a filter of their own.
                    FilterChip { label: "Transfers"; icon: Icons.refresh-cw;
                        min-width: 112px;
                        on: root.txn-kind == "Transfer";
                        clicked => { root.txn-kind = "Transfer"; root.txn-filter(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                HorizontalLayout {
                    spacing: 16px; alignment: start;
                    Text {
                        text: "\{root.txn-total} transactions";
                        color: FinTheme.ink-dim; font-size: 11.5px; vertical-alignment: center;
                    }
                    Text {
                        text: root.txn-spent + " out";
                        color: FinTheme.ink; font-size: 11.5px; font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.txn-income + " in";
                        color: FinTheme.good; font-size: 11.5px; font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                Card {
                    vertical-stretch: 1;
                    clip: true;
                    VerticalLayout {
                        padding: 0px; spacing: 0px;

                        // header row
                        Rectangle {
                            min-height: 38px; max-height: 38px;
                            background: FinTheme.card-2;
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; spacing: 10px;
                                HeadCell { label: "DATE"; w: 90px;
                                    sorted: root.txn-sort == "date"; desc: root.txn-desc;
                                    clicked => { root.txn-sort-by("date"); } }
                                HeadCell { label: "DESCRIPTION"; flex: true;
                                    sorted: root.txn-sort == "description"; desc: root.txn-desc;
                                    clicked => { root.txn-sort-by("description"); } }
                                HeadCell { label: "CATEGORY"; w: 130px;
                                    sorted: root.txn-sort == "category"; desc: root.txn-desc;
                                    clicked => { root.txn-sort-by("category"); } }
                                HeadCell { label: "ACCOUNT"; w: 120px;
                                    sorted: root.txn-sort == "account"; desc: root.txn-desc;
                                    clicked => { root.txn-sort-by("account"); } }
                                HeadCell { label: "SOURCE"; w: 90px;
                                    sorted: root.txn-sort == "source"; desc: root.txn-desc;
                                    clicked => { root.txn-sort-by("source"); } }
                                HeadCell { label: "AMOUNT"; w: 110px; right: true;
                                    sorted: root.txn-sort == "amount"; desc: root.txn-desc;
                                    clicked => { root.txn-sort-by("amount"); } }
                                if root.running-shown: HeadCell {
                                    label: "BALANCE"; w: 110px; right: true; sortable: false; }
                                HeadCell { label: ""; w: 64px; sortable: false; }
                            }
                        }
                        Rectangle { min-height: 1px; max-height: 1px; background: FinTheme.hairline; }

                        ScrollView {
                            vertical-stretch: 1;
                            property <int> watch: root.txns.length + root.txn-page * 1000;
                            changed watch => { self.viewport-y = 0; }
                            init => { self.viewport-y = 0; }
                            VerticalLayout {
                                spacing: 0px; alignment: start;
                                if root.txns.length == 0: Rectangle {
                                    min-height: 200px;
                                    Text {
                                        text: "No transactions match that.";
                                        color: FinTheme.ink-dim; font-size: 13px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                for t in root.txns: Rectangle {
                                    min-height: 44px; max-height: 44px;
                                    background: rowta.has-hover ? FinTheme.card-2 : transparent;
                                    rowta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.txn-open(t.id); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 14px; padding-right: 14px; spacing: 10px;
                                        Cell { text: t.date; w: 90px; dim: true; }
                                        Cell {
                                            text: t.description; flex: true;
                                            // A transfer is shown but must read as
                                            // obviously not spending.
                                            ink: t.kind == "transfer"
                                                 ? FinTheme.transfer-ink : FinTheme.ink;
                                        }
                                        // Category as a tinted tag rather than grey
                                        // text: it is the column the eye groups the
                                        // table by, and the colour is the same one
                                        // the donut used.
                                        Rectangle {
                                            horizontal-stretch: 0;
                                            min-width: 130px; max-width: 130px;
                                            background: transparent;
                                            // A long category name is cut off here
                                            // rather than growing the pill into the
                                            // account column.
                                            clip: true;
                                            if t.category != "": Pill {
                                                x: 0;
                                                y: (parent.height - self.height) / 2;
                                                label: t.category; hue: t.cat-hue;
                                            }
                                        }
                                        Cell { text: t.account; w: 120px; dim: true; }
                                        Cell { text: t.source; w: 90px; dim: true; }
                                        Cell {
                                            text: t.amount; w: 110px; right: true; strong: true;
                                            ink: t.kind == "income"   ? FinTheme.good
                                               : t.kind == "transfer" ? FinTheme.transfer-ink
                                                                      : FinTheme.ink;
                                        }
                                        if root.running-shown: Cell {
                                            text: t.running; w: 110px; right: true; dim: true; }
                                        Rectangle {
                                            horizontal-stretch: 0;
                                            min-width: 64px; max-width: 64px;
                                            background: transparent;
                                            HorizontalLayout {
                                                alignment: end; spacing: 2px;
                                                VerticalLayout {
                                                    alignment: center; horizontal-stretch: 0;
                                                    IconBtn {
                                                        icon: Icons.x; hue: FinTheme.ink-dim;
                                                        clicked => { root.txn-delete(t.id); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        y: parent.height - 1px;
                                        height: 1px; width: parent.width;
                                        background: FinTheme.hairline;
                                    }
                                }
                            }
                        }
                    }
                }

                // pager
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    Btn {
                        label: "Previous"; h: 32px; enabled: root.txn-page > 0;
                        clicked => { root.txn-goto(root.txn-page - 1); }
                    }
                    Text {
                        text: "Page \{root.txn-page + 1} of \{root.txn-pages}";
                        color: FinTheme.ink-dim; font-size: 12px; vertical-alignment: center;
                    }
                    Btn {
                        label: "Next"; h: 32px; enabled: root.txn-page + 1 < root.txn-pages;
                        clicked => { root.txn-goto(root.txn-page + 1); }
                    }
                }
            }

            // ══ BILLS ═══════════════════════════════════════════════════════
            if root.tab == "bills": ScrollView {
                property <int> watch: root.bills.length + root.bill-templates.length;
                changed watch => { self.viewport-y = 0; }
                init => { self.viewport-y = 0; }
                VerticalLayout {
                    alignment: start;
                    padding-right: 6px; spacing: 14px;

                    StatStrip { stats: root.bill-stats; }

                    // Which bills to show. Filtered in Rust rather than here: Slint
                    // models cannot be filtered in a `for`, and a hidden-but-present
                    // row would still be counted by everything above.
                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        FilterChip { label: "All"; count: root.bills-all;
                            on: root.bills-filter == "all";
                            clicked => { root.set-bills-filter("all"); } }
                        FilterChip { label: "Needs action"; count: root.bills-needs;
                            min-width: 128px;
                            on: root.bills-filter == "needs";
                            clicked => { root.set-bills-filter("needs"); } }
                        FilterChip { label: "Auto"; count: root.bills-auto;
                            on: root.bills-filter == "auto";
                            clicked => { root.set-bills-filter("auto"); } }
                        FilterChip { label: "Paid"; count: root.bills-paid;
                            on: root.bills-filter == "paid";
                            clicked => { root.set-bills-filter("paid"); } }
                        FilterChip { label: "One-off"; count: root.bills-oneoff;
                            min-width: 96px;
                            on: root.bills-filter == "oneoff";
                            clicked => { root.set-bills-filter("oneoff"); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        // Which month. The list is dated, so without this it shows
                        // whatever window the loader happened to ask for — and the
                        // four figures above it would be of that window too.
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            HorizontalLayout {
                                spacing: 4px;
                                IconBtn { icon: Icons.chevron-left;
                                    clicked => { root.bills-step(-1); } }
                                Text { text: root.bills-period; color: FinTheme.ink;
                                    font-size: 12.5px; font-weight: 700;
                                    vertical-alignment: center; min-width: 104px;
                                    horizontal-alignment: center; }
                                IconBtn { icon: Icons.chevron-right;
                                    clicked => { root.bills-step(1); } }
                            }
                        }
                    }

                    Card {
                        clip: true;
                        VerticalLayout {
                            alignment: start;
                            padding: 0px; spacing: 0px;

                            // Column header. Not sortable: the list is ordered by due
                            // date, which is the only order a bill list is useful in.
                            Rectangle {
                                min-height: 36px; max-height: 36px;
                                background: FinTheme.card-2;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                                    HeadCell { label: "BILL"; flex: true; sortable: false; }
                                    HeadCell { label: "CATEGORY"; w: 116px; sortable: false; }
                                    HeadCell { label: "DUE"; w: 78px; sortable: false; }
                                    HeadCell { label: "ESTIMATE"; w: 96px; right: true;
                                        sortable: false; }
                                    HeadCell { label: "ACTUAL"; w: 96px; right: true;
                                        sortable: false; }
                                    HeadCell { label: "PAYS FROM"; w: 108px; sortable: false; }
                                    HeadCell { label: "STATUS"; w: 116px; sortable: false; }
                                    HeadCell { label: ""; w: 104px; sortable: false; }
                                }
                            }
                            Rectangle { min-height: 1px; max-height: 1px;
                                background: FinTheme.hairline; }

                            if root.bills.length == 0: Blank {
                                title: root.bills-all == 0 ? "No bills yet" : "Nothing in that filter";
                                body: root.bills-all == 0
                                    ? "A bill is anything whose amount changes month to month — electricity, water, a card statement. Add one, or let the importer find it in a statement."
                                    : "Every bill is in one of the other groups.";
                                icon: Icons.receipt;
                            }

                            for b in root.bills: brow := Rectangle {
                                min-height: 46px; max-height: 46px;
                                // An overdue row carries a faint alarm wash of its
                                // own, so it is findable in a long list without
                                // hovering every row to see which one is red.
                                background: b.status == "overdue"
                                    ? FinTheme.bad.with-alpha(bta.has-hover ? 0.14 : 0.07)
                                    : (bta.has-hover ? FinTheme.card-2 : transparent);
                                bta := TouchArea { }
                                property <color> hue:
                                    b.status == "overdue" ? FinTheme.bad :
                                    b.status == "paid"    ? FinTheme.good :
                                    b.days <= 0           ? FinTheme.warn : FinTheme.ink-dim;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                                    // Name, with the cycle underneath it — the
                                    // mockup's two-line first cell.
                                    Rectangle {
                                        horizontal-stretch: 1; min-width: 120px;
                                        background: transparent; clip: true;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                Tile {
                                                    size: 28px; hue: brow.hue;
                                                    icon: b.status == "paid" ? Icons.check
                                                        : b.auto-post ? Icons.refresh-cw
                                                        : Icons.receipt;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 1;
                                                spacing: 1px;
                                                Text { text: b.name; color: FinTheme.ink;
                                                    font-size: 12.5px; font-weight: 600;
                                                    overflow: elide; }
                                                Text {
                                                    text: b.kind == "one-off" ? "one-off"
                                                        : (b.auto-post ? "auto-debit" : "confirm each month");
                                                    color: FinTheme.ink-dim; font-size: 10px;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: 116px; max-width: 116px;
                                        background: transparent; clip: true;
                                        if b.category != "": Pill {
                                            x: 0; y: (parent.height - self.height) / 2;
                                            label: b.category; hue: b.cat-hue;
                                        }
                                    }
                                    Cell { text: b.due; w: 78px; dim: true; }
                                    // Italic as well as tilde'd: a guess must not be
                                    // readable as a measurement.
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: 96px; max-width: 96px;
                                        background: transparent;
                                        Text {
                                            width: 100%;
                                            y: (parent.height - self.height) / 2;
                                            text: b.estimate == "" ? "—" : b.estimate;
                                            color: FinTheme.ink-dim; font-size: 12.5px;
                                            font-italic: b.is-estimate;
                                            horizontal-alignment: right;
                                        }
                                    }
                                    Cell {
                                        text: b.actual == "" ? "—" : b.actual;
                                        w: 96px; right: true; strong: true;
                                    }
                                    Cell { text: b.account; w: 108px; dim: true; }
                                    // Status, with the variance under it when both an
                                    // estimate and an actual are known — the gap
                                    // between those two is the whole reason a bill is
                                    // not a subscription.
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: 116px; max-width: 116px;
                                        background: transparent; clip: true;
                                        VerticalLayout {
                                            alignment: center; spacing: 1px;
                                            HorizontalLayout {
                                                alignment: start;
                                                Pill {
                                                    hue: brow.hue;
                                                    label: b.status == "overdue"
                                                            ? "\{-b.days} days late"
                                                        : b.status == "paid" ? "Paid"
                                                        : b.status == "skipped" ? "Skipped"
                                                        : b.auto-post ? "Auto-debit"
                                                        : b.days == 0 ? "Due today"
                                                        : "Due in \{b.days}d";
                                                }
                                            }
                                            if b.variance != "": Text {
                                                text: (b.over ? "+" : "−") + b.variance
                                                      + (b.over ? " over" : " under");
                                                color: b.over ? FinTheme.bad : FinTheme.good;
                                                font-size: 10px; font-weight: 700;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: 104px; max-width: 104px;
                                        background: transparent;
                                        HorizontalLayout {
                                            alignment: end; spacing: 4px;
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                if b.status != "paid": Btn {
                                                    label: b.is-estimate ? "Enter" : "Paid";
                                                    h: 28px; primary: true;
                                                    clicked => { root.pay-obligation(b.id); }
                                                }
                                                if b.status == "paid": Btn {
                                                    label: "Undo"; h: 28px;
                                                    clicked => { root.unpay-obligation(b.id); }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                if b.status != "paid": IconBtn {
                                                    icon: Icons.x; tip: "Skip this one";
                                                    clicked => { root.skip-obligation(b.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px; width: parent.width;
                                    background: FinTheme.hairline;
                                }
                            }
                        }
                    }

                    // the templates behind them
                    if root.bill-templates.length > 0: Card {
                        VerticalLayout {
                            alignment: start;
                            padding: 16px; spacing: 10px;
                            CardTitle {
                                title: "Recurring bills";
                                hint: "The templates that produce the dated bills above.";
                            }
                            for r in root.bill-templates: HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text { text: r.name; color: FinTheme.ink; font-size: 12.5px;
                                        font-weight: 600; }
                                    Text {
                                        text: r.cycle + " · next " + r.next-due
                                              + (r.account == "" ? "" : " · " + r.account);
                                        color: FinTheme.ink-dim; font-size: 11px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text {
                                        text: r.amount;
                                        color: FinTheme.ink; font-size: 13px; font-weight: 700;
                                        font-italic: r.is-estimate;
                                        horizontal-alignment: right;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Btn { label: "Edit"; h: 28px;
                                            clicked => { root.open-sheet("bill", r.id); } }
                                        IconBtn { icon: Icons.x;
                                            clicked => { root.recur-delete(r.id); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ══ SUBSCRIPTIONS ═══════════════════════════════════════════════
            if root.tab == "subs": ScrollView {
                property <int> watch: root.subs.length;
                changed watch => { self.viewport-y = 0; }
                init => { self.viewport-y = 0; }
                VerticalLayout {
                    alignment: start;
                    padding-right: 6px; spacing: 14px;
                    StatStrip { stats: root.sub-stats; }

                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        // All four the same width, sized for the longest label
                        // and its count. Left to themselves "All 11" and
                        // "Cancelled 1" are two very different chips.
                        FilterChip { label: "All"; count: root.subs-all; w: 116px;
                            on: root.subs-filter == "all";
                            clicked => { root.subs-page = 0; root.set-subs-filter("all"); } }
                        FilterChip { label: "Active"; count: root.subs-active; w: 116px;
                            on: root.subs-filter == "active";
                            clicked => { root.subs-page = 0; root.set-subs-filter("active"); } }
                        FilterChip { label: "Paused"; count: root.subs-paused; w: 116px;
                            on: root.subs-filter == "paused";
                            clicked => { root.subs-page = 0; root.set-subs-filter("paused"); } }
                        FilterChip { label: "Cancelled"; count: root.subs-cancelled; w: 116px;
                            on: root.subs-filter == "cancelled";
                            clicked => { root.subs-page = 0; root.set-subs-filter("cancelled"); } }
                        // Not a status you drift into — a holding pen the X puts a
                        // row in, and the only place it can be deleted for good.
                        FilterChip { label: "Removed"; count: root.subs-removed; w: 116px;
                            on: root.subs-filter == "removed";
                            clicked => { root.subs-page = 0; root.set-subs-filter("removed"); } }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        // Narrowed in Rust like the chips are, for the same reason:
                        // a hidden-but-present row would still be counted by the
                        // totals above it.
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            ComboBox {
                                model: root.subs-categories;
                                current-value: root.subs-category;
                                min-width: 160px;
                                selected(v) => {
                                    root.subs-page = 0;
                                    root.subs-category = v;
                                    root.subs-filter-changed();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            ComboBox {
                                model: root.subs-currencies;
                                current-value: root.subs-currency;
                                min-width: 140px;
                                selected(v) => {
                                    root.subs-page = 0;
                                    root.subs-currency = v;
                                    root.subs-filter-changed();
                                }
                            }
                        }
                    }

                    Card {
                        clip: true;
                        VerticalLayout {
                            alignment: start;
                            padding: 0px; spacing: 0px;
                            Rectangle {
                                min-height: 38px; max-height: 38px;
                                background: FinTheme.card-2;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                                    // The number is the position in the sort, not a
                                    // key of its own, so it is the one column that
                                    // cannot be sorted by.
                                    HeadCell { label: "#"; w: root.subs-num; centre: true;
                                        sortable: false; }
                                    HeadCell { label: "SERVICE"; w: root.subs-name;
                                        sorted: root.subs-sort == "name"; desc: root.subs-desc;
                                        clicked => { root.subs-page = 0; root.subs-sort-by("name"); } }
                                    HeadCell { label: "CATEGORY"; w: root.subs-col; centre: true;
                                        sorted: root.subs-sort == "category"; desc: root.subs-desc;
                                        clicked => { root.subs-page = 0; root.subs-sort-by("category"); } }
                                    HeadCell { label: "CYCLE"; w: root.subs-col; centre: true;
                                        sorted: root.subs-sort == "cycle"; desc: root.subs-desc;
                                        clicked => { root.subs-page = 0; root.subs-sort-by("cycle"); } }
                                    // Both, side by side: a monthly figure is what
                                    // you feel and a yearly one is what you decide on.
                                    // One key behind them: they are the same number
                                    // divided by twelve, so sorting by either is the
                                    // same order and offering two would be a lie.
                                    HeadCell { label: "COST / MO"; w: root.subs-col; centre: true;
                                        sorted: root.subs-sort == "monthly"; desc: root.subs-desc;
                                        clicked => { root.subs-page = 0; root.subs-sort-by("monthly"); } }
                                    HeadCell { label: "COST / YR"; w: root.subs-col; centre: true;
                                        sorted: root.subs-sort == "yearly"; desc: root.subs-desc;
                                        clicked => { root.subs-page = 0; root.subs-sort-by("yearly"); } }
                                    HeadCell { label: "NEXT CHARGE"; w: root.subs-col; centre: true;
                                        sorted: root.subs-sort == "next"; desc: root.subs-desc;
                                        clicked => { root.subs-page = 0; root.subs-sort-by("next"); } }
                                    HeadCell { label: "PAYS FROM"; w: root.subs-col; centre: true;
                                        sorted: root.subs-sort == "account"; desc: root.subs-desc;
                                        clicked => { root.subs-page = 0; root.subs-sort-by("account"); } }
                                    HeadCell { label: "STATUS"; w: root.subs-col; centre: true;
                                        sorted: root.subs-sort == "status"; desc: root.subs-desc;
                                        clicked => { root.subs-page = 0; root.subs-sort-by("status"); } }
                                    HeadCell { label: "ACTIONS"; w: root.subs-col; centre: true;
                                        sortable: false; }
                                }
                            }
                            Rectangle { min-height: 1px; max-height: 1px;
                                background: FinTheme.hairline; }

                            if root.subs.length == 0: Blank {
                                title: root.subs-all == 0 ? "No subscriptions tracked"
                                                          : "Nothing in that filter";
                                body: root.subs-all == 0
                                    ? "A subscription is a fixed amount on a fixed cycle. Import a statement and the app will offer to set up the ones it can already see."
                                    : "Every subscription is in one of the other groups.";
                                icon: Icons.repeat;
                            }

                            // Only the current page is drawn. The whole list is in
                            // the model either way, so this is a question of what is
                            // on screen, not of what was loaded.
                            for s[i] in root.subs: srow := Rectangle {
                                property <bool> on-page:
                                    i >= root.subs-from && i < root.subs-from + root.subs-per-page;
                                // A row off the page collapses instead of hiding, so
                                // it takes no space in the column it is not part of.
                                min-height: srow.on-page ? 54px : 0px;
                                max-height: srow.on-page ? 54px : 0px;
                                visible: srow.on-page;
                                clip: true;
                                background: sta.has-hover ? FinTheme.card-2 : transparent;
                                // A paused or cancelled row is dimmed rather than
                                // hidden: it is still money committed until it is
                                // actually gone, and the totals say so.
                                opacity: s.status == "active" ? 1.0 : 0.55;
                                sta := TouchArea { }
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                                    // Position in the filtered list, not in the model:
                                    // the number answers "which row am I looking at",
                                    // and the list you are looking at is the filtered
                                    // one. It keeps counting across pages.
                                    Cell { text: "\{i + 1}"; w: root.subs-num;
                                        centre: true; dim: true; }
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: root.subs-name; max-width: root.subs-name;
                                        background: transparent; clip: true;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                // The service's own initial on its own
                                                // colour. There is no brand table behind
                                                // it and there should not be one: a
                                                // hardcoded list of logos is wrong within
                                                // a year and misses whatever the user
                                                // actually pays for.
                                                AccountBadge {
                                                    glyph: s.badge; hue: s.hue; side: 34px;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 1;
                                                spacing: 2px;
                                                Text { text: s.name; color: FinTheme.ink;
                                                    font-size: 13px; font-weight: 700;
                                                    overflow: elide; }
                                                Text {
                                                    // What the service charges under its
                                                    // own name. The price rise it used to
                                                    // carry is a state, not a price, and
                                                    // now lives in the status pill.
                                                    text: s.plan;
                                                    color: FinTheme.ink-dim;
                                                    font-size: 10.5px; overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: root.subs-col; max-width: root.subs-col;
                                        background: transparent; clip: true;
                                        if s.category != "": Pill {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            label: s.category; hue: s.cat-hue;
                                        }
                                    }
                                    Cell { text: s.cycle; w: root.subs-col; centre: true; dim: true; }
                                    Cell { text: s.monthly; w: root.subs-col; centre: true; strong: true; }
                                    Cell { text: s.yearly; w: root.subs-col; centre: true; dim: true; }
                                    Cell { text: s.next-short; w: root.subs-col; centre: true;
                                        dim: s.status != "active"; }
                                    Cell { text: s.account; w: root.subs-col; centre: true; dim: true; }
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: root.subs-col; max-width: root.subs-col;
                                        background: transparent; clip: true;
                                        // One pill, in priority order. A price rise
                                        // outranks Active because Active is the state
                                        // you already assumed.
                                        stp := Pill {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            dot: true;
                                            label: s.hike-pct > 0
                                                ? "Price ↑ \{s.hike-pct}%"
                                                : (s.status == "active"
                                                   ? (s.auto-post ? "Auto" : "Active")
                                                   : s.status);
                                            hue: s.hike-pct > 0 ? FinTheme.warn
                                               : s.status == "active" ? FinTheme.good
                                                                      : FinTheme.ink-dim;
                                        }
                                        // The pill is the price history's own handle —
                                        // it is what named the rise, so it is what opens
                                        // the record of it. Sized to the pill so the rest
                                        // of the column stays inert.
                                        if s.hike-pct > 0: TouchArea {
                                            x: stp.x; y: stp.y;
                                            width: stp.width; height: stp.height;
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.open-sheet("prices", s.id); }
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: root.subs-col; max-width: root.subs-col;
                                        background: transparent;
                                        HorizontalLayout {
                                            alignment: center; spacing: 3px;
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                IconBtn { icon: Icons.pencil; tip: "Edit";
                                                    clicked => { root.open-sheet("sub", s.id); } }
                                            }
                                            // On a removed row this is the way back
                                            // out: a bin you cannot take anything out of
                                            // is a delete button with a longer path.
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                IconBtn {
                                                    icon: s.status == "active" ? Icons.pause
                                                        : s.status == "removed" ? Icons.refresh-cw
                                                                                : Icons.play;
                                                    tip: s.status == "active" ? "Pause"
                                                       : s.status == "removed" ? "Put it back"
                                                                               : "Resume";
                                                    clicked => {
                                                        root.recur-status(s.id,
                                                            s.status == "active" ? "paused" : "active");
                                                    }
                                                }
                                            }
                                            // Two acts behind one glyph, and which one
                                            // you get is which list you are looking at:
                                            // from anywhere else the X files the row
                                            // under Removed, and only from Removed does
                                            // it delete. Nothing is destroyed from a
                                            // screen that was not showing you the bin.
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                IconBtn {
                                                    icon: Icons.x;
                                                    hue: s.status == "removed" ? FinTheme.bad
                                                                               : FinTheme.ink-dim;
                                                    tip: s.status == "removed"
                                                        ? "Delete for good" : "Remove";
                                                    clicked => {
                                                        root.subs-del = s;
                                                        root.subs-del-open = true;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px; width: parent.width;
                                    background: FinTheme.hairline;
                                }
                            }

                            // Footer: what is on screen out of what there is, and the
                            // pager. Shown even on a single page so the count of a
                            // filtered list is always readable.
                            if root.subs.length > 0: Rectangle {
                                min-height: 46px; max-height: 46px;
                                background: FinTheme.card-2;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px; spacing: 8px;
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 1;
                                        Text {
                                            text: "Showing \{root.subs-from + 1}–"
                                                + "\{Math.min(root.subs-from + root.subs-per-page, root.subs.length)}"
                                                + " of \{root.subs.length}";
                                            color: FinTheme.ink-dim; font-size: 11.5px;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 0;
                                        IconBtn {
                                            icon: Icons.chevron-left; tip: "Previous page";
                                            enabled: root.subs-pg > 0;
                                            clicked => { root.subs-page = root.subs-pg - 1; }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 0;
                                        Pill {
                                            label: "\{root.subs-pg + 1} of \{root.subs-pages}";
                                            hue: FinTheme.accent; h: 24px;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 0;
                                        IconBtn {
                                            icon: Icons.chevron-right; tip: "Next page";
                                            enabled: root.subs-pg < root.subs-pages - 1;
                                            clicked => { root.subs-page = root.subs-pg + 1; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ══ LENDING ═════════════════════════════════════════════════════
            if root.tab == "dues": ScrollView {
                property <int> watch: root.dues.length;
                changed watch => { self.viewport-y = 0; }
                init => { self.viewport-y = 0; }
                VerticalLayout {
                    alignment: start;
                    padding-right: 6px; spacing: 14px;

                    StatStrip { stats: root.due-stats; }

                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        FilterChip { label: "All"; count: root.dues-all; w: 128px;
                            on: root.dues-filter == "all";
                            clicked => { root.set-dues-filter("all"); } }
                        FilterChip { label: "Lent out"; count: root.dues-to-me; w: 128px;
                            on: root.dues-filter == "to-me";
                            clicked => { root.set-dues-filter("to-me"); } }
                        FilterChip { label: "Borrowed"; count: root.dues-i-owe; w: 128px;
                            on: root.dues-filter == "i-owe";
                            clicked => { root.set-dues-filter("i-owe"); } }
                        FilterChip { label: "Squared up"; count: root.dues-closed; w: 128px;
                            on: root.dues-filter == "closed";
                            clicked => { root.set-dues-filter("closed"); } }
                    }

                    Card {
                        clip: true;
                        VerticalLayout {
                            alignment: start;
                            padding: 0px; spacing: 0px;
                            Rectangle {
                                min-height: 36px; max-height: 36px;
                                background: FinTheme.card-2;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                                    HeadCell { label: "PERSON"; w: 150px; sortable: false; }
                                    HeadCell { label: "WHICH WAY"; w: 108px; sortable: false; }
                                    HeadCell { label: "NOTE"; flex: true; sortable: false; }
                                    HeadCell { label: "BACK SO FAR"; w: 104px; right: true;
                                        sortable: false; }
                                    HeadCell { label: "OUTSTANDING"; w: 92px; right: true;
                                        sortable: false; }
                                    HeadCell { label: "AMOUNT"; w: 104px; right: true;
                                        sortable: false; }
                                    HeadCell { label: ""; w: 132px; sortable: false; }
                                }
                            }
                            Rectangle { min-height: 1px; max-height: 1px;
                                background: FinTheme.hairline; }

                            if root.dues.length == 0: Blank {
                                title: root.dues-all == 0 ? "Nothing owed either way"
                                                          : "Nothing in that filter";
                                body: root.dues-all == 0
                                    ? "Money you have lent to or borrowed from a named person. Lending posts as a transfer, not as spending — it is still your money until you write it off."
                                    : "Everything here is in one of the other groups.";
                                icon: Icons.users;
                            }

                            for d in root.dues: drow := Rectangle {
                                min-height: 46px; max-height: 46px;
                                background: dta.has-hover ? FinTheme.card-2 : transparent;
                                opacity: d.status == "open" ? 1.0 : 0.6;
                                dta := TouchArea { }
                                property <color> hue: d.direction == "owed_to_me"
                                    ? FinTheme.good : FinTheme.bad;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px; spacing: 10px;
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: 150px; max-width: 150px;
                                        background: transparent; clip: true;
                                        HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                Tile {
                                                    size: 28px; hue: drow.hue;
                                                    icon: d.direction == "owed_to_me"
                                                        ? Icons.arrow-down : Icons.arrow-up;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 1;
                                                spacing: 1px;
                                                Text { text: d.person; color: FinTheme.ink;
                                                    font-size: 12.5px; font-weight: 600;
                                                    overflow: elide; }
                                                Text { text: "since " + d.opened;
                                                    color: FinTheme.ink-dim; font-size: 10px;
                                                    overflow: elide; }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: 108px; max-width: 108px;
                                        background: transparent; clip: true;
                                        Pill {
                                            x: 0; y: (parent.height - self.height) / 2;
                                            label: d.direction == "owed_to_me"
                                                ? "Lent out" : "Borrowed";
                                            hue: drow.hue;
                                        }
                                    }
                                    Cell { text: d.note; flex: true; dim: true; }
                                    // What has actually come back. The column that
                                    // makes a part-settled due readable: ₹1,000 of
                                    // ₹3,000 is a different thing from ₹2,000 owed.
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: 104px; max-width: 104px;
                                        background: transparent;
                                        Text {
                                            width: 100%;
                                            y: (parent.height - self.height) / 2;
                                            text: d.part-paid ? d.settled + " of " + d.original
                                                              : (d.status == "open" ? "—" : d.settled);
                                            color: d.part-paid ? FinTheme.good : FinTheme.ink-dim;
                                            font-size: 11px; horizontal-alignment: right;
                                            overflow: elide;
                                        }
                                    }
                                    Cell {
                                        text: d.status == "open" ? "\{d.age-days} days" : "—";
                                        w: 92px; right: true;
                                        // Six months and counting is worth noticing.
                                        ink: d.age-days >= 180 ? FinTheme.warn : FinTheme.ink-dim;
                                    }
                                    Cell {
                                        text: d.amount; w: 104px; right: true; strong: true;
                                        ink: drow.hue;
                                    }
                                    Rectangle {
                                        horizontal-stretch: 0;
                                        min-width: 132px; max-width: 132px;
                                        background: transparent;
                                        HorizontalLayout {
                                            alignment: end; spacing: 4px;
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                if d.status == "open": Btn {
                                                    label: "Settle"; h: 28px; primary: true;
                                                    clicked => { root.due-settle(d.id); }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                if d.status == "open": IconBtn {
                                                    icon: Icons.archive;
                                                    tip: "Write it off";
                                                    clicked => { root.due-write-off(d.id); }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                IconBtn { icon: Icons.x; tip: "Delete";
                                                    clicked => { root.due-delete(d.id); } }
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px; width: parent.width;
                                    background: FinTheme.hairline;
                                }
                            }
                        }
                    }

                    // Six months of closed dues, beside the open ones rather than
                    // behind a filter. The useful question about a person is
                    // whether this gets paid back, and that needs the history in
                    // view at the same time as the balance.
                    if root.dues-settled.length > 0: Card {
                        VerticalLayout {
                            alignment: start;
                            padding: 16px; spacing: 8px;
                            CardTitle {
                                title: "Squared up";
                                hint: "Paid back, paid off or written off — the last six months.";
                            }
                            for d in root.dues-settled: HorizontalLayout {
                                spacing: 10px;
                                Text { text: d.person; color: FinTheme.ink;
                                    font-size: 12px; font-weight: 600;
                                    vertical-alignment: center; min-width: 120px; }
                                Pill {
                                    label: d.status == "written_off" ? "written off"
                                         : d.direction == "owed_to_me" ? "They paid you back"
                                                                       : "You paid them back";
                                    hue: d.status == "written_off" ? FinTheme.warn
                                       : d.direction == "owed_to_me" ? FinTheme.good
                                                                     : FinTheme.ink-dim;
                                }
                                Text { text: d.note; color: FinTheme.ink-dim;
                                    font-size: 11.5px; vertical-alignment: center;
                                    horizontal-stretch: 1; overflow: elide; }
                                // How long it stayed open. The number that says
                                // whether a person is slow or simply forgetful.
                                Text {
                                    text: d.age-days > 0 ? "took \{d.age-days} days" : "";
                                    color: FinTheme.ink-dim; font-size: 11px;
                                    vertical-alignment: center; min-width: 110px;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    text: d.amount; color: FinTheme.ink;
                                    font-size: 12px; font-weight: 700;
                                    vertical-alignment: center; min-width: 100px;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                    }

                    // The one thing this tab must not do.
                    Text {
                        text: "Shown separately and never subtracted: what you are owed is not cash you have, and what you owe is not spending you have done.";
                        color: FinTheme.ink-dim; font-size: 11px; wrap: word-wrap;
                    }
                }
            }

            // ══ ACCOUNTS ════════════════════════════════════════════════════
            if root.tab == "accounts": ScrollView {
                property <int> watch: root.accounts.length + root.loans.length;
                changed watch => { self.viewport-y = 0; }
                init => { self.viewport-y = 0; }
                acol := VerticalLayout {
                    alignment: start;
                    padding-right: 6px; spacing: 12px;

                    // One height for every card on the tab, accounts and loans
                    // alike, taken from the fullest card there is — a credit
                    // card, which carries the whole stack: header, balance,
                    // utilisation bar, five detail rows and a row of buttons.
                    // Sizing each card to its own content made a grid of ragged
                    // rows, and sizing them square made them enormous.
                    //
                    // pad(32) + head(32) + balance(26) + note and bar(22)
                    //  + five rows(150) + buttons(26) + seven gaps(49) = 337,
                    // rounded up to clear the loan card, whose extra progress
                    // line needs another sixteen.
                    property <length> card-h: 356px;

                    // The same strip every other tab opens with, in place of the
                    // walk that used to sit at the very bottom of this one. The
                    // figures were being printed below three screens of accounts,
                    // which is the last place anyone looks for a total.
                    //
                    // The cards are also the tab's filter. Lending is the one that
                    // is not a filter at all — the money is on another tab, so the
                    // card goes there rather than pretending to narrow this grid.
                    StatStrip {
                        stats: root.account-stats;
                        picked(what) => {
                            if (what == "acct:lending") { root.set-tab("dues"); }
                            else if (what == "acct:all") { root.set-account-filter(""); }
                            else if (what == "acct:cash") { root.set-account-filter("cash"); }
                            else if (what == "acct:cards") { root.set-account-filter("cards"); }
                            else if (what == "acct:loans") { root.set-account-filter("loans"); }
                        }
                    }

                    // Only when one is on. A permanent "showing everything" row is a
                    // row that says nothing on the screen it is most often seen.
                    if root.account-filter != "": HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Pill {
                                hue: FinTheme.accent; h: 26px; dot: true;
                                label: root.account-filter == "cash" ? "Bank, cash and wallets only"
                                     : root.account-filter == "cards" ? "Cards only"
                                     : "Loans only";
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Btn { label: "Show everything"; h: 26px;
                            clicked => { root.set-account-filter(""); } }
                    }

                    if root.account-filter != "loans": HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Pill { label: "LIQUID · " + root.liquid-total;
                                   hue: FinTheme.accent; h: 28px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }

                    // A card each rather than one row each, and side by side
                    // rather than stacked. Every kind of account has a different
                    // interesting fact under its balance — a reconcile, a
                    // statement, a drift, a top-up — so a table would have to
                    // show all four columns for all four kinds, mostly blank;
                    // and one full-width row per account fits three on a screen.
                    agrid := Rectangle {
                        horizontal-stretch: 1;
                        property <int> cols: self.width < 480px ? 1
                                           : self.width < 760px ? 2 : 3;
                        property <length> gap: 18px;
                        property <length> cardw: (self.width - (cols - 1) * gap) / cols;
                        property <length> cardh: acol.card-h;
                        height: Math.ceil(root.accounts.length / cols) * (cardh + gap);
                        for a[ai] in root.accounts: Rectangle {
                            x: Math.mod(ai, agrid.cols) * (agrid.cardw + agrid.gap);
                            y: Math.floor(ai / agrid.cols) * (agrid.cardh + agrid.gap);
                            width: agrid.cardw; height: agrid.cardh;
                            border-radius: Surface.rr(14px, self.width, self.height);
                            background: FinTheme.card;
                            border-width: 1px;
                            border-color: acta.has-hover ? FinTheme.accent.with-alpha(0.55)
                                                         : FinTheme.hairline;
                            opacity: a.closed ? 0.55 : 1.0;
                            clip: true;
                            animate border-color { duration: 120ms; easing: ease-out; }
                            // Declared first so the buttons below sit on top of it
                            // and keep their own clicks.
                            acta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.detail-account = a; root.detail-loan-open = false;
                                             root.detail-open = true; }
                            }
                            VerticalLayout {
                                alignment: start;
                                padding: 16px; spacing: 7px;

                                HorizontalLayout {
                                    spacing: 9px;
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 0;
                                        AccountBadge { glyph: a.badge; hue: a.hue; }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 1; spacing: 1px;
                                        HorizontalLayout {
                                            spacing: 6px; alignment: start;
                                            Text { text: a.name; color: FinTheme.ink;
                                                font-size: 12.5px; font-weight: 700;
                                                overflow: elide;
                                                vertical-alignment: center; }
                                            if a.kind == "virtual": Pill {
                                                label: "holding"; hue: FinTheme.ink-dim; }
                                            if a.closed: Pill {
                                                label: "closed"; hue: FinTheme.ink-dim; }
                                        }
                                        Text { text: a.sub; color: FinTheme.ink-dim;
                                            font-size: 10.5px; overflow: elide; }
                                    }
                                }

                                // Its own line, left-aligned under the name: in a
                                // column this narrow a balance pinned to the right
                                // of the header collides with the name.
                                Text {
                                    text: a.balance;
                                    color: a.negative ? FinTheme.bad : FinTheme.ink;
                                    font-size: 19px; font-weight: 800;
                                    overflow: elide;
                                }

                                // A card's headroom, drawn rather than stated:
                                // "9.5%" and a bar nearly empty say the same
                                // thing, and only one of them is read at speed.
                                if a.limit-note != "": VerticalLayout {
                                    spacing: 3px;
                                    Text { text: a.limit-note; color: FinTheme.ink-dim;
                                        font-size: 10.5px; overflow: elide; }
                                    Bar {
                                        pct: a.util-pct; thickness: 5px;
                                        hue: a.util-pct >= 70 ? FinTheme.warn
                                                              : FinTheme.accent;
                                    }
                                }

                                if a.lent != "": KvRow {
                                    kv: { label: "Lent out", value: a.lent,
                                          tone: "ok", strong: false };
                                }
                                if a.borrowed != "": KvRow {
                                    kv: { label: "Borrowed", value: a.borrowed,
                                          tone: "warn", strong: false };
                                }
                                if a.reconciled != "": KvRow {
                                    kv: { label: "Balance", value: a.reconciled,
                                          tone: "flat", strong: false };
                                }
                                if a.in-month != "": KvRow {
                                    kv: { label: "In this month", value: a.in-month,
                                          tone: "ok", strong: false };
                                }
                                if a.out-month != "": KvRow {
                                    kv: { label: "Out this month", value: a.out-month,
                                          tone: "flat", strong: false };
                                }
                                if a.statement != "": KvRow {
                                    kv: { label: "Statement", value: a.statement,
                                          tone: "flat", strong: false };
                                }
                                if a.minimum-due != "": KvRow {
                                    kv: { label: "Minimum due", value: a.minimum-due,
                                          tone: "flat", strong: false };
                                }
                                if a.drift != "": KvRow {
                                    kv: { label: "Last count was out by",
                                          value: a.drift,
                                          tone: a.drift-bad ? "warn" : "ok",
                                          strong: false };
                                }
                                if a.topped-from != "": KvRow {
                                    kv: { label: "Topped up from", value: a.topped-from,
                                          tone: "flat", strong: false };
                                }
                                if a.last-topup != "": KvRow {
                                    kv: { label: "Last top-up", value: a.last-topup,
                                          tone: "flat", strong: false };
                                }

                                // The one thing each kind of account actually
                                // needs doing to it, named the way the act is
                                // named: a wallet is counted, not reconciled.
                                if a.kind == "cash": Text {
                                    text: "Cash always drifts. A recount sets the balance and books the gap.";
                                    color: FinTheme.ink-dim; font-size: 10px;
                                    wrap: word-wrap;
                                }
                                if a.kind == "wallet": Text {
                                    text: "Top-ups are transfers, not spending. Only what leaves the wallet counts.";
                                    color: FinTheme.ink-dim; font-size: 10px;
                                    wrap: word-wrap;
                                }
                                if a.kind == "virtual": Text {
                                    text: "Lending is not spending. Money moves here when a due opens and comes back when it settles.";
                                    color: FinTheme.ink-dim; font-size: 10px;
                                    wrap: word-wrap;
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }
                                HorizontalLayout {
                                    spacing: 5px; alignment: start;
                                    if a.kind == "cash": Btn {
                                        label: "Recount"; h: 26px;
                                        clicked => { root.account-recount(a.id); } }
                                    if a.kind != "cash" && a.kind != "virtual": Btn {
                                        label: "Reconcile"; h: 26px;
                                        clicked => { root.account-reconcile(a.id); } }
                                    if a.kind == "card" && a.negative: Btn {
                                        label: "Pay it off"; h: 26px;
                                        clicked => { root.account-pay-card(a.id); } }
                                    if a.kind != "virtual": Btn {
                                        label: "Edit"; h: 26px;
                                        clicked => { root.open-sheet("account", a.id); } }
                                    if a.kind != "virtual" && a.txn-count == 0: IconBtn {
                                        icon: Icons.x;
                                        clicked => { root.account-delete(a.id); } }
                                }
                            }
                        }
                    }

                    if root.account-filter == "" || root.account-filter == "loans": HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Pill { label: root.loans.length == 0 ? "LOANS"
                                        : "LOANS · " + root.loans-total + " OUTSTANDING";
                                   hue: FinTheme.bad; h: 28px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    if root.loans.length == 0 && root.account-filter != "cash"
                        && root.account-filter != "cards": Text {
                        text: "No loans tracked.";
                        color: FinTheme.ink-dim; font-size: 12.5px;
                    }
                    lgrid := Rectangle {
                        horizontal-stretch: 1;
                        property <int> cols: self.width < 480px ? 1
                                           : self.width < 760px ? 2 : 3;
                        property <length> gap: 18px;
                        property <length> cardw: (self.width - (cols - 1) * gap) / cols;
                        property <length> cardh: acol.card-h;
                        // Collapsed rather than hidden by an `if`: the grid places its
                        // cards by index off its own size, so a wrapper it could be
                        // conditional inside would have to repeat all of that.
                        property <bool> off: root.account-filter == "cash"
                                          || root.account-filter == "cards";
                        clip: true;
                        height: self.off ? 0px
                            : Math.ceil(root.loans.length / cols) * (cardh + gap);
                        for l[li] in root.loans: Rectangle {
                            x: Math.mod(li, lgrid.cols) * (lgrid.cardw + lgrid.gap);
                            y: Math.floor(li / lgrid.cols) * (lgrid.cardh + lgrid.gap);
                            width: lgrid.cardw; height: lgrid.cardh;
                            border-radius: Surface.rr(14px, self.width, self.height);
                            background: FinTheme.card;
                            border-width: 1px;
                            border-color: lcta.has-hover ? FinTheme.accent.with-alpha(0.55)
                                                         : FinTheme.hairline;
                            clip: true;
                            animate border-color { duration: 120ms; easing: ease-out; }
                            lcta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.detail-loan = l; root.detail-loan-open = true;
                                             root.detail-open = true; }
                            }
                            VerticalLayout {
                                alignment: start;
                                padding: 16px; spacing: 6px;
                                HorizontalLayout {
                                    spacing: 9px;
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 0;
                                        AccountBadge { glyph: l.badge; hue: l.hue; }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 1; spacing: 1px;
                                        Text { text: l.name; color: FinTheme.ink;
                                            font-size: 12.5px; font-weight: 700;
                                            overflow: elide; }
                                        Text { text: l.rate; color: FinTheme.ink-dim;
                                            font-size: 10.5px; overflow: elide; }
                                    }
                                }
                                Text {
                                    text: l.balance; color: FinTheme.bad;
                                    font-size: 19px; font-weight: 800;
                                    overflow: elide;
                                }
                                Text {
                                    text: "\{l.progress-pct}% repaid · "
                                          + "\{l.remaining-months} of "
                                          + "\{l.tenure-months} left";
                                    color: FinTheme.ink-dim; font-size: 10.5px;
                                    overflow: elide;
                                }
                                Bar { pct: l.progress-pct; hue: FinTheme.accent; toned: false; }
                                KvRow {
                                    kv: { label: "EMI", value: l.emi,
                                          tone: "flat", strong: false };
                                }

                                // How the next instalment divides. The number
                                // that answers "I have paid this for five
                                // years, why has it barely moved".
                                if l.emi-principal != "": KvRow {
                                    kv: { label: "This EMI · principal",
                                          value: l.emi-principal, tone: "ok",
                                          strong: false };
                                }
                                if l.emi-interest != "": KvRow {
                                    kv: { label: "This EMI · interest",
                                          value: l.emi-interest,
                                          tone: l.interest-free ? "flat" : "warn",
                                          strong: false };
                                }
                                if l.closes != "": KvRow {
                                    kv: { label: "Closes", value: l.closes,
                                          tone: "flat", strong: false };
                                }
                                if l.interest-left != "": KvRow {
                                    kv: { label: "Interest left",
                                          value: l.interest-left,
                                          tone: l.interest-free ? "ok" : "bad",
                                          strong: false };
                                    rule: false;
                                }

                                Rectangle { vertical-stretch: 1; background: transparent; }
                                HorizontalLayout {
                                    spacing: 5px; alignment: start;
                                    Btn { label: "Schedule"; h: 26px;
                                        clicked => { root.loan-schedule(l.account-id); } }
                                    Btn { label: "Prepay?"; h: 26px;
                                        clicked => { root.loan-prepay(l.account-id); } }
                                }
                            }
                        }
                    }

                }
            }

            // ══ PLANNING · DASHBOARD ════════════════════════════════════════
            // Overview says what happened. Transactions says where. Accounts
            // says where the money is. This says what to do next, and every
            // block on it is a decision, a prediction or a button — a figure
            // with none of the three belongs on Overview, which already has it.
            //
            // One long scroll rather than four tabs, in the order the questions
            // occur to someone: can I afford this month, what is coming, what
            // needs me, am I inside my envelopes, where does this end up, and
            // am I getting better at it.
            if root.tab == "planning": dashsv := ScrollView {
                property <int> watch: root.timeline.length + root.attention.length
                    + root.predictions.length + root.budgets.length;
                changed watch => { self.viewport-y = 0; }
                init => { self.viewport-y = 0; }
                // Pinned, not left to grow. A Flickable sizes its viewport to
                // what the content would like to be, and one un-wrapping line of
                // text anywhere in this page asks for more than the window has —
                // at which point every full-width card is laid out against that
                // wider viewport and runs off the right edge. The page scrolls
                // one way only, so the viewport is exactly the visible width.
                viewport-width: self.visible-width;
                dash := VerticalLayout {
                    alignment: start;
                    // 14px of this is the scrollbar, which is drawn over the
                    // right edge of the viewport rather than beside it, and 6px
                    // is the gutter that keeps a card from touching it.
                    padding-right: 20px; spacing: 14px;

                    // What a row on this page actually has to fill, measured off
                    // the scroll view rather than worked out from the page width.
                    // Four cards and three gaps add up to exactly this, so an
                    // estimate that is one scrollbar out does not shrink the
                    // fourth card — it takes its right edge off the screen.
                    property <length> avail: Math.max(360px, dashsv.visible-width - 20px);
                    property <length> quarter: (self.avail - 3 * 12px) / 4;
                    property <length> halfw: (self.avail - 14px) / 2;
                    property <int> proj-n: Math.max(1, root.projection.length);
                    property <length> proj-w:
                        (self.avail - 12px * (self.proj-n - 1)) / self.proj-n;

                    // ── the month this page is about ─────────────────────────
                    Card {
                        HorizontalLayout {
                            padding: 16px; spacing: 12px;
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Rectangle {
                                    width: 40px; height: 40px;
                                    border-radius: Surface.rr(13px, self.width, self.height);
                                    background: FinTheme.accent-grad;
                                    AppIcon {
                                        source: Icons.calendar-clock;
                                        tint: FinTheme.on-accent;
                                        width: 20px; height: 20px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 2px; horizontal-stretch: 1;
                                Text { text: "Planning"; color: FinTheme.ink;
                                    font-size: 17px; font-weight: 800; }
                                Text {
                                    text: "Plan smarter. Spend better. Build wealth.";
                                    color: FinTheme.ink-dim; font-size: 12px;
                                }
                            }
                            // One control, not four. The month this page is
                            // about is the only thing the header decides, so it
                            // gets the room the three jump chips were using —
                            // and the year, which used to live on Plan, opens
                            // the same calendar the timeline does.
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                HorizontalLayout {
                                    spacing: 8px; alignment: end;
                                    IconBtn { icon: Icons.chevron-left;
                                        clicked => { root.plan-step(-1); } }
                                    Text {
                                        text: root.cal-label; color: FinTheme.ink;
                                        font-size: 18px; font-weight: 800;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                        min-width: 176px;
                                    }
                                    IconBtn { icon: Icons.chevron-right;
                                        clicked => { root.plan-step(1); } }
                                    FilterChip {
                                        label: "Year"; w: 74px;
                                        on: root.cal-view == "year";
                                        clicked => {
                                            root.set-cal-view("year");
                                            root.plan-modal = "calendar";
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── can I afford this month ──────────────────────────────
                    // Four cards, always four: what have I got, where does it
                    // close, how much am I keeping — and then the verdict on the
                    // three, which is last because it is a reading of them.
                    HorizontalLayout {
                        spacing: 12px;
                        for s[i] in root.plan-health: PlanCard {
                            width: dash.quarter;
                            stat: s;
                            icon: i == 0 ? Icons.wallet
                                : i == 1 ? Icons.trending-up
                                : i == 2 ? Icons.pie-chart
                                         : Icons.square-check;
                            hue: i == 0 ? #f472b6
                               : i == 1 ? #38bdf8
                               : i == 2 ? #a78bfa
                                        : FinTheme.good;
                        }
                    }

                    // ── where the month's income is spoken for ────────────────
                    // One income, three claims on it. Committed is dated and not
                    // up for discussion, envelopes are the part actually being
                    // steered, and free is the only part a decision can still be
                    // made about — which is why it is a slice and not a leftover.
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Cash flow this month"; color: FinTheme.ink;
                                    font-size: 13.5px; font-weight: 700;
                                    vertical-alignment: center; horizontal-stretch: 1; }
                                Btn {
                                    label: "The full statement"; h: 28px;
                                    clicked => { root.plan-modal = "flow"; }
                                }
                            }
                            Rectangle {
                                height: 18px;
                                border-radius: Surface.rr(9px, self.width, self.height);
                                background: FinTheme.pill-bg;
                                clip: true;
                                fixed := Rectangle {
                                    x: 0;
                                    width: parent.width * root.fixed-pct / 100;
                                    height: parent.height;
                                    background: @linear-gradient(90deg, #f472b6, #fb923c);
                                }
                                planned := Rectangle {
                                    x: fixed.width;
                                    width: parent.width * root.budget-allocated-pct / 100;
                                    height: parent.height;
                                    background: FinTheme.accent-grad;
                                }
                                Rectangle {
                                    x: fixed.width + planned.width;
                                    width: parent.width * root.plan-free-pct / 100;
                                    height: parent.height;
                                    background: #38bdf8;
                                }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                for k in [
                                    { c: #16a34a, t: "Income", v: root.budget-income,
                                      p: 100, n: "What came in this month." },
                                    { c: #f472b6, t: "Committed", v: root.fixed-total,
                                      p: root.fixed-pct,
                                      n: "Loans, bills and subscriptions. Dated, not decided." },
                                    { c: FinTheme.accent, t: "Planned", v: root.budget-allocated,
                                      p: root.budget-allocated-pct,
                                      n: "Envelopes — the part of the month you steer." },
                                    { c: #38bdf8, t: "Free to use", v: root.plan-free,
                                      p: root.plan-free-pct,
                                      n: "What is left after the two above it. Not saved — just not spoken for yet." },
                                ]: HorizontalLayout {
                                    spacing: 8px; horizontal-stretch: 1;
                                    VerticalLayout {
                                        alignment: start; horizontal-stretch: 0;
                                        padding-top: 4px;
                                        Rectangle {
                                            width: 10px; height: 10px;
                                            border-radius: Surface.rr(3px, self.width, self.height);
                                            background: k.c;
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px; horizontal-stretch: 1;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            Text { text: k.t; color: FinTheme.ink-dim;
                                                font-size: 11px; font-weight: 700;
                                                horizontal-stretch: 0;
                                                vertical-alignment: center; }
                                            Text { text: "\{k.p}%"; color: FinTheme.ink-dim;
                                                font-size: 11px; horizontal-stretch: 1;
                                                vertical-alignment: center; }
                                        }
                                        Text { text: k.v == "" ? "—" : k.v;
                                            color: FinTheme.ink; font-size: 13px;
                                            font-weight: 800; }
                                        Text { text: k.n; color: FinTheme.ink-dim;
                                            font-size: 11px; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }

                    // ── what is coming ───────────────────────────────────────
                    // The calendar written as one line of time. The grid behind
                    // any of these cards answers "which day"; this answers "in
                    // what order", which is the question you have when deciding
                    // whether the 8th survives until the 15th.
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "When money moves"; color: FinTheme.ink;
                                    font-size: 13.5px; font-weight: 700;
                                    vertical-alignment: center; horizontal-stretch: 0; }
                                for l in [
                                    { t: "Income", c: #16a34a },
                                    { t: "Bills & EMIs", c: #f472b6 },
                                    { t: "Subscriptions", c: #a78bfa },
                                    { t: "Other", c: #94a3b8 },
                                ]: HorizontalLayout {
                                    spacing: 6px; horizontal-stretch: 0;
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 0;
                                        Rectangle {
                                            width: 8px; height: 8px;
                                            border-radius: 4px;
                                            background: l.c;
                                        }
                                    }
                                    Text { text: l.t; color: FinTheme.ink-dim;
                                        font-size: 11px; vertical-alignment: center; }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text {
                                    text: "Any day opens it on the calendar";
                                    color: FinTheme.ink-dim; font-size: 11px;
                                    vertical-alignment: center; horizontal-stretch: 0;
                                }
                            }
                            if root.timeline.length == 0: Text {
                                text: "Nothing is dated in this month — no bill, no subscription, no credit.";
                                color: FinTheme.ink-dim; font-size: 12.5px;
                            }
                            // Scrolls sideways rather than shrinking: a month
                            // with fourteen dated days is not a month with
                            // fourteen narrower days.
                            if root.timeline.length > 0: ScrollView {
                                height: 106px;
                                viewport-width: root.timeline.length * 152px;
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    for e in root.timeline: ev := Card {
                                        width: 140px;
                                        background: e.closing
                                            ? e.hue.with-alpha(FinTheme.light ? 0.10 : 0.14)
                                            : (eta.has-hover ? FinTheme.card-2 : FinTheme.card);
                                        border-color: e.closing
                                            ? e.hue.with-alpha(0.4)
                                            : (eta.has-hover ? e.hue.with-alpha(0.5)
                                                             : FinTheme.hairline);
                                        animate background, border-color { duration: 110ms; }
                                        eta := TouchArea {
                                            enabled: !e.closing && e.idx >= 0;
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.plan-day = e.day;
                                                root.plan-sel = root.cal-days[e.idx];
                                                // Month view, whatever the year
                                                // button last left it on: this
                                                // click picked a day, and a day
                                                // is not on the year grid.
                                                root.set-cal-view("month");
                                                root.plan-modal = "calendar";
                                            }
                                        }
                                        VerticalLayout {
                                            padding: 12px; spacing: 6px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Rectangle {
                                                    width: 26px; height: 26px;
                                                    border-radius: 13px;
                                                    background: e.hue;
                                                    horizontal-stretch: 0;
                                                    Text {
                                                        text: e.day;
                                                        color: #ffffff;
                                                        font-size: 11.5px; font-weight: 800;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1;
                                                    background: transparent; }
                                            }
                                            Text {
                                                text: e.name; color: FinTheme.ink;
                                                font-size: 12px; font-weight: 600;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: e.amount;
                                                color: e.income ? FinTheme.good : FinTheme.ink;
                                                font-size: 13px; font-weight: 800;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── what needs you ───────────────────────────────────────
                    // Dated things that are late or nearly so, and the flags
                    // that carry an alarm. One list: they are one question, and
                    // two lists asking it would leave the merging to the reader.
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "What needs attention"; color: FinTheme.ink;
                                    font-size: 13.5px; font-weight: 700;
                                    vertical-alignment: center; horizontal-stretch: 1; }
                                if root.attention.length > 0: Pill {
                                    label: "\{root.attention.length}"; hue: FinTheme.warn; }
                            }
                            if root.attention.length == 0: Text {
                                text: "Nothing is late and nothing is about to be. This month is quiet.";
                                color: FinTheme.ink-dim; font-size: 12.5px;
                            }
                            if root.attention.length > 0: ScrollView {
                                height: 134px;
                                viewport-width: root.attention.length
                                    * (dash.quarter + 12px);
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    for a in root.attention: ac := Card {
                                        width: dash.quarter;
                                        property <color> hue: a.severity == "bad"
                                            ? FinTheme.bad : FinTheme.warn;
                                        background: ac.hue.with-alpha(FinTheme.light ? 0.07 : 0.10);
                                        border-color: ac.hue.with-alpha(0.3);
                                        VerticalLayout {
                                            padding: 14px; spacing: 6px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                VerticalLayout {
                                                    alignment: start; horizontal-stretch: 0;
                                                    Rectangle {
                                                        width: 24px; height: 24px;
                                                        border-radius: Surface.rr(8px, self.width, self.height);
                                                        background: ac.hue.with-alpha(0.18);
                                                        AppIcon {
                                                            source: a.severity == "bad"
                                                                ? Icons.bell : Icons.clock;
                                                            tint: ac.hue;
                                                            width: 13px; height: 13px;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                        }
                                                    }
                                                }
                                                Text {
                                                    text: a.title; color: ac.hue;
                                                    font-size: 12.5px; font-weight: 700;
                                                    wrap: word-wrap; horizontal-stretch: 1;
                                                }
                                            }
                                            Text {
                                                text: a.detail; color: FinTheme.ink-dim;
                                                font-size: 11.5px; wrap: word-wrap;
                                                vertical-stretch: 1;
                                            }
                                            if a.action-label != "": HorizontalLayout {
                                                alignment: start;
                                                Btn { label: a.action-label; h: 28px;
                                                    clicked => { root.flag-action(a.action); } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── am I inside my envelopes ─────────────────────────────
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Envelopes"; color: FinTheme.ink;
                                    font-size: 13.5px; font-weight: 700;
                                    vertical-alignment: center; horizontal-stretch: 0; }
                                Text {
                                    text: root.budget-allocated == ""
                                        ? "nothing set this month"
                                        : root.envelopes-spent + " of " + root.budget-allocated;
                                    color: FinTheme.ink-dim; font-size: 11.5px;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }
                                Btn { label: "Manage envelopes"; h: 28px;
                                    clicked => { root.plan-modal = "budgets"; } }
                            }
                            // Seven a row, wrapping onto a second. Sideways
                            // scrolling hid envelopes behind an edge — the eighth
                            // one existed only if you thought to drag — and the
                            // whole point of the block is that you can see all of
                            // them at once and tell which is the one in trouble.
                            envg := VerticalLayout {
                                spacing: 10px;
                                // The add tile is the last cell, so it wraps with
                                // the rest instead of being pinned anywhere.
                                property <int> cells: root.budgets.length + 1;
                                property <int> rows: Math.ceil(self.cells / 7);
                                property <length> cellw:
                                    (dash.avail - 32px - 6 * 10px) / 7;
                                for r in envg.rows: HorizontalLayout {
                                    spacing: 10px; alignment: start;
                                    for c in 7: cell := Rectangle {
                                        property <int> idx: r * 7 + c;
                                        width: envg.cellw;
                                        height: 124px;
                                        background: transparent;
                                        // Tail cells on the last row: laid out so
                                        // a short row still aligns with a full one,
                                        // drawn as nothing.
                                        if cell.idx < root.budgets.length: bc := Card {
                                            property <FinBudgetRow> b:
                                                root.budgets[cell.idx];
                                            background: envta.has-hover
                                                ? FinTheme.card : FinTheme.card-2;
                                            border-color: envta.has-hover
                                                ? FinTheme.accent.with-alpha(0.5)
                                                : FinTheme.hairline;
                                            animate background, border-color
                                                { duration: 110ms; }
                                            // The card is the way in. A "Set one"
                                            // button on the empty ones and nothing
                                            // on the rest meant the envelope you
                                            // wanted to change was the one you
                                            // could not click.
                                            envta := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => {
                                                    root.open-sheet("budget",
                                                        bc.b.category-id);
                                                }
                                            }
                                            VerticalLayout {
                                                padding: 12px; spacing: 5px;
                                                Text { text: bc.b.name; color: FinTheme.ink;
                                                    font-size: 12px; font-weight: 700;
                                                    overflow: elide; }
                                                Text {
                                                    text: bc.b.unset
                                                        ? bc.b.spent + " spent"
                                                        : (bc.b.over
                                                           ? bc.b.remaining + " over"
                                                           : bc.b.remaining + " left");
                                                    color: bc.b.over
                                                        ? FinTheme.bad : FinTheme.ink;
                                                    font-size: 13.5px; font-weight: 800;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: bc.b.unset ? "no envelope set"
                                                                     : "of " + bc.b.budget;
                                                    color: FinTheme.ink-dim;
                                                    font-size: 10.5px;
                                                    overflow: elide;
                                                    vertical-stretch: 1;
                                                }
                                                if !bc.b.unset: HorizontalLayout {
                                                    spacing: 6px;
                                                    Bar {
                                                        pct: bc.b.used-pct;
                                                        hue: bc.b.off-pace
                                                            ? FinTheme.warn
                                                            : FinTheme.accent;
                                                    }
                                                    Text { text: "\{bc.b.used-pct}%";
                                                        color: FinTheme.ink-dim;
                                                        font-size: 10.5px;
                                                        horizontal-stretch: 0;
                                                        vertical-alignment: center; }
                                                }
                                                if bc.b.unset: Text {
                                                    text: "Click to set one";
                                                    color: FinTheme.accent;
                                                    font-size: 10.5px; font-weight: 700;
                                                }
                                            }
                                        }
                                        if cell.idx == root.budgets.length: add := Card {
                                            background: transparent;
                                            border-color: addta.has-hover
                                                ? FinTheme.accent.with-alpha(0.55)
                                                : FinTheme.hairline;
                                            addta := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.open-sheet("budget", 0); }
                                            }
                                            VerticalLayout {
                                                alignment: center; spacing: 8px;
                                                padding: 12px;
                                                Rectangle {
                                                    width: 28px; height: 28px;
                                                    border-radius: Surface.rr(9px, self.width, self.height);
                                                    background: FinTheme.accent.with-alpha(0.16);
                                                    x: (parent.width - self.width) / 2;
                                                    AppIcon {
                                                        source: Icons.plus;
                                                        tint: FinTheme.accent;
                                                        width: 14px; height: 14px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }
                                                Text {
                                                    text: "Add envelope";
                                                    color: FinTheme.ink-dim;
                                                    font-size: 11.5px; font-weight: 700;
                                                    horizontal-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── what will happen if this carries on ──────────────────
                    // Each envelope's own pace, carried to the day it runs out.
                    // Straight-line arithmetic, and said so: it is a warning
                    // about the pace, not a claim about the future.
                    Card {
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "Spending predictions"; color: FinTheme.ink;
                                    font-size: 13.5px; font-weight: 700;
                                    vertical-alignment: center; horizontal-stretch: 1; }
                                Text {
                                    text: "At the pace each envelope is going";
                                    color: FinTheme.ink-dim; font-size: 11px;
                                    vertical-alignment: center; horizontal-stretch: 0;
                                }
                            }
                            if root.predictions.length == 0: Text {
                                text: "Spend from an envelope for a few days and this will say when it runs out.";
                                color: FinTheme.ink-dim; font-size: 12.5px;
                            }
                            if root.predictions.length > 0: ScrollView {
                                height: 132px;
                                viewport-width: root.predictions.length
                                    * (dash.quarter + 12px);
                                HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    for p in root.predictions: pc := Card {
                                        width: dash.quarter;
                                        background: p.soon
                                            ? p.hue.with-alpha(FinTheme.light ? 0.07 : 0.10)
                                            : FinTheme.card;
                                        border-color: p.soon ? p.hue.with-alpha(0.3)
                                                             : FinTheme.hairline;
                                        VerticalLayout {
                                            padding: 14px; spacing: 4px;
                                            Text { text: p.name; color: FinTheme.ink;
                                                font-size: 12.5px; font-weight: 700;
                                                overflow: elide; }
                                            Text {
                                                text: p.soon ? "Runs out" : "Lasts past";
                                                color: FinTheme.ink-dim; font-size: 11px;
                                            }
                                            Text {
                                                text: p.finish;
                                                color: p.soon ? p.hue : FinTheme.ink;
                                                font-size: 13.5px; font-weight: 800;
                                                overflow: elide;
                                            }
                                            // The days themselves, each a share
                                            // of this envelope's own worst one.
                                            HorizontalLayout {
                                                spacing: 1px; vertical-stretch: 1;
                                                for pt in p.points: Rectangle {
                                                    horizontal-stretch: 1;
                                                    background: transparent;
                                                    Rectangle {
                                                        y: parent.height - self.height;
                                                        width: parent.width;
                                                        height: Math.max(1px,
                                                            parent.height * pt / 100);
                                                        border-radius: 1px;
                                                        background: p.hue.with-alpha(
                                                            pt > 0 ? 0.85 : 0.18);
                                                    }
                                                }
                                            }
                                            Text {
                                                text: p.note; color: FinTheme.ink-dim;
                                                font-size: 10.5px; overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── where this month leads ───────────────────────────────
                    if root.projection.length > 0: Card {
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "If nothing changes"; color: FinTheme.ink;
                                    font-size: 13.5px; font-weight: 700;
                                    vertical-alignment: center; horizontal-stretch: 1; }
                                Text {
                                    text: "An average of what has happened, carried forward.";
                                    color: FinTheme.ink-dim; font-size: 11px;
                                    vertical-alignment: center; horizontal-stretch: 0;
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                for p in root.projection: prc := Card {
                                    width: dash.proj-w;
                                    background: FinTheme.card-2;
                                    property <color> tone: p.tone == "bad" ? FinTheme.bad
                                        : p.tone == "warn" ? FinTheme.warn
                                        : p.tone == "ok" ? FinTheme.good : FinTheme.ink;
                                    VerticalLayout {
                                        padding: 14px; spacing: 5px;
                                        Text { text: p.label; color: FinTheme.ink-dim;
                                            font-size: 11px; wrap: word-wrap; }
                                        Text { text: p.value; color: prc.tone;
                                            font-size: 17px; font-weight: 800;
                                            overflow: elide; }
                                    }
                                }
                            }
                            if root.projection-note != "": Text {
                                text: root.projection-note;
                                color: FinTheme.ink-dim; font-size: 11.5px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ── am I getting better at this ──────────────────────────
                    // Six months of one metric beside four habits. Both are
                    // about direction rather than about this month, which is
                    // why they sit together and below everything actionable.
                    HorizontalLayout {
                        spacing: 14px;

                        Card {
                            width: dash.halfw;
                            height: 268px;
                            VerticalLayout {
                                padding: 16px; spacing: 10px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Six month trends"; color: FinTheme.ink;
                                        font-size: 13.5px; font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1; }
                                    Btn { label: "All trends"; h: 26px;
                                        clicked => { root.plan-modal = "trends"; } }
                                }
                                HorizontalLayout {
                                    spacing: 6px; alignment: start;
                                    for t[i] in root.trends: FilterChip {
                                        label: t.name;
                                        on: root.trend-metric == i;
                                        clicked => { root.trend-metric = i; }
                                    }
                                }
                                if root.trends.length == 0: Text {
                                    text: "Nothing to compare yet — this needs a month of history behind it.";
                                    color: FinTheme.ink-dim; font-size: 12px; wrap: word-wrap;
                                }
                                if root.trends.length > 0: HorizontalLayout {
                                    spacing: 10px; vertical-stretch: 1;
                                    for m in root.trends[root.trend-metric].months:
                                    VerticalLayout {
                                        spacing: 6px; horizontal-stretch: 1;
                                        Text {
                                            text: m.amount; color: FinTheme.ink-dim;
                                            font-size: 10.5px;
                                            font-weight: m.current ? 800 : 500;
                                            horizontal-alignment: center;
                                            overflow: elide;
                                        }
                                        Rectangle {
                                            vertical-stretch: 1;
                                            background: transparent;
                                            // A month with no income is a gap
                                            // rather than a bar at the floor:
                                            // "nothing came in" and "nothing was
                                            // kept" are different claims.
                                            if m.known: Rectangle {
                                                y: parent.height - self.height;
                                                width: parent.width;
                                                height: parent.height
                                                    * Math.max(3, m.pct) / 100;
                                                border-radius: Surface.rr(5px, self.width, self.height);
                                                background: m.current
                                                    ? FinTheme.accent-grad
                                                    : FinTheme.accent.with-alpha(0.3);
                                            }
                                            if !m.known: Rectangle {
                                                y: parent.height - self.height;
                                                width: parent.width;
                                                height: 3px;
                                                border-radius: 1.5px;
                                                background: FinTheme.hairline;
                                            }
                                        }
                                        Text {
                                            text: m.label; color: FinTheme.ink-dim;
                                            font-size: 10.5px;
                                            font-weight: m.current ? 800 : 500;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        Card {
                            width: dash.halfw;
                            height: 268px;
                            VerticalLayout {
                                padding: 16px; spacing: 10px;
                                Text { text: "Financial habits"; color: FinTheme.ink;
                                    font-size: 13.5px; font-weight: 700;
                                    min-height: 26px; vertical-alignment: center; }
                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        alignment: start;
                                        padding-right: 6px; spacing: 10px;
                                        for h in root.habits: HorizontalLayout {
                                            spacing: 10px;
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                Rectangle {
                                                    width: 26px; height: 26px;
                                                    border-radius: Surface.rr(9px, self.width, self.height);
                                                    background: h.hue.with-alpha(0.16);
                                                    AppIcon {
                                                        source: h.bar ? Icons.square-check
                                                                      : Icons.sparkles;
                                                        tint: h.hue;
                                                        width: 13px; height: 13px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }
                                            }
                                            Text {
                                                text: h.label; color: FinTheme.ink;
                                                font-size: 12px; vertical-alignment: center;
                                                horizontal-stretch: 1; overflow: elide;
                                            }
                                            if h.bar: VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                width: 92px;
                                                Bar { pct: h.pct; hue: h.hue; toned: false; }
                                            }
                                            // A habit's button opens the list it
                                            // is counting, not another tab: the
                                            // number is the summary and the list
                                            // is the detail behind it.
                                            if h.action-label != "": Btn {
                                                label: h.action-label; h: 26px;
                                                clicked => { root.plan-modal = h.action; }
                                            }
                                            Text {
                                                text: h.value; color: FinTheme.ink;
                                                font-size: 12.5px; font-weight: 800;
                                                vertical-alignment: center;
                                                horizontal-alignment: right;
                                                min-width: 74px; horizontal-stretch: 0;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── the month, read backwards ────────────────────────────
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "Monthly review"; color: FinTheme.ink;
                                font-size: 13.5px; font-weight: 700;
                                vertical-alignment: center; horizontal-stretch: 1; }
                            Btn { label: "The full review"; h: 26px;
                                clicked => { root.plan-modal = "review"; } }
                        }
                        StatStrip { stats: root.review; }
                    }

                    // ── what could be done better ────────────────────────────
                    // The other half of the flags: nothing here is going wrong,
                    // which is exactly why it is at the bottom.
                    if root.recos.length > 0: Card {
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            Text { text: "Worth doing"; color: FinTheme.ink;
                                font-size: 13.5px; font-weight: 700; }
                            for r in root.recos: HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Rectangle {
                                        width: 30px; height: 30px;
                                        border-radius: Surface.rr(10px, self.width, self.height);
                                        background: (r.severity == "good"
                                            ? FinTheme.good
                                            : FinTheme.accent).with-alpha(0.15);
                                        AppIcon {
                                            source: r.severity == "good"
                                                ? Icons.trending-up : Icons.sparkles;
                                            tint: r.severity == "good"
                                                ? FinTheme.good : FinTheme.accent;
                                            width: 15px; height: 15px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px; horizontal-stretch: 1; alignment: center;
                                    Text { text: r.title; color: FinTheme.ink;
                                        font-size: 12.5px; font-weight: 700;
                                        wrap: word-wrap; }
                                    Text { text: r.detail; color: FinTheme.ink-dim;
                                        font-size: 11.5px; wrap: word-wrap; }
                                }
                                if r.action-label != "": VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Btn { label: r.action-label; h: 28px;
                                        clicked => { root.flag-action(r.action); } }
                                }
                            }
                        }
                    }
                }
            }

        }
    }
    }

    // ══ PLANNING · DRILL-DOWNS ══════════════════════════════════════════════
    // The six tables and grids Planning summarises. They were three tabs of
    // their own until the page took their headlines; the tables themselves did
    // not go anywhere, they moved behind the link on the section that quotes
    // them. Nothing on Planning navigates — every way in from it is one of these.

    // ── the month as a grid, and one day of it written out ──────────────────
    // Opened by any card on the timeline and by the year button in the header.
    // The timeline says what order things land in; this says which square of the
    // month they land on, which is the question you have next and the only one
    // the grid answers better than the line.
    if root.plan-modal == "calendar": PlanModal {
        title: "Calendar · " + root.cal-label;
        hint: root.cal-view == "year"
            ? "Twelve months of what is dated, at the same scale."
            : "Pick a day to read it in full.";
        // Back to months on the way out: the header behind this modal is the
        // same selector, and it would otherwise be left naming a year.
        closed => {
            root.plan-modal = "";
            root.set-cal-view("month");
        }

        Card {
            VerticalLayout {
                padding: 16px; spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    FilterChip {
                        label: "Month"; min-width: 84px;
                        on: root.cal-view != "year";
                        clicked => { root.set-cal-view("month"); }
                    }
                    FilterChip {
                        label: "Year"; min-width: 78px;
                        on: root.cal-view == "year";
                        clicked => { root.set-cal-view("year"); }
                    }
                    IconBtn { icon: Icons.chevron-left;
                        clicked => { root.plan-step(-1); } }
                    Text { text: root.cal-label; color: FinTheme.ink;
                        font-size: 15px; font-weight: 700;
                        vertical-alignment: center; }
                    IconBtn { icon: Icons.chevron-right;
                        clicked => { root.plan-step(1); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                if root.cal-view == "year": CalYear { months: root.cal-months; }
                if root.cal-view != "year": CalGrid {
                    days: root.cal-days;
                    selected: root.plan-day;
                    row-min: 56px;
                    picked(d) => {
                        root.plan-day = d.day;
                        root.plan-sel = d;
                    }
                }
            }
        }

        // One day, in full. Only under the month grid: a year has no day to be
        // in full, and the list would be describing a square that is not shown.
        if root.cal-view != "year": Card {
            VerticalLayout {
                padding: 16px; spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.plan-day == 0
                            ? "No day selected"
                            : "\{root.plan-day} " + root.cal-label;
                        color: FinTheme.ink; font-size: 14px;
                        font-weight: 700; vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    if root.plan-today > 0: Pill {
                        label: root.plan-delta == 0 ? "today"
                            : (root.plan-delta > 0
                               ? "in \{root.plan-delta} days"
                               : "\{0 - root.plan-delta} days ago");
                        hue: root.plan-delta == 0 ? FinTheme.accent
                            : (root.plan-delta > 0 ? FinTheme.ink-dim
                                                   : FinTheme.warn);
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    if root.plan-sel.income != "": Text {
                        text: "+" + root.plan-sel.income;
                        color: FinTheme.good; font-size: 12.5px;
                        font-weight: 700; vertical-alignment: center;
                    }
                    if root.plan-sel.amount != "": Text {
                        text: root.plan-sel.amount;
                        color: root.plan-sel.overdue ? FinTheme.bad : FinTheme.ink;
                        font-size: 12.5px; font-weight: 700;
                        vertical-alignment: center;
                    }
                    if root.plan-today > 0 && root.plan-delta != 0: Btn {
                        label: "Today"; h: 26px;
                        clicked => { root.plan-reset(); }
                    }
                }
                VerticalLayout {
                    // No spacing: every other day's row is an empty wrapper, and
                    // the gap between them would still be laid out.
                    spacing: 0;
                    for a in root.cal-agenda: VerticalLayout {
                        if a.day == root.plan-day: HorizontalLayout {
                            spacing: 10px;
                            padding-top: 5px; padding-bottom: 5px;
                            // Every row shares one date, so the date says nothing
                            // and what kind of thing it is says a lot.
                            Text {
                                text: a.kind == "subscription" ? "SUB"
                                    : (a.kind == "bill" ? "BILL" : "ONE-OFF");
                                color: a.cat-hue;
                                font-size: 9.5px; font-weight: 800;
                                vertical-alignment: center;
                                min-width: 54px; horizontal-stretch: 0;
                            }
                            Text { text: a.name; color: FinTheme.ink;
                                font-size: 12.5px; vertical-alignment: center;
                                horizontal-stretch: 1; overflow: elide; }
                            Pill {
                                label: a.status;
                                hue: a.status == "overdue" ? FinTheme.bad
                                   : (a.status == "paid" ? FinTheme.good
                                                         : FinTheme.ink-dim);
                            }
                            Text {
                                text: a.actual == "" ? a.estimate : a.actual;
                                color: FinTheme.ink; font-size: 12.5px;
                                font-weight: 700; font-italic: a.is-estimate;
                                vertical-alignment: center;
                                min-width: 96px; horizontal-stretch: 0;
                                horizontal-alignment: right;
                            }
                        }
                    }
                    if root.plan-sel.count == 0: Text {
                        text: root.plan-day == 0
                            ? "Nothing picked yet — choose a day above."
                            : "Nothing lands on this day.";
                        color: FinTheme.ink-dim; font-size: 12.5px;
                    }
                }
            }
        }
    }

    // ── the whole cash-flow statement ───────────────────────────────────────
    if root.plan-modal == "flow": PlanModal {
        title: "Cash flow · " + root.cal-label;
        hint: "The month on its own, then the bank balance it happens inside.";
        closed => { root.plan-modal = ""; }

        // First, because it is the one the section is about. What came in this
        // month, and what each kind of commitment takes out of it.
        if root.plan-statement.length > 0: Card {
            VerticalLayout {
                alignment: start;
                padding: 16px; spacing: 4px;
                CardTitle {
                    title: "This month, from what came in";
                    hint: "Income, less what is dated and what is set aside.";
                }
                for f in root.plan-statement: KvRow { kv: f; }
            }
        }

        // Second, and named as a different thing. A balance is a running total of
        // every month before this one, so it can be healthy in a bad month and
        // thin in a good one — which is why it is not the statement above.
        if root.cal-flow.length > 0: Card {
            VerticalLayout {
                alignment: start;
                padding: 16px; spacing: 4px;
                CardTitle {
                    title: "The bank balance, separately";
                    hint: "What is there now, what is still to leave it, where it ends.";
                    hue: FinTheme.accent-2;
                }
                for f in root.cal-flow: KvRow { kv: f; }
            }
        }

        Card {
            VerticalLayout {
                alignment: start;
                padding: 16px; spacing: 10px;
                CardTitle { title: "Everything dated"; hint: root.cal-label; }
                if root.cal-agenda.length == 0: Text {
                    text: "Nothing dated this month.";
                    color: FinTheme.ink-dim; font-size: 12.5px;
                }
                for a in root.cal-agenda: HorizontalLayout {
                    spacing: 10px;
                    Text { text: a.due; color: FinTheme.ink-dim; font-size: 11.5px;
                        vertical-alignment: center; min-width: 92px; }
                    Text { text: a.name; color: FinTheme.ink; font-size: 12.5px;
                        vertical-alignment: center; horizontal-stretch: 1;
                        overflow: elide; }
                    Pill {
                        label: a.status;
                        hue: a.status == "overdue" ? FinTheme.bad
                           : a.status == "paid"    ? FinTheme.good
                                                   : FinTheme.ink-dim;
                    }
                    Text {
                        text: a.actual == "" ? a.estimate : a.actual;
                        color: FinTheme.ink; font-size: 12.5px; font-weight: 700;
                        font-italic: a.is-estimate;
                        vertical-alignment: center; min-width: 100px;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }

    // ── every envelope, and what is not one ─────────────────────────────────
    if root.plan-modal == "budgets": PlanModal {
        title: "Envelopes · " + root.budget-period;
        hint: root.budget-income == ""
            ? "No income recorded this month."
            : root.budget-income + " came in · " + root.budget-allocated
              + " set aside · " + root.budget-unallocated + " unallocated";
        closed => { root.plan-modal = ""; }

        HorizontalLayout {
            spacing: 8px; alignment: start;
            Btn { label: "Copy last month"; h: 32px; icon: Icons.rotate-ccw;
                clicked => { root.budget-copy-forward(); } }
            Btn { label: "Set an envelope"; h: 32px; primary: true; icon: Icons.plus;
                clicked => { root.open-sheet("budget", 0); } }
        }

        Card {
            VerticalLayout {
                alignment: start;
                padding: 16px; spacing: 12px;
                CardTitle {
                    title: "Envelopes";
                    hint: root.budget-allocated == ""
                        ? "nothing set this month"
                        : root.envelopes-spent + " of " + root.budget-allocated;
                }
                if root.budgets.length == 0: Blank {
                    title: "No envelopes yet";
                    body: "Set a monthly limit on the categories you actually decide about — groceries, eating out, shopping. Rent and insurance do not need one.";
                    icon: Icons.pie-chart;
                    tint: FinTheme.accent;
                }
                for b in root.budgets: VerticalLayout {
                    spacing: 5px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: b.name; color: FinTheme.ink;
                            font-size: 12.5px; font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1; overflow: elide; }
                        if b.unset: Pill { label: "no envelope"; hue: FinTheme.warn; }
                        if b.over-by != "": Pill { label: b.over-by; hue: FinTheme.bad; }
                        Text {
                            text: b.spent + (b.unset ? "" : " of " + b.budget);
                            color: b.over ? FinTheme.bad : FinTheme.ink;
                            font-size: 12px; font-weight: 700;
                            vertical-alignment: center; horizontal-stretch: 0;
                        }
                        if !b.unset: Btn { label: "Edit"; h: 26px;
                            clicked => { root.open-sheet("budget", b.category-id); } }
                        if b.unset: Btn { label: "Set"; h: 26px;
                            clicked => { root.open-sheet("budget", b.category-id); } }
                        if !b.unset: IconBtn { icon: Icons.x;
                            clicked => { root.budget-remove(b.category-id); } }
                    }
                    if !b.unset: Bar {
                        pct: b.used-pct;
                        hue: b.off-pace ? FinTheme.warn : FinTheme.accent;
                    }
                    if !b.unset: Text {
                        text: b.over
                            ? b.remaining + " over"
                            : (b.off-pace
                               ? "On this pace the month ends at " + b.projected
                               : b.remaining + " left");
                        color: b.over ? FinTheme.bad
                             : (b.off-pace ? FinTheme.warn : FinTheme.ink-dim);
                        font-size: 11px;
                    }
                    if b.detail != "": Text {
                        text: b.detail; color: FinTheme.ink-dim; font-size: 10.5px;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 14px;
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    padding: 16px; spacing: 10px;
                    CardTitle {
                        title: "Where " + root.budget-income + " is committed";
                        hint: "before anything discretionary";
                    }
                    for c in root.commitments: VerticalLayout {
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Rectangle { width: 10px; height: 10px;
                                    border-radius: Surface.rr(3px, self.width, self.height); background: c.hue; }
                            }
                            Text { text: c.name; color: FinTheme.ink;
                                font-size: 12px; vertical-alignment: center;
                                horizontal-stretch: 1; overflow: elide; }
                            Text { text: "\{c.pct}%"; color: FinTheme.ink-dim;
                                font-size: 11px; vertical-alignment: center;
                                min-width: 34px; horizontal-alignment: right; }
                            Text { text: c.amount; color: FinTheme.ink;
                                font-size: 12px; font-weight: 700;
                                vertical-alignment: center; min-width: 92px;
                                horizontal-alignment: right; }
                        }
                        Bar { pct: c.pct; thickness: 5px; hue: c.hue; toned: false; }
                    }
                    if root.commitments.length == 0: Text {
                        text: "No income recorded this month, so there is nothing to divide up yet.";
                        color: FinTheme.ink-dim; font-size: 12px; wrap: word-wrap;
                    }
                }
            }
            // What leaves whatever you decide, itemised. Shown so the page adds
            // up: envelopes are a quarter of a normal month, and showing only
            // them implies the rest is yours to steer too.
            Card {
                horizontal-stretch: 0;
                min-width: 300px; max-width: 300px;
                VerticalLayout {
                    padding: 16px; spacing: 4px;
                    Text { text: "NOT BUDGETED"; color: FinTheme.ink-dim;
                        font-size: 11px; font-weight: 700; }
                    Text {
                        text: root.fixed-total == "" ? "—" : root.fixed-total;
                        color: FinTheme.ink; font-size: 22px; font-weight: 800;
                    }
                    Text {
                        text: root.fixed-share;
                        color: FinTheme.ink-dim; font-size: 11px; wrap: word-wrap;
                    }
                    Text {
                        text: "You cannot overspend a bill — you can only fail to pay it.";
                        color: FinTheme.ink-dim; font-size: 10.5px; wrap: word-wrap;
                    }
                    for f in root.fixed-items: KvRow { kv: f; }
                    if root.fixed-items.length == 0: Text {
                        text: "Nothing fixed this month.";
                        color: FinTheme.ink-dim; font-size: 11.5px;
                    }
                    if root.budget-unbudgeted != "": KvRow {
                        kv: { label: "Spending with no envelope",
                              value: root.budget-unbudgeted,
                              tone: "warn", strong: false };
                        rule: false;
                    }
                    // The rule, stated where the rollover figures are shown,
                    // because "why is my envelope bigger than I set it" is
                    // otherwise unanswerable from the UI.
                    Text {
                        text: "An envelope with rollover carries what it did not spend into next month. One without it starts fresh.";
                        color: FinTheme.ink-dim; font-size: 10.5px; wrap: word-wrap;
                    }
                }
            }
        }

        // Six months, twice: which envelope keeps not holding, and whether the
        // month as a whole did. Everything above is this month; these two say
        // whether this month is the exception or the pattern.
        Card {
            VerticalLayout {
                alignment: start;
                padding: 16px; spacing: 8px;
                CardTitle {
                    title: "Six months, envelope by envelope";
                    hint: "An empty cell is a month with no envelope set, not a month with no spending.";
                    hue: FinTheme.accent-2;
                }
                if root.envelope-history.length == 0: Text {
                    text: "No envelope has been set for long enough to have a history yet.";
                    color: FinTheme.ink-dim; font-size: 12px; wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: ""; horizontal-stretch: 1; min-width: 110px; }
                    for m in root.discipline-months: Text {
                        text: m; color: FinTheme.ink-dim;
                        font-size: 10.5px; font-weight: 700;
                        horizontal-alignment: right;
                        min-width: 66px; horizontal-stretch: 0;
                    }
                    Text {
                        text: "AVG VS BUDGET"; color: FinTheme.ink-dim;
                        font-size: 10.5px; font-weight: 700;
                        horizontal-alignment: right;
                        min-width: 100px; horizontal-stretch: 0;
                    }
                }
                Rectangle { min-height: 1px; max-height: 1px;
                    background: FinTheme.hairline; }
                for h in root.envelope-history: HorizontalLayout {
                    spacing: 8px;
                    Text { text: h.name; color: FinTheme.ink;
                        font-size: 12px; font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1; min-width: 110px;
                        overflow: elide; }
                    for c[i] in h.cells: Text {
                        text: c;
                        color: h.over[i] ? FinTheme.bad : FinTheme.ink-dim;
                        font-size: 11.5px; vertical-alignment: center;
                        horizontal-alignment: right;
                        min-width: 66px; horizontal-stretch: 0;
                    }
                    Text {
                        text: h.avg-delta;
                        color: h.avg-over ? FinTheme.bad : FinTheme.good;
                        font-size: 11.5px; font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        min-width: 100px; horizontal-stretch: 0;
                    }
                }
            }
        }

        Card {
            VerticalLayout {
                alignment: start;
                padding: 16px; spacing: 10px;
                CardTitle {
                    title: "Six months of discipline";
                    hint: "Only counts categories that had an envelope that month.";
                    hue: FinTheme.good;
                }
                if root.discipline.length == 0: Text {
                    text: "Nothing to compare yet — this needs a month that had an envelope set on it.";
                    color: FinTheme.ink-dim; font-size: 12px; wrap: word-wrap;
                }
                for m in root.discipline: HorizontalLayout {
                    spacing: 10px;
                    Text { text: m.period; color: FinTheme.ink-dim;
                        font-size: 11.5px; vertical-alignment: center;
                        min-width: 66px; horizontal-stretch: 0; }
                    Bar {
                        pct: m.pct;
                        // Already decided: within budget or not. The fill's own
                        // tone rule would overrule that.
                        hue: m.within ? FinTheme.good : FinTheme.bad;
                        thickness: 10px; toned: false;
                    }
                    Text {
                        text: m.spent + " / " + m.budget;
                        color: FinTheme.ink-dim; font-size: 11px;
                        vertical-alignment: center;
                        min-width: 130px; horizontal-stretch: 0;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }

    // ── six months, every way the section can cut them ──────────────────────
    if root.plan-modal == "trends": PlanModal {
        title: "Trends";
        hint: "The last six months, by category and as a savings rate.";
        closed => { root.plan-modal = ""; }

        StatStrip { stats: root.insight-stats; }

        // Six months of spending by category, one ring per month. The small
        // multiples that were here normalised every category against its own
        // worst month, so a category with one busy month and a category with
        // six steady ones drew the same shape, and a category with nothing drew
        // a flat line across a box the same size as the rest — which is what
        // left the card looking half empty and saying nothing.
        //
        // The ring is the Overview's `SpendBreakdown`, fed by the same `slices`
        // builder, so a month read here and the same month read on the Overview
        // cannot disagree. The chips pick the month; the ring is the answer.
        if root.trend-pies.length > 0: Card {
            VerticalLayout {
                alignment: start;
                padding: 16px; spacing: 12px;
                CardTitle {
                    title: "Spend by category";
                    hint: root.trend-pies[root.tm].long + " — pick a month to redraw the ring.";
                }
                HorizontalLayout {
                    spacing: 6px; alignment: start;
                    for m[i] in root.trend-pies: FilterChip {
                        label: m.label; w: 62px;
                        on: root.tm == i;
                        clicked => { root.trend-month = i; }
                    }
                }
                SpendBreakdown {
                    slices: root.trend-pies[root.tm].slices;
                    total: root.trend-pies[root.tm].total;
                    caption: "spent";
                    empty-label: root.trend-pies[root.tm].long;
                    // The panel is min(page - 64, 980); off that come the modal's
                    // own 20px padding each side, the scroll gutter and the
                    // card's 16px each side. Computed downwards, never read back
                    // off the layout — see `SpendBreakdown.avail`.
                    avail: Math.min(root.width - 64px, 980px) - 78px;
                }
            }
        }

        if root.savings.length > 0: Card {
            VerticalLayout {
                alignment: start;
                padding: 16px; spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 2px; horizontal-stretch: 1;
                        Text { text: "Savings rate"; color: FinTheme.ink;
                            font-size: 13px; font-weight: 700; }
                        Text {
                            text: "Income minus spending, as a share of income. Pick a month.";
                            color: FinTheme.ink-dim; font-size: 11px;
                        }
                    }
                    // The picked month, said in full rather than left to be read
                    // off a bar's height.
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Text {
                            text: root.savings[root.sm].label + " · "
                                + root.savings[root.sm].amount;
                            color: root.savings[root.sm].known
                                ? FinTheme.ink : FinTheme.ink-dim;
                            font-size: 13px; font-weight: 800;
                            horizontal-alignment: right;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    for m[i] in root.savings: VerticalLayout {
                        spacing: 5px; horizontal-stretch: 1;
                        sbar := Rectangle {
                            min-height: 78px; max-height: 78px;
                            background: root.sm == i
                                ? FinTheme.good.with-alpha(0.10)
                                : (svta.has-hover ? FinTheme.good.with-alpha(0.06)
                                                 : transparent);
                            border-radius: Surface.rr(5px, self.width, self.height);
                            svta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.sav-month = i; }
                            }
                            // A month with no income is a gap, not a bar at the
                            // floor: the salary landing late is a calendar
                            // accident, and a zero-height bar would report it as
                            // the worst month on record.
                            if m.known: Rectangle {
                                y: parent.height - self.height;
                                width: parent.width;
                                height: parent.height * Math.max(3, m.pct) / 100;
                                border-radius: Surface.rr(4px, self.width, self.height);
                                background: root.sm == i
                                    ? FinTheme.good : FinTheme.good.with-alpha(0.4);
                            }
                            if !m.known: Rectangle {
                                y: parent.height - self.height;
                                width: parent.width;
                                height: 3px;
                                border-radius: 1.5px;
                                background: FinTheme.hairline;
                            }
                        }
                        Text {
                            text: m.label; color: root.sm == i
                                ? FinTheme.ink : FinTheme.ink-dim;
                            font-size: 10px; font-weight: root.sm == i ? 800 : 500;
                            horizontal-alignment: center;
                        }
                    }
                }
                for k in root.savings-summary: KvRow { kv: k; }
            }
        }

        if root.projection.length > 0: Card {
            VerticalLayout {
                alignment: start;
                padding: 16px; spacing: 4px;
                CardTitle {
                    title: "If nothing changes";
                    hint: "An average of what has happened, carried forward.";
                }
                for p in root.projection: KvRow { kv: p; }
                if root.projection-note != "": Text {
                    text: root.projection-note;
                    color: FinTheme.ink-dim; font-size: 11.5px; wrap: word-wrap;
                }
            }
        }
    }

    // ── every claim the section can put a number behind ─────────────────────
    if root.plan-modal == "review": PlanModal {
        title: "The month in full";
        hint: "Everything Planning found, whether or not it needs doing something about.";
        closed => { root.plan-modal = ""; }

        StatStrip { stats: root.review; }

        if root.flags.length == 0: Blank {
            title: "Nothing to report";
            body: "Planning only says things it can put a number behind. When there is a price rise, an overspend or a subscription you are not using, it will be here.";
            icon: Icons.pie-chart;
            tint: FinTheme.accent;
        }

        for f in root.flags: flag := Card {
            // Named, because `root` inside here is the page and `parent` is
            // whichever layout encloses the icon.
            property <color> hue:
                f.severity == "bad"  ? FinTheme.bad :
                f.severity == "warn" ? FinTheme.warn :
                f.severity == "good" ? FinTheme.good : FinTheme.accent;
            HorizontalLayout {
                padding: 14px; spacing: 12px;
                VerticalLayout {
                    alignment: start; horizontal-stretch: 0;
                    Rectangle {
                        width: 34px; height: 34px; border-radius: Surface.rr(10px, self.width, self.height);
                        background: flag.hue.with-alpha(0.15);
                        AppIcon {
                            source: f.severity == "good" ? Icons.trending-up
                                  : f.severity == "bad"  ? Icons.bell
                                                         : Icons.pie-chart;
                            tint: flag.hue;
                            width: 17px; height: 17px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1; spacing: 4px; alignment: center;
                    Text { text: f.title; color: FinTheme.ink; font-size: 13.5px;
                        font-weight: 700; wrap: word-wrap; }
                    Text { text: f.detail; color: FinTheme.ink-dim; font-size: 12px;
                        wrap: word-wrap; }
                }
                if f.action-label != "": VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Btn { label: f.action-label; h: 30px;
                        clicked => {
                            root.plan-modal = "";
                            root.flag-action(f.action);
                        } }
                }
            }
        }
    }

    // ── the subscriptions that are not the price they were ──────────────────
    if root.plan-modal == "subs": PlanModal {
        title: "Subscriptions that have risen";
        hint: "Measured against the oldest price this app has a record of.";
        closed => { root.plan-modal = ""; }

        Card {
            VerticalLayout {
                alignment: start;
                padding: 16px; spacing: 10px;
                // Every row is one wrapper, so the ones that have not risen
                // collapse to nothing rather than leaving a gap behind them.
                for r in root.subs: VerticalLayout {
                    spacing: 0;
                    if r.hike-pct > 0: HorizontalLayout {
                        spacing: 10px;
                        padding-top: 5px; padding-bottom: 5px;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            AccountBadge { glyph: r.badge; hue: r.hue; side: 30px; }
                        }
                        VerticalLayout {
                            spacing: 2px; horizontal-stretch: 1; alignment: center;
                            Text { text: r.name; color: FinTheme.ink;
                                font-size: 12.5px; font-weight: 700; overflow: elide; }
                            Text { text: r.hike-from + " → " + r.amount;
                                color: FinTheme.ink-dim; font-size: 11.5px; }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Delta { label: "\{r.hike-pct}%"; up: true; }
                        }
                        Text { text: r.yearly; color: FinTheme.ink;
                            font-size: 12px; font-weight: 700;
                            vertical-alignment: center;
                            min-width: 110px; horizontal-alignment: right;
                            horizontal-stretch: 0; }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Btn { label: "Open"; h: 26px;
                                clicked => {
                                    root.plan-modal = "";
                                    root.set-tab("subs");
                                } }
                        }
                    }
                }
                if root.subs.length == 0: Text {
                    text: "No subscriptions are being tracked yet.";
                    color: FinTheme.ink-dim; font-size: 12.5px;
                }
            }
        }
    }

    // ══ SHEET ═══════════════════════════════════════════════════════════════
    // Declared last so it paints over the page: declaration order is z-order.
    // ── sample-data explainer ───────────────────────────────────────────────
    // What the sample data is, why it is there, and the two things that can be
    // done about it.
    if root.demo-open: Rectangle {
        width: 100%; height: 100%;
        background: #000000a0;
        TouchArea { clicked => { root.demo-open = false; } }

        Rectangle {
            width: Math.min(root.width - 64px, 520px);
            height: dl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Surface.rr(20px, self.width, self.height);
            background: Theme.modal;
            border-width: 1px;
            // Warn-edged only while there is invented money on screen. Opened from the
            // logo with none left, this popup is an offer, not an alert.
            border-color: root.demo ? FinTheme.warn.with-alpha(0.35) : FinTheme.hairline;
            drop-shadow-blur: Surface.cast(40px);
            drop-shadow-color: #00000070;
            TouchArea { }

            dl := VerticalLayout {
                padding: 20px; spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            width: 34px; height: 34px; border-radius: Surface.rr(11px, self.width, self.height);
                            background: root.demo
                                ? FinTheme.warn.with-alpha(0.16)
                                : FinTheme.accent.with-alpha(0.14);
                            AppIcon {
                                source: root.demo ? Icons.triangle-alert : Icons.wallet;
                                tint: root.demo ? FinTheme.warn : FinTheme.accent;
                                width: 18px; height: 18px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1;
                        Text {
                            text: root.demo
                                ? "This is sample data, not your money."
                                : "Sample data, if you want it back.";
                            color: FinTheme.ink; font-size: 16px; font-weight: 800;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        IconBtn { icon: Icons.x; clicked => { root.demo-open = false; } }
                    }
                }

                Text {
                    text: "The section seeded a plausible year of accounts, spending, bills, subscriptions, loans, dues and budgets on its first run, because nine empty tabs look exactly like nine broken ones. None of it came from a bank and none of it is yours.";
                    color: FinTheme.ink-dim; font-size: 12.5px; wrap: word-wrap;
                }
                Text {
                    text: root.demo
                        ? "It gets out of your way by itself, one part at a time: your first real account clears the sample accounts, your first real bill clears the sample bills. Nothing you enter is ever removed with it."
                        : "There is none of it left. Adding it back puts the sample accounts, bills, subscriptions, loans, dues and budgets in again, and leaves everything you entered yourself untouched.";
                    color: FinTheme.ink-dim; font-size: 12.5px; wrap: word-wrap;
                }

                Rectangle { min-height: 1px; max-height: 1px; background: FinTheme.hairline; }

                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1;
                        Text {
                            // The remove button empties the section outright, so
                            // this says so rather than leaving it to be discovered.
                            text: root.demo
                                ? "Remove all of it empties the section — every account, posting, bill and budget, yours as well as the sample's."
                                : "Adding it puts a year of invented money in, labelled everywhere it appears.";
                            color: root.demo ? FinTheme.warn : FinTheme.ink-dim;
                            font-size: 11px; wrap: word-wrap;
                        }
                    }
                    Btn {
                        label: "Add sample data"; icon: Icons.plus; h: 36px;
                        primary: !root.demo;
                        clicked => { root.demo-add(); root.demo-open = false; }
                    }
                    // Offered whenever there is anything to clear, which after the
                    // sample has gone is the user's own data — the button is the
                    // section's reset, and hiding it once the samples went made it
                    // look as though only invented money could be removed.
                    Btn {
                        label: "Remove all of it"; icon: Icons.trash; h: 36px; danger: true;
                        clicked => { root.demo-remove(); root.demo-open = false; }
                    }
                }
            }
        }
    }

    // ── health score ────────────────────────────────────────────────────────
    // The total on the strip is a claim; this is the working behind it. Every
    // component shows what it was worth, what it scored and the figure that
    // decided it, so the number can be argued with rather than believed.
    if root.health-open: DetailModal {
        title: "Financial Health Score";
        subtitle: root.health-band;
        amount: root.health-score;
        badge: "%";
        hue: FinTheme.accent;
        closed => { root.health-open = false; }
        confirmed => { root.health-open = false; }

        for p in root.health-parts: VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 10px;
                Text { text: p.label;
                    color: p.measured ? FinTheme.ink : FinTheme.ink-dim;
                    font-size: 12.5px; font-weight: 700;
                    vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: p.points;
                    color: p.tone == "bad"  ? FinTheme.bad
                         : p.tone == "warn" ? FinTheme.warn
                         : p.tone == "ok"   ? FinTheme.good : FinTheme.ink-dim;
                    font-size: 12.5px; font-weight: 800;
                    vertical-alignment: center; horizontal-stretch: 0; }
            }
            // No bar on a component that was not measured — an empty bar reads
            // as a zero, and "no envelopes yet" is not a score of nothing.
            if p.measured: Bar {
                pct: p.pct; thickness: 6px; toned: false;
                hue: p.tone == "bad"  ? FinTheme.bad
                   : p.tone == "warn" ? FinTheme.warn
                   : p.tone == "ok"   ? FinTheme.good : FinTheme.accent;
            }
            Text { text: p.detail; color: FinTheme.ink-dim;
                font-size: 11px; wrap: word-wrap; }
        }

        Text {
            text: "Six readings of the ledger, weighted and added up. A component with nothing behind it yet is left out of both sides of the fraction rather than scored as a zero, so the total stays out of 100. Nothing here is guessed at: there is no net worth in it, and nothing about anything the app has not been told.";
            color: FinTheme.ink-dim; font-size: 10.5px; wrap: word-wrap;
        }
    }

    // ── mark paid ───────────────────────────────────────────────────────────
    // Opened by clicking a row in "Needs you". The row's own button pays outright;
    // this is the same act with the figure, the date and the account in front of
    // you first — which matters most for the estimated ones, where "Mark paid" is
    // agreeing to a number nobody has confirmed yet.
    if root.needs-open: DetailModal {
        property <FinObligationRow> o: root.needs-sel;
        title: o.name;
        subtitle: o.status == "overdue"
            ? "was due \{o.due} · unpaid"
            : (o.days == 0 ? "\{o.due} · due today"
            : (o.days == 1 ? "\{o.due} · due tomorrow"
            : "\{o.due} · in \{o.days} days"));
        amount: o.estimate;
        amount-bad: o.status == "overdue";
        badge: o.kind == "subscription" ? "SUB" : (o.kind == "bill" ? "BILL" : "ONE");
        hue: o.status == "overdue" ? FinTheme.bad : FinTheme.accent;
        // Enter marks it paid. Unlike skipping, this one is undoable — `unpay`
        // deletes the posting and reopens the obligation.
        closed => { root.needs-open = false; }
        confirmed => { root.needs-open = false; root.pay-obligation(o.id); }

        if o.is-estimate: Text {
            text: "This figure is an estimate from what this charge has cost before. Marking it paid posts it at that amount; edit the transaction afterwards if the real one differs.";
            color: FinTheme.ink-dim; font-size: 11px; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: "Category"; color: FinTheme.ink-dim; font-size: 12px;
                vertical-alignment: center; horizontal-stretch: 1;
            }
            Text {
                text: o.category == "" ? "Uncategorised" : o.category;
                color: FinTheme.ink; font-size: 12px; font-weight: 600;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: "Paid from"; color: FinTheme.ink-dim; font-size: 12px;
                vertical-alignment: center; horizontal-stretch: 1;
            }
            Text {
                text: o.account == "" ? "—" : o.account;
                color: FinTheme.ink; font-size: 12px; font-weight: 600;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            Btn {
                label: "Skip this one"; h: 32px;
                // Hands over to the same confirmation the row's own button raises,
                // rather than skipping outright: which modal you started from does
                // not change how permanent it is.
                clicked => { root.needs-open = false; root.needs-skip-open = true; }
            }
            Btn {
                label: "Mark paid"; h: 32px; primary: true; icon: Icons.check;
                clicked => { root.needs-open = false; root.pay-obligation(o.id); }
            }
        }
    }

    // ── skip confirmation ───────────────────────────────────────────────────
    // Skipping writes `skipped` and posts nothing. There is no un-skip anywhere in
    // this section, so this is the last chance to not do it — which is the whole
    // reason it exists rather than the X acting straight away.
    if root.needs-skip-open: DetailModal {
        property <FinObligationRow> o: root.needs-sel;
        title: "Skip " + o.name + "?";
        subtitle: o.due;
        amount: o.estimate;
        badge: "!";
        hue: FinTheme.warn;
        closed => { root.needs-skip-open = false; }
        // Enter closes rather than skips. This modal exists because the act is
        // permanent, and a permanent act one keystroke away is the thing it was
        // put here to prevent.
        confirmed => { root.needs-skip-open = false; }

        Text {
            text: "It stops asking about this one and records nothing as paid. Your balances do not move. This cannot be undone from here — if it was paid, mark it paid instead so the posting exists.";
            color: FinTheme.ink-dim; font-size: 11.5px; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            Btn {
                label: "Keep it"; h: 32px;
                clicked => { root.needs-skip-open = false; }
            }
            Btn {
                label: "Mark paid instead"; h: 32px; icon: Icons.check;
                clicked => { root.needs-skip-open = false; root.pay-obligation(o.id); }
            }
            Btn {
                label: "Skip it"; h: 32px; primary: true; icon: Icons.x;
                clicked => { root.needs-skip-open = false; root.skip-obligation(o.id); }
            }
        }
    }

    // ── remove a subscription, or delete one that is already removed ────────
    if root.subs-del-open: DetailModal {
        title: root.subs-del.name;
        subtitle: root.subs-gone ? "Delete for good" : "Remove from the list";
        amount: root.subs-del.monthly + " a month";
        badge: root.subs-del.badge;
        hue: root.subs-del.hue;
        closed => { root.subs-del-open = false; }
        // Enter acts on the reversible one only. Deleting for good behind a bare
        // keystroke would defeat the box that exists to prevent exactly that.
        confirmed => {
            if (!root.subs-gone) {
                root.subs-del-open = false;
                root.recur-status(root.subs-del.id, "removed");
            }
        }
        Text {
            text: root.subs-gone
                ? "This erases the subscription, its price history and its schedule. Transactions it already posted stay in the ledger and stop claiming a template. There is no undo."
                : "It moves to Removed and stops appearing anywhere else. Nothing is deleted, no posting changes, and Removed has a button to put it back.";
            color: FinTheme.ink-dim; font-size: 11.5px; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            Btn {
                label: "Keep it"; h: 32px;
                clicked => { root.subs-del-open = false; }
            }
            Btn {
                label: root.subs-gone ? "Delete for good" : "Remove it";
                h: 32px; icon: Icons.x;
                primary: true;
                danger: root.subs-gone;
                clicked => {
                    root.subs-del-open = false;
                    if (root.subs-gone) { root.recur-delete(root.subs-del.id); }
                    else { root.recur-status(root.subs-del.id, "removed"); }
                }
            }
        }
    }

    // ── the header's one button ─────────────────────────────────────────────
    if root.actions-open: ActionsModal {
        actions: root.acts;
        closed => { root.actions-open = false; }
        act(what) => {
            root.actions-open = false;
            if (what == "import") { root.import-pick(); }
            else if (what == "scan") { root.scan-receipt(); }
            else { root.open-sheet(what, 0); }
        }
    }

    // ── account detail ──────────────────────────────────────────────────────
    if root.detail-open && !root.detail-loan-open: DetailModal {
        property <FinAccountRow> a: root.detail-account;
        title: a.name;
        subtitle: a.sub;
        amount: a.balance;
        amount-bad: a.negative;
        badge: a.badge;
        hue: a.hue;
        closed => { root.detail-open = false; }
        // A holding account has no edit sheet, so Enter has nothing to confirm.
        confirmed => {
            if (a.kind != "virtual") {
                root.detail-open = false; root.open-sheet("account", a.id);
            }
        }

        if a.limit-note != "": VerticalLayout {
            spacing: 4px;
            Text { text: a.limit-note; color: FinTheme.ink-dim; font-size: 11px; }
            Bar { pct: a.util-pct; thickness: 6px;
                  hue: a.util-pct >= 70 ? FinTheme.warn : FinTheme.accent; }
        }
        if a.lent != "": KvRow {
            kv: { label: "Lent out", value: a.lent, tone: "ok", strong: false }; }
        if a.borrowed != "": KvRow {
            kv: { label: "Borrowed", value: a.borrowed, tone: "warn", strong: false }; }
        if a.reconciled != "": KvRow {
            kv: { label: "Balance", value: a.reconciled, tone: "flat", strong: false }; }
        if a.in-month != "": KvRow {
            kv: { label: "In this month", value: a.in-month, tone: "ok", strong: false }; }
        if a.out-month != "": KvRow {
            kv: { label: "Out this month", value: a.out-month, tone: "flat", strong: false }; }
        if a.statement != "": KvRow {
            kv: { label: "Statement", value: a.statement, tone: "flat", strong: false }; }
        if a.minimum-due != "": KvRow {
            kv: { label: "Minimum due", value: a.minimum-due, tone: "flat", strong: false }; }
        if a.drift != "": KvRow {
            kv: { label: "Last count was out by", value: a.drift,
                  tone: a.drift-bad ? "warn" : "ok", strong: false }; }
        if a.topped-from != "": KvRow {
            kv: { label: "Topped up from", value: a.topped-from, tone: "flat", strong: false }; }
        if a.last-topup != "": KvRow {
            kv: { label: "Last top-up", value: a.last-topup, tone: "flat", strong: false }; }
        KvRow {
            kv: { label: "Transactions", value: "\{a.txn-count}", tone: "flat", strong: false };
            rule: false;
        }

        if a.kind == "cash": Text {
            text: "Cash always drifts. A recount sets the balance and books the gap.";
            color: FinTheme.ink-dim; font-size: 11px; wrap: word-wrap; }
        if a.kind == "wallet": Text {
            text: "Top-ups are transfers, not spending. Only what leaves the wallet counts.";
            color: FinTheme.ink-dim; font-size: 11px; wrap: word-wrap; }
        if a.kind == "virtual": Text {
            text: "A holding account, not one of yours. Money moves here when a due opens and comes back when it settles, which is why lending never counts as spending.";
            color: FinTheme.ink-dim; font-size: 11px; wrap: word-wrap; }

        HorizontalLayout {
            spacing: 8px; alignment: start;
            if a.kind == "cash": Btn { label: "Recount"; h: 30px;
                clicked => { root.detail-open = false; root.account-recount(a.id); } }
            if a.kind != "cash" && a.kind != "virtual": Btn { label: "Reconcile"; h: 30px;
                clicked => { root.detail-open = false; root.account-reconcile(a.id); } }
            if a.kind == "card" && a.negative: Btn { label: "Pay it off"; h: 30px;
                clicked => { root.detail-open = false; root.account-pay-card(a.id); } }
            // Edit opens the sheet in the same frame this panel uses, so the
            // popup reads as changing mode rather than stacking a second dialog.
            if a.kind != "virtual": Btn { label: "Edit"; h: 30px; primary: true;
                clicked => { root.detail-open = false; root.open-sheet("account", a.id); } }
            if a.kind != "virtual" && a.txn-count == 0: Btn {
                label: "Delete"; h: 30px; danger: true;
                clicked => { root.detail-open = false; root.account-delete(a.id); } }
        }
    }

    // ── loan detail ─────────────────────────────────────────────────────────
    if root.detail-open && root.detail-loan-open: DetailModal {
        property <FinLoanRow> l: root.detail-loan;
        title: l.name;
        subtitle: l.rate + " · " + l.emi + " a month";
        amount: l.balance;
        amount-bad: true;
        badge: l.badge;
        hue: l.hue;
        closed => { root.detail-open = false; }
        confirmed => { root.detail-open = false; root.open-sheet("loan", l.account-id); }

        VerticalLayout {
            spacing: 5px;
            Bar { pct: l.progress-pct; hue: FinTheme.accent; toned: false; }
            Text {
                text: "\{l.progress-pct}% repaid · \{l.remaining-months} of \{l.tenure-months} instalments left";
                color: FinTheme.ink-dim; font-size: 11px;
            }
        }
        KvRow { kv: { label: "Borrowed", value: l.principal, tone: "flat", strong: false }; }
        KvRow { kv: { label: "EMI", value: l.emi, tone: "flat", strong: false }; }
        KvRow { kv: { label: "Next instalment", value: l.next-due, tone: "flat", strong: false }; }
        if l.emi-principal != "": KvRow {
            kv: { label: "This EMI · principal", value: l.emi-principal,
                  tone: "ok", strong: false }; }
        if l.emi-interest != "": KvRow {
            kv: { label: "This EMI · interest", value: l.emi-interest,
                  tone: l.interest-free ? "flat" : "warn", strong: false }; }
        if l.closes != "": KvRow {
            kv: { label: "Closes", value: l.closes, tone: "flat", strong: false }; }
        if l.interest-left != "": KvRow {
            kv: { label: "Interest still to pay", value: l.interest-left,
                  tone: l.interest-free ? "ok" : "bad", strong: false };
            rule: false; }

        HorizontalLayout {
            spacing: 8px; alignment: start;
            Btn { label: "Schedule"; h: 30px;
                clicked => { root.detail-open = false; root.loan-schedule(l.account-id); } }
            Btn { label: "What if I prepay?"; h: 30px;
                clicked => { root.detail-open = false; root.loan-prepay(l.account-id); } }
            // A loan's terms live on the loan, not on the account behind it —
            // editing it as a plain account could only ever rename it.
            Btn { label: "Edit"; h: 30px; primary: true;
                clicked => { root.detail-open = false; root.open-sheet("loan", l.account-id); } }
        }
    }

    if root.sheet != "": Rectangle {
        width: 100%; height: 100%;
        background: transparent;
        ScrimFrost { width: 100%; height: 100%; accent: FinTheme.accent; }
        // Swallows clicks so the page behind cannot be operated through the
        // scrim, and closes on a click outside the panel.
        TouchArea { clicked => { root.close-sheet(); } }

        // Escape closes, Enter saves. The scope wraps the panel rather than
        // sitting beside it: a key pressed while a field has the focus only
        // reaches a handler that is an *ancestor* of that field.
        FocusScope {
        width: 100%; height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.close-sheet(); return accept; }
            if (e.text == Key.Return) { root.sheet-confirm(); return accept; }
            reject
        }

        Rectangle {
            width: Math.min(root.width - 64px, 640px);
            // Fits its content, up to the window. A fixed 720px box put a
            // two-row rate list at the top of half a screen of nothing — and
            // every short sheet in this section had the same problem, so the
            // panel measures rather than each sheet declaring a height.
            height: Math.min(root.height - 64px, Math.max(240px, body.preferred-height));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Surface.rr(20px, self.width, self.height);
            background: Theme.modal;
            border-width: 1px;
            border-color: FinTheme.hairline;
            drop-shadow-blur: Surface.cast(40px);
            drop-shadow-color: #00000070;
            // A second TouchArea, so clicks inside the panel do not reach the
            // scrim's close handler.
            TouchArea { }

            body := VerticalLayout {
                padding: 20px; spacing: 14px;

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 3px; alignment: center;
                        Text { text: root.sheet-title; color: FinTheme.ink;
                            font-size: 17px; font-weight: 800; }
                        if root.sheet-hint != "": Text { text: root.sheet-hint;
                            color: FinTheme.ink-dim; font-size: 11.5px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        IconBtn { icon: Icons.x; clicked => { root.close-sheet(); } }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    // ScrollView declares `preferred-height: 100%` — its parent's
                    // height — so a panel measured from `body.preferred-height` was
                    // measuring nothing and fell back to the 50px minimum: one visible
                    // row and a scrollbar for the rest. Reporting what is actually
                    // inside makes the sheet as tall as its content, and the clamp on
                    // the panel still hands scrolling back when there is too much.
                    preferred-height: sheetc.preferred-height;
                    property <int> watch: root.form.length + root.prices.length
                                        + root.schedule.length + root.import-rows.length
                                        + root.proposals.length + root.rates.length;
                    changed watch => { self.viewport-y = 0; }
                    init => { self.viewport-y = 0; }
                    sheetc := VerticalLayout {
                        padding-right: 6px; spacing: 14px; alignment: start;

                        for f in root.form: FinFieldRow {
                            field: f;
                            set(k, v) => { root.set-field(k, v); }
                            confirm => { root.sheet-confirm(); }
                        }

                        // ── price history ───────────────────────────────────
                        if root.prices.length > 0: VerticalLayout {
                            spacing: 8px;
                            Text { text: "Price history"; color: FinTheme.ink;
                                font-size: 12.5px; font-weight: 700; }
                            for p in root.prices: HorizontalLayout {
                                spacing: 10px;
                                Text { text: p.from; color: FinTheme.ink-dim; font-size: 11.5px;
                                    vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: p.amount; color: FinTheme.ink; font-size: 12.5px;
                                    font-weight: 700; vertical-alignment: center; }
                            }
                        }

                        // ── exchange rates ──────────────────────────────────
                        // ── reconcile ───────────────────────────────────────
                        // Before booking a correction, the honest first move is to
                        // look for what is actually missing. This is the mockup's
                        // "find the missing row": it opens the ledger filtered to
                        // this account so the gap can be spotted rather than papered
                        // over with an adjustment.
                        if root.sheet == "reconcile": VerticalLayout {
                            spacing: 8px;
                            Rectangle {
                                border-radius: Surface.rr(12px, self.width, self.height);
                                background: FinTheme.warn.with-alpha(0.10);
                                border-width: 1px;
                                border-color: FinTheme.warn.with-alpha(0.30);
                                VerticalLayout {
                                    padding: 12px; spacing: 6px;
                                    Text {
                                        text: "A correction is a last resort.";
                                        color: FinTheme.warn; font-size: 12px; font-weight: 700;
                                    }
                                    Text {
                                        text: "If the statement and the ledger disagree, usually one transaction is missing or duplicated. Look for it first — booking the difference hides the cause and the same gap opens again next month.";
                                        color: FinTheme.ink-dim; font-size: 11.5px; wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        Btn {
                                            label: "Find the missing row"; icon: Icons.search;
                                            h: 30px;
                                            clicked => { root.find-missing(); }
                                        }
                                    }
                                }
                            }
                        }

                        // ── import column mapping ───────────────────────────
                        // Which column of the file became which field. Shown because
                        // it is guessed, and a wrong guess inverts a whole statement
                        // while every total still looks plausible.
                        if root.sheet == "import" && root.import-map.length > 0: VerticalLayout {
                            spacing: 6px;
                            Text { text: "Column mapping"; color: FinTheme.ink;
                                font-size: 12.5px; font-weight: 700; }
                            Text {
                                text: "Guessed from the header row. Correct one and the preview below re-reads the file straight away — debit and credit the wrong way round inverts a whole statement and leaves every total looking plausible.";
                                color: FinTheme.ink-dim; font-size: 11px; wrap: word-wrap;
                            }
                            for m in root.import-map: HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text { text: m.label; color: FinTheme.ink-dim;
                                        font-size: 11.5px; min-width: 130px; }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    AppIcon { source: Icons.arrow-right; tint: FinTheme.ink-dim;
                                        width: 12px; height: 12px; }
                                }
                                // Editable when the file had a header row to offer.
                                // An OFX states its own structure, so its mapping
                                // stays read-only rather than pretending to be a
                                // choice.
                                if m.kind == "dropdown": ComboBox {
                                    model: m.options;
                                    current-value: m.value;
                                    horizontal-stretch: 1;
                                    selected(v) => { root.set-field(m.key, v); }
                                }
                                if m.kind != "dropdown": Text {
                                    text: m.value == "" ? "not found" : m.value;
                                    color: m.value == "" ? FinTheme.warn : FinTheme.ink;
                                    font-size: 11.5px; font-weight: 600;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                        }

                        if root.sheet == "rates": VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "The ten most traded currencies, checked once a day. Every rate is held against the base, so any pair converts through it. A rate you type is kept and never overwritten — and none of this touches money already posted: a transaction stores the rate that was in force when it was entered, so a refresh changes what is still to come and nothing that has already happened.";
                                color: FinTheme.ink-dim; font-size: 11.5px; wrap: word-wrap;
                            }
                            for r in root.rates: Rectangle {
                                min-height: 46px; max-height: 46px;
                                background: transparent;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 0;
                                        // The code on its own square, the same badge
                                        // the accounts grid uses, so a currency is
                                        // findable by shape rather than by reading.
                                        AccountBadge {
                                            glyph: r.code;
                                            hue: r.known
                                                ? (r.live ? FinTheme.accent : FinTheme.warn)
                                                : FinTheme.ink-dim;
                                            side: 34px;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: r.name; color: FinTheme.ink;
                                            font-size: 12.5px; font-weight: 700;
                                            overflow: elide; }
                                        Text {
                                            text: r.rate;
                                            color: r.known ? FinTheme.ink-dim : FinTheme.warn;
                                            font-size: 11px; overflow: elide;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 0;
                                        spacing: 2px;
                                        Text {
                                            text: r.inverse; color: FinTheme.ink-dim;
                                            font-size: 11px;
                                            horizontal-alignment: right;
                                        }
                                        Text {
                                            text: r.edited; color: FinTheme.ink-dim;
                                            font-size: 10px;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px; width: parent.width;
                                    background: FinTheme.hairline;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                Btn {
                                    label: root.rates-busy ? "Checking…" : "Check now";
                                    icon: Icons.refresh-cw; h: 32px;
                                    enabled: !root.rates-busy;
                                    clicked => { root.rates-refresh(); }
                                }
                            }
                        }

                        // ── amortisation schedule ───────────────────────────
                        if root.schedule.length > 0: VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Amortisation"; color: FinTheme.ink;
                                    font-size: 12.5px; font-weight: 700;
                                    vertical-alignment: center; horizontal-stretch: 1; }
                                // Ten at a time. A twenty-year loan is 240
                                // instalments and the sheet built every one of
                                // them before showing anything.
                                IconBtn { icon: Icons.chevron-left;
                                    enabled: root.schedule-page > 1;
                                    clicked => { root.schedule-step(-1); } }
                                Text {
                                    text: "\{root.schedule-page} of \{root.schedule-pages}";
                                    color: FinTheme.ink-dim; font-size: 11.5px;
                                    vertical-alignment: center;
                                }
                                IconBtn { icon: Icons.chevron-right;
                                    enabled: root.schedule-page < root.schedule-pages;
                                    clicked => { root.schedule-step(1); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                HeadCell { label: "#"; w: 34px; sortable: false; }
                                HeadCell { label: "DUE"; w: 88px; sortable: false; }
                                HeadCell { label: "PAYMENT"; w: 92px; right: true;
                                    sortable: false; }
                                HeadCell { label: "PRINCIPAL"; w: 92px; right: true;
                                    sortable: false; }
                                HeadCell { label: "INTEREST"; w: 92px; right: true;
                                    sortable: false; }
                                HeadCell { label: "LEFT"; flex: true; right: true;
                                    sortable: false; }
                            }
                            for i in root.schedule: Rectangle {
                                min-height: 30px; max-height: 30px;
                                background: transparent;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Cell { text: "\{i.n}"; w: 34px; dim: true; }
                                    Cell { text: i.due; w: 88px; dim: true; }
                                    Cell { text: i.emi; w: 92px; right: true; strong: true; }
                                    Cell { text: i.principal; w: 92px; right: true;
                                        ink: FinTheme.good; }
                                    Cell { text: i.interest; w: 92px; right: true;
                                        ink: FinTheme.warn; }
                                    Cell { text: i.balance; flex: true; right: true; dim: true; }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px; width: parent.width;
                                    background: FinTheme.hairline;
                                }
                            }
                        }

                        // ── import preview ──────────────────────────────────
                        if root.sheet == "import": VerticalLayout {
                            spacing: 10px;
                            if root.import-needs-format: Rectangle {
                                border-radius: Surface.rr(12px, self.width, self.height);
                                background: FinTheme.warn.with-alpha(0.14);
                                VerticalLayout {
                                    padding: 12px; spacing: 4px;
                                    Text { text: "Which way round are the dates?";
                                        color: FinTheme.ink; font-size: 12.5px;
                                        font-weight: 700; }
                                    Text {
                                        text: "Every date in this file has both parts at 12 or below, so the file cannot say whether 05/07 is 5 July or 7 May. Guessing would shift the whole statement by months without anything looking wrong.";
                                        color: FinTheme.ink-dim; font-size: 11.5px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            if root.import-summary != "": Text {
                                text: root.import-summary; color: FinTheme.ink-dim;
                                font-size: 11.5px; wrap: word-wrap;
                            }
                            if root.import-rows.length > 0: VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    HeadCell { label: "DATE"; w: 88px; sortable: false; }
                                    HeadCell { label: "DESCRIPTION"; flex: true;
                                        sortable: false; }
                                    HeadCell { label: "AMOUNT"; w: 104px; right: true;
                                        sortable: false; }
                                }
                                for r in root.import-rows: HorizontalLayout {
                                    spacing: 8px;
                                    Cell { text: r.date; w: 88px; dim: true; }
                                    Cell { text: r.description; flex: true; }
                                    Cell {
                                        text: r.amount; w: 104px; right: true; strong: true;
                                        ink: r.credit ? FinTheme.good : FinTheme.ink;
                                    }
                                }
                            }
                        }

                        // ── detected recurring charges ──────────────────────
                        if root.proposals.length > 0: VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "These look like they repeat. Nothing is created until you say so, and none of them will post money on their own.";
                                color: FinTheme.ink-dim; font-size: 11.5px; wrap: word-wrap;
                            }
                            for p in root.proposals: Rectangle {
                                min-height: 58px; max-height: 58px;
                                border-radius: Surface.rr(12px, self.width, self.height);
                                background: FinTheme.card-2;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 1; spacing: 3px;
                                        HorizontalLayout {
                                            spacing: 8px; alignment: start;
                                            Text { text: p.name; color: FinTheme.ink;
                                                font-size: 13px; font-weight: 600;
                                                vertical-alignment: center; }
                                            Pill { label: p.kind; hue: FinTheme.accent; }
                                            if p.confidence == "low": Pill {
                                                label: "worth checking"; hue: FinTheme.warn; }
                                        }
                                        Text {
                                            text: "\{p.cycle} · \{p.occurrences} "
                                                  + "charges seen · next \{p.next-due}";
                                            color: FinTheme.ink-dim; font-size: 11px;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 0;
                                        Text { text: p.amount; color: FinTheme.ink;
                                            font-size: 13px; font-weight: 700;
                                            horizontal-alignment: right; }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 0;
                                        Btn { label: "Add"; h: 28px; primary: true;
                                            clicked => { root.accept-proposal(p.idx); } }
                                    }
                                }
                            }
                        }
                    }
                }

                // An answer, not a complaint: what the chosen category's envelope
                // has left, or which fields came off a photographed receipt.
                if root.sheet-note != "": Rectangle {
                    border-radius: Surface.rr(10px, self.width, self.height);
                    background: FinTheme.accent.with-alpha(0.10);
                    VerticalLayout {
                        padding: 10px;
                        Text {
                            text: root.sheet-note; color: FinTheme.ink;
                            font-size: 11.5px; wrap: word-wrap;
                        }
                    }
                }

                if root.sheet-error != "": Text {
                    text: root.sheet-error; color: FinTheme.bad; font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px; alignment: end;
                    Btn { label: "Cancel"; clicked => { root.close-sheet(); } }
                    // Only on the forms where entering several in a row is normal.
                    // Offering it on a reconcile or a prepayment would be offering
                    // to repeat something that happens once.
                    if root.sheet-primary != "" && (root.sheet == "txn" || root.sheet == "due"
                                                    || root.sheet == "one-off" || root.sheet == "budget"): Btn {
                        label: "Save & add another";
                        enabled: !root.sheet-busy;
                        clicked => { root.submit-again(); }
                    }
                    if root.sheet-primary != "": Btn {
                        label: root.sheet-busy ? "Working…" : root.sheet-primary;
                        primary: true;
                        enabled: !root.sheet-busy;
                        clicked => { root.submit-sheet(); }
                    }
                }
            }
        }
        }
    }
}
