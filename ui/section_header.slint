// Shared two-tier-header primitives. Every content page (Photos · Videos ·
// Music · Books · Cloud · Tools) builds the same header *shape* from these,
// passing its own accent + light/dark canvas so the per-app theme is preserved.
// Modeled on the Photos page header (the reference look).
import { AppIcon, Icons } from "icons.slint";

// Pill tab / action chip. Generalizes the old GPhotoChip / VideoTab / MusicTab /
// ViewTab. Light pages: grey pill, dark text. Dark pages: faint glass pill with
// a hairline border. Active = accent fill. `blink` flashes a green confirm.
export component HdrChip inherits Rectangle {
    in property <string> label;
    in property <image> icon;               // optional leading icon
    in property <color> accent: #1a73e8;
    in property <color> active-text: #ffffff;   // gold accents want dark text here
    in property <bool> active: false;
    in property <bool> dark: false;
    in property <bool> blink: false;
    // Overridable dark-branch colours so a themed caller (e.g. Music's light
    // mode) can supply readable surfaces/text instead of the baked white alphas.
    in property <color> dk-idle:   #ffffff0d;
    in property <color> dk-hover:  #ffffff1a;
    in property <color> dk-text:   #d6d6da;
    in property <color> dk-border: #ffffff22;
    // Colored-gradient variant: when has-grad, the chip carries its own vivid hue
    // (idle = faint tint wash, active/hover = full gradient) so a row of chips can
    // read as 5 distinct colors in both light and dark themes.
    in property <brush> grad;
    in property <bool> has-grad: false;
    in property <color> tint: #ec4899;
    // Light-mode flag so colored (has-grad) chips can darken their text + deepen
    // the idle wash for readability on a light canvas.
    in property <bool> light-theme: false;
    callback clicked();
    height: 36px; min-width: 84px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: self.height / 2;
    clip: true;
    background: has-grad
        ? (active ? grad : (touch.has-hover
            ? tint.with-alpha(light-theme ? 0.34 : 0.30)
            : tint.with-alpha(light-theme ? 0.20 : 0.15)))
        : (active
            ? accent
            : (dark
                ? (touch.has-hover ? dk-hover : dk-idle)
                : (touch.has-hover ? #e8eaed : #f1f3f4)));
    border-width: has-grad ? (active ? 0px : 1px) : ((dark && !active) ? 1px : 0px);
    border-color: has-grad ? tint.with-alpha(light-theme ? 0.85 : 0.55) : dk-border;
    animate background { duration: 140ms; easing: ease-out; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    // On a light canvas the bright tints (teal/amber) wash out — darken the
    // idle text so it stays legible; active text stays white on the gradient.
    // Inactive coloured chips: darken on light, brighten toward white on dark
    // so the label stays legible against the faint tint wash either way.
    property <color> lbl-color: active ? active-text : (has-grad ? (light-theme ? tint.mix(#000000, 0.72) : tint.mix(#ffffff, 0.5)) : (dark ? dk-text : #3c4043));
    HorizontalLayout { alignment: center; spacing: root.label == "" ? 0px : 7px; padding-left: 4px; padding-right: 4px;
        if root.icon.width > 0: VerticalLayout { alignment: center; AppIcon { source: root.icon; tint: root.lbl-color; width: 15px; height: 15px; } }
        // Icon-only chips (label == "") drop the Text so the chip can shrink to a
        // compact square — keeps row-2 tab rows from clipping on scaled displays.
        if root.label != "": Text {
            text: label; font-size: 13px; font-weight: has-grad ? 700 : 600;
            color: root.lbl-color;
            vertical-alignment: center;
        }
    }
    // Green confirmation flash overlay (used by Photos' star/archive tabs).
    Rectangle {
        width: 100%; height: 100%; border-radius: parent.border-radius;
        background: #34a853;
        opacity: root.blink ? 0.9 : 0;
        animate opacity { duration: 280ms; easing: ease-in-out; }
        HorizontalLayout { alignment: center; spacing: 6px; visible: root.blink;
            VerticalLayout { alignment: center; AppIcon { source: Icons.check; tint: #ffffff; width: 14px; height: 14px; } }
            Text {
                text: root.label; color: #ffffff; font-size: 13px; font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}

// 44px / fully-rounded search pill with 🔍, placeholder, and a clear-✕ that
// only shows while there's a query. `width` is fixed by default but pages can
// override; `dark` flips the colors for the cinematic pages.
export component HdrSearch inherits Rectangle {
    in property <bool> dark: false;
    in property <string> placeholder: "Search";
    in-out property <string> query: "";
    callback edited(string);
    callback cleared();
    width: 360px; height: 44px; border-radius: 22px;
    horizontal-stretch: 0; vertical-stretch: 0;
    background: dark ? #ffffff14 : #f1f3f4;
    border-width: dark ? 1px : 0px;
    border-color: #ffffff22;
    HorizontalLayout {
        padding-left: 18px; padding-right: 10px; spacing: 8px;
        VerticalLayout { alignment: center; AppIcon { source: Icons.search; tint: dark ? #9a9aa2 : #5f6368; width: 16px; height: 16px; } }
        Rectangle {
            horizontal-stretch: 1;
            qi := TextInput {
                width: 100%; height: 100%;
                text <=> root.query;
                color: dark ? #ffffff : #202124; font-size: 14px;
                vertical-alignment: center; single-line: true;
                edited => { root.edited(self.text); }
            }
            if root.query == "": Text {
                text: root.placeholder; color: dark ? #9a9aa2 : #5f6368; font-size: 14px;
                vertical-alignment: center; height: 100%;
                visible: !qi.has-focus;
            }
        }
        if root.query != "": Rectangle {
            width: 28px; height: 28px; border-radius: 14px;
            horizontal-stretch: 0; vertical-stretch: 0;
            y: (parent.height - self.height) / 2;
            background: dark ? (clearx.has-hover ? #ffffff33 : #ffffff22)
                             : (clearx.has-hover ? #d7dadd : #e3e6e8);
            clearx := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.query = ""; root.edited(""); root.cleared(); }
            }
            AppIcon { source: Icons.x; tint: dark ? #e8e8ea : #3c4043; width: 13px; height: 13px; }
        }
    }
}

// Accent-filled count pill. One or two segments separated by "·". Pinned at the
// far right of row 1 (e.g. "🖼 124 photos · 📁 6 folders").
export component CountPill inherits Rectangle {
    in property <color> accent: #ea4335;
    in property <color> text-color: #ffffff;
    in property <string> seg1;
    in property <string> seg2: "";
    height: 44px; border-radius: 22px; background: accent;
    horizontal-stretch: 0; vertical-stretch: 0;
    HorizontalLayout {
        padding-left: 18px; padding-right: 18px; spacing: 10px;
        Text { text: root.seg1; color: text-color; font-size: 12px; font-weight: 700; vertical-alignment: center; }
        if root.seg2 != "": Text { text: "·"; color: text-color.with-alpha(0.8); vertical-alignment: center; }
        if root.seg2 != "": Text { text: root.seg2; color: text-color; font-size: 12px; font-weight: 700; vertical-alignment: center; }
    }
}
