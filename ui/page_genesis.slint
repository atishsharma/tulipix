// Genesis — book search and download, a sub-page of the Books section.
//
// One `phase` enum drives every state this page can be in, rather than five
// booleans that can disagree with each other:
//
//   idle      — nothing searched yet
//   probing   — finding a mirror whose *search* works (3-15 s on a cold start)
//   searching — a query is out
//   ready     — results, or an honest "no results"
//   failed    — every mirror refused, with the reasons
//
// `probing` earns its own state: mirrors are health-checked by running a real
// search, because plenty of them serve a healthy front page while their search
// endpoint 500s. That check is slow, and without something on screen naming it,
// the wait reads as a hang.
import { Theme } from "tokens.slint";
import { BookTheme } from "page_books.slint";
import { ScrollView } from "std-widgets.slint";
import { AppIcon, Icons } from "icons.slint";

// One row of search results. `have` marks a book already in the download
// history, keyed on MD5 — the catalogue's own identity for a file.
export struct GenesisRow {
    md5: string,
    title: string,
    author: string,
    year: string,
    language: string,
    pages: string,
    size: string,
    format: string,
    have: bool,
}

// One topic the search can be scoped to. Multi-select; the mirror takes them
// as repeated query parameters.
export struct GenesisTopic { code: string, label: string, on: bool }

// ── a pill, used for topics and for the field/format/language pickers ───────
component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    callback clicked();
    horizontal-stretch: 0; height: 32px; border-radius: 16px;
    background: root.on ? BookTheme.tint-violet : BookTheme.pill-bg;
    border-width: 1.5px;
    border-color: root.on ? BookTheme.accent.with-alpha(0.45) : transparent;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; alignment: center;
        Text {
            text: root.label;
            color: root.on ? BookTheme.accent
                : (ta.has-hover ? BookTheme.ink : BookTheme.ink-dim);
            font-size: 12.5px; font-weight: 600; vertical-alignment: center;
        }
    }
    animate background, border-color { duration: 120ms; }
}

// ── a dropdown-looking value picker ─────────────────────────────────────────
// Cycles through its options on click rather than opening a menu: there are at
// most seven, and a popup that has to be positioned by hand is a lot of
// machinery for "next value".
component Picker inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked();
    horizontal-stretch: 0; height: 32px; border-radius: 16px;
    background: BookTheme.pill-bg;
    border-width: 1.5px;
    border-color: ta.has-hover ? BookTheme.accent.with-alpha(0.4) : BookTheme.hairline;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px; padding-right: 10px; spacing: 7px; alignment: center;
        Text {
            text: root.label; color: BookTheme.ink-dim; font-size: 12.5px;
            vertical-alignment: center;
        }
        Text {
            text: root.value; color: BookTheme.ink; font-size: 12.5px; font-weight: 600;
            vertical-alignment: center;
        }
        AppIcon {
            source: Icons.chevron-down; tint: BookTheme.ink-dim;
            width: 13px; height: 13px;
        }
    }
    animate border-color { duration: 120ms; }
}

// ── the mirror status chip in the header ────────────────────────────────────
// Names the host that answered and how long it took. Not decoration: failover
// between mirrors is otherwise completely silent.
component MirrorChip inherits Rectangle {
    in property <string> text;
    in property <string> tone;   // ok | warn | bad
    horizontal-stretch: 0; height: 32px; border-radius: 16px;
    property <color> hue:
        root.tone == "ok"   ? #22c55e :
        root.tone == "warn" ? #f59e0b :
                              #ef4444;
    background: root.hue.with-alpha(0.13);
    HorizontalLayout {
        padding-left: 13px; padding-right: 15px; spacing: 8px; alignment: center;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Rectangle { width: 7px; height: 7px; border-radius: 4px; background: root.hue; }
        }
        Text {
            text: root.text; color: BookTheme.ink; font-size: 12px; font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// ── a skeleton line, for the searching state ────────────────────────────────
// Width comes from the caller: a component's own root cannot read `parent`, so
// a proportional width has to be computed where the parent is in scope.
component Skel inherits Rectangle {
    height: 12px; border-radius: 6px;
    background: BookTheme.track;
    opacity: 0.55;
    animate opacity { duration: 700ms; iteration-count: -1; direction: alternate; }
    init => { self.opacity = 1.0; }
}

// ── one big centred message, for idle / empty / failed ──────────────────────
component EmptyState inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <image> icon;
    in property <color> tint: BookTheme.accent;
    height: 300px;
    VerticalLayout {
        alignment: center; spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 52px; height: 52px; border-radius: 16px;
                background: root.tint.with-alpha(0.13);
                AppIcon {
                    source: root.icon; tint: root.tint; width: 26px; height: 26px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        Rectangle { height: 6px; background: transparent; }
        Text {
            text: root.title; color: BookTheme.ink; font-size: 16px; font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.body; color: BookTheme.ink-dim; font-size: 13px;
            horizontal-alignment: center; wrap: word-wrap;
        }
        @children
    }
}

export component GenesisPage inherits Rectangle {
    in property <string> phase: "idle";   // idle|probing|searching|ready|failed
    in property <string> status: "";
    in property <string> mirror: "";
    in property <string> mirror-tone: "ok";
    in property <string> error: "";
    in property <[GenesisRow]> rows: [];
    in property <[GenesisTopic]> topics: [];
    in property <string> field: "Any";
    in property <string> format: "Any";
    in property <string> language: "Any";
    in property <string> dest: "";
    // Empty when no Books library folder is configured. Downloading somewhere
    // the library cannot see is worse than refusing, so the Get buttons go
    // dead and this says why.
    in property <bool> can-download: true;
    // Download in flight.
    in property <bool> busy: false;
    in property <string> busy-name: "";
    in property <float> busy-pct: 0.0;
    in property <string> busy-detail: "";
    // Shown for a few seconds after a download lands.
    in property <string> done-name: "";
    in property <string> done-detail: "";

    in-out property <string> terms: "";

    callback back();
    callback search();
    callback download(string);
    callback cancel();
    callback toggle-topic(string);
    callback cycle-field();
    callback cycle-format();
    callback cycle-language();
    callback retry();
    callback open-dest();

    background: BookTheme.canvas;

    VerticalLayout {
        padding: 24px; spacing: 18px;

        // ── header ──────────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    width: 38px; height: 38px; border-radius: 12px;
                    background: backt.has-hover ? BookTheme.track : BookTheme.pill-bg;
                    backt := TouchArea { mouse-cursor: pointer; clicked => { root.back(); } }
                    AppIcon {
                        source: Icons.chevron-left; tint: BookTheme.ink;
                        width: 18px; height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    width: 40px; height: 40px; border-radius: 12px;
                    background: BookTheme.tint-violet;
                    AppIcon {
                        source: Icons.download; tint: BookTheme.accent;
                        width: 21px; height: 21px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text {
                    text: "Genesis"; color: BookTheme.ink; font-size: 26px; font-weight: 800;
                    vertical-alignment: center;
                }
            }
            if root.mirror != "": VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                MirrorChip { text: root.mirror; tone: root.mirror-tone; }
            }
        }

        // ── search row ──────────────────────────────────────────────────────
        // No debounce: each search is a network round trip, so it fires on
        // Enter and on the button, never per keystroke.
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                horizontal-stretch: 1; height: 52px; border-radius: 26px;
                background: ti.has-focus ? BookTheme.card : BookTheme.pill-bg;
                border-width: 1.5px;
                border-color: ti.has-focus
                    ? BookTheme.accent.with-alpha(0.55) : BookTheme.hairline;
                animate background, border-color { duration: 120ms; }
                HorizontalLayout {
                    padding-left: 20px; padding-right: 16px; spacing: 12px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        AppIcon {
                            source: Icons.search; tint: BookTheme.ink-dim;
                            width: 19px; height: 19px;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.terms == "": Text {
                            text: "Title, author, series or ISBN";
                            x: 0; color: BookTheme.ink-dim; font-size: 15px;
                            vertical-alignment: center; horizontal-alignment: left;
                        }
                        ti := TextInput {
                            width: 100%; height: 100%;
                            vertical-alignment: center; single-line: true;
                            color: BookTheme.ink; font-size: 15px;
                            text <=> root.terms;
                            selection-background-color: BookTheme.accent.with-alpha(0.3);
                            accepted => { root.search(); }
                        }
                    }
                    if root.terms != "": VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            width: 28px; height: 28px; border-radius: 14px;
                            background: clr.has-hover ? BookTheme.track : transparent;
                            clr := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.terms = ""; }
                            }
                            AppIcon {
                                source: Icons.x; tint: BookTheme.ink-dim;
                                width: 14px; height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    height: 52px; min-width: 128px; border-radius: 26px;
                    background: go.has-hover
                        ? BookTheme.accent.darker(0.1) : BookTheme.accent;
                    go := TouchArea { mouse-cursor: pointer; clicked => { root.search(); } }
                    Text {
                        text: "Search"; color: #ffffff; font-size: 14px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    animate background { duration: 120ms; }
                }
            }
        }

        // ── filters ─────────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 9px; alignment: start;
            for t in root.topics: Chip {
                label: t.label; on: t.on;
                clicked => { root.toggle-topic(t.code); }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle { width: 1px; height: 22px; background: BookTheme.hairline; }
            }
            Picker { label: "Field"; value: root.field; clicked => { root.cycle-field(); } }
            Picker { label: "Format"; value: root.format; clicked => { root.cycle-format(); } }
            Picker { label: "Language"; value: root.language; clicked => { root.cycle-language(); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }

        // ── body ────────────────────────────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            border-radius: 16px;
            background: BookTheme.card;
            border-width: 1px; border-color: BookTheme.hairline;
            clip: true;

            if root.phase == "idle": EmptyState {
                title: "Search for a book";
                body: root.can-download
                    ? "Results come from Library Genesis mirrors. Downloads land in "
                      + root.dest + ", which is watched by your library."
                    : "The download folder could not be created, so there is nowhere for a book to land.";
                icon: Icons.search;
                tint: root.can-download ? BookTheme.accent : #f59e0b;
            }

            if root.phase == "probing": EmptyState {
                title: "Finding a working mirror…";
                // Said plainly because the wait is real and otherwise looks
                // like a hang.
                body: root.status != "" ? root.status
                    : "Mirrors often serve a healthy front page while search is down, so each one is checked with a real query.";
                icon: Icons.wifi;
                tint: #f59e0b;
            }

            if root.phase == "searching": VerticalLayout {
                padding: 16px; spacing: 0px; alignment: start;
                for i in 6: Rectangle {
                    height: 62px;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 14px;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1;
                            Rectangle {
                                height: 12px;
                                Skel { x: 0; width: parent.width * 0.7; }
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Rectangle {
                                width: 180px; height: 12px;
                                Skel { x: 0; width: parent.width * 0.8; }
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Rectangle {
                                width: 90px; height: 12px;
                                Skel { x: 0; width: parent.width * 0.7; }
                            }
                        }
                    }
                }
            }

            if root.phase == "failed": EmptyState {
                title: "Every mirror failed";
                body: root.error;
                icon: Icons.triangle-alert;
                tint: #ef4444;
                Rectangle { height: 8px; background: transparent; }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 38px; min-width: 118px; border-radius: 19px;
                        background: rt.has-hover ? BookTheme.accent.darker(0.1) : BookTheme.accent;
                        rt := TouchArea { mouse-cursor: pointer; clicked => { root.retry(); } }
                        Text {
                            text: "Try again"; color: #ffffff;
                            font-size: 13px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }

            if root.phase == "ready" && root.rows.length == 0: EmptyState {
                title: "No results";
                // Filters run after the mirror truncates, so a narrow one is
                // the usual reason a real title comes back empty.
                body: "Nothing matched on " + root.mirror
                    + ". Format and language are applied after the mirror answers, so a narrow filter is the usual cause.";
                icon: Icons.search;
                tint: BookTheme.ink-dim;
            }

            if root.phase == "ready" && root.rows.length > 0: VerticalLayout {
                spacing: 0px;

                // Column header. Widths repeat on every row below — Slint has
                // no grid that spans a repeater, so the two are kept in step by
                // hand. Every column but Title is pinned min == max, because a
                // stretch factor divides only *leftover* width and would give
                // wildly uneven columns.
                Rectangle {
                    height: 40px; background: BookTheme.pill-bg;
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; spacing: 12px;
                        Text {
                            text: "TITLE"; color: BookTheme.ink-dim; font-size: 10.5px;
                            font-weight: 700; letter-spacing: 0.8px;
                            horizontal-stretch: 1; vertical-alignment: center;
                        }
                        Text {
                            text: "AUTHOR"; color: BookTheme.ink-dim; font-size: 10.5px;
                            font-weight: 700; letter-spacing: 0.8px;
                            min-width: 180px; max-width: 180px; horizontal-stretch: 0;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "YEAR"; color: BookTheme.ink-dim; font-size: 10.5px;
                            font-weight: 700; letter-spacing: 0.8px;
                            min-width: 54px; max-width: 54px; horizontal-stretch: 0;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "LANG"; color: BookTheme.ink-dim; font-size: 10.5px;
                            font-weight: 700; letter-spacing: 0.8px;
                            min-width: 78px; max-width: 78px; horizontal-stretch: 0;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "PAGES"; color: BookTheme.ink-dim; font-size: 10.5px;
                            font-weight: 700; letter-spacing: 0.8px;
                            min-width: 56px; max-width: 56px; horizontal-stretch: 0;
                            horizontal-alignment: right; vertical-alignment: center;
                        }
                        Text {
                            text: "SIZE"; color: BookTheme.ink-dim; font-size: 10.5px;
                            font-weight: 700; letter-spacing: 0.8px;
                            min-width: 78px; max-width: 78px; horizontal-stretch: 0;
                            horizontal-alignment: right; vertical-alignment: center;
                        }
                        Text {
                            text: "FORMAT"; color: BookTheme.ink-dim; font-size: 10.5px;
                            font-weight: 700; letter-spacing: 0.8px;
                            min-width: 74px; max-width: 74px; horizontal-stretch: 0;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 106px; horizontal-stretch: 0; background: transparent;
                        }
                    }
                }

                res := ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: reslist.preferred-height;
                    // A new search must open at the top, or the second search
                    // starts scrolled to wherever the first one was left.
                    property <int> watch: root.rows.length;
                    changed watch => { self.viewport-y = 0; }
                    init => { self.viewport-y = 0; }

                    reslist := VerticalLayout {
                        width: parent.width;
                        alignment: start;

                        for r in root.rows: Rectangle {
                            height: 58px;
                            background: rowt.has-hover ? BookTheme.pill-bg : transparent;
                            rowt := TouchArea { }
                            Rectangle {
                                y: parent.height - 1px; height: 1px;
                                background: BookTheme.hairline;
                            }
                            HorizontalLayout {
                                padding-left: 18px; padding-right: 18px; spacing: 12px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Text {
                                        text: r.title; color: BookTheme.ink;
                                        font-size: 13px; font-weight: 600; overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text {
                                        text: r.author; color: BookTheme.ink-dim;
                                        font-size: 12.5px; overflow: elide;
                                        min-width: 180px; max-width: 180px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text {
                                        text: r.year; color: BookTheme.ink-dim; font-size: 12.5px;
                                        min-width: 54px; max-width: 54px; overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text {
                                        text: r.language; color: BookTheme.ink-dim; font-size: 12.5px;
                                        min-width: 78px; max-width: 78px; overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text {
                                        text: r.pages; color: BookTheme.ink-dim; font-size: 12.5px;
                                        min-width: 56px; max-width: 56px;
                                        horizontal-alignment: right;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text {
                                        text: r.size; color: BookTheme.ink-dim; font-size: 12.5px;
                                        min-width: 78px; max-width: 78px;
                                        horizontal-alignment: right;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Rectangle {
                                        min-width: 74px; max-width: 74px;
                                        HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                height: 22px; border-radius: 6px;
                                                horizontal-stretch: 0;
                                                background: BookTheme.tint-blue;
                                                HorizontalLayout {
                                                    padding-left: 9px; padding-right: 9px;
                                                    Text {
                                                        text: r.format; color: BookTheme.ink;
                                                        font-size: 10.5px; font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                // Already downloaded: a check, not a button.
                                // The history is keyed on MD5, so this never
                                // offers the same file twice.
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Rectangle {
                                        min-width: 106px; max-width: 106px; height: 32px;
                                        if r.have: HorizontalLayout {
                                            alignment: end; spacing: 6px;
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                AppIcon {
                                                    source: Icons.check; tint: #22c55e;
                                                    width: 15px; height: 15px;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                Text {
                                                    text: "In library"; color: #22c55e;
                                                    font-size: 12px; font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        if !r.have: Rectangle {
                                            x: parent.width - self.width;
                                            width: 88px; height: 32px; border-radius: 16px;
                                            opacity: root.can-download && !root.busy ? 1.0 : 0.4;
                                            background: dlt.has-hover && root.can-download && !root.busy
                                                ? BookTheme.tint-violet : transparent;
                                            border-width: 1.5px;
                                            border-color: dlt.has-hover && root.can-download && !root.busy
                                                ? BookTheme.accent.with-alpha(0.5)
                                                : BookTheme.hairline;
                                            dlt := TouchArea {
                                                mouse-cursor: root.can-download && !root.busy
                                                    ? pointer : default;
                                                clicked => {
                                                    if (root.can-download && !root.busy) {
                                                        root.download(r.md5);
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                alignment: center; spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center; horizontal-stretch: 0;
                                                    AppIcon {
                                                        source: Icons.download;
                                                        tint: dlt.has-hover && root.can-download && !root.busy
                                                            ? BookTheme.accent : BookTheme.ink-dim;
                                                        width: 14px; height: 14px;
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center; horizontal-stretch: 0;
                                                    Text {
                                                        text: "Get";
                                                        color: dlt.has-hover && root.can-download && !root.busy
                                                            ? BookTheme.accent : BookTheme.ink;
                                                        font-size: 12.5px; font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            animate background, border-color { duration: 120ms; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── download strip ──────────────────────────────────────────────────
        if root.busy: Rectangle {
            height: 66px; border-radius: 14px;
            background: BookTheme.pill-bg;
            border-width: 1px; border-color: BookTheme.hairline;
            HorizontalLayout {
                padding: 14px; spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1; alignment: center; spacing: 7px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.busy-name; color: BookTheme.ink; font-size: 13px;
                            font-weight: 600; overflow: elide; horizontal-stretch: 1;
                        }
                        Text {
                            text: root.busy-detail; color: BookTheme.ink-dim;
                            font-size: 12px; horizontal-stretch: 0;
                        }
                    }
                    Rectangle {
                        height: 6px; border-radius: 3px; background: BookTheme.track;
                        Rectangle {
                            x: 0; y: 0; height: parent.height; border-radius: 3px;
                            width: parent.width * root.busy-pct;
                            background: BookTheme.accent;
                            animate width { duration: 200ms; easing: ease-out; }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        height: 34px; min-width: 90px; border-radius: 17px;
                        background: cx.has-hover ? BookTheme.track : transparent;
                        border-width: 1.5px; border-color: BookTheme.hairline;
                        cx := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(); } }
                        Text {
                            text: "Cancel"; color: BookTheme.ink;
                            font-size: 12.5px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }

        if !root.busy && root.done-name != "": Rectangle {
            height: 62px; border-radius: 14px;
            background: BookTheme.tint-green;
            HorizontalLayout {
                padding: 14px; spacing: 14px;
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: 32px; height: 32px; border-radius: 16px;
                        background: #22c55e.with-alpha(0.2);
                        AppIcon {
                            source: Icons.check; tint: #22c55e; width: 16px; height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1; spacing: 3px;
                    Text {
                        text: "Added to library — " + root.done-name;
                        color: BookTheme.ink; font-size: 13px; font-weight: 600; overflow: elide;
                    }
                    Text {
                        text: root.done-detail; color: BookTheme.ink-dim; font-size: 11.5px;
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        height: 32px; min-width: 96px; border-radius: 16px;
                        background: opn.has-hover ? BookTheme.card : transparent;
                        border-width: 1.5px; border-color: #22c55e.with-alpha(0.4);
                        opn := TouchArea { mouse-cursor: pointer; clicked => { root.open-dest(); } }
                        Text {
                            text: "Show file"; color: BookTheme.ink;
                            font-size: 12px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }
    }
}
