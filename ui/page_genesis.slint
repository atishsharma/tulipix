// Genesis — book search and download, a sub-page of the Books section.
//
// One `phase` enum drives every state this page can be in, rather than five
// booleans that can disagree with each other:
//
//   idle      — nothing searched yet
//   probing   — finding a mirror whose *search* works (3-15 s on a cold start)
//   searching — a query is out
//   ready     — results, or an honest "no results"
//   failed    — every mirror refused, with the reasons
//
// `probing` earns its own state: mirrors are health-checked by running a real
// search, because plenty of them serve a healthy front page while their search
// endpoint 500s. That check is slow, and without something on screen naming it,
// the wait reads as a hang.
import { Theme } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";
import { BookTheme } from "page_books.slint";
import { ScrollView } from "std-widgets.slint";
import { AppIcon, Icons } from "icons.slint";

// One row of search results. `have` marks a book already in the download
// history, keyed on MD5 — the catalogue's own identity for a file.
export struct GenesisRow {
    md5: string,
    title: string,
    author: string,
    year: string,
    language: string,
    pages: string,
    size: string,
    format: string,
    have: bool,
}

// One topic the search can be scoped to. Multi-select; the mirror takes them
// as repeated query parameters.
export struct GenesisTopic { code: string, label: string, on: bool }

// ── a pill, used for topics and for the field/format/language pickers ───────
component Chip inherits Skin {
    in property <string> label;
    in property <bool> on: false;
    callback clicked();
    horizontal-stretch: 0; height: 32px; border-radius: Surface.r(16px);
    background: root.on ? BookTheme.tint-violet : BookTheme.pill-bg;
    border-width: 1.5px;
    border-color: root.on ? BookTheme.accent.with-alpha(0.45) : transparent;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; alignment: center;
        Text {
            text: root.label;
            color: root.on ? BookTheme.accent
                : (ta.has-hover ? BookTheme.ink : BookTheme.ink-dim);
            font-size: 12.5px; font-weight: 600; vertical-alignment: center;
        }
    }
    animate background, border-color { duration: 120ms; }
}

// ── a dropdown-looking value picker ─────────────────────────────────────────
// Cycles through its options on click rather than opening a menu: there are at
// most seven, and a popup that has to be positioned by hand is a lot of
// machinery for "next value".
component Picker inherits Skin {
    in property <string> label;
    in property <string> value;
    callback clicked();
    horizontal-stretch: 0; height: 32px; border-radius: Surface.r(16px);
    background: BookTheme.pill-bg;
    border-width: 1.5px;
    border-color: ta.has-hover ? BookTheme.accent.with-alpha(0.4) : BookTheme.hairline;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px; padding-right: 10px; spacing: 7px; alignment: center;
        Text {
            text: root.label; color: BookTheme.ink-dim; font-size: 12.5px;
            vertical-alignment: center;
        }
        Text {
            text: root.value; color: BookTheme.ink; font-size: 12.5px; font-weight: 600;
            vertical-alignment: center;
        }
        AppIcon {
            source: Icons.chevron-down; tint: BookTheme.ink-dim;
            width: 13px; height: 13px;
        }
    }
    animate border-color { duration: 120ms; }
}

// ── one page-step arrow ─────────────────────────────────────────────────────
// Stays in place when it cannot move — a control that disappears at the ends
// makes the row jump width every time the last page is reached.
component PageArrow inherits Skin {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    horizontal-stretch: 0; width: 32px; height: 32px;
    border-radius: Surface.r(16px);
    opacity: root.enabled ? 1.0 : 0.35;
    background: root.enabled && ta.has-hover ? BookTheme.tint-violet : BookTheme.pill-bg;
    border-width: 1.5px;
    border-color: root.enabled && ta.has-hover
        ? BookTheme.accent.with-alpha(0.5) : BookTheme.hairline;
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    AppIcon {
        source: root.icon;
        tint: root.enabled && ta.has-hover ? BookTheme.accent : BookTheme.ink-dim;
        width: 14px; height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    animate background, border-color, opacity { duration: 120ms; }
}

// ── a clickable column header ───────────────────────────────────────────────
// Carries the arrow for the column it sorts by. Sorting happens over the whole
// result set, so the arrow describes the table, not the page.
component SortHead inherits Skin {
    in property <string> label;
    in property <string> key;
    in property <string> active;
    in property <bool> desc: false;
    in property <bool> align-right: false;
    callback clicked();
    property <bool> on: root.active == root.key;
    horizontal-stretch: 0; height: 100%;
    background: transparent;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        spacing: 4px;
        alignment: root.align-right ? end : start;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Text {
                text: root.label;
                color: root.on ? BookTheme.accent
                    : (ta.has-hover ? BookTheme.ink : BookTheme.ink-dim);
                font-size: 10.5px; font-weight: 700; letter-spacing: 0.8px;
                vertical-alignment: center;
            }
        }
        // Reserved even when unsorted, so a header does not shift sideways the
        // first time it is clicked.
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Rectangle {
                width: 10px; height: 10px; background: transparent;
                if root.on: AppIcon {
                    source: root.desc ? Icons.chevron-down : Icons.chevron-up;
                    tint: BookTheme.accent; width: 10px; height: 10px;
                }
            }
        }
    }
}

// ── the mirror status chip in the header ────────────────────────────────────
// Names the host that answered and how long it took. Not decoration: failover
// between mirrors is otherwise completely silent.
component MirrorChip inherits Skin {
    in property <string> text;
    in property <string> tone;   // ok | warn | bad
    horizontal-stretch: 0; height: 32px; border-radius: Surface.r(16px);
    property <color> hue:
        root.tone == "ok"   ? #22c55e :
        root.tone == "warn" ? #f59e0b :
                              #ef4444;
    background: root.hue.with-alpha(0.13);
    HorizontalLayout {
        padding-left: 13px; padding-right: 15px; spacing: 8px; alignment: center;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Rectangle { width: 7px; height: 7px; border-radius: Surface.r(4px); background: root.hue; }
        }
        Text {
            text: root.text; color: BookTheme.ink; font-size: 12px; font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// ── a skeleton line, for the searching state ────────────────────────────────
// Width comes from the caller: a component's own root cannot read `parent`, so
// a proportional width has to be computed where the parent is in scope.
component Skel inherits Skin {
    height: 12px; border-radius: Surface.r(6px);
    background: BookTheme.track;
    opacity: 0.55;
    animate opacity { duration: 700ms; iteration-count: -1; direction: alternate; }
    init => { self.opacity = 1.0; }
}

// ── one big centred message, for idle / empty / failed ──────────────────────
component EmptyState inherits Skin {
    in property <string> title;
    in property <string> body;
    in property <image> icon;
    in property <color> tint: BookTheme.accent;
    height: 300px;
    VerticalLayout {
        alignment: center; spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 52px; height: 52px; border-radius: Surface.r(16px);
                background: root.tint.with-alpha(0.13);
                AppIcon {
                    source: root.icon; tint: root.tint; width: 26px; height: 26px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        Rectangle { height: 6px; background: transparent; }
        Text {
            text: root.title; color: BookTheme.ink; font-size: 16px; font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.body; color: BookTheme.ink-dim; font-size: 13px;
            horizontal-alignment: center; wrap: word-wrap;
        }
        @children
    }
}

export component GenesisPage inherits Rectangle {
    in property <string> phase: "idle";   // idle|probing|searching|ready|failed
    in property <string> status: "";
    in property <string> mirror: "";
    in property <string> mirror-tone: "ok";
    in property <string> error: "";
    in property <[GenesisRow]> rows: [];
    in property <[GenesisTopic]> topics: [];
    in property <string> field: "Any";
    in property <string> format: "Any";
    in property <string> language: "Any";
    in property <string> dest: "";
    // Empty when no Books library folder is configured. Downloading somewhere
    // the library cannot see is worse than refusing, so the Get buttons go
    // dead and this says why.
    in property <bool> can-download: true;
    // Download in flight.
    in property <bool> busy: false;
    in property <string> busy-name: "";
    in property <float> busy-pct: 0.0;
    in property <string> busy-detail: "";
    // Shown for a few seconds after a download lands.
    in property <string> done-name: "";
    in property <string> done-detail: "";

    // ── result table: sorting + pagination ──
    // Both run over the whole result set in Rust, not over the twelve rows on
    // screen — sorting a page in place would only shuffle that page.
    in property <int> page: 0;
    in property <int> pages: 0;
    in property <int> total: 0;
    // "" = mirror order. Otherwise title|author|year|language|pages|size|format.
    in property <string> sort: "";
    in property <bool> sort-desc: false;

    // ── settings ──
    in-out property <bool> settings-open: false;
    // Newline-separated mirror list, most-preferred first. Empty = the built-in
    // seed list.
    in-out property <string> mirrors: "";
    in property <string> mirrors-default: "";
    in property <bool> settings-saved: false;
    // The mirror that answered the last search, as a full URL — the one thing
    // that tells you *where* the books are actually coming from.
    in property <string> active-url: "";

    in-out property <string> terms: "";

    callback back();
    callback search();
    callback download(string);
    callback cancel();
    callback toggle-topic(string);
    callback cycle-field();
    callback cycle-format();
    callback cycle-language();
    callback retry();
    callback open-dest();
    callback set-page(int);
    callback sort-clicked(string);
    callback settings-opened();
    callback settings-save();
    callback settings-reset();
    callback pick-dest();

    background: BookTheme.canvas;

    VerticalLayout {
        padding: 24px; spacing: 18px;

        // ── header ──────────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 14px;
            // Back — outlined in the section accent so it reads as a control
            // rather than as a blank tile in the corner.
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    width: 38px; height: 38px; border-radius: Surface.r(12px);
                    background: backt.has-hover
                        ? BookTheme.tint-violet : BookTheme.pill-bg;
                    border-width: 1.5px;
                    border-color: backt.has-hover
                        ? BookTheme.accent : BookTheme.accent.with-alpha(0.45);
                    backt := TouchArea { mouse-cursor: pointer; clicked => { root.back(); } }
                    AppIcon {
                        source: Icons.chevron-left;
                        tint: backt.has-hover ? BookTheme.accent : BookTheme.ink;
                        width: 18px; height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    animate background, border-color { duration: 120ms; }
                }
            }
            // Logo and wordmark share one outlined plate — two loose elements
            // beside a search bar read as decoration; a bordered lockup reads as
            // the name of the thing.
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    height: 46px; border-radius: 23px;
                    background: BookTheme.tint-violet;
                    border-width: 1.5px;
                    border-color: BookTheme.accent.with-alpha(0.5);
                    HorizontalLayout {
                        padding-left: 7px; padding-right: 18px; spacing: 10px;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Rectangle {
                                width: 32px; height: 32px; border-radius: Surface.r(11px);
                                background: BookTheme.accent;
                                AppIcon {
                                    source: Icons.download; tint: #ffffff;
                                    width: 17px; height: 17px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Text {
                                text: "Genesis"; color: BookTheme.ink;
                                font-size: 22px; font-weight: 800;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            if root.mirror != "": VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                MirrorChip { text: root.mirror; tone: root.mirror-tone; }
            }
            // Settings — download folder, mirror list, and the address the
            // results are actually coming from.
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    width: 38px; height: 38px; border-radius: Surface.r(12px);
                    background: setb.has-hover || root.settings-open
                        ? BookTheme.tint-violet : BookTheme.pill-bg;
                    border-width: 1.5px;
                    border-color: root.settings-open
                        ? BookTheme.accent : BookTheme.accent.with-alpha(0.35);
                    setb := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.settings-open = true; root.settings-opened(); }
                    }
                    AppIcon {
                        source: Icons.settings;
                        tint: root.settings-open ? BookTheme.accent : BookTheme.ink;
                        width: 18px; height: 18px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    animate background, border-color { duration: 120ms; }
                }
            }
        }

        // ── search row ──────────────────────────────────────────────────────
        // No debounce: each search is a network round trip, so it fires on
        // Enter and on the button, never per keystroke.
        HorizontalLayout {
            spacing: 12px;
            // Filled in the section tint rather than left on the page colour —
            // it is the one control the page exists for, and a bare outline put
            // it level with the filter pills below it.
            Rectangle {
                horizontal-stretch: 1; height: 52px; border-radius: 26px;
                background: BookTheme.tint-violet;
                border-width: 1.5px;
                border-color: ti.has-focus
                    ? BookTheme.accent : BookTheme.accent.with-alpha(0.4);
                animate background, border-color { duration: 120ms; }
                HorizontalLayout {
                    padding-left: 20px; padding-right: 16px; spacing: 12px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        AppIcon {
                            source: Icons.search; tint: BookTheme.ink-dim;
                            width: 19px; height: 19px;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.terms == "": Text {
                            text: "Title, author, series or ISBN";
                            x: 0; color: BookTheme.ink-dim; font-size: 15px;
                            vertical-alignment: center; horizontal-alignment: left;
                        }
                        ti := TextInput {
                            width: 100%; height: 100%;
                            vertical-alignment: center; single-line: true;
                            color: BookTheme.ink; font-size: 15px;
                            text <=> root.terms;
                            selection-background-color: BookTheme.accent.with-alpha(0.3);
                            accepted => { root.search(); }
                        }
                    }
                    if root.terms != "": VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            width: 28px; height: 28px; border-radius: Surface.r(14px);
                            background: clr.has-hover ? BookTheme.track : transparent;
                            clr := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.terms = ""; }
                            }
                            AppIcon {
                                source: Icons.x; tint: BookTheme.ink-dim;
                                width: 14px; height: 14px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    height: 52px; min-width: 128px; border-radius: 26px;
                    background: go.has-hover
                        ? BookTheme.accent.darker(0.1) : BookTheme.accent;
                    go := TouchArea { mouse-cursor: pointer; clicked => { root.search(); } }
                    Text {
                        text: "Search"; color: #ffffff; font-size: 14px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                    animate background { duration: 120ms; }
                }
            }
        }

        // ── filters ─────────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 9px; alignment: start;
            for t in root.topics: Chip {
                label: t.label; on: t.on;
                clicked => { root.toggle-topic(t.code); }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle { width: 1px; height: 22px; background: BookTheme.hairline; }
            }
            Picker { label: "Field"; value: root.field; clicked => { root.cycle-field(); } }
            Picker { label: "Format"; value: root.format; clicked => { root.cycle-format(); } }
            Picker { label: "Language"; value: root.language; clicked => { root.cycle-language(); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }

            // Pager, right edge of this row rather than under the table: the
            // table scrolls, so a control below it is off screen exactly when
            // it is wanted. Hidden on a single page — a Previous and Next that
            // can never do anything is noise.
            if root.pages > 1: VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                HorizontalLayout {
                    spacing: 6px;
                    PageArrow {
                        icon: Icons.chevron-left;
                        enabled: root.page > 0;
                        clicked => { root.set-page(root.page - 1); }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Text {
                            text: (root.page + 1) + " / " + root.pages
                                + "  ·  " + root.total + " results";
                            color: BookTheme.ink-dim; font-size: 12px; font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    PageArrow {
                        icon: Icons.chevron-right;
                        enabled: root.page + 1 < root.pages;
                        clicked => { root.set-page(root.page + 1); }
                    }
                }
            }
        }

        // ── body ────────────────────────────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            border-radius: Surface.r(16px);
            background: BookTheme.card;
            border-width: 1px; border-color: BookTheme.hairline;
            clip: true;

            if root.phase == "idle": EmptyState {
                title: "Search for a book";
                body: root.can-download
                    ? "Results come from Library Genesis mirrors. Downloads land in "
                      + root.dest + ", which is watched by your library."
                    : "The download folder could not be created, so there is nowhere for a book to land.";
                icon: Icons.search;
                tint: root.can-download ? BookTheme.accent : #f59e0b;
            }

            if root.phase == "probing": EmptyState {
                title: "Finding a working mirror…";
                // Said plainly because the wait is real and otherwise looks
                // like a hang.
                body: root.status != "" ? root.status
                    : "Mirrors often serve a healthy front page while search is down, so each one is checked with a real query.";
                icon: Icons.wifi;
                tint: #f59e0b;
            }

            if root.phase == "searching": VerticalLayout {
                padding: 16px; spacing: 0px; alignment: start;
                for i in 6: Rectangle {
                    height: 62px;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 14px;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1;
                            Rectangle {
                                height: 12px;
                                Skel { x: 0; width: parent.width * 0.7; }
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Rectangle {
                                width: 180px; height: 12px;
                                Skel { x: 0; width: parent.width * 0.8; }
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Rectangle {
                                width: 90px; height: 12px;
                                Skel { x: 0; width: parent.width * 0.7; }
                            }
                        }
                    }
                }
            }

            if root.phase == "failed": EmptyState {
                title: "Every mirror failed";
                body: root.error;
                icon: Icons.triangle-alert;
                tint: #ef4444;
                Rectangle { height: 8px; background: transparent; }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        height: 38px; min-width: 118px; border-radius: Surface.r(19px);
                        background: rt.has-hover ? BookTheme.accent.darker(0.1) : BookTheme.accent;
                        rt := TouchArea { mouse-cursor: pointer; clicked => { root.retry(); } }
                        Text {
                            text: "Try again"; color: #ffffff;
                            font-size: 13px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }

            if root.phase == "ready" && root.rows.length == 0: EmptyState {
                title: "No results";
                // Filters run after the mirror truncates, so a narrow one is
                // the usual reason a real title comes back empty.
                body: "Nothing matched on " + root.mirror
                    + ". Format and language are applied after the mirror answers, so a narrow filter is the usual cause.";
                icon: Icons.search;
                tint: BookTheme.ink-dim;
            }

            if root.phase == "ready" && root.rows.length > 0: VerticalLayout {
                spacing: 0px;

                // Column header. Widths repeat on every row below — Slint has
                // no grid that spans a repeater, so the two are kept in step by
                // hand. Every column but Title is pinned min == max, because a
                // stretch factor divides only *leftover* width and would give
                // wildly uneven columns.
                Rectangle {
                    height: 40px; background: BookTheme.pill-bg;
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; spacing: 12px;
                        // Title is the one column that stretches; the rest are
                        // pinned min == max so a stretch factor cannot divide
                        // leftover width unevenly between them.
                        SortHead {
                            label: "TITLE"; key: "title"; horizontal-stretch: 1;
                            active: root.sort; desc: root.sort-desc;
                            clicked => { root.sort-clicked("title"); }
                        }
                        SortHead {
                            label: "AUTHOR"; key: "author";
                            min-width: 180px; max-width: 180px;
                            active: root.sort; desc: root.sort-desc;
                            clicked => { root.sort-clicked("author"); }
                        }
                        SortHead {
                            label: "YEAR"; key: "year";
                            min-width: 54px; max-width: 54px;
                            active: root.sort; desc: root.sort-desc;
                            clicked => { root.sort-clicked("year"); }
                        }
                        SortHead {
                            label: "LANG"; key: "language";
                            min-width: 78px; max-width: 78px;
                            active: root.sort; desc: root.sort-desc;
                            clicked => { root.sort-clicked("language"); }
                        }
                        SortHead {
                            label: "PAGES"; key: "pages"; align-right: true;
                            min-width: 56px; max-width: 56px;
                            active: root.sort; desc: root.sort-desc;
                            clicked => { root.sort-clicked("pages"); }
                        }
                        SortHead {
                            label: "SIZE"; key: "size"; align-right: true;
                            min-width: 78px; max-width: 78px;
                            active: root.sort; desc: root.sort-desc;
                            clicked => { root.sort-clicked("size"); }
                        }
                        SortHead {
                            label: "FORMAT"; key: "format";
                            min-width: 74px; max-width: 74px;
                            active: root.sort; desc: root.sort-desc;
                            clicked => { root.sort-clicked("format"); }
                        }
                        Rectangle {
                            width: 106px; horizontal-stretch: 0; background: transparent;
                        }
                    }
                }

                res := ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: reslist.preferred-height;
                    // A new search must open at the top, or the second search
                    // starts scrolled to wherever the first one was left. Page
                    // is watched separately: two full pages have the same row
                    // count, so length alone would not notice the turn.
                    property <int> watch: root.rows.length;
                    property <int> watch-page: root.page;
                    changed watch => { self.viewport-y = 0; }
                    changed watch-page => { self.viewport-y = 0; }
                    init => { self.viewport-y = 0; }

                    reslist := VerticalLayout {
                        width: parent.width;
                        alignment: start;

                        for r in root.rows: Rectangle {
                            height: 58px;
                            background: rowt.has-hover ? BookTheme.pill-bg : transparent;
                            rowt := TouchArea { }
                            Rectangle {
                                y: parent.height - 1px; height: 1px;
                                background: BookTheme.hairline;
                            }
                            HorizontalLayout {
                                padding-left: 18px; padding-right: 18px; spacing: 12px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Text {
                                        text: r.title; color: BookTheme.ink;
                                        font-size: 13px; font-weight: 600; overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text {
                                        text: r.author; color: BookTheme.ink-dim;
                                        font-size: 12.5px; overflow: elide;
                                        min-width: 180px; max-width: 180px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text {
                                        text: r.year; color: BookTheme.ink-dim; font-size: 12.5px;
                                        min-width: 54px; max-width: 54px; overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text {
                                        text: r.language; color: BookTheme.ink-dim; font-size: 12.5px;
                                        min-width: 78px; max-width: 78px; overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text {
                                        text: r.pages; color: BookTheme.ink-dim; font-size: 12.5px;
                                        min-width: 56px; max-width: 56px;
                                        horizontal-alignment: right;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Text {
                                        text: r.size; color: BookTheme.ink-dim; font-size: 12.5px;
                                        min-width: 78px; max-width: 78px;
                                        horizontal-alignment: right;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Rectangle {
                                        min-width: 74px; max-width: 74px;
                                        HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                height: 22px; border-radius: Surface.r(6px);
                                                horizontal-stretch: 0;
                                                background: BookTheme.tint-blue;
                                                HorizontalLayout {
                                                    padding-left: 9px; padding-right: 9px;
                                                    Text {
                                                        text: r.format; color: BookTheme.ink;
                                                        font-size: 10.5px; font-weight: 700;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                // Already downloaded: a check, not a button.
                                // The history is keyed on MD5, so this never
                                // offers the same file twice.
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Rectangle {
                                        min-width: 106px; max-width: 106px; height: 32px;
                                        if r.have: HorizontalLayout {
                                            alignment: end; spacing: 6px;
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                AppIcon {
                                                    source: Icons.check; tint: #22c55e;
                                                    width: 15px; height: 15px;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; horizontal-stretch: 0;
                                                Text {
                                                    text: "In library"; color: #22c55e;
                                                    font-size: 12px; font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        if !r.have: Rectangle {
                                            x: parent.width - self.width;
                                            width: 88px; height: 32px; border-radius: Surface.r(16px);
                                            opacity: root.can-download && !root.busy ? 1.0 : 0.4;
                                            background: dlt.has-hover && root.can-download && !root.busy
                                                ? BookTheme.tint-violet : transparent;
                                            border-width: 1.5px;
                                            border-color: dlt.has-hover && root.can-download && !root.busy
                                                ? BookTheme.accent.with-alpha(0.5)
                                                : BookTheme.hairline;
                                            dlt := TouchArea {
                                                mouse-cursor: root.can-download && !root.busy
                                                    ? pointer : default;
                                                clicked => {
                                                    if (root.can-download && !root.busy) {
                                                        root.download(r.md5);
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                alignment: center; spacing: 6px;
                                                VerticalLayout {
                                                    alignment: center; horizontal-stretch: 0;
                                                    AppIcon {
                                                        source: Icons.download;
                                                        tint: dlt.has-hover && root.can-download && !root.busy
                                                            ? BookTheme.accent : BookTheme.ink-dim;
                                                        width: 14px; height: 14px;
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center; horizontal-stretch: 0;
                                                    Text {
                                                        text: "Get";
                                                        color: dlt.has-hover && root.can-download && !root.busy
                                                            ? BookTheme.accent : BookTheme.ink;
                                                        font-size: 12.5px; font-weight: 600;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            animate background, border-color { duration: 120ms; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── download strip ──────────────────────────────────────────────────
        if root.busy: Rectangle {
            height: 66px; border-radius: Surface.r(14px);
            background: BookTheme.pill-bg;
            border-width: 1px; border-color: BookTheme.hairline;
            HorizontalLayout {
                padding: 14px; spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1; alignment: center; spacing: 7px;
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: root.busy-name; color: BookTheme.ink; font-size: 13px;
                            font-weight: 600; overflow: elide; horizontal-stretch: 1;
                        }
                        Text {
                            text: root.busy-detail; color: BookTheme.ink-dim;
                            font-size: 12px; horizontal-stretch: 0;
                        }
                    }
                    Rectangle {
                        height: 6px; border-radius: Surface.r(3px); background: BookTheme.track;
                        Rectangle {
                            x: 0; y: 0; height: parent.height; border-radius: Surface.r(3px);
                            width: parent.width * root.busy-pct;
                            background: BookTheme.accent;
                            animate width { duration: 200ms; easing: ease-out; }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        height: 34px; min-width: 90px; border-radius: Surface.r(17px);
                        background: cx.has-hover ? BookTheme.track : transparent;
                        border-width: 1.5px; border-color: BookTheme.hairline;
                        cx := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(); } }
                        Text {
                            text: "Cancel"; color: BookTheme.ink;
                            font-size: 12.5px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }

        if !root.busy && root.done-name != "": Rectangle {
            height: 62px; border-radius: Surface.r(14px);
            background: BookTheme.tint-green;
            HorizontalLayout {
                padding: 14px; spacing: 14px;
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: 32px; height: 32px; border-radius: Surface.r(16px);
                        background: #22c55e.with-alpha(0.2);
                        AppIcon {
                            source: Icons.check; tint: #22c55e; width: 16px; height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1; spacing: 3px;
                    Text {
                        text: "Added to library — " + root.done-name;
                        color: BookTheme.ink; font-size: 13px; font-weight: 600; overflow: elide;
                    }
                    Text {
                        text: root.done-detail; color: BookTheme.ink-dim; font-size: 11.5px;
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        height: 32px; min-width: 96px; border-radius: Surface.r(16px);
                        background: opn.has-hover ? BookTheme.card : transparent;
                        border-width: 1.5px; border-color: #22c55e.with-alpha(0.4);
                        opn := TouchArea { mouse-cursor: pointer; clicked => { root.open-dest(); } }
                        Text {
                            text: "Show file"; color: BookTheme.ink;
                            font-size: 12px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }
    }

    // ── settings ────────────────────────────────────────────────────────────
    // Declared after the layout, which is what puts it on top: Slint paints in
    // declaration order.
    if root.settings-open: FocusScope {
        width: 100%; height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.settings-open = false; return accept; }
            return reject;
        }
        Rectangle {
            background: #000000.with-alpha(0.55);
            TouchArea { clicked => { root.settings-open = false; } }
            Rectangle {
                width: min(560px, parent.width - 48px);
                height: min(560px, parent.height - 48px);
                border-radius: BookTheme.radius;
                background: BookTheme.card;
                border-width: 1px; border-color: BookTheme.hairline;
                drop-shadow-blur: Surface.cast(40px);
                drop-shadow-color: Surface.cast-ink(#00000055);
                drop-shadow-offset-y: Surface.cast-y(24px);
                // Without this, a click inside would fall through to the scrim
                // and close the dialog.
                TouchArea {}
                VerticalLayout {
                    padding: 24px; spacing: 14px;

                    HorizontalLayout {
                        spacing: 10px; vertical-stretch: 0;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Rectangle {
                                width: 4px; height: 20px; border-radius: Surface.r(2px);
                                background: BookTheme.accent;
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1;
                            Text {
                                text: "Genesis settings"; color: BookTheme.ink;
                                font-size: 17px; font-weight: 800; vertical-alignment: center;
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Rectangle {
                                width: 30px; height: 30px; border-radius: Surface.r(15px);
                                background: xs.has-hover ? BookTheme.track : transparent;
                                xs := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.settings-open = false; }
                                }
                                AppIcon {
                                    source: Icons.x; tint: BookTheme.ink-dim;
                                    width: 14px; height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }

                    // ── download folder ──
                    // Everything that lands here is registered as a library
                    // root, so the books show up in My Library without a
                    // separate import step. Changing it re-registers the new
                    // one; the old folder keeps whatever is already in it.
                    Text {
                        text: "Download folder"; color: BookTheme.ink-dim;
                        font-size: 11px; font-weight: 700; letter-spacing: 0.6px;
                        vertical-stretch: 0;
                    }
                    HorizontalLayout {
                        spacing: 8px; vertical-stretch: 0;
                        Rectangle {
                            horizontal-stretch: 1; height: 40px;
                            border-radius: Surface.r(10px);
                            background: BookTheme.pill-bg;
                            border-width: 1px; border-color: BookTheme.hairline;
                            clip: true;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                Text {
                                    text: root.dest == "" ? "not set" : root.dest;
                                    color: root.dest == "" ? BookTheme.ink-dim : BookTheme.ink;
                                    font-size: 12.5px; vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Rectangle {
                                height: 40px; min-width: 96px;
                                border-radius: Surface.r(10px);
                                background: pd.has-hover
                                    ? BookTheme.accent.darker(0.1) : BookTheme.accent;
                                pd := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.pick-dest(); }
                                }
                                Text {
                                    text: "Change…"; color: #ffffff;
                                    font-size: 12.5px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: parent.width; height: parent.height;
                                }
                                animate background { duration: 120ms; }
                            }
                        }
                    }
                    Text {
                        text: "Watched by your library — anything downloaded here shows up in Books without importing it by hand.";
                        color: BookTheme.ink-dim; font-size: 11px; wrap: word-wrap;
                        vertical-stretch: 0;
                    }

                    // ── the mirror that is answering right now ──
                    if root.active-url != "": Rectangle {
                        height: 54px; border-radius: Surface.r(12px);
                        background: BookTheme.tint-green;
                        vertical-stretch: 0;
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; spacing: 10px;
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Rectangle {
                                    width: 8px; height: 8px; border-radius: Surface.r(4px);
                                    background: #22c55e;
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 1; spacing: 2px;
                                Text {
                                    text: "Working mirror"; color: BookTheme.ink-dim;
                                    font-size: 10px; font-weight: 700; letter-spacing: 0.6px;
                                }
                                Text {
                                    text: root.active-url; color: BookTheme.ink;
                                    font-size: 12.5px; font-weight: 600; overflow: elide;
                                }
                            }
                        }
                    }

                    // ── mirror list ──
                    Text {
                        text: "Mirrors — one per line, tried top to bottom";
                        color: BookTheme.ink-dim; font-size: 11px; font-weight: 700;
                        letter-spacing: 0.6px; vertical-stretch: 0;
                    }
                    Rectangle {
                        vertical-stretch: 1; border-radius: Surface.r(10px);
                        background: BookTheme.pill-bg;
                        border-width: 1px;
                        border-color: mi.has-focus ? BookTheme.accent : BookTheme.hairline;
                        clip: true;
                        mi := TextInput {
                            x: 12px; y: 10px;
                            width: parent.width - 24px; height: parent.height - 20px;
                            text <=> root.mirrors;
                            color: BookTheme.ink; font-size: 12.5px;
                            font-family: "monospace";
                            single-line: false; wrap: no-wrap;
                            selection-background-color: BookTheme.accent.with-alpha(0.3);
                        }
                        if root.mirrors == "": Text {
                            x: 13px; y: 11px;
                            text: root.mirrors-default;
                            color: BookTheme.ink-dim; font-size: 12.5px;
                            font-family: "monospace";
                            visible: !mi.has-focus;
                        }
                    }
                    Text {
                        text: "Leave empty for the built-in list. Each entry is health-checked with a real search before it is used — a mirror can serve a fine front page while its search endpoint is down.";
                        color: BookTheme.ink-dim; font-size: 11px; wrap: word-wrap;
                        vertical-stretch: 0;
                    }

                    HorizontalLayout {
                        spacing: 9px; alignment: end; vertical-stretch: 0;
                        Rectangle {
                            height: 38px; min-width: 96px; border-radius: Surface.r(19px);
                            background: rs.has-hover ? BookTheme.track : transparent;
                            border-width: 1.5px; border-color: BookTheme.hairline;
                            rs := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.settings-reset(); }
                            }
                            Text {
                                text: "Reset"; color: BookTheme.ink;
                                font-size: 12.5px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                        }
                        Rectangle {
                            height: 38px; min-width: 120px; border-radius: Surface.r(19px);
                            background: root.settings-saved
                                ? #22c55e
                                : (sv.has-hover ? BookTheme.accent.darker(0.1) : BookTheme.accent);
                            sv := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.settings-save(); }
                            }
                            Text {
                                text: root.settings-saved ? "Saved ✓" : "Save";
                                color: #ffffff; font-size: 12.5px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: parent.width; height: parent.height;
                            }
                            animate background { duration: 120ms; }
                        }
                    }
                }
            }
        }
    }
}
