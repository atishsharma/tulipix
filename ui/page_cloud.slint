// Cloud section — OneDrive language: light canvas, blue accent. Left rail lists
// connected rclone remotes; main pane is a lazy remote-tree file table with a
// breadcrumb. A modal connects a new remote via `rclone config create`.
import { ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { HdrChip, HdrSearch, CountPill } from "section_header.slint";

export struct CloudRemote { name: string, backend: string }
export struct CloudEntry { name: string, is_dir: bool, size: string, modified: string, index: int }

component CmdButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();
    height: 34px; min-width: 96px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 4px;
    background: primary ? #0078d4 : (touch.has-hover ? #eef6fc : transparent);
    border-width: primary ? 0px : 1px;
    border-color: #d2d0ce;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text { text: label; font-size: 13px; font-weight: 600;
        color: primary ? #ffffff : #0078d4;
        horizontal-alignment: center; vertical-alignment: center; }
}

component CtxItem inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();
    height: 32px; horizontal-stretch: 1;
    background: ci.has-hover ? (danger ? #fde7e9 : #eef6fc) : transparent;
    ci := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        Text { text: root.label; color: root.danger ? #c50f1f : #1b1a19; font-size: 13px;
            vertical-alignment: center; horizontal-stretch: 1; }
    }
}

export component CloudPage inherits Rectangle {
    in property <[CloudRemote]> remotes: [];
    in property <string> active-remote: "";
    in property <string> path: "";
    in property <[CloudEntry]> entries: [];
    // Right-click context menu state.
    in-out property <bool> ctx-open: false;
    in-out property <length> ctx-x: 0;
    in-out property <length> ctx-y: 0;
    in-out property <int> ctx-index: 0;
    in-out property <bool> ctx-is-dir: false;
    callback ctx-action(int, string);
    in-out property <string> query: "";
    in property <bool> rclone-ok: true;
    in property <string> status: "";
    in-out property <bool> connect-open: false;
    in-out property <string> form-name: "";
    in-out property <string> form-backend: "drive";
    in-out property <string> form-opts: "";

    callback refresh();
    callback connect-open-dialog();
    callback connect-submit();
    callback connect-cancel();
    callback remote-open(string);
    callback remote-delete(string);
    callback entry-activate(int);
    callback browse-up();
    callback search(string);

    // OneDrive blue — shared so header chips stay on-theme.
    property <color> accent: #0078d4;

    background: #faf9f8;

    VerticalLayout {
        spacing: 0px;

        // Row 1 — title · filter · refresh · connect · count pill.
        Rectangle {
            height: 72px; horizontal-stretch: 1; background: #ffffff;
            border-width: 1px; border-color: #edebe9;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; spacing: 14px;
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Text { text: "Cloud"; color: #1b1a19; font-size: 22px; font-weight: 700; } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    HdrSearch { width: 360px; placeholder: "Filter files";
                        query <=> root.query; edited(q) => { root.search(q); } } }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    HdrChip { label: "↻ Refresh"; accent: root.accent; height: 44px; min-width: 110px; clicked => { root.refresh(); } } }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    HdrChip { label: "+ Connect remote"; accent: root.accent; active: true; height: 44px; min-width: 160px; clicked => { root.connect-open-dialog(); } } }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    CountPill { accent: root.accent; seg1: "☁ " + remotes.length + (remotes.length == 1 ? " remote" : " remotes"); } }
            }
        }

        // Row 2 — breadcrumb · up · item count.
        Rectangle {
            height: 54px; horizontal-stretch: 1; background: #ffffff;
            border-width: 1px; border-color: #edebe9;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; spacing: 10px; alignment: start;
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    HorizontalLayout {
                        spacing: 6px; alignment: start;
                        Text { text: active-remote == "" ? "My remotes" : active-remote; color: root.accent; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                        if path != "": Text { text: "›"; color: #8a8886; font-size: 13px; vertical-alignment: center; }
                        if path != "": Text { text: path; color: #605e5c; font-size: 13px; vertical-alignment: center; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if active-remote != "": VerticalLayout { alignment: center; horizontal-stretch: 0;
                    HdrChip { label: "‹ Up"; accent: root.accent; min-width: 72px; clicked => { root.browse-up(); } } }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Text { text: entries.length + " items"; color: #605e5c; font-size: 12px; vertical-alignment: center; } }
            }
        }

        // rclone-missing banner.
        if !rclone-ok: Rectangle {
            height: 34px; background: #fde7e9; border-width: 1px; border-color: #f3c9cd;
            Text { text: "rclone not found — install rclone (or bundle it) to connect remotes.";
                color: #a4262c; font-size: 12px; vertical-alignment: center;
                horizontal-alignment: center; }
        }
        if status != "": Rectangle {
            height: 28px; background: #f3f2f1;
            Text { text: status; color: #605e5c; font-size: 11px; vertical-alignment: center;
                horizontal-alignment: center; }
        }

        HorizontalLayout {
            // Left rail — remotes list.
            Rectangle {
                width: 230px; horizontal-stretch: 0; vertical-stretch: 1; background: #f3f2f1;
                border-width: 1px; border-color: #edebe9;
                VerticalLayout {
                    padding: 12px; spacing: 4px; alignment: start;
                    Text { text: "REMOTES"; color: #8a8886; font-size: 10px; font-weight: 700; }
                    if remotes.length == 0: Text { text: "None connected"; color: #a19f9d; font-size: 12px; }
                    for r[i] in remotes: Rectangle {
                        height: 44px; border-radius: 4px;
                        background: r.name == active-remote ? #deecf9 : (rta.has-hover ? #eef6fc : transparent);
                        rta := TouchArea { mouse-cursor: pointer; clicked => { root.remote-open(r.name); } }
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 6px; spacing: 8px;
                            Text { text: "☁"; color: #0078d4; font-size: 18px; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 1;
                                Text { text: r.name; color: #1b1a19; font-size: 13px; font-weight: 600; overflow: elide; }
                                Text { text: r.backend; color: #8a8886; font-size: 10px; }
                            }
                            Rectangle {
                                width: 24px; height: 24px; border-radius: 4px; y: (parent.height - self.height)/2;
                                background: dta.has-hover ? #f3d6d8 : transparent;
                                dta := TouchArea { mouse-cursor: pointer; clicked => { root.remote-delete(r.name); } }
                                Text { text: "🗑"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }

            // Main file pane.
            VerticalLayout {
                horizontal-stretch: 1; spacing: 0px;
                // table header
                Rectangle {
                    height: 34px; horizontal-stretch: 1; background: transparent;
                    border-width: 1px; border-color: #edebe9;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        Text { text: "Name"; color: #605e5c; font-size: 12px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "Modified"; color: #605e5c; font-size: 12px; font-weight: 700; vertical-alignment: center; width: 130px; }
                        Text { text: "Size"; color: #605e5c; font-size: 12px; font-weight: 700; vertical-alignment: center; width: 90px; }
                    }
                }
                // body
                Rectangle {
                    vertical-stretch: 1; horizontal-stretch: 1; background: #ffffff;
                    border-width: 1px; border-color: #edebe9;

                    if active-remote == "": VerticalLayout {
                        alignment: center; spacing: 12px;
                        HorizontalLayout { alignment: center;
                            Rectangle { width: 88px; height: 88px; border-radius: 12px; background: #deecf9;
                                Text { text: "☁"; font-size: 40px; color: #0078d4; horizontal-alignment: center; vertical-alignment: center; } } }
                        Text { text: remotes.length == 0 ? "No remotes connected" : "Pick a remote"; color: #1b1a19; font-size: 19px; font-weight: 700; horizontal-alignment: center; }
                        Text { text: "Connect Google Drive, Dropbox, S3 and 70+ more via rclone — then browse, mount, sync and stream."; color: #605e5c; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                        HorizontalLayout { alignment: center; CmdButton { label: "+ Connect remote"; primary: true; clicked => { root.connect-open-dialog(); } } }
                    }

                    if active-remote != "": ScrollView {
                        VerticalLayout {
                            alignment: start;
                            for e[i] in entries: Rectangle {
                                height: 38px;
                                background: eta.has-hover ? #f3f9fd : transparent;
                                eta := TouchArea { mouse-cursor: pointer;
                                    clicked => { root.entry-activate(e.index); }
                                    pointer-event(ev) => {
                                        if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                                            root.ctx-index = e.index;
                                            root.ctx-is-dir = e.is_dir;
                                            root.ctx-x = self.absolute-position.x + self.mouse-x - root.absolute-position.x;
                                            root.ctx-y = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                                            root.ctx-open = true;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px; spacing: 0px;
                                    HorizontalLayout {
                                        horizontal-stretch: 1; spacing: 8px;
                                        Text { text: e.is_dir ? "📁" : "📄"; font-size: 15px; vertical-alignment: center; }
                                        Text { text: e.name; color: #1b1a19; font-size: 13px; vertical-alignment: center; overflow: elide; }
                                    }
                                    Text { text: e.modified; color: #605e5c; font-size: 12px; vertical-alignment: center; width: 130px; }
                                    Text { text: e.size; color: #605e5c; font-size: 12px; vertical-alignment: center; width: 90px; }
                                }
                                Rectangle { x: 0; y: parent.height - 1px; width: parent.width; height: 1px; background: #f3f2f1; }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Connect-remote modal ──
    if connect-open: Rectangle {
        background: #00000055;
        TouchArea { clicked => { /* swallow */ } }
        Rectangle {
            width: 460px; height: 420px; border-radius: 10px; background: #ffffff;
            drop-shadow-blur: 30px; drop-shadow-color: #00000055;
            VerticalLayout {
                padding: 24px; spacing: 14px;
                Text { text: "Connect a remote"; color: #1b1a19; font-size: 18px; font-weight: 700; }
                Text { text: "Shells `rclone config create`. OAuth backends (drive/dropbox) need a token — paste `token={...}` below or run `rclone authorize` first.";
                    color: #605e5c; font-size: 11px; wrap: word-wrap; }

                Text { text: "Name"; color: #323130; font-size: 12px; font-weight: 600; }
                LineEdit { placeholder-text: "gdrive"; text <=> root.form-name; }

                Text { text: "Backend"; color: #323130; font-size: 12px; font-weight: 600; }
                LineEdit { placeholder-text: "drive / s3 / dropbox / webdav / sftp …"; text <=> root.form-backend; }

                Text { text: "Options (key=value per line)"; color: #323130; font-size: 12px; font-weight: 600; }
                Rectangle {
                    vertical-stretch: 1; border-radius: 4px; border-width: 1px; border-color: #d2d0ce;
                    TextEdit { width: 100%; height: 100%; text <=> root.form-opts; }
                }

                HorizontalLayout {
                    spacing: 10px; alignment: end;
                    CmdButton { label: "Cancel"; clicked => { root.connect-cancel(); } }
                    CmdButton { label: "Connect"; primary: true; clicked => { root.connect-submit(); } }
                }
            }
        }
    }

    // ── Right-click context menu ──
    if ctx-open: Rectangle {
        // Full-page catcher to dismiss on outside click / right-click.
        TouchArea {
            mouse-cursor: default;
            clicked => { root.ctx-open = false; }
            pointer-event(ev) => { if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) { root.ctx-open = false; } }
        }
        Rectangle {
            x: min(root.ctx-x, root.width - self.width - 8px);
            y: min(root.ctx-y, root.height - self.height - 8px);
            width: 210px;
            height: menu.preferred-height + 12px;
            border-radius: 8px; background: #ffffff;
            border-width: 1px; border-color: #e1dfdd;
            drop-shadow-blur: 24px; drop-shadow-color: #00000040;
            menu := VerticalLayout {
                padding: 6px; spacing: 0px;
                CtxItem { label: root.ctx-is-dir ? "Open" : "Open / Play"; clicked => { root.ctx-open = false; root.ctx-action(root.ctx-index, "open"); } }
                if !root.ctx-is-dir: CtxItem { label: "Open with default app"; clicked => { root.ctx-open = false; root.ctx-action(root.ctx-index, "openwith"); } }
                CtxItem { label: "Reveal in file manager"; clicked => { root.ctx-open = false; root.ctx-action(root.ctx-index, "reveal"); } }
                if !root.ctx-is-dir: CtxItem { label: "Download a copy"; clicked => { root.ctx-open = false; root.ctx-action(root.ctx-index, "download"); } }
                CtxItem { label: "Copy path"; clicked => { root.ctx-open = false; root.ctx-action(root.ctx-index, "copypath"); } }
                Rectangle { height: 1px; background: #edebe9; }
                CtxItem { label: "Delete"; danger: true; clicked => { root.ctx-open = false; root.ctx-action(root.ctx-index, "delete"); } }
            }
        }
    }
}
