// Transfer section — the desktop half of "a phone on the same Wi-Fi opens a
// URL". Three cards across the top, one per question a person actually has:
//
//   Connection — how do I get in?      QR, address, PIN, what it works with.
//   Send       — how do I give a file? One big target.
//   Receive    — where do files land?  The inbox, and what is arriving.
//
// Recent Transfers is a real table below them, full width.
//
// Identity: orange→amber (Theme.transfer-accent → transfer-accent-2). It is the
// one hue the six existing sections — violet, indigo, pink, emerald, teal,
// cyan — leave free, so a glance at the accent says which section this is.
import { Theme } from "tokens.slint";
import { ScrollView } from "std-widgets.slint";
import { AppIcon, Icons } from "icons.slint";

// One file the desktop is offering. `id` is the tray id, never a path — the
// phone cannot name a file on disk at all.
export struct TransferFile { id: int, name: string, size: string, kind: string }

// One phone that has authenticated, until its 48 hours are up.
export struct TransferDevice { token: string, label: string, seen: string }

// One upload in flight (or just finished). `state` is active | done | failed.
// A success clears itself after a few seconds; a failure stays until dismissed,
// which is what `id` is for.
export struct TransferUp { id: int, name: string, size: string, pct: float, state: string }

// One row of the ledger. `direction` is in | out; `missing` greys a row whose
// file has since been moved or deleted rather than hiding it.
// `stamp` rather than `when`, which is a Slint keyword.
export struct TransferRow {
    direction: string, name: string, path: string, size: string,
    peer: string, status: string, stamp: string,
    kind: string, kindlabel: string, missing: bool,
}

// One address a phone could reach. Both a hotspot and a Wi-Fi link commonly
// qualify at once, so this is a picker rather than a guess.
export struct TransferIface { name: string, ip: string }

// ── gradient action button ──────────────────────────────────────────────────
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    in property <image> icon;
    callback clicked();
    height: 40px; min-width: 118px; border-radius: 10px;
    background: primary
        ? (enabled ? @linear-gradient(135deg, Theme.transfer-accent, Theme.transfer-accent-2) : Theme.panel-2)
        : (touch.has-hover ? Theme.panel-2 : transparent);
    border-width: primary ? 0px : 1px;
    border-color: Theme.outline;
    opacity: enabled ? 1.0 : 0.5;
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    HorizontalLayout {
        alignment: center; spacing: 7px;
        padding-left: 14px; padding-right: 14px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon {
                source: root.icon; width: 15px; height: 15px;
                colorize: root.primary ? #ffffff : Theme.text-dim;
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Text {
                text: root.label; color: root.primary ? #ffffff : Theme.text;
                font-size: 13px; font-weight: 700; vertical-alignment: center;
            }
        }
    }
}

// ── small text button for per-row actions ───────────────────────────────────
component RowBtn inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.text-dim;
    callback clicked();
    horizontal-stretch: 0; height: 28px; min-width: 64px; border-radius: 8px;
    background: touch.has-hover ? Theme.panel-2 : transparent;
    border-width: 1px;
    border-color: root.tint == Theme.error ? Theme.error.with-alpha(0.4) : Theme.outline;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        text: root.label; color: root.tint; font-size: 11.5px; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// ── destructive action, for the one button that throws data away ────────────
// Quiet until the pointer is on it, then it commits to red. Ghost-by-default
// keeps it from competing with the card title it sits beside, and the colour
// arriving on hover is the last warning before the confirm dialog.
component DangerBtn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px; min-width: 124px; border-radius: 10px;
    opacity: root.enabled ? 1.0 : 0.4;
    background: !root.enabled ? transparent
        : (touch.has-hover ? Theme.error.with-alpha(0.14) : Theme.error.with-alpha(0.05));
    border-width: 1px;
    border-color: touch.has-hover && root.enabled
        ? Theme.error.with-alpha(0.55) : Theme.error.with-alpha(0.24);
    animate background, border-color { duration: 130ms; }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    HorizontalLayout {
        alignment: center; spacing: 7px;
        padding-left: 13px; padding-right: 14px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon { source: root.icon; colorize: Theme.error; width: 14px; height: 14px; }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Text {
                text: root.label; color: Theme.error; font-size: 12px; font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}

// ── the card the three panes are built from ─────────────────────────────────
// A tinted circular glyph, a title, a one-line subtitle, then whatever the
// caller puts inside. Same shape every time so the eye can skip the chrome.
component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    in property <color> tint: Theme.transfer-accent;
    // An optional control pinned to the right of the title row. Empty label
    // means no button, which is every card but Recent Transfers.
    in property <string> action;
    in property <image> action-icon;
    in property <bool> action-enabled: true;
    callback action-clicked();
    border-radius: Theme.radius-lg;
    background: Theme.panel;
    border-width: 1px; border-color: Theme.outline;
    drop-shadow-blur: 20px;
    drop-shadow-color: #00000012;
    VerticalLayout {
        padding: 20px; spacing: 16px;
        HorizontalLayout {
            spacing: 13px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    width: 44px; height: 44px; border-radius: 22px;
                    background: root.tint.with-alpha(0.14);
                    AppIcon {
                        source: root.icon; colorize: root.tint; width: 21px; height: 21px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1; spacing: 3px;
                Text { text: root.title; color: Theme.text; font-size: 17px; font-weight: 700; }
                if root.subtitle != "": Text {
                    text: root.subtitle; color: Theme.text-dim; font-size: 12.5px;
                    wrap: word-wrap;
                }
            }
            if root.action != "": VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                DangerBtn {
                    label: root.action;
                    icon: root.action-icon;
                    enabled: root.action-enabled;
                    clicked => { root.action-clicked(); }
                }
            }
        }
        @children
    }
}

// ── one section of the Help panel ───────────────────────────────────────────
// Body text is pre-wrapped prose with its own newlines, so it is one Text with
// word-wrap rather than a list — the platform steps are sentences, not bullets,
// and splitting them into rows would need a model per block for no gain.
component HelpBlock inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <image> icon;
    in property <color> tint: Theme.transfer-accent;
    height: self.preferred-height;
    border-radius: 12px;
    background: Theme.panel-2;
    border-width: 1px; border-color: Theme.outline;
    VerticalLayout {
        padding: 14px; spacing: 9px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    width: 26px; height: 26px; border-radius: 8px;
                    background: root.tint.with-alpha(0.16);
                    AppIcon {
                        source: root.icon; colorize: root.tint; width: 14px; height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text {
                    text: root.title; color: Theme.text; font-size: 13.5px; font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.body; color: Theme.text-dim; font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// ── one pagination step ─────────────────────────────────────────────────────
// Disabled rather than hidden at the ends, so the pair does not jump sideways
// when it reaches the first or last page.
component PageBtn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    // Chevron after the label instead of before it, for Next.
    in property <bool> trailing: false;
    in property <bool> enabled: true;
    callback clicked();
    horizontal-stretch: 0; height: 32px; min-width: 104px; border-radius: 9px;
    opacity: root.enabled ? 1.0 : 0.35;
    background: touch.has-hover && root.enabled ? Theme.panel-2 : transparent;
    border-width: 1px; border-color: Theme.outline;
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    HorizontalLayout {
        alignment: center; spacing: 6px;
        padding-left: 11px; padding-right: 11px;
        if !root.trailing: VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon { source: root.icon; colorize: Theme.text-dim; width: 13px; height: 13px; }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Text {
                text: root.label; color: Theme.text; font-size: 11.5px; font-weight: 600;
                vertical-alignment: center;
            }
        }
        if root.trailing: VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon { source: root.icon; colorize: Theme.text-dim; width: 13px; height: 13px; }
        }
    }
}

// ── one sortable column header ──────────────────────────────────────────────
// The arrow only appears on the active column: six idle chevrons would read as
// six dropdowns. Hover lifts the label so the whole strip still says "clickable"
// before anything has been sorted.
component SortHead inherits Rectangle {
    in property <string> label;
    in property <int> index;
    in property <int> active;
    in property <bool> desc;
    in property <bool> numeric: false;
    callback clicked();
    property <bool> on: root.active == root.index;
    horizontal-stretch: 0;
    background: touch.has-hover ? Theme.outline.with-alpha(0.35) : transparent;
    border-radius: 7px;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 6px; padding-right: 6px; spacing: 4px;
        alignment: root.numeric ? end : start;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Text {
                text: root.label;
                color: root.on ? Theme.transfer-accent
                    : (touch.has-hover ? Theme.text : Theme.text-dim);
                font-size: 11px; font-weight: 700; vertical-alignment: center;
            }
        }
        if root.on: VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon {
                source: root.desc ? Icons.chevron-down : Icons.chevron-up;
                colorize: Theme.transfer-accent; width: 12px; height: 12px;
            }
        }
    }
}

// ── the tinted footer strip each card ends on ───────────────────────────────
component NoteStrip inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> chip;
    in property <image> icon;
    in property <color> tint: Theme.ok;
    border-radius: 12px;
    background: root.tint.with-alpha(0.10);
    border-width: 1px; border-color: root.tint.with-alpha(0.22);
    HorizontalLayout {
        padding: 12px; spacing: 11px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Rectangle {
                width: 30px; height: 30px; border-radius: 15px;
                background: root.tint.with-alpha(0.18);
                AppIcon {
                    source: root.icon; colorize: root.tint; width: 15px; height: 15px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 1; spacing: 2px;
            Text { text: root.title; color: Theme.text; font-size: 12.5px; font-weight: 700; }
            if root.body != "": Text {
                text: root.body; color: Theme.text-dim; font-size: 11px; wrap: word-wrap;
            }
        }
        if root.chip != "": VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Rectangle {
                height: 22px; min-width: 54px; border-radius: 11px;
                background: root.tint.with-alpha(0.20);
                Text {
                    text: root.chip; color: root.tint; font-size: 10.5px; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
            }
        }
    }
}

// ── a read-only field the value can be selected out of ──────────────────────
// Slint has no clipboard API to call, but a TextInput handles Ctrl+C itself —
// so the value is selectable rather than sitting behind a copy button that
// could not work.
component ValueField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> size: 13px;
    in property <color> tone: Theme.text;
    in property <int> weight: 600;
    height: 46px; border-radius: 10px;
    background: Theme.panel-2;
    border-width: 1px; border-color: Theme.outline;
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 8px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 1;
            TextInput {
                text: root.value; read-only: true; single-line: true;
                color: root.tone; font-size: root.size; font-weight: root.weight;
                selection-background-color: Theme.transfer-accent.with-alpha(0.3);
                vertical-alignment: center;
            }
        }
    }
}

// ── one platform chip under the QR ──────────────────────────────────────────
component PlatformChip inherits Rectangle {
    in property <string> label;
    height: 26px; horizontal-stretch: 0; border-radius: 13px;
    background: Theme.panel-2;
    border-width: 1px; border-color: Theme.outline;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; alignment: center;
        Text {
            text: root.label; color: Theme.text-dim; font-size: 11px; font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// ── one interface chip in the address picker ────────────────────────────────
component IfaceChip inherits Rectangle {
    in property <TransferIface> iface;
    in property <bool> active: false;
    callback clicked();
    height: 28px; horizontal-stretch: 0; border-radius: 14px;
    background: root.active ? Theme.transfer-accent.with-alpha(0.18) : Theme.panel-2;
    border-width: 1px;
    border-color: root.active ? Theme.transfer-accent : Theme.outline;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 11px; padding-right: 11px; spacing: 6px; alignment: center;
        Text {
            text: root.iface.ip; color: root.active ? Theme.transfer-accent : Theme.text;
            font-size: 11.5px; font-weight: 700; vertical-alignment: center;
        }
        Text {
            text: root.iface.name; color: Theme.text-dim; font-size: 10.5px;
            vertical-alignment: center;
        }
    }
}

// ── one progress row for an upload in flight ────────────────────────────────
// A success disappears on its own a few seconds after it lands — the permanent
// record is the Recent Transfers row below. A failure has no timer: it is the
// one thing here worth reading late, so it waits to be dismissed.
component UploadRow inherits Rectangle {
    in property <TransferUp> up;
    callback dismiss();
    property <bool> failed: root.up.state == "failed";
    height: root.failed ? 76px : 58px;
    border-radius: 11px;
    background: root.failed ? Theme.error.with-alpha(0.07) : Theme.panel-2;
    border-width: root.failed ? 1px : 0px;
    border-color: Theme.error.with-alpha(0.28);
    property <color> tint:
        root.up.state == "done"   ? Theme.ok :
        root.failed               ? Theme.error :
                                    Theme.transfer-accent;
    VerticalLayout {
        padding: 11px; spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.up.name; color: Theme.text; font-size: 12.5px;
                overflow: elide; horizontal-stretch: 1; vertical-alignment: center;
            }
            Text {
                text: root.up.state == "done"   ? "Done"
                    : root.failed               ? "Failed"
                    : Math.round(root.up.pct * 100) + "%";
                color: root.tint; font-size: 11.5px; font-weight: 700;
                horizontal-stretch: 0; vertical-alignment: center;
            }
        }
        Rectangle {
            height: 4px; border-radius: 2px; background: Theme.outline;
            Rectangle {
                x: 0; y: 0; height: parent.height; border-radius: 2px;
                width: parent.width * (root.up.state == "done" ? 1.0 : root.up.pct);
                background: root.tint;
                animate width { duration: 200ms; easing: ease-out; }
            }
        }
        if !root.failed: Text {
            text: root.up.size; color: Theme.text-dim; font-size: 10.5px;
        }
        // The phone is the sender, so nothing on this end can re-pull the file.
        // Saying where the retry actually lives beats a button that cannot work.
        if root.failed: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text {
                    text: "Send it again from the phone";
                    color: Theme.text-dim; font-size: 10.5px; overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    height: 22px; min-width: 62px; border-radius: 7px;
                    background: dis.has-hover ? Theme.error.with-alpha(0.16) : transparent;
                    border-width: 1px; border-color: Theme.error.with-alpha(0.35);
                    dis := TouchArea { mouse-cursor: pointer; clicked => { root.dismiss(); } }
                    Text {
                        text: "Dismiss"; color: Theme.error;
                        font-size: 10.5px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                }
            }
        }
    }
}

// ── one row of the shared-files tray ────────────────────────────────────────
component TrayRow inherits Rectangle {
    in property <TransferFile> file;
    in property <color> accent;
    callback remove();
    height: 52px; border-radius: 11px;
    background: touch.has-hover ? Theme.panel-2 : Theme.panel-2.with-alpha(0.6);
    touch := TouchArea { }
    HorizontalLayout {
        padding-left: 11px; padding-right: 11px; spacing: 11px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Rectangle {
                width: 32px; height: 32px; border-radius: 9px;
                background: root.accent.with-alpha(0.15);
                Text {
                    text: root.file.kind; color: root.accent;
                    font-size: 9px; font-weight: 800;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 1; spacing: 2px;
            Text { text: root.file.name; color: Theme.text; font-size: 12.5px; overflow: elide; }
            Text { text: root.file.size; color: Theme.text-dim; font-size: 10.5px; }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            RowBtn { label: "Remove"; clicked => { root.remove(); } }
        }
    }
}

export component TransferPage inherits Rectangle {
    in property <bool> running: false;
    in property <string> status: "";
    in property <string> hint: "";
    in property <string> attempts: "";
    in property <string> url: "";
    in property <string> pin: "";
    in property <image> qr;
    in property <[TransferFile]> files: [];
    in property <string> total: "";
    in property <[TransferDevice]> devices: [];
    in property <[TransferUp]> uploads: [];
    in property <[TransferRow]> rows: [];
    in property <[TransferIface]> ifaces: [];
    in property <string> iface: "";
    in property <string> inbox: "";
    in property <bool> inbox-ok: true;
    in property <int> page: 0;
    in property <int> pages: 1;
    // Which column the ledger is ordered by, as the visual index:
    // Name 0 | Size 1 | Type 2 | Status 3 | From/To 4 | Time 5.
    in property <int> sort: 5;
    in property <bool> sort-desc: true;
    in property <int> port: 8420;

    // `start` / `stop` would shadow LayoutAlignment.start inside this file.
    callback start-sharing();
    callback stop-sharing();
    callback add-files();
    callback add-folder();
    callback remove(int);
    callback clear();
    callback forget(string);
    callback set-iface(string);
    callback pick-inbox();
    callback open-inbox();
    callback open-row(int);
    callback clear-history();
    callback set-page(int);
    callback set-sort(int, bool);
    callback dismiss-upload(int);

    // Modal state. Both dialogs are drawn after the main layout so they land on
    // top — Slint z-order follows declaration order.
    property <bool> confirm-clear: false;
    property <bool> help-open: false;

    // A second click on the active column flips direction; a first click on a
    // new one starts from the reading most people want — newest, biggest,
    // A-first — rather than always ascending.
    function sort-clicked(col: int) {
        if (root.sort == col) {
            root.set-sort(col, !root.sort-desc);
        } else {
            root.set-sort(col, col == 1 || col == 5);
        }
    }

    property <color> accent: Theme.transfer-accent;
    property <color> send-tint: #6366f1;    // indigo — giving
    property <color> recv-tint: Theme.ok;   // green  — getting

    // Three equal columns, sized here rather than left to `horizontal-stretch`.
    // A stretch factor only divides *leftover* space, and these cards have very
    // different preferred widths — the QR block makes Connection wide and the
    // drop zone makes Send narrow — so stretching handed Connection ~910px and
    // Send ~320px. Pinning min == max is what actually forces equal columns.
    property <length> gutter: 20px;
    // 44px of body padding, two gutters, and 16px of headroom for the
    // ScrollView's own scrollbar — without that last term three exact thirds
    // overflow by a few pixels and earn a horizontal scrollbar.
    property <length> col-w: max(300px, (root.width - 44px - 2 * root.gutter - 16px) / 3);

    background: transparent;

    VerticalLayout {
        spacing: 0px;

        // ── header: identity, live address, the one control that opens or
        // closes the port ───────────────────────────────────────────────────
        Rectangle {
            height: 76px; horizontal-stretch: 1; background: Theme.panel;
            border-width: 1px; border-color: Theme.outline;
            HorizontalLayout {
                padding-left: 26px; padding-right: 26px; spacing: 14px;
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: 40px; height: 40px; border-radius: 12px;
                        background: root.accent.with-alpha(0.16);
                        AppIcon {
                            source: Icons.share; colorize: root.accent; width: 20px; height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Text { text: "Transfer"; color: Theme.text; font-size: 23px; font-weight: 700; }
                }
                // The bind error, verbatim, when there is one — a silent
                // failure here is indistinguishable from a dismissed firewall
                // prompt.
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            AppIcon {
                                source: Icons.link; colorize: Theme.text-dim;
                                width: 14px; height: 14px;
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1;
                            Text {
                                text: root.status; color: Theme.text-dim; font-size: 12.5px;
                                overflow: elide; wrap: no-wrap;
                            }
                        }
                    }
                }
                if root.running: VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        height: 28px; min-width: 88px; border-radius: 14px;
                        background: Theme.ok.with-alpha(0.14);
                        HorizontalLayout {
                            padding-left: 11px; padding-right: 12px; spacing: 6px; alignment: center;
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                AppIcon {
                                    source: Icons.wifi; colorize: Theme.ok;
                                    width: 13px; height: 13px;
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Text {
                                    text: "Online"; color: Theme.ok;
                                    font-size: 11.5px; font-weight: 700; vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        height: 34px; min-width: 130px; border-radius: 17px;
                        background: root.running ? Theme.ok.with-alpha(0.10) : Theme.panel-2;
                        border-width: 1px;
                        border-color: root.running ? Theme.ok.with-alpha(0.35) : Theme.outline;
                        HorizontalLayout {
                            padding-left: 13px; padding-right: 14px; spacing: 8px; alignment: center;
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Rectangle {
                                    width: 8px; height: 8px; border-radius: 4px;
                                    background: root.running ? Theme.ok : Theme.text-dim;
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Text {
                                    text: root.running ? "Sharing active" : "Not sharing";
                                    color: root.running ? Theme.ok : Theme.text-dim;
                                    font-size: 12px; font-weight: 700; vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                // Help sits beside the one control that matters, because the
                // moment a person needs it is the moment sharing looks on and
                // the phone still says it cannot connect.
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        height: 34px; min-width: 92px; border-radius: 17px;
                        background: helper.has-hover ? Theme.panel-2 : transparent;
                        border-width: 1px; border-color: Theme.outline;
                        helper := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.help-open = true; }
                        }
                        HorizontalLayout {
                            padding-left: 13px; padding-right: 14px; spacing: 7px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                AppIcon {
                                    source: Icons.info; colorize: Theme.text-dim;
                                    width: 15px; height: 15px;
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Text {
                                    text: "Help"; color: Theme.text;
                                    font-size: 12.5px; font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        height: 34px; min-width: 118px; border-radius: 17px;
                        background: root.running
                            ? (stopper.has-hover ? Theme.error.with-alpha(0.16) : Theme.error.with-alpha(0.10))
                            : @linear-gradient(135deg, Theme.transfer-accent, Theme.transfer-accent-2);
                        border-width: root.running ? 1px : 0px;
                        border-color: Theme.error.with-alpha(0.35);
                        stopper := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.running) { root.stop-sharing(); } else { root.start-sharing(); }
                            }
                        }
                        Text {
                            text: root.running ? "Stop sharing" : "Start sharing";
                            color: root.running ? Theme.error : #ffffff;
                            font-size: 12.5px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }

        sv := ScrollView {
            horizontal-stretch: 1; vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: body.preferred-height;
            // Every page in this app opens at the top; a ScrollView otherwise
            // keeps whatever viewport-y it had the last time it was alive.
            init => { self.viewport-y = 0; }

            body := VerticalLayout {
                width: parent.width;
                padding: 22px; spacing: 20px;

                // ── the three cards ─────────────────────────────────────────
                HorizontalLayout {
                    spacing: root.gutter;

                    // ── Connection ──────────────────────────────────────────
                    Card {
                        min-width: root.col-w; max-width: root.col-w;
                        title: "Connection";
                        subtitle: "Scan the code, or type the address and PIN.";
                        icon: Icons.link;
                        tint: root.accent;

                        HorizontalLayout {
                            spacing: 16px;
                            // The QR carries a single-use pairing key, not the
                            // PIN — a photo of this screen taken later is
                            // worthless.
                            Rectangle {
                                width: 168px; height: 168px; horizontal-stretch: 0;
                                border-radius: 14px;
                                background: root.running ? #ffffff : Theme.panel-2;
                                border-width: 1px; border-color: Theme.outline;
                                if root.running: Image {
                                    source: root.qr; image-fit: contain;
                                    width: parent.width - 14px; height: parent.height - 14px;
                                    x: 7px; y: 7px;
                                }
                                if !root.running: Text {
                                    text: "Not sharing"; color: Theme.text-dim; font-size: 12px;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: parent.width; height: parent.height;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 10px; alignment: start;
                                VerticalLayout {
                                    spacing: 5px;
                                    Text {
                                        text: "ADDRESS"; color: Theme.text-dim;
                                        font-size: 10px; letter-spacing: 1.3px; font-weight: 700;
                                    }
                                    ValueField {
                                        value: root.running ? root.url : "—";
                                        size: 13px; tone: root.accent; weight: 700;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 5px;
                                    Text {
                                        text: "PIN"; color: Theme.text-dim;
                                        font-size: 10px; letter-spacing: 1.3px; font-weight: 700;
                                    }
                                    ValueField {
                                        value: root.running ? root.pin : "——————";
                                        size: 22px; tone: root.accent; weight: 800;
                                    }
                                }
                                // Somebody grinding the PIN is silent from this
                                // end otherwise: the guesser gets a 429 and the
                                // desktop shows nothing.
                                if root.attempts != "": Text {
                                    text: root.attempts; color: Theme.error;
                                    font-size: 11px; font-weight: 600; wrap: word-wrap;
                                }
                            }
                        }

                        // Both a hotspot and a Wi-Fi link commonly qualify;
                        // only the person holding the phone knows which.
                        if root.ifaces.length > 1: VerticalLayout {
                            spacing: 7px;
                            Text {
                                text: "THIS NETWORK"; color: Theme.text-dim;
                                font-size: 10px; letter-spacing: 1.3px; font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: 6px; alignment: start;
                                for f in root.ifaces: IfaceChip {
                                    iface: f;
                                    active: f.ip == root.iface;
                                    clicked => { root.set-iface(f.ip); }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.outline; }
                        Text {
                            text: "Works on any device with a browser";
                            color: Theme.text-dim; font-size: 11px;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 6px; alignment: center;
                            PlatformChip { label: "Android"; }
                            PlatformChip { label: "iOS"; }
                            PlatformChip { label: "Windows"; }
                            PlatformChip { label: "macOS"; }
                            PlatformChip { label: "Linux"; }
                        }

                        // The firewall advice used to live here. It is the one
                        // failure the desktop cannot detect, so it earned a
                        // permanent strip — but it only matters once, and it
                        // sat in the card a working setup looks at every day.
                        // It is in Help now, alongside the other platforms.
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }

                    // ── Send ────────────────────────────────────────────────
                    Card {
                        min-width: root.col-w; max-width: root.col-w;
                        title: "Send";
                        subtitle: "Share files with the phone — never the library.";
                        icon: Icons.upload;
                        tint: root.send-tint;

                        // A click target, not a drop target: Slint has no
                        // OS-level file drop, and a zone that says "drag here"
                        // and then ignores a drag is worse than no zone.
                        Rectangle {
                            min-height: 176px; border-radius: 14px;
                            background: pick.has-hover
                                ? root.send-tint.with-alpha(0.07) : Theme.panel-2.with-alpha(0.5);
                            border-width: 1.5px;
                            border-color: pick.has-hover
                                ? root.send-tint : Theme.outline-strong;
                            pick := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.add-files(); }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 12px;
                                padding-left: 18px; padding-right: 18px;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 62px; height: 62px; border-radius: 31px;
                                        background: @linear-gradient(135deg,
                                            root.send-tint, root.send-tint.brighter(20%));
                                        AppIcon {
                                            source: Icons.upload; colorize: #ffffff;
                                            width: 26px; height: 26px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                                Text {
                                    text: "Choose files to share";
                                    color: Theme.text; font-size: 14px; font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "They stay on this machine — the phone pulls them over the link.";
                                    color: Theme.text-dim; font-size: 11.5px;
                                    horizontal-alignment: center; wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: center; spacing: 8px;
                                    ActionButton {
                                        label: "Choose files"; icon: Icons.folder-open;
                                        clicked => { root.add-files(); }
                                    }
                                    ActionButton {
                                        label: "Choose folder"; primary: false;
                                        icon: Icons.folder;
                                        clicked => { root.add-folder(); }
                                    }
                                }
                            }
                        }

                        if root.files.length > 0: HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 1;
                                Text {
                                    text: root.total; color: Theme.text-dim;
                                    font-size: 11.5px; font-weight: 600;
                                }
                            }
                            RowBtn { label: "Clear all"; clicked => { root.clear(); } }
                        }
                        for f in root.files: TrayRow {
                            file: f; accent: root.send-tint;
                            remove => { root.remove(f.id); }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        NoteStrip {
                            title: root.devices.length == 0
                                ? "No phone has paired yet"
                                : root.devices.length + " phone(s) paired";
                            body: "A phone stays paired for 48 hours, then types the PIN again.";
                            icon: Icons.users;
                            tint: root.send-tint;
                        }
                        for d in root.devices: Rectangle {
                            height: 46px; border-radius: 11px; background: Theme.panel-2;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 10px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text { text: d.label; color: Theme.text; font-size: 12.5px; }
                                    Text {
                                        text: "last seen " + d.seen; color: Theme.text-dim;
                                        font-size: 10.5px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    RowBtn {
                                        label: "Forget"; tint: Theme.error;
                                        clicked => { root.forget(d.token); }
                                    }
                                }
                            }
                        }
                    }

                    // ── Receive ─────────────────────────────────────────────
                    Card {
                        min-width: root.col-w; max-width: root.col-w;
                        title: "Receive";
                        subtitle: "Everything the phone sends lands here, flat.";
                        icon: Icons.download;
                        tint: root.recv-tint;

                        Rectangle {
                            height: 46px; border-radius: 10px; background: Theme.panel-2;
                            border-width: 1px;
                            border-color: root.inbox-ok ? Theme.outline : Theme.error;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 8px; spacing: 8px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Text {
                                        text: root.inbox; color: Theme.text; font-size: 12px;
                                        overflow: elide; vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Rectangle {
                                        width: 32px; height: 32px; border-radius: 9px;
                                        background: openfold.has-hover ? Theme.panel : transparent;
                                        openfold := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.open-inbox(); }
                                        }
                                        AppIcon {
                                            source: Icons.folder-open; colorize: root.recv-tint;
                                            width: 16px; height: 16px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }

                        if root.inbox-ok: NoteStrip {
                            title: root.uploads.length == 0
                                ? "Ready to receive" : "Receiving";
                            body: root.uploads.length == 0
                                ? "Files the phone sends will appear here."
                                : "One at a time — parallel writes to one disk are slower.";
                            icon: Icons.check;
                            tint: root.recv-tint;
                        }
                        if !root.inbox-ok: NoteStrip {
                            title: "That folder cannot be written to";
                            body: "Uploads are refused until it can. Downloads still work.";
                            icon: Icons.triangle-alert;
                            tint: Theme.error;
                        }

                        for u in root.uploads: UploadRow {
                            up: u;
                            dismiss => { root.dismiss-upload(u.id); }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            ActionButton {
                                label: "Change location"; primary: false; icon: Icons.map-pin;
                                clicked => { root.pick-inbox(); }
                            }
                            ActionButton {
                                label: "Open folder"; primary: false; icon: Icons.folder;
                                clicked => { root.open-inbox(); }
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        // Deliberately not "end-to-end encrypted": this is
                        // plain HTTP on the local network, and saying otherwise
                        // in the one place a person checks would be a lie.
                        NoteStrip {
                            title: "Local network only";
                            body: "Direct device to device, no relay, no server, nothing stored off this machine. Plain HTTP, so the browser will say “not secure”.";
                            icon: Icons.shield;
                            tint: root.recv-tint;
                        }
                    }
                }

                // ── Recent Transfers, full width ────────────────────────────
                Card {
                    title: "Recent transfers";
                    subtitle: "Sent and received. Click a column to sort. A greyed row is a file that has since moved.";
                    icon: Icons.clock;
                    tint: root.accent;
                    // Nothing to clear when the table is empty, so the button
                    // says so rather than sitting there live and doing nothing.
                    action: "Clear history";
                    action-icon: Icons.trash;
                    action-enabled: root.rows.length > 0;
                    action-clicked => { root.confirm-clear = true; }

                    // Column header. Widths are repeated on every row below —
                    // Slint has no grid that spans a repeater, so the two must
                    // be kept in step by hand.
                    //
                    // Sorting runs in SQL over the whole ledger, not over the
                    // ten rows on screen: sorting a page in place would only
                    // shuffle that page and leave the rest of the table alone.
                    Rectangle {
                        height: 34px; border-radius: 9px; background: Theme.panel-2;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; spacing: 12px;
                            SortHead {
                                label: "Name"; index: 0; horizontal-stretch: 1;
                                active: root.sort; desc: root.sort-desc;
                                clicked => { root.sort-clicked(0); }
                            }
                            // Size sits beside the filename it describes rather
                            // than three columns away.
                            SortHead {
                                label: "Size"; index: 1; min-width: 110px; numeric: true;
                                active: root.sort; desc: root.sort-desc;
                                clicked => { root.sort-clicked(1); }
                            }
                            SortHead {
                                label: "Type"; index: 2; min-width: 150px;
                                active: root.sort; desc: root.sort-desc;
                                clicked => { root.sort-clicked(2); }
                            }
                            SortHead {
                                label: "Status"; index: 3; min-width: 160px;
                                active: root.sort; desc: root.sort-desc;
                                clicked => { root.sort-clicked(3); }
                            }
                            SortHead {
                                label: "From / To"; index: 4; min-width: 190px;
                                active: root.sort; desc: root.sort-desc;
                                clicked => { root.sort-clicked(4); }
                            }
                            SortHead {
                                label: "Time"; index: 5; min-width: 140px;
                                active: root.sort; desc: root.sort-desc;
                                clicked => { root.sort-clicked(5); }
                            }
                            Rectangle { width: 34px; horizontal-stretch: 0; background: transparent; }
                        }
                    }

                    if root.rows.length == 0: Rectangle {
                        height: 64px;
                        Text {
                            text: "Nothing yet. Sent and received files are both recorded here.";
                            color: Theme.text-dim; font-size: 12px;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }

                    for r[i] in root.rows: Rectangle {
                        height: 60px; border-radius: 10px;
                        background: rowtouch.has-hover ? Theme.panel-2 : transparent;
                        opacity: r.missing ? 0.55 : 1.0;
                        rowtouch := TouchArea {
                            mouse-cursor: r.path == "" ? default : pointer;
                            clicked => { if (r.path != "") { root.open-row(i); } }
                        }
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; spacing: 12px;

                            // Name — icon tile, filename, what kind of file.
                            HorizontalLayout {
                                horizontal-stretch: 1; spacing: 11px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Rectangle {
                                        width: 34px; height: 34px; border-radius: 10px;
                                        background: (r.direction == "in" ? root.recv-tint : root.accent)
                                            .with-alpha(0.14);
                                        Text {
                                            text: r.kind;
                                            color: r.direction == "in" ? root.recv-tint : root.accent;
                                            font-size: 9px; font-weight: 800;
                                            horizontal-alignment: center; vertical-alignment: center;
                                            width: parent.width; height: parent.height;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text {
                                        text: r.name; color: Theme.text; font-size: 12.5px;
                                        font-weight: 600; overflow: elide;
                                    }
                                    Text {
                                        text: r.kindlabel; color: Theme.text-dim; font-size: 10.5px;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Size — kept next to the name it belongs to.
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Text {
                                    text: r.size; color: Theme.text; font-size: 12px;
                                    min-width: 110px; horizontal-alignment: right;
                                }
                            }

                            // Type — which way it went.
                            HorizontalLayout {
                                min-width: 150px; horizontal-stretch: 0; spacing: 7px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    AppIcon {
                                        source: r.direction == "in" ? Icons.arrow-down : Icons.arrow-up;
                                        colorize: r.direction == "in" ? root.recv-tint : root.accent;
                                        width: 15px; height: 15px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Text {
                                        text: r.direction == "in" ? "Received" : "Sent";
                                        color: r.direction == "in" ? root.recv-tint : root.accent;
                                        font-size: 12px; font-weight: 600; vertical-alignment: center;
                                    }
                                }
                            }

                            // Status.
                            HorizontalLayout {
                                min-width: 160px; horizontal-stretch: 0; spacing: 7px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    AppIcon {
                                        source: r.status == "ok" ? Icons.check : Icons.triangle-alert;
                                        colorize: r.status == "ok" ? Theme.ok : Theme.error;
                                        width: 15px; height: 15px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Text {
                                        text: r.status == "ok" ? "Completed" : r.status;
                                        color: r.status == "ok" ? Theme.ok : Theme.error;
                                        font-size: 12px; font-weight: 600; vertical-alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0; spacing: 2px;
                                Text {
                                    text: r.direction == "in" ? "From" : "To"; color: Theme.text-dim;
                                    font-size: 10px; min-width: 190px;
                                }
                                Text {
                                    text: r.peer; color: Theme.text; font-size: 11.5px;
                                    font-weight: 600; min-width: 190px;
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Text {
                                    text: r.stamp; color: Theme.text-dim; font-size: 11.5px;
                                    min-width: 140px;
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Rectangle {
                                    width: 34px; height: 34px; border-radius: 9px;
                                    background: reveal.has-hover ? Theme.panel : transparent;
                                    opacity: r.path == "" ? 0.25 : 1.0;
                                    reveal := TouchArea {
                                        mouse-cursor: r.path == "" ? default : pointer;
                                        clicked => { if (r.path != "") { root.open-row(i); } }
                                    }
                                    AppIcon {
                                        source: Icons.folder-open; colorize: Theme.text-dim;
                                        width: 15px; height: 15px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }
                    }

                    // Pagination. Hidden outright on a single page — a Previous
                    // and Next that can never do anything is just noise.
                    if root.pages > 1: HorizontalLayout {
                        spacing: 8px; alignment: center;
                        PageBtn {
                            label: "Previous"; icon: Icons.chevron-left;
                            enabled: root.page > 0;
                            clicked => { root.set-page(root.page - 1); }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Text {
                                text: "Page " + (root.page + 1) + " of " + root.pages;
                                color: Theme.text-dim; font-size: 11.5px; font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        PageBtn {
                            label: "Next"; icon: Icons.chevron-right; trailing: true;
                            enabled: root.page + 1 < root.pages;
                            clicked => { root.set-page(root.page + 1); }
                        }
                    }
                }

                // ── footer ──────────────────────────────────────────────────
                HorizontalLayout {
                    alignment: center; spacing: 8px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        AppIcon {
                            source: Icons.shield; colorize: Theme.text-dim;
                            width: 14px; height: 14px;
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Text {
                            text: "Transfers go straight between your devices — no relay, no account, nothing stored on a server.";
                            color: Theme.text-dim; font-size: 11.5px; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── modals ──────────────────────────────────────────────────────────────
    // Declared after the layout, which is what puts them on top: Slint paints in
    // declaration order. The scrim's own TouchArea both dims the page and eats
    // clicks meant for what is behind it.

    if root.confirm-clear: Rectangle {
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.confirm-clear = false; } }
        Rectangle {
            width: min(430px, parent.width - 48px);
            height: self.preferred-height;
            border-radius: Theme.radius-lg;
            background: Theme.panel;
            border-width: 1px; border-color: Theme.outline;
            drop-shadow-blur: 40px; drop-shadow-color: #00000055;
            // Without this the click would fall through to the scrim and close
            // the dialog the moment anyone touched it.
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 16px;
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: start; horizontal-stretch: 0;
                        Rectangle {
                            width: 44px; height: 44px; border-radius: 22px;
                            background: Theme.error.with-alpha(0.14);
                            AppIcon {
                                source: Icons.trash; colorize: Theme.error;
                                width: 20px; height: 20px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 6px; alignment: center;
                        Text {
                            text: "Clear transfer history?";
                            color: Theme.text; font-size: 17px; font-weight: 700;
                            wrap: word-wrap;
                        }
                        // The distinction worth spelling out: this is a log, and
                        // people reach for it expecting a delete.
                        Text {
                            text: "This erases the record of what was sent and received. "
                                + "The files themselves are not touched, and paired devices stay paired.";
                            color: Theme.text-dim; font-size: 12.5px; wrap: word-wrap;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.outline; }
                HorizontalLayout {
                    spacing: 10px; alignment: end;
                    Rectangle {
                        height: 36px; min-width: 92px; border-radius: 10px;
                        background: cancel-t.has-hover ? Theme.panel-2 : transparent;
                        border-width: 1px; border-color: Theme.outline;
                        cancel-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.confirm-clear = false; }
                        }
                        Text {
                            text: "Cancel"; color: Theme.text;
                            font-size: 12.5px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                    Rectangle {
                        height: 36px; min-width: 124px; border-radius: 10px;
                        background: wipe-t.has-hover
                            ? Theme.error : Theme.error.with-alpha(0.88);
                        wipe-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.confirm-clear = false;
                                root.clear-history();
                            }
                        }
                        Text {
                            text: "Clear history"; color: #ffffff;
                            font-size: 12.5px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }
    }

    if root.help-open: Rectangle {
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.help-open = false; } }
        Rectangle {
            width: min(620px, parent.width - 48px);
            height: min(640px, parent.height - 48px);
            border-radius: Theme.radius-lg;
            background: Theme.panel;
            border-width: 1px; border-color: Theme.outline;
            drop-shadow-blur: 40px; drop-shadow-color: #00000055;
            TouchArea { }
            VerticalLayout {
                padding: 0px;
                // Header, outside the scroll so the close button stays put.
                HorizontalLayout {
                    padding: 20px; spacing: 13px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            width: 42px; height: 42px; border-radius: 21px;
                            background: root.accent.with-alpha(0.14);
                            AppIcon {
                                source: Icons.info; colorize: root.accent;
                                width: 20px; height: 20px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1; spacing: 3px;
                        Text {
                            text: "Connecting a device";
                            color: Theme.text; font-size: 17px; font-weight: 700;
                        }
                        Text {
                            text: "Anything with a browser works. No app to install on the other end.";
                            color: Theme.text-dim; font-size: 12px; wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            width: 32px; height: 32px; border-radius: 9px;
                            background: closeh.has-hover ? Theme.panel-2 : transparent;
                            closeh := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.help-open = false; }
                            }
                            AppIcon {
                                source: Icons.x; colorize: Theme.text-dim;
                                width: 15px; height: 15px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.outline; }

                helpsv := ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: helpbody.preferred-height;
                    init => { self.viewport-y = 0; }

                    helpbody := VerticalLayout {
                        width: parent.width;
                        padding: 20px; spacing: 14px;

                        HelpBlock {
                            title: "Start here";
                            tint: root.accent;
                            icon: Icons.wifi;
                            body: "1.  Press Start sharing on this computer.\n"
                                + "2.  Put both devices on the same Wi-Fi, or tether one to the other's hotspot.\n"
                                + "3.  Scan the QR code, or type the address into any browser.\n"
                                + "4.  Enter the 6-digit PIN. The QR skips this — it carries a single-use key that lasts 60 seconds.";
                        }

                        // The live one, with this machine's real port and link
                        // substituted in. It sits first because a person opening
                        // this panel is almost always already stuck.
                        if root.hint != "": HelpBlock {
                            title: "Phone says it cannot connect";
                            tint: Theme.warn;
                            icon: Icons.shield;
                            body: root.hint;
                        }

                        HelpBlock {
                            title: "Windows";
                            tint: #0ea5e9;
                            icon: Icons.monitor-play;
                            body: "Windows Firewall asks once, on the very first bind, and dismissing that dialog silently blocks every connection afterwards — with no second prompt.\n\n"
                                + "Fix it at Settings → Privacy & security → Windows Security → Firewall & network protection → Allow an app through firewall, and tick Tulipix for Private networks.\n\n"
                                + "If the network is marked Public, either switch it to Private or open TCP " + root.port + " directly.";
                        }

                        HelpBlock {
                            title: "macOS";
                            tint: #a78bfa;
                            icon: Icons.command;
                            body: "macOS asks for Local Network permission the first time an app talks to the LAN. Denied once, it never asks again.\n\n"
                                + "Turn it on at System Settings → Privacy & Security → Local Network → Tulipix.\n\n"
                                + "Then check System Settings → Network → Firewall. If it is on, either allow incoming connections for Tulipix or make sure Block all incoming connections is off.";
                        }

                        HelpBlock {
                            title: "Linux";
                            tint: #22c55e;
                            icon: Icons.wrench;
                            body: "A default-deny firewall drops the phone's packets before they reach the app, and this end cannot tell — the bind succeeded either way.\n\n"
                                + "ufw:       sudo ufw allow in on <interface> to any port " + root.port + " proto tcp\n"
                                + "firewalld: sudo firewall-cmd --add-port=" + root.port + "/tcp\n\n"
                                + "Scope the rule to the one link rather than opening the port everywhere — otherwise it follows the laptop onto the next network it joins.";
                        }

                        HelpBlock {
                            title: "Android";
                            tint: #84cc16;
                            icon: Icons.download;
                            body: "Any browser works. Chrome, Firefox and Samsung Internet are all fine.\n\n"
                                + "Using this phone as the hotspot: the laptop is a client on the phone's network, so pick the hotspot address from THIS NETWORK on the Connection card — that is the one the phone can reach.\n\n"
                                + "Downloads land in the browser's own folder, usually Downloads. Some Android builds warn about files from a “not secure” page; that is the plain-HTTP notice, not a problem with the file.";
                        }

                        HelpBlock {
                            title: "iPhone and iPad";
                            tint: #f472b6;
                            icon: Icons.upload;
                            body: "Safari works, and the Camera app scans the QR straight into it.\n\n"
                                + "Turn off Private Wi-Fi Address for this network if the connection is refused after it worked once — a rotating address invalidates the paired device.\n\n"
                                + "Uploading photos: pick Photo Library in the file picker. iOS converts HEIC to JPEG on the way out unless Settings → Photos → Transfer to Mac or PC is set to Keep Originals.";
                        }

                        HelpBlock {
                            title: "Still nothing";
                            tint: Theme.text-dim;
                            icon: Icons.triangle-alert;
                            body: "Client isolation — an “AP isolation” or “guest network” setting on the router — blocks devices from seeing each other at all, and no firewall change on either end will fix it. A phone hotspot is the quickest way around it.\n\n"
                                + "A VPN on either device routes traffic away from the local network. Turn it off and try again.\n\n"
                                + "Corporate and campus Wi-Fi very often has isolation on by design. Expect it to fail there.";
                        }
                    }
                }
            }
        }
    }
}
