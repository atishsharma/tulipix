// Transfer section — the desktop half of "a phone on the same Wi-Fi opens a
// URL". Three cards across the top, one per question a person actually has:
//
//   Connection — how do I get in?      QR, address, PIN, what it works with.
//   Send       — how do I give a file? One big target.
//   Receive    — where do files land?  The inbox, and what is arriving.
//
// Recent Transfers is a real table below them, full width.
//
// Identity: orange→amber (Theme.transfer-accent → transfer-accent-2). It is the
// one hue the six existing sections — violet, indigo, pink, emerald, teal,
// cyan — leave free, so a glance at the accent says which section this is.
import { Theme } from "tokens.slint";
import { Surface, Rim } from "surface.slint";
import { ScrollView } from "std-widgets.slint";
import { AppIcon, Icons } from "icons.slint";

// One file the desktop is offering. `id` is the tray id, never a path — the
// phone cannot name a file on disk at all.
// `to` is the device this file is offered to, already resolved to a display
// name in Rust — empty means every paired device. The row shows it because a
// tray that mixes audiences is unreadable without it.
export struct TransferFile { id: int, name: string, size: string, kind: string, to: string }

// One phone that has authenticated, until its 48 hours are up.
//
// `idx` is the position in the list, which is how the Connection card lays five
// buttons to a row: Slint cannot chunk a model, and the row a button belongs to
// has to be decidable from the button itself.
//
// `name` is what to call it — the name typed on the desktop, or the device type
// when there is none. `kind` still comes along, because it chooses the icon.
export struct TransferDevice {
    token: string, name: string, kind: string, label: string,
    ip: string, pin: string, remaining: string, seen: string, idx: int,
    // Bytes moving to or from this device right now. Drives the second ring on
    // the round button, which is the only place the page says which of ten
    // devices a transfer belongs to.
    busy: bool,
}

// One upload in flight (or just finished). `state` is active | done | failed.
// A success clears itself after a few seconds; a failure stays until dismissed,
// which is what `id` is for.
// `moved` is "12.4 MB / 40 MB" and `rate` "3.1 MB/s" — both empty unless the
// file is actually moving, since a rate on a finished row is a number about the
// past pretending to be about now.
export struct TransferUp {
    id: int, name: string, size: string, pct: float, state: string,
    moved: string, rate: string,
}

// One row of the ledger. `direction` is in | out; `missing` greys a row whose
// file has since been moved or deleted rather than hiding it.
// `stamp` rather than `when`, which is a Slint keyword.
// `status` is the ledger's own word — ok | failed | sending. A row that is
// still sending carries `pct` and `progress` ("43% · 3.1 MB/s"), filled in on
// every tick from the bytes actually on the wire; `id` is the ledger row id,
// which is what matches the two together and what the retry button names.
export struct TransferRow {
    id: int,
    direction: string, name: string, path: string, size: string,
    peer: string, status: string, stamp: string,
    kind: string, kindlabel: string, missing: bool,
    pct: float, progress: string,
}

// One address a phone could reach. Both a hotspot and a Wi-Fi link commonly
// qualify at once, so this is a picker rather than a guess.
export struct TransferIface { name: string, ip: string }

// ── solid action button ─────────────────────────────────────────────────────
// Every button on this page is one filled shape with white text: a ghost button
// beside a filled one reads as disabled, and on the light theme the ghosts were
// invisible until hovered. The colour says what the button is for — indigo for
// giving, green for receiving, red for throwing away — and it darkens on hover
// and again on press, which is the whole of the pressed feedback.
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.transfer-accent;
    in property <bool> enabled: true;
    in property <image> icon;
    callback clicked();
    height: 40px; min-width: 118px; border-radius: Surface.btn-radius;
    background: !root.enabled ? Surface.body(Theme.panel-2)
        : (touch.pressed ? root.tint.darker(32%)
        : (touch.has-hover ? root.tint.darker(16%) : Surface.tile(root.tint)));
    opacity: enabled ? 1.0 : 0.5;
    drop-shadow-blur: Surface.cast(0px);
    drop-shadow-color: Surface.shadow-ink;
    drop-shadow-offset-y: Surface.cast-y(0px);
    animate background { duration: 110ms; }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    // A filled key in the two moulded languages: same colour, lit top edge, and
    // it goes down when held. Standard has no rim and keeps the flat fill.
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, parent.border-radius - 1px);
        pressed: touch.pressed;
    }
    HorizontalLayout {
        alignment: center; spacing: 7px;
        padding-left: 14px; padding-right: 14px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon { source: root.icon; width: 15px; height: 15px; colorize: #ffffff; }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Text {
                text: root.label; color: #ffffff;
                font-size: 13px; font-weight: 700; vertical-alignment: center;
            }
        }
    }
}

// ── small filled button for per-row actions ─────────────────────────────────
// Red by default: both users of it — Remove and Clear all — throw a choice away.
component RowBtn inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.error;
    callback clicked();
    horizontal-stretch: 0; height: 28px; min-width: 64px; border-radius: Surface.rr(8px, self.width, self.height);
    background: touch.pressed ? root.tint.darker(32%)
        : (touch.has-hover ? root.tint.darker(16%) : Surface.tile(root.tint));
    animate background { duration: 110ms; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, parent.border-radius - 1px);
        pressed: touch.pressed;
    }
    Text {
        text: root.label; color: #ffffff; font-size: 11.5px; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// ── destructive action, for the buttons that throw data away ────────────────
// Filled red rather than a red outline. The confirm dialog is what stops an
// accident here; the button's job is to be found, not to be timid.
component DangerBtn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px; min-width: 124px; border-radius: Surface.btn-radius;
    opacity: root.enabled ? 1.0 : 0.4;
    background: !root.enabled ? Surface.body(Theme.panel-2)
        : (touch.pressed ? Theme.error.darker(32%)
        : (touch.has-hover ? Theme.error.darker(16%) : Surface.tile(Theme.error)));
    animate background { duration: 110ms; }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, parent.border-radius - 1px);
        pressed: touch.pressed;
    }
    HorizontalLayout {
        alignment: center; spacing: 7px;
        padding-left: 13px; padding-right: 14px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon { source: root.icon; colorize: #ffffff; width: 14px; height: 14px; }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Text {
                text: root.label; color: #ffffff; font-size: 12px; font-weight: 700;
                vertical-alignment: center;
            }
        }
    }
}

// ── the card the three panes are built from ─────────────────────────────────
// A tinted circular glyph, a title, a one-line subtitle, then whatever the
// caller puts inside. Same shape every time so the eye can skip the chrome.
component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    in property <color> tint: Theme.transfer-accent;
    // An optional control pinned to the right of the title row. Empty label
    // means no button, which is every card but Recent Transfers.
    in property <string> action;
    in property <image> action-icon;
    in property <bool> action-enabled: true;
    callback action-clicked();
    border-radius: Surface.panel-radius;
    background: Surface.panel(Theme.panel, root.tint);
    // The card wears its own tint rather than the shared grey, so the outer
    // border, the glyph and the panels inside it are one colour.
    border-width: Surface.edge-w(1px); border-color: Surface.edge(root.tint, 0.30);
    drop-shadow-blur: Surface.cast(20px);
    drop-shadow-color: Surface.cast-ink(#00000012);
    drop-shadow-offset-y: Surface.cast-y(20px);
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Surface.panel-radius - 1px;
    }
    VerticalLayout {
        padding: 20px; spacing: 16px;
        HorizontalLayout {
            spacing: 13px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    width: 44px; height: 44px; border-radius: 22px;
                    background: Surface.wash(root.tint, 0.14);
                    if Surface.rim: Rim {
                        x: 1px; y: 1px;
                        width: parent.width - 2px; height: parent.height - 2px;
                        radius: parent.border-radius - 1px;
                    }
                    AppIcon {
                        source: root.icon; colorize: root.tint; width: 21px; height: 21px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1; spacing: 3px;
                Text { text: root.title; color: Theme.text; font-size: 17px; font-weight: 700; }
                if root.subtitle != "": Text {
                    text: root.subtitle; color: Theme.text-dim; font-size: 12.5px;
                    wrap: word-wrap;
                }
            }
            if root.action != "": VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                DangerBtn {
                    label: root.action;
                    icon: root.action-icon;
                    enabled: root.action-enabled;
                    clicked => { root.action-clicked(); }
                }
            }
        }
        @children
    }
}

// ── one section of the Help panel ───────────────────────────────────────────
// Body text is pre-wrapped prose with its own newlines, so it is one Text with
// word-wrap rather than a list — the platform steps are sentences, not bullets,
// and splitting them into rows would need a model per block for no gain.
component HelpBlock inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <image> icon;
    in property <color> tint: Theme.transfer-accent;
    height: self.preferred-height;
    border-radius: Surface.rr(12px, self.width, self.height);
    background: Surface.panel(Theme.panel-2, root.tint);
    border-width: Surface.edge-w(1px); border-color: Surface.clay ? transparent : Theme.outline;
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, Surface.rr(12px, self.width, self.height) - 1px);
    }
    VerticalLayout {
        padding: 14px; spacing: 9px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    width: 26px; height: 26px; border-radius: Surface.rr(8px, self.width, self.height);
                    background: Surface.wash(root.tint, 0.16);
                    AppIcon {
                        source: root.icon; colorize: root.tint; width: 14px; height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text {
                    text: root.title; color: Theme.text; font-size: 13.5px; font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.body; color: Theme.text-dim; font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// ── one pagination step ─────────────────────────────────────────────────────
// Disabled rather than hidden at the ends, so the pair does not jump sideways
// when it reaches the first or last page.
component PageBtn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    // Chevron after the label instead of before it, for Next.
    in property <bool> trailing: false;
    in property <bool> enabled: true;
    in property <color> tint: Theme.transfer-accent;
    callback clicked();
    horizontal-stretch: 0; height: 32px; min-width: 104px; border-radius: Surface.rr(9px, self.width, self.height);
    opacity: root.enabled ? 1.0 : 0.35;
    background: !root.enabled ? Surface.body(Theme.panel-2)
        : (touch.pressed ? root.tint.darker(32%)
        : (touch.has-hover ? root.tint.darker(16%) : Surface.tile(root.tint)));
    animate background { duration: 110ms; }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, parent.border-radius - 1px);
        pressed: touch.pressed;
    }
    HorizontalLayout {
        alignment: center; spacing: 6px;
        padding-left: 11px; padding-right: 11px;
        if !root.trailing: VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon { source: root.icon; colorize: #ffffff; width: 13px; height: 13px; }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Text {
                text: root.label; color: #ffffff; font-size: 11.5px; font-weight: 700;
                vertical-alignment: center;
            }
        }
        if root.trailing: VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon { source: root.icon; colorize: #ffffff; width: 13px; height: 13px; }
        }
    }
}

// ── a column title in the ledger header ─────────────────────────────────────
// A filled pill rather than bare grey text: six labels in a row on a tinted
// header strip read as one smear otherwise, and the fill is what separates them.
// White on a saturated fill is the one combination that holds on both themes —
// Theme.text would vanish on the light one and the dim variants on the dark.
component HeadPill inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    in property <bool> on: false;
    in property <bool> hot: false;
    height: 22px; border-radius: 11px;
    horizontal-stretch: 0;
    background: root.on ? Surface.tile(root.tint)
        : root.tint.with-alpha(root.hot ? 0.78 : 0.60);
    animate background { duration: 110ms; }
    HorizontalLayout {
        padding-left: 9px; padding-right: 9px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Text {
                text: root.label; color: #ffffff;
                font-size: 10.5px; font-weight: 700; vertical-alignment: center;
            }
        }
    }
}

// ── one sortable column header ──────────────────────────────────────────────
// Every column carries an arrow, faint until it is the one being sorted by. That
// is what says "these are clickable" — the hover fill that used to do it was
// Theme.outline, which on the light theme is nearly black and read as a shadow
// dropped on the header rather than a highlight.
component SortHead inherits Rectangle {
    in property <string> label;
    in property <int> index;
    in property <int> active;
    in property <bool> desc;
    in property <color> tint: Theme.transfer-accent;
    callback clicked();
    property <bool> on: root.active == root.index;
    horizontal-stretch: 0;
    background: transparent;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 6px; padding-right: 6px; spacing: 4px;
        alignment: center;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            HeadPill {
                label: root.label; tint: root.tint;
                on: root.on; hot: touch.has-hover;
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon {
                // Idle columns point down — that is what clicking them does
                // first for text, and it keeps six identical hints from looking
                // like six different states.
                source: root.on && !root.desc ? Icons.chevron-up : Icons.chevron-down;
                colorize: root.on ? root.tint
                    : Theme.text-dim.with-alpha(touch.has-hover ? 0.8 : 0.4);
                width: 12px; height: 12px;
            }
        }
    }
}

// ── the tinted footer strip each card ends on ───────────────────────────────
component NoteStrip inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> chip;
    in property <image> icon;
    in property <color> tint: Theme.ok;
    border-radius: Surface.rr(12px, self.width, self.height);
    background: Surface.wash(root.tint, 0.10);
    border-width: Surface.edge-w(1px); border-color: Surface.edge(root.tint, 0.22);
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, Surface.rr(12px, self.width, self.height) - 1px);
    }
    HorizontalLayout {
        padding: 12px; spacing: 11px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Rectangle {
                width: 30px; height: 30px; border-radius: 15px;
                background: Surface.wash(root.tint, 0.18);
                AppIcon {
                    source: root.icon; colorize: root.tint; width: 15px; height: 15px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 1; spacing: 2px;
            Text { text: root.title; color: Theme.text; font-size: 12.5px; font-weight: 700; }
            if root.body != "": Text {
                text: root.body; color: Theme.text-dim; font-size: 11px; wrap: word-wrap;
            }
        }
        if root.chip != "": VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Rectangle {
                height: 22px; min-width: 54px; border-radius: 11px;
                background: Surface.wash(root.tint, 0.20);
                Text {
                    text: root.chip; color: root.tint; font-size: 10.5px; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
            }
        }
    }
}

// ── a read-only field the value can be selected out of ──────────────────────
// Slint has no clipboard API to call, but a TextInput handles Ctrl+C itself —
// so the value is selectable rather than sitting behind a copy button that
// could not work.
component ValueField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> size: 13px;
    in property <color> tone: Theme.text;
    in property <int> weight: 600;
    /// The hue of the box this field sits in, so ADDRESS and PIN are outlined in
    /// their card's colour like everything else rather than in the shared grey.
    in property <color> tint: Theme.transfer-accent;
    /// A trailing button inside the well. Empty label draws nothing, which is
    /// what PIN wants — there is nothing to open a PIN with.
    in property <string> action;
    callback action-clicked();
    height: 46px; border-radius: Surface.rr(10px, self.width, self.height);
    // Hover lifts both the fill and the border: these are the two values people
    // reach for with the mouse to select and copy, so they have to answer it.
    background: Surface.wash(root.tint, hov.has-hover ? 0.12 : 0.06);
    border-width: Surface.edge-w(1px);
    border-color: Surface.edge(root.tint, hov.has-hover ? 0.75 : 0.38);
    animate background, border-color { duration: 120ms; }
    // A field is a well, not a plate: the sheen runs the other way so it reads
    // as something set into the card rather than sitting on it.
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, Surface.rr(10px, self.width, self.height) - 1px);
        pressed: true;
    }
    // Behind the TextInput so selecting the value still works — a TouchArea
    // declared first loses the click to the input drawn over it.
    hov := TouchArea { mouse-cursor: text; }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 8px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 1;
            TextInput {
                text: root.value; read-only: true; single-line: true;
                color: root.tone; font-size: root.size; font-weight: root.weight;
                selection-background-color: root.tint.with-alpha(0.3);
                vertical-alignment: center;
            }
        }
        // Inside the well rather than beside it: the address and the thing you
        // do with the address are one control. Drawn over the TouchArea above,
        // so it takes its own clicks while the value stays selectable.
        if root.action != "": Rectangle {
            y: (parent.height - self.height) / 2;
            height: 30px;
            width: openlbl.preferred-width + 22px;
            horizontal-stretch: 0;
            border-radius: Surface.rr(8px, self.width, self.height);
            background: root.tint.with-alpha(opent.has-hover ? 0.34 : 0.2);
            border-width: 1px;
            border-color: root.tint.with-alpha(opent.has-hover ? 0.8 : 0.45);
            animate background, border-color { duration: 120ms; }
            opent := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.action-clicked(); }
            }
            openlbl := Text {
                text: root.action;
                color: Theme.text;
                font-size: 11.5px; font-weight: 700;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}


// ── one interface chip in the address picker ────────────────────────────────
component IfaceChip inherits Rectangle {
    in property <TransferIface> iface;
    in property <bool> active: false;
    callback clicked();
    height: 28px; horizontal-stretch: 0; border-radius: 14px;
    background: root.active ? Surface.wash(Theme.transfer-accent, 0.18)
                            : Surface.body(Theme.panel-2);
    border-width: Surface.edge-w(1px);
    border-color: Surface.clay ? transparent
                : (root.active ? Theme.transfer-accent : Theme.outline);
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 11px; padding-right: 11px; spacing: 6px; alignment: center;
        Text {
            text: root.iface.ip; color: root.active ? Theme.transfer-accent : Theme.text;
            font-size: 11.5px; font-weight: 700; vertical-alignment: center;
        }
        Text {
            text: root.iface.name; color: Theme.text-dim; font-size: 10.5px;
            vertical-alignment: center;
        }
    }
}

// ── who the next file is for ────────────────────────────────────────────────
// A dropdown, not a row of chips. Ten devices may be paired and the title row is
// one line of a three-column card — chips would have run into the count and the
// Clear-all button long before the tenth. One fixed-width control instead, which
// costs the same space whether one phone is paired or all ten.
//
// Files are stamped with whoever is picked when they are added, so changing this
// aims the next pick without re-addressing what is already in the tray.
component TargetSelect inherits Rectangle {
    in property <[TransferDevice]> devices: [];
    /// The selected device token, "" for everyone.
    in property <string> target: "";
    /// That device's display name. Resolved in Rust rather than looked up here:
    /// Slint cannot search a model, and the one place that already turns a token
    /// into a name is the code that builds the model.
    in property <string> target-name: "";
    in property <color> tint;
    callback selected(string);

    width: 132px; height: 26px; horizontal-stretch: 0;
    border-radius: Surface.rr(8px, self.width, self.height);
    background: Surface.wash(root.tint, hov.has-hover ? 0.2 : 0.1);
    border-width: Surface.edge-w(1px);
    border-color: Surface.edge(root.tint, hov.has-hover ? 0.8 : 0.42);
    animate background, border-color { duration: 120ms; }

    hov := TouchArea {
        mouse-cursor: pointer;
        clicked => { pop.show(); }
    }
    HorizontalLayout {
        padding-left: 9px; padding-right: 8px; spacing: 5px;
        Text {
            text: "→";
            color: root.tint; font-size: 11px; font-weight: 700;
            vertical-alignment: center; horizontal-stretch: 0;
        }
        Text {
            text: root.target == "" ? "Everyone" : root.target-name;
            color: Theme.text; font-size: 10.5px; font-weight: 700;
            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            AppIcon {
                source: Icons.chevron-down; tint: root.tint;
                width: 10px; height: 10px;
            }
        }
    }
    pop := PopupWindow {
        x: 0; y: 30px; width: root.width;
        Rectangle {
            background: Theme.panel;
            border-radius: Surface.rr(10px, self.width, self.height);
            border-width: 1px; border-color: Surface.edge(root.tint, 0.55);
            drop-shadow-blur: Surface.cast(22px);
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 6px;
            VerticalLayout {
                padding: 5px; spacing: 1px;
                // Always first, and always present: it is the default and the way
                // back from having picked one phone.
                Rectangle {
                    height: 28px; border-radius: Surface.rr(7px, self.width, self.height);
                    background: root.target == "" ? Surface.wash(root.tint, 0.2)
                              : (evh.has-hover ? Surface.wash(root.tint, 0.12) : transparent);
                    evh := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.selected(""); }
                    }
                    HorizontalLayout {
                        padding-left: 9px; padding-right: 9px;
                        Text {
                            text: "Everyone";
                            color: root.target == "" ? root.tint : Theme.text;
                            font-size: 11px; font-weight: root.target == "" ? 700 : 500;
                            vertical-alignment: center;
                        }
                    }
                }
                for d in root.devices: Rectangle {
                    height: 28px; border-radius: Surface.rr(7px, self.width, self.height);
                    background: root.target == d.token ? Surface.wash(root.tint, 0.2)
                              : (dh.has-hover ? Surface.wash(root.tint, 0.12) : transparent);
                    dh := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.selected(d.token); }
                    }
                    HorizontalLayout {
                        padding-left: 9px; padding-right: 9px; spacing: 6px;
                        Text {
                            text: d.name;
                            color: root.target == d.token ? root.tint : Theme.text;
                            font-size: 11px; font-weight: root.target == d.token ? 700 : 500;
                            vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                        }
                        Text {
                            text: d.kind; color: Theme.text-dim; font-size: 10px;
                            vertical-alignment: center; horizontal-stretch: 0;
                        }
                    }
                }
            }
        }
    }
}

// ── one progress row for an upload in flight ────────────────────────────────
// A success disappears on its own a few seconds after it lands — the permanent
// record is the Recent Transfers row below. A failure has no timer: it is the
// one thing here worth reading late, so it waits to be dismissed.
component UploadRow inherits Rectangle {
    in property <TransferUp> up;
    callback dismiss();
    property <bool> failed: root.up.state == "failed";
    height: root.failed ? 82px : 64px;
    border-radius: Surface.rr(11px, self.width, self.height);
    background: root.failed ? Surface.wash(Theme.error, 0.07) : Surface.body(Theme.panel-2);
    border-width: Surface.edge-w(root.failed ? 1px : 0px);
    border-color: Surface.edge(Theme.error, 0.28);
    property <color> tint:
        root.up.state == "done"   ? Theme.ok :
        root.failed               ? Theme.error :
                                    Theme.transfer-accent;
    VerticalLayout {
        padding: 11px; spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.up.name; color: Theme.text; font-size: 12.5px;
                overflow: elide; horizontal-stretch: 1; vertical-alignment: center;
            }
            Text {
                text: root.up.state == "done"   ? "Done"
                    : root.failed               ? "Failed"
                    : Math.round(root.up.pct * 100) + "%";
                color: root.tint; font-size: 11.5px; font-weight: 700;
                horizontal-stretch: 0; vertical-alignment: center;
            }
        }
        Rectangle {
            height: 4px; border-radius: 2px; background: Theme.outline;
            Rectangle {
                x: 0; y: 0; height: parent.height; border-radius: 2px;
                width: parent.width * (root.up.state == "done" ? 1.0 : root.up.pct);
                background: root.tint;
                animate width { duration: 200ms; easing: ease-out; }
            }
        }
        // While it is arriving: how much has landed out of how much, and how
        // fast. A bare percentage says nothing about whether a 2 GB file is
        // going to take one minute or twenty.
        if !root.failed: HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.up.moved != "" ? root.up.moved : root.up.size;
                color: Theme.text-dim; font-size: 10.5px;
                horizontal-stretch: 1; overflow: elide; vertical-alignment: center;
            }
            if root.up.rate != "": Text {
                text: root.up.rate; color: root.tint;
                font-size: 10.5px; font-weight: 700;
                horizontal-stretch: 0; vertical-alignment: center;
            }
        }
        // The phone is the sender, so nothing on this end can re-pull the file.
        // Saying where the retry actually lives beats a button that cannot work.
        if root.failed: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center; horizontal-stretch: 1;
                Text {
                    text: "Send it again from the phone";
                    color: Theme.text-dim; font-size: 10.5px; overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Rectangle {
                    height: 22px; min-width: 62px; border-radius: 7px;
                    background: dis.has-hover ? Theme.error.with-alpha(0.16) : transparent;
                    border-width: 1px; border-color: Theme.error.with-alpha(0.35);
                    dis := TouchArea { mouse-cursor: pointer; clicked => { root.dismiss(); } }
                    Text {
                        text: "Dismiss"; color: Theme.error;
                        font-size: 10.5px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                        width: parent.width; height: parent.height;
                    }
                }
            }
        }
    }
}

// ── one row of the shared-files tray ────────────────────────────────────────
component TrayRow inherits Rectangle {
    in property <TransferFile> file;
    in property <color> accent;
    callback remove();
    // 64px to match UploadRow, which is what makes FILES TO SEND and ARRIVING
    // the same box rather than two boxes that nearly line up.
    height: 64px; border-radius: Surface.rr(11px, self.width, self.height);
    background: Surface.body(touch.has-hover ? Theme.panel-2 : Theme.panel-2.with-alpha(0.6));
    touch := TouchArea { }
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, Surface.rr(11px, self.width, self.height) - 1px);
    }
    HorizontalLayout {
        padding-left: 11px; padding-right: 11px; spacing: 11px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Rectangle {
                width: 32px; height: 32px; border-radius: Surface.rr(9px, self.width, self.height);
                background: Surface.wash(root.accent, 0.15);
                Text {
                    text: root.file.kind; color: root.accent;
                    font-size: 9px; font-weight: 800;
                    horizontal-alignment: center; vertical-alignment: center;
                    width: parent.width; height: parent.height;
                }
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 1; spacing: 2px;
            Text { text: root.file.name; color: Theme.text; font-size: 12.5px; overflow: elide; }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.file.size; color: Theme.text-dim; font-size: 10.5px;
                    horizontal-stretch: 0;
                }
                // Only when it is for one device. "For everyone" on every row of
                // the common case would be noise on every row.
                if root.file.to != "": Text {
                    text: "→ " + root.file.to; color: root.accent;
                    font-size: 10.5px; font-weight: 700;
                    horizontal-stretch: 0; overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            RowBtn { label: "Remove"; clicked => { root.remove(); } }
        }
    }
}

// ── one paired device, as a round button ────────────────────────────────────
// The caption is the name typed on the desktop, or the device type when there is
// none. Fifteen characters at most, which is longer than a cell of the five-wide
// grid holds, so the caption elides and the popup carries the whole name.
component DeviceChip inherits Rectangle {
    in property <TransferDevice> device;
    in property <color> tint;
    /// The colour of "a file is moving", distinct from the section accent so the
    /// ring cannot be mistaken for a hover or a selection.
    in property <color> busy-tint: Theme.ok;
    callback clicked();
    horizontal-stretch: 0;
    // Placed by arithmetic inside the paired-devices grid rather than by a
    // layout, so both dimensions are fixed here: 48px circle, 6px, one line of
    // caption. The width is overridden per cell to divide the row into five.
    width: 68px; height: 70px;
    background: transparent;
    // 1.1s in and out. Only evaluated while busy, so an idle list is not asking
    // for a repaint every frame.
    property <float> beat: root.device.busy
        ? Math.abs(Math.mod(animation-tick() / 550ms, 2.0) - 1.0)
        : 0.0;
    // The type decides the glyph. Anything unrecognised gets the desktop icon
    // rather than no icon: an unknown browser is still a device.
    property <image> glyph:
        root.device.kind == "Android" || root.device.kind == "iPhone" ? Icons.device-mobile :
        root.device.kind == "iPad"                                    ? Icons.device-tablet :
        root.device.kind == "Mac"                                     ? Icons.device-laptop :
                                                                        Icons.device-desktop;
    VerticalLayout {
        spacing: 6px; alignment: start;
        HorizontalLayout {
            alignment: center;
            // Busy is a blink inside the circle, not a ring around it. The old
            // ring grew to 64px and clipped against the neighbouring cell; fill
            // and border alpha carry the same "this one is moving a file"
            // without the button ever changing size.
            Rectangle {
                width: 48px; height: 48px; border-radius: 24px;
                background: root.device.busy
                    ? Surface.wash(root.busy-tint, 0.10 + 0.26 * root.beat)
                    : Surface.wash(root.tint, t.has-hover ? 0.22 : 0.11);
                border-width: Surface.edge-w(1.5px);
                border-color: root.device.busy
                    ? Surface.edge(root.busy-tint, 0.40 + 0.55 * root.beat)
                    : Surface.edge(root.tint, t.has-hover ? 0.7 : 0.32);
                t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
                AppIcon {
                    source: root.glyph;
                    colorize: root.device.busy ? root.busy-tint : root.tint;
                    width: 20px; height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        Text {
            text: root.device.name; color: Theme.text;
            font-size: 10.5px; font-weight: 600;
            horizontal-alignment: center; overflow: elide;
        }
    }
}

// ── the bordered box a short list lives in ──────────────────────────────────
// Always drawn, empty or not: a list that appears only once it has something in
// it moves everything below it the moment a file is chosen, and the empty box is
// where the eye already is. `rows` is how many fit before it scrolls — two here,
// which is what keeps the cards short enough to leave the ledger below them room
// on one screen.
component Outline inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <string> empty;
    in property <bool> is-empty: true;
    in property <length> row-h: 52px;
    in property <int> rows: 2;
    in property <color> tint;
    /// An optional control in the title row, on the right. Empty label, no button
    /// — which is every use but Send's "Clear all".
    in property <string> action;
    callback action-clicked();
    /// Send only: who the next file added is for. Empty list draws nothing, so
    /// the picker appears the moment a device pairs and goes again when the last
    /// one is forgotten — there is nothing to aim at before that.
    in property <[TransferDevice]> targets: [];
    in property <string> target: "";
    in property <string> target-name: "";
    callback pick-target(string);
    // The box is exactly title-plus-`rows` tall and takes none of the card's
    // slack. Stretching it did not show more rows — the list inside is fixed and
    // top-aligned — it only opened a band of empty box under the last row that
    // read as stray bottom padding. The slack belongs to the panel above.
    vertical-stretch: 0;
    border-radius: Surface.rr(12px, self.width, self.height);
    background: Surface.wash(root.tint, 0.05);
    border-width: Surface.edge-w(1px); border-color: Surface.edge(root.tint, 0.38);
    // A well: the list is set into the card, so the sheen is inverted.
    if Surface.rim: Rim {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        radius: Math.max(2px, Surface.rr(12px, self.width, self.height) - 1px);
        pressed: true;
    }
    VerticalLayout {
        padding: 10px; spacing: 8px; alignment: start;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.label; color: Theme.text-dim;
                font-size: 10px; letter-spacing: 1.2px; font-weight: 700;
                horizontal-stretch: 0; vertical-alignment: center;
            }
            // Right of the title, which is where the question "for whom?" belongs
            // — beside the answer to "what?" rather than buried under the list.
            if root.targets.length > 0: TargetSelect {
                devices: root.targets;
                target: root.target;
                target-name: root.target-name;
                tint: root.tint;
                selected(t) => { root.pick-target(t); }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.note != "": Text {
                text: root.note; color: root.tint;
                font-size: 10.5px; font-weight: 700;
                horizontal-stretch: 0; vertical-alignment: center;
            }
            if root.action != "": RowBtn {
                label: root.action;
                clicked => { root.action-clicked(); }
            }
        }
        // Exactly `rows` rows tall whether it holds none, two or twenty: a box
        // that grows with its contents is the thing that was pushing the buttons
        // out of the card.
        Rectangle {
            min-height: root.rows * root.row-h + (root.rows - 1) * 10px;
            max-height: root.rows * root.row-h + (root.rows - 1) * 10px;
            background: transparent;
            // The ScrollView is unconditional — `@children` has to live in one
            // place — and the empty line is drawn over it, which it can be
            // because an empty list draws nothing underneath.
            ScrollView {
                width: parent.width; height: parent.height;
                // The horizontal bar is what left the strip of dead box under the
                // last row: nothing here is ever wider than the box, so the space
                // it reserved was never going to be used.
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    padding-right: 4px; spacing: 10px; alignment: start;
                    @children
                }
            }
            if root.is-empty: Text {
                text: root.empty; color: Theme.text-dim;
                font-size: 11.5px; wrap: word-wrap;
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
        }
    }
}

export component TransferPage inherits Rectangle {
    in property <bool> running: false;
    in property <string> status: "";
    in property <string> hint: "";
    in property <string> attempts: "";
    in property <string> url: "";
    /// Where a phone installs the root certificate, over plain http. Empty when
    /// the server is not on TLS, which is what hides the hint.
    in property <string> trust-url: "";
    // SHA-256 of the certificate being served, for the phone's first-use check.
    in property <string> fingerprint: "";
    /// The mDNS form of the address. Empty when there is no certificate, since
    /// the name is only worth offering when it is one the certificate covers.
    in property <string> host-url: "";
    in property <string> pin: "";
    in property <image> qr;
    /// The same code light-on-dark. Only the enlarged view uses it, and only
    /// when asked: a QR is meant to be dark-on-light and some scanners hold to
    /// that, so the inverted one is a choice rather than a theme.
    in property <image> qr-inv;
    in property <[TransferFile]> files: [];
    in property <string> total: "";
    in property <[TransferDevice]> devices: [];
    in property <[TransferUp]> uploads: [];
    in property <[TransferRow]> rows: [];
    in property <[TransferIface]> ifaces: [];
    in property <string> iface: "";
    /// Which paired device the tray is pointed at, "" for everyone.
    in property <string> share-target: "";
    /// That device's display name, resolved in Rust.
    in property <string> share-target-name: "";
    in property <string> inbox: "";
    in property <bool> inbox-ok: true;
    in property <int> page: 0;
    in property <int> pages: 1;
    // Which column the ledger is ordered by, as the visual index:
    // Name 0 | Size 1 | Type 2 | Status 3 | From/To 4 | Time 5.
    in property <int> sort: 5;
    in property <bool> sort-desc: true;
    in property <int> port: 8420;

    // `start` / `stop` would shadow LayoutAlignment.start inside this file.
    callback start-sharing();
    callback stop-sharing();
    callback add-files();
    callback add-folder();
    callback remove(int);
    callback clear();
    callback forget(string);
    callback set-iface(string);
    callback pick-inbox();
    callback open-inbox();
    callback open-row(int);
    /// Re-offer the file behind a failed send, by row index, and drop the row
    /// it failed on.
    callback retry-row(int);
    callback clear-history();
    callback set-page(int);
    callback set-sort(int, bool);
    callback dismiss-upload(int);
    callback rename-device(string, string);
    callback set-share-target(string);
    callback open-url();

    // How many phones may be paired at once. Mirrors `auth::MAX_DEVICES`, which
    // is what actually refuses the eleventh — this is only the caption.
    in property <int> device-max: 10;

    // Modal state. Both dialogs are drawn after the main layout so they land on
    // top — Slint z-order follows declaration order.
    property <bool> confirm-clear: false;
    property <bool> help-open: false;
    // Which device's popup is open, by token. Empty means none — the same
    // "a name, not a boolean" reasoning as the Finances sheet.
    property <string> device-open: "";
    property <TransferDevice> device;
    // The name being typed, kept out of `device` so a half-typed name is never
    // mistaken for the stored one.
    property <string> device-name: "";

    // The popup works off a copy, not off an index into `devices`: the list is
    // replaced wholesale on every refresh, and an index would start pointing at a
    // different phone the moment one of them expired.
    function open-device(d: TransferDevice) {
        root.device = d;
        root.device-name = d.name;
        root.device-open = d.token;
    }

    // A second click on the active column flips direction; a first click on a
    // new one starts from the reading most people want — newest, biggest,
    // A-first — rather than always ascending.
    function sort-clicked(col: int) {
        if (root.sort == col) {
            root.set-sort(col, !root.sort-desc);
        } else {
            root.set-sort(col, col == 1 || col == 5);
        }
    }

    // One hue per box, and every border on the page is drawn from one of these.
    // Five boxes in three columns all outlined in the same grey read as one
    // undifferentiated grid; a hue each is what says which card a panel belongs
    // to before the label is read.
    property <color> accent: Theme.transfer-accent;
    property <color> send-tint: #6366f1;    // indigo — giving
    property <color> recv-tint: Theme.ok;   // green  — getting
    property <color> pair-tint: #f59e0b;    // amber  — who is let in
    property <color> hist-tint: #06b6d4;    // cyan   — what already happened
    property <color> help-tint: #64748b;    // slate  — neither, so neutral

    // The device popup's three footer buttons, sized as a set.
    property <length> btn-w: 118px;
    property <length> btn-h: 38px;

    // The ledger's six column pills. One family — cyan through violet, all at
    // roughly the same saturation and lightness — so six different fills read as
    // a set rather than six unrelated badges, and white sits legibly on every
    // one of them under both themes.
    property <color> col-name:   #06b6d4;
    property <color> col-size:   #0ea5e9;
    property <color> col-type:   #6366f1;
    property <color> col-status: #14b8a6;
    property <color> col-peer:   #3b82f6;
    property <color> col-time:   #8b5cf6;

    // Three equal columns, sized here rather than left to `horizontal-stretch`.
    // A stretch factor only divides *leftover* space, and these cards have very
    // different preferred widths — the QR block makes Connection wide and the
    // drop zone makes Send narrow — so stretching handed Connection ~910px and
    // Send ~320px. Pinning min == max is what actually forces equal columns.
    property <length> gutter: 20px;
    // 44px of body padding, two gutters, and 16px of headroom for the
    // ScrollView's own scrollbar — without that last term three exact thirds
    // overflow by a few pixels and earn a horizontal scrollbar.
    property <length> col-w: max(300px, (root.width - 44px - 2 * root.gutter - 16px) / 3);
    // One height for all three cards, so none of them moves when a file is
    // chosen or a phone pairs. The number is Send at rest — header, the picker
    // panel, and a two-row FILES TO SEND box — with enough headroom for a
    // two-line subtitle at the narrowest column. Every card has one panel that
    // stretches into whatever slack is left, so the extra never shows as a gap.
    // 576 is the tallest of the three at its worst — Connection with a network
    // picker and a two-line subtitle at the narrowest column. Anything larger is
    // dead space in all three and pushes the ledger off the first screen.
    property <length> card-h: 576px;

    // Which way round the enlarged code is drawn. Off by default and reset by
    // nothing: whoever flipped it did so because their screen or their eyes
    // wanted it that way, and it should still be that way next time.
    property <bool> qr-dark: false;

    background: transparent;

    VerticalLayout {
        spacing: 0px;

        // ── header: identity, live address, the one control that opens or
        // closes the port ───────────────────────────────────────────────────
        Rectangle {
            height: 76px; horizontal-stretch: 1;
            background: Surface.panel(Theme.panel, root.accent);
            border-width: Surface.edge-w(1px);
            border-color: Surface.clay ? transparent : Theme.outline;
            HorizontalLayout {
                padding-left: 26px; padding-right: 26px; spacing: 14px;
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: 40px; height: 40px; border-radius: Surface.rr(12px, self.width, self.height);
                        background: Surface.wash(root.accent, 0.16);
                        AppIcon {
                            source: Icons.share; colorize: root.accent; width: 20px; height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Text { text: "Transfer"; color: Theme.text; font-size: 23px; font-weight: 700; }
                }
                // The bind error, verbatim, when there is one — a silent
                // failure here is indistinguishable from a dismissed firewall
                // prompt.
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            AppIcon {
                                source: Icons.link; colorize: Theme.text-dim;
                                width: 14px; height: 14px;
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1;
                            Text {
                                text: root.status; color: Theme.text-dim; font-size: 12.5px;
                                overflow: elide; wrap: no-wrap;
                            }
                        }
                    }
                }
                if root.running: VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        height: 28px; min-width: 88px; border-radius: 14px;
                        background: Surface.wash(Theme.ok, 0.14);
                        HorizontalLayout {
                            padding-left: 11px; padding-right: 12px; spacing: 6px; alignment: center;
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                AppIcon {
                                    source: Icons.wifi; colorize: Theme.ok;
                                    width: 13px; height: 13px;
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Text {
                                    text: "Online"; color: Theme.ok;
                                    font-size: 11.5px; font-weight: 700; vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        height: 34px; min-width: 118px; border-radius: 17px;
                        // Solid either way — an outlined Stop beside a filled
                        // Start read as the disabled one of the pair.
                        background: root.running
                            ? (stopper.pressed ? Theme.error.darker(32%)
                              : (stopper.has-hover ? Theme.error.darker(16%) : Theme.error))
                            : (stopper.pressed ? root.accent.darker(32%)
                              : (stopper.has-hover ? root.accent.darker(16%) : root.accent));
                        animate background { duration: 110ms; }
                        stopper := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.running) { root.stop-sharing(); } else { root.start-sharing(); }
                            }
                        }
                        Text {
                            text: root.running ? "Stop sharing" : "Start sharing";
                            color: #ffffff;
                            font-size: 12.5px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
                // Help sits beside the one control that matters, because the
                // moment a person needs it is the moment sharing looks on and
                // the phone still says it cannot connect.
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        height: 34px; min-width: 92px; border-radius: 17px;
                        // Slate: neither of the two things the page does, so it
                        // takes neither of their colours.
                        background: helper.pressed ? root.help-tint.darker(32%)
                            : (helper.has-hover ? root.help-tint.darker(16%) : root.help-tint);
                        animate background { duration: 110ms; }
                        helper := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.help-open = true; }
                        }
                        HorizontalLayout {
                            padding-left: 13px; padding-right: 14px; spacing: 7px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                AppIcon {
                                    source: Icons.info; colorize: #ffffff;
                                    width: 15px; height: 15px;
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Text {
                                    text: "Help"; color: #ffffff;
                                    font-size: 12.5px; font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        sv := ScrollView {
            horizontal-stretch: 1; vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: body.preferred-height;
            // Every page in this app opens at the top; a ScrollView otherwise
            // keeps whatever viewport-y it had the last time it was alive.
            init => { self.viewport-y = 0; }

            body := VerticalLayout {
                width: parent.width;
                padding: 22px; spacing: 20px;

                // ── the three cards ─────────────────────────────────────────
                HorizontalLayout {
                    spacing: root.gutter;

                    // ── Connection ──────────────────────────────────────────
                    Card {
                        min-width: root.col-w; max-width: root.col-w;
                        height: root.card-h;
                        title: "Connection";
                        subtitle: "Scan the code, or type the address and PIN.";
                        icon: Icons.link;
                        tint: root.accent;

                        // The three ways in — code, address, PIN — inside one
                        // bordered panel, the same one Send's picker is drawn
                        // as. Separately they read as three unrelated fields;
                        // together they read as the one thing the card is for.
                        // It is also the card's stretchy panel: when there is no
                        // network picker to draw, the slack lands here rather
                        // than as a gap under the device grid.
                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: Surface.rr(14px, self.width, self.height);
                            background: Surface.wash(root.accent, 0.05);
                            border-width: Surface.edge-w(1.5px);
                            border-color: Surface.edge(root.accent, 0.42);
                            if Surface.rim: Rim {
                                x: 1px; y: 1px;
                                width: parent.width - 2px; height: parent.height - 2px;
                                radius: Math.max(2px, Surface.rr(14px, self.width, self.height) - 1px);
                                pressed: true;
                            }
                            HorizontalLayout {
                                padding: 16px; spacing: 16px;
                                // The QR carries a single-use pairing key, not the
                                // PIN — a photo of this screen taken later is
                                // worthless.
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    qrbox := Rectangle {
                                        // 140 rather than 168: still a comfortable
                                        // scan target, and the 28px is what the
                                        // three cards came down by.
                                        width: 140px; height: 140px;
                                        border-radius: 14px;
                                        background: root.running ? #ffffff : Theme.panel-2;
                                        // The white plate needs a visible edge of
                                        // its own or it floats in the panel it
                                        // sits in on the light theme.
                                        border-width: 1.5px;
                                        border-color: root.accent.with-alpha(qrhov.has-hover ? 0.75 : 0.38);
                                        animate border-color { duration: 120ms; }
                                        qrhov := TouchArea {
                                            mouse-cursor: root.running ? pointer : default;
                                            clicked => { if (root.running) { qrpop.show(); } }
                                        }
                                        if root.running: Image {
                                            source: root.qr; image-fit: contain;
                                            width: parent.width - 14px; height: parent.height - 14px;
                                            x: 7px; y: 7px;
                                        }
                                        if !root.running: Text {
                                            text: "Not sharing"; color: Theme.text-dim; font-size: 12px;
                                            horizontal-alignment: center; vertical-alignment: center;
                                            width: parent.width; height: parent.height;
                                        }

                                        // 140px is a scan target for a phone held
                                        // near the screen; across a desk it is not.
                                        // Clicking the code blows it up rather than
                                        // making every session's card bigger for the
                                        // one time in ten that the distance matters.
                                        qrpop := PopupWindow {
                                            // Centred on the page, not on the 140px
                                            // square it belongs to. A popup this size
                                            // hung off the Connection card sits half
                                            // over one column and half over the next;
                                            // the middle of the page is where the eye
                                            // already is when something opens.
                                            // Coordinates here are the parent's, so
                                            // the page's origin has to be walked back
                                            // to — hence the two absolute-positions.
                                            x: root.absolute-position.x - qrbox.absolute-position.x
                                                + (root.width - self.width) / 2;
                                            y: root.absolute-position.y - qrbox.absolute-position.y
                                                + (root.height - self.height) / 2;
                                            width: 424px; height: 512px;
                                            close-policy: close-on-click-outside;
                                            Rectangle {
                                                width: 100%; height: 100%;
                                                border-radius: Surface.rr(18px, self.width, self.height);
                                                background: Surface.panel(Theme.panel, root.accent);
                                                border-width: Surface.edge-w(1.5px);
                                                border-color: Surface.edge(root.accent, 0.45);
                                                drop-shadow-blur: Surface.cast(40px);
                                                drop-shadow-color: Surface.cast-ink(#00000099);
                                                drop-shadow-offset-y: Surface.cast-y(40px);
                                                VerticalLayout {
                                                    padding: 18px; spacing: 12px;
                                                    Text {
                                                        text: "Scan to pair";
                                                        color: Theme.text; font-size: 15px; font-weight: 800;
                                                        horizontal-alignment: center;
                                                    }
                                                    // Same plate as the small one, on
                                                    // purpose: the enlarged view is the
                                                    // card's own code, not a second
                                                    // widget that happens to look alike.
                                                    Rectangle {
                                                        height: 316px;
                                                        border-radius: 16px;
                                                        background: root.qr-dark ? #0c0e16 : #ffffff;
                                                        border-width: 1.5px;
                                                        border-color: root.accent.with-alpha(0.38);
                                                        animate background { duration: 140ms; }
                                                        Image {
                                                            source: root.qr-dark ? root.qr-inv : root.qr;
                                                            image-fit: contain;
                                                            width: 300px; height: 300px;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                        }
                                                    }
                                                    Text {
                                                        text: root.url;
                                                        color: Theme.text-dim; font-size: 11.5px;
                                                        horizontal-alignment: center; overflow: elide;
                                                    }
                                                    HorizontalLayout {
                                                        alignment: center; spacing: 8px;
                                                        ActionButton {
                                                            label: root.qr-dark ? "Normal code" : "Invert code";
                                                            icon: Icons.contrast;
                                                            tint: root.accent;
                                                            clicked => { root.qr-dark = !root.qr-dark; }
                                                        }
                                                        ActionButton {
                                                            label: "Close";
                                                            tint: root.help-tint;
                                                            clicked => { qrpop.close(); }
                                                        }
                                                    }
                                                    // Said once, here, rather than
                                                    // discovered as a code that will
                                                    // not scan on somebody's phone.
                                                    if root.qr-dark: Text {
                                                        text: "A few scanners only read dark-on-light. Switch back if this one will not take.";
                                                        color: Theme.text-dim; font-size: 10.5px;
                                                        horizontal-alignment: center; wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1; spacing: 10px; alignment: center;
                                    VerticalLayout {
                                        spacing: 5px;
                                        Text {
                                            text: "ADDRESS"; color: Theme.text-dim;
                                            font-size: 10px; letter-spacing: 1.3px; font-weight: 700;
                                        }
                                        ValueField {
                                            value: root.running ? root.url : "—";
                                            size: 13px; tone: root.accent; weight: 700;
                                            // Opens this machine's browser on the
                                            // phone page, already paired — the URL
                                            // carries a fresh single-use key, the
                                            // same mechanism the QR uses. Without
                                            // it the desktop was asked for the PIN
                                            // it is itself displaying, every time.
                                            action: root.running ? "Open" : "";
                                            action-clicked => { root.open-url(); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 5px;
                                        Text {
                                            text: "PIN"; color: Theme.text-dim;
                                            font-size: 10px; letter-spacing: 1.3px; font-weight: 700;
                                        }
                                        ValueField {
                                            value: root.running ? root.pin : "——————";
                                            size: 22px; tone: root.accent; weight: 800;
                                        }
                                    }
                                    // The same machine by name, for a phone whose
                                    // browser resolves .local. Under the address
                                    // rather than instead of it: plenty do not.
                                    if root.host-url != "": Text {
                                        text: "also " + root.host-url;
                                        color: Theme.text-dim; font-size: 10.5px;
                                        overflow: elide;
                                    }
                                    // Somebody grinding the PIN is silent from this
                                    // end otherwise: the guesser gets a 429 and the
                                    // desktop shows nothing.
                                    if root.attempts != "": Text {
                                        text: root.attempts; color: Theme.error;
                                        font-size: 11px; font-weight: 600; wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        // Both a hotspot and a Wi-Fi link commonly qualify;
                        // only the person holding the phone knows which.
                        if root.ifaces.length > 1: VerticalLayout {
                            spacing: 7px;
                            Text {
                                text: "THIS NETWORK"; color: Theme.text-dim;
                                font-size: 10px; letter-spacing: 1.3px; font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: 6px; alignment: start;
                                for f in root.ifaces: IfaceChip {
                                    iface: f;
                                    active: f.ip == root.iface;
                                    clicked => { root.set-iface(f.ip); }
                                }
                            }
                        }

                        // ── paired devices ──────────────────────────────────
                        // Here rather than in Send: pairing is how a device gets
                        // in, which is this card's whole subject. Send is about
                        // files, and a phone that has paired can be sent nothing
                        // until a file is chosen anyway.
                        // Same bordered box as the two file lists, so the card's
                        // three blocks read as one family. Two rows of five is
                        // exactly `device-max`, so the box never scrolls and
                        // never grows — the tenth phone lands in the last cell.
                        Outline {
                            label: "PAIRED DEVICES";
                            note: root.devices.length + " / " + root.device-max;
                            empty: root.running
                                ? "Nothing paired yet. Scan the code, or type the address and PIN on the phone."
                                : "Start sharing, then scan the code from the phone.";
                            is-empty: root.devices.length == 0;
                            rows: 2; row-h: 70px;
                            // Amber, not the card's violet: this is the one box
                            // in Connection that is about people rather than
                            // plumbing. Red once it is full — the count is the
                            // only warning that the next phone will be turned
                            // away, and a sentence saying so made the card
                            // scroll.
                            tint: root.devices.length >= root.device-max
                                ? Theme.error : root.pair-tint;
                            // Slint cannot slice a model into rows, and the old
                            // collapse-to-zero-width trick left the buttons
                            // sitting on each other. Children of a plain
                            // Rectangle are placed absolutely, so index → cell
                            // is arithmetic: five columns of `cell`, two rows of
                            // 74px, nothing overlapping and nothing reflowing.
                            grid := Rectangle {
                                height: 150px;
                                background: transparent;
                                property <length> cell: (self.width - 4 * 10px) / 5;
                                for d in root.devices: DeviceChip {
                                    device: d; tint: root.pair-tint;
                                    width: grid.cell;
                                    x: Math.mod(d.idx, 5) * (grid.cell + 10px);
                                    y: Math.floor(d.idx / 5) * 80px;
                                    clicked => { root.open-device(d); }
                                }
                            }
                        }

                        // The firewall advice used to live here. It is the one
                        // failure the desktop cannot detect, so it earned a
                        // permanent strip — but it only matters once, and it
                        // sat in the card a working setup looks at every day.
                        // It is in Help now, alongside the other platforms.
                    }

                    // ── Send ────────────────────────────────────────────────
                    Card {
                        min-width: root.col-w; max-width: root.col-w;
                        height: root.card-h;
                        title: "Send";
                        subtitle: "Share files with the phone — never the library.";
                        icon: Icons.upload;
                        tint: root.send-tint;

                        // A click target, not a drop target: Slint has no
                        // OS-level file drop, and a zone that says "drag here"
                        // and then ignores a drag is worse than no zone.
                        // No min-height: it was 176px while the content inside
                        // needed nearer 200, and an explicit min-height on the
                        // Rectangle wins over what its children ask for — so the
                        // buttons were laid outside the rounded border. The padding
                        // below does the same job without lying about the size.
                        // This is Send's stretchy panel: the card is a fixed
                        // height, the file box under it is fixed, so whatever is
                        // left over grows the picker instead of the card.
                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: Surface.rr(14px, self.width, self.height);
                            background: Surface.wash(root.send-tint, pick.has-hover ? 0.10 : 0.05);
                            border-width: Surface.edge-w(1.5px);
                            border-color: pick.has-hover
                                ? Surface.edge(root.send-tint, 1.0)
                                : Surface.edge(root.send-tint, 0.42);
                            if Surface.rim: Rim {
                                x: 1px; y: 1px;
                                width: parent.width - 2px; height: parent.height - 2px;
                                radius: Math.max(2px, Surface.rr(14px, self.width, self.height) - 1px);
                                pressed: true;
                            }
                            pick := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.add-files(); }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 12px;
                                padding-left: 18px; padding-right: 18px;
                                padding-top: 20px; padding-bottom: 20px;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 62px; height: 62px; border-radius: 31px;
                                        background: @linear-gradient(135deg,
                                            root.send-tint, root.send-tint.brighter(20%));
                                        AppIcon {
                                            source: Icons.upload; colorize: #ffffff;
                                            width: 26px; height: 26px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                                Text {
                                    text: "Choose files to share";
                                    color: Theme.text; font-size: 14px; font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "They stay on this machine — the phone pulls them over the link.";
                                    color: Theme.text-dim; font-size: 11.5px;
                                    horizontal-alignment: center; wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: center; spacing: 8px;
                                    ActionButton {
                                        label: "Choose files"; icon: Icons.folder-open;
                                        tint: root.send-tint;
                                        clicked => { root.add-files(); }
                                    }
                                    ActionButton {
                                        label: "Choose folder"; icon: Icons.folder;
                                        // A shade down from its sibling: same job,
                                        // second choice, and two identical fills
                                        // side by side read as one wide button.
                                        tint: root.send-tint.darker(25%);
                                        clicked => { root.add-folder(); }
                                    }
                                }
                            }
                        }

                        // What is on offer, always visible. Two rows, then it
                        // scrolls inside its own border rather than growing the
                        // card — twelve files must not make Send taller than
                        // Connection and Receive.
                        Outline {
                            label: "FILES TO SEND";
                            note: root.files.length > 0 ? root.total : "";
                            empty: "Nothing chosen yet. Until you pick something, a paired phone sees an empty list.";
                            is-empty: root.files.length == 0;
                            // 64px, which is what TrayRow actually is. At 58 the
                            // box was six pixels short per row, so two files —
                            // the number it is sized for — already scrolled, and
                            // the second row was clipped by the amount the box
                            // was under-measured.
                            row-h: 64px;
                            tint: root.send-tint;
                            action: root.files.length > 0 ? "Clear all" : "";
                            action-clicked => { root.clear(); }
                            targets: root.devices;
                            target: root.share-target;
                            target-name: root.share-target-name;
                            pick-target(t) => { root.set-share-target(t); }
                            for f in root.files: TrayRow {
                                file: f; accent: root.send-tint;
                                remove => { root.remove(f.id); }
                            }
                        }
                    }

                    // ── Receive ─────────────────────────────────────────────
                    Card {
                        min-width: root.col-w; max-width: root.col-w;
                        height: root.card-h;
                        title: "Receive";
                        subtitle: "Everything the phone sends lands here, flat.";
                        icon: Icons.download;
                        tint: root.recv-tint;

                        // The folder and the two buttons that change it, in the
                        // same bordered panel Send's picker uses — they were one
                        // decision drawn as two blocks. Red border rather than a
                        // red field when the folder cannot be written to: the
                        // buttons are the fix, so they belong inside the warning.
                        // Receive's stretchy panel too.
                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: Surface.rr(14px, self.width, self.height);
                            background: Surface.wash(root.recv-tint, 0.05);
                            border-width: Surface.edge-w(1.5px);
                            border-color: root.inbox-ok
                                ? Surface.edge(root.recv-tint, 0.42) : Theme.error;
                            if Surface.rim: Rim {
                                x: 1px; y: 1px;
                                width: parent.width - 2px; height: parent.height - 2px;
                                radius: Math.max(2px, Surface.rr(14px, self.width, self.height) - 1px);
                                pressed: true;
                            }
                            VerticalLayout {
                                alignment: center; spacing: 12px;
                                padding-left: 16px; padding-right: 16px;
                                padding-top: 16px; padding-bottom: 16px;
                                Text {
                                    text: "INBOX FOLDER"; color: Theme.text-dim;
                                    font-size: 10px; letter-spacing: 1.3px; font-weight: 700;
                                }
                                Rectangle {
                                    height: 46px; border-radius: Surface.rr(10px, self.width, self.height);
                                    background: Surface.body(Theme.panel-2);
                                    border-width: Surface.edge-w(1px);
                                    border-color: root.inbox-ok
                                        ? (Surface.clay ? transparent : Theme.outline) : Theme.error;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 8px; spacing: 8px;
                                        VerticalLayout {
                                            alignment: center; horizontal-stretch: 1;
                                            Text {
                                                text: root.inbox; color: Theme.text; font-size: 12px;
                                                overflow: elide; vertical-alignment: center;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center; horizontal-stretch: 0;
                                            Rectangle {
                                                width: 32px; height: 32px; border-radius: 9px;
                                                background: openfold.has-hover ? Theme.panel : transparent;
                                                openfold := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.open-inbox(); }
                                                }
                                                AppIcon {
                                                    source: Icons.folder-open; colorize: root.recv-tint;
                                                    width: 16px; height: 16px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ActionButton {
                                        label: "Change location"; icon: Icons.map-pin;
                                        tint: root.recv-tint;
                                        clicked => { root.pick-inbox(); }
                                    }
                                    ActionButton {
                                        label: "Open folder"; icon: Icons.folder;
                                        tint: root.recv-tint.darker(25%);
                                        clicked => { root.open-inbox(); }
                                    }
                                }
                            }
                        }

                        if root.inbox-ok: NoteStrip {
                            title: root.uploads.length == 0
                                ? "Ready to receive" : "Receiving";
                            body: root.uploads.length == 0
                                ? "Files the phone sends will appear here."
                                : "One at a time — parallel writes to one disk are slower.";
                            icon: Icons.check;
                            tint: root.recv-tint;
                        }
                        if !root.inbox-ok: NoteStrip {
                            title: "That folder cannot be written to";
                            body: "Uploads are refused until it can. Downloads still work.";
                            icon: Icons.triangle-alert;
                            tint: Theme.error;
                        }

                        // The same box as Send's, for the same reason: the arrivals
                        // list appearing out of nowhere shifted everything under it
                        // at the exact moment attention was on it.
                        Outline {
                            label: "ARRIVING";
                            note: root.uploads.length > 0
                                ? root.uploads.length + (root.uploads.length == 1 ? " file" : " files")
                                : "";
                            empty: "Nothing arriving. What the phone sends lands in the folder above.";
                            is-empty: root.uploads.length == 0;
                            // Matches UploadRow, the same six pixels a row that
                            // FILES TO SEND was short by. A failed row is taller
                            // still and does scroll — that one is meant to be
                            // read, not glanced at.
                            row-h: 64px;
                            tint: root.recv-tint;
                            for u in root.uploads: UploadRow {
                                up: u;
                                dismiss => { root.dismiss-upload(u.id); }
                            }
                        }
                    }
                }

                // ── Recent Transfers, full width ────────────────────────────
                Card {
                    title: "Recent transfers";
                    subtitle: "Sent and received. Click a column to sort. A greyed row is a file that has since moved.";
                    icon: Icons.clock;
                    tint: root.hist-tint;
                    // Nothing to clear when the table is empty, so the button
                    // says so rather than sitting there live and doing nothing.
                    action: "Clear history";
                    action-icon: Icons.trash;
                    action-enabled: root.rows.length > 0;
                    action-clicked => { root.confirm-clear = true; }

                    // Column header. Widths are repeated on every row below —
                    // Slint has no grid that spans a repeater, so the two must
                    // be kept in step by hand.
                    //
                    // Sorting runs in SQL over the whole ledger, not over the
                    // ten rows on screen: sorting a page in place would only
                    // shuffle that page and leave the rest of the table alone.
                    //
                    // Hidden while the ledger is empty — six column pills over
                    // nothing read as a broken table rather than a fresh one.
                    if root.rows.length > 0: Rectangle {
                        height: 38px; border-radius: Surface.rr(9px, self.width, self.height);
                        background: Surface.body(Theme.panel-2);
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; spacing: 12px;
                            // Blank head over the row numbers: the column is
                            // position, and position is not something to sort by.
                            Rectangle { width: 30px; horizontal-stretch: 0; background: transparent; }
                            SortHead {
                                label: "Name"; index: 0; horizontal-stretch: 1;
                                active: root.sort; desc: root.sort-desc; tint: root.col-name;
                                clicked => { root.sort-clicked(0); }
                            }
                            // Size sits beside the filename it describes rather
                            // than three columns away.
                            SortHead {
                                label: "Size"; index: 1; min-width: 110px;
                                active: root.sort; desc: root.sort-desc; tint: root.col-size;
                                clicked => { root.sort-clicked(1); }
                            }
                            SortHead {
                                label: "Type"; index: 2; min-width: 150px;
                                active: root.sort; desc: root.sort-desc; tint: root.col-type;
                                clicked => { root.sort-clicked(2); }
                            }
                            SortHead {
                                label: "Status"; index: 3; min-width: 160px;
                                active: root.sort; desc: root.sort-desc; tint: root.col-status;
                                clicked => { root.sort-clicked(3); }
                            }
                            SortHead {
                                label: "From / To"; index: 4; min-width: 190px;
                                active: root.sort; desc: root.sort-desc; tint: root.col-peer;
                                clicked => { root.sort-clicked(4); }
                            }
                            SortHead {
                                label: "Time"; index: 5; min-width: 140px;
                                active: root.sort; desc: root.sort-desc; tint: root.col-time;
                                clicked => { root.sort-clicked(5); }
                            }
                            Rectangle { width: 34px; horizontal-stretch: 0; background: transparent; }
                        }
                    }

                    if root.rows.length == 0: Rectangle {
                        height: 64px;
                        Text {
                            text: "Nothing yet. Sent and received files are both recorded here.";
                            color: Theme.text-dim; font-size: 12px;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }

                    for r[i] in root.rows: Rectangle {
                        height: 64px; border-radius: Surface.rr(10px, self.width, self.height);
                        background: rowtouch.has-hover ? Surface.body(Theme.panel-2) : transparent;
                        opacity: r.missing ? 0.55 : 1.0;
                        rowtouch := TouchArea {
                            mouse-cursor: r.path == "" ? default : pointer;
                            clicked => { if (r.path != "") { root.open-row(i); } }
                        }
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; spacing: 12px;

                            // Row number, counted through the whole ledger and
                            // not restarted per page — page two opens at 11, so
                            // the number says which transfer this is rather than
                            // where it happens to sit on screen. PAGE_SIZE is 10.
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Text {
                                    text: root.page * 10 + i + 1;
                                    color: Theme.text-dim; font-size: 11.5px; font-weight: 700;
                                    width: 30px; horizontal-alignment: center;
                                }
                            }

                            // Name — icon tile, filename, what kind of file.
                            HorizontalLayout {
                                horizontal-stretch: 1; spacing: 11px; alignment: start;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    Rectangle {
                                        width: 34px; height: 34px; border-radius: Surface.rr(10px, self.width, self.height);
                                        background: Surface.wash(
                                            r.direction == "in" ? root.recv-tint : root.accent, 0.14);
                                        Text {
                                            text: r.kind;
                                            color: r.direction == "in" ? root.recv-tint : root.accent;
                                            font-size: 9px; font-weight: 800;
                                            horizontal-alignment: center; vertical-alignment: center;
                                            width: parent.width; height: parent.height;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 2px;
                                    Text {
                                        text: r.name; color: Theme.text; font-size: 12.5px;
                                        font-weight: 600; overflow: elide;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: r.kindlabel; color: Theme.text-dim; font-size: 10.5px;
                                        overflow: elide; horizontal-alignment: center;
                                    }
                                }
                            }

                            // Size — kept next to the name it belongs to.
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Text {
                                    text: r.size; color: Theme.text; font-size: 12px;
                                    min-width: 110px; horizontal-alignment: center;
                                }
                            }

                            // Type — which way it went.
                            HorizontalLayout {
                                min-width: 150px; horizontal-stretch: 0; spacing: 7px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    AppIcon {
                                        source: r.direction == "in" ? Icons.arrow-down : Icons.arrow-up;
                                        colorize: r.direction == "in" ? root.recv-tint : root.accent;
                                        width: 15px; height: 15px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Text {
                                        text: r.direction == "in" ? "Received" : "Sent";
                                        color: r.direction == "in" ? root.recv-tint : root.accent;
                                        font-size: 12px; font-weight: 600; vertical-alignment: center;
                                    }
                                }
                            }

                            // Status. A file still on the wire says how far along
                            // it is and how fast, over its own progress bar —
                            // the row is written on the first chunk, so without
                            // this a 4 GB download claimed to be done at once.
                            HorizontalLayout {
                                min-width: 160px; horizontal-stretch: 0; spacing: 7px;
                                alignment: center;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 0;
                                    AppIcon {
                                        source: r.status == "ok" ? Icons.check
                                            : r.status == "sending" ? Icons.arrow-up
                                            : Icons.triangle-alert;
                                        colorize: r.status == "ok" ? Theme.ok
                                            : r.status == "sending" ? root.accent : Theme.error;
                                        width: 15px; height: 15px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text {
                                        text: r.status == "ok" ? "Completed"
                                            : r.status == "sending"
                                                ? (r.progress != "" ? r.progress : "Sending…")
                                                : r.status;
                                        color: r.status == "ok" ? Theme.ok
                                            : r.status == "sending" ? root.accent : Theme.error;
                                        font-size: 12px; font-weight: 600; vertical-alignment: center;
                                    }
                                    if r.status == "sending": Rectangle {
                                        height: 3px; border-radius: 1.5px;
                                        background: Theme.outline;
                                        Rectangle {
                                            x: 0; y: 0; height: parent.height; border-radius: 1.5px;
                                            width: parent.width * r.pct;
                                            background: root.accent;
                                            animate width { duration: 200ms; easing: ease-out; }
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0; spacing: 2px;
                                Text {
                                    text: r.direction == "in" ? "From" : "To"; color: Theme.text-dim;
                                    font-size: 10px; min-width: 190px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: r.peer; color: Theme.text; font-size: 11.5px;
                                    font-weight: 600; min-width: 190px;
                                    horizontal-alignment: center;
                                }
                                // Offers the file again, and drops the failed row
                                // so the table does not keep a record that has
                                // been superseded. Only for a send: an upload is
                                // the phone's to repeat, and only while the file
                                // is still where it was read from.
                                if r.status == "failed" && r.direction == "out" && !r.missing
                                        && r.path != "": Rectangle {
                                    height: 20px; min-width: 68px; border-radius: 7px;
                                    background: retry.has-hover
                                        ? Surface.wash(root.accent, 0.18) : transparent;
                                    border-width: 1px;
                                    border-color: Surface.edge(root.accent, 0.4);
                                    retry := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.retry-row(i); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 7px; padding-right: 7px; spacing: 5px;
                                        alignment: center;
                                        VerticalLayout {
                                            alignment: center;
                                            AppIcon {
                                                source: Icons.refresh-cw; colorize: root.accent;
                                                width: 11px; height: 11px;
                                            }
                                        }
                                        Text {
                                            text: "Send again"; color: root.accent;
                                            font-size: 10px; font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Text {
                                    text: r.stamp; color: Theme.text-dim; font-size: 11.5px;
                                    min-width: 140px; horizontal-alignment: center;
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 0;
                                Rectangle {
                                    width: 34px; height: 34px; border-radius: 9px;
                                    background: reveal.has-hover ? Theme.panel : transparent;
                                    opacity: r.path == "" ? 0.25 : 1.0;
                                    reveal := TouchArea {
                                        mouse-cursor: r.path == "" ? default : pointer;
                                        clicked => { if (r.path != "") { root.open-row(i); } }
                                    }
                                    AppIcon {
                                        source: Icons.folder-open; colorize: Theme.text-dim;
                                        width: 15px; height: 15px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }
                    }

                    // Pagination. Hidden outright on a single page — a Previous
                    // and Next that can never do anything is just noise.
                    if root.pages > 1: HorizontalLayout {
                        spacing: 8px; alignment: center;
                        PageBtn {
                            label: "Previous"; icon: Icons.chevron-left;
                            tint: root.hist-tint;
                            enabled: root.page > 0;
                            clicked => { root.set-page(root.page - 1); }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 0;
                            Text {
                                text: "Page " + (root.page + 1) + " of " + root.pages;
                                color: Theme.text-dim; font-size: 11.5px; font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        PageBtn {
                            label: "Next"; icon: Icons.chevron-right; trailing: true;
                            tint: root.hist-tint;
                            enabled: root.page + 1 < root.pages;
                            clicked => { root.set-page(root.page + 1); }
                        }
                    }
                }

                // The one thing a phone cannot discover on its own. It meets the
                // browser's certificate warning and has no way to learn there is
                // a page that makes it go away, so the desktop is where that
                // address has to be readable. Here rather than in Connection: the
                // cards are a fixed height, and this would have cost all three of
                // them 60px of it for a line that is read once per phone.
                if root.trust-url != "": Rectangle {
                    border-radius: Surface.rr(12px, self.width, self.height);
                    background: Surface.wash(root.pair-tint, 0.08);
                    border-width: Surface.edge-w(1px);
                    border-color: Surface.edge(root.pair-tint, 0.32);
                    HorizontalLayout {
                        padding: 11px; padding-left: 14px; padding-right: 14px; spacing: 11px;
                        VerticalLayout {
                            alignment: start; horizontal-stretch: 0;
                            Rectangle {
                                width: 30px; height: 30px; border-radius: 15px;
                                background: Surface.wash(root.pair-tint, 0.18);
                                AppIcon {
                                    source: Icons.shield; colorize: root.pair-tint;
                                    width: 15px; height: 15px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1; spacing: 3px;
                            Text {
                                text: "First time on a phone? The browser asks about the certificate once.";
                                color: Theme.text; font-size: 12px; font-weight: 700;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "The QR goes to " + root.trust-url + " — tap Continue, then Advanced and Proceed. The phone remembers this certificate from then on, and a different one on this address asks again. Nothing to install.";
                                color: Theme.text-dim; font-size: 11px; wrap: word-wrap;
                            }
                            // The half of trust-on-first-use that makes it worth
                            // anything: something to compare the phone's warning
                            // against. Shown here because this is the end nobody
                            // can tamper with from the network.
                            if root.fingerprint != "": Text {
                                text: root.fingerprint;
                                color: Theme.text-dim; font-size: 10px;
                                font-family: "monospace"; wrap: word-wrap;
                            }
                        }
                    }
                }

                // ── footer ──────────────────────────────────────────────────
                HorizontalLayout {
                    alignment: center; spacing: 8px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        AppIcon {
                            source: Icons.shield; colorize: Theme.text-dim;
                            width: 14px; height: 14px;
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Text {
                            text: "Transfers go straight between your devices — no relay, no account, nothing stored on a server.";
                            color: Theme.text-dim; font-size: 11.5px; vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── modals ──────────────────────────────────────────────────────────────
    // Declared after the layout, which is what puts them on top: Slint paints in
    // declaration order. The scrim's own TouchArea both dims the page and eats
    // clicks meant for what is behind it.

    if root.confirm-clear: Rectangle {
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.confirm-clear = false; } }
        Rectangle {
            width: min(430px, parent.width - 48px);
            height: self.preferred-height;
            border-radius: Surface.panel-radius;
            background: Surface.panel(Theme.panel, root.accent);
            border-width: Surface.edge-w(1px);
            border-color: Surface.clay ? transparent : Theme.outline;
            drop-shadow-blur: Surface.cast(40px);
            drop-shadow-color: Surface.cast-ink(#00000055);
            drop-shadow-offset-y: Surface.cast-y(40px);
            // Without this the click would fall through to the scrim and close
            // the dialog the moment anyone touched it.
            TouchArea { }
            VerticalLayout {
                padding: 24px; spacing: 16px;
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: start; horizontal-stretch: 0;
                        Rectangle {
                            width: 44px; height: 44px; border-radius: 22px;
                            background: Surface.wash(Theme.error, 0.14);
                            AppIcon {
                                source: Icons.trash; colorize: Theme.error;
                                width: 20px; height: 20px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 6px; alignment: center;
                        Text {
                            text: "Clear transfer history?";
                            color: Theme.text; font-size: 17px; font-weight: 700;
                            wrap: word-wrap;
                        }
                        // The distinction worth spelling out: this is a log, and
                        // people reach for it expecting a delete.
                        Text {
                            text: "This erases the record of what was sent and received. "
                                + "The files themselves are not touched, and paired devices stay paired.";
                            color: Theme.text-dim; font-size: 12.5px; wrap: word-wrap;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.outline; }
                HorizontalLayout {
                    spacing: 10px; alignment: end;
                    Rectangle {
                        height: 36px; min-width: 92px; border-radius: Surface.btn-radius;
                        background: cancel-t.pressed ? root.help-tint.darker(32%)
                            : (cancel-t.has-hover ? root.help-tint.darker(16%) : root.help-tint);
                        animate background { duration: 110ms; }
                        cancel-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.confirm-clear = false; }
                        }
                        Text {
                            text: "Cancel"; color: #ffffff;
                            font-size: 12.5px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                    Rectangle {
                        height: 36px; min-width: 124px; border-radius: Surface.btn-radius;
                        background: wipe-t.pressed ? Theme.error.darker(32%)
                            : (wipe-t.has-hover ? Theme.error.darker(16%) : Theme.error);
                        animate background { duration: 110ms; }
                        wipe-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.confirm-clear = false;
                                root.clear-history();
                            }
                        }
                        Text {
                            text: "Clear history"; color: #ffffff;
                            font-size: 12.5px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: parent.width; height: parent.height;
                        }
                    }
                }
            }
        }
    }

    if root.help-open: Rectangle {
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.help-open = false; } }
        Rectangle {
            width: min(620px, parent.width - 48px);
            height: min(640px, parent.height - 48px);
            border-radius: Surface.panel-radius;
            background: Surface.panel(Theme.panel, root.accent);
            border-width: Surface.edge-w(1px);
            border-color: Surface.clay ? transparent : Theme.outline;
            drop-shadow-blur: Surface.cast(40px);
            drop-shadow-color: Surface.cast-ink(#00000055);
            drop-shadow-offset-y: Surface.cast-y(40px);
            TouchArea { }
            VerticalLayout {
                padding: 0px;
                // Header, outside the scroll so the close button stays put.
                HorizontalLayout {
                    padding: 20px; spacing: 13px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            width: 42px; height: 42px; border-radius: 21px;
                            background: Surface.wash(root.accent, 0.14);
                            AppIcon {
                                source: Icons.info; colorize: root.accent;
                                width: 20px; height: 20px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1; spacing: 3px;
                        Text {
                            text: "Connecting a device";
                            color: Theme.text; font-size: 17px; font-weight: 700;
                        }
                        Text {
                            text: "Anything with a browser works. No app to install on the other end.";
                            color: Theme.text-dim; font-size: 12px; wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            width: 32px; height: 32px; border-radius: 9px;
                            background: closeh.has-hover ? Theme.panel-2 : transparent;
                            closeh := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.help-open = false; }
                            }
                            AppIcon {
                                source: Icons.x; colorize: Theme.text-dim;
                                width: 15px; height: 15px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.outline; }

                helpsv := ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    viewport-height: helpbody.preferred-height;
                    init => { self.viewport-y = 0; }

                    helpbody := VerticalLayout {
                        width: parent.width;
                        padding: 20px; spacing: 14px;

                        HelpBlock {
                            title: "Start here";
                            tint: root.accent;
                            icon: Icons.wifi;
                            body: "1.  Press Start sharing on this computer.\n"
                                + "2.  Put both devices on the same Wi-Fi, or tether one to the other's hotspot.\n"
                                + "3.  Scan the QR code, or type the address into any browser.\n"
                                + "4.  Enter the 6-digit PIN. The QR skips this — it carries a single-use key that lasts 60 seconds.";
                        }

                        // The live one, with this machine's real port and link
                        // substituted in. It sits first because a person opening
                        // this panel is almost always already stuck.
                        if root.hint != "": HelpBlock {
                            title: "Phone says it cannot connect";
                            tint: Theme.warn;
                            icon: Icons.shield;
                            body: root.hint;
                        }

                        HelpBlock {
                            title: "Windows";
                            tint: #0ea5e9;
                            icon: Icons.monitor-play;
                            body: "Windows Firewall asks once, on the very first bind, and dismissing that dialog silently blocks every connection afterwards — with no second prompt.\n\n"
                                + "Fix it at Settings → Privacy & security → Windows Security → Firewall & network protection → Allow an app through firewall, and tick Tulipix for Private networks.\n\n"
                                + "If the network is marked Public, either switch it to Private or open TCP " + root.port + " directly.";
                        }

                        HelpBlock {
                            title: "macOS";
                            tint: #a78bfa;
                            icon: Icons.command;
                            body: "macOS asks for Local Network permission the first time an app talks to the LAN. Denied once, it never asks again.\n\n"
                                + "Turn it on at System Settings → Privacy & Security → Local Network → Tulipix.\n\n"
                                + "Then check System Settings → Network → Firewall. If it is on, either allow incoming connections for Tulipix or make sure Block all incoming connections is off.";
                        }

                        HelpBlock {
                            title: "Linux";
                            tint: #22c55e;
                            icon: Icons.wrench;
                            body: "A default-deny firewall drops the phone's packets before they reach the app, and this end cannot tell — the bind succeeded either way.\n\n"
                                + "ufw:       sudo ufw allow in on <interface> to any port " + root.port + " proto tcp\n"
                                + "firewalld: sudo firewall-cmd --add-port=" + root.port + "/tcp\n\n"
                                + "Scope the rule to the one link rather than opening the port everywhere — otherwise it follows the laptop onto the next network it joins.";
                        }

                        HelpBlock {
                            title: "Android";
                            tint: #84cc16;
                            icon: Icons.download;
                            body: "Any browser works. Chrome, Firefox and Samsung Internet are all fine.\n\n"
                                + "Using this phone as the hotspot: the laptop is a client on the phone's network, so pick the hotspot address from THIS NETWORK on the Connection card — that is the one the phone can reach.\n\n"
                                + "Downloads land in the browser's own folder, usually Downloads. Some Android builds warn about files from a “not secure” page; that is the plain-HTTP notice, not a problem with the file.";
                        }

                        HelpBlock {
                            title: "iPhone and iPad";
                            tint: #f472b6;
                            icon: Icons.upload;
                            body: "Safari works, and the Camera app scans the QR straight into it.\n\n"
                                + "Turn off Private Wi-Fi Address for this network if the connection is refused after it worked once — a rotating address invalidates the paired device.\n\n"
                                + "Uploading photos: pick Photo Library in the file picker. iOS converts HEIC to JPEG on the way out unless Settings → Photos → Transfer to Mac or PC is set to Keep Originals.";
                        }

                        HelpBlock {
                            title: "Still nothing";
                            tint: Theme.text-dim;
                            icon: Icons.triangle-alert;
                            body: "Client isolation — an “AP isolation” or “guest network” setting on the router — blocks devices from seeing each other at all, and no firewall change on either end will fix it. A phone hotspot is the quickest way around it.\n\n"
                                + "A VPN on either device routes traffic away from the local network. Turn it off and try again.\n\n"
                                + "Corporate and campus Wi-Fi very often has isolation on by design. Expect it to fail there.";
                        }
                    }
                }
            }
        }
    }

    // ── one paired device ───────────────────────────────────────────────────
    // Opened from its round button in Connection. Everything about that device in
    // one place: what to call it, what it paired with, how long it has left, and
    // the one destructive thing that can be done to it.
    if root.device-open != "": Rectangle {
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.device-open = ""; } }
        Rectangle {
            width: min(400px, parent.width - 48px);
            height: self.preferred-height;
            border-radius: Surface.panel-radius;
            background: Surface.panel(Theme.panel, root.accent);
            border-width: Surface.edge-w(1px);
            border-color: Surface.clay ? transparent : Theme.outline;
            drop-shadow-blur: Surface.cast(40px);
            drop-shadow-color: Surface.cast-ink(#00000055);
            drop-shadow-offset-y: Surface.cast-y(40px);
            TouchArea { }
            VerticalLayout {
                padding: 22px; spacing: 14px;

                HorizontalLayout {
                    spacing: 13px;
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            width: 48px; height: 48px; border-radius: 24px;
                            background: Surface.wash(root.accent, 0.14);
                            AppIcon {
                                source: root.device.kind == "Android" || root.device.kind == "iPhone"
                                        ? Icons.device-mobile
                                      : root.device.kind == "iPad" ? Icons.device-tablet
                                      : root.device.kind == "Mac"  ? Icons.device-laptop
                                      :                              Icons.device-desktop;
                                colorize: root.accent; width: 21px; height: 21px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1; spacing: 3px;
                        Text {
                            text: root.device.name; color: Theme.text;
                            font-size: 16px; font-weight: 700; overflow: elide;
                        }
                        // The full User-Agent reading, which is more than fits
                        // under a 54px circle but is what identifies the thing.
                        Text {
                            text: root.device.label + " · last seen " + root.device.seen;
                            color: Theme.text-dim; font-size: 11.5px; wrap: word-wrap;
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.outline; }

                // Name: typed here, applied on Enter or on Save. Fifteen characters,
                // enforced on the way in rather than complained about afterwards —
                // and again in Rust, which is what actually stores it.
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "NAME"; color: Theme.text-dim;
                            font-size: 10px; letter-spacing: 1.3px; font-weight: 700;
                            horizontal-stretch: 1; vertical-alignment: center;
                        }
                        Text {
                            text: root.device-name.character-count + " / 15";
                            color: Theme.text-dim; font-size: 10px; font-weight: 700;
                            horizontal-stretch: 0; vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 42px; border-radius: Surface.rr(10px, self.width, self.height);
                        background: Surface.body(Theme.panel-2);
                        border-width: 1px;
                        border-color: namefield.has-focus ? root.accent : Theme.outline;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 12px;
                            VerticalLayout {
                                alignment: center;
                                namefield := TextInput {
                                    text: root.device-name;
                                    single-line: true;
                                    color: Theme.text; font-size: 13px; font-weight: 600;
                                    selection-background-color: root.accent.with-alpha(0.3);
                                    vertical-alignment: center;
                                    // The limit is applied as it is typed: the
                                    // sixteenth character never appears, so nobody
                                    // types a name and then loses the end of it.
                                    edited => {
                                        if (self.text.character-count > 15) {
                                            self.text = root.device-name;
                                        } else {
                                            root.device-name = self.text;
                                        }
                                    }
                                    accepted => {
                                        root.rename-device(root.device.token, root.device-name);
                                        root.device-open = "";
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: "Leave it empty to go back to calling it " + root.device.kind + ".";
                        color: Theme.text-dim; font-size: 10.5px; wrap: word-wrap;
                    }
                }

                // What it paired with and what is left of that. The PIN is the one
                // that was on screen when this device paired, not today's — the
                // session PIN is new at every start.
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 5px; horizontal-stretch: 1;
                        Text {
                            text: "PIN USED"; color: Theme.text-dim;
                            font-size: 10px; letter-spacing: 1.3px; font-weight: 700;
                        }
                        ValueField {
                            value: root.device.pin != "" ? root.device.pin : "—";
                            size: 15px; tone: root.accent; weight: 800;
                        }
                    }
                    VerticalLayout {
                        spacing: 5px; horizontal-stretch: 1;
                        Text {
                            text: "ADDRESS"; color: Theme.text-dim;
                            font-size: 10px; letter-spacing: 1.3px; font-weight: 700;
                        }
                        ValueField {
                            value: root.device.ip != "" ? root.device.ip : "—";
                            size: 13px;
                        }
                    }
                }

                VerticalLayout {
                    spacing: 5px;
                    Text {
                        text: "TIME LEFT"; color: Theme.text-dim;
                        font-size: 10px; letter-spacing: 1.3px; font-weight: 700;
                    }
                    ValueField { value: root.device.remaining; size: 13px; }
                }

                Rectangle { height: 1px; background: Theme.outline; }

                HorizontalLayout {
                    spacing: 10px;
                    // One size for all three: each button's natural width comes
                    // from its own label, so left alone they step 124 / 84 / 118
                    // and the row reads as three unrelated controls. Fixed here
                    // rather than in the components — this is the only place the
                    // three of them stand side by side.
                    // Forget is the destructive one, so it keeps its distance from
                    // Save rather than sitting beside it.
                    DangerBtn {
                        width: root.btn-w; height: root.btn-h;
                        label: "Forget";
                        icon: Icons.trash;
                        clicked => {
                            root.forget(root.device.token);
                            root.device-open = "";
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton {
                        width: root.btn-w; height: root.btn-h;
                        label: "Close"; tint: root.help-tint;
                        clicked => { root.device-open = ""; }
                    }
                    ActionButton {
                        width: root.btn-w; height: root.btn-h;
                        label: "Save name"; tint: root.pair-tint;
                        clicked => {
                            root.rename-device(root.device.token, root.device-name);
                            root.device-open = "";
                        }
                    }
                }
            }
        }
    }
}
