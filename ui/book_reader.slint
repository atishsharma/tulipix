// Book Reader (np.p8.books.reader) — target: docs/books-redesign/newreader.png.
// ORIGINAL design (the dead creader.png single cream column is NOT reused).
// Full-screen overlay pushed above the section content when a book is opened.
//
// Skeleton: white top bar (back + title/author + icon buttons) · content row
// (floating chevrons + two-page paper spread | optional Contents panel) ·
// white bottom bar (prev-chapter pill + scrub slider + page pill + next-chapter
// pill). Paper surface + body text follow the reading theme (light/sepia/dark);
// chrome always stays app-sans white. All data flows in via `in` properties;
// user actions leave through callbacks the sec-books crate wires to the engine.
import { Theme } from "tokens.slint";
import { AppIcon, Icons } from "icons.slint";
import { BookTheme } from "page_books.slint";
import { ScrollView, LineEdit, ComboBox } from "std-widgets.slint";

// One Contents-panel row: front-matter or chapter. `chapter` is the spine index
// to jump to (-1 = non-navigable heading). `active` highlights current position.
export struct TocRow {
    label: string,
    page: int,
    depth: int,
    chapter: int,
    active: bool,
}

// One bookmark, listed under the annotate icon.
export struct ThumbRow {
    page: int,        // 1-based
    image: image,
}

export struct BookmarkRow {
    id: int,
    page: int,
    note: string,
}

// One in-book search hit: 1-based screen page + a snippet around the match.
export struct SearchRow {
    page: int,
    snippet: string,
}

// One search-highlight box on a PDF page, normalised 0‥1 to the page size.
// `right` = the box belongs to the spread's right page.
export struct HlRect {
    x: float,
    y: float,
    w: float,
    h: float,
    right: bool,
}

// One page-anchored note in the annotate panel. `id` is the DB row id (used to
// edit/delete/jump); `page` is the 1-based screen page it was made on.
export struct AnnotRow {
    id: int,
    page: int,
    snippet: string,
    note: string,
}

// ── small parts ─────────────────────────────────────────────────────────────

// 44px rounded-square chrome icon button; `active` = violet-tint + violet icon.
// Hover-tooltip state — any reader control publishes its hint here; the
// BookReader root renders one pill at (x, y). File-local singleton.
global RTip {
    in-out property <string> text: "";
    in-out property <length> x: 0;
    in-out property <length> y: 0;
}

component ChromeButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <string> caption;
    // Per-button color combo (library pill palette) + hover hint.
    in property <color> accent: BookTheme.accent;
    in property <string> tip: "";
    callback clicked;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: root.accent.with-alpha(root.active ? 0.26 : (ta.has-hover ? 0.18 : 0.10));
    border-width: 1px;
    border-color: root.accent.with-alpha(root.active ? 0.8 : 0.4);
    animate background { duration: 120ms; }
    if root.caption == "": AppIcon {
        source: root.icon;
        tint: root.accent;
        width: 20px;
        height: 20px;
    }
    if root.caption != "": Text {
        text: root.caption;
        color: root.accent;
        font-size: 15px;
        font-weight: 800;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tip != "") {
                RTip.text = root.tip;
                RTip.x = self.absolute-position.x + root.width / 2;
                RTip.y = self.absolute-position.y + root.height + 8px;
            } else if (RTip.text == root.tip) {
                RTip.text = "";
            }
        }
    }
}

// One segment in a settings segmented-control (Line spacing / Margins / Typeface).
component SegItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <length> text-size: 12px;
    in property <string> preview-font: "";
    callback clicked;
    height: 34px;
    border-radius: 9px;
    background: active ? BookTheme.accent : BookTheme.pill-bg;
    border-width: 1px;
    border-color: active ? BookTheme.accent : BookTheme.hairline;
    HorizontalLayout {
        alignment: center;
        Text {
            text: root.label;
            color: root.active ? #ffffff : BookTheme.ink;
            font-size: root.text-size;
            font-weight: 600;
            font-family: root.preview-font;
            vertical-alignment: center;
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Floating circular chevron at a spread edge (48px) — theme-aware card fill
// + accent outline/icon so it stays visible on every reading theme.
component EdgeNav inherits Rectangle {
    in property <image> icon;
    in property <string> tip: "";
    callback clicked;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: ta.has-hover ? BookTheme.tint-violet : BookTheme.card;
    border-width: 1.5px;
    border-color: BookTheme.accent.with-alpha(0.55);
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000022;
    drop-shadow-offset-y: 2px;
    AppIcon {
        source: root.icon;
        tint: BookTheme.accent;
        width: 22px;
        height: 22px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tip != "") {
                RTip.text = root.tip;
                RTip.x = self.absolute-position.x + root.width / 2;
                RTip.y = self.absolute-position.y + root.height + 8px;
            } else if (RTip.text == root.tip) {
                RTip.text = "";
            }
        }
    }
}

// One paper page: serif body column + centered folio footer `‹ n ›`.
component PaperPage inherits Rectangle {
    in property <string> body;
    in property <string> heading;       // chapter title, shown on its first page
    in property <int> folio;
    in property <color> ink;
    in property <length> font-size: 17px;
    in property <string> font-family: "serif";
    in property <bool> bold: false;
    in property <int> talign: 1;        // body alignment: 0 left · 1 center · 2 right
    // Horizontal padding (both sides combined), margin-driven so the rendered
    // column matches what the engine paginates to.
    in property <length> pad-x: 96px;
    callback prev;
    callback next;
    // No own paper/shadow — the page sits on the open-book mockup
    // (reader2page-*.png) drawn by the spread underneath.
    background: transparent;
    // Folio ‹ n › — pinned to the very top edge, out of the text flow.
    HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        y: 2px;
        height: 20px;
        spacing: 12px;
        fa := TouchArea {
            width: 16px;
            mouse-cursor: pointer;
            clicked => { root.prev(); }
            AppIcon { source: Icons.chevron-left; tint: root.ink.with-alpha(0.5); width: 12px; height: 12px; }
        }
        Text {
            text: root.folio;
            color: root.ink.with-alpha(0.6);
            font-size: 12px;
            vertical-alignment: center;
        }
        na := TouchArea {
            width: 16px;
            mouse-cursor: pointer;
            clicked => { root.next(); }
            AppIcon { source: Icons.chevron-right; tint: root.ink.with-alpha(0.5); width: 12px; height: 12px; }
        }
    }
    VerticalLayout {
        padding-left: root.pad-x / 2;
        padding-right: root.pad-x / 2;
        padding-top: 40px;
        padding-bottom: 20px;
        spacing: 0px;
        // Reflow text page: chapter opener (centered serif title + divider) + body.
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            if root.heading != "": VerticalLayout {
                padding-top: 12px;
                padding-bottom: 26px;
                spacing: 16px;
                Text {
                    text: root.heading;
                    color: root.ink;
                    font-size: root.font-size * 1.85;
                    font-family: root.font-family;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                // Ornamental divider: two thin rules + a center dot (manual layout
                // so the 1px rules aren't stretched by a surrounding layout).
                Rectangle {
                    height: 8px;
                    Rectangle { x: parent.width / 2 - 64px; y: (parent.height - 1px) / 2; width: 54px; height: 1px; background: root.ink.with-alpha(0.28); }
                    Rectangle { x: (parent.width - 5px) / 2; y: (parent.height - 5px) / 2; width: 5px; height: 5px; border-radius: 2.5px; background: root.ink.with-alpha(0.42); }
                    Rectangle { x: parent.width / 2 + 10px; y: (parent.height - 1px) / 2; width: 54px; height: 1px; background: root.ink.with-alpha(0.28); }
                }
            }
            Text {
                text: root.body;
                color: root.ink;
                font-size: root.font-size;
                font-family: root.font-family;
                font-weight: root.bold ? 600 : 400;
                wrap: word-wrap;
                vertical-alignment: top;
                horizontal-alignment: root.talign == 0 ? TextHorizontalAlignment.left
                    : root.talign == 2 ? TextHorizontalAlignment.right
                    : TextHorizontalAlignment.center;
                vertical-stretch: 1;
            }
        }
    }
}

// ── scrub slider ──────────────────────────────────────────────────────────
// Custom slider so the handle matches the design (clean white/violet knob)
// instead of the renderer's default. Click or drag maps x → page.
component BookSlider inherits Rectangle {
    in property <int> minimum: 1;
    in property <int> maximum: 1;
    in property <int> value: 1;
    // Wheel step — 2 in spread views so the step survives spread re-alignment
    // (a +1 step snaps back to the same aligned spread and the bar stalls).
    in property <int> step: 1;
    callback changed(int);
    height: 24px;
    property <float> frac: root.maximum > root.minimum
        ? (root.value - root.minimum) / (root.maximum - root.minimum) : 0;
    // Track + violet fill (3× thick).
    Rectangle {
        y: (parent.height - 12px) / 2;
        height: 12px;
        border-radius: 6px;
        background: BookTheme.track;
        Rectangle {
            x: 0;
            width: parent.width * root.frac;
            height: 12px;
            border-radius: 6px;
            background: BookTheme.accent;
        }
    }
    // Knob.
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        x: root.frac * (parent.width - self.width);
        y: (parent.height - self.height) / 2;
        background: #ffffff;
        border-width: 2px;
        border-color: BookTheme.accent;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000026;
        drop-shadow-offset-y: 1px;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if (self.pressed) {
                root.changed(root.minimum + Math.round(Math.clamp(self.mouse-x / root.width, 0, 1) * (root.maximum - root.minimum)));
            }
        }
        clicked => {
            root.changed(root.minimum + Math.round(Math.clamp(self.mouse-x / root.width, 0, 1) * (root.maximum - root.minimum)));
        }
        // Mouse wheel over the bar steps a page (spread) at a time.
        scroll-event(e) => {
            if (e.delta-y < 0 || e.delta-x < 0) {
                root.changed(Math.min(root.value + root.step, root.maximum));
                return accept;
            }
            if (e.delta-y > 0 || e.delta-x > 0) {
                root.changed(Math.max(root.value - root.step, root.minimum));
                return accept;
            }
            reject
        }
    }
}

// Vertical zoom slider (google-maps style) — pinned to the stage's right-bottom
// edge in single-page image view. + on top, − at the bottom.
component VFloatSlider inherits Rectangle {
    in property <float> minimum: 1.0;
    in property <float> maximum: 3.0;
    in property <float> value: 1.0;
    callback changed(float);
    width: 28px;
    property <float> frac: root.maximum > root.minimum
        ? (root.value - root.minimum) / (root.maximum - root.minimum) : 0;
    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 24px; border-radius: 8px;
            background: BookTheme.accent.with-alpha(plus-ta.has-hover ? 0.28 : 0.12);
            border-width: 1px; border-color: BookTheme.accent.with-alpha(0.45);
            Text { text: "+"; color: BookTheme.accent; font-size: 15px; font-weight: 800; }
            plus-ta := TouchArea { mouse-cursor: pointer;
                clicked => { root.changed(Math.min(root.value + 0.25, root.maximum)); } }
        }
        track := Rectangle {
            vertical-stretch: 1;
            Rectangle {
                x: (parent.width - 6px) / 2; width: 6px; height: 100%;
                border-radius: 3px; background: BookTheme.track;
                Rectangle {
                    x: 0; width: 6px;
                    y: parent.height * (1 - root.frac);
                    height: parent.height * root.frac;
                    border-radius: 3px; background: BookTheme.accent;
                }
            }
            Rectangle {
                width: 16px; height: 16px; border-radius: 8px;
                x: (parent.width - self.width) / 2;
                y: (1 - root.frac) * (parent.height - self.height);
                background: #ffffff; border-width: 2px; border-color: BookTheme.accent;
                drop-shadow-blur: 5px; drop-shadow-color: #00000026;
            }
            vta := TouchArea {
                mouse-cursor: pointer;
                moved => { if (self.pressed) {
                    root.changed(root.minimum + (1 - Math.clamp(self.mouse-y / track.height, 0, 1)) * (root.maximum - root.minimum)); } }
                clicked => {
                    root.changed(root.minimum + (1 - Math.clamp(self.mouse-y / track.height, 0, 1)) * (root.maximum - root.minimum)); }
            }
        }
        Rectangle {
            height: 24px; border-radius: 8px;
            background: BookTheme.accent.with-alpha(minus-ta.has-hover ? 0.28 : 0.12);
            border-width: 1px; border-color: BookTheme.accent.with-alpha(0.45);
            Text { text: "−"; color: BookTheme.accent; font-size: 15px; font-weight: 800; }
            minus-ta := TouchArea { mouse-cursor: pointer;
                clicked => { root.changed(Math.max(root.value - 0.25, root.minimum)); } }
        }
    }
}

// Flat PDF/CBZ stage (Files/Firefox-style): one page or a side-by-side spread
// on the canvas — aspect-correct (1:1 page ratio, zoom 1.0 = 100% fit), no
// book mockup. Wheel zooms toward the cursor, drag pans, zoom resets per page.
// `edge-hover` feeds the fullscreen chrome reveal (pointer near top/bottom).
component PdfStage inherits Rectangle {
    in property <image> left-image;
    in property <image> right-image;
    in property <bool> dual: false;
    /// Long-strip (webtoon) page: fits width and scrolls vertically instead of
    /// being contain-fitted into an unreadable sliver.
    in property <bool> webtoon: false;
    in property <[HlRect]> hl: [];
    in-out property <float> zoom: 1.0;
    /// Changes when a genuinely different page is shown (not when the same
    /// page is re-rendered sharper). Drives the zoom/pan reset.
    in property <int> page-token;
    /// Requests a re-rasterisation of the current page at `tier` × base DPI.
    callback want-dpi(int);
    callback edge-hover(bool, bool);
    // Fired on any press — the reader refocuses its key scope so arrow keys
    // keep working after the search field (or any LineEdit) had focus.
    callback tapped();
    // Tap zones: a clean click (no pan) on the left/right third turns pages.
    callback tap-prev();
    callback tap-next();
    clip: true;
    property <length> pan-x: 0;
    property <length> pan-y: 0;
    property <float> l-ar: root.left-image.height > 0 ? root.left-image.width * 1.0 / root.left-image.height : 0.708;
    property <float> r-ar: !root.dual ? 0 : root.right-image.height > 0 ? root.right-image.width * 1.0 / root.right-image.height : root.l-ar;
    property <length> gap: root.dual ? 6px : 0px;
    // Webtoon (long-strip) pages are many screens tall. Contain-fitting one
    // renders it as an unreadable sliver down the middle, so those fit the
    // WIDTH instead and scroll vertically.
    property <length> fit-h: root.webtoon
        ? (root.width - 32px) / Math.max(root.l-ar, 0.01)
        : min(root.height - 16px, (root.width - 32px - root.gap) / (root.l-ar + root.r-ar));
    property <length> base-w: root.fit-h * (root.l-ar + root.r-ar) + root.gap;
    property <length> max-px: Math.max(0px, (root.base-w * root.zoom - root.width) / 2);
    property <length> max-py: Math.max(0px, (root.fit-h * root.zoom - root.height) / 2);
    // New page → reset zoom/pan (each page zooms independently).
    //
    // Keyed on the page token, NOT on `left-image`: the same page gets its
    // bitmap swapped for a sharper one while zoomed in, and resetting there
    // threw the reader back to a fitted view mid-gesture. All the geometry
    // below is derived from aspect ratio and `zoom`, never from the source
    // bitmap's pixel size, so a higher-DPI render of the same page lands in
    // exactly the same place.
    // A long strip starts at its top, not centred halfway down it. Positive
    // pan-y moves the page down the screen, so max-py is the top edge.
    changed page-token => {
        root.zoom = 1.0;
        root.pan-x = 0;
        root.pan-y = root.webtoon ? root.max-py : 0px;
    }
    // Resolution tier wanted for the current zoom. The engine re-rasterises
    // the page when this changes, so deep zoom shows real detail instead of
    // magnified 150-DPI pixels.
    // ponytail: whole-page re-render, capped at 2×; tiled rendering of just
    // the visible region is the upgrade if someone wants 4×+.
    property <int> dpi-tier: root.zoom >= 1.6 ? 2 : 1;
    changed dpi-tier => { root.want-dpi(root.dpi-tier); }
    changed zoom => {
        if (root.zoom <= 1.0) { root.pan-x = 0; root.pan-y = 0; }
        root.pan-x = Math.clamp(root.pan-x, -root.max-px, root.max-px);
        root.pan-y = Math.clamp(root.pan-y, -root.max-py, root.max-py);
    }
    // Keep the page point under the mouse fixed while zooming.
    function zoom-at(nz: float, mx: length, my: length) {
        if (nz != root.zoom) {
            root.pan-x = (mx - root.width / 2) - ((mx - root.width / 2) - root.pan-x) * nz / root.zoom;
            root.pan-y = (my - root.height / 2) - ((my - root.height / 2) - root.pan-y) * nz / root.zoom;
            root.zoom = nz;
        }
    }
    // Page backdrop + soft shadow under the whole spread (Files look).
    Rectangle {
        x: (root.width - root.base-w * root.zoom) / 2 + root.pan-x;
        y: (root.height - root.fit-h * root.zoom) / 2 + root.pan-y;
        width: root.base-w * root.zoom;
        height: root.fit-h * root.zoom;
        background: #ffffff;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 6px;
    }
    lpage := Image {
        source: root.left-image;
        image-fit: fill;   // aspect already exact via l-ar
        width: root.fit-h * root.l-ar * root.zoom;
        height: root.fit-h * root.zoom;
        x: (root.width - root.base-w * root.zoom) / 2 + root.pan-x;
        y: (root.height - self.height) / 2 + root.pan-y;
    }
    if root.dual: Image {
        source: root.right-image;
        image-fit: fill;
        width: root.fit-h * root.r-ar * root.zoom;
        height: lpage.height;
        x: lpage.x + lpage.width + root.gap * root.zoom;
        y: lpage.y;
    }
    // Search-hit word boxes (amber wash over the raster).
    for h in root.hl: Rectangle {
        property <length> page-w: root.fit-h * (h.right ? root.r-ar : root.l-ar) * root.zoom;
        property <length> page-x: h.right
            ? lpage.x + lpage.width + root.gap * root.zoom : lpage.x;
        x: self.page-x + h.x * self.page-w;
        y: lpage.y + h.y * root.fit-h * root.zoom;
        width: h.w * self.page-w;
        height: h.h * root.fit-h * root.zoom;
        border-radius: 2px;
        background: #f5a62359;
        border-width: 1px;
        border-color: #f5a623aa;
    }
    ta := TouchArea {
        mouse-cursor: (root.zoom > 1.0 || root.webtoon) ? MouseCursor.grab : MouseCursor.default;
        property <length> down-x: 0;
        property <length> down-y: 0;
        scroll-event(e) => {
            // Long-strip comics scroll; everything else zooms. Reaching either
            // end of the strip rolls into the neighbouring page, which is what
            // makes a chaptered webtoon read as one continuous column.
            if (root.webtoon) {
                if (e.delta-y < 0 && root.pan-y <= -root.max-py + 1px) {
                    root.tap-next();
                } else if (e.delta-y > 0 && root.pan-y >= root.max-py - 1px) {
                    root.tap-prev();
                } else {
                    root.pan-y = Math.clamp(root.pan-y + e.delta-y * 2, -root.max-py, root.max-py);
                }
                return accept;
            }
            root.zoom-at(Math.clamp(root.zoom + (e.delta-y > 0 ? 0.25 : -0.25), 0.5, 4.0), self.mouse-x, self.mouse-y);
            return accept;
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.down-x = root.pan-x;
                self.down-y = root.pan-y;
                root.tapped();
            }
            if (e.kind == PointerEventKind.move) {
                root.edge-hover(self.mouse-y < 90px, self.mouse-y > root.height - 90px);
            }
        }
        moved => {
            // A long strip overflows the screen at zoom 1, so it must drag too.
            if (root.zoom > 1.0 || root.webtoon) {
                root.pan-x = Math.clamp(self.down-x + (self.mouse-x - self.pressed-x), -root.max-px, root.max-px);
                root.pan-y = Math.clamp(self.down-y + (self.mouse-y - self.pressed-y), -root.max-py, root.max-py);
            }
        }
        clicked => {
            // Only a clean un-zoomed click (not a pan release) turns pages.
            if (root.zoom <= 1.0
                && Math.abs(self.mouse-x - self.pressed-x) < 8px
                && Math.abs(self.mouse-y - self.pressed-y) < 8px) {
                if (self.mouse-x < root.width / 3) { root.tap-prev(); }
                else if (self.mouse-x > root.width * 2 / 3) { root.tap-next(); }
            }
        }
    }
}

// Continuous single-column scroll of the whole book (reflow text mode).
component ContinuousText inherits Rectangle {
    in property <string> text;
    in property <color> paper;   // page color (reading theme)
    in property <color> ink;
    in property <length> font-size;
    in property <string> font-family;
    in property <bool> bold: false;
    in property <int> talign: 1;   // 0 left · 1 center · 2 right
    // Chapter title, shown bold above the chapter body.
    in property <string> heading: "";
    // "Next chapter" button at the column's end (auto-advance affordance).
    in property <bool> has-next: false;
    callback next-chapter();
    // Within-chapter scroll target (0‥1) — set by the engine on scrub so the
    // progress bar navigates the chapter column.
    in property <float> scroll-frac: 0;
    changed scroll-frac => {
        sv.viewport-y = -Math.max(0px,
            (sv.viewport-height - sv.visible-height) * Math.clamp(self.scroll-frac, 0, 1));
    }
    // New chapter text → back to the top.
    changed text => { sv.viewport-y = 0; }
    // Keyboard scroll: BookReader bumps this ±1; we scroll one step + reset.
    in-out property <int> nudge: 0;
    changed nudge => {
        if (self.nudge != 0) {
            sv.viewport-y = Math.clamp(sv.viewport-y - self.nudge * 160px,
                Math.min(0px, sv.visible-height - sv.viewport-height), 0px);
            self.nudge = 0;
        }
    }
    // Sides = app-theme canvas; the centered 60% column is the page (reading-
    // theme paper color) with hairline rules on its inside edges.
    background: BookTheme.canvas;
    Rectangle {
        x: root.width * 0.20 - 24px; y: 0;
        width: root.width * 0.60 + 48px; height: 100%;
        background: root.paper;
    }
    sv := ScrollView {
        VerticalLayout {
            padding-top: 44px;
            padding-bottom: 44px;
            // Paper column is the middle 60%; keep the text off its edges with
            // ~10% internal padding on each side (0.60 × 0.10 = 0.06).
            padding-left: root.width * 0.26;
            padding-right: root.width * 0.26;
            spacing: 20px;
            if root.heading != "": Text {
                text: root.heading;
                color: root.ink;
                font-size: root.font-size * 1.6;
                font-family: root.font-family;
                font-weight: 800;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: root.text;
                color: root.ink;
                font-size: root.font-size;
                font-family: root.font-family;
                font-weight: root.bold ? 600 : 400;
                wrap: word-wrap;
                horizontal-alignment: root.talign == 0 ? TextHorizontalAlignment.left
                    : root.talign == 2 ? TextHorizontalAlignment.right
                    : TextHorizontalAlignment.center;
            }
            // Chapter end → continue reading without reaching for the pills.
            if root.has-next: HorizontalLayout {
                alignment: center;
                padding-top: 10px;
                Rectangle {
                    width: 190px;
                    height: 42px;
                    border-radius: 21px;
                    background: ncta.has-hover ? BookTheme.accent.with-alpha(0.9) : BookTheme.accent;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "Next chapter"; color: #ffffff; font-size: 13px;
                            font-weight: 700; vertical-alignment: center; }
                        VerticalLayout { alignment: center;
                            AppIcon { source: Icons.chevron-right; tint: #ffffff; width: 14px; height: 14px; } }
                    }
                    ncta := TouchArea { mouse-cursor: pointer; clicked => { root.next-chapter(); } }
                }
            }
        }
    }
    // Inner page-edge rules — the spread-gutter look on a single page.
    Rectangle { x: root.width * 0.20 - 24px; y: 0; width: 1px; height: 100%;
        background: BookTheme.hairline; }
    Rectangle { x: root.width * 0.80 + 23px; y: 0; width: 1px; height: 100%;
        background: BookTheme.hairline; }
}

// Read-aloud view: chapter sentences as a scroll list, active one highlighted.
component ReadAlong inherits Rectangle {
    in property <[string]> sentences;
    in property <int> active;
    in property <color> paper;
    in property <color> ink;
    in property <length> font-size;
    in property <string> font-family;
    callback jump(int);
    background: root.paper;
    property <length> row-h: root.font-size * 2.6;
    sv := ScrollView {
        VerticalLayout {
            padding: 44px;
            spacing: 4px;
            for s[i] in root.sentences: Rectangle {
                border-radius: 8px;
                background: i == root.active ? BookTheme.accent.with-alpha(0.15) : (rowta.has-hover ? BookTheme.pill-bg.with-alpha(0.5) : transparent);
                HorizontalLayout {
                    padding: 7px;
                    Text {
                        text: s;
                        color: i == root.active ? BookTheme.accent : root.ink;
                        font-size: root.font-size;
                        font-family: root.font-family;
                        font-weight: i == root.active ? 600 : 400;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                rowta := TouchArea { mouse-cursor: pointer; clicked => { root.jump(i); } }
            }
        }
    }
    // Rough auto-scroll to keep the active sentence in the upper third.
    changed active => { sv.viewport-y = -Math.max(0px, root.active * root.row-h - root.height / 3); }
}

// ── contents panel ──────────────────────────────────────────────────────────

component ContentsPanel inherits Rectangle {
    in property <[TocRow]> toc;
    in-out property <string> filter;
    callback filter-changed(string);   // engine filters the row model
    callback jump(int);
    callback close();
    width: 310px;
    background: BookTheme.card;
    border-width: 1px;
    border-color: BookTheme.hairline;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        // Header
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "Contents";
                color: BookTheme.ink;
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
            }
            ChromeButton {
                icon: Icons.x;
                width: 32px;
                height: 32px;
                clicked => { root.close(); }
            }
        }
        // Live filter field
        search := LineEdit {
            placeholder-text: "Search contents";
            text <=> root.filter;
            edited(t) => { root.filter-changed(t); }
        }
        // Tree
        ScrollView {
            VerticalLayout {
                spacing: 2px;
                for row[i] in root.toc: rowrect := Rectangle {
                    height: 34px;
                    border-radius: 8px;
                    background: row.active ? BookTheme.tint-violet : (rowta.has-hover ? BookTheme.pill-bg : transparent);
                    HorizontalLayout {
                        padding-left: 8px + (row.depth * 16px);
                        padding-right: 10px;
                        spacing: 6px;
                        if row.chapter >= 0: VerticalLayout {
                            alignment: center;
                            AppIcon {
                                source: Icons.chevron-right;
                                tint: BookTheme.ink-dim;
                                width: 12px;
                                height: 12px;
                            }
                        }
                        Text {
                            text: row.label;
                            color: row.active ? BookTheme.accent : BookTheme.ink;
                            font-size: 13px;
                            font-weight: row.active ? 700 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: row.page > 0 ? row.page : "";
                            color: BookTheme.ink-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    rowta := TouchArea {
                        mouse-cursor: row.chapter >= 0 ? pointer : default;
                        clicked => { if (row.chapter >= 0) { root.jump(row.chapter); } }
                    }
                }
            }
        }
    }
}

// ── search panel ──────────────────────────────────────────────────────────

component SearchPanel inherits Rectangle {
    in property <[SearchRow]> results;
    in-out property <string> query;
    callback run(string);
    callback jump(int);
    callback close();
    width: 310px;
    background: BookTheme.card;
    border-width: 1px;
    border-color: BookTheme.hairline;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "Search";
                color: BookTheme.ink;
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
            }
            ChromeButton {
                icon: Icons.x;
                width: 32px;
                height: 32px;
                clicked => { root.close(); }
            }
        }
        field := LineEdit {
            placeholder-text: "Find in book";
            text <=> root.query;
            edited(t) => { root.run(t); }
        }
        Text {
            text: root.query == "" ? "" : (root.results.length + (root.results.length == 1 ? " result" : " results"));
            color: BookTheme.ink-dim;
            font-size: 12px;
        }
        ScrollView {
            VerticalLayout {
                spacing: 2px;
                for row in root.results: Rectangle {
                    height: 56px;
                    border-radius: 8px;
                    background: hitta.has-hover ? BookTheme.pill-bg : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: "p" + row.page;
                            color: BookTheme.accent;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                            width: 34px;
                        }
                        Text {
                            text: row.snippet;
                            color: BookTheme.ink;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    hitta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.jump(row.page); }
                    }
                }
            }
        }
    }
}

// ── page thumbnails panel ─────────────────────────────────────────────────
// The navigation primitive for magazines and comics: pages there have no
// chapter structure, so a contents list and a scrubber give you nothing to
// aim at. Thumbs are generated in the background and stream in, so a long
// book fills progressively instead of blocking on the whole set.

component ThumbsPanel inherits Rectangle {
    in property <[ThumbRow]> thumbs;
    in property <int> total;          // page count, for the loading hint
    in property <int> current-page;   // 1-based; highlights its tile
    callback jump(int);               // 1-based page
    callback close();
    width: 310px;
    background: BookTheme.card;
    border-width: 1px;
    border-color: BookTheme.hairline;
    // Tile geometry — the 2-column grid below is positioned by hand, so these
    // are the single source of truth for both the tiles and the viewport.
    property <length> tile-w: 138px;
    property <length> tile-h: 196px;
    property <length> gap: 10px;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "Pages";
                color: BookTheme.ink;
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
            }
            ChromeButton {
                icon: Icons.x;
                width: 32px;
                height: 32px;
                clicked => { root.close(); }
            }
        }
        if root.thumbs.length < root.total: Text {
            text: "Rendering pages… " + root.thumbs.length + " / " + root.total;
            color: BookTheme.ink-dim;
            font-size: 12px;
        }
        ScrollView {
            viewport-height: Math.ceil(root.thumbs.length / 2) * (root.tile-h + root.gap);
            for t[i] in root.thumbs: Rectangle {
                x: Math.mod(i, 2) * (root.tile-w + root.gap);
                y: Math.floor(i / 2) * (root.tile-h + root.gap);
                width: root.tile-w;
                height: root.tile-h;
                border-radius: 8px;
                // Current page reads as selected; hover is a softer echo.
                background: t.page == root.current-page
                    ? BookTheme.accent.with-alpha(0.18)
                    : (tta.has-hover ? BookTheme.pill-bg : transparent);
                border-width: t.page == root.current-page ? 2px : 1px;
                border-color: t.page == root.current-page
                    ? BookTheme.accent
                    : BookTheme.hairline;
                animate background { duration: 100ms; }
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    Image {
                        source: t.image;
                        image-fit: contain;
                        vertical-stretch: 1;
                    }
                    Text {
                        text: t.page;
                        color: t.page == root.current-page ? BookTheme.accent : BookTheme.ink-dim;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }
                tta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.jump(t.page); }
                }
            }
        }
    }
}

// ── bookmarks panel ───────────────────────────────────────────────────────

component BookmarksPanel inherits Rectangle {
    in property <[BookmarkRow]> bookmarks;
    in property <bool> bookmarked;   // current page already bookmarked
    callback toggle();               // bookmark / unbookmark the current page
    callback jump(int);              // 1-based screen page
    callback remove(int);            // bookmark row id
    callback close();
    width: 310px;
    background: BookTheme.card;
    border-width: 1px;
    border-color: BookTheme.hairline;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "Bookmarks";
                color: BookTheme.ink;
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
            }
            ChromeButton {
                icon: Icons.x;
                width: 32px;
                height: 32px;
                clicked => { root.close(); }
            }
        }
        // Toggle a bookmark on the current page (amber, like the ribbon).
        Rectangle {
            height: 40px;
            border-radius: 10px;
            background: #f5a623.with-alpha(bmta.has-hover ? 0.85 : 1.0);
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                VerticalLayout { alignment: center;
                    AppIcon { source: Icons.bookmark; tint: #ffffff; width: 15px; height: 15px; } }
                Text {
                    text: root.bookmarked ? "Remove bookmark on this page" : "Bookmark this page";
                    color: #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center;
                }
            }
            bmta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle(); } }
        }
        if root.bookmarks.length == 0: Text {
            text: "No bookmarks yet.";
            color: BookTheme.ink-dim;
            font-size: 12px;
        }
        ScrollView {
            VerticalLayout {
                spacing: 2px;
                for row in root.bookmarks: Rectangle {
                    height: 44px;
                    border-radius: 8px;
                    background: rowta.has-hover ? BookTheme.pill-bg : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout { alignment: center;
                                    AppIcon { source: Icons.bookmark; tint: #f5a623; width: 14px; height: 14px; } }
                                Text {
                                    text: "Page " + row.page + (row.note != "" ? " · " + row.note : "");
                                    color: BookTheme.ink;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }
                            rowta := TouchArea { mouse-cursor: pointer; clicked => { root.jump(row.page); } }
                        }
                        ChromeButton {
                            icon: Icons.trash;
                            width: 28px;
                            height: 28px;
                            clicked => { root.remove(row.id); }
                        }
                    }
                }
            }
        }
    }
}

// ── reader ──────────────────────────────────────────────────────────────────

export component BookReader inherits Rectangle {
    // Header
    in property <string> title;
    in property <string> author;
    /// Title of the next volume in this book's series ("" = none, pill hidden).
    in property <string> next-title: "";
    callback open-next();
    // Two-page spread text + folios (right-* empty in single-page mode).
    in property <string> left-text;
    in property <string> right-text;
    in property <string> left-heading;   // chapter title on a chapter's first page
    in property <string> right-heading;
    in property <bool> image-mode: false;   // fixed-page (PDF/CBZ/CBR) book
    in property <image> left-image;
    in property <image> right-image;
    in property <int> left-folio;
    in property <int> right-folio;
    // Bottom bar
    in property <int> page-index;     // 1-based screen page
    in property <int> page-count;
    in property <float> percent;      // 0‥1
    in property <string> chapter-name;
    in property <string> next-chapter-name;
    // Toggles / state
    in property <bool> bookmarked;
    in property <bool> has-note: false;   // current page carries a note (R3)
    in-out property <bool> contents-open: true;
    in-out property <bool> typography-open: false;
    in property <float> font-px: 17;
    in property <string> font-family: "serif";
    in property <bool> bold: false;
    in property <int> line-index: 1;      // 0 compact · 1 normal · 2 relaxed
    in property <int> margin-index: 1;     // 0 narrow · 1 normal · 2 wide
    in property <int> typeface: 0;         // 0 serif · 1 sans · 2 mono
    in property <int> text-align: 1;       // 0 left · 1 center · 2 right
    in property <float> brightness: 1.0;   // 0.4‥1.0 page dim
    in-out property <bool> search-open: false;
    in-out property <string> search-query;
    in property <[SearchRow]> search-results;
    // Hidden for books with no searchable text (comics, magazine PDFs).
    in property <bool> search-enabled: true;
    // Enter in the search field hops to the next hit (cycles).
    property <int> search-idx: -1;
    // Debounced search: scanning every page on every keystroke lagged typing
    // in big books — run 300ms after the last edit instead.
    search-timer := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            search-timer.running = false;
            root.search-run(root.search-query);
        }
    }
    // Bookmarks side panel.
    in-out property <bool> bookmarks-open: false;
    in property <[BookmarkRow]> bookmarks: [];
    // Long-strip comic (webtoon) — detected from page proportions.
    in property <bool> webtoon: false;
    // Margin trimming (fixed-page books).
    in property <bool> trim: false;
    callback set-trim(bool);
    // Deep zoom asked for a sharper rasterisation of the current page.
    callback want-dpi(int);
    // Page thumbnails (fixed-page books).
    in-out property <bool> thumbs-open: false;
    in property <[ThumbRow]> thumbs: [];
    in property <int> thumb-total: 0;
    callback thumb-jump(int);   // 1-based page
    callback thumbs-requested(); // panel opened → engine starts rendering
    // PDF search highlights (word boxes on the current page/spread).
    in property <[HlRect]> search-hl: [];
    // Ebook search flash highlight: pre · match · post snippet parts, plus the
    // spread position of the hit (right page? vertical fraction of the page).
    in property <string> flash-pre: "";
    in property <string> flash-word: "";
    in property <string> flash-post: "";
    in property <float> flash-frac: 0;
    in property <bool> flash-right: false;
    property <bool> flash-on: false;
    changed flash-word => {
        if (root.flash-word != "") { root.flash-on = true; flash-timer.running = true; }
    }
    flash-timer := Timer {
        interval: 4s;
        running: false;
        triggered => { flash-timer.running = false; root.flash-on = false; }
    }
    in-out property <bool> notes-open: false;
    in property <[AnnotRow]> notes;
    in-out property <bool> more-open: false;
    in property <[TocRow]> toc;
    in property <string> theme-mode: "light"; // light | sepia | dark
    in property <bool> loading: false;
    in property <string> error-text: "";
    in-out property <string> contents-filter;
    // Single-page view (header toggle): one page + zoom (image) or continuous
    // scroll (text). `full-text` is the whole book for the text-scroll mode.
    in-out property <bool> force-single: false;
    in-out property <float> zoom: 1.0;
    // Ebook zoom = font scale (engine repaginates); PDF zoom stays visual.
    changed zoom => { if (!root.image-mode) { root.set-font-scale(root.zoom); } }
    // PDF spread mode (Firefox-style): 1 = odd spreads (1·2, 3·4…),
    // 2 = even (cover alone, then 2·3, 4·5…). Single page = force-single.
    in-out property <int> spread-mode: 1;
    // Fullscreen (PDF): chrome bars collapse; hovering the top/bottom edge
    // (reported by PdfStage) slides them back in. Escape exits.
    in-out property <bool> fullscreen: false;
    in-out property <bool> top-reveal: false;
    in-out property <bool> bottom-reveal: false;
    in property <string> full-text: "";
    // Chapter title above the continuous column (bold headline).
    in property <string> full-heading: "";
    // Continuous column: is there a chapter after this one?
    in property <bool> full-has-next: false;
    // Within-chapter scroll target for the continuous column (engine-set).
    in property <float> full-frac: 0;
    // Read-aloud (TTS) — sentence list + highlight + controls.
    in-out property <bool> tts-open: false;
    in property <[string]> tts-sentences: [];
    in property <int> tts-active: 0;
    in property <bool> tts-playing: false;
    in property <int> tts-speed-index: 1;   // 0 .75× · 1 1× · 2 1.25× · 3 1.5×
    in property <[string]> tts-voices: [];
    in property <string> tts-voice: "";
    // Define-a-word popup (R2): centered lookup — definition / translation / wiki.
    in-out property <bool> define-open: false;
    in-out property <string> define-word: "";
    in-out property <string> define-lang: "hi";     // translation target (2-letter)
    in property <bool> define-loading: false;
    in property <string> define-definition: "";
    in property <string> define-pos: "";
    in property <string> define-translation: "";
    in property <string> define-wiki: "";
    in property <string> define-wiki-url: "";

    // Callbacks → sec-books
    callback back();
    callback prev-spread();
    callback next-spread();
    callback toggle-bookmark();
    callback bookmarks-load();     // fired on opening the bookmarks panel
    callback bookmark-jump(int);   // 1-based screen page
    callback bookmark-remove(int); // bookmark row id
    callback set-font-scale(float); // ebook zoom slider → font scale
    callback annotate();           // fired on opening the notes panel → load
    callback annot-add();
    callback annot-jump(int);
    callback annot-set-note(int, string);
    callback annot-remove(int);
    callback annot-export();
    callback search-run(string);
    callback search-jump(int);    // result click → page jump + highlight
    callback font-dec();
    callback font-inc();
    callback set-line-spacing(int);
    callback set-margin(int);
    callback set-typeface(int);
    callback set-align(int);      // body alignment: 0 left · 1 center · 2 right
    callback toggle-bold();
    callback set-theme(string);
    callback set-brightness(float);
    callback brightness-cycle();
    callback more-mark-finished();
    callback more-remove();
    callback jump-chapter(int);
    callback contents-filter-changed(string); // engine re-filters TOC rows
    callback scrub(int);          // slider release → screen page
    callback prev-chapter();
    callback next-chapter();
    callback prev-page();         // single-page step (±1)
    callback next-page();
    callback set-single(bool);    // tell the engine to stop even-aligning spreads
    callback set-spread(int);     // PDF spread alignment: 1 odd · 2 even
    callback report-geom(length, length); // real page px → engine pagination
    // Debounce geometry reports out of the `changed width/height` pass: calling
    // report-geom (→ repaginate) synchronously inside a changed callback makes
    // Slint count the whole repaginate cascade as one long changed chain (and
    // warn). A one-shot Timer fires it after the current change pass settles.
    property <length> pending-geom-w: 0;
    property <length> pending-geom-h: 0;
    geom-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            geom-timer.running = false;
            if (!root.image-mode) { root.report-geom(root.pending-geom-w, root.pending-geom-h); }
        }
    }
    callback tts-start();
    callback tts-stop();
    callback tts-play-pause();
    callback tts-set-speed(int);
    callback tts-set-voice(string);
    callback tts-jump(int);
    callback define-run(string, string);   // (word, target-lang)
    callback open-url(string);

    // Derived paper palette from theme-mode.
    property <color> paper: root.theme-mode == "sepia" ? #f4ecd8
        : root.theme-mode == "dark" ? #1c1c20
        : root.theme-mode == "night" ? #000000 : #fdfcf8;
    property <color> paper-ink: root.theme-mode == "sepia" ? #4a3f2f
        : root.theme-mode == "dark" ? #d8d8dc
        : root.theme-mode == "night" ? #b8b8be : #1b1b22;
    // Open-book mockup behind the two-page spread — one variant per reading
    // theme (user-made Book_*.png, 1511×1041; night uses the OLED book).
    property <image> spread-bg: root.theme-mode == "sepia"
            ? @image-url("../resources/icons/bookhero/Book_Sepia.png")
        : root.theme-mode == "dark"
            ? @image-url("../resources/icons/bookhero/Book_Dark.png")
        : root.theme-mode == "night"
            ? @image-url("../resources/icons/bookhero/Book_OLED.png")
        : @image-url("../resources/icons/bookhero/Book_Light.png");
    // Margin-driven horizontal page padding (both sides), matching the engine's
    // MARGINS table so pagination and rendering agree.
    property <length> page-pad-x: root.margin-index == 0 ? 56px : root.margin-index == 2 ? 150px : 96px;
    // Single page when the user toggles it, or the window is too narrow for two.
    property <bool> single-page: root.force-single || root.width < 1000px;
    // Keyboard scroll bump for the continuous column (±1 per press).
    property <int> cont-nudge: 0;
    // Escape → "close this book?" dialog (Enter confirms).
    property <bool> close-confirm: false;
    // Continuous text scroll = single-page mode on a reflow (non-image) book.
    property <bool> continuous: root.single-page && !root.image-mode;
    // Keep the engine's spread alignment in sync with the view mode.
    changed single-page => { root.set-single(root.single-page); }

    // Page-turn animation: on each spread change dip the paper opacity, and a
    // one-shot Timer eases it back — a soft cross-flip without double-buffering.
    property <float> spread-op: 1.0;
    animate spread-op { duration: 130ms; easing: ease-in-out; }
    changed page-index => { root.spread-op = 0.4; turn-timer.running = true; }
    turn-timer := Timer {
        interval: 130ms;
        running: false;
        triggered => { turn-timer.running = false; root.spread-op = 1.0; }
    }

    background: BookTheme.canvas;
    forward-focus: key-scope;

    key-scope := FocusScope {
        key-pressed(e) => {
            // Close-confirm dialog eats Enter (confirm) and Escape (cancel).
            if (root.close-confirm) {
                if (e.text == Key.Return) { root.close-confirm = false; root.back(); return accept; }
                if (e.text == Key.Escape) { root.close-confirm = false; return accept; }
                return reject;
            }
            // Left/Right in the continuous chapter column switch chapters
            // (the column IS one chapter; Up/Down + PageUp/Down scroll it).
            if (e.text == Key.LeftArrow || e.text == Key.PageUp) {
                if (e.text == Key.LeftArrow && root.continuous) { root.prev-chapter(); }
                else if (root.continuous) { root.cont-nudge = -1; }
                else if (root.single-page) { root.prev-page(); }
                else { root.prev-spread(); }
                return accept;
            }
            if (e.text == Key.RightArrow || e.text == Key.PageDown || e.text == " ") {
                if (e.text == Key.RightArrow && root.continuous) { root.next-chapter(); }
                else if (root.continuous) { root.cont-nudge = 1; }
                else if (root.single-page) { root.next-page(); }
                else { root.next-spread(); }
                return accept;
            }
            // Up/Down: page in fixed-page books, scroll in the ebook column.
            if (e.text == Key.UpArrow) {
                if (root.continuous) { root.cont-nudge = -1; }
                else if (root.single-page) { root.prev-page(); }
                else { root.prev-spread(); }
                return accept;
            }
            if (e.text == Key.DownArrow) {
                if (root.continuous) { root.cont-nudge = 1; }
                else if (root.single-page) { root.next-page(); }
                else { root.next-spread(); }
                return accept;
            }
            if (e.text == Key.Escape) {
                if (root.define-open) { root.define-open = false; }
                else if (root.typography-open) { root.typography-open = false; }
                else if (root.fullscreen) { root.fullscreen = false; }
                else { root.close-confirm = true; }
                return accept;
            }
            if (e.text == "b") { root.toggle-bookmark(); return accept; }
            if (e.text == "t") { root.contents-open = !root.contents-open; return accept; }
            return reject;
        }
    }

    VerticalLayout {
        spacing: 0px;

        // ── Top bar ── collapses in fullscreen; edge-hover slides it back in.
        Rectangle {
            height: root.fullscreen && !root.top-reveal ? 0px : 72px;
            clip: true;
            animate height { duration: 150ms; easing: ease-in-out; }
            background: BookTheme.card;
            border-width: 1px;
            border-color: BookTheme.hairline;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                alignment: space-between;
                // Left: back + title/author pill
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        y: (parent.height - 44px) / 2;
                        border-radius: 22px;
                        background: BookTheme.accent.with-alpha(backta.has-hover ? 0.2 : 0.10);
                        border-width: 1px;
                        border-color: BookTheme.accent.with-alpha(0.4);
                        AppIcon { source: Icons.chevron-left; tint: BookTheme.accent; width: 20px; height: 20px; }
                        backta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.back(); }
                            changed has-hover => {
                                if (self.has-hover) {
                                    RTip.text = "Back to library";
                                    RTip.x = self.absolute-position.x + 22px;
                                    RTip.y = self.absolute-position.y + 52px;
                                } else if (RTip.text == "Back to library") { RTip.text = ""; }
                            }
                        }
                    }
                    // Title + author inside a theme-tinted pill.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 48px;
                            border-radius: 14px;
                            background: BookTheme.accent.with-alpha(0.12);
                            border-width: 1px;
                            border-color: BookTheme.accent.with-alpha(0.4);
                            VerticalLayout {
                                padding-left: 14px; padding-right: 14px;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: root.title;
                                    color: BookTheme.accent;
                                    font-size: 15px;
                                    font-weight: 800;
                                    overflow: elide;
                                }
                                // Author in link-blue with a hand-drawn underline
                                // (Slint Text has no underline property).
                                HorizontalLayout {
                                    alignment: start;
                                    VerticalLayout {
                                        spacing: 1px;
                                        Text {
                                            text: root.author;
                                            color: #3a86ff;
                                            font-size: 11px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: #3a86ff.with-alpha(0.7);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Next volume in the series — the manga/comic case, where
                    // finishing one book almost always means opening the next.
                    // Hidden entirely when there is no next entry.
                    if root.next-title != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 48px;
                            border-radius: 14px;
                            background: nx-ta.has-hover ? BookTheme.accent.with-alpha(0.18)
                                                        : BookTheme.accent.with-alpha(0.08);
                            border-width: 1px;
                            border-color: BookTheme.accent.with-alpha(0.35);
                            animate background { duration: 120ms; }
                            nx-ta := TouchArea { clicked => { root.open-next(); } }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 8px;
                                VerticalLayout {
                                    alignment: center; spacing: 1px;
                                    Text {
                                        text: "Next in series";
                                        color: BookTheme.ink-dim;
                                        font-size: 10px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: root.next-title;
                                        color: BookTheme.accent;
                                        font-size: 13px;
                                        font-weight: 800;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    AppIcon {
                                        source: Icons.chevron-right;
                                        tint: BookTheme.accent;
                                        width: 16px; height: 16px;
                                    }
                                }
                            }
                        }
                    }
                }
                // Right: icon buttons — library pill palette, vertically
                // centered in the bar (they used to clip against its top).
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    // Inline in-book search field (replaces the search icon);
                    // typing opens the results panel live. Hidden for books
                    // with no searchable text (comics / magazine PDFs).
                    if root.search-enabled: Rectangle {
                        width: 200px;
                        height: 44px;
                        border-radius: 12px;
                        background: #3a86ff.with-alpha(0.10);
                        border-width: 1px;
                        border-color: #3a86ff.with-alpha(root.search-open ? 0.8 : 0.4);
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 6px;
                            VerticalLayout { alignment: center;
                                AppIcon { source: Icons.search; tint: #3a86ff; width: 15px; height: 15px; } }
                            VerticalLayout { alignment: center;
                                LineEdit {
                                    height: 30px;
                                    placeholder-text: "Search in book";
                                    text <=> root.search-query;
                                    accepted(t) => {
                                        if (root.search-results.length > 0) {
                                            root.search-idx = Math.mod(root.search-idx + 1, root.search-results.length);
                                            root.search-jump(root.search-results[root.search-idx].page);
                                        }
                                    }
                                    edited(t) => {
                                        root.search-idx = -1;
                                        search-timer.restart();
                                        if (t != "") {
                                            root.search-open = true;
                                            root.contents-open = false;
                                            root.bookmarks-open = false;
                                        } else {
                                            root.search-open = false;
                                        }
                                    }
                                } }
                        }
                    }
                    // Bookmarks panel toggle (ribbon lit when this page is marked).
                    ChromeButton {
                        icon: Icons.bookmark;
                        accent: #f5a623;
                        tip: "Bookmarks";
                        active: root.bookmarked || root.bookmarks-open;
                        clicked => {
                            root.bookmarks-open = !root.bookmarks-open;
                            if (root.bookmarks-open) {
                                root.contents-open = false;
                                root.search-open = false;
                                root.bookmarks-load();
                            }
                        }
                    }
                    // Crop uniform margins — scans routinely waste a fifth of
                    // the screen on white borders.
                    if root.image-mode: ChromeButton {
                        icon: Icons.crop;
                        accent: #118ab2;
                        tip: root.trim ? "Show full page" : "Trim margins";
                        active: root.trim;
                        clicked => { root.set-trim(!root.trim); }
                    }
                    // Page thumbnails — the way you navigate a magazine or
                    // comic, where there is no chapter structure to aim at.
                    if root.image-mode: ChromeButton {
                        icon: Icons.layout-grid;
                        accent: #2fbf71;
                        tip: "Pages";
                        active: root.thumbs-open;
                        clicked => {
                            root.thumbs-open = !root.thumbs-open;
                            if (root.thumbs-open) {
                                root.contents-open = false;
                                root.search-open = false;
                                root.bookmarks-open = false;
                                root.thumbs-requested();
                            }
                        }
                    }
                    ChromeButton {
                        icon: Icons.menu;
                        accent: #6c4df6;
                        tip: "Table of contents";
                        active: root.contents-open;
                        clicked => {
                            root.contents-open = !root.contents-open;
                            if (root.contents-open) {
                                root.search-open = false;
                                root.bookmarks-open = false;
                                root.thumbs-open = false;
                            }
                        }
                    }
                    // Single-page view toggle (ebooks; PDFs pick their page
                    // layout in the Aa panel instead).
                    if !root.image-mode: ChromeButton {
                        icon: root.force-single ? Icons.file-text : Icons.book-open;
                        accent: #e0518f;
                        tip: root.force-single ? "Two-page view" : "Single-page view";
                        active: root.force-single;
                        clicked => { root.force-single = !root.force-single; }
                    }
                    // Read aloud (TTS) — reflow text only (image PDFs have no text).
                    if !root.image-mode: ChromeButton {
                        icon: Icons.headphones;
                        accent: #3a86ff;
                        tip: "Read aloud";
                        active: root.tts-open;
                        clicked => {
                            root.tts-open = !root.tts-open;
                            if (root.tts-open) { root.tts-start(); } else { root.tts-stop(); }
                        }
                    }
                    // Define a word (dictionary / translation / Wikipedia).
                    ChromeButton {
                        caption: "Def";
                        accent: #2fbf71;
                        tip: "Define a word";
                        active: root.define-open;
                        clicked => { root.define-open = !root.define-open; }
                    }
                    ChromeButton {
                        caption: "Aa";
                        accent: #6c4df6;
                        tip: "Reading settings";
                        active: root.typography-open;
                        clicked => { root.typography-open = !root.typography-open; }
                    }
                    ChromeButton {
                        icon: Icons.sun;
                        accent: #f5a623;
                        tip: "Cycle brightness";
                        clicked => { root.brightness-cycle(); }
                    }
                    ChromeButton {
                        icon: Icons.ellipsis;
                        accent: #e0518f;
                        tip: "More actions";
                        active: root.more-open;
                        clicked => { root.more-open = !root.more-open; }
                    }
                }
            }
        }

        // ── Content row ──────────────────────────────────────────────────
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            // Spread area with floating chevrons.
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                // Fullscreen chrome reveal for non-PDF views (PdfStage reports
                // its own edge hover); sits under everything so page controls
                // keep their clicks.
                if !root.image-mode: TouchArea {
                    width: 100%;
                    height: 100%;
                    // Clicking the page area returns key focus to the reader
                    // (a LineEdit keeps focus after typing otherwise); the
                    // left/right thirds double as page-turn tap zones.
                    clicked => {
                        key-scope.focus();
                        if (self.mouse-x < self.width / 3) {
                            if (root.continuous) { root.prev-chapter(); }
                            else { root.prev-spread(); }
                        } else if (self.mouse-x > self.width * 2 / 3) {
                            if (root.continuous) { root.next-chapter(); }
                            else { root.next-spread(); }
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.move && root.fullscreen) {
                            root.top-reveal = self.mouse-y < 90px;
                            root.bottom-reveal = self.mouse-y > self.height - 90px;
                        }
                    }
                }
                // Loading / error states over the paper.
                if root.error-text != "": VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: root.error-text;
                        color: BookTheme.ink;
                        font-size: 15px;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        width: 160px;
                        height: 40px;
                        border-radius: 20px;
                        background: BookTheme.accent;
                        Text { text: "Back to library"; color: #ffffff; font-size: 13px; font-weight: 700; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.back(); } }
                    }
                }
                // Two-page spread (wide, not single-page, ebooks only): the
                // open-book mockup with two IDENTICAL centered text columns
                // (equal margins from every page edge). Fixed-page books
                // (PDF/CBZ/CBR) use the flat PdfStage below instead.
                if root.error-text == "" && !root.tts-open && !root.single-page && !root.image-mode: HorizontalLayout {
                    alignment: center;
                    padding: 16px;
                    spacing: 0px;
                    spread := Rectangle {
                        // Contain-fit the 1511×1041 mockup into the stage, at
                        // 95% so the book's top/bottom never touch the chrome.
                        property <length> bg-w: min(min(1360px, parent.width - 140px),
                            self.height * 1.4515) * 0.95;
                        property <length> bg-h: bg-w / 1.4515;
                        property <length> oy: (self.height - bg-h) / 2;
                        width: bg-w;
                        opacity: root.spread-op;
                        Image {
                            source: root.spread-bg;
                            x: 0;
                            y: spread.oy;
                            width: spread.bg-w;
                            height: spread.bg-h;
                        }
                        // Edge shadows on the mockup's left/right/bottom (all
                        // reading themes) — matches the flat PDF spread look.
                        Rectangle {
                            x: -18px;
                            y: spread.oy + 8px;
                            width: 18px;
                            height: spread.bg-h - 8px;
                            background: @linear-gradient(90deg, #00000000 0%, #00000030 100%);
                        }
                        Rectangle {
                            x: spread.bg-w;
                            y: spread.oy + 8px;
                            width: 18px;
                            height: spread.bg-h - 8px;
                            background: @linear-gradient(90deg, #00000030 0%, #00000000 100%);
                        }
                        Rectangle {
                            x: -8px;
                            y: spread.oy + spread.bg-h;
                            width: spread.bg-w + 16px;
                            height: 22px;
                            background: @linear-gradient(180deg, #00000038 0%, #00000000 100%);
                        }
                        // Page-surface fractions of the mockup (measured):
                        // left page x .079–.493, right page x .507–.921,
                        // both y .017–.966 (symmetric). Text columns: equal
                        // 0.34×0.87 blocks centered on each page, inside the
                        // mockup's decorative frame.
                        lp := PaperPage {
                            x: spread.bg-w * 0.286 - self.width / 2;
                            y: spread.oy + spread.bg-h * 0.49 - self.height / 2;
                            width: spread.bg-w * 0.34;
                            height: spread.bg-h * 0.87;
                            body: root.left-text;
                            heading: root.left-heading;
                            font-family: root.font-family;
                            bold: root.bold;
                            folio: root.left-folio;
                            ink: root.paper-ink;
                            talign: root.text-align;
                            pad-x: root.page-pad-x;
                            font-size: root.font-px * 1px;
                            prev => { root.prev-spread(); }
                            next => { root.next-spread(); }
                            // Report the real page px so the engine paginates to
                            // the actual column (fixes clipping / gaps on resize).
                            changed width => { if (!root.image-mode) { root.pending-geom-w = self.width; root.pending-geom-h = self.height; geom-timer.running = true; } }
                            changed height => { if (!root.image-mode) { root.pending-geom-w = self.width; root.pending-geom-h = self.height; geom-timer.running = true; } }
                        }
                        rp := PaperPage {
                            x: spread.bg-w * 0.714 - self.width / 2;
                            y: lp.y;
                            width: spread.bg-w * 0.34;
                            height: lp.height;
                            body: root.right-text;
                            heading: root.right-heading;
                            font-family: root.font-family;
                            bold: root.bold;
                            folio: root.right-folio;
                            ink: root.paper-ink;
                            talign: root.text-align;
                            pad-x: root.page-pad-x;
                            font-size: root.font-px * 1px;
                            prev => { root.prev-spread(); }
                            next => { root.next-spread(); }
                        }
                        // Search-hit flash pill ON the mockup page: anchored to
                        // the hit's page (left/right) at its rough vertical
                        // position — Slint Text can't style substrings inline.
                        if root.flash-on && root.flash-word != "": Rectangle {
                            x: Math.clamp((root.flash-right ? spread.bg-w * 0.714 : spread.bg-w * 0.286) - self.width / 2,
                                8px, spread.bg-w - self.width - 8px);
                            y: Math.clamp(spread.oy + spread.bg-h * (0.055 + 0.87 * root.flash-frac),
                                spread.oy + 12px, spread.oy + spread.bg-h - 48px);
                            width: Math.min(sf-row.preferred-width + 28px, spread.bg-w * 0.44);
                            height: 34px;
                            border-radius: 17px;
                            background: BookTheme.card;
                            border-width: 1.5px;
                            border-color: #f5a623.with-alpha(0.8);
                            drop-shadow-blur: 16px;
                            drop-shadow-color: #00000033;
                            clip: true;
                            sf-row := HorizontalLayout {
                                alignment: center;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 0px;
                                Text { text: root.flash-pre; color: BookTheme.ink-dim; font-size: 12px;
                                    vertical-alignment: center; overflow: elide; }
                                Text { text: root.flash-word; color: #f5a623; font-size: 12px;
                                    font-weight: 800; vertical-alignment: center; }
                                Text { text: root.flash-post; color: BookTheme.ink-dim; font-size: 12px;
                                    vertical-alignment: center; overflow: elide; }
                            }
                        }
                    }
                }
                // Read-aloud view (overrides the page layout while active).
                if root.error-text == "" && root.tts-open: ReadAlong {
                    width: 100%;
                    height: 100%;
                    sentences: root.tts-sentences;
                    active: root.tts-active;
                    paper: root.paper;
                    ink: root.paper-ink;
                    font-size: root.font-px * 1px;
                    font-family: root.font-family;
                    jump(i) => { root.tts-jump(i); }
                }
                // Flat PDF/CBZ stage — single page or side-by-side spread,
                // zoom (mouse-anchored) + pan, no book mockup.
                if root.error-text == "" && !root.tts-open && root.image-mode: PdfStage {
                    width: 100%;
                    height: 100%;
                    opacity: root.spread-op;
                    left-image: root.left-image;
                    right-image: root.right-image;
                    dual: !root.single-page && root.right-folio > 0;
                    hl: root.search-hl;
                    zoom <=> root.zoom;
                    // The folio identifies the page; a sharper re-render of
                    // the same page keeps it, so zoom/pan survive.
                    page-token: root.left-folio;
                    webtoon: root.webtoon;
                    want-dpi(t) => { root.want-dpi(t); }
                    tapped => { key-scope.focus(); }
                    tap-prev => { if (root.single-page) { root.prev-page(); } else { root.prev-spread(); } }
                    tap-next => { if (root.single-page) { root.next-page(); } else { root.next-spread(); } }
                    edge-hover(t, b) => {
                        if (root.fullscreen) {
                            root.top-reveal = t;
                            root.bottom-reveal = b;
                        }
                    }
                }
                // Continuous single-column scroll (reflow text).
                if root.error-text == "" && !root.tts-open && root.continuous: ContinuousText {
                    width: 100%;
                    height: 100%;
                    text: root.full-text;
                    paper: root.paper;
                    ink: root.paper-ink;
                    font-size: root.font-px * 1px;
                    font-family: root.font-family;
                    bold: root.bold;
                    talign: root.text-align;
                    heading: root.full-heading;
                    has-next: root.full-has-next;
                    next-chapter => { root.next-chapter(); }
                    scroll-frac: root.full-frac;
                    nudge <=> root.cont-nudge;
                }
                // Floating chevrons — spread & single-image (not continuous scroll).
                // Single-page steps by 1; spread steps by 2.
                if root.error-text == "" && !root.continuous && !root.tts-open: EdgeNav {
                    x: 16px;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.chevron-left;
                    tip: root.single-page ? "Previous page" : "Previous spread";
                    clicked => {
                        key-scope.focus();
                        if (root.single-page) { root.prev-page(); } else { root.prev-spread(); }
                    }
                }
                if root.error-text == "" && !root.continuous && !root.tts-open: EdgeNav {
                    x: parent.width - self.width - 16px;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.chevron-right;
                    tip: root.single-page ? "Next page" : "Next spread";
                    clicked => {
                        key-scope.focus();
                        if (root.single-page) { root.next-page(); } else { root.next-spread(); }
                    }
                }
                // Zoom column (all book views) — vertical slider + zoom percent
                // + ratio presets + fullscreen, pinned to the stage's right-
                // bottom. PDFs zoom the raster; ebooks scale the type.
                if root.error-text == "" && !root.tts-open: VerticalLayout {
                    x: parent.width - 48px;
                    y: parent.height - 348px;
                    width: 36px;
                    // Explicit height + start alignment — without it the layout
                    // fills the parent and pushes the buttons off-screen.
                    height: 332px;
                    alignment: start;
                    spacing: 8px;
                    VFloatSlider {
                        height: 230px;
                        // Ebook zoom maps to font scale, which clamps at
                        // 13‥26px — a wider slider range would just be dead.
                        minimum: root.image-mode ? 0.5 : 0.75;
                        maximum: root.image-mode ? 4.0 : 1.5;
                        value: root.zoom;
                        changed(v) => { root.zoom = v; }
                    }
                    Text {
                        text: Math.round(root.zoom * 100) + "%";
                        color: BookTheme.ink-dim;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    // One ratio button: PDFs cycle 100% → 70% → 50%; ebooks
                    // just toggle 100% ↔ 75% (the font-scale floor).
                    ChromeButton {
                        width: 36px;
                        height: 32px;
                        caption: root.zoom == 0.7 ? "70" : root.zoom == 0.5 ? "50"
                            : root.zoom == 0.75 ? "75" : "1:1";
                        tip: root.image-mode ? "Zoom preset: 100% → 70% → 50%" : "Zoom preset: 100% ↔ 75%";
                        clicked => {
                            if (root.image-mode) {
                                root.zoom = root.zoom == 1.0 ? 0.7 : root.zoom == 0.7 ? 0.5 : 1.0;
                            } else {
                                root.zoom = root.zoom == 1.0 ? 0.75 : 1.0;
                            }
                        }
                    }
                    ChromeButton {
                        width: 36px;
                        height: 32px;
                        icon: Icons.maximize;
                        tip: root.fullscreen ? "Exit full screen (Esc)" : "Full screen";
                        active: root.fullscreen;
                        clicked => {
                            root.fullscreen = !root.fullscreen;
                            root.top-reveal = false;
                            root.bottom-reveal = false;
                        }
                    }
                }
                // Search flash banner (continuous single-column view only —
                // the two-page spread shows its pill on the mockup itself).
                if root.flash-on && root.flash-word != "" && root.continuous: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 56px;
                    width: Math.min(flash-row.preferred-width + 32px, parent.width - 32px);
                    height: 36px;
                    border-radius: 18px;
                    background: BookTheme.card;
                    border-width: 1.5px;
                    border-color: #f5a623.with-alpha(0.7);
                    drop-shadow-blur: 18px;
                    drop-shadow-color: #00000033;
                    clip: true;
                    flash-row := HorizontalLayout {
                        alignment: center;
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 0px;
                        Text { text: root.flash-pre; color: BookTheme.ink-dim; font-size: 12px;
                            vertical-alignment: center; overflow: elide; }
                        Text { text: root.flash-word; color: #f5a623; font-size: 12px;
                            font-weight: 800; vertical-alignment: center; }
                        Text { text: root.flash-post; color: BookTheme.ink-dim; font-size: 12px;
                            vertical-alignment: center; overflow: elide; }
                    }
                }
                // Brightness dimmer (over the paper, under the chrome bars).
                if root.brightness < 1.0: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #000000;
                    opacity: 1.0 - root.brightness;
                }
                // Loading spinner (simple).
                if root.loading: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: root.paper.with-alpha(0.4);
                    Text {
                        text: "Loading…";
                        color: BookTheme.ink-dim;
                        font-size: 14px;
                    }
                }
            }
            // Contents panel.
            if root.contents-open: ContentsPanel {
                toc: root.toc;
                filter <=> root.contents-filter;
                filter-changed(t) => { root.contents-filter-changed(t); }
                jump(c) => { root.jump-chapter(c); }
                close => { root.contents-open = false; }
            }
            // Search panel (mutually exclusive with contents).
            if root.search-open: SearchPanel {
                results: root.search-results;
                query <=> root.search-query;
                run(t) => { search-timer.restart(); }
                jump(p) => { root.search-jump(p); }
                close => { root.search-open = false; }
            }
            // Page thumbnails — fixed-page books only (an ebook's pages are a
            // function of the current typography, so previews would be moot).
            if root.thumbs-open && root.image-mode: ThumbsPanel {
                thumbs: root.thumbs;
                total: root.thumb-total;
                current-page: root.page-index;
                jump(p) => { root.thumb-jump(p); }
                close => { root.thumbs-open = false; }
            }
            // Bookmarks panel (existing bookmarks for this book).
            if root.bookmarks-open: BookmarksPanel {
                bookmarks: root.bookmarks;
                bookmarked: root.bookmarked;
                toggle => { root.toggle-bookmark(); }
                jump(p) => { root.bookmark-jump(p); }
                remove(id) => { root.bookmark-remove(id); }
                close => { root.bookmarks-open = false; }
            }
        }

        // ── Bottom bar ── collapses in fullscreen; edge-hover reveals it.
        Rectangle {
            height: root.fullscreen && !root.bottom-reveal ? 0px : 72px;
            clip: true;
            animate height { duration: 150ms; easing: ease-in-out; }
            background: BookTheme.card;
            border-width: 1px;
            border-color: BookTheme.hairline;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;
                // Prev chapter pill (hidden when the book has no chapters).
                if root.toc.length > 0: Rectangle {
                    width: 108px;
                    y: (parent.height - 40px) / 2;
                    height: 40px;
                    border-radius: 20px;
                    background: #3a86ff.with-alpha(prevta.has-hover ? 0.24 : 0.10);
                    border-width: 1px;
                    border-color: #3a86ff.with-alpha(0.45);
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        VerticalLayout { alignment: center;
                            AppIcon { source: Icons.chevron-left; tint: #3a86ff; width: 14px; height: 14px; } }
                        Text { text: "Previous"; color: #3a86ff; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                    }
                    prevta := TouchArea { mouse-cursor: pointer;
                        clicked => { root.prev-chapter(); }
                        changed has-hover => {
                            if (self.has-hover) {
                                RTip.text = "Previous chapter";
                                RTip.x = self.absolute-position.x + 54px;
                                RTip.y = self.absolute-position.y - 30px;
                            } else if (RTip.text == "Previous chapter") { RTip.text = ""; }
                        }
                    }
                }
                // Center scrub block.
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    // Slider row with page pill + percent. Without chapters the
                    // pills are gone — inset the bar so it reads centered.
                    HorizontalLayout {
                        spacing: 12px;
                        padding-left: root.toc.length == 0 ? root.width * 0.12 : 0px;
                        padding-right: root.toc.length == 0 ? root.width * 0.12 : 0px;
                        BookSlider {
                            horizontal-stretch: 1;
                            minimum: 1;
                            maximum: max(root.page-count, 1);
                            value: root.page-index;
                            step: root.single-page ? 1 : 2;
                            changed(p) => { key-scope.focus(); root.scrub(p); }
                        }
                        // Page pill.
                        Rectangle {
                            width: 74px;
                            height: 26px;
                            y: (parent.height - 26px) / 2;
                            border-radius: 13px;
                            background: BookTheme.card;
                            border-width: 1px;
                            border-color: BookTheme.hairline;
                            Text {
                                text: root.page-index + " / " + root.page-count;
                                color: BookTheme.ink;
                                font-size: 13px;
                                font-weight: 700;
                            }
                        }
                        Text {
                            text: round(root.percent * 100) + "%";
                            color: BookTheme.ink-dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    // Chapter names under slider (zoom moved to the stage's
                    // right edge as a vertical google-maps-style slider).
                    // PDFs get them too when the file carries an outline.
                    if !root.image-mode || root.toc.length > 0: HorizontalLayout {
                        Text {
                            text: root.chapter-name;
                            color: BookTheme.ink-dim;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: root.next-chapter-name;
                            color: BookTheme.ink-dim;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }
                }
                // Next chapter pill (violet filled; hidden without chapters).
                if root.toc.length > 0: Rectangle {
                    width: 92px;
                    y: (parent.height - 40px) / 2;
                    height: 40px;
                    border-radius: 20px;
                    background: nextta.has-hover ? BookTheme.accent.with-alpha(0.9) : BookTheme.accent;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "Next"; color: #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                        VerticalLayout { alignment: center;
                            AppIcon { source: Icons.chevron-right; tint: #ffffff; width: 14px; height: 14px; } }
                    }
                    nextta := TouchArea { mouse-cursor: pointer;
                        clicked => { root.next-chapter(); }
                        changed has-hover => {
                            if (self.has-hover) {
                                RTip.text = "Next chapter";
                                RTip.x = self.absolute-position.x + 46px;
                                RTip.y = self.absolute-position.y - 30px;
                            } else if (RTip.text == "Next chapter") { RTip.text = ""; }
                        }
                    }
                }
            }
        }
    }

    // ── Reading-settings (Aa) sheet ───────────────────────────────────────────
    // Click-away backdrop + floating card anchored under the Aa button. Size /
    // line-spacing / margins / typeface re-paginate (sec-books); theme / bold /
    // brightness are visual-only.
    if root.typography-open: TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.typography-open = false; }
    }
    if root.typography-open: Rectangle {
        x: root.width - self.width - 20px;
        y: 76px;
        width: 320px;
        height: root.image-mode ? 352px : 566px;
        border-radius: 16px;
        background: BookTheme.card;
        border-width: 1px;
        border-color: BookTheme.hairline;
        drop-shadow-blur: 28px;
        drop-shadow-color: #00000026;
        drop-shadow-offset-y: 6px;
        VerticalLayout {
            padding: 16px;
            spacing: 14px;
            // ── PDF sections (fixed-page books: layout + zoom + fullscreen;
            //    the ebook typography below is meaningless there). ──────────
            if root.image-mode: VerticalLayout {
                spacing: 7px;
                Text { text: "Page layout"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                HorizontalLayout {
                    spacing: 8px;
                    SegItem { label: "Single"; active: root.force-single;
                        clicked => { root.force-single = true; } }
                    SegItem { label: "Odd 1·2"; active: !root.force-single && root.spread-mode == 1;
                        clicked => { root.force-single = false; root.spread-mode = 1; root.set-spread(1); } }
                    SegItem { label: "Even 2·3"; active: !root.force-single && root.spread-mode == 2;
                        clicked => { root.force-single = false; root.spread-mode = 2; root.set-spread(2); } }
                }
            }
            if root.image-mode: VerticalLayout {
                spacing: 7px;
                Text { text: "Zoom"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                HorizontalLayout {
                    spacing: 10px;
                    ChromeButton { caption: "−"; clicked => { root.zoom = Math.max(root.zoom - 0.25, 0.5); } }
                    Text { text: Math.round(root.zoom * 100) + "%"; color: BookTheme.ink; font-size: 14px;
                        font-weight: 700; horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center; }
                    ChromeButton { caption: "+"; clicked => { root.zoom = Math.min(root.zoom + 0.25, 4.0); } }
                }
                HorizontalLayout {
                    SegItem { label: "Fit page (100%)"; active: root.zoom == 1.0;
                        clicked => { root.zoom = 1.0; } }
                }
            }
            if root.image-mode: HorizontalLayout {
                SegItem {
                    label: root.fullscreen ? "Full screen: On  (Esc exits)" : "Full screen: Off";
                    active: root.fullscreen;
                    clicked => {
                        root.fullscreen = !root.fullscreen;
                        root.top-reveal = false;
                        root.bottom-reveal = false;
                        root.typography-open = false;
                    }
                }
            }
            // ── Ebook typography (reflow text only). ─────────────────────
            if !root.image-mode: VerticalLayout {
                spacing: 7px;
                Text { text: "Text size"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                HorizontalLayout {
                    spacing: 10px;
                    ChromeButton { caption: "A−"; clicked => { root.font-dec(); } }
                    Text { text: round(root.font-px) + " px"; color: BookTheme.ink; font-size: 14px;
                        font-weight: 700; horizontal-stretch: 1; horizontal-alignment: center; vertical-alignment: center; }
                    ChromeButton { caption: "A+"; clicked => { root.font-inc(); } }
                }
            }
            // Line spacing.
            if !root.image-mode: VerticalLayout {
                spacing: 7px;
                Text { text: "Line spacing"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                HorizontalLayout {
                    spacing: 8px;
                    SegItem { label: "Compact"; active: root.line-index == 0; clicked => { root.set-line-spacing(0); } }
                    SegItem { label: "Normal"; active: root.line-index == 1; clicked => { root.set-line-spacing(1); } }
                    SegItem { label: "Relaxed"; active: root.line-index == 2; clicked => { root.set-line-spacing(2); } }
                }
            }
            // Margins.
            if !root.image-mode: VerticalLayout {
                spacing: 7px;
                Text { text: "Margins"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                HorizontalLayout {
                    spacing: 8px;
                    SegItem { label: "Narrow"; active: root.margin-index == 0; clicked => { root.set-margin(0); } }
                    SegItem { label: "Normal"; active: root.margin-index == 1; clicked => { root.set-margin(1); } }
                    SegItem { label: "Wide"; active: root.margin-index == 2; clicked => { root.set-margin(2); } }
                }
            }
            // Typeface.
            if !root.image-mode: VerticalLayout {
                spacing: 7px;
                Text { text: "Typeface"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                HorizontalLayout {
                    spacing: 8px;
                    SegItem { label: "Serif"; preview-font: "serif"; active: root.typeface == 0; clicked => { root.set-typeface(0); } }
                    SegItem { label: "Sans"; preview-font: "sans-serif"; active: root.typeface == 1; clicked => { root.set-typeface(1); } }
                    SegItem { label: "Mono"; preview-font: "monospace"; active: root.typeface == 2; clicked => { root.set-typeface(2); } }
                }
            }
            // Alignment (visual-only — line breaks don't change).
            if !root.image-mode: VerticalLayout {
                spacing: 7px;
                Text { text: "Alignment"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                HorizontalLayout {
                    spacing: 8px;
                    SegItem { label: "Left"; active: root.text-align == 0; clicked => { root.set-align(0); } }
                    SegItem { label: "Center"; active: root.text-align == 1; clicked => { root.set-align(1); } }
                    SegItem { label: "Right"; active: root.text-align == 2; clicked => { root.set-align(2); } }
                }
            }
            // Theme swatches (paper themes — reflow books only).
            if !root.image-mode: VerticalLayout {
                spacing: 7px;
                Text { text: "Theme"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                HorizontalLayout {
                    spacing: 10px;
                    for t in [
                        { key: "light", col: #fdfcf8 },
                        { key: "sepia", col: #f4ecd8 },
                        { key: "dark", col: #1c1c20 },
                        { key: "night", col: #000000 },
                    ]: Rectangle {
                        height: 36px;
                        border-radius: 10px;
                        background: t.col;
                        border-width: root.theme-mode == t.key ? 2.5px : 1px;
                        border-color: root.theme-mode == t.key ? BookTheme.accent : BookTheme.hairline;
                        TouchArea { mouse-cursor: pointer; clicked => { root.set-theme(t.key); } }
                    }
                }
            }
            // Brightness.
            VerticalLayout {
                spacing: 7px;
                Text { text: "Brightness"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                HorizontalLayout {
                    spacing: 8px;
                    SegItem { label: "Dim"; active: root.brightness <= 0.65; clicked => { root.set-brightness(0.6); } }
                    SegItem { label: "Medium"; active: root.brightness > 0.65 && root.brightness < 0.95; clicked => { root.set-brightness(0.8); } }
                    SegItem { label: "Full"; active: root.brightness >= 0.95; clicked => { root.set-brightness(1.0); } }
                }
            }
            // Bold.
            if !root.image-mode: HorizontalLayout {
                SegItem { label: root.bold ? "Bold: On" : "Bold: Off"; active: root.bold;
                    clicked => { root.toggle-bold(); } }
            }
        }
    }

    // ── ••• (more) popover ────────────────────────────────────────────────────
    if root.more-open: TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.more-open = false; }
    }
    if root.more-open: Rectangle {
        x: root.width - self.width - 20px;
        y: 76px;
        width: 220px;
        height: 96px;
        border-radius: 14px;
        background: BookTheme.card;
        border-width: 1px;
        border-color: BookTheme.hairline;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000022;
        drop-shadow-offset-y: 4px;
        VerticalLayout {
            padding: 8px;
            spacing: 2px;
            for item in [
                { label: "Mark as finished", icon: Icons.check, danger: false, action: "finished" },
                { label: "Remove from library", icon: Icons.trash, danger: true, action: "remove" },
            ]: Rectangle {
                height: 38px;
                border-radius: 8px;
                background: mrowta.has-hover ? BookTheme.pill-bg : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    VerticalLayout { alignment: center;
                        AppIcon {
                            source: item.icon;
                            tint: item.danger ? #d64545 : BookTheme.ink-dim;
                            width: 16px;
                            height: 16px;
                        } }
                    Text {
                        text: item.label;
                        color: item.danger ? #d64545 : BookTheme.ink;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                mrowta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.more-open = false;
                        if (item.action == "finished") { root.more-mark-finished(); }
                        if (item.action == "remove") { root.more-remove(); }
                    }
                }
            }
        }
    }

    // ── Read-aloud control bar ────────────────────────────────────────────────
    if root.tts-open: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 72px - 68px;
        width: 640px;
        height: 56px;
        border-radius: 28px;
        background: BookTheme.card;
        border-width: 1px;
        border-color: BookTheme.hairline;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000026;
        drop-shadow-offset-y: 4px;
        HorizontalLayout {
            padding-left: 10px; padding-right: 14px; spacing: 10px; alignment: center;
            // Play / pause.
            Rectangle {
                width: 40px; height: 40px; border-radius: 20px; background: BookTheme.accent;
                AppIcon { source: root.tts-playing ? Icons.pause : Icons.play; tint: #ffffff; width: 18px; height: 18px; }
                TouchArea { mouse-cursor: pointer; clicked => { root.tts-play-pause(); } }
            }
            // Voice.
            VerticalLayout { alignment: center; horizontal-stretch: 1;
                ComboBox {
                    model: root.tts-voices;
                    current-value: root.tts-voice;
                    selected(v) => { root.tts-set-voice(v); }
                } }
            // Speed.
            SegItem { label: "0.75×"; text-size: 11px; active: root.tts-speed-index == 0; clicked => { root.tts-set-speed(0); } }
            SegItem { label: "1×"; text-size: 11px; active: root.tts-speed-index == 1; clicked => { root.tts-set-speed(1); } }
            SegItem { label: "1.25×"; text-size: 11px; active: root.tts-speed-index == 2; clicked => { root.tts-set-speed(2); } }
            SegItem { label: "1.5×"; text-size: 11px; active: root.tts-speed-index == 3; clicked => { root.tts-set-speed(3); } }
            // Close.
            Rectangle {
                width: 36px; height: 36px; border-radius: 18px; background: closeta.has-hover ? BookTheme.pill-bg : BookTheme.card;
                border-width: 1px; border-color: BookTheme.hairline;
                AppIcon { source: Icons.x; tint: BookTheme.ink-dim; width: 15px; height: 15px; }
                closeta := TouchArea { mouse-cursor: pointer; clicked => { root.tts-open = false; root.tts-stop(); } }
            }
        }
    }

    // ── Define-a-word popup (R2) ───────────────────────────────────────────────
    if root.define-open: TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.define-open = false; }
    }
    if root.define-open: Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 540px;
        height: 460px;
        border-radius: 18px;
        background: BookTheme.card;
        border-width: 1px;
        border-color: BookTheme.hairline;
        drop-shadow-blur: 34px;
        drop-shadow-color: #00000033;
        drop-shadow-offset-y: 8px;
        VerticalLayout {
            padding: 18px;
            spacing: 14px;
            // Title + close.
            HorizontalLayout {
                alignment: space-between;
                Text { text: "Define"; color: BookTheme.ink; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                ChromeButton { icon: Icons.x; width: 32px; height: 32px; clicked => { root.define-open = false; } }
            }
            // Word input + language + search.
            HorizontalLayout {
                spacing: 8px;
                wordfield := LineEdit {
                    placeholder-text: "Type a word…";
                    text <=> root.define-word;
                    horizontal-stretch: 1;
                    accepted(t) => { root.define-run(t, root.define-lang); }
                }
                ComboBox {
                    model: ["hi", "es", "fr", "de", "it", "pt", "ja", "zh", "ru", "ar"];
                    current-value: root.define-lang;
                    selected(v) => { root.define-lang = v; }
                }
                Rectangle {
                    width: 92px; height: 34px; border-radius: 9px; background: BookTheme.accent;
                    HorizontalLayout { alignment: center; spacing: 6px;
                        VerticalLayout { alignment: center;
                            AppIcon { source: Icons.search; tint: #ffffff; width: 14px; height: 14px; } }
                        Text { text: "Search"; color: #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.define-run(root.define-word, root.define-lang); } }
                }
            }
            if root.define-loading: Text { text: "Looking up…"; color: BookTheme.ink-dim; font-size: 13px; }
            // Results.
            ScrollView {
                VerticalLayout {
                    spacing: 14px;
                    if root.define-definition != "": VerticalLayout {
                        spacing: 3px;
                        Text { text: "Definition" + (root.define-pos != "" ? " · " + root.define-pos : "");
                            color: BookTheme.accent; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                        Text { text: root.define-definition; color: BookTheme.ink; font-size: 14px; wrap: word-wrap; }
                    }
                    if root.define-translation != "": VerticalLayout {
                        spacing: 3px;
                        Text { text: "Translation (" + root.define-lang + ")"; color: BookTheme.accent; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                        Text { text: root.define-translation; color: BookTheme.ink; font-size: 14px; wrap: word-wrap; }
                    }
                    if root.define-wiki != "": VerticalLayout {
                        spacing: 3px;
                        Text { text: "Wikipedia"; color: BookTheme.accent; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                        Text { text: root.define-wiki; color: BookTheme.ink; font-size: 13px; wrap: word-wrap; }
                        if root.define-wiki-url != "": Text {
                            text: "Open article →"; color: BookTheme.accent; font-size: 12px; font-weight: 700;
                            TouchArea { mouse-cursor: pointer; clicked => { root.open-url(root.define-wiki-url); } }
                        }
                    }
                    if !root.define-loading && root.define-definition == "" && root.define-translation == "" && root.define-wiki == "": Text {
                        text: "Enter a word and press Search.";
                        color: BookTheme.ink-dim; font-size: 13px;
                    }
                }
            }
        }
    }

    // ── Close-confirm dialog (Escape → confirm with Enter) ────────────────────
    if root.close-confirm: Rectangle {
        width: 100%; height: 100%;
        background: #00000066;
        TouchArea { clicked => { root.close-confirm = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 320px; height: 150px;
            border-radius: 16px;
            background: BookTheme.card;
            border-width: 1.5px;
            border-color: BookTheme.accent.with-alpha(0.5);
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000044;
            VerticalLayout {
                padding: 20px; spacing: 14px;
                Text { text: "Close this book?"; color: BookTheme.ink;
                    font-size: 16px; font-weight: 800; horizontal-alignment: center; }
                Text { text: "Your reading position is saved."; color: BookTheme.ink-dim;
                    font-size: 12px; horizontal-alignment: center; }
                HorizontalLayout {
                    spacing: 10px; alignment: center;
                    Rectangle {
                        width: 110px; height: 38px; border-radius: 19px;
                        background: BookTheme.pill-bg;
                        border-width: 1px; border-color: BookTheme.hairline;
                        Text { text: "Cancel  (Esc)"; color: BookTheme.ink; font-size: 12px; font-weight: 600; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.close-confirm = false; } }
                    }
                    Rectangle {
                        width: 110px; height: 38px; border-radius: 19px;
                        background: BookTheme.accent;
                        Text { text: "Close  (↵)"; color: #ffffff; font-size: 12px; font-weight: 700; }
                        TouchArea { mouse-cursor: pointer;
                            clicked => { root.close-confirm = false; root.back(); } }
                    }
                }
            }
        }
    }

    // ── Hover tooltip pill (published by any control via RTip) ────────────────
    if RTip.text != "": Rectangle {
        x: Math.clamp(RTip.x - root.absolute-position.x - self.width / 2,
            8px, root.width - self.width - 8px);
        y: Math.clamp(RTip.y - root.absolute-position.y, 8px, root.height - 36px);
        width: tip-t.preferred-width + 22px;
        height: 26px;
        border-radius: 13px;
        background: BookTheme.dark ? #2a2a36f2 : #1b1b22ee;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
        tip-t := Text {
            text: RTip.text;
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
        }
    }
}
