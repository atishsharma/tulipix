import { Theme } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";

export struct ContextItem {
    id: string,
    label: string,
    shortcut: string,
    danger: bool,
}

export component ContextMenu inherits Rectangle {
    in property <[ContextItem]> items;
    in-out property <bool> open: false;
    in property <length> menu-x: 0;
    in property <length> menu-y: 0;
    callback chosen(string);

    width: 100%; height: 100%;
    background: transparent;
    if open: TouchArea {
        clicked => { root.open = false; }
    }

    if open: Rectangle {
        x: menu-x; y: menu-y;
        width: 220px; height: items.length * 32px + 12px;
        background: Theme.modal;
        border-radius: Theme.radius-md;
        border-color: Theme.outline-strong; border-width: 1px;
        drop-shadow-blur: Surface.cast(32px);
        drop-shadow-color: #00000099;
        z: 100;
        VerticalLayout {
            padding: 6px;
            for it in root.items: Rectangle {
                height: 30px;
                border-radius: Surface.rr(6px, self.width, self.height);
                touch := TouchArea {
                    clicked => { root.chosen(it.id); root.open = false; }
                }
                background: touch.has-hover
                    ? (it.danger ? #dc262633 : Theme.panel-2)
                    : transparent;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px;
                    Text {
                        text: it.label;
                        color: it.danger ? #fca5a5 : Theme.text;
                        font-size: 12px; vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: it.shortcut;
                        color: Theme.text-dim;
                        font-size: 11px; vertical-alignment: center;
                    }
                }
            }
        }
    }
}
