// Home layout 6 of 7 — DECK. Spec: docs/home-layouts/06-deck.md (mockup l3.png).
//
// The command deck: a strip of section keys across the top, the resume strip and
// the newest arrivals under it, five hub panels along the bottom, and a standing
// rail on the right holding the player, the quick launches and the money.
//
// Same data as every other layout — only the composition differs. Card switches
// collapse their band rather than leaving a hole (README §5).
import { Theme } from "tokens.slint";
import { Surface, Rim } from "surface.slint";
import { Icons, AppIcon } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { HomeStats, HomeRemote, HomeContinue } from "page_home.slint";
import { HomeDue } from "page_home_cinema.slint";

// ── Panel base ──────────────────────────────────────────────────────────────
component DeckCard inherits Rectangle {
    border-radius: Surface.card-radius;
    background: Surface.body(Theme.panel);
    border-width: 1px;
    border-color: Surface.hairline;
    drop-shadow-blur: Surface.card-shadow;
    drop-shadow-color: Surface.shadow-ink;
    drop-shadow-offset-y: Surface.card-shadow-y;
    if Surface.rim: Rim {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        radius: Surface.card-radius - 1px;
    }
    @children
}

// ── Section key — icon plate, name, count ───────────────────────────────────
component SectionChip inherits Rectangle {
    in property <string> name;
    in property <string> count;
    in property <image> icon;
    in property <color> accent;
    callback clicked();
    height: 62px;
    horizontal-stretch: 0;
    border-radius: Surface.r(14px);
    background: t.has-hover ? Surface.body(Theme.panel-2) : Surface.body(Theme.panel);
    border-width: 1px;
    border-color: t.has-hover ? root.accent.with-alpha(0.5) : Surface.hairline;
    drop-shadow-blur: Surface.tile-shadow();
    drop-shadow-color: Surface.shadow-ink;
    drop-shadow-offset-y: Surface.tile-shadow-y();
    animate border-color { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 9px;
        Rectangle {
            width: 34px; height: 34px; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            border-radius: Surface.glyph-radius;
            background: root.accent.with-alpha(Theme.dark ? 0.26 : 0.16);
            AppIcon { source: root.icon; tint: root.accent; width: 17px; height: 17px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        VerticalLayout {
            alignment: center; spacing: 1px; horizontal-stretch: 1;
            Text { text: root.name; color: Theme.text; font-size: 13px; font-weight: 700;
                overflow: elide; }
            Text { text: root.count; color: Theme.text-dim; font-size: 10px; overflow: elide; }
        }
    }
}

// ── Resume tile — cover, scrim, title, progress ─────────────────────────────
component ResumeTile inherits Rectangle {
    in property <HomeContinue> item;
    in property <color> accent;
    callback clicked();
    border-radius: Surface.r(14px);
    clip: true;
    background: root.accent.with-alpha(Theme.dark ? 0.22 : 0.14);
    border-width: 1px;
    border-color: t.has-hover ? root.accent.with-alpha(0.55) : Surface.hairline;
    animate border-color { duration: 120ms; easing: ease-out; }
    if root.item.cover.width > 0: Image {
        source: root.item.cover; image-fit: cover;
        width: 100%; height: 100%;
        opacity: t.has-hover ? 1.0 : 0.92;
        animate opacity { duration: 140ms; easing: ease-out; }
    }
    if root.item.cover.width == 0: AppIcon {
        source: root.item.kind == "video" ? Icons.film
            : root.item.kind == "book" ? Icons.book-open
            : root.item.kind == "podcast" ? Icons.mic : Icons.headphones;
        tint: root.accent; width: 26px; height: 26px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 - 14px;
    }
    // Bottom scrim so the caption survives a bright frame.
    Rectangle {
        y: parent.height - 78px; width: 100%; height: 78px;
        background: @linear-gradient(180deg, #00000000, #000000d8);
    }
    // Play affordance, centred, only for things you watch or hear.
    if root.item.kind != "book": Rectangle {
        width: 40px; height: 40px; border-radius: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 14px;
        background: t.has-hover ? #ffffff : #ffffffcc;
        animate background { duration: 120ms; easing: ease-out; }
        AppIcon { source: Icons.play; tint: #101020; width: 15px; height: 15px;
            x: (parent.width - self.width) / 2 + 1px; y: (parent.height - self.height) / 2; }
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    VerticalLayout {
        padding: 11px; spacing: 5px; alignment: end;
        Text { text: root.item.title; color: #ffffff; font-size: 12.5px; font-weight: 700;
            overflow: elide; }
        Text {
            text: root.item.sub == "" ? root.item.author : root.item.sub;
            color: #ffffffb0; font-size: 10px; overflow: elide;
        }
        HorizontalLayout {
            height: 6px; spacing: 7px;
            Rectangle {
                height: 5px; border-radius: 3px; horizontal-stretch: 1;
                y: (parent.height - self.height) / 2;
                background: #ffffff33;
                Rectangle {
                    x: 0; width: parent.width * Math.clamp(root.item.frac, 0.0, 1.0);
                    height: 100%; border-radius: 3px; background: #ffffff;
                }
            }
            Text {
                text: root.item.frac < 0 ? "" : Math.round(root.item.frac * 100) + "%";
                color: #ffffffcc; font-size: 9.5px; font-weight: 700;
                width: 26px; horizontal-alignment: right; horizontal-stretch: 0;
                vertical-alignment: center;
            }
        }
    }
}

// ── Filter chip ─────────────────────────────────────────────────────────────
component DeckChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    height: 26px;
    width: lab.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: 13px;
    background: root.active ? Theme.brand : (t.has-hover ? Theme.glass-strong : Theme.glass);
    border-width: 1px;
    border-color: root.active ? Theme.brand : Theme.glass-border;
    animate background { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    lab := Text {
        text: root.label;
        color: root.active ? #ffffff : Theme.text-dim;
        font-size: 11px; font-weight: root.active ? 700 : 500;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}

// ── Card caption — icon dot, title, sub, slot on the right ──────────────────
component DeckCap inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <image> icon;
    in property <color> accent;
    height: 34px;
    background: transparent;
    HorizontalLayout {
        spacing: 9px;
        Rectangle {
            width: 26px; height: 26px; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            border-radius: Surface.r(8px);
            background: root.accent.with-alpha(Theme.dark ? 0.26 : 0.16);
            AppIcon { source: root.icon; tint: root.accent; width: 14px; height: 14px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        VerticalLayout {
            alignment: center; spacing: 0px; horizontal-stretch: 0;
            Text { text: root.title; color: Theme.text; font-size: 13px; font-weight: 700; }
            Text { text: root.sub; color: Theme.text-dim; font-size: 9.5px;
                height: root.sub == "" ? 0px : self.preferred-height; }
        }
        @children
    }
}

// ── Soft footer button on a hub panel ───────────────────────────────────────
component DeckFoot inherits Rectangle {
    in property <string> label;
    in property <color> accent;
    callback clicked();
    height: 30px;
    border-radius: Surface.r(9px);
    background: root.accent.with-alpha(t.has-hover ? (Theme.dark ? 0.34 : 0.24)
                                                   : (Theme.dark ? 0.20 : 0.13));
    animate background { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text { text: root.label; color: root.accent; font-size: 11px; font-weight: 700;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}

// ── Transport button ────────────────────────────────────────────────────────
component DeckBtn inherits Rectangle {
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> lit: false;
    in property <color> accent: Theme.sec-music;
    callback clicked();
    width: root.primary ? 40px : 30px;
    height: self.width;
    horizontal-stretch: 0;
    border-radius: self.width / 2;
    background: root.primary
        ? (t.has-hover ? root.accent : root.accent.with-alpha(0.9))
        : (t.has-hover ? Theme.glass-strong : transparent);
    animate background { duration: 110ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    AppIcon {
        source: root.icon;
        tint: root.primary ? #ffffff : (root.lit ? root.accent : Theme.text-dim);
        width: root.primary ? 16px : 14px; height: self.width;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}

// ── Tool disc on the hub panel ──────────────────────────────────────────────
component ToolDisc inherits Rectangle {
    in property <image> icon;
    callback clicked();
    width: 38px; height: 38px;
    horizontal-stretch: 0;
    border-radius: 19px;
    background: Theme.sec-tools.with-alpha(t.has-hover ? (Theme.dark ? 0.34 : 0.22)
                                                       : (Theme.dark ? 0.20 : 0.12));
    animate background { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    AppIcon { source: root.icon; tint: Theme.sec-tools; width: 16px; height: 16px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}

// ── Quick launch tile ───────────────────────────────────────────────────────
component QuickTile inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <color> accent;
    callback clicked();
    background: transparent;
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    VerticalLayout {
        spacing: 6px; alignment: center;
        Rectangle {
            height: 40px; width: 40px; horizontal-stretch: 0;
            x: (parent.width - self.width) / 2;
            border-radius: Surface.r(12px);
            background: root.accent.with-alpha(t.has-hover ? (Theme.dark ? 0.36 : 0.24)
                                                           : (Theme.dark ? 0.22 : 0.13));
            animate background { duration: 120ms; easing: ease-out; }
            AppIcon { source: root.icon; tint: root.accent; width: 18px; height: 18px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        Text { text: root.label; color: Theme.text-dim; font-size: 9.5px; font-weight: 600;
            horizontal-alignment: center; wrap: word-wrap; }
    }
}

export component HomeDeck inherits Rectangle {
    // ── Header ──────────────────────────────────────────────────────────────
    in property <string> greeting: "Welcome";
    in property <string> date-line: "";
    in property <string> library-line: "";
    in property <image> avatar-image;
    // ── Body ────────────────────────────────────────────────────────────────
    in property <HomeStats> stats;
    in property <[HomeContinue]> continue-rows: [];
    in property <[image]> recent-photos: [];
    in property <[image]> recent-videos: [];
    in property <[image]> book-covers: [];
    in property <[HomeRemote]> cloud-remotes: [];
    in property <string> transfer-inbox: "";
    in property <string> transfer-note: "";
    // ── Money ───────────────────────────────────────────────────────────────
    in property <string> fin-spent: "";
    in property <string> fin-month: "";
    in property <string> fin-income: "";
    in property <string> fin-liquid: "";
    in property <[float]> fin-months: [];
    in property <[HomeDue]> fin-dues: [];
    // ── Player ──────────────────────────────────────────────────────────────
    in property <string> np-title: "";
    in property <string> np-sub: "";
    in property <image> np-art;
    in property <color> np-accent: Theme.sec-music;
    in property <bool> playing: false;
    in property <float> pos: 0;
    in property <float> dur: 1;
    in property <string> pos-label: "";
    in property <string> dur-label: "";
    in property <bool> shuffle: false;
    in property <string> repeat: "off";
    in property <float> volume: 1;
    in property <bool> muted: false;
    // ── Card visibility ─────────────────────────────────────────────────────
    in property <bool> hc-continue: true;
    in property <bool> hc-library: true;      // the Recently Added strip
    in property <bool> hc-player: true;
    in property <bool> hc-quick: true;
    in property <bool> hc-photos: true;
    in property <bool> hc-videos: true;
    in property <bool> hc-music: true;
    in property <bool> hc-books: true;
    in property <bool> hc-cloud: true;
    in property <bool> hc-tools: true;
    in property <bool> hc-transfer: true;
    in property <bool> hc-finances: true;

    callback open-section(string);
    callback open-search();
    callback open-tool(string);
    callback open-remote(string);
    callback open-profile();
    /// Settings › Status — the dashboard is a Settings tab, not a section.
    callback open-status();
    callback open-photo-item(int);
    callback open-video-item(int);
    callback open-book-item(int);
    callback continue-open(HomeContinue);
    callback start-sharing();
    callback playpause();
    callback next();
    callback prev();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-zen();
    callback open-stream();
    callback open-livetv();
    callback open-download();
    callback random-radio();

    // ── Geometry ────────────────────────────────────────────────────────────
    property <length> pad: 24px;
    property <length> gap: 12px;
    property <length> head-h: 82px;
    property <int> rail-n: (root.hc-player ? 1 : 0) + (root.hc-quick ? 1 : 0)
        + (root.hc-finances ? 1 : 0);
    property <length> rail-w: root.rail-n > 0 ? 300px : 0px;
    property <length> col-w: root.width - 2 * root.pad
        - (root.rail-w > 0px ? root.rail-w + root.gap : 0px);
    // Section keys divide the column evenly; nested layouts don't hand leftover
    // width down (slint-layout-width-distribution), so the width is computed.
    property <int> keys: (root.hc-photos ? 1 : 0) + (root.hc-videos ? 1 : 0)
        + (root.hc-music ? 1 : 0) + (root.hc-books ? 1 : 0) + (root.hc-cloud ? 1 : 0)
        + (root.hc-tools ? 1 : 0) + (root.hc-transfer ? 1 : 0) + (root.hc-finances ? 1 : 0);
    property <length> key-w: root.keys > 0
        ? (root.col-w - (root.keys - 1) * 8px) / root.keys : 0px;
    property <int> hubs: (root.hc-cloud ? 1 : 0) + (root.hc-transfer ? 1 : 0)
        + (root.hc-finances ? 1 : 0) + (root.hc-tools ? 1 : 0) + 1;   // +1 = status
    property <length> hub-w: (root.col-w - (root.hubs - 1) * root.gap) / root.hubs;
    // Resume strip: four slots, or as many as there are.
    property <int> res-n: Math.min(4, root.continue-rows.length);
    property <length> res-w: root.res-n > 0
        ? (root.col-w - 28px - (root.res-n - 1) * 10px) / root.res-n : 0px;
    // Recently Added strip.
    property <string> ra: "all";
    property <length> thumb-w: 152px;
    property <int> ra-shown:
        root.ra == "photos" ? Math.min(6, root.recent-photos.length)
        : root.ra == "videos" ? Math.min(6, root.recent-videos.length)
        : root.ra == "books" ? Math.min(6, root.book-covers.length)
        : Math.min(3, root.recent-photos.length) + Math.min(2, root.recent-videos.length)
          + Math.min(1, root.book-covers.length);
    property <int> ra-total: root.stats.photos + root.stats.videos + root.stats.books;
    property <bool> fin-late: root.fin-dues.length > 0 && root.fin-dues[0].late;
    property <bool> scanning: root.stats.photos-scan != "" || root.stats.videos-note != "";

    function accent-of(kind: string) -> color {
        kind == "video" ? Theme.sec-videos
            : kind == "book" ? Theme.sec-books
            : kind == "podcast" ? Theme.sec-music
            : Theme.sec-music
    }

    background: Theme.bg;
    clip: true;

    // ── Top bar ─────────────────────────────────────────────────────────────
    Rectangle {
        x: root.pad; y: 18px; width: root.width - 2 * root.pad; height: 52px;
        background: transparent;
        VerticalLayout {
            alignment: center; spacing: 3px; horizontal-stretch: 1;
            width: Math.max(220px, (parent.width - 440px) / 2);
            Text { text: root.greeting; color: Theme.text; font-size: 23px; font-weight: 700;
                letter-spacing: -0.8px; overflow: elide; }
            Text {
                text: root.date-line + (root.library-line == "" ? "" : "  ·  " + root.library-line);
                color: Theme.text-dim; font-size: 10.5px; overflow: elide;
            }
        }
        // Search pill, centred on the page like the mockup.
        Rectangle {
            width: Math.min(430px, parent.width * 0.34); height: 42px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 21px;
            background: Surface.body(sb.has-hover ? Theme.panel-2 : Theme.panel);
            border-width: 1px; border-color: Surface.hairline;
            drop-shadow-blur: Surface.card-shadow;
            drop-shadow-color: Surface.shadow-ink;
            drop-shadow-offset-y: Surface.card-shadow-y;
            sb := TouchArea { mouse-cursor: pointer; clicked => { root.open-search(); } }
            HorizontalLayout {
                padding-left: 16px; padding-right: 10px; spacing: 10px;
                AppIcon { source: Icons.search; tint: Theme.text-dim; width: 15px; height: 15px;
                    y: (parent.height - self.height) / 2; horizontal-stretch: 0; }
                Text { text: "Search anything in Tulipix…"; color: Theme.text-dim;
                    font-size: 12px; vertical-alignment: center; horizontal-stretch: 1;
                    overflow: elide; }
                Rectangle {
                    width: 40px; height: 22px; border-radius: 8px; horizontal-stretch: 0;
                    y: (parent.height - self.height) / 2;
                    background: Theme.glass;
                    Text { text: "⌘K"; color: Theme.text-dim; font-size: 10px; font-weight: 600;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
            }
        }
        // Avatar — the only door out of Home in this bar.
        Rectangle {
            width: 42px; height: 42px; border-radius: 21px; clip: true;
            x: parent.width - self.width; y: (parent.height - self.height) / 2;
            background: Theme.brand.with-alpha(0.22);
            border-width: 2px; border-color: Surface.hairline;
            av := TouchArea { mouse-cursor: pointer; clicked => { root.open-profile(); } }
            if root.avatar-image.width > 0: Image { source: root.avatar-image; image-fit: cover;
                width: 100%; height: 100%; }
            if root.avatar-image.width == 0: AppIcon { source: Icons.user; tint: Theme.brand;
                width: 18px; height: 18px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
    }

    // ── Left column ─────────────────────────────────────────────────────────
    Rectangle {
        x: root.pad; y: root.head-h; width: root.col-w;
        height: root.height - root.head-h - root.pad;
        background: transparent;
        clip: true;
        csv := ScrollView {
            width: 100%; height: 100%;
            // Every page opens at the top (ui-scroll-start-top).
            viewport-y: 0px;
            VerticalLayout {
                width: csv.visible-width;
                spacing: root.gap; alignment: start;

                // ── Section keys ────────────────────────────────────────────
                if root.keys > 0: HorizontalLayout {
                    height: 62px; spacing: 8px; alignment: start;
                    if root.hc-photos: SectionChip {
                        width: root.key-w; name: "Photos"; icon: Icons.image;
                        accent: Theme.sec-photos; count: root.stats.photos + " items";
                        clicked => { root.open-section("photos"); } }
                    if root.hc-videos: SectionChip {
                        width: root.key-w; name: "Videos"; icon: Icons.film;
                        accent: Theme.sec-videos; count: root.stats.videos + " items";
                        clicked => { root.open-section("videos"); } }
                    if root.hc-music: SectionChip {
                        width: root.key-w; name: "Music"; icon: Icons.music;
                        accent: Theme.sec-music; count: root.stats.songs + " songs";
                        clicked => { root.open-section("music"); } }
                    if root.hc-books: SectionChip {
                        width: root.key-w; name: "Books"; icon: Icons.book-open;
                        accent: Theme.sec-books; count: root.stats.books + " books";
                        clicked => { root.open-section("books"); } }
                    if root.hc-cloud: SectionChip {
                        width: root.key-w; name: "Cloud"; icon: Icons.cloud;
                        accent: Theme.sec-cloud;
                        count: root.stats.cloud-remotes + " services";
                        clicked => { root.open-section("cloud"); } }
                    if root.hc-tools: SectionChip {
                        width: root.key-w; name: "Tools"; icon: Icons.wrench;
                        accent: Theme.sec-tools;
                        count: root.stats.tools-note == "" ? "utilities" : root.stats.tools-note;
                        clicked => { root.open-section("tools"); } }
                    if root.hc-transfer: SectionChip {
                        width: root.key-w; name: "Transfer"; icon: Icons.share;
                        accent: Theme.sec-transfer;
                        count: root.transfer-inbox == "" ? "local network" : "inbox set";
                        clicked => { root.open-section("transfer"); } }
                    if root.hc-finances: SectionChip {
                        width: root.key-w; name: "Finances"; icon: Icons.wallet;
                        accent: Theme.sec-finances;
                        count: root.fin-month == "" ? "track & manage" : root.fin-month;
                        clicked => { root.open-section("finances"); } }
                }

                // ── Continue where you left off ─────────────────────────────
                if root.hc-continue: DeckCard {
                    height: root.continue-rows.length == 0 ? 118px : 232px;
                    VerticalLayout {
                        padding: 14px; spacing: 10px;
                        DeckCap {
                            title: "Continue where you left off";
                            sub: root.continue-rows.length == 0 ? ""
                                : root.continue-rows.length + " in progress";
                            icon: Icons.play; accent: Theme.brand;
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.continue-rows.length == 0: Text {
                            text: "Nothing half-finished. Start a film, a book or an episode and it "
                                + "waits for you here.";
                            color: Theme.text-dim; font-size: 11.5px; wrap: word-wrap;
                        }
                        if root.continue-rows.length > 0: HorizontalLayout {
                            spacing: 10px; alignment: start;
                            for r[i] in root.continue-rows: Rectangle {
                                // Zero-width past the fourth slot: a repeater with an
                                // `if` inside is the slint#6426 shape.
                                width: i < root.res-n ? root.res-w : 0px;
                                horizontal-stretch: 0;
                                background: transparent;
                                clip: true;
                                ResumeTile {
                                    width: root.res-w; height: 100%;
                                    item: r; accent: root.accent-of(r.kind);
                                    clicked => { root.continue-open(r); }
                                }
                            }
                        }
                    }
                }

                // ── Recently added ──────────────────────────────────────────
                if root.hc-library: DeckCard {
                    height: 168px;
                    VerticalLayout {
                        padding: 14px; spacing: 10px;
                        DeckCap {
                            title: "Recently Added"; icon: Icons.sparkles; accent: Theme.sec-photos;
                            sub: root.ra-total + " items in the library";
                            Rectangle { width: 10px; horizontal-stretch: 0; }
                            DeckChip { label: "All"; active: root.ra == "all";
                                y: (parent.height - self.height) / 2;
                                clicked => { root.ra = "all"; } }
                            DeckChip { label: "Photos"; active: root.ra == "photos";
                                y: (parent.height - self.height) / 2;
                                clicked => { root.ra = "photos"; } }
                            DeckChip { label: "Videos"; active: root.ra == "videos";
                                y: (parent.height - self.height) / 2;
                                clicked => { root.ra = "videos"; } }
                            DeckChip { label: "Books"; active: root.ra == "books";
                                y: (parent.height - self.height) / 2;
                                clicked => { root.ra = "books"; } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 0; alignment: start;
                            // Three feeds in one strip. Each cell carries its own
                            // trailing gap so a hidden cell leaves no ghost spacing.
                            for p[i] in root.recent-photos: Rectangle {
                                property <bool> show: root.ra == "photos" ? i < 6
                                    : (root.ra == "all" && i < 3);
                                width: self.show ? root.thumb-w + 10px : 0px;
                                horizontal-stretch: 0;
                                background: transparent;
                                clip: true;
                                Rectangle {
                                    width: root.thumb-w; height: 100%;
                                    border-radius: Surface.r(12px); clip: true;
                                    background: Theme.sec-photos.with-alpha(0.18);
                                    Image { source: p; image-fit: cover; width: 100%; height: 100%; }
                                    TouchArea { mouse-cursor: pointer;
                                        clicked => { root.open-photo-item(i); } }
                                }
                            }
                            for v[i] in root.recent-videos: Rectangle {
                                property <bool> show: root.ra == "videos" ? i < 6
                                    : (root.ra == "all" && i < 2);
                                width: self.show ? root.thumb-w + 10px : 0px;
                                horizontal-stretch: 0;
                                background: transparent;
                                clip: true;
                                Rectangle {
                                    width: root.thumb-w; height: 100%;
                                    border-radius: Surface.r(12px); clip: true;
                                    background: Theme.sec-videos.with-alpha(0.18);
                                    Image { source: v; image-fit: cover; width: 100%; height: 100%; }
                                    TouchArea { mouse-cursor: pointer;
                                        clicked => { root.open-video-item(i); } }
                                }
                            }
                            for b[i] in root.book-covers: Rectangle {
                                property <bool> show: root.ra == "books" ? i < 6
                                    : (root.ra == "all" && i < 1);
                                width: self.show ? root.thumb-w + 10px : 0px;
                                horizontal-stretch: 0;
                                background: transparent;
                                clip: true;
                                Rectangle {
                                    width: root.thumb-w; height: 100%;
                                    border-radius: Surface.r(12px); clip: true;
                                    background: Theme.sec-books.with-alpha(0.18);
                                    Image { source: b; image-fit: cover; width: 100%; height: 100%; }
                                    TouchArea { mouse-cursor: pointer;
                                        clicked => { root.open-book-item(i); } }
                                }
                            }
                            // The rest of the library, as a door rather than a number.
                            Rectangle {
                                width: root.ra-total > root.ra-shown ? 132px : 0px;
                                horizontal-stretch: 0;
                                border-radius: Surface.r(12px);
                                clip: true;
                                background: mt.has-hover ? Theme.glass-strong : Theme.glass;
                                border-width: 1px; border-color: Theme.glass-border;
                                animate background { duration: 120ms; easing: ease-out; }
                                mt := TouchArea { mouse-cursor: pointer;
                                    clicked => { root.open-section(root.ra == "videos" ? "videos"
                                        : root.ra == "books" ? "books" : "photos"); } }
                                VerticalLayout {
                                    alignment: center; spacing: 1px;
                                    Text { text: "+" + Math.max(0, root.ra-total - root.ra-shown);
                                        color: Theme.brand; font-size: 17px; font-weight: 700;
                                        horizontal-alignment: center; }
                                    Text { text: "More"; color: Theme.text-dim; font-size: 10px;
                                        horizontal-alignment: center; }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                // ── Your hub ────────────────────────────────────────────────
                Text { text: "Your Hub"; color: Theme.text; font-size: 15px; font-weight: 700;
                    height: 22px; }
                HorizontalLayout {
                    height: 214px; spacing: root.gap; alignment: start;

                    // Cloud
                    if root.hc-cloud: DeckCard {
                        width: root.hub-w; horizontal-stretch: 0;
                        VerticalLayout {
                            padding: 13px; spacing: 8px;
                            DeckCap { title: "Cloud Services"; icon: Icons.cloud;
                                accent: Theme.sec-cloud;
                                sub: root.stats.cloud-remotes + " connected";
                                Rectangle { horizontal-stretch: 1; } }
                            VerticalLayout {
                                spacing: 4px; vertical-stretch: 1;
                                for r[i] in root.cloud-remotes: Rectangle {
                                    height: i < 3 ? 28px : 0px;
                                    border-radius: Surface.r(8px);
                                    background: rt.has-hover ? Theme.glass : transparent;
                                    clip: true;
                                    rt := TouchArea { mouse-cursor: pointer;
                                        clicked => { root.open-remote(r.name); } }
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 6px; spacing: 7px;
                                        Rectangle { width: 6px; height: 6px; border-radius: 3px;
                                            horizontal-stretch: 0;
                                            y: (parent.height - self.height) / 2;
                                            background: Theme.sec-cloud; }
                                        Text { text: r.name; color: Theme.text; font-size: 11px;
                                            font-weight: 600; vertical-alignment: center;
                                            overflow: elide; horizontal-stretch: 1; }
                                        Text { text: r.usage == "" ? r.backend : r.usage;
                                            color: Theme.text-dim; font-size: 10px;
                                            vertical-alignment: center; horizontal-stretch: 0; }
                                    }
                                }
                                if root.cloud-remotes.length == 0: Text {
                                    text: "No remotes yet. Connect one and it shows up here.";
                                    color: Theme.text-dim; font-size: 10.5px; wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                            DeckFoot { label: "Manage Cloud"; accent: Theme.sec-cloud;
                                clicked => { root.open-section("cloud"); } }
                        }
                    }

                    // Transfer
                    if root.hc-transfer: DeckCard {
                        width: root.hub-w; horizontal-stretch: 0;
                        VerticalLayout {
                            padding: 13px; spacing: 8px;
                            DeckCap { title: "Transfer Center"; icon: Icons.share;
                                accent: Theme.sec-transfer; sub: "local network";
                                Rectangle { horizontal-stretch: 1; } }
                            VerticalLayout {
                                spacing: 6px; vertical-stretch: 1;
                                Text {
                                    text: root.transfer-inbox == ""
                                        ? "Inbox not set yet — pick a folder when you first receive."
                                        : "Received files land in " + root.transfer-inbox;
                                    color: Theme.text-dim; font-size: 10.5px; wrap: word-wrap;
                                }
                                if root.transfer-note != "": Text {
                                    text: root.transfer-note; color: Theme.text; font-size: 11px;
                                    wrap: word-wrap;
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                            Rectangle {
                                height: 32px; border-radius: Surface.r(9px);
                                background: @linear-gradient(140deg, Theme.transfer-accent,
                                    Theme.transfer-accent-2);
                                sh := TouchArea { mouse-cursor: pointer;
                                    clicked => { root.start-sharing(); } }
                                HorizontalLayout {
                                    spacing: 7px; alignment: center;
                                    AppIcon { source: Icons.zap; tint: #231000;
                                        width: 13px; height: 13px;
                                        y: (parent.height - self.height) / 2; }
                                    Text { text: "Start sharing"; color: #231000; font-size: 11px;
                                        font-weight: 700; vertical-alignment: center; }
                                }
                            }
                            DeckFoot { label: "View All Transfers"; accent: Theme.sec-transfer;
                                clicked => { root.open-section("transfer"); } }
                        }
                    }

                    // Finances
                    if root.hc-finances: DeckCard {
                        width: root.hub-w; horizontal-stretch: 0;
                        VerticalLayout {
                            padding: 13px; spacing: 8px;
                            DeckCap { title: "Finances"; icon: Icons.wallet;
                                accent: Theme.sec-finances;
                                sub: root.fin-month == "" ? "this month" : root.fin-month;
                                Rectangle { horizontal-stretch: 1; } }
                            HorizontalLayout {
                                height: 40px; spacing: 10px;
                                VerticalLayout {
                                    alignment: center; spacing: 1px; horizontal-stretch: 1;
                                    Text { text: "Expenses"; color: Theme.text-dim;
                                        font-size: 9.5px; }
                                    Text { text: root.fin-spent == "" ? "—" : root.fin-spent;
                                        color: root.fin-late ? Theme.error : Theme.text;
                                        font-size: 15px; font-weight: 700; overflow: elide; }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 1px; horizontal-stretch: 1;
                                    Text { text: "Income"; color: Theme.text-dim; font-size: 9.5px; }
                                    Text { text: root.fin-income == "" ? "—" : root.fin-income;
                                        color: Theme.text; font-size: 15px; font-weight: 700;
                                        overflow: elide; }
                                }
                            }
                            // The year in bars — the last one is this month. The
                            // strip owns a fixed height: bars sized off `parent.height`
                            // inside a stretching layout are a binding loop.
                            Rectangle {
                                vertical-stretch: 1; background: transparent;
                                HorizontalLayout {
                                    height: 58px; width: 100%; spacing: 3px;
                                    y: parent.height - self.height;
                                    for m[i] in root.fin-months: Rectangle {
                                        border-radius: 2px;
                                        y: parent.height - self.height;
                                        height: Math.max(2px, 58px * Math.max(0.05, m));
                                        background: i == root.fin-months.length - 1
                                            ? Theme.sec-finances
                                            : Theme.sec-finances.with-alpha(0.34);
                                    }
                                }
                            }
                            DeckFoot { label: "Open Finances"; accent: Theme.sec-finances;
                                clicked => { root.open-section("finances"); } }
                        }
                    }

                    // Tools
                    if root.hc-tools: DeckCard {
                        width: root.hub-w; horizontal-stretch: 0;
                        VerticalLayout {
                            padding: 13px; spacing: 8px;
                            DeckCap { title: "Tools & Utilities"; icon: Icons.wrench;
                                accent: Theme.sec-tools;
                                sub: root.stats.tools-note == "" ? "every converter"
                                    : root.stats.tools-note;
                                Rectangle { horizontal-stretch: 1; } }
                            // One representative op per category, 3×2, like the
                            // Tools card on Classic. The sixth disc is the door.
                            VerticalLayout {
                                spacing: 8px; vertical-stretch: 1; alignment: center;
                                HorizontalLayout {
                                    height: 38px; spacing: 8px; alignment: center;
                                    ToolDisc { icon: Icons.folder;
                                        clicked => { root.open-tool("fileops"); } }
                                    ToolDisc { icon: Icons.film;
                                        clicked => { root.open-tool("video"); } }
                                    ToolDisc { icon: Icons.music;
                                        clicked => { root.open-tool("audio"); } }
                                }
                                HorizontalLayout {
                                    height: 38px; spacing: 8px; alignment: center;
                                    ToolDisc { icon: Icons.image;
                                        clicked => { root.open-tool("photo"); } }
                                    ToolDisc { icon: Icons.message-circle;
                                        clicked => { root.open-tool("subs"); } }
                                    ToolDisc { icon: Icons.layout-grid;
                                        clicked => { root.open-section("tools"); } }
                                }
                            }
                            DeckFoot { label: "Explore Tools"; accent: Theme.sec-tools;
                                clicked => { root.open-section("tools"); } }
                        }
                    }

                    // Status — derived from what Home already knows, not invented.
                    DeckCard {
                        width: root.hub-w; horizontal-stretch: 0;
                        VerticalLayout {
                            padding: 13px; spacing: 8px;
                            DeckCap { title: "System Status"; icon: Icons.shield;
                                accent: Theme.sec-status; sub: "what the app is doing";
                                Rectangle { horizontal-stretch: 1; } }
                            HorizontalLayout {
                                height: 30px; spacing: 7px;
                                Rectangle { width: 8px; height: 8px; border-radius: 4px;
                                    horizontal-stretch: 0;
                                    y: (parent.height - self.height) / 2;
                                    background: root.fin-late ? Theme.warn
                                        : (root.scanning ? Theme.sec-status : Theme.ok); }
                                Text {
                                    text: root.fin-late ? "Something is overdue"
                                        : (root.scanning ? "Working in the background"
                                                         : "Everything looks good");
                                    color: Theme.text; font-size: 11.5px; font-weight: 600;
                                    vertical-alignment: center; overflow: elide;
                                }
                            }
                            VerticalLayout {
                                spacing: 3px; vertical-stretch: 1;
                                for s in [
                                    { label: "Library",
                                      value: root.stats.photos-scan == "" ? "Indexed"
                                            : root.stats.photos-scan },
                                    { label: "Cloud",
                                      value: root.stats.cloud-remotes == 0 ? "None"
                                            : root.stats.cloud-remotes + " linked" },
                                    { label: "Inbox",
                                      value: root.transfer-inbox == "" ? "Not set" : "Ready" },
                                ]: HorizontalLayout {
                                    height: 22px; spacing: 6px;
                                    Text { text: s.label; color: Theme.text-dim; font-size: 10.5px;
                                        vertical-alignment: center; horizontal-stretch: 1; }
                                    Text { text: s.value; color: Theme.text; font-size: 10.5px;
                                        font-weight: 600; vertical-alignment: center;
                                        overflow: elide; horizontal-stretch: 0; }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                            DeckFoot { label: "View Status"; accent: Theme.sec-status;
                                clicked => { root.open-status(); } }
                        }
                    }
                }
                Rectangle { height: 8px; }
            }
        }
    }

    // ── Right rail ──────────────────────────────────────────────────────────
    if root.rail-n > 0: Rectangle {
        x: root.width - root.pad - root.rail-w;
        y: root.head-h; width: root.rail-w;
        height: root.height - root.head-h - root.pad;
        background: transparent;
        clip: true;
        rsv := ScrollView {
            width: 100%; height: 100%;
            viewport-y: 0px;
            VerticalLayout {
                width: rsv.visible-width;
                spacing: root.gap; alignment: start;

                // NOW PLAYING
                if root.hc-player: DeckCard {
                    height: 392px;
                    VerticalLayout {
                        padding: 14px; spacing: 11px;
                        DeckCap { title: "Now Playing"; icon: Icons.music; accent: root.np-accent;
                            sub: root.np-title == "" ? "nothing yet" : "";
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 28px; height: 28px; horizontal-stretch: 0;
                                y: (parent.height - self.height) / 2;
                                border-radius: Surface.r(8px);
                                background: zt.has-hover ? Theme.glass-strong : Theme.glass;
                                zt := TouchArea { mouse-cursor: pointer;
                                    clicked => { root.open-zen(); } }
                                AppIcon { source: Icons.waveform; tint: Theme.text-dim;
                                    width: 14px; height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2; }
                            }
                        }
                        // Artwork — square, the biggest thing in the rail.
                        Rectangle {
                            height: 150px; border-radius: Surface.r(14px); clip: true;
                            background: @linear-gradient(150deg, root.np-accent.with-alpha(0.55),
                                root.np-accent.with-alpha(0.18));
                            if root.np-art.width > 0: Image { source: root.np-art;
                                image-fit: cover; width: 100%; height: 100%; }
                            if root.np-art.width == 0: AppIcon { source: Icons.disc;
                                tint: root.np-accent; width: 34px; height: 34px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: root.np-title == "" ? "Nothing playing" : root.np-title;
                                color: Theme.text; font-size: 13px; font-weight: 700;
                                overflow: elide; }
                            Text { text: root.np-sub; color: Theme.text-dim; font-size: 10.5px;
                                overflow: elide; }
                        }
                        // Seek.
                        HorizontalLayout {
                            height: 16px; spacing: 8px;
                            Text { text: root.pos-label; color: Theme.text-dim; font-size: 9.5px;
                                width: 34px; horizontal-stretch: 0; vertical-alignment: center; }
                            Rectangle {
                                height: 4px; border-radius: 2px; horizontal-stretch: 1;
                                y: (parent.height - self.height) / 2;
                                background: Theme.text.with-alpha(0.14);
                                Rectangle {
                                    x: 0; height: 100%; border-radius: 2px;
                                    width: parent.width
                                        * Math.clamp(root.dur > 0 ? root.pos / root.dur : 0, 0.0, 1.0);
                                    background: root.np-accent;
                                }
                                sk := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.seek(root.dur * (self.mouse-x / parent.width));
                                    }
                                }
                            }
                            Text { text: root.dur-label; color: Theme.text-dim; font-size: 9.5px;
                                width: 34px; horizontal-alignment: right; horizontal-stretch: 0;
                                vertical-alignment: center; }
                        }
                        // Transport.
                        HorizontalLayout {
                            height: 40px; spacing: 4px; alignment: space-between;
                            DeckBtn { icon: Icons.shuffle; lit: root.shuffle;
                                accent: root.np-accent;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.toggle-shuffle(); } }
                            DeckBtn { icon: Icons.skip-back; accent: root.np-accent;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.prev(); } }
                            DeckBtn { icon: root.playing ? Icons.pause : Icons.play;
                                primary: true; accent: root.np-accent;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.playpause(); } }
                            DeckBtn { icon: Icons.skip-forward; accent: root.np-accent;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.next(); } }
                            DeckBtn { icon: root.repeat == "one" ? Icons.repeat-1 : Icons.repeat;
                                lit: root.repeat != "off"; accent: root.np-accent;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.cycle-repeat(); } }
                        }
                        // Volume.
                        HorizontalLayout {
                            height: 22px; spacing: 9px;
                            Rectangle {
                                width: 22px; height: 22px; horizontal-stretch: 0;
                                background: transparent;
                                vt := TouchArea { mouse-cursor: pointer;
                                    clicked => { root.toggle-mute(); } }
                                AppIcon { source: root.muted ? Icons.volume-x : Icons.volume;
                                    tint: vt.has-hover ? Theme.text : Theme.text-dim;
                                    width: 14px; height: 14px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2; }
                            }
                            Rectangle {
                                height: 4px; border-radius: 2px; horizontal-stretch: 1;
                                y: (parent.height - self.height) / 2;
                                background: Theme.text.with-alpha(0.14);
                                Rectangle {
                                    x: 0; height: 100%; border-radius: 2px;
                                    width: parent.width
                                        * Math.clamp(root.muted ? 0 : root.volume, 0.0, 1.0);
                                    background: root.np-accent;
                                }
                                vol := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.set-volume(Math.clamp(self.mouse-x / parent.width,
                                            0.0, 1.0));
                                    }
                                }
                            }
                        }
                    }
                }

                // QUICK ACCESS
                if root.hc-quick: DeckCard {
                    height: 146px;
                    VerticalLayout {
                        padding: 14px; spacing: 8px;
                        DeckCap { title: "Quick Access"; icon: Icons.zap; accent: Theme.brand;
                            Rectangle { horizontal-stretch: 1; } }
                        HorizontalLayout {
                            spacing: 4px; vertical-stretch: 1;
                            QuickTile { label: "Stream"; icon: Icons.monitor-play;
                                accent: Theme.sec-videos; clicked => { root.open-stream(); } }
                            QuickTile { label: "Live TV"; icon: Icons.tv;
                                accent: Theme.sec-transfer; clicked => { root.open-livetv(); } }
                            QuickTile { label: "Music D/L"; icon: Icons.download;
                                accent: Theme.sec-music; clicked => { root.open-download(); } }
                            QuickTile { label: "Random Radio"; icon: Icons.radio;
                                accent: Theme.sec-books; clicked => { root.random-radio(); } }
                        }
                    }
                }

                // AT A GLANCE
                if root.hc-finances: DeckCard {
                    height: 218px;
                    VerticalLayout {
                        padding: 14px; spacing: 8px;
                        DeckCap { title: "At a Glance"; icon: Icons.pie-chart;
                            accent: Theme.sec-finances;
                            sub: root.fin-month == "" ? "this month" : root.fin-month;
                            Rectangle { horizontal-stretch: 1; } }
                        for g in [
                            { label: "Expenses", value: root.fin-spent, tint: Theme.sec-finances,
                              icon: Icons.receipt },
                            { label: "Income", value: root.fin-income, tint: Theme.ok,
                              icon: Icons.trending-up },
                            { label: "Liquid", value: root.fin-liquid, tint: Theme.brand,
                              icon: Icons.wallet },
                        ]: Rectangle {
                            height: 46px;
                            border-radius: Surface.r(11px);
                            background: gt.has-hover ? Theme.glass : transparent;
                            gt := TouchArea { mouse-cursor: pointer;
                                clicked => { root.open-section("finances"); } }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 9px;
                                Rectangle {
                                    width: 30px; height: 30px; horizontal-stretch: 0;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Surface.r(9px);
                                    background: g.tint.with-alpha(Theme.dark ? 0.24 : 0.15);
                                    AppIcon { source: g.icon; tint: g.tint;
                                        width: 15px; height: 15px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2; }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 1px; horizontal-stretch: 1;
                                    Text { text: g.label; color: Theme.text-dim; font-size: 9.5px; }
                                    Text { text: g.value == "" ? "—" : g.value; color: Theme.text;
                                        font-size: 13.5px; font-weight: 700; overflow: elide; }
                                }
                                // The same twelve bars as the panel, small.
                                HorizontalLayout {
                                    width: 62px; horizontal-stretch: 0; spacing: 2px;
                                    padding-top: 12px; padding-bottom: 12px;
                                    for m[i] in root.fin-months: Rectangle {
                                        border-radius: 1px;
                                        y: parent.height - self.height;
                                        height: Math.max(2px, 22px * Math.max(0.06, m));
                                        background: i == root.fin-months.length - 1
                                            ? g.tint : g.tint.with-alpha(0.3);
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 8px; }
            }
        }
    }
}
