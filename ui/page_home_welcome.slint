// Home layout 7 of 7 — WELCOME. Spec: docs/home-layouts/07-welcome.md (mockup l4.png).
//
// The front door: a big greeting beside a drawn banner, a bar of the six things
// you launch by name, Continue beside the newest arrivals, the section tiles as
// "My Hub", and the player pinned along the bottom of the page.
//
// Nothing here scrolls — every row's height comes out of the page budget (see
// `free` / `hub-h` / `cont-row-h` / `hero-h`) so it all lands on one screen.
//
// Same data as every other layout — only the composition differs.
import { Theme, Accent } from "tokens.slint";
import { Surface, Rim } from "surface.slint";
import { Icons, AppIcon } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { HomeStats, HomeContinue, HomeChip, HomeBook, HomeQuote } from "page_home.slint";
import { VizView } from "page_music.slint";
import { MusicSongRow, MusicLyricLine } from "music_common.slint";

// ── Panel base ──────────────────────────────────────────────────────────────
component WelCard inherits Rectangle {
    border-radius: Surface.card-radius;
    background: Surface.body(Theme.panel);
    border-width: 1px;
    border-color: Surface.hairline;
    drop-shadow-blur: Surface.card-shadow;
    drop-shadow-color: Surface.shadow-ink;
    drop-shadow-offset-y: Surface.card-shadow-y;
    if Surface.rim: Rim {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        radius: Surface.card-radius - 1px;
    }
    @children
}

// ── Launch shortcut in the top bar ──────────────────────────────────────────
component Launcher inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <color> accent;
    callback clicked();
    background: t.has-hover ? Theme.glass : transparent;
    border-radius: Surface.rr(14px, self.width, self.height);
    animate background { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        spacing: 10px; alignment: center;
        Rectangle {
            width: 34px; height: 34px; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            border-radius: Surface.rr(10px, self.width, self.height);
            background: root.accent.with-alpha(Theme.dark ? 0.24 : 0.14);
            AppIcon { source: root.icon; tint: root.accent; width: 16px; height: 16px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        Text { text: root.label; color: Theme.text; font-size: 12.5px; font-weight: 600;
            vertical-alignment: center; horizontal-stretch: 0; overflow: elide; }
    }
}

// ── My Hub tile ─────────────────────────────────────────────────────────────
// Exported: Cinema's shelf carries the same hub, and two copies of a tile is
// two places to fix the next thing that is wrong with it.
export component HubTile inherits Rectangle {
    in property <string> name;
    in property <string> count;
    in property <image> icon;
    in property <color> accent;
    callback clicked();
    // Light-theme wash multiplier. Focused's tiles sit eight-across on a card and
    // read fine at the base alpha; Cinema shows ONE tile alone in a column, where
    // the same fill looked unpainted — it asks for 1.4.
    in property <float> wash: 1.0;
    horizontal-stretch: 0;
    border-radius: Surface.rr(16px, self.width, self.height);
    background: root.accent.with-alpha(t.has-hover ? (Theme.dark ? 0.28 : 0.18 * root.wash)
                                                   : (Theme.dark ? 0.16 : 0.10 * root.wash));
    border-width: 1px;
    border-color: t.has-hover ? root.accent.with-alpha(0.45) : transparent;
    animate background, border-color { duration: 130ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    // Second inner outline on hover, held off the card's own edge — the tile
    // reads as a button that is armed rather than one that merely lit up.
    Rectangle {
        x: 5px; y: 5px;
        width: parent.width - 10px; height: parent.height - 10px;
        border-radius: Math.max(2px, Surface.rr(16px, self.width, self.height) - 5px);
        background: transparent;
        border-width: t.has-hover ? 2px : 0px;
        border-color: root.accent.with-alpha(0.75);
        animate border-width { duration: 130ms; easing: ease-out; }
    }
    // Double-height tile: the disc rides the top, the label sits on the floor.
    // The disc takes whatever height the page budget leaves over the two lines.
    // Handed in, NOT derived from self.height — sizing a child off the parent's
    // height inside a stretching layout is the binding-loop trap.
    in property <length> disc: 46px;
    // Type scale. Focused's tiles are one of eight in a row and read at 1.0;
    // Cinema shows a single tile in a 300 px column, where the same type left a
    // fat empty band top and bottom. Everything below is sized off this.
    in property <float> text-scale: 1.0;
    // Disc, name and count stacked dead centre.
    VerticalLayout {
        padding-left: 8px; padding-right: 8px;
        padding-top: 10px * root.text-scale; padding-bottom: 10px * root.text-scale;
        spacing: 7px * root.text-scale;
        alignment: center;
        HorizontalLayout {
            alignment: center; height: root.disc; vertical-stretch: 0;
            Rectangle {
                width: root.disc; height: root.disc; horizontal-stretch: 0;
                border-radius: Surface.rr(15px, self.width, self.height);
                // White on every theme — the accent icon is drawn for a light
                // plate, and the dark-theme panel colour swallowed it.
                background: #ffffff;
                AppIcon { source: root.icon; tint: root.accent;
                    width: root.disc * 0.44; height: self.width;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
        }
        Text { text: root.name; color: Theme.text; font-size: 14px * root.text-scale;
            font-weight: 700;
            vertical-stretch: 0; horizontal-alignment: center; overflow: elide; }
        // The count rides its own solid accent pill.
        HorizontalLayout {
            alignment: center; height: 19px * root.text-scale; vertical-stretch: 0;
            Rectangle {
                width: Math.min(parent.width, cnt.preferred-width);
                horizontal-stretch: 0;
                border-radius: 9.5px * root.text-scale;
                background: Surface.tile(root.accent);
                border-width: Surface.clay ? 0px : 1px;
                border-color: root.accent.darker(0.25);
                cnt := HorizontalLayout {
                    padding-left: 9px * root.text-scale; padding-right: 9px * root.text-scale;
                    Text { text: root.count; color: #ffffff; font-size: 10px * root.text-scale;
                        font-weight: 700; vertical-alignment: center;
                        horizontal-alignment: center; overflow: elide; }
                }
            }
        }
    }
}

// ── Hover label ─────────────────────────────────────────────────────────────
// A small accent pill that floats above whatever it is attached to. The width
// hugs the label: a plain Rectangle takes its parent's width and lets the text
// spill out of the pill. Nothing in the bar clips, so it overflows the card.
component WelTip inherits Rectangle {
    in property <string> label;
    in property <color> accent;
    // The host's width, handed in: a component's own root cannot read `parent`,
    // so centring over whatever it labels has to arrive from the outside.
    in property <length> host-w: 0px;
    x: (root.host-w - self.width) / 2;
    y: -27px;
    width: tipt.preferred-width + 16px;
    height: 22px;
    border-radius: 11px;
    background: root.accent;
    drop-shadow-blur: Surface.cast(10px);
    drop-shadow-color: #00000088;
    tipt := Text {
        text: root.label; color: #ffffff;
        font-size: 11px; font-weight: 700;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}

// ── One line of the now-playing block, marqueed when it does not fit ────────
// A long title used to elide to "Ranjha - From Shersh…". It now runs as a true
// marquee: the line travels left at a steady 34px/s and a SECOND copy follows a
// 48px gap behind it, so when the first copy has walked its full span the copy
// is standing exactly where it started and the reset is invisible. No
// back-and-forth, no pause at the ends — one direction, forever.
//
// The loop is an `animate` with `iteration-count: -1`, not an `animation-tick()`
// binding: the tick would repaint every frame for every line, including the
// short ones that never move.
// Exported: Timeline's rail player runs its two lines through the same marquee.
export component WelMarquee inherits Rectangle {
    in property <string> label;
    in property <color> ink;
    in property <length> size;
    in property <int> weight: 700;
    // Rolls only when the line actually overflows its box.
    property <bool> roll: t.preferred-width > self.width;
    // One full cycle = the text plus the gap that separates it from its copy.
    property <length> span: t.preferred-width + 48px;
    clip: true;
    t := Text {
        text: root.label; color: root.ink;
        font-size: root.size; font-weight: root.weight;
        width: self.preferred-width;
        y: (parent.height - self.height) / 2;
        x: root.roll ? -root.span : 0px;
        // Linear, because a marquee that eases is a marquee that stutters at the
        // seam. `iteration-count` is guarded: a line that fits travels 0px, and
        // an infinite loop over a 0s duration would spin the animation driver at
        // frame rate for nothing.
        animate x {
            duration: 1s * (root.span / 34px);
            easing: linear;
            iteration-count: root.roll ? -1 : 1;
        }
    }
    // The chaser. Rides one span behind the original, so it enters from the
    // right exactly as the original leaves — and carries no text at all when
    // the line fits, which is when nothing should be drawn twice.
    Text {
        text: root.roll ? root.label : "";
        color: root.ink; font-size: root.size; font-weight: root.weight;
        width: self.preferred-width;
        y: (parent.height - self.height) / 2;
        x: t.x + root.span;
    }
}

// ── Transport button — always outlined, fills when active or hovered ────────
component WelBtn inherits Rectangle {
    in property <image> icon;
    in property <string> tip;            // hover label ("" = none)
    in property <bool> primary: false;   // play/pause — filled at rest
    in property <bool> lit: false;       // shuffle on / repeat on
    in property <color> accent;
    in property <color> ink;
    callback clicked();
    property <bool> on: root.primary || root.lit || t.has-hover;
    width: root.primary ? 48px : 32px;
    height: self.width;
    horizontal-stretch: 0;
    border-radius: self.width / 2;
    background: root.on ? root.accent : transparent;
    border-width: 1.5px;
    border-color: root.on ? root.accent : root.ink.with-alpha(0.45);
    animate background, border-color { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    AppIcon {
        source: root.icon;
        tint: root.on ? #ffffff : root.ink;
        width: root.primary ? 19px : 14px; height: self.width;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
    if root.tip != "" && t.has-hover: WelTip { label: root.tip; accent: root.accent;
        host-w: root.width; }
}

// ── Hero quote shelf ───────────────────────────────────────────────────────
// Two lines — the quotation, then its author — after a quote mark on the left.
// Shown only when the visualizer is not, so the hero row is never an empty band.
component HeroQuote inherits Rectangle {
    in property <HomeQuote> quote;
    background: transparent;
    property <length> textx: 26px;
    property <length> textw: Math.max(0px, self.width - self.textx - 8px);
    AppIcon {
        source: Icons.quote; tint: Theme.text-dim.with-alpha(0.7);
        width: 16px; height: 16px;
        x: 0px; y: Math.max(0px, (parent.height - 34px) / 2);
    }
    // No explicit height on either line — a box shorter than the line's own
    // height blanks the text (what the Continue rows were bitten by).
    Text {
        x: root.textx; y: Math.max(0px, (parent.height - 34px) / 2);
        width: root.textw;
        text: root.quote.text; color: Theme.text;
        font-size: 13px; font-weight: 500; overflow: elide;
    }
    Text {
        x: root.textx; y: Math.max(0px, (parent.height - 34px) / 2) + 19px;
        width: root.textw;
        text: root.quote.author == "" ? "" : "— " + root.quote.author;
        color: Theme.text-dim; font-size: 11px; font-weight: 600; overflow: elide;
    }
}

// ── Status key ─────────────────────────────────────────────────────────────
// The expanded sidebar key, rebuilt to hero scale: the same three health
// colours (busy is green — a scan running is the app working, not a warning),
// the same breathing lamp, the same tint-the-whole-key rule. Two differences,
// both because this one does not leave the app: single click, not double, and
// no link mark — it opens the in-window Status page (Settings › Status), not
// the loopback dashboard in a browser.
component HeroStatus inherits Rectangle {
    in property <string> level: "unknown";
    in property <string> note: "Starting…";
    callback clicked();

    property <color> lamp:
        root.level == "ok"      ? #22c55e :
        root.level == "busy"    ? #10b981 :
        root.level == "problem" ? #ef4444 :
                                  Theme.sec-settings;
    // A pulse means "something is happening": idle and OK are steady, so the
    // page stops repainting once the app settles.
    property <bool> pulse: true;
    Timer {
        interval: 900ms;
        running: root.level == "busy" || root.level == "problem";
        triggered => { root.pulse = !root.pulse; }
    }
    changed level => { root.pulse = true; }

    border-radius: Surface.btn-radius;
    background: root.lamp.with-alpha(touch.has-hover ? 0.16 : 0.09);
    border-width: 1px;
    border-color: root.lamp.with-alpha(touch.has-hover ? 0.62 : 0.38);
    animate background, border-color { duration: 140ms; easing: ease-out; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }

    // Lamp on the right edge, centred against the two text lines rather than
    // pinned to the corner the sidebar key uses — this key is 40px tall, not a
    // 44px rail row, and a corner lamp read as floating above the text. It
    // breathes on its own timer with a fixed glow ring: the fill fades, the
    // ring does not, so it reads as a lamp turning up and down rather than as
    // something appearing.
    Rectangle {
        x: parent.width - self.width - 12px;
        y: (parent.height - self.height) / 2;
        width: 9px; height: 9px; border-radius: 4.5px;
        background: root.lamp.with-alpha(root.pulse ? 1.0 : 0.25);
        animate background { duration: 850ms; easing: ease-in-out; }
        Rectangle {
            x: -3px; y: -3px;
            width: parent.width + 6px; height: parent.height + 6px;
            border-radius: self.width / 2;
            background: transparent;
            border-width: 1px; border-color: root.lamp.with-alpha(0.3);
        }
    }
    VerticalLayout {
        x: 11px; width: parent.width - 11px - 24px;
        y: 0px; height: parent.height;
        alignment: center; spacing: 1px;
        Text { text: "Status"; color: Theme.text; font-size: 12px; font-weight: 700; }
        // Elided, not the rail's marquee: this key has the hero's width to
        // work with, and a scrolling line under the greeting would compete
        // with the greeting.
        Text { text: root.note; color: Theme.text-dim; font-size: 10px; overflow: elide; }
    }
}

// ── Recently Added tiles ───────────────────────────────────────────────────
// All three take their box from the parent (x / y / width / height) and own
// only what is inside it. The repeaters that place them collapse the overflow
// to a zero-sized box rather than wrapping the tile in an `if` — an `if` inside
// a repeater is the "accessing deleted parent" crash (slint#6426).

// Photos and Videos: one cover-fitted thumb, lit on hover.
component RaTile inherits Rectangle {
    in property <image> art;
    in property <color> accent;
    in property <bool> play: false;      // videos get the play affordance
    callback clicked();
    border-radius: Surface.rr(10px, self.width, self.height);
    background: root.accent.with-alpha(0.14);
    clip: true;
    border-width: t.has-hover ? 2px : 0px;
    border-color: root.accent;
    animate border-width { duration: 120ms; easing: ease-out; }
    if root.art.width > 0: Image {
        source: root.art; image-fit: cover; width: 100%; height: 100%;
    }
    Rectangle {
        width: 100%; height: 100%; background: #00000059;
        opacity: t.has-hover ? 1 : 0;
        animate opacity { duration: 120ms; easing: ease-out; }
    }
    if root.play: Rectangle {
        width: 30px; height: 30px; border-radius: 15px;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        background: root.accent;
        opacity: t.has-hover ? 1 : 0.82;
        AppIcon { source: Icons.play; tint: #ffffff; width: 13px; height: 13px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Music: My Music's song card, verbatim in style — square thumb, 10px gap,
// one centred title line at 13/600. No artist line: the Songs grid does not
// carry one either, and the point is that the two read as the same card.
component RaSong inherits Rectangle {
    in property <MusicSongRow> song;
    in property <bool> now: false;
    callback clicked();
    // Square, as wide as the cell allows once the title line is paid for.
    property <length> disc: Math.max(0px, Math.min(root.width, root.height - 26px));
    background: transparent;
    Rectangle {
        width: root.disc; height: root.disc;
        x: (parent.width - self.width) / 2; y: 0px;
        border-radius: Surface.rr(10px, self.width, self.height); clip: true;
        background: Theme.sec-music.with-alpha(0.14);
        // Playing wins over hover on the border — you can hover a different
        // card while this is the one you are hearing.
        border-width: (t.has-hover || root.now) ? 2px : 0px;
        border-color: root.now ? #22c55e : #ec4899;
        drop-shadow-blur: t.has-hover ? 28px : (root.now ? 18px : 0px);
        drop-shadow-color: root.now ? #22c55eaa : #ec4899aa;
        animate drop-shadow-blur, border-width { duration: 120ms; easing: ease-out; }
        // Hover zoom: Slint has no transform, so the image grows past its frame
        // and re-centres inside the clip. The frame never resizes, so no layout
        // and no TouchArea moves — which is what would oscillate at the edge.
        if root.song.thumb.width > 0: Image {
            source: root.song.thumb; image-fit: cover;
            property <length> zoom: t.has-hover ? 10px : 0px;
            width: parent.width + self.zoom; height: parent.height + self.zoom;
            x: -self.zoom / 2; y: -self.zoom / 2;
            animate width, height, x, y { duration: 160ms; easing: ease-out; }
        }
        if root.song.thumb.width == 0: AppIcon {
            source: Icons.music; tint: Theme.sec-music.with-alpha(0.7);
            width: 20px; height: 20px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        }
        Rectangle {
            width: 100%; height: 100%; background: #00000066;
            opacity: t.has-hover ? 1 : 0;
            animate opacity { duration: 120ms; easing: ease-out; }
        }
        Rectangle {
            width: 36px; height: 36px; border-radius: 18px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #ec4899;
            opacity: t.has-hover ? 1 : 0;
            animate opacity { duration: 120ms; easing: ease-out; }
            AppIcon { source: Icons.play; tint: #ffffff; width: 14px; height: 14px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
    }
    // No explicit height — a box shorter than the line's own height blanks the
    // text outright (what the Continue rows were bitten by).
    Text {
        x: 0px; y: root.disc + 10px; width: root.width;
        text: root.song.title; color: root.now ? #ec4899 : Theme.text;
        font-size: 13px; font-weight: 600;
        horizontal-alignment: center; overflow: elide;
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Books: the baked 3D cover — the same `_book5` rendition the Books grid and
// the Continue Reading card draw — with Classic's shelf pull on hover. The
// glow is the book's OWN hue (what the Books section outlines everything with),
// not the section accent, so four covers hovered in turn read as four books.
// The lift lives inside the tile so the parent only has to place it.
component RaBook inherits Rectangle {
    in property <HomeBook> book;
    callback clicked();
    // Bake first, flat art as the fallback while the prebake sweep catches up.
    property <image> art: root.book.book.width > 0 ? root.book.book : root.book.cover;
    background: transparent;
    Rectangle {
        width: 100%; height: Math.max(0px, parent.height - 10px);
        y: t.has-hover ? 0px : 10px;
        animate y { duration: 160ms; easing: ease-out; }
        border-radius: Surface.rr(10px, self.width, self.height);
        background: t.has-hover ? root.book.hue.with-alpha(0.10) : transparent;
        border-width: t.has-hover ? 1.5px : 0px;
        border-color: root.book.hue.with-alpha(0.55);
        // The bake carries its own page edges and spine, so `contain` — a
        // `cover` crop would cut the mockup's own geometry off.
        drop-shadow-blur: t.has-hover ? 26px : 0px;
        drop-shadow-color: root.book.hue.with-alpha(0.55);
        drop-shadow-offset-y: t.has-hover ? 8px : 0px;
        animate background, border-color, drop-shadow-blur { duration: 160ms; easing: ease-out; }
        if root.art.width > 0: Image {
            source: root.art; image-fit: contain;
            width: parent.width - 8px; height: parent.height - 8px;
            x: 4px; y: 4px;
        }
        if root.art.width == 0: AppIcon {
            source: Icons.book-open; tint: Theme.sec-books.with-alpha(0.7);
            width: 20px; height: 20px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        }
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component HomeWelcome inherits Rectangle {
    // ── Header / hero ───────────────────────────────────────────────────────
    in property <string> greeting: "Welcome";
    in property <string> date-line: "";
    in property <string> library-line: "";
    in property <image> avatar-image;
    // No logo-choice / festival here: this layout has no wordmark to brand.
    // ── Body ────────────────────────────────────────────────────────────────
    in property <HomeStats> stats;
    in property <[HomeContinue]> continue-rows: [];
    in property <[image]> recent-photos: [];
    in property <[image]> recent-videos: [];
    in property <[HomeBook]> recent-books: [];
    // Already shuffled in Rust — the block below just walks it a minute at a time.
    in property <[HomeQuote]> quotes: [];
    // Greeting emoji. The list lives here rather than in Rust because the
    // rotation is a UI clock: one every two minutes, walked by `emoji-idx`.
    property <[string]> greet-emojis: ["👋", "😊", "🌞", "✨", "🎉", "🌻", "😄", "🌈", "🍀", "💫"];
    property <int> emoji-idx: 0;
    in property <string> transfer-line: "";   // "192.168.1.5:8420"
    in property <int> tool-count: 0;
    // App health, for the hero's Status key. Same two props the sidebar key reads.
    in property <string> status-level: "unknown";
    in property <string> status-note: "Starting…";
    in property <[MusicSongRow]> recent-songs: [];
    in property <string> fin-month: "";
    // ── Player ──────────────────────────────────────────────────────────────
    in property <string> np-title: "";
    in property <string> np-sub: "";
    in property <image> np-art;
    in property <color> np-accent: Theme.sec-music;
    in property <bool> playing: false;
    in property <float> pos: 0;
    in property <float> dur: 1;
    in property <string> pos-label: "";
    in property <string> dur-label: "";
    in property <bool> shuffle: false;
    in property <string> repeat: "off";
    in property <bool> muted: false;
    in property <float> volume: 80;
    in property <[float]> vis-bars: [];
    // Header visualizer + synced lyrics, same feed the Classic header rides.
    in property <int> vis-style: 4;
    in property <[MusicLyricLine]> lyrics-rows: [];
    in property <int> lyrics-active: -1;
    in property <string> player-mode: "music";
    in property <bool> yt-now-video: false;
    // Queue drop-up + the mini player the artwork opens.
    in property <[MusicSongRow]> queue-rows: [];
    in property <int> np-index: -1;
    property <bool> header-viz: true;    // the search box used to live here — the spectrum is the point now
    property <bool> viz-lyrics: true;
    property <bool> viz-allowed: root.playing
        && (root.player-mode == "radio" || (root.player-mode == "music" && !root.yt-now-video));
    property <bool> viz-lyrics-ok: root.player-mode == "music" && !root.yt-now-video;
    // ── Card visibility ─────────────────────────────────────────────────────
    in property <bool> hc-hero: true;
    in property <bool> hc-quick: true;
    in property <bool> hc-continue: true;
    in property <bool> hc-library: true;      // Recently Added grid
    in property <bool> hc-player: true;       // the bottom bar
    in property <bool> hc-photos: true;
    in property <bool> hc-videos: true;
    in property <bool> hc-music: true;
    in property <bool> hc-books: true;
    in property <bool> hc-cloud: true;
    in property <bool> hc-tools: true;
    in property <bool> hc-transfer: true;
    in property <bool> hc-finances: true;

    callback open-section(string);
    callback open-profile();
    /// Settings › Status — the in-window page, not the browser dashboard.
    callback open-status();
    callback open-photo-item(int);
    callback open-video-item(int);
    callback open-book-detail(int);   // book id → the Books detail panel, not the reader
    callback continue-open(HomeContinue);
    callback continue-filter(string);
    callback open-youtube();
    callback open-stream();
    callback open-livetv();
    callback open-download();
    callback open-genesis();
    callback random-radio();
    callback playpause();
    callback next();
    callback prev();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-zen();
    callback open-mini();
    callback play-queue(int);
    // Home never asked the backend to build the Up-next list — only the Music
    // section's panels did — so the drop-up was empty on a fresh session and
    // stale after the track advanced. Ask every time it opens.
    callback refresh-queue();
    callback play-song(int);
    callback open-now-album();
    callback open-now-artist();
    callback set-vis-style(int);

    // ── Geometry ────────────────────────────────────────────────────────────
    property <length> pad: 26px;
    // seconds → m:ss, for the value that rides the cursor over the seek bar.
    pure function fmt(t: float) -> string {
        return Math.floor(t / 60) + ":" + (Math.mod(t, 60) < 10 ? "0" : "")
            + Math.floor(Math.mod(t, 60));
    }
    property <length> gap: 14px;
    // ── The stacked player bar ──────────────────────────────────────────────
    // With a track loaded the bar stands at full height. With nothing loaded it
    // sinks until only 30% of the card is above the page floor — a stub you can
    // see is there — and pops back out while the pointer is on it. Every other
    // row on the page sizes off `free`, which sizes off `bar-h`, so the page
    // takes the reclaimed height back on its own and gives it up again on hover.
    // Idle = nothing loaded, or paused long enough to stop being the thing you
    // are doing. A pause of a few seconds is still listening; 15 seconds of it
    // is not, and the bar goes back to being a stub like it never had a track.
    property <bool> pause-sunk: false;
    property <bool> bar-idle: root.np-title == "" || root.pause-sunk;
    property <bool> bar-peek: false;             // pointer is on the stub
    // Held open for 15s after the last time the pointer entered or left it.
    // Without the hold the bar closes the instant the pointer slips off an
    // edge — and since closing moves the page under the pointer, that lands it
    // back on the bar and reopens it. The hold is what stops the flicker.
    property <bool> bar-hold: false;
    property <bool> bar-open: !root.bar-idle || root.bar-peek || root.bar-hold;
    // The card's own height never changes — 67px, the launch bar's height to
    // the pixel, so the two full-width shelves at the foot of the page read as
    // one pair. What moves is where it stands: `bar-h` is how much of it is
    // above the window floor, and the card hangs off the bottom edge by the
    // rest. Animating the STANDING HEIGHT rather than the card height is what
    // makes it slide up out of the floor instead of growing in place — and it
    // keeps the 50px artwork inside a card that is always tall enough for it.
    // Every other row sizes off `free`, which sizes off `bar-h`, so the page
    // opens up under the same tween for free.
    property <length> card-h: 67px;
    property <length> stub-h: 26px;      // the sliver left showing when sunk
    property <length> bar-h: !root.hc-player ? 0px
        : (root.bar-open ? root.card-h + 14px : root.stub-h);
    animate bar-h { duration: 420ms; easing: ease-in-out; }
    // The bar carries its own ink so it reads on every theme: dark ink over the
    // artwork's accent on light themes, white over pink on dark ones.
    property <color> pl-ink: Theme.dark ? #ffffff : #17121f;
    property <color> pl-dim: Theme.dark ? #ffffffb0 : #17121f99;
    property <color> pl-accent: Theme.dark ? Theme.sec-music : root.np-accent;
    // music-volume is mpv's 0–130 percent, NOT a 0–1 fraction. The track spans
    // 0–100; anything above (the boost range) simply pins the fill full.
    property <float> vol-drag: -1;       // ≥0 while the knob is under the mouse
    property <bool> vol-dirty: false;
    property <float> vol-frac: root.vol-drag >= 0 ? root.vol-drag
        : (root.muted ? 0 : Math.clamp(root.volume / 100, 0.0, 1.0));
    property <length> body-w: root.width - 2 * root.pad;
    // My Hub tiles divide the card evenly — computed, because nested layouts do
    // not hand leftover width down (slint-layout-width-distribution). Tight
    // 6px gutters, so the doubled height reads as one solid shelf.
    property <length> tile-gap: 6px;
    property <int> tiles: (root.hc-photos ? 1 : 0) + (root.hc-videos ? 1 : 0)
        + (root.hc-books ? 1 : 0) + (root.hc-music ? 1 : 0) + (root.hc-cloud ? 1 : 0)
        + (root.hc-tools ? 1 : 0) + (root.hc-transfer ? 1 : 0) + (root.hc-finances ? 1 : 0);
    property <length> tile-w: root.tiles > 0
        ? Math.max(0px, (root.body-w - 28px - (root.tiles - 1) * root.tile-gap) / root.tiles)
        : 0px;
    // Continue / Recently Added split the row; either one alone takes it all.
    property <length> half-w: root.hc-continue && root.hc-library
        ? (root.body-w - root.gap) / 2 : root.body-w;
    // ── Vertical budget ─────────────────────────────────────────────────────
    // The page does not scroll: every row's height is derived from what is
    // actually left after the fixed chrome, so the whole thing lands on one
    // screen at any window size. Only the rows that are switched ON count
    // towards the spacing.
    property <int> rows-n: (root.hc-hero ? 1 : 0) + (root.hc-quick ? 1 : 0)
        + ((root.hc-continue || root.hc-library) ? 1 : 0) + (root.tiles > 0 ? 1 : 0);
    property <length> free: Math.max(360px, root.height - root.bar-h
        - 36px                                   // page padding, top + bottom
        - (root.rows-n - 1) * root.gap
        - (root.hc-quick ? 67px : 0px));         // the launch bar
    // There is no top bar any more — the hero carries the visualizer, the two
    // chips and nothing else. Its 52px, plus the 14px gap under it, went back
    // into the page. My Hub and Continue keep sizing off the OLD number so
    // removing the bar left them exactly where they were; the hero takes the
    // whole 66px.
    property <length> body-free: Math.max(360px, root.free - 66px);
    property <length> hub-h: root.tiles > 0
        ? Math.clamp(root.body-free * 0.28, 156px, 200px) : 0px;
    // Card padding (28) is all the chrome now that the "My Hub" caption is gone;
    // the tile keeps 74px for its name line, count pill and paddings, and the disc
    // takes whatever is left.
    property <length> tile-disc: Math.clamp(root.hub-h - 28px - 74px, 28px, 62px);
    // Continue always draws FOUR slots — filled ones first, empty wells after —
    // so Recently Added has a fixed height to match.
    property <int> cont-slots: 4;
    property <length> cont-row-h: Math.clamp((root.body-free - root.hub-h) * 0.115, 50px, 66px);
    // 32 padding + 34 title/tab row + 10 spacing.
    property <length> cont-h: root.cont-slots * root.cont-row-h + 76px;
    // The banner soaks up whatever is left — the taller the window, the bigger it draws.
    property <length> hero-h: root.hc-hero
        ? Math.max(120px, root.free - root.hub-h
            - ((root.hc-continue || root.hc-library) ? root.cont-h : 0px)) : 0px;
    property <string> cont-filter: "all";
    // Greeting type scales with the hero so the three lines fill its height
    // instead of floating in padding, and with the column so the headline stays
    // on ONE line.
    //
    // The width term is a FACTOR, deliberately, not a measurement. Reading a
    // Text's `preferred-width` from a binding that then feeds another Text's
    // `font-size` re-enters Slint's shared text layout while it still holds its
    // RefCell — i-slint-core textlayout/sharedparley.rs panics with "RefCell
    // already borrowed" before the window ever opens. 0.060 keeps
    // "Good afternoon, <name> 👋" on one line out to a 12-character name —
    // which is exactly the cap Profile enforces on the name, so the headline
    // cannot wrap.
    property <length> greet-col: root.body-w * 0.54 - 16px;
    // The greeting shares the hero's height with the visualizer row now, so it
    // sizes off what is left rather than off the whole block.
    property <length> greet-size: Math.clamp(
        Math.min((root.hero-h - root.hviz-h - root.hviz-pad) * 0.34,
                 root.greet-col * 0.060), 22px, 68px);
    // Row 4 of the greeting column: the spectrum + lyric pill that used to ride
    // the top bar. Zero height unless something is actually playing, and the
    // banner is bottom-anchored in its own block, so it never moves with this.
    property <bool> hviz-on: root.viz-allowed && (root.header-viz
        || (root.viz-lyrics && root.viz-lyrics-ok && root.lyrics-active >= 0));
    // The row exists whether or not audio is playing — the visualizer when it
    // is, the quote shelf when it is not. Keeping the height constant is the
    // point: the greeting above it does not jump when a track starts.
    property <length> hviz-h: Math.clamp(root.hero-h * 0.20, 46px, 88px);
    // 10% of the 60% block clear on both sides would be 0.48w; the strip runs
    // 25% narrower than that so it reads as an accent under the greeting rather
    // than a second full-width band.
    property <length> hviz-w: root.body-w * 0.36;
    // Its own gap above, on top of the layout's spacing — the three greeting
    // rows are one block and the strip should not look welded to the meta line.
    property <length> hviz-pad: Math.clamp(root.hero-h * 0.06, 10px, 26px);
    property <int> res-n: Math.min(root.cont-slots, root.continue-rows.length);
    // ── Recently Added ──────────────────────────────────────────────────────
    // Four tabs on one 20-second loop, Continue's chips reused. 0 Photos ·
    // 1 Videos · 2 Music · 3 Books. Clicking a chip both selects it and
    // restarts the clock, so a deliberate pick gets its full 20s.
    property <int> ra-tab: 0;
    // Quote shelf clock — one a minute, walking the pre-shuffled model.
    property <int> q-idx: 0;
    // Photos / Videos / Music share a 4 × 2 grid; the cells are computed, not
    // stretched, because leftover width does not travel down through nested
    // Slint layouts (slint-layout-width-distribution).
    property <length> ra-gap: 8px;
    property <length> ra-body-h: root.cont-slots * root.cont-row-h;   // cont-h minus its 76px of chrome
    property <length> ra-cell-w: Math.max(0px, (root.half-w - 32px - 3 * root.ra-gap) / 4);
    property <length> ra-cell-h: Math.max(0px, (root.ra-body-h - root.ra-gap) / 2);
    // Books: FOUR, one row, one cell each. The 3D bakes are drawn `contain`
    // inside their cell, so the cell is a quarter of the row and the artwork
    // finds its own size in it — no 9:16 arithmetic to keep in sync.
    property <int> ra-books-n: 4;
    property <length> ra-book-w: root.ra-cell-w;
    property <length> ra-book-h: root.ra-body-h;
    property <int> ra-n: root.ra-tab == 0 ? root.recent-photos.length
        : root.ra-tab == 1 ? root.recent-videos.length
        : root.ra-tab == 2 ? root.recent-songs.length : root.recent-books.length;

    // Classic's Continue palette, kind for kind.
    function accent-of(kind: string) -> color {
        kind == "video" ? Theme.sec-videos
            : kind == "book" ? Theme.sec-books
            : kind == "podcast" ? #8b5cf6
            : #3b82f6
    }
    function kind-label(kind: string) -> string {
        kind == "video" ? "VIDEO"
            : kind == "podcast" ? "PODCAST"
            : kind == "book" ? "BOOK" : "AUDIOBOOK"
    }
    // Measured-by-hand tag widths (9px/800, +0.7 tracking, 10px padding a side).
    // Deliberately NOT `ktag.preferred-width`: that width feeds the title Text's
    // own width, and a text-metric read inside another Text's layout input is
    // what makes i-slint-core panic with "RefCell already borrowed".
    function kind-w(kind: string) -> length {
        kind == "video" ? 52px
            : kind == "podcast" ? 65px
            : kind == "book" ? 46px : 78px
    }

    background: Theme.bg;
    clip: true;

    // ── Page ────────────────────────────────────────────────────────────────
    Rectangle {
        x: root.pad; y: 0px; width: root.body-w;
        height: root.height - root.bar-h;
        background: transparent;
        clip: true;
        psv := ScrollView {
            width: 100%; height: 100%;
            // Every row is sized to fit, so there is nothing to scroll — the
            // bars stay off. The view is still here as the safety net for
            // absurdly short windows.
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            // No `viewport-y: 0px` binding: that pins the view and the wheel
            // does nothing, so the safety net for absurdly short windows was
            // only ever a comment. The page is instantiated inside main's
            // `if active-section == "home"`, so it is built fresh on every
            // entry and opens at the top on its own (ui-scroll-start-top).
            VerticalLayout {
                width: psv.visible-width;
                spacing: root.gap; alignment: start;
                padding-top: 18px; padding-bottom: 18px;

                // ── Hero ────────────────────────────────────────────────────
                // The top bar is gone. Everything it carried lives here now:
                // the spectrum + lyric pill as row 4 of the greeting column,
                // the waveform chip and the avatar above the banner. The
                // wordmark and the logo went with it — the sidebar already
                // says which app this is.
                if root.hc-hero: Rectangle {
                    height: root.hero-h;
                    background: transparent;
                    // Greeting emoji clock — one every two minutes. Kept out of
                    // the layout below: a Timer is non-visual and has no
                    // business being a layout row.
                    Timer {
                        interval: 120s; running: true;
                        triggered => { root.emoji-idx += 1; }
                    }
                    // Right 40%. One drawn banner per theme — the light plate
                    // reads as a white studio, the dark one as a lit desk at
                    // night. Both are transparent PNGs, so they sit on the page
                    // background rather than on a plate of their own.
                    Rectangle {
                        // 10% of its own side kept clear on the right edge.
                        x: parent.width * 0.60; width: parent.width * 0.36; height: 100%;
                        background: transparent;
                        clip: true;
                        Image {
                            source: Theme.dark
                                ? @image-url("../resources/illustrations/darkhero.png")
                                : @image-url("../resources/illustrations/lighthero.png");
                            // 3478 × 1216 — the box keeps that ratio, so `fill`
                            // scales without distorting. Sized by hand to the
                            // SMALLER of the two constraints, i.e. `contain`,
                            // then pinned to the right edge: the art is
                            // transparent, so nothing may be cropped.
                            //
                            // BOTTOM-anchored, not centred. The chips sit in the
                            // space above it and the greeting column grows a
                            // fourth row when audio starts; anchoring the banner
                            // to the floor is what keeps it still through both.
                            property <float> asp: 2.8602;
                            height: Math.min(parent.height, parent.width / self.asp);
                            width: self.height * self.asp;
                            x: parent.width - self.width;
                            y: parent.height - self.height;
                            image-fit: fill;
                        }
                        // The two chips the top bar used to end with, now above
                        // the banner and flush with its right edge.
                        HorizontalLayout {
                            x: parent.width - 262px; y: 0px;
                            width: 262px; height: 44px; spacing: 10px; alignment: end;
                            // Status, left of the avatar. Opens the in-window
                            // Status page rather than the loopback dashboard the
                            // sidebar key opens.
                            HeroStatus {
                                width: 162px; height: 40px; horizontal-stretch: 0;
                                y: (parent.height - self.height) / 2;
                                level: root.status-level;
                                note: root.status-note;
                                clicked => { root.open-status(); }
                            }
                            // Waveform: five styles, Off, and the lyric toggle.
                            Rectangle {
                                width: root.viz-allowed ? 40px : 0px; height: 40px;
                                horizontal-stretch: 0;
                                y: (parent.height - self.height) / 2;
                                border-radius: 20px; clip: true;
                                background: root.header-viz ? Surface.tile(root.np-accent)
                                    : Surface.body(bt.has-hover ? Theme.panel-2 : Theme.panel);
                                border-width: 1px;
                                border-color: root.header-viz ? root.np-accent : Surface.hairline;
                                animate background { duration: 120ms; }
                                bt := TouchArea { mouse-cursor: pointer;
                                    clicked => { viz-menu.show(); } }
                                AppIcon { source: Icons.waveform;
                                    tint: root.header-viz ? #ffffff : Theme.text-dim;
                                    width: 17px; height: 17px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2; }
                                viz-menu := PopupWindow {
                                    x: -104px; y: 44px; width: 144px;
                                    close-policy: close-on-click-outside;
                                    Rectangle { width: 100%; border-radius: Surface.rr(10px, self.width, self.height);
                                        background: Surface.body(Theme.panel);
                                        border-width: 1px; border-color: Theme.outline;
                                        drop-shadow-blur: 24px; drop-shadow-color: #00000066;
                                        // close() must be the LAST statement in every row
                                        // callback — closing first deletes the row mid-eval
                                        // (slint#6426).
                                        VerticalLayout { padding: 6px; spacing: 2px;
                                            for n[i] in ["Bars", "Mirror", "Dots", "Levels", "Line"]: Rectangle {
                                                height: 26px; border-radius: 6px;
                                                background: (root.header-viz && root.vis-style == i)
                                                    ? Accent.color.with-alpha(0.18)
                                                    : (vmi.has-hover ? Theme.panel-2 : transparent);
                                                vmi := TouchArea { mouse-cursor: pointer;
                                                    clicked => { root.header-viz = true;
                                                        root.set-vis-style(i); viz-menu.close(); } }
                                                Text { text: n;
                                                    color: (root.header-viz && root.vis-style == i) ? Accent.color : Theme.text;
                                                    font-size: 12px;
                                                    font-weight: (root.header-viz && root.vis-style == i) ? 700 : 500;
                                                    x: 10px; vertical-alignment: center; height: 100%; } }
                                            Rectangle { height: 1px; background: Theme.outline; }
                                            Rectangle { height: 26px; border-radius: 6px;
                                                background: !root.header-viz ? Accent.color.with-alpha(0.18)
                                                    : (vm0.has-hover ? Theme.panel-2 : transparent);
                                                vm0 := TouchArea { mouse-cursor: pointer;
                                                    clicked => { root.header-viz = false; viz-menu.close(); } }
                                                Text { text: "Off Viz";
                                                    color: !root.header-viz ? Accent.color : Theme.text;
                                                    font-size: 12px;
                                                    font-weight: !root.header-viz ? 700 : 500;
                                                    x: 10px; vertical-alignment: center; height: 100%; } }
                                            if root.viz-lyrics-ok: Rectangle { height: 26px; border-radius: 6px;
                                                background: vml.has-hover ? Theme.panel-2 : transparent;
                                                vml := TouchArea { mouse-cursor: pointer;
                                                    clicked => { root.viz-lyrics = !root.viz-lyrics; viz-menu.close(); } }
                                                Text { text: root.viz-lyrics ? "Lyrics · on" : "Lyrics · off";
                                                    color: root.viz-lyrics ? Accent.color : Theme.text;
                                                    font-size: 12px;
                                                    font-weight: root.viz-lyrics ? 700 : 500;
                                                    x: 10px; vertical-alignment: center; height: 100%; } }
                                        } }
                                }
                            }
                            Rectangle {
                                width: 40px; height: 40px; horizontal-stretch: 0;
                                y: (parent.height - self.height) / 2;
                                border-radius: 20px; clip: true;
                                background: Theme.brand.with-alpha(0.22);
                                border-width: 2px; border-color: Surface.hairline;
                                at := TouchArea { mouse-cursor: pointer;
                                    clicked => { root.open-profile(); } }
                                if root.avatar-image.width > 0: Image { source: root.avatar-image;
                                    image-fit: cover; width: 100%; height: 100%; }
                                if root.avatar-image.width == 0: AppIcon { source: Icons.user;
                                    tint: Theme.brand; width: 17px; height: 17px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2; }
                            }
                        }
                    }
                    // Left 60%: greeting, tagline, meta — and the visualizer as
                    // a fourth row that only exists while audio is playing.
                    // 10% of its own side kept clear on the left edge.
                    VerticalLayout {
                        // `end`, not `center`: the last row (visualizer or quote
                        // shelf) sits on the hero's floor, level with the
                        // bottom-anchored banner beside it.
                        x: parent.width * 0.06; width: parent.width * 0.54 - 16px;
                        alignment: end; spacing: root.greet-size * 0.16;
                        Text { text: root.greeting + " "
                                + root.greet-emojis[Math.mod(root.emoji-idx, root.greet-emojis.length)];
                            color: Theme.text;
                            font-size: root.greet-size; font-weight: 800;
                            letter-spacing: root.greet-size * -0.04;
                            horizontal-alignment: left; wrap: word-wrap; }
                        Text { text: "Your hub for everything that matters.";
                            color: Theme.text-dim; font-size: root.greet-size * 0.42;
                            horizontal-alignment: left; wrap: word-wrap; }
                        // Row 3 rides a red pill in white: the date and the
                        // library totals are the standing facts of the page, so
                        // they are given the one loud colour in the hero. The
                        // pill is only as wide as its text — a full-width band
                        // would read as an error banner.
                        Rectangle {
                            height: root.greet-size * 0.26 * 2.1;
                            horizontal-stretch: 0;
                            Rectangle {
                                x: 0px;
                                width: Math.min(parent.width, metaline.preferred-width + 24px);
                                height: 100%;
                                border-radius: self.height / 2;
                                // A lighter red than #dc2626, and slightly
                                // translucent, so it reads as an accent on the
                                // page rather than a block of ink. White text
                                // still clears contrast at this alpha.
                                background: #ef4444.with-alpha(0.82);
                                clip: true;
                                // No width binding on the Text: feeding the
                                // pill's width back into it would be a layout
                                // loop, and reading a Text's own metrics into
                                // its own box is the shape that panics
                                // "RefCell already borrowed". The pill measures
                                // it; the Text just sits at 12px and clips.
                                metaline := Text {
                                    x: 12px; height: 100%;
                                    text: root.date-line
                                        + (root.library-line == "" ? "" : "  ·  " + root.library-line);
                                    color: #ffffff; font-size: root.greet-size * 0.26;
                                    font-weight: 700;
                                    vertical-alignment: center; overflow: elide;
                                }
                            }
                        }
                        // Row 4. The wrapper spans the column; the strip inside
                        // it stops at 0.54w, which is 10% of the 60% block clear
                        // on the right to match the 10% already clear on the
                        // left. Collapses to zero height with nothing playing.
                        Rectangle {
                            height: root.hviz-h + root.hviz-pad; vertical-stretch: 0;
                            background: transparent; clip: true;
                            // One quote a minute, walking the already-shuffled
                            // model. Stopped while the visualizer has the row,
                            // so it is not ticking behind a hidden block.
                            Timer {
                                interval: 60s; running: !root.hviz-on;
                                triggered => { root.q-idx += 1; }
                            }
                            Rectangle {
                                x: 0px; y: root.hviz-pad;
                                width: root.hviz-on ? root.hviz-w : parent.width;
                                height: root.hviz-h;
                                background: transparent;
                                if root.viz-allowed && root.header-viz: VizView {
                                    width: 100%; height: 100%;
                                    bars: root.vis-bars; style: root.vis-style; active: true;
                                }
                                // Nothing playing → the quote shelf takes the
                                // row rather than leaving a hole under the
                                // greeting. Full width of the greeting column
                                // (the visualizer is deliberately narrower).
                                if !root.hviz-on: HeroQuote {
                                    width: 100%; height: 100%;
                                    quote: root.quotes.length > 0
                                        ? root.quotes[Math.mod(root.q-idx, root.quotes.length)]
                                        : { text: "", author: "" };
                                }
                                // The lyric pill shows whenever the toggle is on,
                                // with or without the spectrum behind it.
                                if root.viz-allowed && root.viz-lyrics && root.viz-lyrics-ok
                                    && root.lyrics-active >= 0 && root.lyrics-rows.length > 0: Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: Math.min(hlyr.preferred-width + 28px, parent.width - 16px);
                                    height: 30px; border-radius: 15px;
                                    background: Surface.tile(#ffffff);
                                    border-width: Surface.clay ? 0px : 1px; border-color: #00000022;
                                    drop-shadow-blur: Surface.clay ? 18px : 12px;
                                    drop-shadow-color: Surface.shadow-ink;
                                    drop-shadow-offset-y: Surface.tile-shadow-y();
                                    hlyr := Text { x: 12px; width: parent.width - 24px; height: 100%;
                                        text: root.lyrics-rows[root.lyrics-active].text;
                                        color: #14141b; font-size: 13px; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        overflow: elide; }
                                }
                            }
                        }
                    }
                }

                // ── Launch bar ──────────────────────────────────────────────
                if root.hc-quick: WelCard {
                    height: 67px;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 0;
                        Launcher { label: "Stream"; icon: Icons.monitor-play;
                            accent: Theme.sec-videos; clicked => { root.open-stream(); } }
                        Rectangle { width: 1px; horizontal-stretch: 0;
                            background: Surface.hairline; }
                        Launcher { label: "YouTube"; icon: Icons.play;
                            accent: #ef4444; clicked => { root.open-youtube(); } }
                        Rectangle { width: 1px; horizontal-stretch: 0;
                            background: Surface.hairline; }
                        Launcher { label: "Music D/L"; icon: Icons.download;
                            accent: Theme.sec-music; clicked => { root.open-download(); } }
                        Rectangle { width: 1px; horizontal-stretch: 0;
                            background: Surface.hairline; }
                        Launcher { label: "Genesis Books"; icon: Icons.sparkles;
                            accent: Theme.sec-books; clicked => { root.open-genesis(); } }
                        Rectangle { width: 1px; horizontal-stretch: 0;
                            background: Surface.hairline; }
                        Launcher { label: "Random Radio"; icon: Icons.radio;
                            accent: Theme.brand; clicked => { root.random-radio(); } }
                        Rectangle { width: 1px; horizontal-stretch: 0;
                            background: Surface.hairline; }
                        Launcher { label: "Live TV"; icon: Icons.tv;
                            accent: Theme.sec-cloud; clicked => { root.open-livetv(); } }
                    }
                }

                // ── Continue · Recently Added ───────────────────────────────
                if root.hc-continue || root.hc-library: HorizontalLayout {
                    // Four Continue slots set the row height; Recently Added
                    // matches it whether or not anything is in progress.
                    height: root.cont-h;
                    spacing: root.gap;

                    if root.hc-continue: WelCard {
                        width: root.half-w; horizontal-stretch: 0;
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            // Title and the kind tabs share ONE row — the tabs
                            // never push the rows down. Same logic as Classic:
                            // the backend hands back an already-filtered model.
                            HorizontalLayout {
                                height: 34px; spacing: 6px; vertical-stretch: 0;
                                Text { text: "Continue"; color: Theme.text;
                                    font-size: 14px; font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1; overflow: elide; }
                                HomeChip { label: "All"; accent: Theme.sec-music;
                                    emphasized: root.cont-filter == "all";
                                    clicked => { root.cont-filter = "all";
                                        root.continue-filter("all"); } }
                                HomeChip { label: "Books"; accent: Theme.sec-books;
                                    emphasized: root.cont-filter == "book";
                                    clicked => { root.cont-filter = "book";
                                        root.continue-filter("book"); } }
                                HomeChip { label: "Videos"; accent: Theme.sec-videos;
                                    emphasized: root.cont-filter == "video";
                                    clicked => { root.cont-filter = "video";
                                        root.continue-filter("video"); } }
                                HomeChip { label: "Podcasts"; accent: #8b5cf6;
                                    emphasized: root.cont-filter == "podcast";
                                    clicked => { root.cont-filter = "podcast";
                                        root.continue-filter("podcast"); } }
                                HomeChip { label: "Audiobooks"; accent: #3b82f6;
                                    emphasized: root.cont-filter == "audiobook";
                                    clicked => { root.cont-filter = "audiobook";
                                        root.continue-filter("audiobook"); } }
                            }
                            // FOUR slots, always. Filled ones first, empty wells
                            // after — spacing lives inside the rows so the zero-
                            // height overflow rows cost nothing (slint#6426 rules
                            // out an `if` inside a repeater).
                            VerticalLayout {
                                spacing: 0px; vertical-stretch: 1;
                                for r[i] in root.continue-rows: Rectangle {
                                    height: i < root.res-n ? root.cont-row-h : 0px;
                                    background: transparent; clip: true;
                                    crow := Rectangle {
                                        property <color> kaccent: root.accent-of(r.kind);
                                        x: 0; y: 2px;
                                        width: parent.width; height: root.cont-row-h - 4px;
                                        border-radius: Surface.rr(12px, self.width, self.height);
                                        // Hover is My Hub's, not a panel swap: the
                                        // row fills with its own kind's accent and
                                        // takes an accent edge. The panel-to-panel
                                        // lift these rows had before was invisible
                                        // on a page already made of panels.
                                        background: ct.has-hover
                                            ? crow.kaccent.with-alpha(Theme.dark ? 0.28 : 0.18)
                                            : Surface.body(Theme.panel.with-alpha(0.55));
                                        border-width: Surface.clay ? 0px : 1px;
                                        border-color: ct.has-hover
                                            ? crow.kaccent.with-alpha(0.45) : Theme.outline;
                                        animate background, border-color { duration: 130ms; easing: ease-out; }
                                        ct := TouchArea { mouse-cursor: pointer;
                                            clicked => { root.continue-open(r); } }
                                        // Absolute placement, not nested layouts:
                                        // leftover width does not travel down through
                                        // nested Slint layouts (see the
                                        // slint-layout-width-distribution note) — the
                                        // stretchy title column came out at zero width,
                                        // so only the fixed-width tag ever drew.
                                        property <length> cw: (root.cont-row-h - 12px) * 3 / 4;
                                        property <length> pillw: 172px;
                                        property <length> pillx: self.width - 9px - self.pillw;
                                        property <length> textx: 7px + self.cw + 10px;
                                        property <length> pillh: Math.min(34px, self.height - 8px);
                                        property <length> tagx: self.pillx - root.kind-w(r.kind) - 8px;
                                        property <length> texttop: (self.height - 37px) / 2;
                                        // Cover, ringed in the kind's colour like Classic's
                                        // tile: outer rect draws the border, inner holds the
                                        // clipped art with a 1px gap between.
                                        Rectangle {
                                            x: 7px; y: 4px;
                                            width: crow.cw; height: crow.height - 8px;
                                            border-radius: Surface.rr(8px, self.width, self.height);
                                            border-width: 1px; border-color: crow.kaccent;
                                            Rectangle {
                                                x: 2px; y: 2px;
                                                width: parent.width - 4px;
                                                height: parent.height - 4px;
                                                border-radius: Surface.rr(6px, self.width, self.height); clip: true;
                                                background: Surface.wash(crow.kaccent, 0.15);
                                                if r.cover.width > 0: Image { source: r.cover;
                                                    image-fit: cover; width: 100%; height: 100%; }
                                                if r.cover.width == 0: AppIcon {
                                                    source: r.kind == "video" ? Icons.film
                                                        : r.kind == "book" ? Icons.book-open
                                                        : r.kind == "podcast" ? Icons.mic
                                                        : Icons.headphones;
                                                    tint: crow.kaccent;
                                                    width: 15px; height: 15px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2; }
                                            }
                                        }
                                        // Category tag — its own pill, left of the
                                        // progress pill and the same height as it.
                                        ktagbox := Rectangle {
                                            x: crow.tagx; y: (crow.height - crow.pillh) / 2;
                                            width: root.kind-w(r.kind); height: crow.pillh;
                                            border-radius: Surface.rr(9px, self.width, self.height);
                                            background: Surface.wash(crow.kaccent, 0.15);
                                            border-width: Surface.clay ? 0px : 1px;
                                            border-color: crow.kaccent.with-alpha(0.55);
                                            HorizontalLayout {
                                                padding-left: 10px; padding-right: 10px;
                                                Text { text: root.kind-label(r.kind);
                                                    horizontal-alignment: center;
                                                    color: crow.kaccent;
                                                    font-size: 9px; font-weight: 800;
                                                    letter-spacing: 0.7px;
                                                    vertical-alignment: center; }
                                            }
                                        }
                                        Text {
                                            x: crow.textx; y: crow.texttop;
                                            width: Math.max(0px, crow.tagx - crow.textx - 12px);
                                            text: r.title; color: Theme.text;
                                            font-size: 13px; font-weight: 800;
                                            vertical-alignment: center; overflow: elide;
                                        }
                                        Text {
                                            x: crow.textx; y: crow.texttop + 21px;
                                            width: Math.max(0px, crow.tagx - crow.textx - 12px);
                                            text: r.author == "" ? r.sub : r.author;
                                            color: Theme.text-dim; font-size: 10.5px;
                                            vertical-alignment: center; overflow: elide;
                                        }
                                        // Classic's progress pill: remaining text + percent
                                        // over the fill bar — white on light, deep accent
                                        // on dark.
                                        Rectangle {
                                            x: crow.pillx; width: crow.pillw;
                                            height: crow.pillh;
                                            y: (crow.height - crow.pillh) / 2;
                                            border-radius: Surface.rr(9px, self.width, self.height);
                                            background: Surface.tile(Theme.dark
                                                ? crow.kaccent.darker(0.30)
                                                : crow.kaccent.with-alpha(0.12));
                                            border-width: Surface.clay ? 0px : 1px;
                                            border-color: Theme.dark ? #ffffffcc
                                                : crow.kaccent.with-alpha(0.55);
                                            Text {
                                                x: 9px; y: 4px;
                                                width: parent.width - 48px;
                                                text: r.sub;
                                                color: Theme.dark ? #ffffff : Theme.text;
                                                font-size: 11px; font-weight: 700;
                                                vertical-alignment: center; overflow: elide;
                                            }
                                            Text {
                                                x: parent.width - 39px; y: 4px;
                                                width: 30px;
                                                text: r.frac < 0 ? "" : Math.round(r.frac * 100) + "%";
                                                color: Theme.dark ? #ffffff : Theme.text;
                                                font-size: 10px; font-weight: 800;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                x: 9px; y: parent.height - 12px;
                                                width: parent.width - 18px; height: 8px;
                                                border-radius: 4px;
                                                background: Theme.dark
                                                    ? #ffffff.with-alpha(0.25)
                                                    : crow.kaccent.with-alpha(0.18);
                                                Rectangle {
                                                    x: 0; y: 0; height: 100%;
                                                    border-radius: 4px;
                                                    width: parent.width * Math.clamp(r.frac, 0.0, 1.0);
                                                    background: Theme.dark ? #ffffff : crow.kaccent;
                                                }
                                            }
                                        }
                                        // The armed inner outline — same second ring
                                        // the hub tiles draw, held off the row's own
                                        // edge. LAST child, so it rides over the cover
                                        // and the pills instead of being cut by them,
                                        // and it is a border-WIDTH that goes to zero,
                                        // never an `if` inside a repeater (slint#6426).
                                        Rectangle {
                                            x: 5px; y: 5px;
                                            width: parent.width - 10px;
                                            height: parent.height - 10px;
                                            border-radius: Math.max(2px, Surface.rr(12px, self.width, self.height) - 5px);
                                            background: transparent;
                                            border-width: ct.has-hover ? 2px : 0px;
                                            border-color: crow.kaccent.with-alpha(0.75);
                                            animate border-width { duration: 130ms; easing: ease-out; }
                                        }
                                    }
                                }
                                // The wells that keep the card four rows tall.
                                for w[i] in [0, 1, 2, 3]: Rectangle {
                                    height: i < root.res-n ? 0px : root.cont-row-h;
                                    background: transparent; clip: true;
                                    Rectangle {
                                        x: 0; y: 2px;
                                        width: parent.width; height: root.cont-row-h - 4px;
                                        border-radius: Surface.rr(12px, self.width, self.height);
                                        background: Theme.text.with-alpha(0.03);
                                        border-width: 1px;
                                        border-color: Theme.text.with-alpha(0.06);
                                        // Empty-state line on the first well only.
                                        // No `if` inside the repeater — the text
                                        // itself goes blank (slint#6426).
                                        Text {
                                            x: 14px; width: parent.width - 28px; height: 100%;
                                            text: (i == 0 && root.res-n == 0)
                                                ? "Nothing half-finished yet — what you start shows up here."
                                                : "";
                                            color: Theme.text-dim; font-size: 11px;
                                            vertical-alignment: center; overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.hc-library: WelCard {
                        width: root.half-w; horizontal-stretch: 0;
                        // The 20s loop. Restarted (not merely reset) on a chip
                        // click, so picking a tab by hand buys a full interval.
                        ratimer := Timer {
                            interval: 20s;
                            triggered => { root.ra-tab = Math.mod(root.ra-tab + 1, 4); }
                        }
                        VerticalLayout {
                            padding: 16px; spacing: 10px;
                            // Same shape as Continue's header: title and tabs on
                            // ONE row, no "View all".
                            HorizontalLayout {
                                height: 34px; spacing: 6px; vertical-stretch: 0;
                                Text { text: "Recently Added"; color: Theme.text;
                                    font-size: 14px; font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1; overflow: elide; }
                                HomeChip { label: "Photos"; accent: Theme.sec-photos;
                                    emphasized: root.ra-tab == 0;
                                    clicked => { root.ra-tab = 0; ratimer.restart(); } }
                                HomeChip { label: "Videos"; accent: Theme.sec-videos;
                                    emphasized: root.ra-tab == 1;
                                    clicked => { root.ra-tab = 1; ratimer.restart(); } }
                                HomeChip { label: "Music"; accent: Theme.sec-music;
                                    emphasized: root.ra-tab == 2;
                                    clicked => { root.ra-tab = 2; ratimer.restart(); } }
                                HomeChip { label: "Books"; accent: Theme.sec-books;
                                    emphasized: root.ra-tab == 3;
                                    clicked => { root.ra-tab = 3; ratimer.restart(); } }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                background: transparent;
                                clip: true;
                                Text {
                                    x: 0; width: 100%; height: 100%;
                                    text: root.ra-n > 0 ? ""
                                        : (root.ra-tab == 0 ? "No photos indexed yet."
                                            : root.ra-tab == 1 ? "No videos indexed yet."
                                            : root.ra-tab == 2 ? "No music indexed yet."
                                            : "No books indexed yet.");
                                    color: Theme.text-dim; font-size: 12px;
                                    vertical-alignment: center; wrap: word-wrap;
                                }
                                // Photos — 4 × 2, newest first.
                                if root.ra-tab == 0: Rectangle {
                                    width: 100%; height: 100%; background: transparent;
                                    for ph[i] in root.recent-photos: RaTile {
                                        width: i < 8 ? root.ra-cell-w : 0px;
                                        height: i < 8 ? root.ra-cell-h : 0px;
                                        x: Math.mod(i, 4) * (root.ra-cell-w + root.ra-gap);
                                        y: Math.floor(i / 4) * (root.ra-cell-h + root.ra-gap);
                                        art: ph; accent: Theme.sec-photos;
                                        clicked => { root.open-photo-item(i); }
                                    }
                                }
                                // Videos — same grid, play badge on hover.
                                if root.ra-tab == 1: Rectangle {
                                    width: 100%; height: 100%; background: transparent;
                                    for vd[i] in root.recent-videos: RaTile {
                                        width: i < 8 ? root.ra-cell-w : 0px;
                                        height: i < 8 ? root.ra-cell-h : 0px;
                                        x: Math.mod(i, 4) * (root.ra-cell-w + root.ra-gap);
                                        y: Math.floor(i / 4) * (root.ra-cell-h + root.ra-gap);
                                        art: vd; accent: Theme.sec-videos; play: true;
                                        clicked => { root.open-video-item(i); }
                                    }
                                }
                                // Music — My Music's song card at this width:
                                // art on top, title over artist beneath.
                                if root.ra-tab == 2: Rectangle {
                                    width: 100%; height: 100%; background: transparent;
                                    for sg[i] in root.recent-songs: RaSong {
                                        width: i < 4 ? root.ra-cell-w : 0px;
                                        height: i < 4 ? root.ra-body-h : 0px;
                                        x: i * (root.ra-cell-w + root.ra-gap);
                                        y: 0px;
                                        song: sg;
                                        now: sg.index == root.np-index && root.np-index >= 0;
                                        clicked => { root.play-song(sg.index); }
                                    }
                                }
                                // Books — Classic's shelf, 9:16 covers that lift
                                // on hover, sized to this narrower card.
                                if root.ra-tab == 3: Rectangle {
                                    width: 100%; height: 100%; background: transparent;
                                    for bk[i] in root.recent-books: RaBook {
                                        width: i < root.ra-books-n ? root.ra-book-w : 0px;
                                        height: i < root.ra-books-n ? root.ra-book-h : 0px;
                                        x: i * (root.ra-book-w + root.ra-gap);
                                        book: bk;
                                        clicked => { root.open-book-detail(bk.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── My Hub ──────────────────────────────────────────────────
                if root.tiles > 0: WelCard {
                    // Tall tiles, tight gutters — height comes out of the page
                    // budget so the shelf never pushes the player off-screen.
                    height: root.hub-h;
                    VerticalLayout {
                        padding: 14px; spacing: 0px;
                        HorizontalLayout {
                            spacing: root.tile-gap; alignment: start; vertical-stretch: 1;
                            if root.hc-photos: HubTile { width: root.tile-w; disc: root.tile-disc;
                                name: "Photos"; count: root.stats.photos + " items";
                                icon: Icons.image; accent: Theme.sec-photos;
                                clicked => { root.open-section("photos"); } }
                            if root.hc-videos: HubTile { width: root.tile-w; disc: root.tile-disc;
                                name: "Videos"; count: root.stats.videos + " items";
                                icon: Icons.film; accent: Theme.sec-videos;
                                clicked => { root.open-section("videos"); } }
                            if root.hc-music: HubTile { width: root.tile-w; disc: root.tile-disc;
                                name: "Music"; count: root.stats.songs + " songs";
                                icon: Icons.music; accent: Theme.sec-music;
                                clicked => { root.open-section("music"); } }
                            if root.hc-books: HubTile { width: root.tile-w; disc: root.tile-disc;
                                name: "Books"; count: root.stats.books + " books";
                                icon: Icons.book-open; accent: Theme.sec-books;
                                clicked => { root.open-section("books"); } }
                            if root.hc-cloud: HubTile { width: root.tile-w; disc: root.tile-disc;
                                name: "Clouds"; count: root.stats.cloud-remotes + " services";
                                icon: Icons.cloud; accent: Theme.sec-cloud;
                                clicked => { root.open-section("cloud"); } }
                            if root.hc-tools: HubTile { width: root.tile-w; disc: root.tile-disc;
                                name: "Tools"; icon: Icons.wrench; accent: Theme.sec-tools;
                                // The catalog's op count, not "utilities" — the
                                // other tiles all say how much is in there.
                                count: root.tool-count + " tools";
                                clicked => { root.open-section("tools"); } }
                            if root.hc-transfer: HubTile { width: root.tile-w; disc: root.tile-disc;
                                // Host IP and port, so the tile is the thing you
                                // read out to the other device. Falls back to the
                                // generic line until the server has bound.
                                name: "Transfer";
                                count: root.transfer-line == "" ? "local network"
                                    : root.transfer-line;
                                icon: Icons.share; accent: Theme.sec-transfer;
                                clicked => { root.open-section("transfer"); } }
                            if root.hc-finances: HubTile { width: root.tile-w; disc: root.tile-disc;
                                name: "Finances";
                                count: root.fin-month == "" ? "overview" : root.fin-month;
                                icon: Icons.wallet; accent: Theme.sec-finances;
                                clicked => { root.open-section("finances"); } }
                        }
                    }
                }
            }
        }
    }

    // The 15s hold clock. Lives out here rather than in the card so it is not
    // torn down and rebuilt every time `hc-player` or the card's own `if`
    // changes — a timer that restarts itself is a timer that never fires.
    hold := Timer {
        interval: 15s; running: root.bar-hold;
        triggered => { root.bar-hold = false; }
    }

    // Pause clock. `running` is the whole start condition — it begins counting
    // the moment playback stops with a track still loaded, and stops dead when
    // playback resumes. Resuming also has to CLEAR the sunk flag, which no
    // binding can do (the flag has to survive `playing` going false again), so
    // the reset rides `changed playing`.
    Timer {
        interval: 15s;
        running: root.hc-player && !root.playing && root.np-title != "" && !root.pause-sunk;
        triggered => { root.pause-sunk = true; }
    }
    changed playing => {
        if (root.playing) { root.pause-sunk = false; }
    }
    // Picking a new track while the bar is sunk has to raise it too — otherwise
    // it stays hidden until playback actually starts, and stays hidden for good
    // if the track never does.
    changed np-title => { root.pause-sunk = false; }

    // ── Bottom player bar ───────────────────────────────────────────────────
    // Its own fill and accent hairline rather than WelCard's default panel —
    // on OLED the panel sits a hair off pure black and the bar vanished.
    if root.hc-player: WelCard {
        x: root.pad; y: root.height - root.bar-h;
        width: root.body-w; height: root.card-h;
        background: Surface.body(Theme.dark ? Theme.panel-2 : Theme.panel);
        border-width: 1px;
        border-color: root.pl-accent.with-alpha(Theme.dark ? 0.45 : 0.30);
        // The hover well for the sunk bar. First child, so every control above
        // it still gets its own clicks; this one only reports the pointer.
        // `changed has-hover` rather than a binding, because the card lives
        // inside an `if` and root cannot reach a name in there.
        peek := TouchArea {
            width: 100%; height: 100%;
            // Restarted on entry AND on exit, so the 15s runs from whichever
            // came last — i.e. from when the pointer actually left.
            changed has-hover => {
                root.bar-peek = self.has-hover;
                root.bar-hold = true;
                hold.restart();
            }
        }
        // Sunk: only the top `stub-h` of the card is above the floor, so the one
        // mark it carries is centred in THAT strip, not in the card. The note
        // pill says what the bar is and that it is there; the grip that used to
        // sit beside it was saying the same thing twice.
        if !root.bar-open: Rectangle {
            x: (parent.width - self.width) / 2;
            y: (root.stub-h - self.height) / 2;
            width: 34px; height: 18px; border-radius: 9px;
            background: root.pl-accent.with-alpha(peek.has-hover ? 1.0 : 0.78);
            animate background { duration: 120ms; easing: ease-out; }
            AppIcon { source: Icons.music; tint: #ffffff;
                width: 11px; height: 11px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2; }
        }
        // Second, inner outline — only while something plays. It breathes on
        // `animation-tick()` (the edge-bubble ring's trick) and slides between
        // the artwork accent and the brand violet, so the bar reads as live.
        // No TouchArea, so it never eats a click meant for the transport, and
        // it is declared BEFORE the transport so the hover pills — which float
        // above their controls — are not sliced by it.
        if root.playing: Rectangle {
            property <float> pulse:
                Math.abs(Math.sin((animation-tick() / 1ms / 620) * 1rad));
            x: 4px; y: 4px;
            width: parent.width - 8px; height: parent.height - 8px;
            border-radius: Math.max(2px, Surface.card-radius - 4px);
            background: transparent;
            border-width: 3px;
            border-color: root.pl-accent.mix(Theme.dark ? #ffffff : Theme.brand-2, self.pulse)
                .with-alpha(0.35 + 0.5 * self.pulse);
        }
        if root.bar-open: HorizontalLayout {
            padding-left: 14px; padding-right: 16px; spacing: 12px;

            // Artwork — opens the app-wide mini player.
            Rectangle {
                width: 50px; height: 50px; horizontal-stretch: 0;
                y: (parent.height - self.height) / 2;
                border-radius: Surface.rr(12px, self.width, self.height); clip: true;
                background: root.pl-accent.with-alpha(0.25);
                border-width: art.has-hover ? 2px : 0px;
                border-color: root.pl-accent;
                animate border-width { duration: 110ms; }
                art := TouchArea { mouse-cursor: pointer;
                    clicked => { root.open-mini(); } }
                if root.np-art.width > 0: Image { source: root.np-art; image-fit: cover;
                    width: 100%; height: 100%; }
                if root.np-art.width == 0: AppIcon { source: Icons.music; tint: root.pl-accent;
                    width: 22px; height: 22px;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                if art.has-hover: WelTip { label: "Open mini player"; accent: root.pl-accent;
                    host-w: parent.width; }
            }
            Rectangle {
                width: 176px; horizontal-stretch: 0; background: transparent;
                nowt := TouchArea { }
                VerticalLayout {
                    width: 100%; height: 100%; alignment: center; spacing: 2px;
                    WelMarquee { height: 17px;
                        label: root.np-title == "" ? "Nothing playing" : root.np-title;
                        ink: root.pl-ink; size: 13px; }
                    WelMarquee { height: 14px;
                        label: root.np-sub; ink: root.pl-dim; size: 10.5px; weight: 500; }
                }
                if nowt.has-hover: WelTip { label: "Now playing"; accent: root.pl-accent;
                    host-w: parent.width; }
            }

            // The five controls, standing where the spectrum used to.
            HorizontalLayout {
                horizontal-stretch: 0; spacing: 8px; alignment: center;
                WelBtn { icon: Icons.shuffle; lit: root.shuffle;
                    tip: root.shuffle ? "Shuffle on" : "Shuffle off";
                    accent: root.pl-accent; ink: root.pl-ink;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.toggle-shuffle(); } }
                WelBtn { icon: Icons.skip-back; tip: "Previous";
                    accent: root.pl-accent; ink: root.pl-ink;
                    y: (parent.height - self.height) / 2; clicked => { root.prev(); } }
                WelBtn { icon: root.playing ? Icons.pause : Icons.play; primary: true;
                    tip: root.playing ? "Pause" : "Play";
                    accent: root.pl-accent; ink: root.pl-ink;
                    y: (parent.height - self.height) / 2; clicked => { root.playpause(); } }
                WelBtn { icon: Icons.skip-forward; tip: "Next";
                    accent: root.pl-accent; ink: root.pl-ink;
                    y: (parent.height - self.height) / 2; clicked => { root.next(); } }
                WelBtn { icon: root.repeat == "one" ? Icons.repeat-1 : Icons.repeat;
                    lit: root.repeat != "off";
                    tip: root.repeat == "one" ? "Repeat track"
                        : (root.repeat == "off" ? "Repeat off" : "Repeat all");
                    accent: root.pl-accent; ink: root.pl-ink;
                    y: (parent.height - self.height) / 2; clicked => { root.cycle-repeat(); } }
            }

            // One row now, so the seek bar gets to be thick and gradient-filled —
            // and wide enough to carry both times inside it. 10% narrower than
            // the slot, so it never crowds the volume block.
            Rectangle {
                horizontal-stretch: 1; background: transparent;
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: parent.width * 0.90; height: 22px; border-radius: 11px;
                    background: root.pl-ink.with-alpha(0.13);
                    border-width: 1px; border-color: root.pl-ink.with-alpha(0.22);
                    clip: true;
                    Rectangle {
                        x: 0; height: 100%; border-radius: 11px;
                        width: parent.width
                            * Math.clamp(root.dur > 0 ? root.pos / root.dur : 0, 0.0, 1.0);
                        background: Theme.dark
                            ? @linear-gradient(90deg, #ec4899 0%, #f9a8d4 55%, #ffffff 100%)
                            : @linear-gradient(90deg, root.np-accent 0%, Theme.brand 100%);
                    }
                    // Elapsed rides the fill, so it flips to white once the fill
                    // has actually reached it.
                    Text { x: 11px; y: (parent.height - self.height) / 2;
                        text: root.pos-label;
                        color: (root.dur > 0 && root.pos / root.dur > 0.12)
                            ? #ffffff : root.pl-dim;
                        font-size: 10px; font-weight: 700; }
                    Text { x: parent.width - self.width - 11px;
                        y: (parent.height - self.height) / 2;
                        text: root.dur-label; color: root.pl-dim;
                        font-size: 10px; font-weight: 700; }
                    // Click to seek. NOT `moved` — every move event is one more
                    // mpv IPC command, and mpv logs a broken pipe for each dead
                    // client the burst leaves behind.
                    sk := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.seek(root.dur * Math.clamp(self.mouse-x / self.width, 0.0, 1.0));
                        }
                    }
                }
                // The time under the pointer, riding the cursor. Lives OUTSIDE
                // the track — the track clips, so a pill parented to it would
                // be cut in half.
                if sk.has-hover && root.dur > 0: Rectangle {
                    property <float> at: root.dur
                        * Math.clamp(sk.mouse-x / sk.width, 0.0, 1.0);
                    x: Math.clamp(parent.width * 0.05 + sk.mouse-x - self.width / 2,
                        0px, parent.width - self.width);
                    y: (parent.height - self.height) / 2 - 28px;
                    width: skt.preferred-width + 16px; height: 22px;
                    border-radius: 11px;
                    background: root.pl-accent;
                    drop-shadow-blur: Surface.cast(10px);
                    drop-shadow-color: #00000088;
                    skt := Text { text: root.fmt(parent.at); color: #ffffff;
                        font-size: 11px; font-weight: 700;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2; }
                }
                if sk.has-hover && root.dur <= 0: WelTip {
                    label: "Seek"; accent: root.pl-accent; host-w: parent.width;
                    y: (parent.height - self.height) / 2 - 28px; }
            }

            // Queue drop-up · volume · zen. The queue sits at the head of the
            // block, next to the seek bar it belongs with.
            HorizontalLayout {
                width: 246px; horizontal-stretch: 0; spacing: 6px; alignment: end;
                // Queue — a drop-UP list of what is coming next.
                Rectangle {
                    width: 34px; height: 34px; horizontal-stretch: 0;
                    y: (parent.height - self.height) / 2;
                    border-radius: 17px;
                    background: qb.has-hover ? root.pl-accent : transparent;
                    border-width: 1.5px;
                    border-color: qb.has-hover ? root.pl-accent : root.pl-ink.with-alpha(0.45);
                    animate background, border-color { duration: 120ms; easing: ease-out; }
                    qb := TouchArea { mouse-cursor: pointer;
                        clicked => { root.refresh-queue(); qpop.show(); } }
                    AppIcon { source: Icons.list-music;
                        tint: qb.has-hover ? #ffffff : root.pl-ink;
                        width: 15px; height: 15px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2; }
                    if qb.has-hover: WelTip {
                        label: "Queue · " + root.queue-rows.length + " tracks";
                        accent: root.pl-accent; host-w: parent.width; }
                    qpop := PopupWindow {
                        // Negative y = the panel opens upward, above the bar.
                        // Centred on the 34px button now that it stands mid-block.
                        x: -141px; y: -336px; width: 316px; height: 330px;
                        close-policy: close-on-click-outside;
                        Rectangle {
                            width: 100%; height: 100%;
                            border-radius: Surface.rr(14px, self.width, self.height);
                            background: Surface.body(Theme.dark ? Theme.panel-2 : Theme.panel);
                            border-width: 1px; border-color: Theme.outline;
                            drop-shadow-blur: 30px; drop-shadow-color: #00000077;
                            VerticalLayout {
                                padding: 12px; spacing: 8px;
                                HorizontalLayout {
                                    height: 18px; spacing: 8px;
                                    Text { text: "Up next"; color: Theme.text;
                                        font-size: 13px; font-weight: 700;
                                        horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: root.queue-rows.length + " tracks";
                                        color: Theme.text-dim; font-size: 10.5px;
                                        horizontal-stretch: 0; vertical-alignment: center; }
                                }
                                Text {
                                    text: root.queue-rows.length == 0
                                        ? "The queue is empty — press play and it fills up." : "";
                                    color: Theme.text-dim; font-size: 11px;
                                    height: root.queue-rows.length == 0 ? 30px : 0px;
                                    wrap: word-wrap;
                                }
                                qsv := ScrollView {
                                    vertical-stretch: 1; viewport-y: 0px;
                                    VerticalLayout {
                                        width: qsv.visible-width; spacing: 2px; alignment: start;
                                        for q in root.queue-rows: Rectangle {
                                            // Rows carry a PLAYBACK POSITION, not a
                                            // row number — comparing the repeater
                                            // index lit whatever row happened to sit
                                            // at that position in the list.
                                            property <bool> now:
                                                q.index == root.np-index && root.np-index >= 0;
                                            height: 40px; border-radius: Surface.rr(9px, self.width, self.height);
                                            background: self.now
                                                ? root.np-accent.with-alpha(0.18)
                                                : (qr.has-hover ? Theme.glass : transparent);
                                            qr := TouchArea { mouse-cursor: pointer;
                                                clicked => { root.play-queue(q.index); } }
                                            HorizontalLayout {
                                                padding-left: 6px; padding-right: 8px;
                                                padding-top: 4px; padding-bottom: 4px; spacing: 8px;
                                                Rectangle {
                                                    width: 32px; horizontal-stretch: 0;
                                                    border-radius: Surface.rr(7px, self.width, self.height); clip: true;
                                                    background: root.np-accent.with-alpha(0.16);
                                                    if q.thumb.width > 0: Image { source: q.thumb;
                                                        image-fit: cover;
                                                        width: 100%; height: 100%; }
                                                }
                                                VerticalLayout {
                                                    alignment: center; spacing: 1px;
                                                    horizontal-stretch: 1; min-width: 0;
                                                    Text { text: q.title;
                                                        color: q.index == root.np-index && root.np-index >= 0
                                                            ? root.np-accent : Theme.text;
                                                        font-size: 11.5px;
                                                        font-weight: q.index == root.np-index && root.np-index >= 0 ? 700 : 500;
                                                        overflow: elide; }
                                                    Text { text: q.artist; color: Theme.text-dim;
                                                        font-size: 9.5px; overflow: elide; }
                                                }
                                                Text { text: q.duration; color: Theme.text-dim;
                                                    font-size: 9.5px; horizontal-stretch: 0;
                                                    vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                WelBtn { icon: root.muted ? Icons.volume-x : Icons.volume;
                    tip: root.muted ? "Unmute" : "Mute";
                    accent: root.pl-accent; ink: root.pl-ink;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.toggle-mute(); } }
                // Drag or click anywhere on the track.
                Rectangle {
                    // 8px of slack each side so the 16px knob stays clear of the
                    // mute button and the queue button at the ends of its travel.
                    width: 126px; horizontal-stretch: 0; background: transparent;
                    Rectangle {
                        x: 8px; y: (parent.height - self.height) / 2;
                        width: parent.width - 16px; height: 12px; border-radius: 6px;
                        background: root.pl-ink.with-alpha(0.13);
                        border-width: 1px; border-color: root.pl-ink.with-alpha(0.22);
                        Rectangle {
                            x: 0; height: 100%; border-radius: 6px;
                            width: parent.width * root.vol-frac;
                            background: root.pl-accent;
                        }
                        Rectangle {
                            width: 16px; height: 16px; border-radius: 8px;
                            x: Math.clamp(parent.width * root.vol-frac - 8px,
                                0px, parent.width - 16px);
                            y: (parent.height - self.height) / 2;
                            background: Theme.dark ? #ffffff : root.pl-ink;
                            border-width: 2px; border-color: root.pl-accent;
                        }
                    }
                    // A drag used to push one mpv IPC command per mouse move.
                    // The knob now follows `vol-drag` locally and a timer
                    // flushes the real value ~11×/s.
                    vol := TouchArea {
                        x: 8px; width: parent.width - 16px;
                        mouse-cursor: pointer;
                        property <bool> dragged: false;
                        moved => {
                            if (self.pressed) {
                                self.dragged = true;
                                root.vol-drag = Math.clamp(self.mouse-x / self.width, 0.0, 1.0);
                                root.vol-dirty = true;
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) { self.dragged = false; }
                            if (e.kind == PointerEventKind.up) {
                                if (self.dragged && root.vol-drag >= 0) {
                                    root.set-volume(100 * root.vol-drag);
                                }
                                root.vol-drag = -1;
                                root.vol-dirty = false;
                            }
                        }
                        clicked => {
                            if (!self.dragged) {
                                root.set-volume(100 * Math.clamp(self.mouse-x / self.width, 0.0, 1.0));
                            }
                        }
                    }
                    Timer {
                        interval: 90ms; running: root.vol-dirty;
                        triggered => {
                            if (root.vol-drag >= 0) { root.set-volume(100 * root.vol-drag); }
                            root.vol-dirty = false;
                        }
                    }
                    // Percentage under the pointer — the value it would take on a
                    // click, or the one being dragged out right now.
                    if vol.has-hover: Rectangle {
                        property <float> at: 100 * (root.vol-drag >= 0 ? root.vol-drag
                            : Math.clamp(vol.mouse-x / vol.width, 0.0, 1.0));
                        x: Math.clamp(8px + vol.mouse-x - self.width / 2,
                            0px, parent.width - self.width);
                        y: (parent.height - self.height) / 2 - 28px;
                        width: volt.preferred-width + 16px; height: 22px;
                        border-radius: 11px;
                        background: root.pl-accent;
                        drop-shadow-blur: Surface.cast(10px);
                        drop-shadow-color: #00000088;
                        volt := Text { text: Math.round(parent.at) + "%"; color: #ffffff;
                            font-size: 11px; font-weight: 700;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2; }
                    }
                }
                WelBtn { icon: Icons.chevron-up; tip: "Zen mode";
                    accent: root.pl-accent; ink: root.pl-ink;
                    y: (parent.height - self.height) / 2; clicked => { root.open-zen(); } }
            }
        }

    }

}
