import { Theme, Accent } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";
import { PanelFrost } from "frost.slint";

export struct ScanProgress {
    section: string,
    label: string,
    total: int,
    added: int,
    failed: int,
    active: bool,
    last_error: string,
}

component ProgressRow inherits Skin {
    in property <ScanProgress> data;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    height: data.failed > 0 && data.last_error != "" ? 56px : 40px;

    VerticalLayout {
        padding: 4px; spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: data.label;
                color: Theme.text;
                font-size: 12px;
                font-weight: 600;
                width: 70px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text:
                    data.failed > 0
                        ? (data.added + " / " + data.total + " · " + data.failed + " failed")
                        : (data.added + " / " + data.total);
                color: data.failed > 0 ? #f97316 : Theme.text-dim;
                font-size: 11px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }

        // Bar
        Rectangle {
            height: 6px;
            horizontal-stretch: 1;
            border-radius: Surface.r(3px);
            background: Surface.body(Theme.panel-2);
            Rectangle {
                x: 0;
                width: data.total > 0
                    ? (parent.width * ((data.added + data.failed) / data.total))
                    : 0px;
                height: parent.height;
                border-radius: Surface.r(3px);
                background: data.active
                    ? @linear-gradient(90deg, Accent.color 0%, Accent.color.with-alpha(0.6) 100%)
                    : (data.failed > 0 ? #f97316 : #16a34a);
                animate width { duration: 220ms; easing: ease-out; }
            }
        }

        // Optional last-error subtitle.
        if data.failed > 0 && data.last_error != "": Text {
            text: data.last_error;
            color: #f97316;
            font-size: 10px;
            font-weight: 500;
            wrap: no-wrap;
            overflow: elide;
        }
    }
}

export component ScanProgressCard inherits Rectangle {
    in property <[ScanProgress]> rows: [];
    in property <bool> visible-flag: false;
    callback dismissed();

    visible: visible-flag;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    // Is any row still scanning?
    property <bool> any-active:
        (rows.length >= 1 && rows[0].active)
        || (rows.length >= 2 && rows[1].active)
        || (rows.length >= 3 && rows[2].active)
        || (rows.length >= 4 && rows[3].active);

    PanelFrost {
        accent: Accent.color;
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: 16px; spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: any-active ? "SCANNING…" : "SCAN COMPLETE";
                    color: any-active ? Accent.color : #16a34a;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1.4px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 24px; height: 24px;
                    horizontal-stretch: 0; vertical-stretch: 0;
                    border-radius: Surface.r(12px);
                    background: dismiss-ta.has-hover ? Theme.panel-2 : transparent;
                    border-width: 1px;
                    border-color: Surface.hairline;
                    Text {
                        text: "×";
                        color: Theme.text-dim;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    dismiss-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.dismissed(); }
                    }
                }
            }

            for r[i] in rows: ProgressRow {
                data: r;
            }
        }
    }
}
