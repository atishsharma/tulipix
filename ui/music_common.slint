// Shared music module — structs, the MusicState global, and shared components
// used across the 5 music sections (mymusic / podcasts / audiobooks / radio /
// youtube). Split out of page_music.slint so each section is its own file.

import { Theme } from "tokens.slint";
import { Surface } from "surface.slint";

// Every duration the music section animates on goes through here, so that
// `Theme.reduce-motion` is one switch instead of 116 literals. Slint has no
// arithmetic on `duration`, hence the explicit ladder rather than a scale
// factor. `stagger` is per-item delay, capped by the call site so page 4 of a
// big grid does not wait a second and a half to appear.
export global MusicMotion {
    out property <bool> off: Theme.reduce-motion;
    // Hover tints, icon fades — the 116 existing literals were 120–160ms.
    out property <duration> fast:    Theme.reduce-motion ?   0ms : 140ms;
    // Card lift, panel ease, tab-chip width.
    out property <duration> mid:     Theme.reduce-motion ?   0ms : 220ms;
    // View crossfade, album-art crossfade, entrance.
    out property <duration> slow:    Theme.reduce-motion ?   0ms : 320ms;
    // Skeleton shimmer sweep + now-playing breathe: long, looping, ambient.
    out property <duration> ambient: Theme.reduce-motion ?   0ms : 1400ms;
    // Scrubber catch-up. mpv reports `time-pos` about once a second, so a short
    // animation gives 70ms of motion and 930ms of stillness — visibly steppy.
    // Matching the poll exactly would read as continuous but make a click-seek
    // take a second to arrive; 400ms is the compromise. Linear, because easing
    // a clock lies about where playback is.
    out property <duration> tick:    Theme.reduce-motion ?   0ms : 400ms;
    out property <duration> stagger: Theme.reduce-motion ?   0ms :  30ms;
    // Entrance offset — the incoming view/card starts this far down.
    out property <length> rise: Theme.reduce-motion ? 0px : 12px;
}

// Three bars that dance while a track plays. This is the only ambient motion
// in the section that carries information rather than decoration: it marks the
// row you are hearing. Slint cannot loop an animation, so each bar animates
// between two heights on an `in-out` flag the page flips on a timer.
export component EqBars inherits Rectangle {
    in property <bool> on: true;
    in property <brush> tint: #ec4899;
    in property <bool> phase: false;   // driven by the page's shared Timer
    in property <length> bar-h: 14px;
    width: 14px;
    height: bar-h;
    HorizontalLayout {
        alignment: center; spacing: 2px;
        for f in [0.35, 1.0, 0.6]: Rectangle {
            width: 3px; border-radius: 1.5px; background: tint;
            // Paused → all three settle to the short height, so a paused row
            // still reads as "this one" without implying sound.
            height: !root.on ? root.bar-h * 0.3
                : (root.phase ? root.bar-h * f : root.bar-h * (1.1 - f));
            y: (parent.height - self.height) / 2;
            animate height { duration: MusicMotion.off ? 0ms : 380ms; easing: ease-in-out; }
        }
    }
}

// Album art that crossfades instead of popping when the track changes.
//
// Slint gives no access to a property's previous value, so this keeps both
// frames itself: on every change the NEW image is written into whichever slot
// is currently hidden, then the flag flips and the two opacities animate past
// each other. One `Image` would have to swap its source mid-fade, which is the
// pop this exists to remove.
export component ArtFade inherits Rectangle {
    in property <image> source;
    in property <duration> dur: MusicMotion.slow;
    property <image> a;
    property <image> b;
    property <bool> show-a: true;
    clip: true;
    init => { self.a = self.source; }
    changed source => {
        if (self.show-a) { self.b = self.source; self.show-a = false; }
        else            { self.a = self.source; self.show-a = true; }
    }
    Image { source: root.a; image-fit: cover; width: 100%; height: 100%;
        opacity: root.show-a ? 1 : 0; animate opacity { duration: root.dur; easing: ease-in-out; } }
    Image { source: root.b; image-fit: cover; width: 100%; height: 100%;
        opacity: root.show-a ? 0 : 1; animate opacity { duration: root.dur; easing: ease-in-out; } }
}

// Skeleton block for a not-yet-loaded card. A soft band sweeps across it on
// the same `phase` flag the EqBars use, so one timer drives both.
export component Shimmer inherits Rectangle {
    in property <bool> phase: false;
    border-radius: Surface.r(10px);
    background: #ffffff0c;
    clip: true;
    Rectangle {
        width: parent.width * 0.45;
        height: parent.height;
        x: root.phase ? parent.width : -self.width;
        background: @linear-gradient(90deg, #ffffff00, #ffffff18, #ffffff00);
        animate x { duration: MusicMotion.ambient; easing: ease-in-out; }
    }
}

// One row in the detailed Songs list (np.p4.music.browse — list view).
export struct MusicSongRow {
    thumb: image,
    title: string,
    artist: string,
    duration: string,
    index: int,        // playback position into music_paths
}

// One worker row in the Downloader tab (mdl): a track being fetched.
export struct DownloaderRow {
    title: string,
    length: string,    // "3:45" from provider metadata ("" when unknown)
    album: string,
    artists: [string], // all credited artists — main-artist dropdown model
    main-artist: string, // currently selected primary
    stage: string,     // queued|searching|downloading|tagging|done|skipped|failed
    percent: float,    // 0-100
    file: string,      // produced filename once done
    selected: bool,    // checkbox — only selected rows download
    thumb: image,      // album art preview ("" → note placeholder)
    abs-index: int,    // position in the full queue (rows may be a page window)
}

// One row in the Downloader → Download History popup.
export struct DlHistoryEntry {
    title: string,
    artists: string,   // "Main, Second, …"
    album: string,
    provider: string,
    when: string,      // "3h ago"
    path: string,      // abs file path — play / reveal target
}

// One row in the Downloader → Search History popup.
export struct DlSearchEntry {
    url: string,
    kind: string,      // track | album | playlist
    title: string,
    provider: string,
    when: string,
}

// One subscribed podcast shown as a card in the Podcasts grid
// (np.p5.music.podcast-feeds).
export struct PodcastCard {
    id: int,           // podcasts.id — drives open / fetch / unsubscribe
    title: string,
    author: string,
    category: string,
    image: image,
    unplayed: int,
    episodes: int,
    index: int,        // global position in the subscription list
    home-pinned: bool, // shown on Home "Your shows"
}

// One card on the Trends (hardcoded directory) page. Carries the feed URL +
// a subscribed flag so the card can flip to ✓ once added to the library.
export struct PodcastTrendCard {
    title: string,
    author: string,
    category: string,
    image: image,
    feed-url: string,
    subscribed: bool,
    index: int,        // position into the baked feed list (subscribe-by-index)
}

// One episode row — used in the detail page, the Home/Latest feed and the
// Downloads list.
export struct PodcastEpisodeRow {
    id: int,           // podcast_episodes.id (for the download-progress match)
    title: string,
    show: string,      // owning podcast title (shown in cross-show feeds)
    date: string,
    duration: string,
    image: image,
    played: bool,
    downloaded: bool,
    queued: bool,      // waiting in the sequential download queue
    dlinfo: string,    // short "when downloaded" stamp (Downloads list)
    index: int,        // position into the list's parallel episode-state vec
    progress: float,   // 0..1 through the episode (0 = untouched or no duration)
    up-next: bool,     // sitting in the cross-show play queue
}

// Rich Songs-list row — adds lyrics / fav / star columns.
export struct SongRowEx {
    thumb: image,
    title: string,
    artist: string,
    album: string,
    duration: string,
    index: int,
    loved: bool,
    stars: int,
    synced: bool,      // has synced lyrics in the DB
}

// One synchronized lyric line (np.p5.music.lyrics-synced).
export struct MusicLyricLine {
    time: string,      // "0:42" display stamp ("" for unsynced lines)
    text: string,
}

// One LRCLIB search candidate shown in the lyrics popup results list.
export struct LyricsResult {
    title: string,
    sub: string,       // "Artist · Album · 3:24"
    kind: string,      // "Synced" | "Normal"
}

// One row in the library-wide lyrics manager (np.p5.atmusic.lyrics-manager).
export struct LyricsMgrRow {
    title: string,
    artist: string,
    status: string,    // "Synced" | "Normal" | "Missing"
    index: int,        // playback position → find/store target
}

// One internet-radio station tile (np.p4.music.radio). `initial` is the
// pre-computed first letter for the no-favicon gradient tile (Slint has no
// substring), `quality` a pre-formatted "MP3 · 128k" badge ("" = unknown).
export struct RadioStation {
    uuid: string,        // radio-browser stationuuid / "custom:<url>"
    name: string,
    initial: string,
    tags: string,        // " · "-joined, pre-trimmed
    country: string,
    quality: string,
    icon: image,
    has-icon: bool,
    fav: bool,
    index: int,          // position into the current stations list
}

// One audiobook card in the Audiobooks grid — one per source folder
// (np.p5.music.audiobook-chapters). Books are grouped by their folder.
export struct BookCard {
    id: string,          // folder path (stable key for open/flag)
    title: string,       // folder basename
    author: string,
    cover: image,        // first chapter's art ("" → 📚 placeholder)
    chapters: int,
    total-time: string,  // pre-formatted, e.g. "8h 12m"
    resume-frac: float,  // 0..1 progress for the card bar
}

// One chapter row in the audiobook detail view.
export struct ChapterRow {
    title: string,
    duration: string,
    index: int,          // music-library position → audiobook-play target
    played: bool,        // listened before (not the current one) → dim colour
    current: bool,       // the chapter Resume restarts → red row
}

// One YouTube video — search result, channel grid, cached, downloaded, playlist
// item. `info` is the ≤100-char blurb; actions are handled by the card.
export struct YtVideo {
    id: string,
    channel-id: string,  // owning channel (recommended cards link to it; "" = unknown)
    title: string,
    channel: string,
    meta: string,        // pre-formatted "312K views · 8 yr ago"
    info: string,        // ≤100-char blurb
    duration: string,    // pre-formatted "4:12"
    thumb: image,
    index: int,          // position into the page's parallel video vec
    fmt: string,         // download container badge ("" = none)
    quality: string,     // download quality badge ("" = none)
    path: string,        // downloaded file path (unique per-resolution row id; "" = not a download)
    progress: float,     // 0..1 watched (0 = untouched or finished)
}

// One subscribed channel — Home right rail + Subscriptions grid.
export struct YtSub {
    channel-id: string,
    title: string,
    avatar: image,
    count: string,       // videos line, e.g. "142 videos" or "—"
    subs: string,        // subscribers line, e.g. "4.2M subscribers"
    subscribed: bool,    // my subscription status
    in-home: bool,       // pinned to the Home right rail
    index: int,
}

// One active/queued YouTube download (Downloads page progress list).
export struct YtDlJob {
    title: string,
    thumb: image,
    status: string,    // "Queued" | "Downloading 45%" | "Merging…"
    frac: float,       // 0..1
}

// One local YouTube playlist card.
export struct YtPlaylist {
    id: int,
    name: string,
    cover: image,
    sub: string,         // "24 videos · 1h 48m"
    index: int,
}

// One row in the library-wide metadata manager (np.p5.atmusic.metadata-manager).
export struct MetaMgrRow {
    file: string,      // filename stem (the parse source)
    title: string,     // current DB title
    artist: string,    // current DB artist
    album: string,     // current DB album
    status: string,    // "Pending" | "Matched" | "No match" | "Error"
    index: int,        // playback position → fetch target
}
