import { Theme } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";
import { ModalFrost } from "frost.slint";
import { AppIcon, Icons } from "icons.slint";

export struct ChatTurn { role: string, content: string }

export component ChatOverlay inherits Rectangle {
    in property <[ChatTurn]> turns;
    in-out property <bool> open: false;
    in-out property <string> draft: "";
    callback submit(string);
    callback close();

    width: 100%; height: 100%;
    background: #00000080;
    visible: open;

    if open: TouchArea { clicked => { root.open = false; root.close(); } }

    if open: ModalFrost {
        accent: Theme.brand;
        x: parent.width / 2 - 340px;
        y: parent.height / 2 - 280px;
        width: 680px; height: 560px;
        z: 300;

        VerticalLayout {
            padding: 18px; spacing: 10px;
            HorizontalLayout {
                HorizontalLayout { alignment: center; spacing: 6px; VerticalLayout { alignment: center; AppIcon { source: Icons.sparkles; tint: Theme.text; width: 16px; height: 16px; } } Text { text: "Chat"; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; } }
                Text { text: "Cmd/Ctrl+J"; color: Theme.text-dim; font-size: 11px; }
            }
            Rectangle {
                horizontal-stretch: 1; vertical-stretch: 1;
                border-radius: Surface.r(10px);
                background: Surface.body(Theme.panel);
                border-color: Surface.hairline; border-width: 1px;
                VerticalLayout {
                    padding: 10px; spacing: 8px;
                    for t in turns: Rectangle {
                        border-radius: Surface.r(8px);
                        background: t.role == "user" ? Theme.panel-2 : transparent;
                        VerticalLayout {
                            padding: 8px; spacing: 2px;
                            Text { text: t.role; color: Theme.text-dim; font-size: 10px; font-weight: 600; }
                            Text { text: t.content; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                }
            }
            Rectangle {
                height: 38px; border-radius: Surface.r(8px);
                background: Surface.body(Theme.panel-2);
                border-color: Surface.hairline; border-width: 1px;
                HorizontalLayout {
                    padding: 4px; spacing: 4px;
                    input := TextInput {
                        horizontal-stretch: 1;
                        font-size: 13px;
                        color: Theme.text;
                        text <=> root.draft;
                        accepted => { root.submit(root.draft); root.draft = ""; }
                    }
                    Rectangle {
                        width: 70px; border-radius: Surface.r(6px);
                        background: Theme.brand;
                        TouchArea { clicked => { root.submit(root.draft); root.draft = ""; } }
                        Text { text: "Send"; color: #ffffff; font-size: 12px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
