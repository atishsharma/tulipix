// Home layout 2 of 5 — COLUMNS. Spec: docs/home-layouts/02-columns.md.
//
// Eight full-height panes. One is open and shows real content; the rest are
// spines you read down — rotated name, count, a peek of artwork. Clicking a
// spine opens it, and the selection survives a restart (`home.columns.open`).
//
// Pane width is the only animated geometry in the app's Home layouts: switching
// a card off widens every survivor over 180 ms rather than leaving a gap.
import { Theme } from "tokens.slint";
import { Icons, AppIcon } from "icons.slint";
import { HomeStats, HomeRemote, HomeContinue } from "page_home.slint";
import { HomeDue } from "page_home_cinema.slint";
import { ThumbStrip, PlateStrip, EdChip } from "page_home_editorial.slint";

// ── Peek frame on a closed pane ─────────────────────────────────────────────
// Fills the spine's width so the artwork reads even at 104 px.
component PeekFrame inherits Rectangle {
    in property <image> shot;
    in property <color> accent;
    in property <image> glyph;
    clip: true;
    background: Theme.panel-2;
    if root.shot.width > 0: Image { source: root.shot; image-fit: cover;
        width: 100%; height: 100%; }
    if root.shot.width == 0: Rectangle {
        width: 100%; height: 100%;
        background: root.accent.with-alpha(0.14);
        AppIcon {
            source: root.glyph; tint: root.accent.with-alpha(0.75);
            width: 20px; height: 20px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        }
    }
}

// ── A pane ──────────────────────────────────────────────────────────────────
// Closed: a spine. Open: whatever the caller passed as children. Open content is
// gated with `visible` rather than `if` because `@children` cannot live inside a
// conditional — and it is one slot, used once.
component ColPane inherits Rectangle {
    in property <string> name;
    in property <string> count-label;
    in property <string> note;
    in property <image> icon;
    in property <color> accent;
    in property <bool> open: false;
    /// Past this width a spine's vertical name reads as a mistake, so the closed
    /// pane switches to a horizontal title (spec §Fluid rules, two panes left).
    in property <bool> wide-closed: false;
    in property <[image]> peek: [];
    callback select();
    border-radius: 0px;
    clip: true;
    background: root.open ? Theme.panel : (t.has-hover ? Theme.panel-2 : Theme.panel.with-alpha(0.55));
    border-width: 1px;
    border-color: root.open ? root.accent.with-alpha(0.42)
        : (t.has-hover ? root.accent.with-alpha(0.3) : Theme.outline);
    animate background, border-color { duration: 140ms; easing: ease-out; }
    t := TouchArea {
        mouse-cursor: root.open ? default : pointer;
        clicked => { if (!root.open) { root.select(); } }
    }
    // Accent cap along the top edge — the one bit of colour a resting spine has.
    Rectangle {
        width: 100%; height: root.open ? 3px : 2px;
        background: root.open ? root.accent : root.accent.with-alpha(0.65);
    }

    // ── Closed, narrow: the spine ───────────────────────────────────────────
    Rectangle {
        visible: !root.open && !root.wide-closed;
        width: 100%; height: 100%; background: transparent;
        AppIcon {
            source: root.icon; tint: root.accent;
            width: 18px; height: 18px;
            x: (parent.width - self.width) / 2; y: 18px;
        }
        // Peek: two frames stacked down the spine, inset 10 px.
        Rectangle {
            x: 10px; y: 48px;
            width: parent.width - 20px; height: 306px;
            background: transparent;
            for im[i] in root.peek: PeekFrame {
                shot: im; accent: root.accent; glyph: root.icon;
                x: 0; y: i * 156px;
                width: parent.width;
                // Only ever two: a third would push into the name track.
                height: i < 2 ? 150px : 0px;
                opacity: i < 2 ? 1.0 : 0.0;
            }
        }
        // Rotated name. Slint rotates about the element's centre, so the wrapper
        // carries an explicit size and the Text is sized to the *name track*
        // (210 px) before it turns — otherwise the glyph run lands off-pane.
        Rectangle {
            width: 26px; height: 210px;
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 46px;
            background: transparent;
            Text {
                text: root.name; color: Theme.text;
                font-size: 19px; font-weight: 700; letter-spacing: -0.4px;
                width: 210px; height: 26px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                transform-rotation: -90deg;
                horizontal-alignment: right; vertical-alignment: center;
                // Hard clip, no ellipsis: a "Finan…" spine reads as broken, a
                // clipped one reads as a spine.
                overflow: clip; wrap: no-wrap;
            }
        }
        Text {
            text: root.count-label; color: Theme.text-dim;
            font-size: 10.5px; font-weight: 600;
            width: parent.width; height: 14px;
            y: parent.height - 26px;
            horizontal-alignment: center; overflow: elide;
        }
    }

    // ── Closed, wide: horizontal title ──────────────────────────────────────
    Rectangle {
        visible: !root.open && root.wide-closed;
        width: 100%; height: 100%; background: transparent;
        VerticalLayout {
            padding: 16px; spacing: 12px; alignment: start;
            HorizontalLayout {
                spacing: 10px; height: 26px;
                AppIcon { source: root.icon; tint: root.accent; width: 18px; height: 18px;
                    horizontal-stretch: 0; y: (parent.height - self.height) / 2; }
                Text { text: root.name; color: Theme.text; font-size: 19px; font-weight: 700;
                    vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Text { text: root.count-label; color: Theme.text-dim; font-size: 11px;
                    vertical-alignment: center; horizontal-stretch: 0; }
            }
            Rectangle {
                height: 150px;
                background: transparent;
                for im[i] in root.peek: PeekFrame {
                    shot: im; accent: root.accent; glyph: root.icon;
                    y: 0; height: parent.height;
                    x: i * ((parent.width + 8px) / 2);
                    width: i < 2 ? (parent.width - 8px) / 2 : 0px;
                    opacity: i < 2 ? 1.0 : 0.0;
                }
            }
            Text { text: root.note; color: Theme.text-dim; font-size: 11px; overflow: elide; }
        }
    }

    // ── Open ────────────────────────────────────────────────────────────────
    Rectangle {
        visible: root.open;
        width: 100%; height: 100%; background: transparent;
        VerticalLayout {
            padding: 20px; padding-top: 22px; spacing: 16px;
            HorizontalLayout {
                spacing: 12px; height: 34px;
                Rectangle {
                    width: 34px; height: 34px; border-radius: 10px; horizontal-stretch: 0;
                    background: root.accent.with-alpha(0.18);
                    AppIcon { source: root.icon; tint: root.accent; width: 18px; height: 18px;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
                VerticalLayout {
                    alignment: center; spacing: 2px; horizontal-stretch: 1;
                    Text { text: root.name; color: Theme.text; font-size: 21px; font-weight: 700;
                        letter-spacing: -0.6px; overflow: elide; }
                    Text { text: root.note; color: Theme.text-dim; font-size: 11px; overflow: elide; }
                }
                Text {
                    text: root.count-label; color: Theme.text; font-size: 15px; font-weight: 700;
                    vertical-alignment: center; horizontal-stretch: 0;
                }
            }
            @children
        }
    }
}

// ── Small stat box inside an open pane ──────────────────────────────────────
component ColStat inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    in property <string> sub;
    in property <color> accent;
    border-radius: 12px;
    background: Theme.panel-2;
    border-width: 1px; border-color: Theme.outline;
    VerticalLayout {
        padding: 13px; spacing: 5px; alignment: start;
        Text { text: root.caption; color: root.accent; font-size: 9.5px; font-weight: 700;
            letter-spacing: 1.1px; }
        Text { text: root.value; color: Theme.text; font-size: 22px; font-weight: 700;
            letter-spacing: -0.8px; overflow: elide; }
        Text { text: root.sub; color: Theme.text-dim; font-size: 10.5px; overflow: elide; }
    }
}

// ── One resume row in the open pane ─────────────────────────────────────────
component ColResume inherits Rectangle {
    in property <HomeContinue> data;
    in property <color> accent;
    callback open();
    height: 46px;
    border-radius: 10px;
    background: t.has-hover ? Theme.glass : transparent;
    animate background { duration: 110ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
    HorizontalLayout {
        padding-left: 8px; padding-right: 10px; spacing: 10px; alignment: start;
        Rectangle {
            width: 30px; height: 30px; border-radius: 7px; clip: true; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            background: root.accent.with-alpha(0.16);
            if root.data.cover.width > 0: Image { source: root.data.cover; image-fit: cover;
                width: 100%; height: 100%; }
        }
        VerticalLayout {
            alignment: center; spacing: 3px; horizontal-stretch: 1;
            Text { text: root.data.title; color: Theme.text; font-size: 12px; font-weight: 600;
                overflow: elide; }
            Rectangle {
                height: 3px; border-radius: 2px;
                background: Theme.text.with-alpha(0.16);
                opacity: root.data.frac >= 0 ? 1.0 : 0.0;
                Rectangle {
                    width: parent.width * Math.max(0.0, Math.min(1.0, root.data.frac));
                    height: 100%; border-radius: 2px; background: root.accent;
                }
            }
        }
        AppIcon {
            source: Icons.play; tint: t.has-hover ? root.accent : Theme.text-dim;
            width: 13px; height: 13px; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
        }
    }
}

export component HomeColumns inherits Rectangle {
    // ── Top bar ─────────────────────────────────────────────────────────────
    in property <string> greeting: "Welcome";
    in property <string> date-line: "";
    in property <string> library-line: "";
    // ── Pane data ───────────────────────────────────────────────────────────
    in property <HomeStats> stats;
    in property <[image]> recent-photos: [];
    in property <[image]> recent-videos: [];
    in property <[image]> book-covers: [];
    in property <[HomeRemote]> cloud-remotes: [];
    in property <[HomeContinue]> continue-rows: [];
    in property <string> fin-spent: "";
    in property <string> fin-month: "";
    in property <string> fin-liquid: "";
    in property <[float]> fin-months: [];
    in property <[HomeDue]> fin-dues: [];
    in property <string> transfer-inbox: "";
    in property <image> np-art;
    in property <string> np-title: "";
    in property <string> np-sub: "";
    /// Which pane is open. Resolved in Rust so it can never name a hidden pane.
    in property <string> open-pane: "photos";
    // ── Card visibility ─────────────────────────────────────────────────────
    in property <bool> hc-photos: true;
    in property <bool> hc-videos: true;
    in property <bool> hc-music: true;
    in property <bool> hc-books: true;
    in property <bool> hc-cloud: true;
    in property <bool> hc-tools: true;
    in property <bool> hc-transfer: true;
    in property <bool> hc-finances: true;

    callback open-section(string);
    callback open-search();
    callback open-tool(string);
    callback open-remote(string);
    callback continue-open(HomeContinue);
    callback start-sharing();
    callback pane-open(string);

    // ── Geometry (spec §Geometry) ───────────────────────────────────────────
    property <length> pad: 14px;
    property <length> bar-h: 70px;
    property <length> gap: 6px;
    property <int> panes: (root.hc-photos ? 1 : 0) + (root.hc-videos ? 1 : 0)
        + (root.hc-music ? 1 : 0) + (root.hc-books ? 1 : 0)
        + (root.hc-cloud ? 1 : 0) + (root.hc-tools ? 1 : 0)
        + (root.hc-transfer ? 1 : 0) + (root.hc-finances ? 1 : 0);
    property <length> avail: root.width - 2 * root.pad
        - root.gap * Math.max(0, root.panes - 1);
    // The open pane takes what the spines do not need, and never drops below the
    // width its content was designed for.
    property <length> open-w: root.panes <= 1 ? root.avail
        : Math.max(460px, root.avail - (root.panes - 1) * 96px);
    property <length> closed-w: root.panes <= 1 ? 0px
        : (root.avail - root.open-w) / (root.panes - 1);
    // Past 260 px a spine's rotated name reads as a mistake.
    property <bool> wide: root.closed-w >= 260px;
    property <bool> fin-late: root.fin-dues.length > 0 && root.fin-dues[0].late;

    background: Theme.bg;
    clip: true;

    // ── Top bar ─────────────────────────────────────────────────────────────
    HorizontalLayout {
        x: root.pad; y: 16px; width: root.width - 2 * root.pad; height: 34px;
        spacing: 14px; alignment: start;
        VerticalLayout {
            alignment: center; spacing: 1px; horizontal-stretch: 1;
            Text { text: root.greeting; color: Theme.text; font-size: 22px; font-weight: 700;
                letter-spacing: -0.8px; overflow: elide; }
            Text { text: root.date-line + (root.library-line == "" ? "" : " · " + root.library-line);
                color: Theme.text-dim; font-size: 11px; overflow: elide; }
        }
        // One late bill is the only thing allowed to interrupt the bar.
        if root.hc-finances && root.fin-late: EdChip {
            label: root.fin-dues[0].name; value: root.fin-dues[0].when;
            accent: Theme.sec-finances; dot: true; late: true;
            horizontal-stretch: 0; y: (parent.height - self.height) / 2;
            TouchArea { mouse-cursor: pointer; clicked => { root.open-section("finances"); } }
        }
        Rectangle {
            width: 96px; height: 30px; border-radius: 15px; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            background: sb.has-hover ? Theme.glass-strong : Theme.glass;
            border-width: 1px; border-color: Theme.glass-border;
            sb := TouchArea { mouse-cursor: pointer; clicked => { root.open-search(); } }
            HorizontalLayout {
                spacing: 7px; alignment: center;
                AppIcon { source: Icons.search; tint: Theme.text-dim; width: 13px; height: 13px;
                    y: (parent.height - self.height) / 2; }
                Text { text: "Search"; color: Theme.text-dim; font-size: 11px;
                    vertical-alignment: center; }
            }
        }
    }

    // ── Panes ───────────────────────────────────────────────────────────────
    HorizontalLayout {
        x: root.pad; y: root.bar-h;
        width: root.width - 2 * root.pad;
        height: root.height - root.bar-h - root.pad;
        spacing: root.gap; alignment: start;

        if root.hc-photos: ColPane {
            name: "Photos"; icon: Icons.image; accent: Theme.sec-photos;
            count-label: root.stats.photos + "";
            note: root.stats.photos-albums + " albums";
            peek: root.recent-photos;
            open: root.open-pane == "photos";
            wide-closed: root.wide;
            width: root.open-pane == "photos" ? root.open-w : root.closed-w;
            horizontal-stretch: 0;
            animate width { duration: 180ms; easing: ease-out; }
            select => { root.pane-open("photos"); }
            // Open content: the newest frames, then the two facts worth a number.
            Rectangle {
                height: 168px;
                ThumbStrip {
                    shots: root.recent-photos; accent: Theme.sec-photos;
                    tw: 168px; th: 118px;
                    width: 100%; height: 100%;
                }
            }
            HorizontalLayout {
                height: 96px; spacing: 10px;
                ColStat { caption: "ITEMS"; accent: Theme.sec-photos;
                    value: root.stats.photos + ""; sub: "in the library"; }
                ColStat { caption: "ALBUMS"; accent: Theme.sec-photos;
                    value: root.stats.photos-albums + ""; sub: root.stats.photos-scan; }
            }
            Rectangle { vertical-stretch: 1; }
            ColStat { caption: "OPEN"; accent: Theme.sec-photos; value: "Photos";
                sub: "Timeline, albums, editor"; height: 84px;
                TouchArea { mouse-cursor: pointer; clicked => { root.open-section("photos"); } } }
        }

        if root.hc-videos: ColPane {
            name: "Videos"; icon: Icons.film; accent: Theme.sec-videos;
            count-label: root.stats.videos + "";
            note: root.stats.videos-shows + " shows";
            peek: root.recent-videos;
            open: root.open-pane == "videos";
            wide-closed: root.wide;
            width: root.open-pane == "videos" ? root.open-w : root.closed-w;
            horizontal-stretch: 0;
            animate width { duration: 180ms; easing: ease-out; }
            select => { root.pane-open("videos"); }
            Rectangle {
                height: 168px;
                ThumbStrip {
                    shots: root.recent-videos; accent: Theme.sec-videos;
                    tw: 168px; th: 118px;
                    width: 100%; height: 100%;
                }
            }
            // RESUME — the same rows the Continue strip shows, video only.
            Text { text: "RESUME"; color: Theme.sec-videos; font-size: 9.5px; font-weight: 700;
                letter-spacing: 1.1px; height: 13px; }
            VerticalLayout {
                spacing: 2px;
                for c in root.continue-rows: ColResume {
                    data: c; accent: Theme.sec-videos;
                    // A layout keeps a zero-height child's spacing, but 2 px of
                    // slack beats a repeater with an `if` inside it.
                    height: c.kind == "video" ? 46px : 0px;
                    opacity: c.kind == "video" ? 1.0 : 0.0;
                    open => { root.continue-open(c); }
                }
            }
            Rectangle { vertical-stretch: 1; }
            ColStat { caption: "OPEN"; accent: Theme.sec-videos; value: "Videos";
                sub: "Library, shows, streams"; height: 84px;
                TouchArea { mouse-cursor: pointer; clicked => { root.open-section("videos"); } } }
        }

        if root.hc-music: ColPane {
            name: "Music"; icon: Icons.music; accent: Theme.sec-music;
            count-label: root.stats.songs + "";
            note: root.stats.podcasts + " podcasts · " + root.stats.radio + " stations";
            open: root.open-pane == "music";
            wide-closed: root.wide;
            width: root.open-pane == "music" ? root.open-w : root.closed-w;
            horizontal-stretch: 0;
            animate width { duration: 180ms; easing: ease-out; }
            select => { root.pane-open("music"); }
            // Now playing, then the plates — Music has no cover feed on Home.
            Rectangle {
                height: 74px; border-radius: 12px;
                background: Theme.panel-2;
                border-width: 1px; border-color: Theme.outline;
                HorizontalLayout {
                    padding: 12px; spacing: 12px; alignment: start;
                    Rectangle {
                        width: 50px; height: 50px; border-radius: 25px; clip: true;
                        horizontal-stretch: 0;
                        background: Theme.sec-music.with-alpha(0.2);
                        if root.np-art.width > 0: Image { source: root.np-art; image-fit: cover;
                            width: 100%; height: 100%; }
                        if root.np-art.width == 0: AppIcon { source: Icons.music;
                            tint: Theme.sec-music; width: 18px; height: 18px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2; }
                    }
                    VerticalLayout {
                        alignment: center; spacing: 3px; horizontal-stretch: 1;
                        Text { text: root.np-title == "" ? "Nothing playing" : root.np-title;
                            color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { text: root.np-title == "" ? "Pick something in Music" : root.np-sub;
                            color: Theme.text-dim; font-size: 10.5px; overflow: elide; }
                    }
                }
            }
            Rectangle {
                height: 64px;
                PlateStrip { lead: root.np-art; accent: Theme.sec-music; tw: 58px;
                    width: 100%; height: 100%; }
            }
            HorizontalLayout {
                height: 96px; spacing: 10px;
                ColStat { caption: "TRACKS"; accent: Theme.sec-music;
                    value: root.stats.songs + ""; sub: "in the library"; }
                ColStat { caption: "AUDIOBOOKS"; accent: Theme.sec-music;
                    value: root.stats.audiobooks + ""; sub: root.stats.podcasts + " podcasts"; }
            }
            Rectangle { vertical-stretch: 1; }
            ColStat { caption: "OPEN"; accent: Theme.sec-music; value: "Music";
                sub: "Library, radio, podcasts, YouTube"; height: 84px;
                TouchArea { mouse-cursor: pointer; clicked => { root.open-section("music"); } } }
        }

        if root.hc-books: ColPane {
            name: "Books"; icon: Icons.book-open; accent: Theme.sec-books;
            count-label: root.stats.books + "";
            note: root.stats.books-reading + " in progress";
            peek: root.book-covers;
            open: root.open-pane == "books";
            wide-closed: root.wide;
            width: root.open-pane == "books" ? root.open-w : root.closed-w;
            horizontal-stretch: 0;
            animate width { duration: 180ms; easing: ease-out; }
            select => { root.pane-open("books"); }
            Rectangle {
                height: 190px;
                ThumbStrip {
                    shots: root.book-covers; accent: Theme.sec-books;
                    tw: 124px; th: 182px;
                    width: 100%; height: 100%;
                }
            }
            Text { text: "READING"; color: Theme.sec-books; font-size: 9.5px; font-weight: 700;
                letter-spacing: 1.1px; height: 13px; }
            VerticalLayout {
                spacing: 2px;
                for c in root.continue-rows: ColResume {
                    data: c; accent: Theme.sec-books;
                    height: c.kind == "book" || c.kind == "audiobook" ? 46px : 0px;
                    opacity: c.kind == "book" || c.kind == "audiobook" ? 1.0 : 0.0;
                    open => { root.continue-open(c); }
                }
            }
            Rectangle { vertical-stretch: 1; }
            ColStat { caption: "OPEN"; accent: Theme.sec-books; value: "Books";
                sub: "Shelf, reader, audiobooks"; height: 84px;
                TouchArea { mouse-cursor: pointer; clicked => { root.open-section("books"); } } }
        }

        if root.hc-cloud: ColPane {
            name: "Cloud"; icon: Icons.cloud; accent: Theme.sec-cloud;
            count-label: root.stats.cloud-remotes + "";
            note: root.cloud-remotes.length == 0 ? "No remotes configured" : "rclone";
            open: root.open-pane == "cloud";
            wide-closed: root.wide;
            width: root.open-pane == "cloud" ? root.open-w : root.closed-w;
            horizontal-stretch: 0;
            animate width { duration: 180ms; easing: ease-out; }
            select => { root.pane-open("cloud"); }
            // The remotes themselves, one row each — the pane's whole content.
            VerticalLayout {
                spacing: 6px;
                for r in root.cloud-remotes: Rectangle {
                    height: 52px; border-radius: 11px;
                    background: rt.has-hover ? Theme.panel-2 : transparent;
                    border-width: 1px; border-color: Theme.outline;
                    animate background { duration: 110ms; easing: ease-out; }
                    rt := TouchArea { mouse-cursor: pointer;
                        clicked => { root.open-remote(r.name); } }
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 10px; alignment: start;
                        Rectangle {
                            width: 8px; height: 8px; border-radius: 4px; horizontal-stretch: 0;
                            y: (parent.height - self.height) / 2;
                            background: Theme.sec-cloud;
                        }
                        VerticalLayout {
                            alignment: center; spacing: 2px; horizontal-stretch: 1;
                            Text { text: r.name; color: Theme.text; font-size: 12.5px;
                                font-weight: 600; overflow: elide; }
                            Text { text: r.backend; color: Theme.text-dim; font-size: 10px;
                                overflow: elide; }
                        }
                        Text { text: r.usage; color: Theme.text; font-size: 12px; font-weight: 600;
                            vertical-alignment: center; horizontal-stretch: 0; }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            ColStat { caption: "OPEN"; accent: Theme.sec-cloud; value: "Cloud";
                sub: "Browse, sync, mount"; height: 84px;
                TouchArea { mouse-cursor: pointer; clicked => { root.open-section("cloud"); } } }
        }

        if root.hc-tools: ColPane {
            name: "Tools"; icon: Icons.wrench; accent: Theme.sec-tools;
            count-label: root.stats.tools-jobs + "";
            note: root.stats.tools-note == "" ? "Nothing queued" : root.stats.tools-note;
            open: root.open-pane == "tools";
            wide-closed: root.wide;
            width: root.open-pane == "tools" ? root.open-w : root.closed-w;
            horizontal-stretch: 0;
            animate width { duration: 180ms; easing: ease-out; }
            select => { root.pane-open("tools"); }
            // The four categories, as the things you actually click.
            VerticalLayout {
                spacing: 8px;
                for c in [
                    { id: "convert", label: "Convert", sub: "Video, audio, images" },
                    { id: "compress", label: "Compress", sub: "Shrink without the guesswork" },
                    { id: "subtitles", label: "Subtitles", sub: "Extract, embed, sync" },
                    { id: "metadata", label: "Metadata", sub: "Tags, covers, rename" },
                ]: Rectangle {
                    height: 58px; border-radius: 11px;
                    background: ct.has-hover ? Theme.panel-2 : transparent;
                    border-width: 1px; border-color: Theme.outline;
                    animate background { duration: 110ms; easing: ease-out; }
                    ct := TouchArea { mouse-cursor: pointer; clicked => { root.open-tool(c.id); } }
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 11px; alignment: start;
                        AppIcon { source: Icons.wrench; tint: Theme.sec-tools;
                            width: 15px; height: 15px; horizontal-stretch: 0;
                            y: (parent.height - self.height) / 2; }
                        VerticalLayout {
                            alignment: center; spacing: 2px; horizontal-stretch: 1;
                            Text { text: c.label; color: Theme.text; font-size: 12.5px;
                                font-weight: 600; }
                            Text { text: c.sub; color: Theme.text-dim; font-size: 10px;
                                overflow: elide; }
                        }
                        AppIcon { source: Icons.arrow-right; tint: Theme.text-dim;
                            width: 14px; height: 14px; horizontal-stretch: 0;
                            y: (parent.height - self.height) / 2; }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            ColStat { caption: "OPEN"; accent: Theme.sec-tools; value: "Tools";
                sub: root.stats.tools-jobs + " jobs run"; height: 84px;
                TouchArea { mouse-cursor: pointer; clicked => { root.open-section("tools"); } } }
        }

        if root.hc-transfer: ColPane {
            name: "Transfer"; icon: Icons.share; accent: Theme.sec-transfer;
            count-label: "—";
            note: "Open to pair";
            open: root.open-pane == "transfer";
            wide-closed: root.wide;
            width: root.open-pane == "transfer" ? root.open-w : root.closed-w;
            horizontal-stretch: 0;
            animate width { duration: 180ms; easing: ease-out; }
            select => { root.pane-open("transfer"); }
            // A door, not a dashboard: the server only binds while the Transfer
            // section is open, so this pane offers the action and the facts.
            Rectangle {
                height: 44px; border-radius: 22px; horizontal-stretch: 0;
                width: 158px;
                background: @linear-gradient(140deg, Theme.transfer-accent, Theme.transfer-accent-2);
                sh := TouchArea { mouse-cursor: pointer; clicked => { root.start-sharing(); } }
                HorizontalLayout {
                    spacing: 8px; alignment: center;
                    AppIcon { source: Icons.zap; tint: #231000; width: 15px; height: 15px;
                        y: (parent.height - self.height) / 2; }
                    Text { text: "Start sharing"; color: #231000; font-size: 12.5px;
                        font-weight: 700; vertical-alignment: center; }
                }
            }
            ColStat { caption: "INBOX"; accent: Theme.sec-transfer; height: 84px;
                value: root.transfer-inbox == "" ? "Not set" : "Ready";
                sub: root.transfer-inbox == "" ? "Pick a folder in Transfer"
                    : root.transfer-inbox; }
            Text {
                text: "Pairing runs on your local network only. Nothing leaves the house, "
                    + "and nothing is stored in the cloud.";
                color: Theme.text-dim; font-size: 11px; wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            ColStat { caption: "OPEN"; accent: Theme.sec-transfer; value: "Transfer";
                sub: "Pair a device, send, receive"; height: 84px;
                TouchArea { mouse-cursor: pointer; clicked => { root.open-section("transfer"); } } }
        }

        if root.hc-finances: ColPane {
            name: "Finances"; icon: Icons.wallet; accent: Theme.sec-finances;
            count-label: root.fin-spent == "" ? "—" : root.fin-spent;
            note: root.fin-month == "" ? "This month" : root.fin-month;
            open: root.open-pane == "finances";
            wide-closed: root.wide;
            width: root.open-pane == "finances" ? root.open-w : root.closed-w;
            horizontal-stretch: 0;
            animate width { duration: 180ms; easing: ease-out; }
            select => { root.pane-open("finances"); }
            HorizontalLayout {
                height: 96px; spacing: 10px;
                ColStat { caption: "SPENT"; accent: Theme.sec-finances;
                    value: root.fin-spent == "" ? "—" : root.fin-spent; sub: root.fin-month; }
                ColStat { caption: "LIQUID"; accent: Theme.sec-finances;
                    value: root.fin-liquid == "" ? "—" : root.fin-liquid; sub: "across accounts"; }
            }
            // Twelve months, newest last.
            Rectangle {
                height: 74px; border-radius: 12px;
                background: Theme.panel-2;
                border-width: 1px; border-color: Theme.outline;
                HorizontalLayout {
                    padding: 12px; spacing: 4px;
                    for m[i] in root.fin-months: Rectangle {
                        border-radius: 2px;
                        y: parent.height - self.height;
                        height: Math.max(2px, parent.height * Math.max(0.04, m));
                        background: i == root.fin-months.length - 1
                            ? Theme.sec-finances : Theme.sec-finances.with-alpha(0.32);
                    }
                }
            }
            Text { text: "NEEDS YOU"; color: Theme.sec-finances; font-size: 9.5px;
                font-weight: 700; letter-spacing: 1.1px; height: 13px; }
            VerticalLayout {
                spacing: 6px;
                for d in root.fin-dues: HorizontalLayout {
                    height: 34px; spacing: 9px;
                    Rectangle {
                        width: 7px; height: 7px; border-radius: 4px; horizontal-stretch: 0;
                        y: (parent.height - self.height) / 2;
                        background: d.late ? Theme.error : Theme.warn;
                    }
                    Text { text: d.name; color: Theme.text; font-size: 12px;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: d.amount; color: Theme.text; font-size: 12px; font-weight: 600;
                        vertical-alignment: center; horizontal-stretch: 0; }
                    Text { text: d.when; color: d.late ? Theme.error : Theme.text-dim;
                        font-size: 10px; vertical-alignment: center;
                        horizontal-alignment: right; width: 62px; horizontal-stretch: 0; }
                }
            }
            Rectangle { vertical-stretch: 1; }
            ColStat { caption: "OPEN"; accent: Theme.sec-finances; value: "Finances";
                sub: "Spending, budgets, planning"; height: 84px;
                TouchArea { mouse-cursor: pointer; clicked => { root.open-section("finances"); } } }
        }
    }
}
