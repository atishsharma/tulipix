import { Theme } from "tokens.slint";
import { ModalFrost } from "frost.slint";

export component ErrorBoundary inherits Rectangle {
    in property <string> title: "Something went wrong";
    in property <string> message: "";
    in property <string> log-tail: "";
    in-out property <bool> open: false;
    callback open-logs();
    callback reload();
    callback quit();

    width: 100%; height: 100%;
    background: #00000099;
    visible: open;

    if open: ModalFrost {
        accent: #dc2626;
        x: parent.width / 2 - 280px;
        y: parent.height / 2 - 220px;
        width: 560px; height: 440px;
        z: 500;
        VerticalLayout {
            padding: 24px; spacing: 12px;
            Text { text: "⚠  " + title; color: Theme.text; font-size: 20px; font-weight: 700; }
            Text { text: message; color: Theme.text-dim; font-size: 13px; }
            Rectangle {
                horizontal-stretch: 1; vertical-stretch: 1;
                border-radius: 8px;
                background: Theme.panel;
                border-color: Theme.outline; border-width: 1px;
                Text {
                    text: log-tail; color: Theme.text-dim;
                    font-size: 11px; font-family: "monospace";
                    x: 10px; y: 8px;
                    width: parent.width - 20px;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                Rectangle { width: 110px; height: 30px; border-radius: 8px;
                    background: Theme.panel-2; border-color: Theme.outline; border-width: 1px;
                    TouchArea { clicked => { root.open-logs(); } }
                    Text { text: "Open Logs"; color: Theme.text; font-size: 12px;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle { width: 80px; height: 30px; border-radius: 8px;
                    background: Theme.panel-2; border-color: Theme.outline; border-width: 1px;
                    TouchArea { clicked => { root.reload(); } }
                    Text { text: "Reload"; color: Theme.text; font-size: 12px;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle { width: 80px; height: 30px; border-radius: 8px;
                    background: #dc2626;
                    TouchArea { clicked => { root.quit(); } }
                    Text { text: "Quit"; color: #ffffff; font-size: 12px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
