import { Theme } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";
import { ModalFrost } from "frost.slint";
import { AppIcon, Icons } from "icons.slint";

export component ErrorBoundary inherits Rectangle {
    in property <string> title: "Something went wrong";
    in property <string> message: "";
    in property <string> log-tail: "";
    in-out property <bool> open: false;
    callback open-logs();
    callback reload();
    callback quit();

    width: 100%; height: 100%;
    background: #00000099;
    visible: open;

    if open: ModalFrost {
        accent: #dc2626;
        x: parent.width / 2 - 280px;
        y: parent.height / 2 - 220px;
        width: 560px; height: 440px;
        z: 500;
        VerticalLayout {
            padding: 24px; spacing: 12px;
            HorizontalLayout { spacing: 8px; VerticalLayout { alignment: center; AppIcon { source: Icons.triangle-alert; tint: Theme.text; width: 20px; height: 20px; } } Text { text: title; color: Theme.text; font-size: 20px; font-weight: 700; vertical-alignment: center; } }
            Text { text: message; color: Theme.text-dim; font-size: 13px; }
            Rectangle {
                horizontal-stretch: 1; vertical-stretch: 1;
                border-radius: Surface.rr(8px, self.width, self.height);
                background: Surface.body(Theme.panel);
                border-color: Surface.hairline; border-width: 1px;
                Text {
                    text: log-tail; color: Theme.text-dim;
                    font-size: 11px; font-family: "monospace";
                    x: 10px; y: 8px;
                    width: parent.width - 20px;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                Rectangle { width: 110px; height: 30px; border-radius: Surface.rr(8px, self.width, self.height);
                    background: Surface.body(Theme.panel-2); border-color: Surface.hairline; border-width: 1px;
                    TouchArea { clicked => { root.open-logs(); } }
                    Text { text: "Open Logs"; color: Theme.text; font-size: 12px;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle { width: 80px; height: 30px; border-radius: Surface.rr(8px, self.width, self.height);
                    background: Surface.body(Theme.panel-2); border-color: Surface.hairline; border-width: 1px;
                    TouchArea { clicked => { root.reload(); } }
                    Text { text: "Reload"; color: Theme.text; font-size: 12px;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle { width: 80px; height: 30px; border-radius: Surface.rr(8px, self.width, self.height);
                    background: #dc2626;
                    TouchArea { clicked => { root.quit(); } }
                    Text { text: "Quit"; color: #ffffff; font-size: 12px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
