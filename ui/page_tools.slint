// Tools section — a utilitarian control center. Two-tier header (Photos
// pattern): row 1 title · search · queue-status pill; row 2 category tabs
// (File ops · Video · Audio · Photo · Subtitles · Queue). Picking a tab shows
// that category's ops; the search filters ops across every category.
import { Theme } from "tokens.slint";
import { ScrollView } from "std-widgets.slint";
import { HdrChip, HdrSearch, CountPill } from "section_header.slint";

// One operation row in the detail body. `cat` is shown only in search results.
export struct ToolOpRow { cat: string, label: string }

component OpRow inherits Rectangle {
    in property <ToolOpRow> op;
    in property <bool> show-cat: false;
    in property <color> tint;
    callback clicked();
    height: 56px; horizontal-stretch: 1; border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.panel-2 : Theme.panel;
    border-width: 1px; border-color: touch.has-hover ? tint : Theme.outline;
    animate border-color { duration: 140ms; easing: ease-out; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 16px; padding-right: 16px; spacing: 12px;
        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: tint;
            horizontal-stretch: 0; vertical-stretch: 0; y: (parent.height - self.height) / 2; }
        VerticalLayout { alignment: center; horizontal-stretch: 1;
            Text { text: op.label; color: Theme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; } }
        if show-cat: VerticalLayout { alignment: center; horizontal-stretch: 0;
            Text { text: op.cat; color: Theme.text-dim; font-size: 11px; font-weight: 600; vertical-alignment: center; } }
    }
}

export component ToolsPage inherits Rectangle {
    in-out property <string> category: "fileops";
    in-out property <string> query: "";
    in property <string> cat-title: "File ops";
    in property <string> cat-icon: "📁";
    in property <[ToolOpRow]> op-rows: [];      // body rows (current category, or search matches)
    in property <string> queue-status: "Idle";  // queue summary for the count pill
    callback open-tool(string);
    callback set-category(string);
    callback search(string);

    property <color> accent: #14b8a6;
    background: transparent;

    VerticalLayout {
        spacing: 0px;

        // Row 1 — title · search · queue pill.
        Rectangle {
            height: 72px; horizontal-stretch: 1; background: Theme.panel;
            border-width: 1px; border-color: Theme.outline;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; spacing: 14px;
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Text { text: "Tools"; color: Theme.text; font-size: 22px; font-weight: 700; } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    HdrSearch { width: 360px; dark: true; placeholder: "Find a tool";
                        query <=> root.query; edited(q) => { root.search(q); } } }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    CountPill { accent: root.accent; seg1: "⚙ " + root.queue-status; } }
            }
        }

        // Row 2 — category tabs.
        Rectangle {
            height: 54px; horizontal-stretch: 1; background: Theme.panel;
            border-width: 1px; border-color: Theme.outline;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; spacing: 8px; alignment: start;
                VerticalLayout { alignment: center; HdrChip { label: "📁 File ops";  min-width: 104px; dark: true; accent: root.accent; active: category == "fileops"; clicked => { root.set-category("fileops"); } } }
                VerticalLayout { alignment: center; HdrChip { label: "🎬 Video";     min-width: 92px;  dark: true; accent: root.accent; active: category == "video";   clicked => { root.set-category("video"); } } }
                VerticalLayout { alignment: center; HdrChip { label: "🎵 Audio";     min-width: 92px;  dark: true; accent: root.accent; active: category == "audio";   clicked => { root.set-category("audio"); } } }
                VerticalLayout { alignment: center; HdrChip { label: "🖼 Photo";     min-width: 92px;  dark: true; accent: root.accent; active: category == "photo";   clicked => { root.set-category("photo"); } } }
                VerticalLayout { alignment: center; HdrChip { label: "💬 Subtitles"; min-width: 104px; dark: true; accent: root.accent; active: category == "subs";    clicked => { root.set-category("subs"); } } }
                VerticalLayout { alignment: center; HdrChip { label: "⚙ Queue";      min-width: 92px;  dark: true; accent: root.accent; active: category == "queue";   clicked => { root.set-category("queue"); } } }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Body — detail list for the selected category (or search results).
        ScrollView {
            vertical-stretch: 1; horizontal-stretch: 1;
            VerticalLayout {
                padding: 32px; padding-top: 24px; spacing: 14px; alignment: start;
                HorizontalLayout {
                    spacing: 12px; alignment: start;
                    Rectangle { width: 44px; height: 44px; border-radius: 12px;
                        horizontal-stretch: 0; vertical-stretch: 0;
                        background: root.accent.with-alpha(0.16);
                        Text { text: root.query == "" ? root.cat-icon : "🔍"; font-size: 22px;
                            horizontal-alignment: center; vertical-alignment: center; } }
                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                        Text { text: root.query == "" ? root.cat-title : "Results for “" + root.query + "”";
                            color: Theme.text; font-size: 18px; font-weight: 700; }
                        Text { text: root.op-rows.length + (root.op-rows.length == 1 ? " operation" : " operations");
                            color: Theme.text-dim; font-size: 12px; } }
                }
                for op[i] in root.op-rows: OpRow {
                    op: op; tint: root.accent; show-cat: root.query != "";
                    clicked => { root.open-tool(op.label); }
                }
                if root.op-rows.length == 0: Text {
                    text: root.query == "" ? "No operations in this category."
                                           : "No tools match “" + root.query + "”.";
                    color: Theme.text-dim; font-size: 13px;
                }
            }
        }
    }
}
