// Tools section — a utilitarian control center, redesigned.
//
// Header: row1 (title · search · status pill showing the selected tool + its
// live progress); row2 category tabs; row3 a horizontal tool bar that splits
// the row into equal segments for the category's ops. Picking a tool opens its
// inline form full-width below. The Queue tab lists live jobs with progress +
// pause/resume/cancel/retry/remove/reorder (destructive actions confirm, with
// mouse + Enter). The Settings tab reports which external tools are available.
//
// Identity: amber→orange gradient (Theme.tools-accent → tools-accent-2). All
// text uses theme-aware Theme.* colors so light + dark both read cleanly.
import { Theme } from "tokens.slint";
import { ScrollView, LineEdit, ComboBox, Slider, Switch } from "std-widgets.slint";
import { HdrChip, HdrSearch, CountPill } from "section_header.slint";
import { AppIcon, Icons } from "icons.slint";

export struct ToolOpRow { cat: string, label: string, kind: string }

export struct ToolField {
    key: string, label: string,
    kind: string,          // file | files | folder | text | number | dropdown | slider | toggle
    value: string,
    options: [string],
    min: float, max: float,
    required: bool,
    hint: string,
}

export struct QueueJob { id: int, name: string, state: string, progress: float, message: string }

// One external tool's availability (Settings tab).
export struct ToolStatus { name: string, source: string, detail: string, available: bool, updatable: bool }

// One finished download (download tool's "Downloaded" list).
export struct DownloadItem { name: string, path: string, meta: string }

// ── gradient action button ──────────────────────────────────────────────────
component RunButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px; min-width: 120px; border-radius: 10px;
    background: primary
        ? (enabled ? @linear-gradient(135deg, Theme.tools-accent, Theme.tools-accent-2) : Theme.panel-2)
        : (b.has-hover ? Theme.panel-2 : transparent);
    border-width: primary ? 0px : 1px; border-color: Theme.outline;
    opacity: enabled ? 1.0 : 0.5;
    b := TouchArea { mouse-cursor: enabled ? pointer : default; clicked => { if (root.enabled) { root.clicked(); } } }
    Text { text: label; color: primary ? #2a1c05 : Theme.text; font-size: 14px; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center; }
}

component ActBtn inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.text;
    callback clicked();
    horizontal-stretch: 0; height: 28px; min-width: 60px; border-radius: 8px;
    background: t.has-hover ? Theme.panel-2 : transparent;
    border-width: 1px; border-color: Theme.outline;
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text { text: label; color: tint; font-size: 12px; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center; }
}

// ── one tool tab in the horizontal bar (equal-width segment) ─────────────────
component ToolTab inherits Rectangle {
    in property <ToolOpRow> op;
    in property <bool> active: false;
    in property <bool> show-cat: false;
    in property <color> tint: #cfe3ff;   // per-tool base hue (light pastel)
    callback clicked();
    horizontal-stretch: 1; height: 44px; border-radius: 11px;
    // Inactive tabs each carry their own light pastel gradient so every tool
    // reads as distinct; the active tab is the amber→orange identity gradient.
    // Pastel fills + dark bold text pop on both light and dark backgrounds.
    background: active
        ? @linear-gradient(135deg, Theme.tools-accent, Theme.tools-accent-2)
        : (touch.has-hover
            ? @linear-gradient(135deg, tint.brighter(8%), tint)
            : @linear-gradient(135deg, tint, tint.darker(9%)));
    border-width: 1px;
    border-color: active ? transparent : tint.darker(22%).with-alpha(0.55);
    animate background { duration: 130ms; easing: ease-out; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    VerticalLayout {
        alignment: center; padding-left: 8px; padding-right: 8px;
        Text { text: op.label; color: #1b2330; font-size: 13px;
            font-weight: active ? 800 : 700; horizontal-alignment: center; overflow: elide; }
        if show-cat: Text { text: op.cat; color: #1b2330.with-alpha(0.65); font-size: 10px;
            font-weight: 600; horizontal-alignment: center; }
    }
}

// ── one form field renderer ──────────────────────────────────────────────────
component FieldRow inherits VerticalLayout {
    in property <ToolField> field;
    callback set(string, string);
    callback pick(string);
    spacing: 6px;
    Text { text: field.label + (field.required ? "  *" : ""); color: Theme.text; font-size: 13px; font-weight: 600; }
    if field.kind == "file" || field.kind == "files" || field.kind == "folder": HorizontalLayout {
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1; height: 38px; border-radius: 9px;
            background: Theme.panel-2; border-width: 1px; border-color: Theme.outline;
            HorizontalLayout { padding-left: 12px; padding-right: 12px;
                Text {
                    text: field.value == "" ? "No file chosen"
                          : (field.kind == "files" ? "Multiple files selected" : field.value);
                    color: field.value == "" ? Theme.text-dim : Theme.text;
                    font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                } }
        }
        RunButton { label: field.kind == "folder" ? "Choose folder…" : "Choose…"; primary: false;
            min-width: 130px; clicked => { root.pick(field.key); } }
    }
    if field.kind == "text": LineEdit { text: field.value; placeholder-text: field.hint;
        edited(t) => { root.set(field.key, t); } }
    if field.kind == "number": LineEdit { text: field.value; input-type: number; placeholder-text: field.hint;
        edited(t) => { root.set(field.key, t); } }
    if field.kind == "dropdown": ComboBox { model: field.options; current-value: field.value;
        selected(v) => { root.set(field.key, v); } }
    if field.kind == "slider": HorizontalLayout {
        spacing: 12px;
        Slider { horizontal-stretch: 1; minimum: field.min; maximum: field.max;
            value: field.value == "" ? field.min : field.value.to-float();
            changed(v) => { root.set(field.key, "\{round(v)}"); } }
        Text { text: field.value == "" ? "—" : field.value; color: Theme.text-dim;
            font-size: 13px; font-weight: 700; vertical-alignment: center; min-width: 36px; }
    }
    if field.kind == "toggle": HorizontalLayout { alignment: start;
        Switch { checked: field.value == "true"; text: field.hint;
            toggled => { root.set(field.key, self.checked ? "true" : "false"); } } }
    if field.hint != "" && field.kind != "text" && field.kind != "number" && field.kind != "toggle":
        Text { text: field.hint; color: Theme.text-dim; font-size: 11px; }
}

// ── live queue row ────────────────────────────────────────────────────────────
component QueueRow inherits Rectangle {
    in property <QueueJob> job;
    callback action(int, string);   // pause|resume|cancel|retry|up|down
    callback confirm(int, string);  // remove (routes through the confirm modal)
    height: 80px; horizontal-stretch: 1; border-radius: Theme.radius-md;
    background: Theme.panel; border-width: 1px; border-color: Theme.outline;
    property <color> chip:
        job.state == "running" ? Theme.tools-accent :
        job.state == "done"    ? Theme.ok :
        job.state == "error"   ? Theme.error :
        job.state == "paused"  ? Theme.warn : Theme.text-dim;
    VerticalLayout {
        padding: 12px; spacing: 7px;
        HorizontalLayout {
            spacing: 8px;
            // reorder (queued only)
            if job.state == "queued": ActBtn { label: "↑"; min-width: 30px; clicked => { root.action(job.id, "up"); } }
            if job.state == "queued": ActBtn { label: "↓"; min-width: 30px; clicked => { root.action(job.id, "down"); } }
            Text { text: job.name; color: Theme.text; font-size: 14px; font-weight: 700;
                vertical-alignment: center; horizontal-stretch: 0; }
            Rectangle { horizontal-stretch: 0; border-radius: 7px; background: chip.with-alpha(0.16);
                HorizontalLayout { padding-left: 9px; padding-right: 9px; padding-top: 3px; padding-bottom: 3px;
                    Text { text: job.state; color: chip; font-size: 10px; font-weight: 800; } } }
            Rectangle { horizontal-stretch: 1; }
            if job.state == "running": ActBtn { label: "Pause"; clicked => { root.action(job.id, "pause"); } }
            if job.state == "paused":  ActBtn { label: "Resume"; clicked => { root.action(job.id, "resume"); } }
            if job.state == "error":   ActBtn { label: "Retry"; clicked => { root.action(job.id, "retry"); } }
            if job.state == "running" || job.state == "queued" || job.state == "paused":
                ActBtn { label: "Cancel"; clicked => { root.action(job.id, "cancel"); } }
            if job.state != "running": ActBtn { label: "Remove"; tint: Theme.error; clicked => { root.confirm(job.id, "remove"); } }
        }
        Rectangle {
            height: 7px; border-radius: 4px; background: Theme.panel-2;
            border-width: 1px; border-color: Theme.outline;
            Rectangle { x: 0; height: parent.height; border-radius: 4px;
                width: parent.width * max(0.0, min(1.0, job.progress));
                background: @linear-gradient(90deg, Theme.tools-accent, Theme.tools-accent-2);
                animate width { duration: 200ms; easing: ease-out; } }
        }
        if job.message != "": Text { text: job.message; color: Theme.text-dim; font-size: 11px; overflow: elide; }
    }
}

// ── settings: one tool-availability row ──────────────────────────────────────
component StatusRow inherits Rectangle {
    in property <ToolStatus> tool;
    callback update(string);
    height: 64px; horizontal-stretch: 1; border-radius: Theme.radius-md;
    background: Theme.panel; border-width: 1px; border-color: Theme.outline;
    property <color> badge: tool.available ? Theme.ok : Theme.error;
    HorizontalLayout {
        padding-left: 16px; padding-right: 16px; spacing: 12px;
        // Update button in a fixed left slot so every row's content lines up in
        // the same columns whether or not the tool is updatable (was misaligned
        // because the button used to sit at the right end, stretched full-height).
        Rectangle { width: 92px; horizontal-stretch: 0;
            if tool.updatable: VerticalLayout { alignment: center;
                ActBtn { label: "Update"; tint: Theme.tools-accent; clicked => { root.update(tool.name); } } } }
        Rectangle { width: 10px; height: 10px; border-radius: 5px; background: badge;
            horizontal-stretch: 0; y: (parent.height - self.height) / 2; }
        VerticalLayout { alignment: center; horizontal-stretch: 1;
            Text { text: tool.name; color: Theme.text; font-size: 14px; font-weight: 700; }
            Text { text: tool.detail; color: Theme.text-dim; font-size: 11px; overflow: elide; } }
        VerticalLayout { alignment: center; horizontal-stretch: 0;
            Rectangle { horizontal-stretch: 0; border-radius: 7px; background: badge.with-alpha(0.16);
                HorizontalLayout { padding-left: 10px; padding-right: 10px; padding-top: 4px; padding-bottom: 4px;
                    Text { text: tool.source; color: badge; font-size: 11px; font-weight: 800; vertical-alignment: center; } } } }
    }
}

// ── page ─────────────────────────────────────────────────────────────────────
export component ToolsPage inherits Rectangle {
    in-out property <string> category: "fileops";
    in-out property <string> query: "";
    in property <string> cat-title: "File ops";
    in property <string> cat-icon: "";
    in property <[ToolOpRow]> op-rows: [];
    in property <string> queue-status: "Idle";
    in property <[ToolField]> fields: [];
    in property <string> active-op: "";
    in property <string> active-label: "";
    in property <string> active-info: "";   // what the tool does + how to use it
    in property <string> error: "";
    in property <[QueueJob]> queue-jobs: [];
    in property <[ToolStatus]> tool-statuses: [];
    in property <[DownloadItem]> downloads: [];
    in-out property <int> worker-slots: 2;
    property <bool> downloads-open: false;

    callback open-tool(string);
    callback set-category(string);
    callback search(string);
    callback field-set(string, string);
    callback field-pick(string);
    callback run();
    callback reset();
    callback close-detail();
    callback queue-action(int, string);
    callback set-workers(int);
    callback update-tool(string);
    callback list-downloads();
    callback open-download(string);

    property <color> accent: Theme.tools-accent;
    // Distinct light pastels cycled across the tool tabs so each tool reads
    // apart from its neighbours (active tab overrides with the amber identity).
    property <[color]> tab-palette: [
        #bcd9ff, #c2efce, #e0d3ff, #ffd0e4, #c4ecef, #ffe2ad, #ffd0c8, #dcefb4, #d6dcff, #f6d2bf,
    ];
    // confirm-dialog state
    property <bool> confirm-open: false;
    property <string> confirm-msg: "";
    property <int> pending-id: -1;
    property <string> pending-act: "";
    background: transparent;

    function ask(id: int, act: string, msg: string) {
        root.pending-id = id; root.pending-act = act; root.confirm-msg = msg; root.confirm-open = true;
    }
    function do-accept() {
        root.confirm-open = false;
        root.queue-action(root.pending-id, root.pending-act);
    }

    VerticalLayout {
        spacing: 0px;

        // Row 1 — title · search · status pill.
        Rectangle {
            height: 72px; horizontal-stretch: 1; background: Theme.panel;
            border-width: 1px; border-color: Theme.outline;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; spacing: 14px;
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Text { text: "Tools"; color: Theme.text; font-size: 22px; font-weight: 700; } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    HdrSearch { width: 320px; dark: Theme.dark; placeholder: "Find a tool";
                        query <=> root.query; edited(q) => { root.search(q); } } }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    CountPill { accent: root.accent; text-color: #2a1c05; seg1: "" + root.queue-status; } }
            }
        }

        // Row 2 — category tabs.
        Rectangle {
            height: 54px; horizontal-stretch: 1; background: Theme.panel;
            border-width: 1px; border-color: Theme.outline;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; spacing: 8px; alignment: start;
                VerticalLayout { alignment: center; HdrChip { icon: Icons.folder; label: "File ops";  min-width: 100px; dark: Theme.dark; accent: root.accent; active: category == "fileops"; clicked => { root.set-category("fileops"); } } }
                VerticalLayout { alignment: center; HdrChip { icon: Icons.film; label: "Video";     min-width: 88px;  dark: Theme.dark; accent: root.accent; active: category == "video";   clicked => { root.set-category("video"); } } }
                VerticalLayout { alignment: center; HdrChip { icon: Icons.music; label: "Audio";     min-width: 88px;  dark: Theme.dark; accent: root.accent; active: category == "audio";   clicked => { root.set-category("audio"); } } }
                VerticalLayout { alignment: center; HdrChip { icon: Icons.image; label: "Photo";     min-width: 88px;  dark: Theme.dark; accent: root.accent; active: category == "photo";   clicked => { root.set-category("photo"); } } }
                VerticalLayout { alignment: center; HdrChip { icon: Icons.message-circle; label: "Subtitles"; min-width: 100px; dark: Theme.dark; accent: root.accent; active: category == "subs";    clicked => { root.set-category("subs"); } } }
                VerticalLayout { alignment: center; HdrChip { icon: Icons.settings; label: "Settings"; min-width: 96px; dark: Theme.dark; accent: root.accent; active: category == "settings"; clicked => { root.set-category("settings"); } } }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Row 3 — horizontal tool bar (tool categories only).
        if category != "settings": Rectangle {
            height: 68px; horizontal-stretch: 1; background: Theme.atmosphere;
            border-width: 1px; border-color: Theme.outline;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; padding-top: 12px; padding-bottom: 12px; spacing: 10px;
                for op[idx] in root.op-rows: ToolTab {
                    op: op; show-cat: root.query != ""; active: op.kind == root.active-op;
                    tint: root.tab-palette[mod(idx, 10)];
                    clicked => { root.open-tool(op.kind); }
                }
                if root.op-rows.length == 0: VerticalLayout { alignment: center;
                    Text { text: root.query == "" ? "No tools here." : "No tools match “" + root.query + "”.";
                        color: Theme.text-dim; font-size: 13px; } }
            }
        }

        // Body.
        Rectangle {
            vertical-stretch: 1; horizontal-stretch: 1; background: transparent;

            // Settings — external tool availability.
            if category == "settings": VerticalLayout {
                padding: 28px; spacing: 14px;
                Text { text: "Tool availability"; color: Theme.text; font-size: 18px; font-weight: 700; }
                Text { text: "Where each external tool resolves from (Tools dir → bundled → system PATH). Set a Tools directory in Settings → System to override.";
                    color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                ScrollView {
                    vertical-stretch: 1; horizontal-stretch: 1;
                    VerticalLayout { spacing: 10px; alignment: start;
                        for tool in root.tool-statuses: StatusRow { tool: tool; update(n) => { root.update-tool(n); } }
                        if root.tool-statuses.length == 0: Text { text: "Scanning…"; color: Theme.text-dim; font-size: 13px; }
                    }
                }
            }

            // Tool detail (full width) or hint.
            if category != "settings": Rectangle {
                if root.active-op == "": VerticalLayout {
                    alignment: center;
                    HorizontalLayout { alignment: center;
                        Rectangle { width: 64px; height: 64px; border-radius: 16px;
                            background: root.accent.with-alpha(0.14);
                            AppIcon { source: Icons.settings; tint: root.accent; width: 30px; height: 30px; } } }
                    Text { text: "Pick a tool above"; color: Theme.text; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Set its options, then Run — jobs and their progress show inside the tool, below the form.";
                        color: Theme.text-dim; font-size: 13px; horizontal-alignment: center; }
                }
                if root.active-op != "": HorizontalLayout {
                    alignment: center;
                    // Fixed-width column sized off the page (not the flickable) so the
                    // inner ScrollView can't form a width binding loop.
                    Rectangle {
                        width: min(680px, root.width - 56px); horizontal-stretch: 0;
                        ScrollView {
                            VerticalLayout {
                                padding: 28px; spacing: 18px; alignment: start;
                                HorizontalLayout {
                                    spacing: 12px;
                                    Rectangle { width: 44px; height: 44px; border-radius: 12px; horizontal-stretch: 0;
                                        background: @linear-gradient(135deg, Theme.tools-accent.with-alpha(0.22), Theme.tools-accent-2.with-alpha(0.22));
                                        AppIcon { source: Icons.settings; tint: root.accent; width: 22px; height: 22px; } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                                        Text { text: root.active-label; color: Theme.text; font-size: 18px; font-weight: 700; } }
                                    // Download tools: jump to the list of finished files.
                                    if root.active-op == "download" || root.active-op == "download_playlist" || root.active-op == "download_live":
                                        ActBtn { label: "Downloaded"; tint: root.accent; min-width: 100px;
                                            clicked => { root.list-downloads(); root.downloads-open = true; } }
                                    ActBtn { label: "Close"; clicked => { root.close-detail(); } }
                                }
                                // Info box: what the tool does + how to use it, shown
                                // above the form so the controls have context.
                                if root.active-info != "": Rectangle {
                                    border-radius: 12px;
                                    background: @linear-gradient(135deg, root.accent.with-alpha(0.13), root.accent.with-alpha(0.06));
                                    border-width: 1px; border-color: root.accent.with-alpha(0.32);
                                    VerticalLayout {
                                        padding: 14px; spacing: 7px;
                                        HorizontalLayout { spacing: 8px; alignment: start;
                                            AppIcon { source: Icons.info; tint: root.accent; width: 16px; height: 16px;
                                                y: 1px; horizontal-stretch: 0; }
                                            Text { text: "About " + root.active-label; color: root.accent;
                                                font-size: 12px; font-weight: 800; vertical-alignment: center; } }
                                        Text { text: root.active-info; color: Theme.text; font-size: 13px;
                                            wrap: word-wrap; }
                                    }
                                }
                                for f in root.fields: FieldRow { field: f;
                                    set(k, v) => { root.field-set(k, v); }
                                    pick(k) => { root.field-pick(k); } }
                                if root.active-op == "cache_clean": Text {
                                    text: "Clears the thumbnail cache. Thumbnails regenerate on demand.";
                                    color: Theme.text-dim; font-size: 12px; }
                                if root.error != "": Text { text: root.error; color: Theme.error; font-size: 12px; font-weight: 600; }
                                HorizontalLayout { spacing: 10px; alignment: start;
                                    RunButton { label: "Run"; clicked => { root.run(); } }
                                    RunButton { label: "Reset"; primary: false; clicked => { root.reset(); } }
                                }

                                // ── Job queue, in-window ──────────────────────────
                                // The queue lives under each tool's form (no separate
                                // tab): Run drops a job here and it shows live progress
                                // with the same pause/resume/cancel/retry/remove/reorder
                                // controls. The queue is global, so jobs from any tool
                                // appear here.
                                Rectangle { height: 1px; background: Theme.outline; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                                        Text { text: "Job queue"; color: Theme.text; font-size: 15px; font-weight: 700; }
                                        Text { text: root.queue-status; color: Theme.text-dim; font-size: 11px; } }
                                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                                        Text { text: "Workers " + root.worker-slots; color: Theme.text-dim; font-size: 11px;
                                            horizontal-alignment: center; }
                                        Slider { width: 120px; minimum: 1; maximum: 6; value: root.worker-slots;
                                            changed(v) => { root.worker-slots = round(v); root.set-workers(round(v)); } } }
                                    VerticalLayout { alignment: center;
                                        ActBtn { label: "Clear all"; tint: Theme.error;
                                            clicked => { root.ask(-1, "clear", "Clear all jobs from the queue?"); } } }
                                }
                                for job in root.queue-jobs: QueueRow { job: job;
                                    action(i, a) => { root.queue-action(i, a); }
                                    confirm(i, a) => { root.ask(i, a, "Remove this job from the queue?"); } }
                                if root.queue-jobs.length == 0: Text {
                                    text: "No jobs yet. Set the options above and press Run.";
                                    color: Theme.text-dim; font-size: 12px; }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── confirmation dialog (mouse + Enter / Esc) ────────────────────────────
    if root.confirm-open: Rectangle {
        background: #00000088;
        TouchArea { clicked => { root.confirm-open = false; } } // click backdrop = cancel
        Rectangle {
            width: 360px; height: 168px; border-radius: Theme.radius-lg;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.modal; border-width: 1px; border-color: Theme.outline-strong;
            // keyboard: Enter confirms, Esc cancels. Focused on creation.
            fs := FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    if (e.text == Key.Return) { root.do-accept(); return accept; }
                    if (e.text == Key.Escape) { root.confirm-open = false; return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 22px; spacing: 18px; alignment: center;
                    Text { text: root.confirm-msg; color: Theme.text; font-size: 15px; font-weight: 600;
                        horizontal-alignment: center; wrap: word-wrap; }
                    HorizontalLayout { alignment: center; spacing: 12px;
                        RunButton { label: "Cancel"; primary: false; min-width: 110px;
                            clicked => { root.confirm-open = false; } }
                        RunButton { label: "Confirm"; min-width: 110px; clicked => { root.do-accept(); } }
                    }
                    Text { text: "Enter to confirm · Esc to cancel"; color: Theme.text-dim; font-size: 11px;
                        horizontal-alignment: center; }
                }
            }
        }
    }

    // ── Downloaded-files browser (download tool) ─────────────────────────────
    if root.downloads-open: Rectangle {
        background: #00000088;
        TouchArea { clicked => { root.downloads-open = false; } } // backdrop = close
        Rectangle {
            width: min(560px, root.width - 64px); height: min(520px, root.height - 80px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.modal; border-width: 1px; border-color: Theme.outline-strong;
            border-radius: Theme.radius-lg; clip: true;
            VerticalLayout {
                padding: 20px; spacing: 14px;
                HorizontalLayout {
                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                        Text { text: "Downloaded"; color: Theme.text; font-size: 17px; font-weight: 700; }
                        Text { text: "~/Downloads · click an item to open in the system player";
                            color: Theme.text-dim; font-size: 11px; } }
                    ActBtn { label: "Close"; clicked => { root.downloads-open = false; } }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout { spacing: 8px; alignment: start;
                        for d in root.downloads: Rectangle {
                            height: 54px; border-radius: 10px; background: Theme.panel;
                            border-width: 1px; border-color: Theme.outline;
                            row := TouchArea { mouse-cursor: pointer; clicked => { root.open-download(d.path); } }
                            HorizontalLayout {
                                padding-left: 14px; padding-right: 14px; spacing: 12px;
                                VerticalLayout { alignment: center; horizontal-stretch: 0;
                                    Rectangle { width: 30px; height: 30px; border-radius: 8px;
                                        background: root.accent.with-alpha(row.has-hover ? 0.26 : 0.14);
                                        AppIcon { source: Icons.play; tint: root.accent; width: 15px; height: 15px; } } }
                                VerticalLayout { alignment: center; horizontal-stretch: 1;
                                    Text { text: d.name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                                    Text { text: d.meta; color: Theme.text-dim; font-size: 11px; } }
                                VerticalLayout { alignment: center;
                                    ActBtn { label: "Open"; tint: root.accent; clicked => { root.open-download(d.path); } } }
                            }
                        }
                        if root.downloads.length == 0: Text {
                            text: "Nothing downloaded yet. Run a download, then check back.";
                            color: Theme.text-dim; font-size: 13px; }
                    }
                }
            }
        }
    }
}
