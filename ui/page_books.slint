// Book Home page (np.p8.books.home) — target: docs/books-redesign/newbook22.png.
// ORIGINAL design (not derived from the dead cbook.png). Colors are PINNED to
// the SPEC light palette via the BookTheme global so the page reads the same
// regardless of the app dark/light Theme — Books is its own bright surface.
//
// Layout (fills parent): Header row · Hero row (Continue card + 2×2 stats) ·
// Main row (Toolbar + book grid + pagination | right rail: quick filters /
// file types / genres). All data flows in via `in` properties; every user
// action leaves through a callback the sec-books crate wires to the engine.
import { Theme } from "tokens.slint";
import { AppIcon, Icons } from "icons.slint";
import { ScrollView, ComboBox, LineEdit } from "std-widgets.slint";

// Books-section palette. Follows the app's global light/dark (Theme.dark) so
// the whole section (Home grid + reader chrome) matches the app theme (R4). The
// reader's *paper* themes (light/sepia/dark/night) are separate — see BookReader.
export global BookTheme {
    out property <bool> dark: Theme.dark;
    out property <color> canvas:      dark ? #14151a : #f2f2f7;
    out property <color> card:        dark ? #1e1f26 : #ffffff;
    out property <color> accent:      #6c4df6;
    out property <color> tint-violet: dark ? #241d3d : #efeaff;
    out property <color> tint-pink:   dark ? #2e1f28 : #fdeef4;
    out property <color> tint-orange: dark ? #2e2519 : #fff3e6;
    out property <color> tint-green:  dark ? #17281f : #e8f8ef;
    out property <color> ink:         dark ? #e8e8ee : #1b1b22;
    out property <color> ink-dim:     dark ? #8f8f9a : #8a8a94;
    out property <color> track:       dark ? #2a2b33 : #ececf2;
    out property <color> pill-bg:     dark ? #24252d : #f4f4f8;
    out property <color> hairline:    dark ? #2c2d36 : #ececf2;
    out property <length> radius: 16px;
    out property <color> shadow:      dark ? #00000040 : #00000010;
}

// One book row for the grid. `percent` 0‥100; `cover` filled by Rust (empty →
// tinted placeholder shows through). `format` is the badge label (EPUB/PDF/…).
export struct BookTile {
    id: int,
    title: string,
    author: string,
    cover: image,
    percent: float,
    favorite: bool,
    format: string,
    date: string,
    hue: color,
    rating: float,
    missing: bool,
    trashed: bool,
}

// Hero "Continue Reading" card. `present` false → empty-state hero. One slide
// of the up-to-5-book slider; Rust swaps the active slide on `hero-slide`.
export struct BooksHero {
    id: int,
    present: bool,
    title: string,
    author: string,
    cover: image,
    hue: color,
    page: int,
    total: int,
    percent: float,
    time-left: string,
    // Decorative illustration (right side); the card picks the variant that
    // matches the current theme so it reads on both light and dark cards.
    art-light: image,
    art-dark: image,
}

// One of the four stat cards (2×2).
export struct BookStat {
    label: string,
    value: string,
    tint: color,
    accent: color,
    icon: image,
}

// A labelled chip with an optional count — file types, genres, quick filters.
export struct BookChip {
    key: string,
    label: string,
    count: int,
}

// A collection row in the detail popup (name + whether the book is a member).
export struct CollRow {
    id: int,
    name: string,
    member: bool,
}

// A collection chip in the rail (int id so the filter callback stays typed).
export struct CollChip {
    id: int,
    name: string,
    count: int,
}

// One per-book time row in the reading-stats panel.
export struct StatBookRow {
    title: string,
    time: string,
}

// ── small parts ───────────────────────────────────────────────────────────────

// White rounded card with the SPEC hairline shadow.
component Card inherits Rectangle {
    background: BookTheme.card;
    border-radius: BookTheme.radius;
    drop-shadow-blur: 2px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: BookTheme.shadow;
}

// Rounded pill button. `filled` → solid accent + white; else outline.
component PillButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> filled: false;
    in property <bool> compact: false; // tighter header-bar sizing
    in property <color> accent: BookTheme.accent;
    callback clicked();
    height: compact ? 38px : 40px;
    border-radius: self.height / 2;
    horizontal-stretch: 0;
    background: filled ? accent : BookTheme.card;
    border-width: filled ? 0px : 1.5px;
    border-color: accent.with-alpha(0.35);
    property <color> ink: filled ? #ffffff : accent;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: compact ? 14px : 16px; padding-right: compact ? 15px : 18px;
        spacing: compact ? 7px : 8px; alignment: center;
        VerticalLayout { alignment: center;
            if root.icon.width > 0: AppIcon { source: root.icon; tint: root.ink;
                width: compact ? 16px : 18px; height: compact ? 16px : 18px; } }
        Text { text: root.label; color: root.ink; font-size: compact ? 13px : 14px; font-weight: 700;
            vertical-alignment: center; }
    }
    states [ hover when ta.has-hover: { background: filled ? accent.darker(0.08) : BookTheme.pill-bg; } ]
    animate background { duration: 120ms; }
}

// Rounded filter chip with optional count badge.
component FilterChip inherits Rectangle {
    in property <string> label;
    in property <int> count: -1;
    in property <bool> active: false;
    callback clicked();
    height: 34px;
    border-radius: 17px;
    horizontal-stretch: 0;
    background: active ? BookTheme.accent : BookTheme.pill-bg;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 6px; alignment: center;
        Text { text: root.label; color: root.active ? #ffffff : BookTheme.ink;
            font-size: 13px; font-weight: 600; vertical-alignment: center; }
        if root.count >= 0: Text { text: root.count; font-size: 12px; font-weight: 600;
            color: root.active ? #ffffffcc : BookTheme.ink-dim; vertical-alignment: center; }
    }
    states [ hover when ta.has-hover && !active: { background: BookTheme.track; } ]
    animate background { duration: 100ms; }
}

// A collection/series row on the Collections / Series pages.
component EntryCard inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <image> icon;
    in property <bool> deletable: false;
    callback clicked();
    callback deleted();
    height: 54px; border-radius: 12px;
    background: eta.has-hover ? BookTheme.pill-bg : BookTheme.card;
    border-width: 1px; border-color: BookTheme.hairline;
    eta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 14px; padding-right: 12px; spacing: 12px; alignment: start;
        VerticalLayout { alignment: center;
            Rectangle { width: 34px; height: 34px; border-radius: 10px; background: BookTheme.tint-violet;
                AppIcon { source: root.icon; tint: BookTheme.accent; width: 17px; height: 17px; } } }
        VerticalLayout { alignment: center; horizontal-stretch: 1;
            Text { text: root.label; color: BookTheme.ink; font-size: 14px; font-weight: 700; overflow: elide; }
            Text { text: root.count + (root.count == 1 ? " book" : " books");
                color: BookTheme.ink-dim; font-size: 11px; } }
        if root.deletable: VerticalLayout { alignment: center;
            Rectangle { width: 30px; height: 30px; border-radius: 8px;
                background: dta.has-hover ? #e0518f.with-alpha(0.14) : transparent;
                AppIcon { source: Icons.trash; tint: #d6336c; width: 15px; height: 15px; }
                dta := TouchArea { mouse-cursor: pointer; clicked => { root.deleted(); } } } }
        VerticalLayout { alignment: center;
            AppIcon { source: Icons.chevron-right; tint: BookTheme.ink-dim; width: 16px; height: 16px; } }
    }
}

// One row in the tile's ⋮ context menu.
component MenuItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> danger: false;
    callback clicked();
    height: 34px; border-radius: 8px;
    background: mta.has-hover ? (danger ? #e0518f.with-alpha(0.12) : BookTheme.pill-bg) : transparent;
    property <color> ink: danger ? #d6336c : BookTheme.ink;
    mta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 12px; spacing: 9px; alignment: start;
        VerticalLayout { alignment: center;
            AppIcon { source: root.icon; tint: root.ink; width: 15px; height: 15px; } }
        Text { text: root.label; color: root.ink; font-size: 13px; font-weight: 500;
            vertical-alignment: center; }
    }
}

// Left cover artwork. When there's no cover image, draws a generated cover
// card from the title/author on a hash-picked color (for PDFs and any coverless
// book). Also shows the format badge + optional reading-progress bar.
component Cover inherits Rectangle {
    in property <image> source;
    in property <string> format;
    in property <string> title;
    in property <string> author;
    in property <color> hue: #6c4df6;
    in property <float> percent: -1;
    // Scale text with the card so it reads in both the tiny grid tile and the
    // larger hero — `big` splits the two size regimes.
    property <bool> big: self.width > 100px;
    border-radius: 8px;
    clip: true;
    background: root.source.width <= 0
        ? @linear-gradient(155deg, root.hue, root.hue.darker(0.35))
        : BookTheme.tint-violet;

    // ── Generated cover (no image) ───────────────────────────────────────────
    if root.source.width <= 0: Rectangle {
        // Inner hairline frame.
        Rectangle {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            border-radius: 6px; border-width: 1.5px; border-color: #ffffff55; background: transparent;
        }
        VerticalLayout {
            padding: root.big ? 16px : 8px; spacing: 0px;
            // Format badge.
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    height: root.big ? 20px : 15px; border-radius: 5px; background: #ffffff33;
                    HorizontalLayout { padding-left: 6px; padding-right: 6px;
                        Text { text: root.format; color: #ffffff; font-size: root.big ? 10px : 8px;
                            font-weight: 700; vertical-alignment: center; } }
                }
            }
            // Title (centered) + divider + author.
            Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center; spacing: root.big ? 12px : 6px;
                    Text {
                        text: root.title; color: #ffffff; font-family: "serif";
                        font-size: root.big ? 20px : 11px; font-weight: 700;
                        horizontal-alignment: center; wrap: word-wrap; overflow: elide;
                    }
                    HorizontalLayout { alignment: center;
                        Rectangle { width: root.big ? 46px : 24px; height: 1px; background: #ffffff77; } }
                    Text {
                        text: root.author; color: #ffffffdd; font-family: "serif";
                        font-size: root.big ? 14px : 9px; font-italic: true;
                        horizontal-alignment: center; wrap: word-wrap; overflow: elide;
                    }
                }
            }
        }
    }

    // ── Real cover image ─────────────────────────────────────────────────────
    Image { source: root.source; image-fit: cover; width: 100%; height: 100%; }

    // Reading progress bar along the bottom edge.
    if root.percent > 0: Rectangle {
        x: 0; y: parent.height - 4px; width: 100%; height: 4px; background: #00000030;
        Rectangle { x: 0; width: parent.width * root.percent / 100; height: 4px;
            background: BookTheme.accent; }
    }
}

// ── stat card ─────────────────────────────────────────────────────────────────
component StatCard inherits Card {
    in property <string> label;
    in property <string> value;
    in property <color> tint;
    in property <color> accent: BookTheme.accent;
    in property <image> icon;
    callback clicked();
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding: 16px; spacing: 14px; alignment: start;
        Rectangle {
            width: 46px; height: 46px; border-radius: 13px; background: root.tint;
            AppIcon { source: root.icon; tint: root.accent; width: 22px; height: 22px; }
        }
        VerticalLayout { alignment: center; spacing: 2px;
            Text { text: root.value; color: BookTheme.ink; font-size: 24px; font-weight: 800; }
            Text { text: root.label; color: BookTheme.ink-dim; font-size: 12px; font-weight: 500; }
        }
    }
    states [ hover when ta.has-hover: { background: #fbfbfd; } ]
}

// Five clickable stars for the local rating (click star N → rating N).
component Stars inherits HorizontalLayout {
    in property <float> rating;
    callback rate(float);
    spacing: 2px;
    for i in [1, 2, 3, 4, 5]: TouchArea {
        width: 15px; height: 15px;
        mouse-cursor: pointer;
        // Clicking the current top star clears the rating.
        clicked => { root.rate(i == root.rating ? 0 : i); }
        AppIcon {
            source: i <= root.rating ? Icons.star-filled : Icons.star;
            tint: i <= root.rating ? #f5a623 : BookTheme.ink-dim.with-alpha(0.55);
            width: 14px; height: 14px;
        }
    }
}

// ── book grid tile (horizontal card: cover-left + details-right) ───────────────
component GridTile inherits Rectangle {
    in property <BookTile> tile;
    in property <[CollChip]> collections: [];
    callback open();
    callback favorite();
    callback rate(float);
    callback open-author();
    callback open-location();
    callback ask-delete();
    callback restore();
    callback delete-perm();
    callback add-collection(int); // add this book to collection id
    border-radius: 14px;
    clip: true; // keep every child inside the tile (meta row was overflowing)
    background: BookTheme.card;
    border-width: 1px;
    border-color: ta.has-hover ? BookTheme.accent.with-alpha(0.35) : BookTheme.hairline;
    drop-shadow-blur: 2px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: BookTheme.shadow;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
    HorizontalLayout {
        padding: 13px; spacing: 13px;
        // Cover (bigger thumb).
        Rectangle {
            width: 88px;
            Cover { width: 100%; height: 124px; source: tile.cover; percent: tile.percent;
                format: tile.format; title: tile.title; author: tile.author; hue: tile.hue; }
        }
        // Details column. Meta cluster (date · rating · type · actions) is pinned
        // to the bottom so it lines up across tiles; the title flexes above it.
        VerticalLayout {
            alignment: start; spacing: 4px; horizontal-stretch: 1;
            // Title — up to 3 lines, shrinks if the cell is short.
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; max-height: 48px; clip: true;
                    Text { text: tile.title; width: 100%; color: BookTheme.ink; font-size: 14px;
                        font-weight: 700; wrap: word-wrap; overflow: elide; } }
                Rectangle { width: 26px; }
            }
            // Author — plain text (2 lines), hover tints it for easy clicking.
            Rectangle {
                height: 30px; clip: true;
                HorizontalLayout {
                    Text { text: tile.author; horizontal-stretch: 1;
                        color: autht.has-hover ? BookTheme.accent : BookTheme.ink-dim;
                        font-size: 12px; font-weight: 600; wrap: word-wrap; overflow: elide;
                        vertical-alignment: center; } }
                autht := TouchArea { mouse-cursor: pointer; clicked => { root.open-author(); } }
            }
            // Push the meta cluster to the bottom (consistent across tiles).
            Rectangle { vertical-stretch: 1; }
            // Publication date line.
            Text { text: "Publication Date : " + (tile.date != "" ? tile.date : "—");
                color: BookTheme.ink-dim; font-size: 11px; font-weight: 500;
                overflow: elide; }
            // Full-width rating pill — stars spread across the whole width.
            Rectangle {
                height: 26px; border-radius: 13px;
                background: tile.rating > 0 ? #f5a623.with-alpha(0.16) : BookTheme.pill-bg;
                HorizontalLayout {
                    padding-left: 14px; padding-right: 14px; alignment: space-between;
                    for i in [1, 2, 3, 4, 5]: TouchArea {
                        width: 22px; mouse-cursor: pointer;
                        clicked => { root.rate(i == root.tile.rating ? 0 : i); }
                        AppIcon { source: i <= root.tile.rating ? Icons.star-filled : Icons.star;
                            tint: i <= root.tile.rating ? #f5a623 : BookTheme.ink-dim.with-alpha(0.55);
                            width: 18px; height: 18px;
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    }
                }
            }
            // File type (left) · add-to-collection (⊕) · favorite (♥) (right).
            HorizontalLayout {
                spacing: 6px; alignment: space-between;
                VerticalLayout { alignment: center;
                    Rectangle {
                        height: 20px; border-radius: 6px; background: BookTheme.pill-bg;
                        HorizontalLayout { padding-left: 8px; padding-right: 8px;
                            Text { text: tile.format; color: BookTheme.ink-dim; font-size: 10px;
                                font-weight: 700; vertical-alignment: center; } }
                    } }
                HorizontalLayout { spacing: 2px; alignment: end;
                    // ⊕ add-to-collection.
                    Rectangle { width: 26px; height: 26px; border-radius: 8px;
                        background: plusta.has-hover ? BookTheme.pill-bg : transparent;
                        AppIcon { source: Icons.plus; tint: BookTheme.ink-dim; width: 16px; height: 16px;
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                        plusta := TouchArea { mouse-cursor: pointer; clicked => { coll-add.show(); } }
                        coll-add := PopupWindow {
                            x: parent.width - 210px; y: parent.height + 4px; width: 210px;
                            Rectangle {
                                background: BookTheme.card; border-radius: 12px;
                                border-width: 1px; border-color: BookTheme.hairline;
                                drop-shadow-blur: 18px; drop-shadow-color: #00000033;
                                VerticalLayout {
                                    padding: 8px; spacing: 2px;
                                    Text { text: "Add to collection"; color: BookTheme.ink-dim;
                                        font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                                    for c in root.collections: MenuItem {
                                        label: c.name; icon: Icons.bookmark;
                                        clicked => { root.add-collection(c.id); coll-add.close(); } }
                                    if root.collections.length == 0: Text {
                                        text: "No collections yet — create one\nin the Collections tab.";
                                        color: BookTheme.ink-dim; font-size: 11px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                    // ♥ favorite.
                    fav-ta := TouchArea {
                        width: 30px; height: 26px; mouse-cursor: pointer;
                        clicked => { root.favorite(); }
                        AppIcon { source: tile.favorite ? Icons.heart-filled : Icons.heart;
                            tint: tile.favorite ? #e0518f : BookTheme.ink-dim; width: 18px; height: 18px;
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    }
                }
            }
        }
    }
    // Overflow context menu (top-right).
    Rectangle {
        x: parent.width - 34px; y: 10px; width: 26px; height: 26px;
        AppIcon { source: Icons.ellipsis; tint: BookTheme.ink-dim; width: 16px; height: 16px; }
        TouchArea { mouse-cursor: pointer; clicked => { ctx-menu.show(); } }
        ctx-menu := PopupWindow {
            x: parent.width - 200px; y: parent.height + 4px; width: 200px;
            Rectangle {
                background: BookTheme.card; border-radius: 12px;
                border-width: 1px; border-color: BookTheme.hairline;
                drop-shadow-blur: 18px; drop-shadow-color: #00000033;
                VerticalLayout {
                    padding: 6px; spacing: 2px;
                    // Library vs. trash view. Delete confirmation is a page-level
                    // modal (reactive state inside a PopupWindow is unreliable).
                    if !root.tile.trashed: MenuItem {
                        label: "Open Location"; icon: Icons.folder-open;
                        clicked => { root.open-location(); ctx-menu.close(); } }
                    if !root.tile.trashed: MenuItem {
                        label: root.tile.favorite ? "Remove Favorite" : "Add to Favorites";
                        icon: Icons.bookmark;
                        clicked => { root.favorite(); ctx-menu.close(); } }
                    if !root.tile.trashed: MenuItem {
                        label: "Delete from Library"; icon: Icons.trash; danger: true;
                        clicked => { ctx-menu.close(); root.ask-delete(); } }
                    if root.tile.trashed: MenuItem {
                        label: "Restore to Library"; icon: Icons.rotate-ccw;
                        clicked => { root.restore(); ctx-menu.close(); } }
                    if root.tile.trashed: MenuItem {
                        label: "Delete Permanently"; icon: Icons.trash; danger: true;
                        clicked => { root.delete-perm(); ctx-menu.close(); } }
                }
            }
        }
    }
}

// A titled rail block (Quick filters / File types / Genres).
component RailBlock inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    Text { text: root.title; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700;
        letter-spacing: 0.6px; }
    @children
}

// One rail list row: leading icon · label · trailing count. Used for quick
// filters and file types (matches the design's right-rail list style).
component RailRow inherits Rectangle {
    in property <image> icon;
    in property <color> icon-tint: BookTheme.accent;
    in property <string> label;
    in property <int> count: -1;
    in property <bool> active: false;
    callback clicked();
    height: 36px;
    border-radius: 10px;
    background: root.active ? BookTheme.tint-violet : (ta.has-hover ? BookTheme.pill-bg : transparent);
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 12px; spacing: 10px;
        VerticalLayout { alignment: center;
            AppIcon { source: root.icon; tint: root.active ? BookTheme.accent : root.icon-tint;
                width: 16px; height: 16px; } }
        Text { text: root.label; color: root.active ? BookTheme.accent : BookTheme.ink;
            font-size: 13px; font-weight: root.active ? 700 : 500; vertical-alignment: center;
            horizontal-stretch: 1; overflow: elide; }
        if root.count >= 0: Text { text: root.count; color: BookTheme.ink-dim; font-size: 12px;
            font-weight: 600; vertical-alignment: center; }
    }
    animate background { duration: 100ms; }
}

// A colored genre chip with a trailing count (rail Genres section).
component GenreChip inherits Rectangle {
    in property <string> label;
    in property <int> count: -1;
    in property <color> hue: BookTheme.accent;
    in property <bool> active: false;
    callback clicked();
    height: 30px;
    border-radius: 15px;
    background: root.active ? root.hue.with-alpha(0.9) : root.hue.with-alpha(0.12);
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 8px; alignment: start;
        Text { text: root.label; color: root.active ? #ffffff : root.hue; font-size: 12px;
            font-weight: 600; vertical-alignment: center; overflow: elide; }
        if root.count >= 0: Text { text: root.count; color: root.active ? #ffffffcc : root.hue.with-alpha(0.7);
            font-size: 11px; font-weight: 600; vertical-alignment: center; }
    }
}

// ── page ──────────────────────────────────────────────────────────────────────
export component BooksPage inherits Rectangle {
    // data in
    in property <BooksHero> hero;
    in property <[BookTile]> tiles: [];
    in property <[BookStat]> stats: [];
    in property <[BookChip]> file-types: [];
    in property <[BookChip]> genres: [];
    in property <[BookChip]> quick-filters: [];
    in property <[string]> sort-options: ["Recently Added", "Recently Read", "Title", "Author", "Rating"];
    in property <int> sort-index: 0;
    in property <[string]> file-type-options: ["All"];
    // Rotating hue palette for the genre chips.
    property <[color]> genre-hues: [#6c4df6, #e0518f, #2fbf71, #f5a623, #3a86ff, #b5179e];
    in property <int> book-count: 0;
    // Number of books in the CURRENT filter (author banner count, etc.).
    in property <int> filtered-count: 0;
    in property <int> page: 1;
    in property <int> page-count: 1;
    // Which main panel is showing: "library" | "collections" | "series".
    property <string> panel: "library";
    // Move-to-Trash confirmation modal (-1 = closed).
    property <int> confirm-trash-id: -1;
    property <string> confirm-trash-title: "";
    // Name of the active collection (for its banner); set on pick.
    property <string> active-collection-name: "";
    in property <string> active-file-type: "";
    in property <string> active-quick: "all";
    in property <string> active-genre: "";
    in property <string> active-author: "";
    in property <string> active-series: "";
    in property <int> active-collection: 0;
    in property <[BookChip]> series: [];
    in property <[CollChip]> collections: [];
    in-out property <bool> search-contents: false;
    in property <string> view-mode: "grid";
    in-out property <string> search-text: "";
    // True when any filter/search narrows the grid — drives the empty-state copy.
    property <bool> filtered: root.active-file-type != "" || root.active-genre != ""
        || root.active-quick != "all" || root.search-text != "" || root.active-author != "";

    // actions out
    callback search(string);
    callback resume();
    callback hero-details();
    // Hero slider: how many in-progress slides, which is active, and step ±1
    // (Rust swaps `hero` + updates the index).
    in property <int> hero-count: 0;
    in property <int> hero-index: 0;
    callback hero-slide(int);
    callback add-books();
    callback open-details(int);
    callback toggle-favorite(int);
    callback card-menu-action(int, string);
    // Context-menu actions + Trash.
    callback open-location(int);
    callback trash-book(int);
    callback restore-book(int);
    callback delete-perm(int);
    in property <int> trashed-count: 0;
    callback set-file-type(string);
    callback set-sort(string);
    callback set-view-mode(string);
    callback quick-filter(string);
    callback genre-filter(string);
    callback stat-card(string);
    callback set-page(int);
    callback set-rating(int, float);
    callback open-author(string);
    // Series / collections / content search / stats.
    callback series-filter(string);
    callback collection-filter(int);
    callback collection-create(string);
    callback collection-delete(int);
    callback collection-toggle(int, int); // (book-id, collection-id)
    callback set-search-contents(bool);
    callback open-stats();
    // Reading-stats panel (R: reading-stats page).
    in-out property <bool> stats-open: false;
    in property <float> stats-hours: 0;
    in property <int> stats-days: 0;
    in property <int> stats-finished: 0;
    in property <int> stats-started: 0;
    in property <int> stats-streak: 0;
    in property <[bool]> stats-heat: [];
    in property <[StatBookRow]> stats-books: [];
    // Book detail popup (R1).
    callback show-detail(int);
    callback fetch-summary(int);
    in property <[CollRow]> detail-collections: [];
    in-out property <bool> detail-open: false;
    in property <int> detail-id: 0;
    in property <string> detail-title: "";
    in property <string> detail-author: "";
    in property <image> detail-cover;
    in property <color> detail-hue: #6c4df6;
    in property <string> detail-format: "";
    in property <string> detail-genre: "";
    in property <string> detail-series: "";
    in property <string> detail-size: "";
    in property <string> detail-added: "";
    in property <string> detail-published: "";
    in property <float> detail-rating: 0;
    in property <float> detail-net-rating: 0; // fetched average (detail-only)
    in property <float> detail-percent: 0;
    in property <string> detail-summary: "";
    in property <bool> detail-summary-loading: false;
    // Delete confirmation sub-state (inside the detail popup).
    property <bool> confirm-delete: false;

    background: BookTheme.canvas;

    VerticalLayout {
        padding: 24px; spacing: 20px;

        // ── header row ──────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 16px;
            // badge + title
            VerticalLayout { alignment: center; horizontal-stretch: 0;
                Rectangle { width: 40px; height: 40px; border-radius: 12px; background: BookTheme.tint-violet;
                    AppIcon { source: Icons.book-open; tint: BookTheme.accent; width: 22px; height: 22px; } } }
            VerticalLayout { alignment: center; horizontal-stretch: 0;
                Text { text: "My Library"; color: BookTheme.ink; font-size: 26px; font-weight: 800;
                    vertical-alignment: center; } }
            // search box — solid bordered field (was a near-invisible pill)
            Rectangle {
                horizontal-stretch: 1; max-width: 460px; height: 42px; border-radius: 21px;
                background: BookTheme.card;
                border-width: 1.5px;
                border-color: ti.has-focus ? BookTheme.accent.with-alpha(0.55) : BookTheme.hairline;
                animate border-color { duration: 120ms; }
                HorizontalLayout {
                    padding-left: 16px; padding-right: 10px; spacing: 10px; alignment: start;
                    VerticalLayout { alignment: center;
                        AppIcon { source: Icons.search; tint: BookTheme.ink-dim; width: 18px; height: 18px; } }
                    Rectangle {
                        horizontal-stretch: 1;
                        // Placeholder sits behind; input is on top in z-order.
                        if root.search-text == "": Text { text: "Search by title, author, genre…";
                            x: 0; color: BookTheme.ink-dim; font-size: 14px;
                            vertical-alignment: center; horizontal-alignment: left; }
                        ti := TextInput {
                            width: 100%; height: 100%;
                            vertical-alignment: center;
                            color: BookTheme.ink; font-size: 14px; single-line: true;
                            text <=> root.search-text;
                            edited => { root.search(self.text); }
                            accepted => { root.search(self.text); }
                        }
                    }
                    // Content-search toggle: search inside book text (FTS).
                    VerticalLayout { alignment: center;
                        Rectangle {
                            width: 30px; height: 30px; border-radius: 8px;
                            background: root.search-contents ? BookTheme.accent.with-alpha(0.16) : transparent;
                            AppIcon { source: Icons.file-text;
                                tint: root.search-contents ? BookTheme.accent : BookTheme.ink-dim;
                                width: 17px; height: 17px; }
                            TouchArea { mouse-cursor: pointer;
                                clicked => { root.set-search-contents(!root.search-contents); } }
                        } }
                    // ⌘K hint badge.
                    VerticalLayout { alignment: center;
                        Rectangle { width: 34px; height: 22px; border-radius: 6px; background: BookTheme.pill-bg;
                            Text { text: "⌘K"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center; } } }
                }
            }
            PillButton { label: "Stats"; icon: Icons.clock; compact: true;
                clicked => { root.open-stats(); } }
            PillButton { label: "Add books"; icon: Icons.plus; filled: true; compact: true;
                clicked => { root.add-books(); } }
        }

        // ── hero row ────────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 20px; height: 210px;
            // continue-reading card — slider over up-to-5 in-progress books
            Card {
                horizontal-stretch: 1;
                clip: true;
                if root.hero.present: HorizontalLayout {
                    padding: 16px; spacing: 18px;
                    Cover { width: 130px; source: root.hero.cover;
                        title: root.hero.title; author: root.hero.author; hue: root.hero.hue; }
                    VerticalLayout {
                        alignment: center; spacing: 6px; horizontal-stretch: 1;
                        Text { text: "CONTINUE READING"; color: BookTheme.accent; font-size: 11px;
                            font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.hero.title; color: BookTheme.ink; font-size: 24px;
                            font-weight: 800; overflow: elide; }
                        Text { text: root.hero.author; color: BookTheme.ink-dim; font-size: 14px;
                            font-weight: 500; overflow: elide; }
                        // progress — thicker (2×) but shorter so the art has room
                        HorizontalLayout { alignment: start;
                            Rectangle { width: 280px; height: 10px; border-radius: 5px; background: BookTheme.track;
                                Rectangle { x: 0; width: parent.width * root.hero.percent / 100; height: 10px;
                                    border-radius: 5px; background: BookTheme.accent; } } }
                        Text { color: BookTheme.ink-dim; font-size: 12px;
                            text: "Page " + root.hero.page + " of " + root.hero.total + " • "
                                + Math.round(root.hero.percent) + "%   " + root.hero.time-left; }
                        HorizontalLayout {
                            spacing: 10px; alignment: start; padding-top: 6px;
                            PillButton { label: "Resume"; icon: Icons.book-open; filled: true;
                                clicked => { root.resume(); } }
                            PillButton { label: "Details";
                                clicked => { root.show-detail(root.hero.id); } }
                            // slide dots
                            if root.hero-count > 1: VerticalLayout { alignment: center;
                                HorizontalLayout { spacing: 5px;
                                    for i in root.hero-count: Rectangle {
                                        width: 7px; height: 7px; border-radius: 4px;
                                        background: i == root.hero-index
                                            ? BookTheme.accent : BookTheme.track; } } }
                        }
                    }
                    // decorative art (right) — theme-matched variant
                    if root.hero.art-light.width > 0: VerticalLayout { alignment: center; horizontal-stretch: 0;
                        Image { source: BookTheme.dark ? root.hero.art-dark : root.hero.art-light;
                            image-fit: contain; width: 220px; height: 170px; } }
                }
                // ← / → slider arrows (only when >1 in-progress book)
                if root.hero.present && root.hero-count > 1: Rectangle {
                    x: 8px; y: (parent.height - 34px) / 2; width: 34px; height: 34px; border-radius: 17px;
                    background: la.has-hover ? BookTheme.pill-bg : BookTheme.card;
                    border-width: 1px; border-color: BookTheme.hairline;
                    AppIcon { source: Icons.chevron-left; tint: BookTheme.ink; width: 18px; height: 18px; }
                    la := TouchArea { mouse-cursor: pointer; clicked => { root.hero-slide(-1); } }
                }
                if root.hero.present && root.hero-count > 1: Rectangle {
                    x: parent.width - 42px; y: (parent.height - 34px) / 2; width: 34px; height: 34px; border-radius: 17px;
                    background: ra.has-hover ? BookTheme.pill-bg : BookTheme.card;
                    border-width: 1px; border-color: BookTheme.hairline;
                    AppIcon { source: Icons.chevron-right; tint: BookTheme.ink; width: 18px; height: 18px; }
                    ra := TouchArea { mouse-cursor: pointer; clicked => { root.hero-slide(1); } }
                }
                if !root.hero.present: VerticalLayout {
                    alignment: center; spacing: 6px;
                    HorizontalLayout { alignment: center;
                        AppIcon { source: Icons.book-open; tint: BookTheme.ink-dim; width: 40px; height: 40px; } }
                    Text { text: "Nothing in progress"; color: BookTheme.ink; font-size: 16px;
                        font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Open a book to start reading"; color: BookTheme.ink-dim;
                        font-size: 13px; horizontal-alignment: center; }
                }
            }
            // stats 2×2 (fixed identities; values flow in via `stats` model).
            Rectangle {
                width: 520px;
                VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout { spacing: 12px;
                        StatCard { horizontal-stretch: 1; label: "Total Books";
                            value: root.stats.length > 0 ? stats[0].value : "0";
                            tint: BookTheme.tint-violet; accent: #6c4df6; icon: Icons.book-open;
                            clicked => { root.stat-card("total"); } }
                        StatCard { horizontal-stretch: 1; label: "Authors";
                            value: root.stats.length > 1 ? stats[1].value : "0";
                            tint: BookTheme.tint-pink; accent: #e0518f; icon: Icons.user;
                            clicked => { root.stat-card("authors"); } }
                    }
                    HorizontalLayout { spacing: 12px;
                        StatCard { horizontal-stretch: 1; label: "In Progress";
                            value: root.stats.length > 2 ? stats[2].value : "0";
                            tint: BookTheme.tint-orange; accent: #f5a623; icon: Icons.circle;
                            clicked => { root.stat-card("reading"); } }
                        StatCard { horizontal-stretch: 1; label: "Completed";
                            value: root.stats.length > 3 ? stats[3].value : "0";
                            tint: BookTheme.tint-green; accent: #2fbf71; icon: Icons.check;
                            clicked => { root.stat-card("finished"); } }
                    }
                }
            }
        }

        // ── main row ────────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 20px; vertical-stretch: 1;
            // left: toolbar + grid + pagination
            VerticalLayout {
                horizontal-stretch: 1; spacing: 16px;
                // toolbar card
                Card {
                    height: 60px;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 8px;
                        // Status chips. Tabs are mutually exclusive: "All" only
                        // lights up when no series/collection/author filter is on.
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            FilterChip { label: "All";
                                active: root.panel == "library" && (root.active-quick == "all" || root.active-quick == "")
                                    && root.active-series == "" && root.active-collection == 0 && root.active-author == "";
                                clicked => { root.panel = "library"; root.quick-filter("all"); } } }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            FilterChip { label: "Reading"; active: root.panel == "library" && root.active-quick == "reading";
                                clicked => { root.panel = "library"; root.quick-filter("reading"); } } }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            FilterChip { label: "Unread"; active: root.panel == "library" && root.active-quick == "unread";
                                clicked => { root.panel = "library"; root.quick-filter("unread"); } } }
                        // Collections page (left of Favorites).
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            FilterChip { label: "Collections"; count: root.collections.length;
                                active: root.panel == "collections";
                                clicked => { root.panel = "collections"; } } }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            FilterChip { label: "Favorites"; active: root.panel == "library" && root.active-quick == "favorites";
                                clicked => { root.panel = "library"; root.quick-filter("favorites"); } } }
                        // Series page (left of Trash).
                        if root.series.length > 0: VerticalLayout { alignment: center; horizontal-stretch: 0;
                            FilterChip { label: "Series"; count: root.series.length;
                                active: root.panel == "series";
                                clicked => { root.panel = "series"; } } }
                        // Trash view (soft-deleted books; restore from the ⋮ menu).
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            FilterChip { label: "Trash"; count: root.trashed-count;
                                active: root.panel == "library" && root.active-quick == "trashed";
                                clicked => { root.panel = "library"; root.quick-filter("trashed"); } } }
                        Rectangle { horizontal-stretch: 1; }
                        // Filters button — now holds File type + Sort in a popover.
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Rectangle {
                                height: 36px; border-radius: 18px; background: fta.has-hover ? BookTheme.pill-bg : BookTheme.card;
                                border-width: 1.5px; border-color: BookTheme.accent.with-alpha(0.35);
                                HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 6px; alignment: center;
                                    VerticalLayout { alignment: center;
                                        AppIcon { source: Icons.sliders; tint: BookTheme.accent; width: 15px; height: 15px; } }
                                    Text { text: "Filters"; color: BookTheme.accent; font-size: 13px; font-weight: 700; vertical-alignment: center; } }
                                fta := TouchArea { mouse-cursor: pointer; clicked => { filters-popup.show(); } }
                                filters-popup := PopupWindow {
                                    // no-auto-close: a ComboBox opens its own popup, which would
                                    // otherwise count as an outside-click and dismiss this one.
                                    close-policy: no-auto-close;
                                    x: parent.width - 260px; y: parent.height + 6px; width: 260px;
                                    Rectangle {
                                        background: BookTheme.card; border-radius: 12px;
                                        border-width: 1px; border-color: BookTheme.hairline;
                                        drop-shadow-blur: 16px; drop-shadow-color: #0000002e;
                                        VerticalLayout {
                                            padding: 14px; spacing: 8px;
                                            Text { text: "File type"; color: BookTheme.ink-dim; font-size: 12px; font-weight: 600; }
                                            ComboBox { model: root.file-type-options;
                                                selected(v) => { root.set-file-type(v); } }
                                            Text { text: "Sort by"; color: BookTheme.ink-dim; font-size: 12px; font-weight: 600; }
                                            ComboBox { model: root.sort-options; current-index: root.sort-index;
                                                selected(v) => { root.set-sort(v); } }
                                            Rectangle { height: 2px; }
                                            Rectangle { height: 36px; border-radius: 18px; background: BookTheme.accent;
                                                Text { text: "Apply"; color: #ffffff; font-size: 13px; font-weight: 700;
                                                    horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { mouse-cursor: pointer; clicked => { filters-popup.close(); } } }
                                        }
                                    }
                                }
                            } }
                        // Pagination (moved from below the grid) — prev · p/N · next.
                        if root.page-count > 1: VerticalLayout { alignment: center; horizontal-stretch: 0;
                            HorizontalLayout { spacing: 6px;
                                Rectangle { width: 32px; height: 32px; border-radius: 16px;
                                    background: root.page > 1 ? BookTheme.card : BookTheme.pill-bg;
                                    border-width: 1px; border-color: BookTheme.hairline;
                                    AppIcon { source: Icons.chevron-left; tint: BookTheme.ink; width: 16px; height: 16px; }
                                    TouchArea { mouse-cursor: pointer;
                                        clicked => { if (root.page > 1) { root.set-page(root.page - 1); } } } }
                                Text { text: root.page + " / " + root.page-count; color: BookTheme.ink;
                                    font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                Rectangle { width: 32px; height: 32px; border-radius: 16px;
                                    background: root.page < root.page-count ? BookTheme.card : BookTheme.pill-bg;
                                    border-width: 1px; border-color: BookTheme.hairline;
                                    AppIcon { source: Icons.chevron-right; tint: BookTheme.ink; width: 16px; height: 16px; }
                                    TouchArea { mouse-cursor: pointer;
                                        clicked => { if (root.page < root.page-count) { root.set-page(root.page + 1); } } } }
                            } }
                    }
                }
                // Author page banner (shown when filtered to one author).
                if root.active-author != "": HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                        Rectangle { width: 40px; height: 40px; border-radius: 20px; background: BookTheme.tint-pink;
                            AppIcon { source: Icons.user; tint: #e0518f; width: 20px; height: 20px; } } }
                    VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 1px;
                        Text { text: "Books by " + root.active-author; color: BookTheme.ink;
                            font-size: 20px; font-weight: 800; overflow: elide; }
                        Text { text: root.filtered-count + (root.filtered-count == 1 ? " book" : " books");
                            color: BookTheme.ink-dim; font-size: 12px; } }
                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            height: 38px; border-radius: 19px; background: cba.has-hover ? BookTheme.pill-bg : BookTheme.card;
                            border-width: 1.5px; border-color: BookTheme.hairline;
                            HorizontalLayout { padding-left: 14px; padding-right: 16px; spacing: 6px; alignment: center;
                                VerticalLayout { alignment: center;
                                    AppIcon { source: Icons.x; tint: BookTheme.ink-dim; width: 14px; height: 14px; } }
                                Text { text: "All books"; color: BookTheme.ink; font-size: 13px;
                                    font-weight: 600; vertical-alignment: center; } }
                            cba := TouchArea { mouse-cursor: pointer; clicked => { root.open-author(""); } }
                        } }
                }
                // Series filter banner.
                if root.panel == "library" && root.active-series != "": HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                        Rectangle { width: 40px; height: 40px; border-radius: 20px; background: BookTheme.tint-violet;
                            AppIcon { source: Icons.book-open; tint: BookTheme.accent; width: 20px; height: 20px; } } }
                    VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 1px;
                        Text { text: "Series · " + root.active-series; color: BookTheme.ink;
                            font-size: 20px; font-weight: 800; overflow: elide; }
                        Text { text: root.filtered-count + (root.filtered-count == 1 ? " book" : " books");
                            color: BookTheme.ink-dim; font-size: 12px; } }
                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            height: 38px; border-radius: 19px; background: sba.has-hover ? BookTheme.pill-bg : BookTheme.card;
                            border-width: 1.5px; border-color: BookTheme.hairline;
                            HorizontalLayout { padding-left: 14px; padding-right: 16px; spacing: 6px; alignment: center;
                                VerticalLayout { alignment: center;
                                    AppIcon { source: Icons.x; tint: BookTheme.ink-dim; width: 14px; height: 14px; } }
                                Text { text: "All books"; color: BookTheme.ink; font-size: 13px;
                                    font-weight: 600; vertical-alignment: center; } }
                            sba := TouchArea { mouse-cursor: pointer; clicked => { root.quick-filter("all"); } }
                        } }
                }
                // Collection filter banner.
                if root.panel == "library" && root.active-collection > 0: HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                        Rectangle { width: 40px; height: 40px; border-radius: 20px; background: BookTheme.tint-violet;
                            AppIcon { source: Icons.bookmark; tint: BookTheme.accent; width: 20px; height: 20px; } } }
                    VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 1px;
                        Text { text: "Collection · " + root.active-collection-name; color: BookTheme.ink;
                            font-size: 20px; font-weight: 800; overflow: elide; }
                        Text { text: root.filtered-count + (root.filtered-count == 1 ? " book" : " books");
                            color: BookTheme.ink-dim; font-size: 12px; } }
                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            height: 38px; border-radius: 19px; background: cbb.has-hover ? BookTheme.pill-bg : BookTheme.card;
                            border-width: 1.5px; border-color: BookTheme.hairline;
                            HorizontalLayout { padding-left: 14px; padding-right: 16px; spacing: 6px; alignment: center;
                                VerticalLayout { alignment: center;
                                    AppIcon { source: Icons.x; tint: BookTheme.ink-dim; width: 14px; height: 14px; } }
                                Text { text: "All books"; color: BookTheme.ink; font-size: 13px;
                                    font-weight: 600; vertical-alignment: center; } }
                            cbb := TouchArea { mouse-cursor: pointer; clicked => { root.quick-filter("all"); } }
                        } }
                }
                // grid (scrollable) — only in the library panel
                if root.panel == "library": sv := ScrollView {
                    vertical-stretch: 1;
                    // Reset scroll to top when the page changes (ScrollView keeps a
                    // stale viewport-y otherwise).
                    property <int> watch-page: root.page;
                    changed watch-page => { sv.viewport-y = 0; }
                    grid := Rectangle {
                        property <length> gap: 16px;
                        // Full-bleed 4×3: 12 books per page, cells stretch to fill
                        // the whole grid area (no blank margins left/right/bottom).
                        property <int> cols: 4;
                        property <int> rows: 3;
                        property <length> cell-w: (sv.visible-width - (cols - 1) * gap) / cols;
                        property <length> cell-h: (sv.visible-height - (rows - 1) * gap) / rows;
                        width: sv.visible-width;
                        height: sv.visible-height;
                        for tile[idx] in root.tiles: GridTile {
                            x: Math.mod(idx, grid.cols) * (grid.cell-w + grid.gap);
                            y: Math.floor(idx / grid.cols) * (grid.cell-h + grid.gap);
                            width: grid.cell-w; height: grid.cell-h;
                            tile: tile;
                            collections: root.collections;
                            add-collection(cid) => { root.collection-toggle(tile.id, cid); }
                            open => { root.show-detail(tile.id); }
                            favorite => { root.toggle-favorite(tile.id); }
                            rate(v) => { root.set-rating(tile.id, v); }
                            open-author => { root.open-author(tile.author); }
                            open-location => { root.open-location(tile.id); }
                            ask-delete => { root.confirm-trash-id = tile.id; root.confirm-trash-title = tile.title; }
                            restore => { root.restore-book(tile.id); }
                            delete-perm => { root.delete-perm(tile.id); }
                        }
                        if tiles.length == 0: VerticalLayout {
                            alignment: center; spacing: 8px;
                            HorizontalLayout { alignment: center;
                                AppIcon { source: root.filtered ? Icons.search : Icons.book-open;
                                    tint: BookTheme.ink-dim; width: 48px; height: 48px; } }
                            Text {
                                text: root.filtered ? "No books match your filters" : "No books here";
                                color: BookTheme.ink; font-size: 16px;
                                font-weight: 700; horizontal-alignment: center; }
                            Text {
                                text: root.filtered ? "Try clearing a filter or search"
                                    : "Add a folder to start your library";
                                color: BookTheme.ink-dim; font-size: 13px; horizontal-alignment: center; }
                        }
                    }
                }
                // Collections page.
                if root.panel == "collections": VerticalLayout {
                    vertical-stretch: 1; spacing: 12px;
                    HorizontalLayout { spacing: 8px;
                        newcol := LineEdit { placeholder-text: "New collection…"; horizontal-stretch: 1;
                            accepted(t) => { root.collection-create(t); self.text = ""; } }
                        Rectangle { width: 96px; height: 36px; border-radius: 10px; background: BookTheme.accent;
                            HorizontalLayout { alignment: center; spacing: 6px;
                                VerticalLayout { alignment: center;
                                    AppIcon { source: Icons.plus; tint: #ffffff; width: 15px; height: 15px; } }
                                Text { text: "Create"; color: #ffffff; font-size: 13px; font-weight: 700;
                                    vertical-alignment: center; } }
                            TouchArea { mouse-cursor: pointer;
                                clicked => { root.collection-create(newcol.text); newcol.text = ""; } } }
                    }
                    clsv := ScrollView { vertical-stretch: 1;
                        VerticalLayout { width: clsv.visible-width; spacing: 8px;
                            for c in root.collections: EntryCard {
                                label: c.name; count: c.count; icon: Icons.bookmark;
                                clicked => { root.active-collection-name = c.name; root.collection-filter(c.id); root.panel = "library"; }
                                deletable: true;
                                deleted => { root.collection-delete(c.id); } }
                            if root.collections.length == 0: Text { text: "No collections yet — create one above.";
                                color: BookTheme.ink-dim; font-size: 13px; }
                        }
                    }
                }
                // Series page.
                if root.panel == "series": srsv := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout { width: srsv.visible-width; spacing: 8px;
                        for sr in root.series: EntryCard {
                            label: sr.label; count: sr.count; icon: Icons.book-open;
                            clicked => { root.series-filter(sr.key); root.panel = "library"; } }
                        if root.series.length == 0: Text { text: "No series in your library.";
                            color: BookTheme.ink-dim; font-size: 13px; }
                    }
                }
            }
            // right rail
            Card {
                width: 300px;
                ScrollView {
                    VerticalLayout {
                        padding: 18px; spacing: 20px; alignment: start;
                        RailBlock { title: "QUICK FILTERS";
                            for q[i] in root.quick-filters: RailRow {
                                label: q.label; count: q.count; active: root.active-quick == q.key;
                                icon: q.key == "reading" ? Icons.book-open
                                    : q.key == "finished" ? Icons.check
                                    : q.key == "unread" ? Icons.circle
                                    : q.key == "favorites" ? Icons.star
                                    : Icons.layout-grid;
                                icon-tint: q.key == "reading" ? #3a86ff
                                    : q.key == "finished" ? #2fbf71
                                    : q.key == "favorites" ? #f5a623
                                    : BookTheme.accent;
                                clicked => { root.quick-filter(q.key); } } }
                        RailBlock { title: "FILE TYPES";
                            for ft[i] in root.file-types: RailRow {
                                label: ft.label; count: ft.count; active: root.active-file-type == ft.key;
                                icon: Icons.book-open; icon-tint: BookTheme.accent;
                                clicked => { root.set-file-type(ft.key); } } }
                        // Genres — colored chips + "View all".
                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                Text { text: "GENRES"; color: BookTheme.ink-dim; font-size: 11px;
                                    font-weight: 700; letter-spacing: 0.6px; horizontal-stretch: 1;
                                    vertical-alignment: center; }
                                Text { text: "View all"; color: BookTheme.accent; font-size: 11px;
                                    font-weight: 700; vertical-alignment: center; }
                            }
                            for g[i] in root.genres: GenreChip {
                                label: g.label; count: g.count; active: root.active-genre == g.key;
                                hue: root.genre-hues[Math.mod(i, root.genre-hues.length)];
                                clicked => { root.genre-filter(g.key); } }
                        }
                        // Series + Collections moved to the toolbar dropdowns.
                        Rectangle { height: 4px; }
                    }
                }
            }
        }
    }

    // ── Move-to-Trash confirmation modal ───────────────────────────────────────
    if root.confirm-trash-id >= 0: Rectangle {
        width: 100%; height: 100%; background: #00000066;
        TouchArea { clicked => { root.confirm-trash-id = -1; } }
        Rectangle {
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            width: 380px; height: 190px; border-radius: 18px; background: BookTheme.card;
            drop-shadow-blur: 30px; drop-shadow-color: #00000044;
            TouchArea {} // swallow clicks so the backdrop doesn't dismiss
            VerticalLayout {
                padding: 22px; spacing: 10px;
                Text { text: "Move to Trash?"; color: BookTheme.ink; font-size: 18px; font-weight: 800; }
                Text { text: root.confirm-trash-title; color: BookTheme.ink-dim; font-size: 13px;
                    wrap: word-wrap; overflow: elide; horizontal-stretch: 1; }
                Text { text: "The file moves to the app Trash. You can restore it later.";
                    color: BookTheme.ink-dim; font-size: 12px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { spacing: 10px; alignment: end;
                    Rectangle { width: 100px; height: 38px; border-radius: 10px; background: BookTheme.pill-bg;
                        Text { text: "Cancel"; color: BookTheme.ink; font-size: 13px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.confirm-trash-id = -1; } } }
                    Rectangle { width: 130px; height: 38px; border-radius: 10px; background: #d6336c;
                        Text { text: "Move to Trash"; color: #ffffff; font-size: 13px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer;
                            clicked => { root.trash-book(root.confirm-trash-id); root.confirm-trash-id = -1; } } }
                }
            }
        }
    }

    // ── Book detail popup (R1) ─────────────────────────────────────────────────
    if root.detail-open: Rectangle {
        width: 100%; height: 100%;
        background: #00000066;
        TouchArea { clicked => { root.detail-open = false; root.confirm-delete = false; } }
    }
    if root.detail-open: Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 640px;
        height: 460px;
        border-radius: 20px;
        background: BookTheme.card;
        border-width: 1px;
        border-color: BookTheme.hairline;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 10px;
        HorizontalLayout {
            padding: 22px; spacing: 20px;
            // Cover.
            Cover {
                width: 168px; height: 246px;
                source: root.detail-cover;
                format: root.detail-format;
                title: root.detail-title;
                author: root.detail-author;
                hue: root.detail-hue;
            }
            // Right column.
            VerticalLayout {
                horizontal-stretch: 1; spacing: 10px;
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 2px; horizontal-stretch: 1;
                        Text { text: root.detail-title; color: BookTheme.ink; font-size: 20px;
                            font-weight: 800; wrap: word-wrap; overflow: elide; }
                        Text { text: root.detail-author; color: BookTheme.accent; font-size: 13px; font-weight: 600;
                            TouchArea { mouse-cursor: pointer; clicked => { root.detail-open = false; root.open-author(root.detail-author); } } }
                    }
                    Rectangle {
                        width: 30px; height: 30px; border-radius: 15px;
                        background: xta.has-hover ? BookTheme.pill-bg : transparent;
                        AppIcon { source: Icons.x; tint: BookTheme.ink-dim; width: 15px; height: 15px; }
                        xta := TouchArea { mouse-cursor: pointer; clicked => { root.detail-open = false; root.confirm-delete = false; } }
                    }
                }
                // Meta row (format · genre · size · added).
                Text {
                    text: root.detail-format
                        + (root.detail-genre != "" ? "  ·  " + root.detail-genre : "")
                        + (root.detail-size != "" ? "  ·  " + root.detail-size : "")
                        + (root.detail-added != "" ? "  ·  " + root.detail-added : "");
                    color: BookTheme.ink-dim; font-size: 12px; wrap: word-wrap;
                }
                Text { text: "Publication Date : " + (root.detail-published != "" ? root.detail-published : "—");
                    color: BookTheme.ink-dim; font-size: 12px; }
                if root.detail-series != "": Text { text: "Series: " + root.detail-series;
                    color: BookTheme.accent; font-size: 12px; font-weight: 600;
                    TouchArea { mouse-cursor: pointer;
                        clicked => { root.detail-open = false; root.series-filter(root.detail-series); } } }
                HorizontalLayout { spacing: 12px; alignment: start;
                    VerticalLayout { alignment: center;
                        Stars { rating: root.detail-rating; rate(v) => { root.set-rating(root.detail-id, v); } } }
                    // Fetched average rating (read-only) — detail popup only.
                    if root.detail-net-rating > 0: VerticalLayout { alignment: center;
                        Rectangle { height: 22px; border-radius: 11px; background: #f5a623.with-alpha(0.16);
                            HorizontalLayout { padding-left: 9px; padding-right: 9px; spacing: 4px; alignment: center;
                                VerticalLayout { alignment: center;
                                    AppIcon { source: Icons.star-filled; tint: #f5a623; width: 12px; height: 12px; } }
                                Text { text: Math.round(root.detail-net-rating * 10) / 10 + " avg";
                                    color: #cf8a12; font-size: 11px; font-weight: 700; vertical-alignment: center; } } } }
                }
                if root.detail-percent > 0: Text {
                    text: Math.round(root.detail-percent * 100) + "% read";
                    color: BookTheme.ink-dim; font-size: 12px;
                }
                // Collections — toggle membership for this book.
                if root.detail-collections.length > 0: HorizontalLayout {
                    spacing: 6px; alignment: start;
                    for c in root.detail-collections: Rectangle {
                        height: 26px; border-radius: 13px;
                        min-width: 44px;
                        background: c.member ? BookTheme.accent : BookTheme.pill-bg;
                        HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 4px;
                            Text { text: (c.member ? "✓ " : "+ ") + c.name;
                                color: c.member ? #ffffff : BookTheme.ink; font-size: 11px;
                                font-weight: 600; vertical-alignment: center; } }
                        TouchArea { mouse-cursor: pointer;
                            clicked => { root.collection-toggle(root.detail-id, c.id); } }
                    }
                }
                // Summary.
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 10px; background: BookTheme.pill-bg.with-alpha(0.5);
                    ScrollView {
                        VerticalLayout {
                            padding: 10px; spacing: 6px;
                            Text { text: root.detail-summary-loading ? "Fetching summary…"
                                    : (root.detail-summary != "" ? root.detail-summary : "No summary yet.");
                                color: BookTheme.ink; font-size: 12px; wrap: word-wrap; }
                            if root.detail-summary == "" && !root.detail-summary-loading: Text {
                                text: "Fetch from online →"; color: BookTheme.accent; font-size: 12px; font-weight: 700;
                                TouchArea { mouse-cursor: pointer; clicked => { root.fetch-summary(root.detail-id); } }
                            }
                        }
                    }
                }
                // Actions.
                if !root.confirm-delete: HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        height: 42px; border-radius: 11px; background: BookTheme.accent; horizontal-stretch: 1;
                        HorizontalLayout { alignment: center; spacing: 6px;
                            AppIcon { source: Icons.book-open; tint: #ffffff; width: 16px; height: 16px; vertical-alignment: center; }
                            Text { text: "Open"; color: #ffffff; font-size: 14px; font-weight: 700; vertical-alignment: center; } }
                        TouchArea { mouse-cursor: pointer; clicked => { root.detail-open = false; root.open-details(root.detail-id); } }
                    }
                    Rectangle {
                        width: 46px; height: 42px; border-radius: 11px;
                        background: refta.has-hover ? BookTheme.pill-bg : BookTheme.card;
                        border-width: 1px; border-color: BookTheme.hairline;
                        AppIcon { source: Icons.refresh-cw; tint: BookTheme.ink-dim; width: 16px; height: 16px; }
                        refta := TouchArea { mouse-cursor: pointer; clicked => { root.fetch-summary(root.detail-id); } }
                    }
                    Rectangle {
                        width: 46px; height: 42px; border-radius: 11px;
                        background: delta.has-hover ? #d6454518 : BookTheme.card;
                        border-width: 1px; border-color: #d6454555;
                        AppIcon { source: Icons.trash; tint: #d64545; width: 16px; height: 16px; }
                        delta := TouchArea { mouse-cursor: pointer; clicked => { root.confirm-delete = true; } }
                    }
                }
                // Delete confirmation.
                if root.confirm-delete: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Remove “" + root.detail-title + "” from your library? The file on disk is kept.";
                        color: BookTheme.ink; font-size: 12px; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            height: 40px; border-radius: 10px; horizontal-stretch: 1;
                            background: cta.has-hover ? BookTheme.pill-bg : BookTheme.card;
                            border-width: 1px; border-color: BookTheme.hairline;
                            Text { text: "Cancel"; color: BookTheme.ink; font-size: 13px; font-weight: 700; }
                            cta := TouchArea { mouse-cursor: pointer; clicked => { root.confirm-delete = false; } }
                        }
                        Rectangle {
                            height: 40px; border-radius: 10px; horizontal-stretch: 1; background: #d64545;
                            Text { text: "Remove"; color: #ffffff; font-size: 13px; font-weight: 700; }
                            TouchArea { mouse-cursor: pointer; clicked => {
                                root.confirm-delete = false; root.detail-open = false;
                                root.card-menu-action(root.detail-id, "remove");
                            } }
                        }
                    }
                }
            }
        }
    }

    // ── Reading-stats panel ────────────────────────────────────────────────────
    if root.stats-open: Rectangle {
        width: 100%; height: 100%;
        background: #00000066;
        TouchArea { clicked => { root.stats-open = false; } }
    }
    if root.stats-open: Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 620px;
        height: 500px;
        border-radius: 20px;
        background: BookTheme.card;
        border-width: 1px;
        border-color: BookTheme.hairline;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 10px;
        VerticalLayout {
            padding: 22px; spacing: 16px;
            HorizontalLayout {
                alignment: space-between;
                Text { text: "Reading stats"; color: BookTheme.ink; font-size: 20px; font-weight: 800;
                    vertical-alignment: center; }
                Rectangle { width: 30px; height: 30px; border-radius: 15px;
                    background: sxta.has-hover ? BookTheme.pill-bg : transparent;
                    AppIcon { source: Icons.x; tint: BookTheme.ink-dim; width: 15px; height: 15px; }
                    sxta := TouchArea { mouse-cursor: pointer; clicked => { root.stats-open = false; } } }
            }
            // Big numbers.
            HorizontalLayout {
                spacing: 12px;
                for m in [
                    { v: root.stats-hours + "h", l: "Read" },
                    { v: root.stats-streak + "d", l: "Streak" },
                    { v: root.stats-finished + "", l: "Finished" },
                    { v: root.stats-started + "", l: "Started" },
                    { v: root.stats-days + "", l: "Days" },
                ]: Rectangle {
                    horizontal-stretch: 1; height: 74px; border-radius: 12px; background: BookTheme.pill-bg;
                    VerticalLayout { alignment: center; spacing: 2px;
                        Text { text: m.v; color: BookTheme.accent; font-size: 22px; font-weight: 800;
                            horizontal-alignment: center; }
                        Text { text: m.l; color: BookTheme.ink-dim; font-size: 11px; font-weight: 600;
                            horizontal-alignment: center; } }
                }
            }
            // 12-week heatmap (84 days, 7 rows × 12 cols).
            Text { text: "Last 12 weeks"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700;
                letter-spacing: 0.5px; }
            Rectangle {
                height: 7 * 15px;
                // 84 days laid out 12 cols × 7 rows (index = col*7 + row).
                for hd[i] in root.stats-heat: Rectangle {
                    x: Math.floor(i / 7) * 15px;
                    y: Math.mod(i, 7) * 15px;
                    width: 11px; height: 11px; border-radius: 3px;
                    background: hd ? BookTheme.accent : BookTheme.track;
                }
            }
            // Per-book time.
            Text { text: "Time per book"; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700;
                letter-spacing: 0.5px; }
            ScrollView {
                VerticalLayout {
                    spacing: 4px;
                    if root.stats-books.length == 0: Text { text: "No reading time logged yet.";
                        color: BookTheme.ink-dim; font-size: 12px; }
                    for b in root.stats-books: HorizontalLayout {
                        Text { text: b.title; color: BookTheme.ink; font-size: 13px; overflow: elide;
                            horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: b.time; color: BookTheme.ink-dim; font-size: 12px; font-weight: 600;
                            vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
