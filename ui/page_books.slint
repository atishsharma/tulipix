// Book Home page (np.p8.books.home) — target: docs/books-redesign/newbook22.png.
// ORIGINAL design (not derived from the dead cbook.png). Colors are PINNED to
// the SPEC light palette via the BookTheme global so the page reads the same
// regardless of the app dark/light Theme — Books is its own bright surface.
//
// Layout (fills parent): Header row · Hero row (Continue card + 2×2 stats) ·
// Main row (Toolbar + book grid + pagination | right rail: quick filters /
// file types / genres). All data flows in via `in` properties; every user
// action leaves through a callback the sec-books crate wires to the engine.
import { Theme } from "tokens.slint";
import { AppIcon, Icons } from "icons.slint";
import { ScrollView, ComboBox } from "std-widgets.slint";

// Pinned SPEC palette — independent of Theme so the surface never goes dark.
export global BookTheme {
    out property <color> canvas: #f2f2f7;
    out property <color> card: #ffffff;
    out property <color> accent: #6c4df6;
    out property <color> tint-violet: #efeaff;
    out property <color> tint-pink: #fdeef4;
    out property <color> tint-orange: #fff3e6;
    out property <color> tint-green: #e8f8ef;
    out property <color> ink: #1b1b22;
    out property <color> ink-dim: #8a8a94;
    out property <color> track: #ececf2;
    out property <color> pill-bg: #f4f4f8;
    out property <color> hairline: #ececf2;
    out property <length> radius: 16px;
    out property <color> shadow: #00000010;
}

// One book row for the grid. `percent` 0‥100; `cover` filled by Rust (empty →
// tinted placeholder shows through). `format` is the badge label (EPUB/PDF/…).
export struct BookTile {
    id: int,
    title: string,
    author: string,
    cover: image,
    percent: float,
    favorite: bool,
    format: string,
    date: string,
    hue: color,
    rating: float,
    missing: bool,
}

// Hero "Continue Reading" card. `present` false → empty-state hero.
export struct BooksHero {
    present: bool,
    title: string,
    author: string,
    cover: image,
    hue: color,
    page: int,
    total: int,
    percent: float,
    time-left: string,
}

// One of the four stat cards (2×2).
export struct BookStat {
    label: string,
    value: string,
    tint: color,
    accent: color,
    icon: image,
}

// A labelled chip with an optional count — file types, genres, quick filters.
export struct BookChip {
    key: string,
    label: string,
    count: int,
}

// ── small parts ───────────────────────────────────────────────────────────────

// White rounded card with the SPEC hairline shadow.
component Card inherits Rectangle {
    background: BookTheme.card;
    border-radius: BookTheme.radius;
    drop-shadow-blur: 2px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: BookTheme.shadow;
}

// Rounded pill button. `filled` → solid accent + white; else outline.
component PillButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> filled: false;
    in property <color> accent: BookTheme.accent;
    callback clicked();
    height: 40px;
    border-radius: 20px;
    horizontal-stretch: 0;
    background: filled ? accent : BookTheme.card;
    border-width: filled ? 0px : 1.5px;
    border-color: accent.with-alpha(0.35);
    property <color> ink: filled ? #ffffff : accent;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 16px; padding-right: 18px; spacing: 8px; alignment: center;
        VerticalLayout { alignment: center;
            if root.icon.width > 0: AppIcon { source: root.icon; tint: root.ink; width: 18px; height: 18px; } }
        Text { text: root.label; color: root.ink; font-size: 14px; font-weight: 700;
            vertical-alignment: center; }
    }
    states [ hover when ta.has-hover: { background: filled ? accent.darker(0.08) : BookTheme.pill-bg; } ]
    animate background { duration: 120ms; }
}

// Rounded filter chip with optional count badge.
component FilterChip inherits Rectangle {
    in property <string> label;
    in property <int> count: -1;
    in property <bool> active: false;
    callback clicked();
    height: 34px;
    border-radius: 17px;
    horizontal-stretch: 0;
    background: active ? BookTheme.accent : BookTheme.pill-bg;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 6px; alignment: center;
        Text { text: root.label; color: root.active ? #ffffff : BookTheme.ink;
            font-size: 13px; font-weight: 600; vertical-alignment: center; }
        if root.count >= 0: Text { text: root.count; font-size: 12px; font-weight: 600;
            color: root.active ? #ffffffcc : BookTheme.ink-dim; vertical-alignment: center; }
    }
    states [ hover when ta.has-hover && !active: { background: BookTheme.track; } ]
    animate background { duration: 100ms; }
}

// Left cover artwork. When there's no cover image, draws a generated cover
// card from the title/author on a hash-picked color (for PDFs and any coverless
// book). Also shows the format badge + optional reading-progress bar.
component Cover inherits Rectangle {
    in property <image> source;
    in property <string> format;
    in property <string> title;
    in property <string> author;
    in property <color> hue: #6c4df6;
    in property <float> percent: -1;
    // Scale text with the card so it reads in both the tiny grid tile and the
    // larger hero — `big` splits the two size regimes.
    property <bool> big: self.width > 100px;
    border-radius: 8px;
    clip: true;
    background: root.source.width <= 0
        ? @linear-gradient(155deg, root.hue, root.hue.darker(0.35))
        : BookTheme.tint-violet;

    // ── Generated cover (no image) ───────────────────────────────────────────
    if root.source.width <= 0: Rectangle {
        // Inner hairline frame.
        Rectangle {
            x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
            border-radius: 6px; border-width: 1.5px; border-color: #ffffff55; background: transparent;
        }
        VerticalLayout {
            padding: root.big ? 16px : 8px; spacing: 0px;
            // Format badge.
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    height: root.big ? 20px : 15px; border-radius: 5px; background: #ffffff33;
                    HorizontalLayout { padding-left: 6px; padding-right: 6px;
                        Text { text: root.format; color: #ffffff; font-size: root.big ? 10px : 8px;
                            font-weight: 700; vertical-alignment: center; } }
                }
            }
            // Title (centered) + divider + author.
            Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center; spacing: root.big ? 12px : 6px;
                    Text {
                        text: root.title; color: #ffffff; font-family: "serif";
                        font-size: root.big ? 20px : 11px; font-weight: 700;
                        horizontal-alignment: center; wrap: word-wrap; overflow: elide;
                    }
                    HorizontalLayout { alignment: center;
                        Rectangle { width: root.big ? 46px : 24px; height: 1px; background: #ffffff77; } }
                    Text {
                        text: root.author; color: #ffffffdd; font-family: "serif";
                        font-size: root.big ? 14px : 9px; font-italic: true;
                        horizontal-alignment: center; wrap: word-wrap; overflow: elide;
                    }
                }
            }
        }
    }

    // ── Real cover image ─────────────────────────────────────────────────────
    Image { source: root.source; image-fit: cover; width: 100%; height: 100%; }

    // Reading progress bar along the bottom edge.
    if root.percent > 0: Rectangle {
        x: 0; y: parent.height - 4px; width: 100%; height: 4px; background: #00000030;
        Rectangle { x: 0; width: parent.width * root.percent / 100; height: 4px;
            background: BookTheme.accent; }
    }
}

// ── stat card ─────────────────────────────────────────────────────────────────
component StatCard inherits Card {
    in property <string> label;
    in property <string> value;
    in property <color> tint;
    in property <color> accent: BookTheme.accent;
    in property <image> icon;
    callback clicked();
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding: 16px; spacing: 14px; alignment: start;
        Rectangle {
            width: 46px; height: 46px; border-radius: 13px; background: root.tint;
            AppIcon { source: root.icon; tint: root.accent; width: 22px; height: 22px; }
        }
        VerticalLayout { alignment: center; spacing: 2px;
            Text { text: root.value; color: BookTheme.ink; font-size: 24px; font-weight: 800; }
            Text { text: root.label; color: BookTheme.ink-dim; font-size: 12px; font-weight: 500; }
        }
    }
    states [ hover when ta.has-hover: { background: #fbfbfd; } ]
}

// Five clickable stars for the local rating (click star N → rating N).
component Stars inherits HorizontalLayout {
    in property <float> rating;
    callback rate(float);
    spacing: 2px;
    for i in [1, 2, 3, 4, 5]: TouchArea {
        width: 15px; height: 15px;
        mouse-cursor: pointer;
        // Clicking the current top star clears the rating.
        clicked => { root.rate(i == root.rating ? 0 : i); }
        AppIcon {
            source: i <= root.rating ? Icons.star-filled : Icons.star;
            tint: i <= root.rating ? #f5a623 : BookTheme.ink-dim.with-alpha(0.55);
            width: 14px; height: 14px;
        }
    }
}

// ── book grid tile (horizontal card: cover-left + details-right) ───────────────
component GridTile inherits Rectangle {
    in property <BookTile> tile;
    callback open();
    callback favorite();
    callback menu();
    callback rate(float);
    callback open-author();
    border-radius: 14px;
    background: BookTheme.card;
    border-width: 1px;
    border-color: ta.has-hover ? BookTheme.accent.with-alpha(0.35) : BookTheme.hairline;
    drop-shadow-blur: 2px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: BookTheme.shadow;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
    HorizontalLayout {
        padding: 14px; spacing: 14px;
        // Cover.
        Rectangle {
            width: 74px;
            Cover { width: 100%; height: 106px; source: tile.cover; percent: tile.percent;
                format: tile.format; title: tile.title; author: tile.author; hue: tile.hue; }
        }
        // Details column.
        VerticalLayout {
            alignment: start; spacing: 4px; horizontal-stretch: 1;
            // Title (leave room for the ⋮ button on its right).
            HorizontalLayout {
                Text { text: tile.title; color: BookTheme.ink; font-size: 14px; font-weight: 700;
                    wrap: word-wrap; overflow: elide; horizontal-stretch: 1; }
                Rectangle { width: 26px; }
            }
            // Author — click opens the author page.
            Rectangle {
                height: 16px;
                Text { text: tile.author; width: 100%; color: autht.has-hover ? BookTheme.accent : BookTheme.ink-dim;
                    font-size: 12px; font-weight: 500; overflow: elide; vertical-alignment: center; }
                autht := TouchArea { mouse-cursor: pointer; clicked => { root.open-author(); } }
            }
            // Format badge + date.
            HorizontalLayout {
                alignment: start; spacing: 8px;
                Rectangle {
                    height: 18px; border-radius: 6px; background: BookTheme.pill-bg;
                    HorizontalLayout { padding-left: 7px; padding-right: 7px;
                        Text { text: tile.format; color: BookTheme.ink-dim; font-size: 9px;
                            font-weight: 700; vertical-alignment: center; } }
                }
                if tile.date != "": HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout { alignment: center;
                        AppIcon { source: Icons.calendar; tint: BookTheme.ink-dim; width: 11px; height: 11px; } }
                    Text { text: tile.date; color: BookTheme.ink-dim; font-size: 10px; vertical-alignment: center; }
                }
            }
            // Local rating (click a star to set).
            HorizontalLayout {
                alignment: start; spacing: 6px;
                Stars { rating: tile.rating; rate(v) => { root.rate(v); } }
                if tile.rating > 0: Text { text: tile.rating; color: BookTheme.ink-dim;
                    font-size: 11px; font-weight: 600; vertical-alignment: center; }
            }
        }
    }
    // Overflow menu (top-right).
    menu-ta := TouchArea {
        x: parent.width - 34px; y: 10px; width: 26px; height: 26px;
        mouse-cursor: pointer; clicked => { root.menu(); }
        AppIcon { source: Icons.ellipsis; tint: BookTheme.ink-dim; width: 16px; height: 16px; }
    }
    // Bookmark / favorite (bottom-right).
    fav-ta := TouchArea {
        x: parent.width - 34px; y: parent.height - 34px; width: 26px; height: 26px;
        mouse-cursor: pointer; clicked => { root.favorite(); }
        AppIcon { source: Icons.bookmark;
            tint: tile.favorite ? BookTheme.accent : BookTheme.ink-dim; width: 16px; height: 16px; }
    }
}

// A titled rail block (Quick filters / File types / Genres).
component RailBlock inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    Text { text: root.title; color: BookTheme.ink-dim; font-size: 11px; font-weight: 700;
        letter-spacing: 0.6px; }
    @children
}

// One rail list row: leading icon · label · trailing count. Used for quick
// filters and file types (matches the design's right-rail list style).
component RailRow inherits Rectangle {
    in property <image> icon;
    in property <color> icon-tint: BookTheme.accent;
    in property <string> label;
    in property <int> count: -1;
    in property <bool> active: false;
    callback clicked();
    height: 36px;
    border-radius: 10px;
    background: root.active ? BookTheme.tint-violet : (ta.has-hover ? BookTheme.pill-bg : transparent);
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 12px; spacing: 10px;
        VerticalLayout { alignment: center;
            AppIcon { source: root.icon; tint: root.active ? BookTheme.accent : root.icon-tint;
                width: 16px; height: 16px; } }
        Text { text: root.label; color: root.active ? BookTheme.accent : BookTheme.ink;
            font-size: 13px; font-weight: root.active ? 700 : 500; vertical-alignment: center;
            horizontal-stretch: 1; overflow: elide; }
        if root.count >= 0: Text { text: root.count; color: BookTheme.ink-dim; font-size: 12px;
            font-weight: 600; vertical-alignment: center; }
    }
    animate background { duration: 100ms; }
}

// A colored genre chip with a trailing count (rail Genres section).
component GenreChip inherits Rectangle {
    in property <string> label;
    in property <int> count: -1;
    in property <color> hue: BookTheme.accent;
    in property <bool> active: false;
    callback clicked();
    height: 30px;
    border-radius: 15px;
    background: root.active ? root.hue.with-alpha(0.9) : root.hue.with-alpha(0.12);
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 8px; alignment: start;
        Text { text: root.label; color: root.active ? #ffffff : root.hue; font-size: 12px;
            font-weight: 600; vertical-alignment: center; overflow: elide; }
        if root.count >= 0: Text { text: root.count; color: root.active ? #ffffffcc : root.hue.with-alpha(0.7);
            font-size: 11px; font-weight: 600; vertical-alignment: center; }
    }
}

// ── page ──────────────────────────────────────────────────────────────────────
export component BooksPage inherits Rectangle {
    // data in
    in property <BooksHero> hero;
    in property <[BookTile]> tiles: [];
    in property <[BookStat]> stats: [];
    in property <[BookChip]> file-types: [];
    in property <[BookChip]> genres: [];
    in property <[BookChip]> quick-filters: [];
    in property <[string]> sort-options: ["Recently Added", "Recently Read", "Title", "Author", "Rating"];
    in property <[string]> file-type-options: ["All"];
    // Rotating hue palette for the genre chips.
    property <[color]> genre-hues: [#6c4df6, #e0518f, #2fbf71, #f5a623, #3a86ff, #b5179e];
    in property <int> book-count: 0;
    in property <int> page: 1;
    in property <int> page-count: 1;
    in property <string> active-file-type: "";
    in property <string> active-quick: "all";
    in property <string> active-genre: "";
    in property <string> active-author: "";
    in property <string> view-mode: "grid";
    in-out property <string> search-text: "";
    // True when any filter/search narrows the grid — drives the empty-state copy.
    property <bool> filtered: root.active-file-type != "" || root.active-genre != ""
        || root.active-quick != "all" || root.search-text != "" || root.active-author != "";

    // actions out
    callback search(string);
    callback resume();
    callback hero-details();
    callback add-books();
    callback open-details(int);
    callback toggle-favorite(int);
    callback card-menu-action(int, string);
    callback set-file-type(string);
    callback set-sort(string);
    callback set-view-mode(string);
    callback quick-filter(string);
    callback genre-filter(string);
    callback stat-card(string);
    callback set-page(int);
    callback set-rating(int, float);
    callback open-author(string);

    background: BookTheme.canvas;

    VerticalLayout {
        padding: 24px; spacing: 20px;

        // ── header row ──────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 16px;
            // badge + title
            VerticalLayout { alignment: center; horizontal-stretch: 0;
                Rectangle { width: 40px; height: 40px; border-radius: 12px; background: BookTheme.tint-violet;
                    AppIcon { source: Icons.book-open; tint: BookTheme.accent; width: 22px; height: 22px; } } }
            VerticalLayout { alignment: center; horizontal-stretch: 0;
                Text { text: "My Library"; color: BookTheme.ink; font-size: 26px; font-weight: 800;
                    vertical-alignment: center; } }
            // search pill
            Rectangle {
                horizontal-stretch: 1; max-width: 460px; height: 44px; border-radius: 22px;
                background: BookTheme.pill-bg;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; spacing: 10px; alignment: start;
                    VerticalLayout { alignment: center;
                        AppIcon { source: Icons.search; tint: BookTheme.ink-dim; width: 18px; height: 18px; } }
                    Rectangle {
                        horizontal-stretch: 1;
                        // Placeholder sits behind; input is on top in z-order.
                        if root.search-text == "": Text { text: "Search by title, author, genre";
                            x: 0; color: BookTheme.ink-dim; font-size: 14px;
                            vertical-alignment: center; horizontal-alignment: left; }
                        ti := TextInput {
                            width: 100%; height: 100%;
                            vertical-alignment: center;
                            color: BookTheme.ink; font-size: 14px; single-line: true;
                            text <=> root.search-text;
                            edited => { root.search(self.text); }
                            accepted => { root.search(self.text); }
                        }
                    }
                    VerticalLayout { alignment: center;
                        AppIcon { source: Icons.mic; tint: BookTheme.ink-dim; width: 18px; height: 18px; } }
                }
            }
            PillButton { label: "Add books"; icon: Icons.plus; filled: true;
                clicked => { root.add-books(); } }
            // count pill
            Rectangle { height: 40px; border-radius: 20px; background: BookTheme.card;
                border-width: 1.5px; border-color: BookTheme.hairline;
                HorizontalLayout { padding-left: 16px; padding-right: 16px;
                    Text { text: root.book-count + " books"; color: BookTheme.ink-dim;
                        font-size: 13px; font-weight: 600; vertical-alignment: center; } } }
        }

        // ── hero row ────────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 20px; height: 210px;
            // continue-reading card
            Card {
                horizontal-stretch: 1;
                if root.hero.present: HorizontalLayout {
                    padding: 16px; spacing: 18px;
                    Cover { width: 130px; source: root.hero.cover;
                        title: root.hero.title; author: root.hero.author; hue: root.hero.hue; }
                    VerticalLayout {
                        alignment: center; spacing: 6px;
                        Text { text: "CONTINUE READING"; color: BookTheme.accent; font-size: 11px;
                            font-weight: 700; letter-spacing: 1px; }
                        Text { text: root.hero.title; color: BookTheme.ink; font-size: 24px;
                            font-weight: 800; overflow: elide; }
                        Text { text: root.hero.author; color: BookTheme.ink-dim; font-size: 14px;
                            font-weight: 500; overflow: elide; }
                        // progress
                        Rectangle { height: 4px; border-radius: 2px; background: BookTheme.track;
                            Rectangle { x: 0; width: parent.width * root.hero.percent / 100; height: 4px;
                                border-radius: 2px; background: BookTheme.accent; } }
                        Text { color: BookTheme.ink-dim; font-size: 12px;
                            text: "Page " + root.hero.page + " of " + root.hero.total + " • "
                                + Math.round(root.hero.percent) + "%   " + root.hero.time-left; }
                        HorizontalLayout {
                            spacing: 10px; alignment: start; padding-top: 6px;
                            PillButton { label: "Resume"; icon: Icons.book-open; filled: true;
                                clicked => { root.resume(); } }
                            PillButton { label: "Details";
                                clicked => { root.hero-details(); } }
                        }
                    }
                }
                if !root.hero.present: VerticalLayout {
                    alignment: center; spacing: 6px;
                    HorizontalLayout { alignment: center;
                        AppIcon { source: Icons.book-open; tint: BookTheme.ink-dim; width: 40px; height: 40px; } }
                    Text { text: "Nothing in progress"; color: BookTheme.ink; font-size: 16px;
                        font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Open a book to start reading"; color: BookTheme.ink-dim;
                        font-size: 13px; horizontal-alignment: center; }
                }
            }
            // stats 2×2 (fixed identities; values flow in via `stats` model).
            Rectangle {
                width: 520px;
                VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout { spacing: 12px;
                        StatCard { horizontal-stretch: 1; label: "Total Books";
                            value: root.stats.length > 0 ? stats[0].value : "0";
                            tint: BookTheme.tint-violet; accent: #6c4df6; icon: Icons.book-open;
                            clicked => { root.stat-card("total"); } }
                        StatCard { horizontal-stretch: 1; label: "Authors";
                            value: root.stats.length > 1 ? stats[1].value : "0";
                            tint: BookTheme.tint-pink; accent: #e0518f; icon: Icons.user;
                            clicked => { root.stat-card("authors"); } }
                    }
                    HorizontalLayout { spacing: 12px;
                        StatCard { horizontal-stretch: 1; label: "In Progress";
                            value: root.stats.length > 2 ? stats[2].value : "0";
                            tint: BookTheme.tint-orange; accent: #f5a623; icon: Icons.circle;
                            clicked => { root.stat-card("reading"); } }
                        StatCard { horizontal-stretch: 1; label: "Completed";
                            value: root.stats.length > 3 ? stats[3].value : "0";
                            tint: BookTheme.tint-green; accent: #2fbf71; icon: Icons.check;
                            clicked => { root.stat-card("finished"); } }
                    }
                }
            }
        }

        // ── main row ────────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 20px; vertical-stretch: 1;
            // left: toolbar + grid + pagination
            VerticalLayout {
                horizontal-stretch: 1; spacing: 16px;
                // toolbar card
                Card {
                    height: 60px;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px; spacing: 8px;
                        // Status chips.
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            FilterChip { label: "All"; active: root.active-quick == "all" || root.active-quick == "";
                                clicked => { root.quick-filter("all"); } } }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            FilterChip { label: "Reading"; active: root.active-quick == "reading";
                                clicked => { root.quick-filter("reading"); } } }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            FilterChip { label: "Unread"; active: root.active-quick == "unread";
                                clicked => { root.quick-filter("unread"); } } }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            FilterChip { label: "Favorites"; active: root.active-quick == "favorites";
                                clicked => { root.quick-filter("favorites"); } } }
                        Rectangle { horizontal-stretch: 1; }
                        // File type dropdown.
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Text { text: "File type"; color: BookTheme.ink-dim; font-size: 12px; vertical-alignment: center; } }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            ComboBox {
                                model: root.file-type-options;
                                selected(v) => { root.set-file-type(v); }
                            } }
                        // Sort dropdown.
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Text { text: "Sort by"; color: BookTheme.ink-dim; font-size: 12px; vertical-alignment: center; } }
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            ComboBox {
                                model: root.sort-options;
                                selected(v) => { root.set-sort(v); }
                            } }
                        // View toggle.
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            HorizontalLayout { spacing: 2px;
                                grid-btn := Rectangle { width: 34px; height: 34px; border-radius: 8px;
                                    background: root.view-mode == "grid" ? BookTheme.tint-violet : transparent;
                                    AppIcon { source: Icons.layout-grid;
                                        tint: root.view-mode == "grid" ? BookTheme.accent : BookTheme.ink-dim;
                                        width: 18px; height: 18px; }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.set-view-mode("grid"); } } }
                                list-btn := Rectangle { width: 34px; height: 34px; border-radius: 8px;
                                    background: root.view-mode == "list" ? BookTheme.tint-violet : transparent;
                                    AppIcon { source: Icons.list-music;
                                        tint: root.view-mode == "list" ? BookTheme.accent : BookTheme.ink-dim;
                                        width: 18px; height: 18px; }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.set-view-mode("list"); } } }
                            } }
                        // Filters button.
                        VerticalLayout { alignment: center; horizontal-stretch: 0;
                            Rectangle {
                                height: 36px; border-radius: 18px; background: fta.has-hover ? BookTheme.pill-bg : BookTheme.card;
                                border-width: 1.5px; border-color: BookTheme.accent.with-alpha(0.35);
                                HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 6px; alignment: center;
                                    VerticalLayout { alignment: center;
                                        AppIcon { source: Icons.sliders; tint: BookTheme.accent; width: 15px; height: 15px; } }
                                    Text { text: "Filters"; color: BookTheme.accent; font-size: 13px; font-weight: 700; vertical-alignment: center; } }
                                fta := TouchArea { mouse-cursor: pointer; }
                            } }
                    }
                }
                // Author page banner (shown when filtered to one author).
                if root.active-author != "": HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                        Rectangle { width: 40px; height: 40px; border-radius: 20px; background: BookTheme.tint-pink;
                            AppIcon { source: Icons.user; tint: #e0518f; width: 20px; height: 20px; } } }
                    VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 1px;
                        Text { text: "Books by " + root.active-author; color: BookTheme.ink;
                            font-size: 20px; font-weight: 800; overflow: elide; }
                        Text { text: root.book-count + (root.book-count == 1 ? " book" : " books");
                            color: BookTheme.ink-dim; font-size: 12px; } }
                    VerticalLayout { alignment: center; horizontal-stretch: 0;
                        Rectangle {
                            height: 38px; border-radius: 19px; background: cba.has-hover ? BookTheme.pill-bg : BookTheme.card;
                            border-width: 1.5px; border-color: BookTheme.hairline;
                            HorizontalLayout { padding-left: 14px; padding-right: 16px; spacing: 6px; alignment: center;
                                VerticalLayout { alignment: center;
                                    AppIcon { source: Icons.x; tint: BookTheme.ink-dim; width: 14px; height: 14px; } }
                                Text { text: "All books"; color: BookTheme.ink; font-size: 13px;
                                    font-weight: 600; vertical-alignment: center; } }
                            cba := TouchArea { mouse-cursor: pointer; clicked => { root.open-author(""); } }
                        } }
                }
                // grid (scrollable)
                sv := ScrollView {
                    vertical-stretch: 1;
                    // Reset scroll to top when the page changes (ScrollView keeps a
                    // stale viewport-y otherwise).
                    property <int> watch-page: root.page;
                    changed watch-page => { sv.viewport-y = 0; }
                    grid := Rectangle {
                        property <length> gap: 14px;
                        property <length> cell-w: 316px;
                        property <int> cols: Math.max(1, Math.floor((self.width + gap) / (cell-w + gap)));
                        property <length> cell-h: 134px;
                        width: sv.visible-width;
                        height: Math.ceil(tiles.length / cols) * (cell-h + gap);
                        for tile[idx] in root.tiles: GridTile {
                            x: Math.mod(idx, grid.cols) * (grid.cell-w + grid.gap);
                            y: Math.floor(idx / grid.cols) * (grid.cell-h + grid.gap);
                            width: grid.cell-w; height: grid.cell-h;
                            tile: tile;
                            open => { root.open-details(tile.id); }
                            favorite => { root.toggle-favorite(tile.id); }
                            menu => { root.card-menu-action(tile.id, "menu"); }
                            rate(v) => { root.set-rating(tile.id, v); }
                            open-author => { root.open-author(tile.author); }
                        }
                        if tiles.length == 0: VerticalLayout {
                            alignment: center; spacing: 8px;
                            HorizontalLayout { alignment: center;
                                AppIcon { source: root.filtered ? Icons.search : Icons.book-open;
                                    tint: BookTheme.ink-dim; width: 48px; height: 48px; } }
                            Text {
                                text: root.filtered ? "No books match your filters" : "No books here";
                                color: BookTheme.ink; font-size: 16px;
                                font-weight: 700; horizontal-alignment: center; }
                            Text {
                                text: root.filtered ? "Try clearing a filter or search"
                                    : "Add a folder to start your library";
                                color: BookTheme.ink-dim; font-size: 13px; horizontal-alignment: center; }
                        }
                    }
                }
                // pagination
                if root.page-count > 1: HorizontalLayout {
                    alignment: center; spacing: 12px;
                    prev := Rectangle { width: 36px; height: 36px; border-radius: 18px;
                        background: root.page > 1 ? BookTheme.card : BookTheme.pill-bg;
                        border-width: 1px; border-color: BookTheme.hairline;
                        AppIcon { source: Icons.chevron-left; tint: BookTheme.ink; width: 18px; height: 18px; }
                        TouchArea { mouse-cursor: pointer;
                            clicked => { if (root.page > 1) { root.set-page(root.page - 1); } } } }
                    Text { text: root.page + " / " + root.page-count; color: BookTheme.ink;
                        font-size: 14px; font-weight: 600; vertical-alignment: center; }
                    next := Rectangle { width: 36px; height: 36px; border-radius: 18px;
                        background: root.page < root.page-count ? BookTheme.card : BookTheme.pill-bg;
                        border-width: 1px; border-color: BookTheme.hairline;
                        AppIcon { source: Icons.chevron-right; tint: BookTheme.ink; width: 18px; height: 18px; }
                        TouchArea { mouse-cursor: pointer;
                            clicked => { if (root.page < root.page-count) { root.set-page(root.page + 1); } } } }
                }
            }
            // right rail
            Card {
                width: 300px;
                ScrollView {
                    VerticalLayout {
                        padding: 18px; spacing: 20px; alignment: start;
                        RailBlock { title: "QUICK FILTERS";
                            for q[i] in root.quick-filters: RailRow {
                                label: q.label; count: q.count; active: root.active-quick == q.key;
                                icon: q.key == "reading" ? Icons.book-open
                                    : q.key == "finished" ? Icons.check
                                    : q.key == "unread" ? Icons.circle
                                    : q.key == "favorites" ? Icons.star
                                    : Icons.layout-grid;
                                icon-tint: q.key == "reading" ? #3a86ff
                                    : q.key == "finished" ? #2fbf71
                                    : q.key == "favorites" ? #f5a623
                                    : BookTheme.accent;
                                clicked => { root.quick-filter(q.key); } } }
                        RailBlock { title: "FILE TYPES";
                            for ft[i] in root.file-types: RailRow {
                                label: ft.label; count: ft.count; active: root.active-file-type == ft.key;
                                icon: Icons.book-open; icon-tint: BookTheme.accent;
                                clicked => { root.set-file-type(ft.key); } } }
                        // Genres — colored chips + "View all".
                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                Text { text: "GENRES"; color: BookTheme.ink-dim; font-size: 11px;
                                    font-weight: 700; letter-spacing: 0.6px; horizontal-stretch: 1;
                                    vertical-alignment: center; }
                                Text { text: "View all"; color: BookTheme.accent; font-size: 11px;
                                    font-weight: 700; vertical-alignment: center; }
                            }
                            for g[i] in root.genres: GenreChip {
                                label: g.label; count: g.count; active: root.active-genre == g.key;
                                hue: root.genre-hues[Math.mod(i, root.genre-hues.length)];
                                clicked => { root.genre-filter(g.key); } }
                        }
                        Rectangle { height: 4px; }
                    }
                }
            }
        }
    }
}
