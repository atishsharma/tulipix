// Books section — Google Play Books language: warm paper canvas, covers on
// shelves with title + author + a reading-progress bar. View tabs filter the
// library (All / Reading / Unread / Comics). Click a cover → native reader.
import { ScrollView, LineEdit } from "std-widgets.slint";
import { HdrChip, HdrSearch, CountPill } from "section_header.slint";
import { AppIcon, Icons } from "icons.slint";
import { Theme } from "tokens.slint";

export struct TocEntryRow { idx: int, title: string, page: int }
export struct BookmarkRow { id: int, page: int, note: string, color: string }
export struct SeriesRow { id: int, name: string, book-count: int, cover: image }
export struct AuthorRow { name: string, book-count: int }
export struct CollectionRow { id: int, name: string, book-count: int, cover: image }

export struct BookTile {
    thumb: image,
    title: string,
    author: string,
    index: int,
    progress: float,   // 0..1 read
    finished: bool,
    comic: bool,
    format: string,    // epub / cbz / cbr / pdf
    has-cover: bool,   // true → show thumb; false → generated fallback cover
    tint: color,       // paper tint for the generated cover (hash(title))
}

// Continue-reading hero card row. `index` maps into the Rust hero list.
export struct HeroRow {
    thumb: image, has-cover: bool, tint: color,
    title: string, author: string,
    frac: float, page-label: string, left-label: string, index: int,
}

// Book detail sheet payload. `index` is the tile index (book_paths) for actions.
export struct BookDetail {
    title: string, author: string, eyebrow: string, desc: string,
    format: string, size: string, pages: string, shelf: string,
    frac: float, page-label: string, left-label: string,
    has-progress: bool, finished: bool,
    thumb: image, has-cover: bool, tint: color, index: int,
}

// One tile in the series drill-in strip. `index` maps into the Rust strip list.
export struct SeriesStripRow {
    thumb: image, has-cover: bool, tint: color,
    title: string, status: string, num: int,
    next-up: bool, finished: bool, frac: float, index: int,
}

// Generated fallback cover — the signature look when a book has no art.
// Paper-tinted panel, 1px inset frame, Georgia title (top), faint author (foot).
// Reused across the grid, hero, series strip and detail sheet.
component GenCover inherits Rectangle {
    in property <string> title;
    in property <string> author;
    in property <color> tint;
    in property <bool> dark: false;
    property <color> base: dark ? root.tint.mix(#14130f, 0.24) : root.tint;
    property <color> ink: dark ? #d8cfb8 : #3a3428;
    background: base;
    clip: true;
    Rectangle {
        x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
        border-width: 1px; border-radius: 3px;
        border-color: root.dark ? #ffffff1c : #00000024;
    }
    VerticalLayout {
        padding-left: 12px; padding-right: 12px; padding-top: 14px; padding-bottom: 12px;
        Text {
            text: root.title; color: root.ink; font-family: "Georgia";
            font-weight: 700; font-size: 14px; wrap: word-wrap; overflow: elide;
        }
        Rectangle { vertical-stretch: 1; }
        Text {
            text: root.author; color: root.ink; font-size: 9px;
            letter-spacing: 1.1px; opacity: 0.62; overflow: elide;
        }
    }
}

export component BooksPage inherits Rectangle {
    in property <int> item-count: 0;
    in property <[BookTile]> tiles: [];
    in property <[SeriesRow]> series: [];
    in property <[AuthorRow]> authors: [];
    in property <[CollectionRow]> collections: [];
    // Structured stats for the chip-card row (np.p5.books.stats).
    in property <int> goal-done: 0;
    in property <int> goal-total: 0;
    in property <string> stat-time: "";      // "14h 20m"
    in property <int> streak-days: 0;
    in property <int> in-progress-count: 0;
    // Transient export confirmation ("Notes exported → ~/Documents/…").
    in property <string> export-status: "";
    in-out property <string> view: "all";
    in-out property <string> query: "";
    in-out property <string> sort-mode: "title";   // title | author | recent
    in-out property <string> sort-dir: "asc";       // asc | desc
    // Drill-in state: shelf (collection) the tile grid is filtered to, and the
    // tile index a "＋ shelf" popup is open for (-1 = closed).
    in-out property <int> sel-collection: -1;
    in-out property <int> shelf-pick-idx: -1;
    callback add-folder();
    callback open-book(int);
    callback set-view(string);
    callback search(string);
    callback set-sort(string);
    callback series-open(int);
    callback collection-open(int);
    callback add-to-collection(int, string); // tile index, shelf name
    callback fetch-meta(int);
    callback export-notes(int);
    callback goal-adjust(int);   // ± yearly reading goal (np.p5.books.stats)
    // Continue-reading hero slider. resume/hero-detail take a hero-list index.
    in property <[HeroRow]> hero-rows: [];
    callback resume(int);
    callback hero-detail(int);   // hero-list index → Rust resolves to a grid index
    // Book detail sheet. detail.index is a grid (tile) index, so the sheet reuses
    // open-book / fetch-meta / shelf-pick directly.
    in property <BookDetail> detail;
    in-out property <int> detail-idx: -1;   // -1 closed
    callback open-detail(int);
    callback mark-finished(int);
    callback remove-book(int);
    // Series drill-in strip.
    in property <[SeriesStripRow]> series-strip: [];
    in property <string> series-strip-title: "";
    in property <string> series-strip-sub: "";
    in property <int> series-strip-done: 0;
    in property <int> series-strip-total: 0;
    callback series-strip-open(int);

    // Books accent (Play-Books blue) — shared so header chips stay on-theme.
    property <color> accent: #1a73e8;
    // Books follows the app light/dark theme. Light keeps the warm-paper
    // identity (unchanged); dark uses a warm-neutral dark surface ramp.
    property <bool> dk: Theme.dark;
    property <color> bk-canvas: dk ? #14130f : #f5f1e8;  // page background
    property <color> bk-bar:    dk ? #1c1a15 : #fbf9f3;  // header rows / cards / popup
    property <color> bk-hair:   dk ? #33302a : #e7e0d0;  // hairline borders / cancel btn
    property <color> bk-ink:    dk ? #f0ece2 : #20201c;  // primary text
    property <color> bk-ink2:   dk ? #b0a890 : #8a8369;  // secondary text
    property <color> bk-ink3:   dk ? #9a9382 : #6b6456;  // tertiary text
    property <color> bk-faint:  dk ? #7d7665 : #b0a88e;  // faint label
    property <color> bk-cover:  dk ? #2a2720 : #d8cfbb;  // cover placeholder
    property <color> bk-hover:  dk ? #2c2922 : #efe8d8;  // row / card hover
    property <color> bk-chiph:  dk ? #2c2922 : #e0d9c6;  // ± goal hover
    property <color> bk-empty:  dk ? #2a2620 : #e7dcc4;  // empty-state circle
    // Views that show the book tile grid (incl. a drilled-in shelf "col:N").
    property <bool> grid-view: view != "series" && view != "authors" && view != "collections";

    property <length> col-gap: 26px;
    property <length> row-h: 296px;
    property <length> cover-h: 210px;

    background: bk-canvas;

    VerticalLayout {
        spacing: 0px;

        // Row 1 — title · search · add · count pill (Photos two-tier pattern).
        Rectangle {
            height: 72px; horizontal-stretch: 1; background: bk-bar;
            border-width: 1px; border-color: bk-hair;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; spacing: 14px;
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Rectangle { width: 34px; height: 34px; border-radius: 10px;
                        background: root.accent.with-alpha(0.16);
                        AppIcon { source: Icons.book-open; tint: root.accent; width: 18px; height: 18px;
                            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; } } }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Text { text: "My library"; color: bk-ink; font-size: 22px; font-weight: 700; } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    HdrSearch { width: 420px; dark: Theme.dark; placeholder: "Search your books";
                        mic-target: "books";
                        query <=> root.query; edited(q) => { root.search(q); } } }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    HdrChip { label: "+ Add books"; accent: root.accent; dark: Theme.dark; active: true; height: 44px; min-width: 140px;
                        clicked => { root.add-folder(); } } }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    CountPill { accent: root.accent; seg1: "" + item-count + " books"; } }
            }
        }

        // Hero — continue reading (np.p5.books). Cycles the most-recent
        // unfinished books; shown only on the All tab.
        if view == "all" && root.hero-rows.length > 0: heroC := Rectangle {
            height: 248px; horizontal-stretch: 1; background: bk-bar; clip: true;
            border-width: 1px; border-color: bk-hair;
            property <int> hidx: 0;
            property <HeroRow> h: root.hero-rows[min(self.hidx, root.hero-rows.length - 1)];
            HorizontalLayout {
                padding-left: 84px; padding-right: 84px; spacing: 36px; alignment: center;
                Rectangle {
                    width: 150px; height: 220px; border-radius: 8px; clip: true; horizontal-stretch: 0;
                    drop-shadow-blur: 24px; drop-shadow-color: #00000055; drop-shadow-offset-y: 10px;
                    if heroC.h.has-cover: Image { source: heroC.h.thumb; image-fit: cover; width: parent.width; height: parent.height; }
                    if !heroC.h.has-cover: GenCover { title: heroC.h.title; author: heroC.h.author; tint: heroC.h.tint; dark: dk; width: parent.width; height: parent.height; }
                }
                VerticalLayout {
                    alignment: center; spacing: 3px; horizontal-stretch: 1;
                    Text { text: "CONTINUE READING"; color: root.accent; font-size: 11px; font-weight: 700; letter-spacing: 1.4px; }
                    Text { text: heroC.h.title; color: bk-ink; font-family: "Georgia"; font-size: 30px; font-weight: 700; overflow: elide; }
                    Text { text: heroC.h.author; color: bk-ink2; font-size: 14px; overflow: elide; }
                    Rectangle { height: 10px; }
                    Rectangle { height: 6px; width: 420px; border-radius: 3px; background: bk-hair; horizontal-stretch: 0;
                        Rectangle { x: 0; y: 0; height: parent.height; width: parent.width * heroC.h.frac; border-radius: 3px; background: #f4b400; } }
                    HorizontalLayout { spacing: 8px; width: 420px;
                        Text { text: heroC.h.page-label; color: bk-ink3; font-size: 12px; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: heroC.h.left-label; color: bk-ink3; font-size: 12px; } }
                    Rectangle { height: 12px; }
                    HorizontalLayout { spacing: 10px; alignment: start;
                        Rectangle { width: 132px; height: 42px; border-radius: 21px; background: root.accent; horizontal-stretch: 0;
                            TouchArea { mouse-cursor: pointer; clicked => { root.resume(heroC.h.index); } }
                            Text { text: "▶ Resume"; color: #ffffff; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 104px; height: 42px; border-radius: 21px; background: transparent; border-width: 1px; border-color: bk-hair; horizontal-stretch: 0;
                            TouchArea { mouse-cursor: pointer; clicked => { root.hero-detail(heroC.h.index); } }
                            Text { text: "Details"; color: bk-ink; font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                    }
                }
            }
            if root.hero-rows.length > 1: Rectangle {
                x: 18px; y: (parent.height - 42px) / 2; width: 42px; height: 42px; border-radius: 21px;
                background: aprev.has-hover ? bk-hover : bk-canvas; border-width: 1px; border-color: bk-hair;
                aprev := TouchArea { mouse-cursor: pointer; clicked => { heroC.hidx = mod(heroC.hidx - 1 + root.hero-rows.length, root.hero-rows.length); } }
                Text { text: "‹"; color: bk-ink; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; } }
            if root.hero-rows.length > 1: Rectangle {
                x: parent.width - 60px; y: (parent.height - 42px) / 2; width: 42px; height: 42px; border-radius: 21px;
                background: anext.has-hover ? bk-hover : bk-canvas; border-width: 1px; border-color: bk-hair;
                anext := TouchArea { mouse-cursor: pointer; clicked => { heroC.hidx = mod(heroC.hidx + 1, root.hero-rows.length); } }
                Text { text: "›"; color: bk-ink; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; } }
        }

        // Row 2 — view tabs · sort chips.
        Rectangle {
            height: 54px; horizontal-stretch: 1; background: bk-bar;
            border-width: 1px; border-color: bk-hair;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; spacing: 8px; alignment: start;
                VerticalLayout { alignment: center; HdrChip { label: "All";       min-width: 90px;  accent: root.accent; dark: Theme.dark; active: view == "all";     clicked => { root.sel-collection = -1; root.view = "all";     root.set-view("all"); } } }
                VerticalLayout { alignment: center; HdrChip { label: "Reading";   min-width: 90px;  accent: root.accent; dark: Theme.dark; active: view == "reading"; clicked => { root.sel-collection = -1; root.view = "reading"; root.set-view("reading"); } } }
                VerticalLayout { alignment: center; HdrChip { label: "Unread";    min-width: 90px;  accent: root.accent; dark: Theme.dark; active: view == "unread";  clicked => { root.sel-collection = -1; root.view = "unread";  root.set-view("unread"); } } }
                VerticalLayout { alignment: center; HdrChip { label: "Comics";    min-width: 90px;  accent: root.accent; dark: Theme.dark; active: view == "comics";  clicked => { root.sel-collection = -1; root.view = "comics";  root.set-view("comics"); } } }
                VerticalLayout { alignment: center; HdrChip { icon: Icons.book-open; label: "Series"; min-width: 110px; accent: root.accent; dark: Theme.dark; active: view == "series";  clicked => { root.sel-collection = -1; root.view = "series";  root.set-view("series"); } } }
                VerticalLayout { alignment: center; HdrChip { icon: Icons.user; label: "Authors"; min-width: 110px; accent: root.accent; dark: Theme.dark; active: view == "authors"; clicked => { root.sel-collection = -1; root.view = "authors"; root.set-view("authors"); } } }
                VerticalLayout { alignment: center; HdrChip { icon: Icons.folder-open; label: "Shelves"; min-width: 110px; accent: root.accent; dark: Theme.dark; active: view == "collections" || root.sel-collection >= 0; clicked => { root.sel-collection = -1; root.view = "collections"; root.set-view("collections"); } } }
                if root.sel-collection >= 0: VerticalLayout { alignment: center; HdrChip { icon: Icons.arrow-left; label: "Back"; min-width: 90px; accent: root.accent; dark: Theme.dark; active: false; clicked => { root.sel-collection = -1; root.view = "collections"; root.set-view("collections"); } } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Text { text: "Sort"; color: bk-ink3; font-size: 12px; vertical-alignment: center; } }
                VerticalLayout { alignment: center; HdrChip {
                    label: "Title";
                    min-width: 92px; accent: root.accent; dark: Theme.dark; active: root.sort-mode == "title"; clicked => { root.set-sort("title"); } } }
                VerticalLayout { alignment: center; HdrChip {
                    label: "Author";
                    min-width: 100px; accent: root.accent; dark: Theme.dark; active: root.sort-mode == "author"; clicked => { root.set-sort("author"); } } }
                VerticalLayout { alignment: center; HdrChip {
                    label: "Recent";
                    min-width: 100px; accent: root.accent; dark: Theme.dark; active: root.sort-mode == "recent"; clicked => { root.set-sort("recent"); } } }
                // Sort direction — click to flip asc/desc on the active sort.
                VerticalLayout { alignment: center; horizontal-stretch: 0;
                    Rectangle { width: 28px; height: 28px; border-radius: 14px;
                        background: dirta.has-hover ? bk-hover : transparent;
                        dirta := TouchArea { mouse-cursor: pointer; clicked => { root.set-sort(root.sort-mode); } }
                        Text { text: root.sort-dir == "desc" ? "▼" : "▲"; color: root.accent; font-size: 11px;
                            horizontal-alignment: center; vertical-alignment: center; } } }
            }
        }

        // Stats chip-card row — goal ring, time read, streak, in progress
        // (np.p5.books.stats). ± nudges the yearly goal. Shown on the All tab.
        if view == "all" && root.goal-total > 0: Rectangle {
            height: 76px; horizontal-stretch: 1; background: bk-canvas;
            HorizontalLayout {
                padding-left: 28px; padding-right: 28px; padding-top: 14px; padding-bottom: 10px;
                spacing: 12px; alignment: start;
                // Goal card — ring + fraction + ± adjust.
                Rectangle {
                    horizontal-stretch: 0; border-radius: 14px; background: bk-bar;
                    border-width: 1px; border-color: bk-hair;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 14px; spacing: 10px; alignment: center;
                        ring := Rectangle {
                            width: 40px; height: 40px;
                            property <float> frac: root.goal-done / max(1, root.goal-total);
                            Path {
                                width: 40px; height: 40px; viewbox-width: 40; viewbox-height: 40;
                                stroke: bk-hair; stroke-width: 4px; fill: transparent;
                                MoveTo { x: 20; y: 4; }
                                ArcTo { x: 20; y: 36; radius-x: 16; radius-y: 16; large-arc: true; sweep: true; }
                                ArcTo { x: 20; y: 4;  radius-x: 16; radius-y: 16; large-arc: true; sweep: true; }
                            }
                            if ring.frac > 0.001: Path {
                                width: 40px; height: 40px; viewbox-width: 40; viewbox-height: 40;
                                stroke: root.accent; stroke-width: 4px; fill: transparent;
                                MoveTo { x: 20; y: 4; }
                                ArcTo {
                                    x: 20 + 16 * sin(ring.frac * 360deg);
                                    y: 20 - 16 * cos(ring.frac * 360deg);
                                    radius-x: 16; radius-y: 16;
                                    large-arc: ring.frac > 0.5; sweep: true;
                                }
                            }
                        }
                        VerticalLayout { alignment: center; spacing: 1px;
                            Text { text: root.goal-done + " / " + root.goal-total; color: bk-ink; font-size: 17px; font-weight: 700; }
                            Text { text: "2026 goal"; color: bk-ink3; font-size: 11px; } }
                        VerticalLayout { alignment: center; spacing: 3px;
                            Rectangle { width: 22px; height: 22px; border-radius: 11px;
                                background: gp2.has-hover ? bk-chiph : transparent;
                                border-width: 1px; border-color: bk-hair;
                                gp2 := TouchArea { mouse-cursor: pointer; clicked => { root.goal-adjust(1); } }
                                AppIcon { source: Icons.plus; tint: bk-ink2; width: 11px; height: 11px; } }
                            Rectangle { width: 22px; height: 22px; border-radius: 11px;
                                background: gm2.has-hover ? bk-chiph : transparent;
                                border-width: 1px; border-color: bk-hair;
                                gm2 := TouchArea { mouse-cursor: pointer; clicked => { root.goal-adjust(-1); } }
                                Text { text: "−"; color: bk-ink2; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; } } }
                    }
                }
                if root.stat-time != "": Rectangle {
                    horizontal-stretch: 0; border-radius: 14px; background: bk-bar; border-width: 1px; border-color: bk-hair;
                    HorizontalLayout { padding-left: 16px; padding-right: 16px; alignment: center;
                        VerticalLayout { alignment: center; spacing: 1px;
                            Text { text: root.stat-time; color: bk-ink; font-size: 17px; font-weight: 700; }
                            Text { text: "Time read"; color: bk-ink3; font-size: 11px; } } } }
                if root.streak-days > 0: Rectangle {
                    horizontal-stretch: 0; border-radius: 14px; background: bk-bar; border-width: 1px; border-color: bk-hair;
                    HorizontalLayout { padding-left: 16px; padding-right: 16px; alignment: center;
                        VerticalLayout { alignment: center; spacing: 1px;
                            Text { text: root.streak-days + (root.streak-days == 1 ? " day" : " days"); color: bk-ink; font-size: 17px; font-weight: 700; }
                            Text { text: "Streak"; color: bk-ink3; font-size: 11px; } } } }
                Rectangle {
                    horizontal-stretch: 0; border-radius: 14px; background: bk-bar; border-width: 1px; border-color: bk-hair;
                    HorizontalLayout { padding-left: 16px; padding-right: 16px; alignment: center;
                        VerticalLayout { alignment: center; spacing: 1px;
                            Text { text: root.in-progress-count + ""; color: bk-ink; font-size: 17px; font-weight: 700; }
                            Text { text: "In progress"; color: bk-ink3; font-size: 11px; } } } }
                Rectangle { horizontal-stretch: 1; }
                if root.export-status != "": VerticalLayout { alignment: center;
                    Text { text: root.export-status; color: root.accent; font-size: 12px; overflow: elide; } }
            }
        }

        // ── SERIES GRID ──────────────────────────────────────────────────────
        if view == "series": ScrollView {
            vertical-stretch: 1; horizontal-stretch: 1;
            VerticalLayout {
                padding-left: 32px; padding-right: 32px; padding-top: 22px; padding-bottom: 36px;
                Rectangle {
                    horizontal-stretch: 1;
                    property <int> cols: max(2, floor(self.width / 176px));
                    property <length> scell: (self.width - (cols - 1) * col-gap) / cols;
                    height: ceil(root.series.length / cols) * 230px;
                    for s[sidx] in root.series: Rectangle {
                        x: mod(sidx, parent.cols) * (parent.scell + col-gap);
                        y: floor(sidx / parent.cols) * 230px;
                        width: parent.scell; height: 230px;
                        VerticalLayout {
                            spacing: 6px;
                            // Cover
                            Rectangle {
                                width: 160px; height: 200px;
                                x: (parent.width - self.width) / 2;
                                border-radius: 10px; clip: true;
                                background: bk-cover;
                                drop-shadow-blur: ssta.has-hover ? 18px : 8px;
                                drop-shadow-color: #00000040;
                                drop-shadow-offset-y: 4px;
                                Image { source: s.cover; image-fit: cover; width: parent.width; height: parent.height; }
                                ssta := TouchArea { mouse-cursor: pointer; clicked => { root.series-open(s.id); } }
                            }
                            Text { text: s.name; color: bk-ink; font-size: 14px; font-weight: 700;
                                overflow: elide; horizontal-alignment: center; }
                            Text { text: s.book-count + " books"; color: bk-ink2; font-size: 11px;
                                horizontal-alignment: center; }
                        }
                    }
                }
            }
        }

        // ── AUTHORS GRID (np.p4.books.library — author pages) ───────────────
        if view == "authors": ScrollView {
            vertical-stretch: 1; horizontal-stretch: 1;
            VerticalLayout {
                padding-left: 32px; padding-right: 32px; padding-top: 22px; padding-bottom: 36px;
                Rectangle {
                    horizontal-stretch: 1;
                    property <int> cols: max(2, floor(self.width / 216px));
                    property <length> acell: (self.width - (cols - 1) * col-gap) / cols;
                    height: ceil(root.authors.length / cols) * 150px;
                    for a[aidx] in root.authors: Rectangle {
                        x: mod(aidx, parent.cols) * (parent.acell + col-gap);
                        y: floor(aidx / parent.cols) * 150px;
                        width: parent.acell; height: 136px;
                        border-radius: 14px;
                        background: asta.has-hover ? bk-hover : bk-bar;
                        border-width: 1px; border-color: bk-hair;
                        asta := TouchArea { mouse-cursor: pointer;
                            // Author page = the library filtered to this author.
                            clicked => { root.sel-collection = -1; root.view = "all"; root.query = a.name; root.search(a.name); root.set-view("all"); } }
                        VerticalLayout {
                            alignment: center; spacing: 8px;
                            HorizontalLayout { alignment: center;
                                Rectangle { width: 56px; height: 56px; border-radius: 28px; background: #1a73e8;
                                    AppIcon { source: Icons.user; tint: #ffffff; width: 24px; height: 24px; } } }
                            Text { text: a.name == "" ? "Unknown author" : a.name; color: bk-ink; font-size: 13px; font-weight: 700;
                                overflow: elide; horizontal-alignment: center; }
                            Text { text: a.book-count + (a.book-count == 1 ? " book" : " books"); color: bk-ink2; font-size: 11px;
                                horizontal-alignment: center; }
                        }
                    }
                }
            }
        }

        // ── SHELVES (collections) GRID ───────────────────────────────────────
        if view == "collections": ScrollView {
            vertical-stretch: 1; horizontal-stretch: 1;
            VerticalLayout {
                padding-left: 32px; padding-right: 32px; padding-top: 22px; padding-bottom: 36px;
                Rectangle {
                    horizontal-stretch: 1;
                    property <int> cols: max(2, floor(self.width / 176px));
                    property <length> ccell: (self.width - (cols - 1) * col-gap) / cols;
                    height: ceil(root.collections.length / cols) * 230px;
                    for c[cidx] in root.collections: Rectangle {
                        x: mod(cidx, parent.cols) * (parent.ccell + col-gap);
                        y: floor(cidx / parent.cols) * 230px;
                        width: parent.ccell; height: 230px;
                        VerticalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 160px; height: 200px;
                                x: (parent.width - self.width) / 2;
                                border-radius: 10px; clip: true;
                                background: bk-cover;
                                drop-shadow-blur: csta.has-hover ? 18px : 8px;
                                drop-shadow-color: #00000040;
                                drop-shadow-offset-y: 4px;
                                Image { source: c.cover; image-fit: cover; width: parent.width; height: parent.height; }
                                if c.book-count == 0: AppIcon { source: Icons.folder-open; width: 40px; height: 40px; }
                                csta := TouchArea { mouse-cursor: pointer;
                                    clicked => { root.sel-collection = c.id; root.collection-open(c.id); } }
                            }
                            Text { text: c.name; color: bk-ink; font-size: 14px; font-weight: 700;
                                overflow: elide; horizontal-alignment: center; }
                            Text { text: c.book-count + " books"; color: bk-ink2; font-size: 11px;
                                horizontal-alignment: center; }
                        }
                    }
                }
            }
        }

        if view == "collections" && root.collections.length == 0: Rectangle {
            vertical-stretch: 1; horizontal-stretch: 1;
            VerticalLayout {
                alignment: center; spacing: 14px;
                HorizontalLayout { alignment: center;
                    Rectangle { width: 96px; height: 96px; border-radius: 16px; background: bk-empty;
                        AppIcon { source: Icons.folder-open; width: 42px; height: 42px; } } }
                Text { text: "No shelves yet"; color: bk-ink; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                Text { text: "Hover a book cover and hit + to file it on a shelf."; color: bk-ink3; font-size: 13px; horizontal-alignment: center; }
            }
        }

        // ── BOOK TILE GRID (all / reading / unread / comics / shelf drill-in) ─
        if grid-view && tiles.length > 0: ScrollView {
            vertical-stretch: 1; horizontal-stretch: 1;
            VerticalLayout {
                padding-left: 32px; padding-right: 32px; padding-top: 22px; padding-bottom: 36px;
                spacing: 8px;
                // Series drill-in strip — reading-order row for an opened series.
                if root.series-strip.length > 0: Rectangle {
                    height: 258px; border-radius: 16px; background: bk-bar;
                    border-width: 1px; border-color: bk-hair;
                    VerticalLayout {
                        padding: 18px; spacing: 12px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: root.series-strip-title; color: bk-ink; font-family: "Georgia"; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                            Text { text: root.series-strip-sub; color: bk-ink3; font-size: 12px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.series-strip-done + " of " + root.series-strip-total + " finished"; color: bk-ink3; font-size: 12px; vertical-alignment: center; }
                            Rectangle { width: 110px; height: 5px; y: (parent.height - self.height)/2; border-radius: 3px; background: bk-hair;
                                Rectangle { x: 0; y: 0; height: parent.height; width: root.series-strip-total > 0 ? parent.width * root.series-strip-done / root.series-strip-total : 0; border-radius: 3px; background: root.accent; } }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            Rectangle {
                                width: root.series-strip.length * 156px; height: 186px;
                                for b[i] in root.series-strip: Rectangle {
                                    x: i * 156px; width: 138px; height: 186px;
                                    VerticalLayout {
                                        spacing: 6px;
                                        Rectangle {
                                            width: 138px; height: 150px; border-radius: 6px; clip: true; background: bk-cover;
                                            drop-shadow-blur: 8px; drop-shadow-color: #00000040; drop-shadow-offset-y: 4px;
                                            if b.has-cover: Image { source: b.thumb; image-fit: cover; width: parent.width; height: parent.height; }
                                            if !b.has-cover: GenCover { title: b.title; author: ""; tint: b.tint; dark: dk; width: parent.width; height: parent.height; }
                                            Rectangle { x: 0; y: 0; width: 6px; height: parent.height; background: #00000030; }
                                            // #n badge
                                            Rectangle { x: 8px; y: parent.height - 26px; width: 30px; height: 18px; border-radius: 9px; background: #000000a8;
                                                Text { text: "#" + b.num; color: #fff; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                                            if b.next-up: Rectangle { x: parent.width - 62px; y: 7px; width: 54px; height: 18px; border-radius: 9px; background: #f4b400;
                                                Text { text: "Next up"; color: #3a2f00; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                                            if b.finished: Rectangle { x: parent.width - 28px; y: 7px; width: 20px; height: 20px; border-radius: 10px; background: root.accent;
                                                AppIcon { source: Icons.check; tint: #fff; width: 12px; height: 12px; } }
                                            if b.frac > 0.001 && !b.finished: Rectangle { x: 0; y: parent.height - 5px; width: parent.width; height: 5px; background: #00000033;
                                                Rectangle { x: 0; y: 0; height: parent.height; width: parent.width * b.frac; background: #f4b400; } }
                                            stta := TouchArea { mouse-cursor: pointer; clicked => { root.series-strip-open(b.index); } }
                                        }
                                        Text { text: b.title; color: bk-ink; font-size: 12px; font-weight: 600; overflow: elide; horizontal-alignment: center; }
                                        Text { text: b.status; color: bk-ink2; font-size: 11px; overflow: elide; horizontal-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    property <int> cols: max(2, floor(self.width / 168px));
                    property <length> cell: (self.width - (cols - 1) * col-gap) / cols;
                    height: ceil(tiles.length / cols) * row-h;
                    for tile[idx] in root.tiles: Rectangle {
                        x: mod(idx, parent.cols) * (parent.cell + col-gap);
                        y: floor(idx / parent.cols) * row-h;
                        width: parent.cell; height: row-h;
                        VerticalLayout {
                            spacing: 8px;
                            // cover
                            Rectangle {
                                width: parent.width * 0.86; height: cover-h;
                                x: (parent.width - self.width) / 2;
                                border-radius: 5px; clip: true;
                                background: bk-cover;
                                drop-shadow-blur: ta.has-hover ? 20px : 9px;
                                drop-shadow-color: #00000044;
                                drop-shadow-offset-y: 6px;
                                if tile.has-cover: Image { source: tile.thumb; image-fit: cover; width: parent.width; height: parent.height; }
                                if !tile.has-cover: GenCover { title: tile.title; author: tile.author; tint: tile.tint; dark: dk; width: parent.width; height: parent.height; }
                                // spine shading
                                Rectangle { x: 0; y: 0; width: 6px; height: parent.height; background: #00000030; }
                                // format chip
                                Rectangle {
                                    x: parent.width - self.width - 6px; y: 6px;
                                    width: fmt.preferred-width + 12px; height: 18px; border-radius: 9px;
                                    background: #000000aa;
                                    fmt := Text { text: tile.format; color: #fff; font-size: 9px; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center; }
                                }
                                // finished tick
                                if tile.finished: Rectangle {
                                    x: 6px; y: 6px; width: 22px; height: 22px; border-radius: 11px; background: #1a73e8;
                                    AppIcon { source: Icons.check; tint: #fff; width: 13px; height: 13px; }
                                }
                                // progress bar
                                if tile.progress > 0.001 && !tile.finished: Rectangle {
                                    x: 0; y: parent.height - 5px; width: parent.width; height: 5px; background: #00000033;
                                    Rectangle { x: 0; y: 0; height: parent.height; width: parent.width * tile.progress;
                                        background: #f4b400; }
                                }
                                ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-detail(tile.index); } }
                                // Hover actions — declared after `ta` so they sit
                                // above it in z-order and actually receive clicks.
                                // fetch-meta (top) + add-to-shelf (below).
                                if ta.has-hover: Rectangle {
                                    x: parent.width - 32px; y: 28px;
                                    width: 26px; height: 26px; border-radius: 13px;
                                    background: #000000a8;
                                    TouchArea { mouse-cursor: pointer;
                                        clicked => { root.fetch-meta(tile.index); } }
                                    Text { text: "⊕"; color: #ffffff; font-size: 13px;
                                        horizontal-alignment: center; vertical-alignment: center; }
                                }
                                if ta.has-hover: Rectangle {
                                    x: parent.width - 32px; y: 58px;
                                    width: 26px; height: 26px; border-radius: 13px;
                                    background: #000000a8;
                                    TouchArea { mouse-cursor: pointer;
                                        clicked => { root.shelf-pick-idx = tile.index; } }
                                    AppIcon { source: Icons.plus; tint: #ffffff; width: 13px; height: 13px; }
                                }
                            }
                            Text { text: tile.title; color: bk-ink; font-size: 12px; font-weight: 600; overflow: elide;
                                horizontal-alignment: center; }
                            Text { text: tile.author; color: bk-ink2; font-size: 10px; overflow: elide;
                                horizontal-alignment: center; }
                        }
                    }
                }
            }
        }

        if grid-view && tiles.length == 0: Rectangle {
            vertical-stretch: 1; horizontal-stretch: 1;
            VerticalLayout {
                alignment: center; spacing: 14px;
                HorizontalLayout { alignment: center;
                    Rectangle { width: 96px; height: 96px; border-radius: 16px; background: bk-empty;
                        AppIcon { source: Icons.book-open; width: 42px; height: 42px; } } }
                Text { text: view == "all" ? "Your shelves are empty" : "Nothing here yet"; color: bk-ink; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                Text { text: "Add a folder with EPUB, CBZ, CBR, PDF, MOBI, AZW3 or FB2 files to build your reading library."; color: bk-ink3; font-size: 13px; horizontal-alignment: center; }
                HorizontalLayout { alignment: center;
                    Rectangle { width: 150px; height: 42px; border-radius: 21px; background: #1a73e8;
                        horizontal-stretch: 0; vertical-stretch: 0;
                        TouchArea { mouse-cursor: pointer; clicked => { root.add-folder(); } }
                        Text { text: "+ Add books"; color: #ffffff; font-size: 13px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center; } } }
            }
        }

        if view == "series" && root.series.length == 0: Rectangle {
            vertical-stretch: 1; horizontal-stretch: 1;
            VerticalLayout {
                alignment: center; spacing: 14px;
                HorizontalLayout { alignment: center;
                    Rectangle { width: 96px; height: 96px; border-radius: 16px; background: bk-empty;
                        AppIcon { source: Icons.book-open; width: 42px; height: 42px; } } }
                Text { text: "No series found"; color: bk-ink; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                Text { text: "Series are detected automatically from your book metadata."; color: bk-ink3; font-size: 13px; horizontal-alignment: center; }
            }
        }
    }

    // ── Book detail sheet (np.p4.books) ──────────────────────────────────────
    if root.detail-idx >= 0: Rectangle {
        background: #00000073;
        TouchArea { clicked => { root.detail-idx = -1; } }
        Rectangle {
            x: (parent.width - 660px) / 2; y: (parent.height - 430px) / 2;
            width: 660px; height: 430px; background: bk-bar; border-radius: 18px;
            border-width: 1px; border-color: bk-hair;
            drop-shadow-blur: 40px; drop-shadow-color: #00000066; drop-shadow-offset-y: 14px;
            TouchArea { }  // swallow inside clicks
            HorizontalLayout {
                padding: 26px; spacing: 24px;
                Rectangle {
                    width: 172px; height: 258px; border-radius: 8px; clip: true; background: bk-cover; horizontal-stretch: 0;
                    drop-shadow-blur: 20px; drop-shadow-color: #00000055; drop-shadow-offset-y: 8px;
                    if root.detail.has-cover: Image { source: root.detail.thumb; image-fit: cover; width: parent.width; height: parent.height; }
                    if !root.detail.has-cover: GenCover { title: root.detail.title; author: root.detail.author; tint: root.detail.tint; dark: dk; width: parent.width; height: parent.height; }
                }
                VerticalLayout {
                    spacing: 6px; horizontal-stretch: 1;
                    Text { text: root.detail.eyebrow; color: root.accent; font-size: 11px; font-weight: 700; letter-spacing: 1.2px; }
                    Text { text: root.detail.title; color: bk-ink; font-family: "Georgia"; font-size: 24px; font-weight: 700; wrap: word-wrap; }
                    Text { text: root.detail.author; color: bk-ink2; font-size: 14px; }
                    HorizontalLayout {
                        spacing: 6px; alignment: start;
                        for c in [root.detail.format, root.detail.size, root.detail.pages, root.detail.shelf]: Rectangle {
                            horizontal-stretch: 0; height: 22px; border-radius: 10px; border-width: 1px; border-color: bk-hair;
                            HorizontalLayout { padding-left: 10px; padding-right: 10px;
                                Text { text: c; color: bk-ink3; font-size: 11px; font-weight: 600; vertical-alignment: center; } }
                        }
                    }
                    Text { text: root.detail.desc; color: bk-ink3; font-size: 13px; wrap: word-wrap; }
                    if root.detail.has-progress: Rectangle {
                        height: 6px; border-radius: 3px; background: bk-hair;
                        Rectangle { x: 0; y: 0; height: parent.height; width: parent.width * root.detail.frac; border-radius: 3px; background: #f4b400; } }
                    if root.detail.has-progress: HorizontalLayout {
                        Text { text: root.detail.page-label; color: bk-ink3; font-size: 12px; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.detail.left-label; color: bk-ink3; font-size: 12px; } }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        Rectangle { horizontal-stretch: 0; width: 96px; height: 36px; border-radius: 18px; background: root.accent;
                            TouchArea { mouse-cursor: pointer; clicked => { root.detail-idx = -1; root.open-book(root.detail.index); } }
                            Text { text: "▶ Read"; color: #fff; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { horizontal-stretch: 0; width: 122px; height: 36px; border-radius: 18px; background: transparent; border-width: 1px; border-color: bk-hair;
                            TouchArea { mouse-cursor: pointer; clicked => { root.mark-finished(root.detail.index); root.detail-idx = -1; } }
                            Text { text: "✓ Mark finished"; color: bk-ink; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { horizontal-stretch: 0; width: 82px; height: 36px; border-radius: 18px; background: transparent; border-width: 1px; border-color: bk-hair;
                            TouchArea { mouse-cursor: pointer; clicked => { root.shelf-pick-idx = root.detail.index; } }
                            Text { text: "+ Shelf"; color: bk-ink; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { horizontal-stretch: 0; width: 60px; height: 36px; border-radius: 18px; background: transparent; border-width: 1px; border-color: bk-hair;
                            TouchArea { mouse-cursor: pointer; clicked => { root.fetch-meta(root.detail.index); } }
                            Text { text: "⊛ Meta"; color: bk-ink; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { horizontal-stretch: 0; width: 82px; height: 36px; border-radius: 18px; background: transparent; border-width: 1px; border-color: #c0392b59;
                            TouchArea { mouse-cursor: pointer; clicked => { root.remove-book(root.detail.index); root.detail-idx = -1; } }
                            Text { text: "Remove"; color: #c0392b; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } }
                    }
                }
            }
            Rectangle { x: parent.width - 44px; y: 12px; width: 32px; height: 32px; border-radius: 16px;
                background: sx.has-hover ? bk-hover : transparent;
                sx := TouchArea { mouse-cursor: pointer; clicked => { root.detail-idx = -1; } }
                Text { text: "✕"; color: bk-ink2; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; } }
        }
    }

    // ── Add-to-shelf popup (np.p4.books.library — collections) ───────────────
    if root.shelf-pick-idx >= 0: Rectangle {
        background: #00000055;
        TouchArea { clicked => { root.shelf-pick-idx = -1; } }
        Rectangle {
            x: (parent.width - 380px) / 2; y: (parent.height - 360px) / 2;
            width: 380px; height: 360px;
            background: bk-bar; border-radius: 16px;
            border-width: 1px; border-color: bk-hair;
            drop-shadow-blur: 28px; drop-shadow-color: #00000050; drop-shadow-offset-y: 8px;
            TouchArea { } // swallow clicks inside the card
            VerticalLayout {
                padding: 18px; spacing: 12px;
                Text { text: "Add to shelf"; color: bk-ink; font-size: 17px; font-weight: 700; }
                // Existing shelves
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for c in root.collections: Rectangle {
                            height: 38px; border-radius: 10px;
                            background: pta.has-hover ? bk-hover : transparent;
                            pta := TouchArea { mouse-cursor: pointer;
                                clicked => { root.add-to-collection(root.shelf-pick-idx, c.name); root.shelf-pick-idx = -1; } }
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 8px;
                                Text { text: c.name; color: bk-ink; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Text { text: c.book-count + ""; color: bk-ink2; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                        if root.collections.length == 0: Text { text: "No shelves yet — create one below.";
                            color: bk-ink2; font-size: 12px; }
                    }
                }
                // New shelf
                HorizontalLayout {
                    spacing: 8px;
                    nsname := LineEdit { placeholder-text: "New shelf name…"; horizontal-stretch: 1;
                        accepted(t) => { if (t != "") { root.add-to-collection(root.shelf-pick-idx, t); root.shelf-pick-idx = -1; } } }
                    Rectangle {
                        width: 84px; height: 36px; border-radius: 18px; background: #1a73e8;
                        TouchArea { mouse-cursor: pointer;
                            clicked => { if (nsname.text != "") { root.add-to-collection(root.shelf-pick-idx, nsname.text); root.shelf-pick-idx = -1; } } }
                        Text { text: "Create"; color: #ffffff; font-size: 13px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 84px; height: 36px; border-radius: 18px; background: bk-hair;
                        TouchArea { mouse-cursor: pointer; clicked => { root.shelf-pick-idx = -1; } }
                        Text { text: "Cancel"; color: bk-ink; font-size: 13px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
