// Throwaway preview harness for slint-viewer --auto-reload during the music split.
// NOT part of the app build (build.rs compiles main.slint only). Delete when done.
// Force `view` to the section under test; the viewer can't click-navigate
// (nav calls go to Rust), so we instantiate MusicPage directly with a view set.
import { MusicPage } from "page_music.slint";

export component Preview inherits Window {
    preferred-width: 1280px;
    preferred-height: 820px;
    title: "tulipix music — split preview";
    MusicPage {
        width: 100%;
        height: 100%;
        // Change this string to preview a different section:
        // mymusic | podcasts | audiobooks | radio | youtube
        view: "audiobooks";
    }
}
