import { Theme, Accent } from "tokens.slint";

// 4 gradient orbs. Real GPU shader is np.p1.ds.orbs (later);
// this is a layered radial-gradient stand-in that still shifts to section accent corner.
export component Orbs inherits Rectangle {
    in property <color> accent: Accent.color;
    in property <{x: float, y: float}> primary-anchor: Accent.orb-corner;

    property <color> animated-accent: accent;
    animate animated-accent { duration: 800ms; easing: ease-in-out; }

    Rectangle {
        background: @radial-gradient(circle, animated-accent.with-alpha(0.28) 0%, transparent 55%);
        x: parent.width  * primary-anchor.x - parent.width  * 0.35;
        y: parent.height * primary-anchor.y - parent.height * 0.35;
        width: parent.width * 0.70; height: parent.height * 0.70;
        animate x { duration: 800ms; easing: ease-in-out; }
        animate y { duration: 800ms; easing: ease-in-out; }
    }
    Rectangle {
        background: @radial-gradient(circle, Theme.brand-2.with-alpha(0.18) 0%, transparent 60%);
        x: parent.width * 0.55; y: parent.height * -0.10;
        width: parent.width * 0.55; height: parent.height * 0.55;
    }
    Rectangle {
        background: @radial-gradient(circle, Theme.sec-music.with-alpha(0.14) 0%, transparent 60%);
        x: parent.width * -0.20; y: parent.height * 0.55;
        width: parent.width * 0.60; height: parent.height * 0.60;
    }
    Rectangle {
        background: @radial-gradient(circle, Theme.sec-books.with-alpha(0.12) 0%, transparent 60%);
        x: parent.width * 0.60; y: parent.height * 0.55;
        width: parent.width * 0.55; height: parent.height * 0.55;
    }
}
