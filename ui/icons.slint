    out property <image> upload:        @image-url("../resources/icons/upload.svg");
    out property <image> rss:           @image-url("../resources/icons/rss.svg");
    out property <image> calendar:      @image-url("../resources/icons/calendar.svg");
    out property <image> calendar-clock:@image-url("../resources/icons/calendar-clock.svg");
    out property <image> file-text:     @image-url("../resources/icons/file-text.svg");
    out property <image> circle:        @image-url("../resources/icons/circle.svg");
