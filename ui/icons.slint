    out property <image> wallet:        @image-url("../resources/icons/wallet.svg");
    out property <image> credit-card:   @image-url("../resources/icons/credit-card.svg");
    out property <image> receipt:       @image-url("../resources/icons/receipt.svg");
    out property <image> trending-up:   @image-url("../resources/icons/trending-up.svg");
