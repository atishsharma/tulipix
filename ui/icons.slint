    out property <image> bookmark:      @image-url("../resources/icons/bookmark.svg");
    out property <image> inbox:         @image-url("../resources/icons/inbox.svg");
    out property <image> clipboard:     @image-url("../resources/icons/clipboard.svg");
    out property <image> contrast:      @image-url("../resources/icons/contrast.svg");
    out property <image> move-vertical: @image-url("../resources/icons/move-vertical.svg");
    out property <image> move-horizontal:@image-url("../resources/icons/move-horizontal.svg");
    out property <image> disc:          @image-url("../resources/icons/disc.svg");
    out property <image> columns-2:     @image-url("../resources/icons/columns-2.svg");
