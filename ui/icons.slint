    out property <image> flip-vertical: @image-url("../resources/icons/flip-vertical.svg");
    out property <image> star-filled:   @image-url("../resources/icons/star-filled.svg");
    out property <image> heart-filled:  @image-url("../resources/icons/heart-filled.svg");
    out property <image> plus:          @image-url("../resources/icons/plus.svg");
    out property <image> move:          @image-url("../resources/icons/move.svg");
    out property <image> crop:          @image-url("../resources/icons/crop.svg");
    out property <image> scaling:       @image-url("../resources/icons/scaling.svg");
    out property <image> minus:         @image-url("../resources/icons/minus.svg");
    out property <image> spline:        @image-url("../resources/icons/spline.svg");
    out property <image> share:         @image-url("../resources/icons/share.svg");
    out property <image> link:          @image-url("../resources/icons/link.svg");
