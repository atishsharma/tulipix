    // Photo viewer modal
    in-out property <bool> viewer-open: false;
    in-out property <image> viewer-image;
    in-out property <string> viewer-label: "";
    in-out property <int> viewer-index: 0;
    in-out property <int> viewer-total: 0;
    in-out property <bool> viewer-slideshow: false;
    in-out property <float> viewer-zoom: 1.0;          // multiplier on top of fit-to-window
    in-out property <int> viewer-nat-w: 0;             // source pixel width (for true %)
    in-out property <int> viewer-nat-h: 0;             // source pixel height
    in-out property <bool> viewer-shuffle: false;       // random next/prev
    in-out property <int> viewer-slideshow-secs: 4;     // slideshow dwell time
    in-out property <bool> viewer-info-open: false;     // EXIF panel toggle
    in-out property <string> viewer-exif: "";           // preformatted EXIF block (Rust-supplied)
    in-out property <image> viewer-histogram;           // RGB histogram (Rust-rendered)
    in-out property <bool> viewer-slideshow-setup: false; // slideshow config row visible
    // Slideshow transition. `viewer-anim` is the chosen effect id; "random"
    // picks one of the five per slide (keyed off viewer-index). The enter
    // animation is replayed each slide: on index change we instantly reset
    // viewer-anim-t to 0 (dur 0ms) then a 1-shot timer ramps it to 1 (dur set).
    in-out property <string> viewer-anim: "fade"; // fade|zoomin|zoomout|slide|dissolve|random
    property <[string]> viewer-anim-pool: ["fade", "zoomin", "zoomout", "slide", "dissolve"];
    property <float> viewer-anim-t: 1.0;
    property <duration> viewer-anim-dur: 0ms;
    property <bool> viewer-anim-kick: false;
    animate viewer-anim-t { duration: root.viewer-anim-dur; easing: ease-out; }
    changed viewer-index => {
        if (root.viewer-slideshow) {
            root.viewer-anim-dur = 0ms; root.viewer-anim-t = 0.0; // instant reset
            root.viewer-anim-kick = true;                          // arm ramp timer
        }
    }
    // Effective effect for the current slide (resolves "random").
    property <string> viewer-anim-eff: root.viewer-anim == "random"
        ? root.viewer-anim-pool[Math.mod(root.viewer-index, 5)]
        : root.viewer-anim;

    // Shared-element hero transition (thumb → viewer). `hero-from` is the
    // clicked tile's absolute rect; `hero-trigger` drives the morph; once it
    // lands, `hero-faded` crossfades the hero out onto the static viewer image.
    in-out property <HeroRect> hero-from: { x: 0px, y: 0px, w: 0px, h: 0px };
    in-out property <bool> hero-trigger: false;
    in-out property <bool> hero-faded: false;
    changed viewer-open => {
        if !root.viewer-open {
            root.hero-trigger = false; root.hero-faded = false;
            root.viewer-slideshow-setup = false;
        }
    }
    // Drive real OS-level fullscreen from the slideshow state — any path that
    // toggles viewer-slideshow (Start button, click-to-stop, Esc, close) keeps
    // the window's fullscreen flag in sync.
    callback request-fullscreen(bool);
    changed viewer-slideshow => { root.request-fullscreen(root.viewer-slideshow); }
    // (Re)arm the 5 s idle countdown that auto-starts the slideshow when the
    // setup row is left untouched. Each setup interaction re-arms it.
    callback slideshow-arm();

