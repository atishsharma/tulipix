import { MusicTheme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Sidebar } from "sidebar.slint";
import { Orbs } from "orbs.slint";
import { SectionPage, PhotoTile } from "section_page.slint";
import { PhotosPage, PhotoGroup, FolderRow, PersonCard, ThingChip, AlbumCard, MemoryRail, MapCluster, DedupeGroup } from "page_photos.slint";
import { PhotoEditor } from "photo_editor.slint";
import { SharedHero, HeroRect } from "shared_element.slint";
import { MilestoneConfetti } from "empty_state.slint";
import { VideosPage, VideoTile, ShowCard, VideoSeason, DiscoverCard } from "page_videos.slint";
import { PlayerOverlay, PlayerTrack, PlayerChapter } from "player.slint";
import { MusicPage, MusicFullscreen, MusicMini, PodcastMini } from "page_music.slint";
import { MusicSongRow, SongRowEx, MusicLyricLine, LyricsResult, LyricsMgrRow, MetaMgrRow, PodcastCard, PodcastTrendCard, PodcastEpisodeRow, BookCard, ChapterRow, RadioStation, YtVideo, YtSub, YtPlaylist, YtDlJob } from "music_common.slint";
import { BooksPage, BookTile, TocEntryRow, BookmarkRow, SeriesRow, AuthorRow, CollectionRow } from "page_books.slint";
import { BookReader } from "book_reader.slint";
import { CloudPage, CloudRemote, CloudEntry, CloudJob, CloudUsage, CloudXfer } from "page_cloud.slint";
import { ToolsPage, ToolOpRow, ToolField, QueueJob, ToolStatus, DownloadItem, ToolInfoRow, ToolDiffRow, TrimSeg } from "page_tools.slint";
import { ThemePicker, ThemeChoice } from "theme_picker.slint";
import { UserState } from "user_card.slint";
import { Mode } from "mode_pill.slint";
import { SettingsApiKeys, ApiKeyRow } from "settings_api_keys.slint";
import { SettingsLibraries, LibraryRow } from "settings_libraries.slint";
import { SettingsScanSchedule, ScanLibraryRow } from "settings_scan_schedule.slint";
import { PanelFrost } from "frost.slint";
import { ScanProgressCard, ScanProgress } from "scan_progress.slint";
import { AmbientScreensaver } from "ambient.slint";
import { ContextMenu, ContextItem } from "context_menu.slint";
import { CmdPalette, PaletteRow } from "cmd_palette.slint";
import { ShortcutHelp, ShortcutGroup, ShortcutItem } from "shortcut_help.slint";
import { ErrorBoundary } from "error_page.slint";
import { PropertiesWindow, AssetProperties } from "properties.slint";
import { SettingsList, SettingItem } from "settings_panels.slint";
import { ChatOverlay, ChatTurn } from "chat_overlay.slint";
import { Gated, GateMode } from "gated.slint";
import { ModePill } from "mode_pill.slint";
import { OnboardingWizard } from "onboarding_wizard.slint";
import { AppIcon, Icons } from "icons.slint";

export {
    ApiKeyRow,
    LibraryRow,
    ScanLibraryRow,
    ThemeChoice,
    Mode,
    UserState,
    PhotoTile,
    ScanProgress,
    PaletteRow,
    ShortcutGroup,
    ShortcutItem,
    AssetProperties,
    SettingItem,
    ChatTurn,
    ContextItem,
}

component SettingsTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    min-height: 36px; max-height: 36px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 12px;
    background: active ? Theme.panel-2 : (touch.has-hover ? Theme.panel : transparent);
    border-color: active ? Theme.outline-strong : transparent;
    border-width: 1px;
    animate background { duration: 140ms; easing: ease-out; }
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        Text {
            text: label;
            color: active ? Theme.text : Theme.text-dim;
            font-size: 12px; font-weight: active ? 600 : 500;
            vertical-alignment: center; horizontal-alignment: center;
        }
    }
}

// Small pill button used in the Settings → Profile panel.
component AcctBtn inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 28px; min-width: 96px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 8px;
    background: touch.has-hover ? Theme.panel : Theme.panel-2;
    border-color: Theme.outline; border-width: 1px;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        Text { text: label; color: Theme.text; font-size: 11px; font-weight: 600;
            vertical-alignment: center; horizontal-alignment: center; }
    }
}

// Pill button used in the photo viewer control bar.
component ViewerButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: false;
    callback clicked();
    height: 38px; min-width: 96px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 19px;
    background: primary
        ? Accent.color.with-alpha(touch.has-hover ? 0.40 : 0.28)
        : white.with-alpha(touch.has-hover ? 0.26 : 0.16);
    border-width: 1px;
    border-color: primary ? Accent.color.with-alpha(0.70) : white.with-alpha(0.34);
    animate background { duration: 120ms; easing: ease-out; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 16px; padding-right: 16px; spacing: 7px; alignment: center;
        if root.icon.width > 0: VerticalLayout { alignment: center; AppIcon { source: root.icon; tint: white; width: 15px; height: 15px; } }
        Text {
            text: label; color: white; font-size: 12px; font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Compact square-ish viewer control (zoom · shuffle · interval · info).
component ViewerMini inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    callback clicked();
    height: 38px; min-width: 46px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 19px;
    background: active
        ? Accent.color.with-alpha(touch.has-hover ? 0.45 : 0.32)
        : white.with-alpha(touch.has-hover ? 0.26 : 0.14);
    border-width: 1px;
    border-color: active ? Accent.color.with-alpha(0.75) : white.with-alpha(0.30);
    animate background { duration: 120ms; easing: ease-out; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 6px; alignment: center;
        if root.icon.width > 0: VerticalLayout { alignment: center; AppIcon { source: root.icon; tint: white; width: 14px; height: 14px; } }
        if root.label != "": Text {
            text: label; color: white; font-size: 12px; font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component ContentSurface inherits Rectangle {
    // Glass surface that wraps every section/page so the layout never
    // collapses to intrinsic size.
    border-radius: Theme.radius-lg;
    background: Theme.panel.with-alpha(0.55);
    border-width: 1px;
    border-color: Theme.outline;
    drop-shadow-blur: 32px;
    drop-shadow-color: #00000040;
    clip: true;
}

component SettingsPage inherits Rectangle {
    in-out property <string> active-tab: "appearance";

    in-out property <ThemeChoice> theme-choice;
    in-out property <bool> reduce-motion;
    callback reduce-motion-changed(bool);
    in property <bool> account-sync-allowed;
    in property <UserState> user;
    in property <[ApiKeyRow]> api-rows;
    in property <[LibraryRow]> library-rows;
    in property <string> lib-busy-task;
    in property <float> lib-busy-frac;
    in property <[ScanLibraryRow]> scan-rows;
    in property <string> default-cadence;

    // Data-driven panels (AI · Endpoints · Security · Data · System).
    in property <[SettingItem]> ai-rows;
    in property <[SettingItem]> endpoint-rows;
    in property <[SettingItem]> security-rows;
    in property <[SettingItem]> data-rows;
    in property <[SettingItem]> system-rows;
    callback setting-toggle(string, bool);
    callback setting-text(string, string);
    callback setting-action(string);

    callback theme-changed(ThemeChoice);
    callback user-action(string);
    callback api-row-toggle(int);
    callback api-row-edit(int);
    callback api-row-test(int);
    callback lib-add();
    callback lib-rescan-all();
    callback lib-clear-thumb-cache();
    callback lib-reset-app();
    callback lib-rebuild-fts();
    callback lib-row-rescan(int);
    callback lib-row-rethumb(int);
    callback lib-row-edit-exclude(int);
    callback lib-row-remove(int);
    callback lib-row-save-section(int, string);
    callback set-default-cadence(string);
    callback set-cadence-override(string, string);

    background: transparent;

    VerticalLayout {
        padding: 28px; spacing: 18px;

        // Header
        HorizontalLayout {
            spacing: 12px; alignment: start;
            Rectangle {
                width: 6px; height: 36px;
                border-radius: 3px;
                background: Accent.color;
                horizontal-stretch: 0;
            }
            VerticalLayout { alignment: center; horizontal-stretch: 0;
                Rectangle { width: 38px; height: 38px; border-radius: 11px;
                    background: Accent.color.with-alpha(0.16);
                    AppIcon { source: Icons.settings; tint: Accent.color; width: 20px; height: 20px;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; } } }
            VerticalLayout {
                spacing: 2px;
                Text { text: "Settings"; color: Theme.text; font-size: 26px; font-weight: 700; }
                Text { text: "Appearance · Libraries · Schedule · API Keys · Profile"; color: Theme.text-dim; font-size: 12px; }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        // Tab strip
        HorizontalLayout {
            spacing: 8px; alignment: start;
            SettingsTab { label: "Appearance"; active: root.active-tab == "appearance"; clicked => { root.active-tab = "appearance"; } }
            SettingsTab { label: "Libraries";  active: root.active-tab == "libraries";  clicked => { root.active-tab = "libraries"; } }
            SettingsTab { label: "Schedule";   active: root.active-tab == "schedule";   clicked => { root.active-tab = "schedule"; } }
            SettingsTab { label: "API Keys";   active: root.active-tab == "api-keys";   clicked => { root.active-tab = "api-keys"; } }
            SettingsTab { label: "AI Models";  active: root.active-tab == "ai";          clicked => { root.active-tab = "ai"; } }
            SettingsTab { label: "Endpoints";  active: root.active-tab == "endpoints";   clicked => { root.active-tab = "endpoints"; } }
            SettingsTab { label: "Security";   active: root.active-tab == "security";    clicked => { root.active-tab = "security"; } }
            SettingsTab { label: "Data";       active: root.active-tab == "data";        clicked => { root.active-tab = "data"; } }
            SettingsTab { label: "System";     active: root.active-tab == "system";      clicked => { root.active-tab = "system"; } }
            SettingsTab { label: "Profile";    active: root.active-tab == "profile";     clicked => { root.active-tab = "profile"; } }
            Rectangle { horizontal-stretch: 1; }
        }

        // Content stage — exactly one child visible at a time, wrapped in
        // a Rectangle that forces full-stage geometry.
        Rectangle {
            background: transparent;
            vertical-stretch: 1;
            horizontal-stretch: 1;

            if active-tab == "appearance": Rectangle {
                width: parent.width; height: parent.height;
                background: transparent;
                VerticalLayout {
                    spacing: 14px; padding: 4px;
                    Text { text: "Theme"; color: Theme.text-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.7px; }
                    ThemePicker {
                        choice <=> root.theme-choice;
                        changed(c) => { root.theme-changed(c); }
                    }

                    Rectangle { height: 14px; }
                    Text { text: "Motion"; color: Theme.text-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.7px; }
                    Rectangle {
                        height: 60px;
                        border-radius: Theme.radius-md;
                        background: Theme.panel-2; border-color: Theme.outline; border-width: 1px;
                        HorizontalLayout {
                            padding: 14px; spacing: 14px; alignment: stretch;
                            VerticalLayout {
                                alignment: center; spacing: 3px; horizontal-stretch: 1;
                                Text { text: "Reduce motion"; color: Theme.text; font-size: 13px; font-weight: 600; }
                                Text { text: "Skip ripple waves, orb drift, and screensaver fades."; color: Theme.text-dim; font-size: 11px; }
                            }
                            // Pill toggle.
                            Rectangle {
                                width: 52px; height: 28px;
                                horizontal-stretch: 0; vertical-stretch: 0;
                                y: (parent.height - self.height) / 2;
                                border-radius: 14px;
                                background: root.reduce-motion ? Accent.color : Theme.outline;
                                animate background { duration: 140ms; easing: ease-out; }
                                TouchArea { mouse-cursor: pointer; clicked => { root.reduce-motion-changed(!root.reduce-motion); } }
                                Rectangle {
                                    width: 22px; height: 22px; border-radius: 11px;
                                    background: #ffffff;
                                    x: root.reduce-motion ? parent.width - self.width - 3px : 3px;
                                    y: (parent.height - self.height) / 2;
                                    animate x { duration: 140ms; easing: ease-out; }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }

            if active-tab == "libraries": Rectangle {
                width: parent.width; height: parent.height;
                background: transparent;
                SettingsLibraries {
                    width: parent.width; height: parent.height;
                    rows: root.library-rows;
                    busy-task: root.lib-busy-task;
                    busy-frac: root.lib-busy-frac;
                    add-location => { root.lib-add(); }
                    rescan-all => { root.lib-rescan-all(); }
                    clear-thumb-cache => { root.lib-clear-thumb-cache(); }
                    rebuild-fts => { root.lib-rebuild-fts(); }
                    reset-app => { root.lib-reset-app(); }
                    row-rescan(i) => { root.lib-row-rescan(i); }
                    row-rethumb(i) => { root.lib-row-rethumb(i); }
                    row-edit-exclude(i) => { root.lib-row-edit-exclude(i); }
                    row-remove(i) => { root.lib-row-remove(i); }
                    row-save-section(i, s) => { root.lib-row-save-section(i, s); }
                }
            }

            if active-tab == "schedule": Rectangle {
                width: parent.width; height: parent.height;
                background: transparent;
                SettingsScanSchedule {
                    width: parent.width; height: parent.height;
                    default-cadence: root.default-cadence;
                    rows: root.scan-rows;
                    set-default-cadence(c) => { root.set-default-cadence(c); }
                    set-override(id, c) => { root.set-cadence-override(id, c); }
                }
            }

            if active-tab == "api-keys": Rectangle {
                width: parent.width; height: parent.height;
                background: transparent;
                SettingsApiKeys {
                    width: parent.width; height: parent.height;
                    rows: root.api-rows;
                    row-toggle(i) => { root.api-row-toggle(i); }
                    row-edit(i)   => { root.api-row-edit(i); }
                    row-test(i)   => { root.api-row-test(i); }
                }
            }

            if active-tab == "ai": Rectangle {
                width: parent.width; height: parent.height; background: transparent;
                SettingsList {
                    width: parent.width; height: parent.height;
                    title: "AI Models"; blurb: "On-device models, auto-captioning, voice search, and optional cloud offload. Models download on demand.";
                    rows: root.ai-rows;
                    toggle(k, v) => { root.setting-toggle(k, v); }
                    text-edited(k, s) => { root.setting-text(k, s); }
                    action(k) => { root.setting-action(k); }
                }
            }
            if active-tab == "endpoints": Rectangle {
                width: parent.width; height: parent.height; background: transparent;
                SettingsList {
                    width: parent.width; height: parent.height;
                    title: "Endpoints & Providers"; blurb: "Override default service URLs (self-host / mirror) and toggle optional metadata providers.";
                    rows: root.endpoint-rows;
                    toggle(k, v) => { root.setting-toggle(k, v); }
                    text-edited(k, s) => { root.setting-text(k, s); }
                    action(k) => { root.setting-action(k); }
                }
            }
            if active-tab == "security": Rectangle {
                width: parent.width; height: parent.height; background: transparent;
                SettingsList {
                    width: parent.width; height: parent.height;
                    title: "Security"; blurb: "Idle auto-lock, passkey unlock, encryption at rest, and OS sandbox status.";
                    rows: root.security-rows;
                    toggle(k, v) => { root.setting-toggle(k, v); }
                    text-edited(k, s) => { root.setting-text(k, s); }
                    action(k) => { root.setting-action(k); }
                }
            }
            if active-tab == "data": Rectangle {
                width: parent.width; height: parent.height; background: transparent;
                SettingsList {
                    width: parent.width; height: parent.height;
                    title: "Data & Tools"; blurb: "Backup / restore, portable export, migration import, and bug reports.";
                    rows: root.data-rows;
                    toggle(k, v) => { root.setting-toggle(k, v); }
                    text-edited(k, s) => { root.setting-text(k, s); }
                    action(k) => { root.setting-action(k); }
                }
            }
            if active-tab == "system": Rectangle {
                width: parent.width; height: parent.height; background: transparent;
                SettingsList {
                    width: parent.width; height: parent.height;
                    title: "System & Performance"; blurb: "Live diagnostics, bundled tools, platform integrations, notifications, and plugins.";
                    rows: root.system-rows;
                    toggle(k, v) => { root.setting-toggle(k, v); }
                    text-edited(k, s) => { root.setting-text(k, s); }
                    action(k) => { root.setting-action(k); }
                }
            }

            if active-tab == "profile": Rectangle {
                width: parent.width; height: parent.height;
                background: transparent;
                ScrollView {
                  width: parent.width; height: parent.height;
                  VerticalLayout {
                    spacing: 16px; padding: 4px;

                    // ── Profile (scaffold) ─────────────────────────────────
                    Text { text: "Profile"; color: Theme.text-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.7px; }
                    Rectangle {
                        height: 92px; border-radius: Theme.radius-md;
                        background: Theme.panel-2; border-color: Theme.outline; border-width: 1px;
                        HorizontalLayout {
                            padding: 16px; spacing: 14px;
                            Rectangle {
                                width: 56px; height: 56px; border-radius: 28px;
                                background: @linear-gradient(135deg, Theme.brand, Theme.brand-2);
                                y: (parent.height - self.height) / 2; horizontal-stretch: 0;
                                if user.avatar-emoji == "": AppIcon { source: Icons.user; tint: #ffffff; width: 26px; height: 26px; }
                                Text { text: user.avatar-emoji; visible: user.avatar-emoji != ""; font-size: 26px;
                                    horizontal-alignment: center; vertical-alignment: center; }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 3px; horizontal-stretch: 1;
                                Text { text: user.display-name == "" ? "Local user" : user.display-name; color: Theme.text; font-size: 15px; font-weight: 700; }
                                Text { text: user.secondary; color: Theme.text-dim; font-size: 11px; }
                            }
                            VerticalLayout { alignment: center; horizontal-stretch: 0; spacing: 6px;
                                AcctBtn { label: "Edit Profile"; clicked => { root.user-action("edit-profile"); } }
                            }
                        }
                    }

                    // ── Local-only — no account mode, no sign-in ───────────
                    Text { text: "Privacy"; color: Theme.text-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.7px; }
                    Rectangle {
                        height: 64px; border-radius: Theme.radius-md;
                        background: Theme.panel-2; border-color: Theme.outline; border-width: 1px;
                        HorizontalLayout {
                            padding: 14px; spacing: 12px;
                            HorizontalLayout { alignment: center; spacing: 6px; VerticalLayout { alignment: center; AppIcon { source: Icons.home; tint: Theme.text; width: 13px; height: 13px; } } Text { text: " This app is local at heart — everything stays on this device. No accounts, no servers, full access."; color: Theme.text; font-size: 13px; vertical-alignment: center; } }
                            VerticalLayout { alignment: center; horizontal-stretch: 0;
                                ModePill { mode: user.mode; } }
                        }
                    }

                    // ── Managed profiles (scaffold) ────────────────────────
                    Text { text: "Profiles"; color: Theme.text-dim; font-size: 11px; font-weight: 700; letter-spacing: 0.7px; }
                    Rectangle {
                        height: 56px; border-radius: Theme.radius-md;
                        background: Theme.panel-2; border-color: Theme.outline; border-width: 1px;
                        HorizontalLayout {
                            padding: 14px; spacing: 10px;
                            Text { text: (user.display-name == "" ? "Local user" : user.display-name) + "  ·  Owner";
                                color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                            VerticalLayout { alignment: center; AcctBtn { label: "Add profile"; clicked => { root.user-action("profiles"); } } }
                        }
                    }

                    Rectangle { vertical-stretch: 1; min-height: 12px; }
                  }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: root.music-fullscreen ? "Tulipix Music - Zen" : "Tulipix";
    icon: @image-url("icons/tulipix.png"); // app icon — window + taskbar
    min-width: 1100px;
    min-height: 720px;
    preferred-width: 1320px;
    preferred-height: 840px;
    background: Theme.bg;
    default-font-family: Theme.font-family;
    default-font-size: 13px;

    in-out property <string> active-section: "photos";
    callback section-changed(string);   // sidebar section click → preload that section
    in-out property <string> active-settings-tab: "appearance";
    in-out property <UserState> user: { display-name: "Local user", secondary: "0 items · 0 B", mode: Mode.local };
    in-out property <ThemeChoice> theme-choice: ThemeChoice.system;
    in-out property <bool> dark <=> Theme.dark;
    in-out property <bool> reduce-motion <=> Theme.reduce-motion;
    callback reduce-motion-changed(bool);
    // Music-section theme (light / dark / OLED) — two-way bound so Rust can
    // restore the last-used choice on boot and persist it when it changes.
    in-out property <bool> music-light <=> MusicTheme.light;
    in-out property <bool> music-oled <=> MusicTheme.oled;
    callback music-theme-changed();

    in-out property <[ApiKeyRow]> api-rows: [];
    in-out property <[LibraryRow]> library-rows: [];
    in-out property <string> lib-busy-task: "";
    in-out property <float> lib-busy-frac: 0;
    in-out property <[ScanLibraryRow]> scan-rows: [];
    in-out property <[SettingItem]> ai-rows: [];
    in-out property <[SettingItem]> endpoint-rows: [];
    in-out property <[SettingItem]> security-rows: [];
    in-out property <[SettingItem]> data-rows: [];
    in-out property <[SettingItem]> system-rows: [];
    callback setting-toggle(string, bool);
    callback setting-text(string, string);
    callback setting-action(string);
    in-out property <[PhotoTile]> photo-tiles: [];
    in-out property <[VideoTile]> video-tiles: [];
    // Videos library tab (np.p3.star-archive-trash / last-accessed / watch-progress).
    in-out property <string> video-category: "library";
    in-out property <string> video-kind: "local";
    in-out property <string> video-query: "";
    in-out property <[ShowCard]> video-shows: [];
    in-out property <[VideoTile]> video-next-up: []; // np.p3.episodes Next Up rail
    in-out property <[VideoSeason]> video-seasons: [];
    in-out property <bool> video-show-open: false;
    in-out property <string> video-show-title: "";
    // Discover feed arrays (np.p3.discover) — populated by kick_discover_refresh.
    in-out property <[DiscoverCard]> video-discover-movies: [];
    in-out property <[DiscoverCard]> video-discover-shows: [];
    in-out property <[DiscoverCard]> video-discover-upcoming: [];
    in-out property <[DiscoverCard]> video-discover-on-air: [];
    callback set-video-category(string);
    callback set-video-kind(string);
    callback video-search(string);
    callback video-show-drill(int);
    callback video-show-back();
    callback video-refresh-discover();
    // Right-click context menu for video posters — its own overlay state so it
    // doesn't collide with the photo grid's menu.
    in-out property <bool> vctx-open: false;
    in-out property <length> vctx-x: 0;
    in-out property <length> vctx-y: 0;
    in-out property <int> vctx-index: 0;
    in-out property <[ContextItem]> vctx-items: [];
    callback open-video-context(int, length, length);
    callback video-context-action(int, string);
    callback video-clear-thumbs();

    // ── Embedded media player (np.p3.player.*) ──
    in-out property <bool> player-open: false;
    in-out property <image> player-frame;
    in-out property <string> player-title: "";
