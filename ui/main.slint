    in-out property <string> music-fs-tab: "lyrics";
    in-out property <bool> music-mini-open: false;
    in-out property <bool> music-mini-bubble: false;
    in-out property <length> music-mini-x: 0px;
    in-out property <length> music-mini-y: 0px;
    // Uniform scale (keeps the 300×470 aspect ratio); 1.0 = original, 3.0 = 300%.
    in-out property <float> music-mini-scale: 1.0;
    property <length> music-mini-w: 300px * root.music-mini-scale;
    // Podcast mini has one fewer control row than the music mini (the full-width
    // speed slider became an inline pill), so it gets a shorter shell — no blank gap.
    property <length> music-mini-h: (root.music-player-mode == "podcast" ? 456px : 470px) * root.music-mini-scale;
    // Open the mini-player centered in the page (used when a podcast starts).
    callback music-center-mini();
    music-center-mini => {
        root.music-mini-bubble = false;
        root.music-mini-open = true;
        root.music-mini-x = (root.width - root.music-mini-w) / 2;
        root.music-mini-y = (root.height - root.music-mini-h) / 2;
    }
    in-out property <length> music-bubble-y: -1px;   // <0 = uninitialised (centre on show)
    in-out property <bool> music-mini-show-queue: false;
    callback music-open-fullscreen();
    callback music-open-mini();

    // Command palette (Ctrl/Cmd+K)
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <[PaletteRow]> palette-rows: [];
    callback palette-query-changed(string);
    callback palette-activated(string);

    // Keyboard-shortcut help (? / F1)
    in-out property <bool> shortcuts-open: false;
    in-out property <[ShortcutGroup]> shortcut-groups: [];

    // Top-level error boundary (panic / fatal)
    in-out property <bool> error-open: false;
    in-out property <string> error-title: "Something went wrong";
    in-out property <string> error-message: "";
    in-out property <string> error-log-tail: "";
    callback error-open-logs();
    callback error-reload();
    callback error-quit();

    // Properties window (asset right-click → Properties)
    in-out property <bool> props-open: false;
    in-out property <AssetProperties> props;
    callback props-open-folder();

    // Chat assistant overlay (Cmd/Ctrl+J)
    in-out property <bool> chat-open: false;
    in-out property <[ChatTurn]> chat-turns: [];
    in-out property <string> chat-draft: "";
    callback chat-submit(string);

    // Capability gating — local app: always true (kept for kid/guest profiles).
    in-out property <bool> account-sync-allowed: false;
    in-out property <string> caps-nudge: "";

    // First-run onboarding wizard (np.p1.auth-shell)
    in-out property <bool> onboarding-open: false;
    in-out property <bool> onboarding-lib-added: false;
    callback onboarding-finished();

    in-out property <string> photos-view-mode: "library";
    in-out property <int> photos-total: 0;          // total photos in library (unfiltered)
    in-out property <int> photos-folder-count: 0;
    in-out property <string> photos-category: "timeline";
    in-out property <string> photos-query: "";
    in-out property <[PhotoGroup]> photo-groups: [];   // timeline date groups
    in-out property <[FolderRow]> photo-folders: [];   // library folder list
    in-out property <[PersonCard]> photo-people: [];   // People tab (np.p2.ai.face-clusters)
    in-out property <[ThingChip]> photo-things: [];    // Things tab (np.p2.ai.tags)
    in-out property <[AlbumCard]> photo-albums: [];    // Albums tab (np.p2.albums)
    in-out property <[AlbumCard]> album-picker-albums: []; // "Add to album" picker list
    in-out property <bool> album-picker-open: false;
    in-out property <string> photos-filter-title: ""; // header for person/tag drill-in
    in-out property <string> photos-folder-name: "";   // open folder (folder view)
    in-out property <string> photos-sort: "date";      // date | name | size
    in-out property <string> photos-sort-dir: "desc";  // asc | desc
    in-out property <string> photos-lib-sort: "name";  // library folder sort: name | count
    in-out property <string> photos-lib-sort-dir: "asc"; // asc | desc
    in-out property <string> photos-blink: "";         // tab to flash as action confirmation
    // Multi-select (np.p2.multiselect).
    in-out property <bool> photos-selecting: false;
    in-out property <int> photos-select-count: 0;
    in-out property <bool> photos-can-paste: false;
    // Phase 6 — new properties.
    in-out property <[MemoryRail]> photo-memory-rails: [];
    in-out property <[MapCluster]> photo-map-clusters: [];
    in-out property <[DedupeGroup]> photo-dedupe-groups: [];
    in-out property <bool> photo-dedupe-scanning: false;
    in-out property <bool> photo-slideshow-dialog-open: false;
    in-out property <string> photo-slideshow-status: "";
    in-out property <bool> photo-smart-rule-open: false;
    in-out property <int> photo-smart-rule-album-id: 0;
    in-out property <int> photo-smart-rule-match-count: -1;
    callback set-photos-view-mode(string);
    callback set-photos-category(string);
    callback photos-visible-hint(float); // np.p1.thumbs.lazy scroll fraction
    callback set-photos-sort(string);
    callback set-photos-library-sort(string);
    callback photo-search(string);
    callback photo-folder-open(string);
    callback photo-select(int, string);   // tile-level: "toggle" | "range"
    callback photo-sel-action(string);     // bar: clear|all|star|archive|trash|copy|cut|paste
    callback refresh-library();            // silent background re-scan (post editor save)
    callback photo-person-open(int);       // People tab: open a cluster's photos
    callback photo-person-rename(int, string); // People tab: name a cluster
    callback photo-thing-open(string);     // Things tab: open a tag's photos
    callback photo-album-open(int);        // Albums tab: open an album's photos
    callback photo-album-new();
    callback photo-album-rename(int, string);
    callback photo-album-delete(int);
    callback photo-album-add-open();       // selection → open picker
    callback photo-album-add(int);         // add selection to album id
    callback photo-album-add-new();        // new album from selection
    // Phase 6 — new callbacks.
    callback memories-refresh();
    callback places-refresh();
    callback photo-label(int, string);
    callback stack-toggle(int);
    callback dedupe-scan();
    callback dedupe-keep(int, bool);
    callback dedupe-both(int);
    callback slideshow-export(string);
    callback smart-rule-test(string);
    callback smart-rule-save(int, string);
    // ── Photo editor (np.p2.edit.*) ──
    in-out property <bool> editor-open: false;
    in-out property <image> editor-preview;
    in-out property <image> editor-original;
    in-out property <int> editor-nat-w: 0;
    in-out property <int> editor-nat-h: 0;
    in-out property <bool> editor-busy: false;
    in-out property <int> editor-op-count: 0;
    in-out property <bool> editor-can-undo: false;
    in-out property <bool> editor-can-redo: false;
    in-out property <string> editor-filename: "";
    in-out property <string> editor-active-filter: "";
    in-out property <string> editor-status: "";
    in-out property <float> editor-exposure: 0;
    in-out property <float> editor-contrast: 0;
    in-out property <float> editor-saturation: 0;
    in-out property <float> editor-temperature: 0;
    in-out property <float> editor-highlights: 0;
    in-out property <float> editor-shadows: 0;
    in-out property <image> editor-histogram;     // edited-image histogram (curve backdrop)
    in-out property <string> editor-exif: "";      // read-only full dump
    in-out property <string> editor-exif-artist: "";
    in-out property <string> editor-exif-copyright: "";
    in-out property <string> editor-exif-description: "";
    in-out property <string> editor-exif-comment: "";
    in-out property <string> editor-exif-date: "";
    callback editor-adjust(float, float, float, float, float, float);
    callback editor-curve(string, float, float, float, float, float);
    callback editor-exif-save(string, string, string, string, string);
    callback editor-exif-clear-gps();
    callback editor-filter(string);
    callback editor-transform(string);
    callback editor-enhance();
    callback editor-sharpen(float);
    callback editor-ai-op(string);
    callback editor-undo();
    callback editor-redo();
    callback editor-reset();
    callback editor-export(string, float);
    callback editor-save-original();
    callback editor-crop(float, float, float, float);
    callback editor-resize(int, int);
    callback editor-close();
    callback user-action(string);
    callback theme-changed(ThemeChoice);
    callback pick-folder();
    callback open-photo(int);
    callback play-video(int);
    callback play-music(int);
    callback music-next();
    callback music-prev();
    callback music-stop();
    callback close-viewer();
    callback viewer-edit();        // open the editor on the current viewer photo
    callback viewer-next();
    callback viewer-prev();
    callback dismiss-scan-progress();

    callback api-row-toggle(int);
    callback api-row-edit(int);
    callback api-row-test(int);

    callback lib-add();
    callback lib-rescan-all();
    callback lib-clear-thumb-cache();
    callback lib-reset-app();
    callback lib-rebuild-fts();
    callback lib-row-rescan(int);
    callback lib-row-rethumb(int);
    callback lib-row-edit-exclude(int);
    callback lib-row-remove(int);
    callback lib-row-save-section(int, string);

    callback set-default-cadence(string);
    callback set-cadence-override(string, string);

    out property <Section> active-enum:
        active-section == "videos"   ? Section.videos :
        active-section == "music"    ? Section.music :
        active-section == "books"    ? Section.books :
        active-section == "cloud"    ? Section.cloud :
        active-section == "tools"    ? Section.tools :
        active-section == "settings" ? Section.settings :
                                       Section.photos;

    init => { Accent.section = root.active-enum; }
    changed active-enum => { Accent.section = root.active-enum; }

    // Background orb layer — absolute-positioned behind everything.
    Orbs {
        x: 0; y: 0;
        width: root.width; height: root.height;
    }

    // Ambient screensaver — fades in while idle, click to wake.
    AmbientScreensaver {
        active <=> root.ambient-active;
        clock-text: root.ambient-clock;
        caption: root.ambient-caption;
    }
    changed ambient-active => { if !root.ambient-active { root.ambient-dismissed(); } }

    // Global keyboard shortcuts — Ctrl/Cmd+K opens the palette, ? / F1 opens
    // the shortcut help. Wraps the whole shell; refocused whenever an overlay
    // closes so the accelerators keep working.
    key-scope := FocusScope {
        key-pressed(e) => {
            // Photo viewer fallback — guarantees Esc/arrows work even if the
            // viewer's own FocusScope lost focus after a click interaction.
            if root.viewer-open {
                if e.text == Key.Escape     { root.close-viewer(); return accept; }
                if e.text == Key.LeftArrow  { root.viewer-prev();  return accept; }
                if e.text == Key.RightArrow { root.viewer-next();  return accept; }
                if e.text == " "            { root.viewer-slideshow = !root.viewer-slideshow; return accept; }
            }
            if (e.modifiers.control || e.modifiers.meta) && e.text == "k" {
                root.palette-open = true; return accept;
            }
            if (e.modifiers.control || e.modifiers.meta) && e.text == "j" {
                root.chat-open = true; return accept;
            }
            if e.text == "?" {
                root.shortcuts-open = true; return accept;
            }
            // Music playback shortcuts — arrows seek/volume, space play/pause
            // (np.p4.music.player-keys). Active in Music OR whenever the
            // app-wide mini-player is open on any other section.
            if (root.active-section == "music" || root.music-mini-open) && !root.viewer-open {
                if e.text == Key.LeftArrow  { root.music-seek(Math.max(0, root.music-pos - 5)); return accept; }
                if e.text == Key.RightArrow { root.music-seek(Math.min(root.music-dur, root.music-pos + 5)); return accept; }
                if e.text == Key.UpArrow    { root.music-set-volume(Math.min(130, root.music-volume + 5)); return accept; }
                if e.text == Key.DownArrow  { root.music-set-volume(Math.max(0, root.music-volume - 5)); return accept; }
                if e.text == " "            { root.music-toggle-pause(); return accept; }
            }
            // Escape minimises the open mini-player to its bubble (any mode).
            if root.music-mini-open && !root.music-mini-bubble && e.text == Key.Escape {
                root.music-mini-bubble = true; return accept;
            }
            // Multi-select keyboard (np.p2.multiselect) — photos section only.
            if root.active-section == "photos" {
                if (e.modifiers.control || e.modifiers.meta) && e.text == "a" {
                    root.photo-sel-action("all"); return accept;
                }
                if e.text == Key.Escape && root.photos-selecting {
                    root.photo-sel-action("clear"); return accept;
                }
                if (e.text == Key.Delete || e.text == Key.Backspace) && root.photos-selecting {
                    root.photo-sel-action("trash"); return accept;
                }
            }
            return reject;
        }

    // Foreground app shell.
    HorizontalLayout {
        padding: 14px;
        spacing: 14px;

        Sidebar {
            // Paint above the content surface so the user-card popup (which can
            // overflow the rail, especially when collapsed) is never covered.
            z: 1;
            active-section <=> root.active-section;
            user: root.user;
            user-action(a) => { root.user-action(a); }
            section-changed(s) => { root.section-changed(s); }
        }

        ContentSurface {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            if active-section == "photos":   PhotosPage { width: parent.width; height: parent.height; item-count: root.photos-total; tiles: root.photo-tiles;
                visible-hint(f) => { root.photos-visible-hint(f); }
                groups: root.photo-groups;
                folders: root.photo-folders;
                people: root.photo-people;
                things: root.photo-things;
                albums: root.photo-albums;
                picker-albums: root.album-picker-albums;
                album-picker-open <=> root.album-picker-open;
                filter-title: root.photos-filter-title;
                folder-count: root.photos-folder-count;
                folder-name: root.photos-folder-name;
                sort-mode: root.photos-sort;
                sort-dir: root.photos-sort-dir;
                lib-sort: root.photos-lib-sort;
                lib-sort-dir: root.photos-lib-sort-dir;
                blink-tab: root.photos-blink;
                selecting: root.photos-selecting;
                select-count: root.photos-select-count;
                can-paste: root.photos-can-paste;
                category <=> root.photos-category;
                query <=> root.photos-query;
                add-folder => { root.pick-folder(); }
                tile-open-rect(i, tx, ty, tw, th) => {
                    root.hero-from = { x: tx, y: ty, w: tw, h: th };
                    root.open-photo(i);
                }
                set-category(c) => { root.set-photos-category(c); }
                set-sort(s) => { root.set-photos-sort(s); }
                set-library-sort(s) => { root.set-photos-library-sort(s); }
                search(q) => { root.photo-search(q); }
                folder-open(p) => { root.photo-folder-open(p); }
                person-open(id) => { root.photo-person-open(id); }
                person-rename(id, n) => { root.photo-person-rename(id, n); }
                thing-open(l) => { root.photo-thing-open(l); }
                album-open(id) => { root.photo-album-open(id); }
                album-new => { root.photo-album-new(); }
                album-rename(id, n) => { root.photo-album-rename(id, n); }
                album-delete(id) => { root.photo-album-delete(id); }
                album-add-open => { root.photo-album-add-open(); }
                album-add(id) => { root.photo-album-add(id); }
                album-add-new => { root.photo-album-add-new(); }
                tile-star(i) => { root.photo-context-action(i, "star"); }
                tile-archive(i) => { root.photo-context-action(i, "archive"); }
                tile-context(i, mx, my) => { root.open-context(i, mx, my); }
                tile-select-toggle(i) => { root.photo-select(i, "toggle"); }
                tile-select-range(i) => { root.photo-select(i, "range"); }
                sel-clear => { root.photo-sel-action("clear"); }
                sel-all => { root.photo-sel-action("all"); }
                sel-star => { root.photo-sel-action("star"); }
                sel-archive => { root.photo-sel-action("archive"); }
                sel-trash => { root.photo-sel-action("trash"); }
                sel-copy => { root.photo-sel-action("copy"); }
                sel-cut => { root.photo-sel-action("cut"); }
                sel-paste => { root.photo-sel-action("paste"); }
                memory-rails: root.photo-memory-rails;
                map-clusters: root.photo-map-clusters;
                dedupe-groups: root.photo-dedupe-groups;
                dedupe-scanning <=> root.photo-dedupe-scanning;
                slideshow-dialog-open <=> root.photo-slideshow-dialog-open;
                slideshow-status: root.photo-slideshow-status;
                smart-rule-open <=> root.photo-smart-rule-open;
                smart-rule-album-id <=> root.photo-smart-rule-album-id;
                smart-rule-match-count: root.photo-smart-rule-match-count;
                memories-refresh => { root.memories-refresh(); }
                places-refresh => { root.places-refresh(); }
                photo-label(i, l) => { root.photo-label(i, l); }
                stack-toggle(i) => { root.stack-toggle(i); }
                dedupe-scan => { root.dedupe-scan(); }
                dedupe-keep(cid, kl) => { root.dedupe-keep(cid, kl); }
                dedupe-both(cid) => { root.dedupe-both(cid); }
                slideshow-export(p) => { root.slideshow-export(p); }
                smart-rule-test(j) => { root.smart-rule-test(j); }
                smart-rule-save(aid, j) => { root.smart-rule-save(aid, j); } }
            if active-section == "videos":   VideosPage { width: parent.width; height: parent.height; item-count: root.video-tiles.length; tiles: root.video-tiles;
                category <=> root.video-category;
                kind <=> root.video-kind;
                query <=> root.video-query;
                shows: root.video-shows;
                next-up: root.video-next-up;
                seasons: root.video-seasons;
                show-open: root.video-show-open;
                show-title: root.video-show-title;
                add-folder => { root.pick-folder(); }
                tile-clicked(i) => { root.play-video(i); }
                tile-context(i, mx, my) => { root.open-video-context(i, mx, my); }
                set-category(c) => { root.set-video-category(c); }
                set-kind(k) => { root.set-video-kind(k); }
                search(q) => { root.video-search(q); }
                show-open-id(id) => { root.video-show-drill(id); }
                show-back => { root.video-show-back(); }
                clear-thumbs => { root.video-clear-thumbs(); }
                discover-trending-movies: root.video-discover-movies;
                discover-trending-shows: root.video-discover-shows;
                discover-upcoming: root.video-discover-upcoming;
                discover-on-air: root.video-discover-on-air;
                refresh-discover => { root.video-refresh-discover(); } }
            if active-section == "music":    MusicPage  { width: parent.width; height: parent.height; item-count: root.music-song-total; tiles: root.music-tracks-grid;
                np-title: root.music-np-title; np-sub: root.music-np-sub; np-art: root.music-np-art; playing: root.music-playing;
                player-mode: root.music-player-mode;
                view <=> root.music-view; sleep-min: root.music-sleep-min;
                lib-tab <=> root.music-lib-tab;
                recent: root.music-recent; most: root.music-most; loved-tiles: root.music-loved;
                fresh: root.music-fresh; albums: root.music-albums; artists: root.music-artists; genres: root.music-genres;
                top-artists: root.music-top-artists; top-albums: root.music-top-albums;
                folders: root.music-folders; playlists: root.music-playlists; recent-rows: root.music-recent-rows;
                recent-page: root.music-recent-page; recent-pages: root.music-recent-pages;
                browse-sort <=> root.music-browse-sort; browse-dir <=> root.music-browse-dir; shuffle: root.music-shuffle;
                browse-page: root.music-browse-page; browse-pages: root.music-browse-pages; set-browse-page(d) => { root.music-set-browse-page(d); }
                set-recent-page(d) => { root.music-set-recent-page(d); } set-browse-sort(s) => { root.music-set-browse-sort(s); }
                toggle-shuffle => { root.music-toggle-shuffle(); }
                songs-view <=> root.music-songs-view; set-songs-view(v) => { root.music-set-songs-view(v); }
                grid-density <=> root.music-grid-density; set-grid-density(v) => { root.music-set-grid-density(v); }
                np-loved: root.music-np-loved; np-stars: root.music-np-stars;
                pos: root.music-pos; dur: root.music-dur; pos-label: root.music-pos-label; dur-label: root.music-dur-label;
                volume: root.music-volume; muted: root.music-muted; repeat: root.music-repeat;
                player-panel <=> root.music-player-panel; queue-rows: root.music-queue-rows;
                lyrics-text: root.music-lyrics-text; eq-preset: root.music-eq-preset;
                seek(s) => { root.music-seek(s); } set-volume(v) => { root.music-set-volume(v); }
                toggle-mute => { root.music-toggle-mute(); } cycle-repeat => { root.music-cycle-repeat(); }
                toggle-panel(p) => { root.music-toggle-panel(p); } set-eq(e) => { root.music-set-eq(e); }
                play-queue(i) => { root.music-play-queue(i); } add-to-playlist => { root.music-add-to-playlist(); }
                eq-bands: root.music-eq-bands; set-eq-band(i, v) => { root.music-set-eq-band(i, v); }
                eq-custom-names: root.music-eq-custom-names; eq-save-profile => { root.music-eq-save-profile(); } eq-load-profile(n) => { root.music-eq-load-profile(n); } eq-delete-profile(n) => { root.music-eq-delete-profile(n); }
                songs: root.music-songs; songs-ex: root.music-songs-ex;
                row-fav(i) => { root.music-row-fav(i); } row-rate(i, n) => { root.music-row-rate(i, n); } row-find-lyrics(i) => { root.music-row-find-lyrics(i); }
                row-view-lyrics(i) => { root.music-row-view-lyrics(i); }
                song-play-default(i) => { root.music-song-play-default(i); } song-view-album(i) => { root.music-album-open(i); }
                song-view-artist(i) => { root.music-artist-open(i); } song-properties(i) => { root.music-song-properties(i); }
                song-edit-media(i) => { root.music-song-edit-media(i); }
                song-delete(i) => { root.music-song-delete(i); }
                song-props-open <=> root.music-song-props-open; props-pos <=> root.music-props-pos; props-title: root.music-props-title; props-artist: root.music-props-artist;
                props-album: root.music-props-album; props-genre: root.music-props-genre; props-duration: root.music-props-duration;
                props-release: root.music-props-release; props-credits: root.music-props-credits;
                props-path: root.music-props-path; props-format: root.music-props-format; props-size: root.music-props-size;
                sync-all-lyrics => { root.music-sync-all-lyrics(); } lyrics-sync-status: root.music-lyrics-sync-status; lyrics-sync-progress: root.music-lyrics-sync-progress;
                lyrics-mgr-open <=> root.music-lyrics-mgr-open; lyrics-mgr-total: root.music-lyrics-mgr-total;
                lyrics-mgr-synced: root.music-lyrics-mgr-synced; lyrics-mgr-missing: root.music-lyrics-mgr-missing;
                lyrics-mgr-page: root.music-lyrics-mgr-page; lyrics-mgr-pages: root.music-lyrics-mgr-pages; lyrics-mgr-rows: root.music-lyrics-mgr-rows;
