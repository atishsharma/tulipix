        init => { key-scope.focus(); }
        // Re-grab key focus whenever the section changes so playback shortcuts
        // work across the whole Music page without first clicking the player.
        property <string> watch-section: root.active-section;
        changed watch-section => { key-scope.focus(); }
        // Also re-grab focus when the mini-player opens so its transport keys
        // (space/arrows) work even on non-music sections.
        property <bool> watch-mini: root.music-mini-open;
        changed watch-mini => { if (root.music-mini-open) { key-scope.focus(); } }
    }

    // Right-click context menu for photo tiles. Declared after the shell so it
    // paints on top of the photo grid (Slint z-order = declaration order).
    ContextMenu {
        open <=> root.ctx-open;
        menu-x: root.ctx-x;
        menu-y: root.ctx-y;
        items: root.ctx-items;
        chosen(id) => { root.photo-context-action(root.ctx-index, id); }
    }

    // Right-click context menu for video posters (np.p3 library actions).
    ContextMenu {
        open <=> root.vctx-open;
        menu-x: root.vctx-x;
        menu-y: root.vctx-y;
        items: root.vctx-items;
        chosen(id) => { root.video-context-action(root.vctx-index, id); }
    }

    // Embedded media player (np.p3.player.*) — top of the z-stack.
    PlayerOverlay {
        width: 100%; height: 100%;
        open: root.player-open;
        frame: root.player-frame;
        title: root.player-title;
        pos: root.player-pos;
        duration: root.player-duration;
        pos-label: root.player-pos-label;
        dur-label: root.player-dur-label;
        paused: root.player-paused;
        volume: root.player-volume;
        muted: root.player-muted;
        speed: root.player-speed;
        buffering: root.player-buffering;
        hwdec: root.player-hwdec;
        audio-tracks: root.player-audio-tracks;
        sub-tracks: root.player-sub-tracks;
        chapters: root.player-chapters;
        toggle-pause => { root.player-toggle-pause(); }
        seek(s) => { root.player-seek(s); }
        seek-rel(s) => { root.player-seek-rel(s); }
        set-volume(v) => { root.player-set-volume(v); }
        toggle-mute => { root.player-toggle-mute(); }
        set-speed(s) => { root.player-set-speed(s); }
        set-audio(i) => { root.player-set-audio(i); }
        set-sub(i) => { root.player-set-sub(i); }
                load-sub => { root.player-load-sub(); }
        set-chapter(i) => { root.player-set-chapter(i); }
        close => { root.player-close(); }
        key(k, sh) => { root.player-key(k, sh); }
        toggle-fullscreen => { root.player-toggle-fullscreen(); }
    }

    // Full-screen music player page (above all sections).
    if root.music-fullscreen: MusicFullscreen {
        width: 100%; height: 100%;
        art: root.music-np-art; accent: root.music-np-accent; title: root.music-np-title; sub: root.music-np-sub; playing: root.music-playing;
        pos: root.music-pos; dur: root.music-dur; pos-label: root.music-pos-label; dur-label: root.music-dur-label;
        volume: root.music-volume; muted: root.music-muted; repeat: root.music-repeat; shuffle: root.music-shuffle;
        np-loved: root.music-np-loved; np-stars: root.music-np-stars;
        album: root.music-np-album; vis-bars: root.music-vis-bars; vis-style <=> root.music-vis-style; vis-style-changed(s) => { root.music-set-vis-style(s); }
        queue-rows: root.music-queue-rows; lyrics-rows: root.music-lyrics-rows; lyrics-active: root.music-lyrics-active;
        podcast-mode: root.music-player-mode == "podcast"; speed: root.music-podcast-speed; set-speed(v) => { root.music-podcast-set-speed(v); }
        yt-now-video: root.music-yt-now-video; watch-video() => { root.music-yt-watch-current(); }
        tab <=> root.music-fs-tab;
        // Long-form modes (radio / podcast / audiobook) reopen their mini on
        // close — it's the only player those sections have.
        close => { root.music-fullscreen = false; root.music-exit-zen();
            if (root.music-player-mode != "music") { root.music-center-mini(); } }
        // Lyrics auto-open only makes sense for library tracks.
        init => { root.music-enter-zen(); self.zen-lyrics = root.music-player-mode == "music"; }
        playpause => { root.music-toggle-pause(); }
        next => { root.music-next(); } prev => { root.music-prev(); }
        seek(s) => { root.music-seek(s); } set-volume(v) => { root.music-set-volume(v); }
        toggle-mute => { root.music-toggle-mute(); } cycle-repeat => { root.music-cycle-repeat(); }
        toggle-shuffle => { root.music-toggle-shuffle(); }
        play-queue(i) => { root.music-play-queue(i); } love => { root.music-love(); } rate(n) => { root.music-rate(n); }
        open-now-album => { root.music-open-now-album(); } open-now-artist => { root.music-open-now-artist(); }
    }

    // App-wide draggable mini-player (over every section).
    if root.music-mini-open && !root.music-mini-bubble: Rectangle {
        x: root.music-mini-x; y: root.music-mini-y;
        width: root.music-mini-w; height: root.music-mini-h;
        dragmini := TouchArea {
            mouse-cursor: move;
            moved => {
                if (self.pressed) {
                    root.music-mini-x = Math.clamp(root.music-mini-x + (self.mouse-x - self.pressed-x), 0px, root.width - parent.width);
                    root.music-mini-y = Math.clamp(root.music-mini-y + (self.mouse-y - self.pressed-y), 0px, root.height - parent.height);
                }
            }
        }
        // Music mode — full music mini player (vinyl / queue / lyrics).
        if root.music-player-mode != "podcast": MusicMini {
            width: 100%; height: 100%;
            bold-outline: root.music-mini-outline;
            uiscale: root.music-mini-scale;
            art: root.music-np-art; accent: root.music-np-accent; title: root.music-np-title; sub: root.music-np-sub; album: root.music-np-album; playing: root.music-playing;
            pos: root.music-pos; dur: root.music-dur; pos-label: root.music-pos-label; dur-label: root.music-dur-label;
            shuffle: root.music-shuffle; volume: root.music-volume; muted: root.music-muted; repeat: root.music-repeat;
            queue-rows: root.music-queue-rows; lyrics-rows: root.music-lyrics-rows; lyrics-active: root.music-lyrics-active;
            radio-mode: root.music-player-mode == "radio"; radio-initial: root.music-radio-np-initial;
            book-mode: root.music-player-mode == "book";
            yt-now-video: root.music-yt-now-video; watch-video => { root.music-yt-watch-current(); }
            open-zen => { root.music-mini-open = false; root.music-fullscreen = true; }
            cycle-repeat => { root.music-cycle-repeat(); }
            close => { root.music-mini-open = false; }
            minimise => { root.music-mini-bubble = true; }
            playpause => { root.music-toggle-pause(); }
            next => { root.music-next(); } prev => { root.music-prev(); }
            seek(s) => { root.music-seek(s); } set-volume(v) => { root.music-set-volume(v); }
            toggle-mute => { root.music-toggle-mute(); } toggle-shuffle => { root.music-toggle-shuffle(); } play-queue(i) => { root.music-play-queue(i); }
        }
        // Podcast mode — spoken-word tuned player (-15s / +30s / speed / notes).
        if root.music-player-mode == "podcast": PodcastMini {
            width: 100%; height: 100%;
            bold-outline: root.music-mini-outline;
            uiscale: root.music-mini-scale;
            art: root.music-np-art; accent: root.music-np-accent; title: root.music-np-title; sub: root.music-np-sub; playing: root.music-playing;
            pos: root.music-pos; dur: root.music-dur; pos-label: root.music-pos-label; dur-label: root.music-dur-label;
            speed: root.music-podcast-speed; episodes: root.music-podcast-d-episodes; summary: root.music-podcast-d-desc;
            volume: root.music-volume; muted: root.music-muted;
            open-zen => { root.music-mini-open = false; root.music-fullscreen = true; }
            close => { root.music-mini-open = false; }
            minimise => { root.music-mini-bubble = true; }
            playpause => { root.music-toggle-pause(); }
            skip(s) => { root.music-podcast-skip(s); }
            seek(s) => { root.music-seek(s); }
            set-speed(v) => { root.music-podcast-set-speed(v); }
            set-volume(v) => { root.music-set-volume(v); }
            toggle-mute => { root.music-toggle-mute(); }
            play-episode(id) => { root.music-podcast-play(id); }
        }
        // Resize handles — drag either bottom corner; uniform scale keeps the
        // aspect ratio (100%–300%). A curved arc shows on hover.
        // Bottom-right.
        Rectangle { width: 24px; height: 24px; x: parent.width - self.width; y: parent.height - self.height;
            Rectangle { width: 16px; height: 16px; border-radius: 8px; x: 2px; y: 2px;
                background: transparent; border-width: 2px;
                border-color: brh.has-hover || brh.pressed ? root.music-np-accent : #ffffff55; }
            brh := TouchArea { mouse-cursor: nwse-resize;
                moved => { if (self.pressed) {
                    root.music-mini-scale = Math.clamp(root.music-mini-scale + (self.mouse-x - self.pressed-x) / 300px, 1.0, 3.0);
                } } } }
    }
    // Minimised bubble — pinned to the right edge (Android-style). Drag up/down
    // to reposition; tap to restore the full mini-player.
    if root.music-mini-open && root.music-mini-bubble: Rectangle {
        x: root.width - 78px;
        y: root.music-bubble-y < 0px ? root.height / 2 - 30px : root.music-bubble-y;
        width: 60px; height: 60px;
        // Pulsing accent ring (animated, not clipped).
        Rectangle { width: 60px; height: 60px; border-radius: 30px; background: transparent;
            border-width: 3px; border-color: root.music-np-accent;
            opacity: 0.45 + 0.55 * Math.abs(Math.sin((animation-tick() / 1ms / 280) * 1rad)); }
        // Clipped circular art — spins like a record while playing.
        Rectangle { width: 56px; height: 56px; border-radius: 28px; clip: true; x: 2px; y: 2px;
            background: #14141b; drop-shadow-blur: 26px; drop-shadow-color: root.music-np-accent;
            // Radio with no favicon — letter tile in the bubble too.
            if root.music-player-mode == "radio" && root.music-np-art.width == 0: Rectangle {
                background: @linear-gradient(135deg, #14b8a6, #0ea5e9);
                Text { text: root.music-radio-np-initial; color: #ffffffd0; font-size: 22px; font-weight: 800;
                    horizontal-alignment: center; vertical-alignment: center; } }
            Image { source: root.music-np-art; image-fit: cover; width: 100%; height: 100%; opacity: 0.9;
                transform-rotation: root.music-playing ? Math.mod(animation-tick() / 1ms / 14, 360) * 1deg : 0deg; }
            if root.music-np-title == "": AppIcon { source: Icons.music; tint: #ec4899; width: 24px; height: 24px; } }
        // Center spindle dot — the record-player hub.
        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #14141b; border-width: 1.5px; border-color: #ffffffcc;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        bta := TouchArea {
            mouse-cursor: pointer;
            property <bool> dragged: false;
            moved => {
                if (self.pressed) {
                    root.music-bubble-y = Math.clamp((root.music-bubble-y < 0px ? root.height / 2 - 30px : root.music-bubble-y)
                        + (self.mouse-y - self.pressed-y), 8px, root.height - 68px);
                    self.dragged = true;
                }
            }
            pointer-event(e) => { if (e.kind == PointerEventKind.down) { self.dragged = false; } }
            clicked => { if (!self.dragged) { root.music-mini-bubble = false; } }
        }
    }

    // Book reader overlay (np.p4.books.reader) — full window above content.
    BookReader {
        width: 100%; height: 100%;
        open: root.book-reader-open;
        title: root.book-reader-title;
        kind: root.book-reader-kind;
        page-label: root.book-page-label;
        progress: root.book-progress;
        page-left: root.book-page-left;
        page-right: root.book-page-right;
        has-right: root.book-has-right;
        spread-double: root.book-spread-double;
        rtl: root.book-rtl;
        invert: root.book-invert;
        text: root.book-text;
        text-right: root.book-text-right;
        text-prev: root.book-text-prev;
        text-prev-right: root.book-text-prev-right;
        two-page <=> root.book-two-page;
        two-up-active <=> root.book-two-up-active;
        font-px: root.book-font-px;
        font-family: root.book-font-family;
        page-index: root.book-page-index;
        page-total: root.book-page-total;
        turn: root.book-turn;
        turn-dir: root.book-turn-dir;
        comic-thumbs: root.book-comic-thumbs;
        text-dark <=> root.book-text-dark;
        set-line(l) => { root.book-set-line(l); }
        set-margin(m) => { root.book-set-margin(m); }
        reflow(w, h) => { root.book-reflow(w, h); }
        close => { root.book-reader-close(); }
        next => { root.book-next(); }
        prev => { root.book-prev(); }
        scrub(f) => { root.book-scrub(f); }
        toggle-spread => { root.book-toggle-spread(); }
        toggle-rtl => { root.book-toggle-rtl(); }
        toggle-invert => { root.book-toggle-invert(); }
        set-font(p) => { root.book-set-font(p); }
        set-family(i) => { root.book-set-family(i); }
        toggle-text-dark => { root.book-toggle-text-dark(); }
        toc-entries: root.book-toc-entries;
        reader-bookmarks: root.book-bookmarks;
        toc-open <=> root.book-toc-open;
        bookmarks-open <=> root.book-bookmarks-open;
        read-mode: root.book-read-mode;
        theme: root.book-theme;
        line-height-val: root.book-line-height-val;
        margin-pct: root.book-margin-pct;
        toggle-toc => { root.book-toggle-toc(); }
        jump-to-chapter(i) => { root.book-jump-chapter(i); }
        toggle-bookmarks => { root.book-toggle-bookmarks(); }
        add-bookmark => { root.book-add-bookmark(); }
        jump-to-bookmark(p) => { root.book-jump-bookmark(p); }
        toggle-read-mode => { root.book-toggle-read-mode(); }
        set-theme(t) => { root.book-set-theme(t); }
        tts-start => { root.book-tts-start(); }
        tts-stop => { root.book-tts-stop(); }
        tts-sentence: root.book-tts-sentence;
        bm-color <=> root.book-bm-color;
        find-text(s) => { root.book-find-text(s); }
        guided: root.book-guided;
        define-result: root.book-define-result;
        toggle-guided => { root.book-toggle-guided(); }
        define(s) => { root.book-define(s); }
    }

    // Scan progress floating card — bottom-right corner, visible while a
    // scan is in flight OR a scan finished with at least one failure (so the
    // user can read what went wrong before dismissing).
    if root.scan-active || root.scan-progress.length > 0: Rectangle {
        x: root.width - 380px;
        y: root.height - 280px;
        width: 360px;
        height: 260px;
        ScanProgressCard {
            x: 0; y: 0; width: 360px; height: 260px;
            rows: root.scan-progress;
            visible-flag: true;
            dismissed => { root.dismiss-scan-progress(); }
        }
    }

    // Photo viewer modal. Click anywhere on the dim backdrop or hit Escape
    // (via the close button) to dismiss.
    if root.viewer-open: Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        background: #000000.with-alpha(0.92);

        // Estimated fit-to-window scale, computed from the *window* size minus
        // the fixed chrome (padding 32 ×2, spacing 14 ×2, header ~28, controls
        // 48). Window dims are fixed inputs, so this can't form a layout binding
        // loop the way reading the live stage size would. The 1:1 button reads
        // the real stage size in its click handler (handlers are loop-free).
        property <length> stage-w-est: root.width - 64px;
        property <length> stage-h-est: root.height - 168px;
        property <float> fit-scale: min(
            (stage-w-est / 1px) / max(1, root.viewer-nat-w),
            (stage-h-est / 1px) / max(1, root.viewer-nat-h));
        property <float> true-scale: root.viewer-zoom * fit-scale;

        // Backdrop — click empty area to dismiss.
        TouchArea { clicked => { root.close-viewer(); } }

        // Slideshow auto-advance — interval follows viewer-slideshow-secs.
        viewer-timer := Timer {
            interval: root.viewer-slideshow-secs * 1s;
            running: root.viewer-slideshow && root.viewer-open;
            triggered => { root.viewer-next(); }
        }

        // One-shot: after the instant reset, ramp viewer-anim-t 0→1 so the
        // new slide animates in with the selected transition.
        anim-kick := Timer {
            interval: 16ms;
            running: root.viewer-anim-kick;
            triggered => {
                root.viewer-anim-kick = false;
                root.viewer-anim-dur = 650ms;
                root.viewer-anim-t = 1.0;
            }
        }

        // Keyboard: ← / → nav, space slideshow, +/-/0 zoom, i info, s shuffle.
        viewer-keys := FocusScope {
            key-pressed(e) => {
                if e.text == Key.LeftArrow  { root.viewer-prev(); return accept; }
                if e.text == Key.RightArrow { root.viewer-next(); return accept; }
                if e.text == Key.Escape     { root.close-viewer(); return accept; }
                if e.text == " "            { root.viewer-slideshow = !root.viewer-slideshow; return accept; }
                if e.text == "+" || e.text == "=" { root.viewer-zoom = min(6.0, root.viewer-zoom + 0.25); return accept; }
                if e.text == "-"            { root.viewer-zoom = max(0.1, root.viewer-zoom - 0.25); return accept; }
                if e.text == "0"            { root.viewer-zoom = 1.0; return accept; }
                if e.text == "i"            { root.viewer-info-open = !root.viewer-info-open; return accept; }
                if e.text == "s"            { root.viewer-shuffle = !root.viewer-shuffle; return accept; }
                return reject;
            }
        }

        VerticalLayout {
            // Collapse padding during slideshow so the photo fills the screen.
            padding: root.viewer-slideshow ? 0px : 32px;
            spacing: root.viewer-slideshow ? 0px : 14px;

            // Header — hidden during slideshow for an immersive full-screen view.
            if !root.viewer-slideshow: HorizontalLayout {
                alignment: center; spacing: 12px;
                Text {
                    text: root.viewer-label;
                    color: white; font-size: 14px; font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 1px; height: 14px; background: white.with-alpha(0.30);
                    horizontal-stretch: 0; vertical-stretch: 0;
                }
                Text {
                    text: (root.viewer-index + 1) + " / " + root.viewer-total;
                    color: white.with-alpha(0.66); font-size: 13px;
                    vertical-alignment: center;
                }
            }

            // Zoom + pan stage. Scroll wheel zooms (10%–600%); drag pans when
            // zoomed past 100%. Click during a slideshow stops it.
            stage := Rectangle {
                horizontal-stretch: 1; vertical-stretch: 1;
                clip: true;
                property <length> pan-x: 0;
                property <length> pan-y: 0;
                property <length> down-pan-x: 0;
                property <length> down-pan-y: 0;
                // Mirror zoom so a change (incl. reset on photo nav) recenters.
                property <float> zoom-mirror: root.viewer-zoom;
                changed zoom-mirror => { if self.zoom-mirror <= 1.0 { self.pan-x = 0; self.pan-y = 0; } }

                if !root.viewer-slideshow: Image {
                    source: root.viewer-image;
                    image-fit: contain;
                    width: stage.width * root.viewer-zoom;
                    height: stage.height * root.viewer-zoom;
                    x: (stage.width - self.width) / 2 + stage.pan-x;
                    y: (stage.height - self.height) / 2 + stage.pan-y;
                }

                // Slideshow layer: replays the selected enter transition each
                // slide via viewer-anim-t (0→1). fx resolves "random" upstream.
                if root.viewer-slideshow: Image {
                    property <string> fx: root.viewer-anim-eff;
                    property <float> t: root.viewer-anim-t;
                    property <float> sc: fx == "zoomin"  ? (0.90 + 0.10 * t)
                                       : fx == "zoomout" ? (1.12 - 0.12 * t) : 1.0;
                    property <length> dx: fx == "slide" ? (1px * (1.0 - t) * 90) : 0px;
                    source: root.viewer-image;
                    image-fit: contain;
                    opacity: (fx == "zoomin" || fx == "zoomout") ? (0.5 + 0.5 * t) : t;
                    width: stage.width * sc;
                    height: stage.height * sc;
                    x: (stage.width - self.width) / 2 + dx;
                    y: (stage.height - self.height) / 2;
                }

                stage-touch := TouchArea {
                    mouse-cursor: root.viewer-zoom > 1.0 ? MouseCursor.grab : MouseCursor.default;
                    clicked => { if root.viewer-slideshow { root.viewer-slideshow = false; } }
                    scroll-event(e) => {
                        root.viewer-zoom = max(0.1, min(6.0,
                            root.viewer-zoom + (e.delta-y > 0 ? 0.25 : -0.25)));
                        if root.viewer-zoom <= 1.0 { stage.pan-x = 0; stage.pan-y = 0; }
                        return accept;
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            stage.down-pan-x = stage.pan-x;
                            stage.down-pan-y = stage.pan-y;
                        }
                    }
                    moved => {
                        if root.viewer-zoom > 1.0 {
                            stage.pan-x = stage.down-pan-x + (self.mouse-x - self.pressed-x);
                            stage.pan-y = stage.down-pan-y + (self.mouse-y - self.pressed-y);
                        }
                    }
                }
            }

            // Control bar — hidden during the immersive slideshow. Fixed height
            // so the zoom-% label (which reads stage size) can't feed back into
            // the layout that sizes the stage (binding-loop break).
            if !root.viewer-slideshow: HorizontalLayout {
                height: 48px;
                alignment: center; spacing: 8px;
                // Zoom group. % is the true on-screen scale; clicking it fits.
                ViewerMini { label: "-"; clicked => { root.viewer-zoom = max(0.1, root.viewer-zoom - 0.25); if root.viewer-zoom <= 1.0 { stage.pan-x = 0; stage.pan-y = 0; } } }
                ViewerMini { label: Math.round(true-scale * 100) + "%";
                    clicked => { root.viewer-zoom = 1.0; stage.pan-x = 0; stage.pan-y = 0; } }
                ViewerMini { label: "+"; clicked => { root.viewer-zoom = min(6.0, root.viewer-zoom + 0.25); } }
                // 1:1 — jump to true 100% (native px). Reads the real stage
                // size here (in a handler, so no binding loop).
                ViewerMini { label: "1:1"; active: Math.abs(true-scale - 1.0) < 0.02;
                    clicked => {
                        root.viewer-zoom = 1.0 / max(0.001, min(
                            (stage.width / 1px) / max(1, root.viewer-nat-w),
                            (stage.height / 1px) / max(1, root.viewer-nat-h)));
                        stage.pan-x = 0; stage.pan-y = 0;
                    } }
                ViewerMini { label: "Fit"; active: Math.abs(root.viewer-zoom - 1.0) < 0.01;
                    clicked => { root.viewer-zoom = 1.0; stage.pan-x = 0; stage.pan-y = 0; } }

                // Prev / Next — kept adjacent.
                ViewerButton { icon: Icons.chevron-left; label: "Prev"; clicked => { root.viewer-prev(); } }
                ViewerButton { icon: Icons.chevron-right; label: "Next"; clicked => { root.viewer-next(); } }

                // Slideshow: first click reveals the interval + shuffle setup;
                // the button then becomes "Start".
                if !root.viewer-slideshow-setup: ViewerButton {
                    icon: Icons.play; label: "Slideshow"; primary: true;
                    clicked => { root.viewer-slideshow-setup = true; root.slideshow-arm(); }
                }
                if root.viewer-slideshow-setup: ViewerMini {
                    icon: Icons.minus; clicked => { root.viewer-slideshow-secs = max(1, root.viewer-slideshow-secs - 1); root.slideshow-arm(); }
                }
                if root.viewer-slideshow-setup: ViewerMini {
                    icon: Icons.timer; label: "" + root.viewer-slideshow-secs + "s";
                }
                if root.viewer-slideshow-setup: ViewerMini {
                    icon: Icons.plus; clicked => { root.viewer-slideshow-secs = min(10, root.viewer-slideshow-secs + 1); root.slideshow-arm(); }
                }
                if root.viewer-slideshow-setup: ViewerMini {
                    icon: Icons.shuffle; label: "Shuffle"; active: root.viewer-shuffle;
                    clicked => { root.viewer-shuffle = !root.viewer-shuffle; root.slideshow-arm(); }
                }
                // Transition selector — cycles the six effects.
                if root.viewer-slideshow-setup: ViewerMini {
                    icon: Icons.film; label: "" + (root.viewer-anim == "fade"     ? "Fade"
                                  : root.viewer-anim == "zoomin"   ? "Zoom In"
                                  : root.viewer-anim == "zoomout"  ? "Zoom Out"
                                  : root.viewer-anim == "slide"    ? "Slide"
                                  : root.viewer-anim == "dissolve" ? "Dissolve"
                                  : "Random");
                    clicked => {
                        root.viewer-anim =
                              root.viewer-anim == "fade"     ? "zoomin"
                            : root.viewer-anim == "zoomin"   ? "zoomout"
                            : root.viewer-anim == "zoomout"  ? "slide"
                            : root.viewer-anim == "slide"    ? "dissolve"
                            : root.viewer-anim == "dissolve" ? "random"
                            : "fade";
                        root.slideshow-arm();
                    }
                }
                if root.viewer-slideshow-setup: ViewerButton {
                    label: "Start"; primary: true;
                    clicked => { root.viewer-slideshow-setup = false; root.viewer-slideshow = true; }
                }
                if root.viewer-slideshow-setup: ViewerButton {
                    label: "Cancel"; clicked => { root.viewer-slideshow-setup = false; }
                }

                ViewerButton { icon: Icons.pencil; label: "Edit"; primary: true; clicked => { root.viewer-edit(); } }
            }
        }

        // EXIF / metadata panel (toggle with ⓘ or "i") — right side. Its own
        // TouchArea blocks click-through to the backdrop so it closes cleanly.
        if root.viewer-info-open && !root.viewer-slideshow: Rectangle {
            x: parent.width - self.width - 24px;
            y: 80px;
            width: 340px;
            height: parent.height - 200px;
            border-radius: Theme.radius-lg;
            background: #0b0d1cf2;
            border-width: 1px; border-color: white.with-alpha(0.16);
            TouchArea { }  // swallow clicks so they don't reach the backdrop
            VerticalLayout {
                padding: 18px; spacing: 10px;
                HorizontalLayout {
                    Text { text: "Photo info"; color: white; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle {
                        width: 26px; height: 26px; border-radius: 13px;
                        horizontal-stretch: 0; vertical-stretch: 0;
                        background: closex.has-hover ? white.with-alpha(0.18) : white.with-alpha(0.08);
                        closex := TouchArea { mouse-cursor: pointer; clicked => { root.viewer-info-open = false; } }
                        AppIcon { source: Icons.x; tint: white; width: 13px; height: 13px; }
                    }
                }
                Rectangle { height: 1px; background: white.with-alpha(0.15); }
                Flickable {
                    vertical-stretch: 1;
                    viewport-height: exif-text.preferred-height;
                    exif-text := Text {
                        width: parent.width;
                        text: root.viewer-exif == "" ? "No metadata." : root.viewer-exif;
                        color: white.with-alpha(0.85); font-size: 11px;
                        font-family: "monospace"; wrap: word-wrap;
                    }
                }
                // Histogram — RGB distribution, rendered by Rust into an image.
                Rectangle { height: 1px; background: white.with-alpha(0.15); }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Histogram"; color: white.with-alpha(0.75); font-size: 11px; font-weight: 600;
                        vertical-alignment: center; horizontal-stretch: 1; }
                    HorizontalLayout { alignment: center; spacing: 6px; VerticalLayout { alignment: center; AppIcon { source: Icons.circle-dot; tint: #ff5252; width: 9px; height: 9px; } } Text { text: "R"; color: #ff5252; font-size: 9px; vertical-alignment: center; } }
                    HorizontalLayout { alignment: center; spacing: 6px; VerticalLayout { alignment: center; AppIcon { source: Icons.circle-dot; tint: #4caf50; width: 9px; height: 9px; } } Text { text: "G"; color: #4caf50; font-size: 9px; vertical-alignment: center; } }
                    HorizontalLayout { alignment: center; spacing: 6px; VerticalLayout { alignment: center; AppIcon { source: Icons.circle-dot; tint: #5c9dff; width: 9px; height: 9px; } } Text { text: "B"; color: #5c9dff; font-size: 9px; vertical-alignment: center; } }
                }
                Rectangle {
                    height: 96px; horizontal-stretch: 1;
                    border-radius: Theme.radius-sm;
                    background: #00000066;
                    clip: true;
                    Image {
                        source: root.viewer-histogram;
                        image-fit: fill;
                        width: parent.width; height: parent.height;
                    }
                    Rectangle { x: parent.width / 3; width: 1px; height: parent.height; background: white.with-alpha(0.10); }
                    Rectangle { x: 2 * parent.width / 3; width: 1px; height: parent.height; background: white.with-alpha(0.10); }
                }
                // X-axis tonal regions: left = dark pixels, right = bright.
                HorizontalLayout {
                    Text { text: "Shadows"; color: white.with-alpha(0.55); font-size: 9px; horizontal-alignment: left; horizontal-stretch: 1; }
                    Text { text: "Midtones"; color: white.with-alpha(0.55); font-size: 9px; horizontal-alignment: center; horizontal-stretch: 1; }
                    Text { text: "Highlights"; color: white.with-alpha(0.55); font-size: 9px; horizontal-alignment: right; horizontal-stretch: 1; }
                }
            }
        }

        // Large edge tap-targets for prev / next — hidden during slideshow.
        if !root.viewer-slideshow: Rectangle {
            x: 0; y: 0; width: 80px; height: parent.height;
            AppIcon { source: Icons.chevron-left; tint: white.with-alpha(left-touch.has-hover ? 0.95 : 0.45); width: 40px; height: 40px; x: 20px; y: (parent.height - self.height) / 2; }
            left-touch := TouchArea { mouse-cursor: pointer; clicked => { root.viewer-prev(); } }
        }
        // Right edge next-tapper — suppressed while the info panel is open so
        // it can't sit on top of (and swallow clicks meant for) the panel.
        if !root.viewer-slideshow && !root.viewer-info-open: Rectangle {
            x: parent.width - 80px; y: 0; width: 80px; height: parent.height;
            AppIcon { source: Icons.chevron-right; tint: white.with-alpha(right-touch.has-hover ? 0.95 : 0.45); width: 40px; height: 40px; x: 20px; y: (parent.height - self.height) / 2; }
            right-touch := TouchArea { mouse-cursor: pointer; clicked => { root.viewer-next(); } }
        }

        // EXIF / info toggle — standalone button at the far right end, top
        // corner. Declared after the edge tappers so it always wins clicks.
        if !root.viewer-slideshow: Rectangle {
            x: parent.width - self.width - 24px; y: 28px;
            width: 40px; height: 40px; border-radius: 20px;
            background: info-toggle.has-hover || root.viewer-info-open ? white.with-alpha(0.22) : white.with-alpha(0.10);
            info-toggle := TouchArea { mouse-cursor: pointer;
                clicked => { root.viewer-info-open = !root.viewer-info-open; } }
            AppIcon { source: Icons.info; tint: white; width: 18px; height: 18px; }
        }
        // Close — sits just left of the ⓘ button (top-right corner).
        if !root.viewer-slideshow: Rectangle {
            x: parent.width - self.width - 24px - 48px; y: 28px;
            width: 40px; height: 40px; border-radius: 20px;
            background: closebtn.has-hover ? white.with-alpha(0.22) : white.with-alpha(0.10);
            closebtn := TouchArea { mouse-cursor: pointer; clicked => { root.close-viewer(); } }
            AppIcon { source: Icons.x; tint: white; width: 16px; height: 16px; }
        }

        // Shared-element hero — morphs the clicked thumb's rect into the
        // viewer's image area, then crossfades out onto the static viewer
        // image (np.p1.ds.shared-element). Skipped when there's no source
        // rect (e.g. opened from the command palette).
        if root.hero-from.w > 0px && !root.hero-faded: SharedHero {
            source: root.viewer-image;
            from-rect: root.hero-from;
            to-rect: {
                x: stage.absolute-position.x, y: stage.absolute-position.y,
                w: stage.width, h: stage.height
            };
            trigger: root.hero-trigger;
            faded: root.hero-faded;
        }
        // Drive the handoff: once the morph has played, fade the hero out.
        hero-fade-timer := Timer {
            interval: Theme.reduce-motion ? 140ms : 380ms;
            running: root.viewer-open && root.hero-trigger && !root.hero-faded;
            triggered => { root.hero-faded = true; }
        }

        // Grab focus when the viewer opens so keys work immediately; flip the
        // hero trigger so it animates from the thumb rect to the stage.
        init => { viewer-keys.focus(); root.hero-trigger = true; }
    }

    // Command palette — Spotlight-style. Rust supplies fuzzy-ranked rows.
    if root.palette-open: CmdPalette {
        x: 0; y: 0; width: root.width; height: root.height;
        visible: true;
        query <=> root.palette-query;
        rows: root.palette-rows;
        query-changed(q) => { root.palette-query-changed(q); }
        row-activated(id) => { root.palette-activated(id); root.palette-open = false; }
        dismissed => { root.palette-open = false; key-scope.focus(); }
    }

    // Keyboard-shortcut help overlay.
    if root.shortcuts-open: ShortcutHelp {
        x: 0; y: 0; width: root.width; height: root.height;
        visible: true;
        groups: root.shortcut-groups;
        dismissed => { root.shortcuts-open = false; key-scope.focus(); }
        print-clicked => { root.shortcuts-open = false; key-scope.focus(); }
    }

    // Asset properties window.
    if root.props-open: PropertiesWindow {
        x: 0; y: 0; width: root.width; height: root.height;
        open: true;
        props: root.props;
        open-containing-folder => { root.props-open-folder(); }
        close => { root.props-open = false; key-scope.focus(); }
    }

    // Top-level error boundary — surfaces fatal errors with recovery actions.
    if root.error-open: ErrorBoundary {
        x: 0; y: 0; width: root.width; height: root.height;
        open: true;
        title: root.error-title;
        message: root.error-message;
        log-tail: root.error-log-tail;
        open-logs => { root.error-open-logs(); }
        reload => { root.error-reload(); }
        quit => { root.error-quit(); }
    }

    // Chat assistant overlay (Cmd/Ctrl+J).
    if root.chat-open: ChatOverlay {
        x: 0; y: 0; width: root.width; height: root.height;
        open: true;
        turns: root.chat-turns;
        draft <=> root.chat-draft;
        submit(q) => { root.chat-submit(q); }
        close => { root.chat-open = false; key-scope.focus(); }
    }

    // Non-destructive photo editor (np.p2.edit.*) — full-screen overlay.
    if root.editor-open: PhotoEditor {
        x: 0; y: 0; width: root.width; height: root.height;
        preview: root.editor-preview;
        original: root.editor-original;
        nat-w: root.editor-nat-w;
        nat-h: root.editor-nat-h;
        busy: root.editor-busy;
        op-count: root.editor-op-count;
        can-undo: root.editor-can-undo;
        can-redo: root.editor-can-redo;
        filename: root.editor-filename;
        active-filter: root.editor-active-filter;
        status: root.editor-status;
        exposure <=> root.editor-exposure;
        contrast <=> root.editor-contrast;
        saturation <=> root.editor-saturation;
        temperature <=> root.editor-temperature;
        highlights <=> root.editor-highlights;
        shadows <=> root.editor-shadows;
        histogram: root.editor-histogram;
        exif-dump: root.editor-exif;
        exif-artist <=> root.editor-exif-artist;
        exif-copyright <=> root.editor-exif-copyright;
        exif-description <=> root.editor-exif-description;
        exif-comment <=> root.editor-exif-comment;
        exif-date <=> root.editor-exif-date;
        adjust(e, c, s, t, h, sh) => { root.editor-adjust(e, c, s, t, h, sh); }
        curve-changed(ch, y0, y1, y2, y3, y4) => { root.editor-curve(ch, y0, y1, y2, y3, y4); }
        exif-save(a, c, d, m, dt) => { root.editor-exif-save(a, c, d, m, dt); }
        exif-clear-gps => { root.editor-exif-clear-gps(); }
        filter-preset(p) => { root.editor-filter(p); }
        transform(k) => { root.editor-transform(k); }
        enhance => { root.editor-enhance(); }
        sharpen(a) => { root.editor-sharpen(a); }
        ai-op(o) => { root.editor-ai-op(o); }
        undo => { root.editor-undo(); }
        redo => { root.editor-redo(); }
        reset => { root.editor-reset(); }
        do-export(f, q) => { root.editor-export(f, q); }
        save-original => { root.editor-save-original(); }
        crop-apply(x, y, w, h) => { root.editor-crop(x, y, w, h); }
        resize-apply(w, h) => { root.editor-resize(w, h); }
        close => { root.editor-close(); root.editor-open = false; key-scope.focus(); }
    }

    // Add-folder → assign music sub-section popup. After + Add picks a folder,
    // the user classifies it into one of the 5 music sections; choosing
    // Audiobooks flags every track in that folder as an audiobook.
    if root.music-add-section-open: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        background: #000000aa;
        TouchArea { clicked => { root.music-add-section-open = false; } } // scrim dismiss
        Rectangle {
            width: 460px; height: 360px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-lg;
            background: Theme.modal;
            border-color: Accent.color.with-alpha(0.5); border-width: 1px;
            drop-shadow-blur: 32px; drop-shadow-color: #000000aa;
            TouchArea {} // swallow clicks so they don't dismiss
            VerticalLayout {
                padding: 22px; spacing: 12px;
                Text { text: "Add to library"; color: Theme.text; font-size: 18px; font-weight: 700; }
                Text { text: "Classify this folder. Audiobooks get chapter nav + position-remember.";
                    color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                Text { text: root.music-pending-add-path; color: Accent.color; font-size: 11px;
                    overflow: elide; }
                Rectangle { height: 1px; background: Theme.outline; }
                for opt[i] in [
                    { key: "mymusic",    icon: Icons.music, label: "My Music",   sub: "Songs, albums, artists" },
                    { key: "podcasts",   icon: Icons.mic, label: "Podcasts",   sub: "RSS feeds + episodes" },
                    { key: "audiobooks", icon: Icons.book-open, label: "Audiobooks",  sub: "Chapters + resume + speed" },
                    { key: "radio",      icon: Icons.radio, label: "Radio",      sub: "Stream stations" },
                    { key: "youtube",    icon: Icons.play, label: "YouTube",     sub: "Downloads" },
                ]: Rectangle {
                    height: 44px; border-radius: 10px;
                    background: oa.has-hover ? Accent.color.with-alpha(0.16) : Theme.panel;
                    border-width: 1px; border-color: oa.has-hover ? Accent.color.with-alpha(0.5) : Theme.outline;
                    animate background { duration: 100ms; }
                    oa := TouchArea { mouse-cursor: pointer;
                        clicked => { root.music-confirm-add-section(opt.key); root.music-add-section-open = false; } }
                    HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 10px;
                        VerticalLayout { alignment: center; AppIcon { source: opt.icon; tint: Theme.text; width: 17px; height: 17px; } }
                        VerticalLayout { alignment: center; Text { text: opt.label; color: Theme.text; font-size: 14px; font-weight: 700; } }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; Text { text: opt.sub; color: Theme.text-dim; font-size: 11px; } } }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { alignment: end;
                    Rectangle { width: 90px; height: 32px; border-radius: 8px;
                        background: ca.has-hover ? Theme.panel-2 : Theme.panel;
                        border-width: 1px; border-color: Theme.outline;
                        ca := TouchArea { mouse-cursor: pointer; clicked => { root.music-add-section-open = false; } }
                        Text { text: "Cancel"; color: Theme.text; font-size: 12px;
                            horizontal-alignment: center; vertical-alignment: center; } } }
            }
        }
    }

    // Milestone confetti (np.p1.ds.empty-state) — celebratory pop on library
    // milestones (1k photos / 100h watched / first sync). Auto-clears.
    in-out property <string> milestone: "";
    if root.milestone != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: 120px;
        width: 360px; height: 64px;
        border-radius: Theme.radius-lg;
        background: Theme.modal;
        border-color: Accent.color.with-alpha(0.8); border-width: 1px;
        drop-shadow-blur: 30px; drop-shadow-color: Accent.color.with-alpha(0.35);
        MilestoneConfetti { label: root.milestone; playing: true; }
        Timer { interval: 5s; running: root.milestone != ""; triggered => { root.milestone = ""; } }
    }

    // Capability-denied nudge toast (np.p1.caps.events). Auto-clears.
    if root.caps-nudge != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 96px;
        width: 460px; height: 52px;
        border-radius: Theme.radius-md;
        background: Theme.modal;
        border-color: Accent.color.with-alpha(0.6); border-width: 1px;
        drop-shadow-blur: 24px; drop-shadow-color: #00000066;
        nudge-timer := Timer {
            interval: 4s; running: root.caps-nudge != "";
            triggered => { root.caps-nudge = ""; }
        }
        HorizontalLayout {
            padding-left: 16px; padding-right: 12px; spacing: 12px;
            Text { text: root.caps-nudge; color: Theme.text; font-size: 12px;
                vertical-alignment: center; horizontal-stretch: 1; }
            Rectangle {
                width: 78px; height: 30px; border-radius: 8px;
                background: @linear-gradient(135deg, Theme.brand, Theme.brand-2);
                y: (parent.height - self.height) / 2; horizontal-stretch: 0;
                TouchArea { clicked => { root.caps-nudge = ""; root.active-section = "settings"; root.active-settings-tab = "profile"; } }
                Text { text: "Open"; color: #ffffff; font-size: 11px; font-weight: 600;
                    horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }

    // First-run onboarding wizard — top-most so it gates the first session.
    if root.onboarding-open: OnboardingWizard {
        x: 0; y: 0; width: root.width; height: root.height;
        theme-choice <=> root.theme-choice;
        mode: "local";
        library-added: root.onboarding-lib-added;
        theme-changed(c) => { root.theme-changed(c); }
        choose-mode(m) => { root.user-action("switch-to-local"); }
        add-library => { root.pick-folder(); }
        finished => { root.onboarding-finished(); }
    }
}

