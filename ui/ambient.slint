import { Theme } from "tokens.slint";

// Idle-screensaver overlay — Ken Burns pan/zoom over a backdrop placeholder
// + clock overlay. Real photo/video source from local 5★ + AI memories
// wires up in tulipix-photos (np.p1.ambient backend).

export component AmbientScreensaver inherits Rectangle {
    in property <string> clock-text: "00:00";
    in property <string> caption: "";
    in-out property <bool> active: false;

    visible: active;
    background: #000000;
    width: 100%; height: 100%;
    z: 1000;

    if active: Rectangle {
        property <float> t: 0;
        animate t { duration: 12s; easing: ease-in-out; }
        background: @linear-gradient(135deg,
            #1a0f3a.with-alpha(0.95) 0%,
            #050614.with-alpha(0.85) 50%,
            #4f46e5.with-alpha(0.18) 100%);
        Rectangle {
            background: @radial-gradient(circle, Theme.brand.with-alpha(0.30) 0%, transparent 60%);
            x: 100px + t * 200px;
            y: 60px + t * 80px;
            width: parent.width * 0.7;
            height: parent.height * 0.7;
        }
        init => { self.t = 1; }
    }

    if active: VerticalLayout {
        alignment: end; padding: 60px;
        Text {
            text: clock-text;
            color: #f8faff;
            font-size: 96px; font-weight: 200;
            horizontal-alignment: center;
        }
        Text {
            text: caption;
            color: #f8faffa0;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }

    TouchArea { clicked => { root.active = false; } }
}
