// Home layout 1 of 5 — CINEMA. Spec: docs/home-layouts/01-cinema.md.
//
// One hero at full bleed for whatever you were last watching, a shelf along the
// bottom carrying the resume rail and the section keys, and a glass stack on the
// right for the two sections that are numbers rather than pictures.
//
// Every band collapses rather than stretches when its card is switched off, so a
// stripped-down Cinema looks deliberate: no card leaves a hole behind it.
import { Theme } from "tokens.slint";
import { Surface, Rim } from "surface.slint";
import { Icons, AppIcon } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { HomeStats, HomeContinue } from "page_home.slint";

/// One obligation in the Finances panel. Kept local so this page does not have
/// to import page_finances.slint (388 KB) for one struct.
export struct HomeDue {
    name: string,
    amount: string,
    when: string,
    late: bool,
}

// ── Top-bar pill ────────────────────────────────────────────────────────────
component TopPill inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> icon-only: false;
    callback clicked();
    height: 31px;
    width: root.icon-only ? 34px : (lab.preferred-width + 40px);
    border-radius: 16px;
    background: t.has-hover ? Theme.glass-strong : Theme.glass;
    border-width: 1px;
    border-color: Theme.glass-border;
    animate background { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.icon-only ? 0px : 12px;
        padding-right: root.icon-only ? 0px : 12px;
        spacing: 7px; alignment: center;
        AppIcon { source: root.icon; tint: Theme.text-dim; width: 14px; height: 14px;
            y: (parent.height - self.height) / 2; }
        // Unconditional so its width can drive the pill; empty when icon-only.
        lab := Text {
            text: root.icon-only ? "" : root.label;
            color: Theme.text-dim; font-size: 11.5px;
            vertical-alignment: center;
        }
    }
}

// ── Hero button ─────────────────────────────────────────────────────────────
component HeroBtn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: false;
    callback clicked();
    height: 42px;
    width: lab.preferred-width + 54px;
    border-radius: 21px;
    background: root.primary
        ? (t.has-hover ? #ffffff : #f2f2f7)
        : (t.has-hover ? Theme.glass-strong : Theme.glass);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.glass-border;
    animate background { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        spacing: 9px; alignment: center;
        padding-left: 18px; padding-right: 18px;
        AppIcon {
            source: root.icon; width: 16px; height: 16px;
            tint: root.primary ? #0a0a12 : Theme.text;
            y: (parent.height - self.height) / 2;
        }
        lab := Text {
            text: root.label; font-size: 13px;
            font-weight: root.primary ? 700 : 600;
            color: root.primary ? #0a0a12 : Theme.text;
            vertical-alignment: center;
        }
    }
}

// ── One resume tile in the shelf rail ───────────────────────────────────────
// Width follows the artwork's real aspect so a rail of mixed media keeps its
// bottoms aligned: a book is a spine, a podcast is a square, a film is a frame.
component RailTile inherits Rectangle {
    in property <HomeContinue> data;
    in property <color> accent;
    callback open();
    property <length> art-h: 95px;
    width: root.data.kind == "book" || root.data.kind == "audiobook" ? 66px
        : (root.data.kind == "podcast" ? 95px : 168px);
    height: root.art-h + 40px;
    background: transparent;
    t := TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: root.art-h; border-radius: Surface.r(9px); clip: true;
            background: Theme.panel-2;
            border-width: t.has-hover ? 1px : 0px;
            border-color: root.accent;
            if root.data.cover.width > 0: Image {
                source: root.data.cover; image-fit: cover;
                width: 100%; height: 100%;
            }
            if root.data.cover.width == 0: AppIcon {
                source: root.data.kind == "video" ? Icons.film
                    : (root.data.kind == "podcast" ? Icons.mic : Icons.book-open);
                tint: root.accent; width: 20px; height: 20px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        // Progress hairline sits under the art, not over it — an overlay bar on a
        // 95 px thumbnail eats the part of the frame you are trying to recognise.
        Rectangle { height: 6px; }
        Rectangle {
            height: 2px;
            background: Theme.text.with-alpha(0.18); border-radius: 1px;
            opacity: root.data.frac >= 0 ? 1.0 : 0.0;
            Rectangle {
                width: parent.width * Math.max(0.0, Math.min(1.0, root.data.frac));
                height: 100%; border-radius: 1px; background: root.accent;
            }
        }
        Rectangle { height: 6px; }
        Text {
            text: root.data.title; color: Theme.text; font-size: 11.5px; font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.data.sub == "" ? root.data.author : root.data.sub;
            color: Theme.text-dim; font-size: 10px; overflow: elide;
        }
    }
}

// ── One section key in the shelf strip ──────────────────────────────────────
component SectionKey inherits Rectangle {
    in property <string> label;
    in property <string> stat;
    in property <image> icon;
    in property <color> accent;
    callback clicked();
    height: 62px;
    border-radius: Surface.r(11px);
    background: t.has-hover ? Theme.glass-strong : Theme.glass;
    border-width: 1px;
    border-color: t.has-hover ? root.accent.with-alpha(0.5) : Theme.glass-border;
    clip: true;
    animate background, border-color { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    // Accent edge — the only colour on a resting key, so the strip reads as
    // eight sections rather than eight buttons.
    Rectangle { width: 2px; height: 100%; background: root.accent; }
    HorizontalLayout {
        padding-left: 13px; padding-right: 11px; spacing: 11px; alignment: start;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            Rectangle {
                width: 30px; height: 30px; border-radius: Surface.r(9px);
                background: root.accent.with-alpha(0.2);
                AppIcon { source: root.icon; tint: root.accent; width: 16px; height: 16px;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
        }
        VerticalLayout {
            alignment: center; spacing: 1px; horizontal-stretch: 1;
            Text { text: root.label; color: Theme.text; font-size: 11.5px; font-weight: 600; overflow: elide; }
            Text { text: root.stat; color: Theme.text-dim; font-size: 10px; overflow: elide; }
        }
    }
}

// ── Glass panel in the right stack ──────────────────────────────────────────
component GlassPanel inherits Rectangle {
    in property <string> title;
    in property <string> note;
    in property <image> icon;
    in property <color> accent;
    callback clicked();
    border-radius: Surface.r(15px);
    // Deliberately not a real backdrop blur: blurring a live 1440-wide image
    // every frame is the expensive thing on the femtovg renderer, and a dimmed
    // plate over a scrim reads the same at this size.
    background: Theme.dark ? #0c0c14b0 : #ffffffc4;
    border-width: 1px;
    border-color: t.has-hover ? root.accent.with-alpha(0.45) : Theme.glass-border;
    animate border-color { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    if Surface.rim: Rim {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        radius: Surface.r(15px) - 1px;
    }
}

export component HomeCinema inherits Rectangle {
    // ── Chrome ──────────────────────────────────────────────────────────────
    in property <string> greeting: "Welcome";
    in property <string> date-line: "";
    in property <string> library-line: "";      // "12,481 items · 1.9 TB"
    // ── Hero ────────────────────────────────────────────────────────────────
    in property <string> hero-kind: "";
    in property <string> hero-title: "";
    in property <string> hero-kicker: "";
    in property <string> hero-meta: "";
    in property <float> hero-frac: -1;
    in property <image> hero-art;
    // ── Shelf ───────────────────────────────────────────────────────────────
    in property <[HomeContinue]> continue-rows: [];
    in property <HomeStats> stats;
    // ── Right stack ─────────────────────────────────────────────────────────
    in property <string> fin-spent: "";
    in property <string> fin-month: "";
    in property <string> fin-liquid: "";
    in property <[float]> fin-months: [];       // 0‥1 per month, oldest first
    in property <[HomeDue]> fin-dues: [];
    in property <string> transfer-inbox: "";
    in property <string> transfer-note: "";     // "2 paired" once the home summary lands
    // ── Card visibility (docs/home-layouts/01-cinema.md §Fluid rules) ───────
    in property <bool> hc-hero: true;
    in property <bool> hc-continue: true;
    in property <bool> hc-photos: true;
    in property <bool> hc-videos: true;
    in property <bool> hc-music: true;
    in property <bool> hc-books: true;
    in property <bool> hc-cloud: true;
    in property <bool> hc-tools: true;
    in property <bool> hc-transfer: true;
    in property <bool> hc-finances: true;

    callback open-section(string);
    callback open-search();
    callback resume-hero();
    callback hero-details();
    callback continue-open(HomeContinue);
    callback start-sharing();

    // ── Geometry ────────────────────────────────────────────────────────────
    property <length> pad: 34px;
    property <int> keys: (root.hc-photos ? 1 : 0) + (root.hc-videos ? 1 : 0)
        + (root.hc-music ? 1 : 0) + (root.hc-books ? 1 : 0)
        + (root.hc-cloud ? 1 : 0) + (root.hc-tools ? 1 : 0);
    property <bool> rail-on: root.hc-continue && root.continue-rows.length > 0;
    property <int> stack-n: (root.hc-finances ? 1 : 0) + (root.hc-transfer ? 1 : 0);
    // The shelf is a band that collapses: rail + keys, either, or nothing.
    property <length> key-h: root.keys > 0 ? 62px : 0px;
    property <length> rail-h: root.rail-on ? 135px : 0px;
    property <length> shelf-h: (root.rail-h > 0px || root.key-h > 0px)
        ? 18px + root.rail-h + (root.rail-h > 0px && root.key-h > 0px ? 14px : 0px)
          + root.key-h + 20px
        : 0px;
    property <length> stack-w: 274px;
    property <length> hero-w: root.stack-n > 0 ? 520px : 720px;
    // Hero text sits centred in what the shelf leaves behind.
    property <length> hero-y: (root.height - root.shelf-h) * 0.42;

    background: Theme.bg;
    clip: true;

    // ── Backdrop ────────────────────────────────────────────────────────────
    if root.hc-hero && root.hero-art.width > 0: Image {
        source: root.hero-art; image-fit: cover;
        width: 100%; height: 100%;
    }
    // No art (or no hero): the app gradient stands in, so the page is never a
    // flat black rectangle with text on it.
    if !root.hc-hero || root.hero-art.width == 0: Rectangle {
        width: 100%; height: 100%;
        background: @linear-gradient(145deg, Theme.brand.with-alpha(0.45),
            Theme.sec-videos.with-alpha(0.28), Theme.bg);
    }
    // Side and bottom scrims. Two flat gradients rather than a blur.
    Rectangle {
        width: 100%; height: 100%;
        background: @linear-gradient(90deg, Theme.bg, Theme.bg.with-alpha(0.86) 34%,
            Theme.bg.with-alpha(0.18) 64%, Theme.bg.with-alpha(0.62));
    }
    Rectangle {
        width: 100%; height: 100%;
        background: @linear-gradient(0deg, Theme.bg 2%, Theme.bg.with-alpha(0.08) 48%);
    }

    // ── Top bar ─────────────────────────────────────────────────────────────
    HorizontalLayout {
        x: root.pad; y: 22px; width: root.width - 2 * root.pad; height: 31px;
        spacing: 14px; alignment: start;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 9px; height: 9px; border-radius: 3px;
                    y: (parent.height - self.height) / 2;
                    background: @linear-gradient(140deg, Theme.brand, Theme.sec-music);
                }
                Text { text: "tulipix"; color: Theme.text; font-size: 15px; font-weight: 700;
                    vertical-alignment: center; }
            }
        }
        Rectangle { width: 1px; height: 18px; background: Theme.glass-border;
            y: (parent.height - self.height) / 2; horizontal-stretch: 0; }
        Text {
            text: root.greeting + (root.date-line == "" ? "" : " · " + root.date-line);
            color: Theme.text-dim; font-size: 12px; vertical-alignment: center;
            overflow: elide; horizontal-stretch: 1;
        }
        TopPill { label: root.library-line; icon: Icons.image; horizontal-stretch: 0;
            clicked => { root.open-section("photos"); } }
        TopPill { icon: Icons.search; icon-only: true; horizontal-stretch: 0;
            clicked => { root.open-search(); } }
    }

    // ── Hero ────────────────────────────────────────────────────────────────
    if root.hc-hero: Rectangle {
        x: root.pad + 6px; y: root.hero-y; width: root.hero-w;
        height: 220px; background: transparent;
        VerticalLayout {
            spacing: 0; alignment: start;
            // Kicker — the badge says what the button will do, in the button's words.
            HorizontalLayout {
                spacing: 9px; alignment: start; height: 20px;
                Rectangle {
                    width: 62px; height: 19px; border-radius: 5px; horizontal-stretch: 0;
                    background: root.hero-title == "" ? Theme.brand : Theme.sec-videos;
                    Text {
                        text: root.hero-title == "" ? "START" : "RESUME";
                        color: #0b0b12; font-size: 9px; font-weight: 700; letter-spacing: 0.8px;
                        width: 100%; height: 100%;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Text {
                    text: root.hero-title == "" ? "NOTHING IN PROGRESS" : root.hero-kicker;
                    color: Theme.text-dim; font-size: 10px; font-weight: 600;
                    letter-spacing: 1.4px; vertical-alignment: center; overflow: elide;
                }
            }
            Rectangle { height: 14px; }
            // Title. One line, elided — it must never wrap into the shelf.
            Text {
                text: root.hero-title == "" ? "Your library" : root.hero-title;
                color: Theme.text; font-size: 62px; font-weight: 700;
                letter-spacing: -2.6px; wrap: no-wrap; overflow: elide;
            }
            Rectangle { height: 12px; }
            Text {
                text: root.hero-title == ""
                    ? "Add a folder and the newest thing you were watching lands here."
                    : root.hero-meta;
                color: Theme.text-dim; font-size: 12.5px; overflow: elide;
            }
            Rectangle { height: 16px; }
            if root.hero-frac >= 0: Rectangle {
                width: 330px; height: 3px; border-radius: 2px;
                background: Theme.text.with-alpha(0.2);
                Rectangle {
                    width: parent.width * Math.max(0.0, Math.min(1.0, root.hero-frac));
                    height: 100%; border-radius: 2px; background: Theme.sec-videos;
                }
            }
            Rectangle { height: 20px; }
            HorizontalLayout {
                spacing: 10px; alignment: start; height: 42px;
                HeroBtn {
                    label: root.hero-title == "" ? "Browse Photos" : "Resume";
                    icon: root.hero-title == "" ? Icons.image : Icons.play;
                    primary: true;
                    clicked => {
                        if (root.hero-title == "") { root.open-section("photos"); }
                        else { root.resume-hero(); }
                    }
                }
                if root.hero-title != "": HeroBtn {
                    label: "Details"; icon: Icons.info;
                    clicked => { root.hero-details(); }
                }
            }
        }
    }

    // ── Right glass stack ───────────────────────────────────────────────────
    if root.stack-n > 0: Rectangle {
        x: root.width - root.pad - root.stack-w;
        y: 96px; width: root.stack-w;
        height: root.height - root.shelf-h - 96px - 20px;
        background: transparent;
        VerticalLayout {
            spacing: 11px; alignment: start;

            // Finances — the one card on Home that is only numbers.
            if root.hc-finances: GlassPanel {
                title: "FINANCES"; accent: Theme.sec-finances; icon: Icons.wallet;
                height: 30px + 40px + 34px + (root.fin-dues.length * 30px) + 16px;
                clicked => { root.open-section("finances"); }
                VerticalLayout {
                    padding: 13px; spacing: 0;
                    HorizontalLayout {
                        spacing: 8px; height: 17px;
                        AppIcon { source: Icons.wallet; tint: Theme.sec-finances;
                            width: 13px; height: 13px; horizontal-stretch: 0; }
                        Text { text: "FINANCES"; color: Theme.sec-finances; font-size: 11px;
                            font-weight: 700; letter-spacing: 0.3px; vertical-alignment: center; }
                        Text { text: root.fin-month; color: Theme.text-dim; font-size: 10px;
                            horizontal-alignment: right; vertical-alignment: center;
                            horizontal-stretch: 1; }
                    }
                    Rectangle { height: 10px; }
                    Text {
                        text: root.fin-spent == "" ? "—" : root.fin-spent;
                        color: Theme.text; font-size: 29px; font-weight: 700;
                        letter-spacing: -1px;
                    }
                    Rectangle { height: 4px; }
                    Text {
                        text: root.fin-liquid == "" ? "spent this month"
                            : "spent this month · " + root.fin-liquid + " liquid";
                        color: Theme.text-dim; font-size: 10.5px; overflow: elide;
                    }
                    // Twelve months, newest last. Bars, not a donut: the shape of a
                    // year is the thing worth seeing at this size.
                    Rectangle { height: 12px; }
                    HorizontalLayout {
                        height: 30px; spacing: 3px;
                        for m[i] in root.fin-months: Rectangle {
                            border-radius: 2px;
                            y: parent.height - self.height;
                            height: Math.max(2px, parent.height * Math.max(0.04, m));
                            background: i == root.fin-months.length - 1
                                ? Theme.sec-finances
                                : Theme.sec-finances.with-alpha(0.32);
                        }
                    }
                    for d in root.fin-dues: HorizontalLayout {
                        height: 30px; spacing: 8px;
                        Rectangle {
                            width: 6px; height: 6px; border-radius: 3px; horizontal-stretch: 0;
                            y: (parent.height - self.height) / 2;
                            background: d.late ? Theme.error : Theme.warn;
                        }
                        Text { text: d.name; color: Theme.text; font-size: 11px;
                            vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Text { text: d.amount; color: Theme.text; font-size: 11px; font-weight: 600;
                            vertical-alignment: center; horizontal-stretch: 0; }
                        Text { text: d.when; color: d.late ? Theme.error : Theme.text-dim;
                            font-size: 9.5px; vertical-alignment: center;
                            horizontal-alignment: right; width: 54px; horizontal-stretch: 0; }
                    }
                }
            }

            // Transfer — a door, not a dashboard. The server only binds while the
            // section is open, so there is nothing live to show here yet; the
            // panel offers the one action that matters and says where files land.
            if root.hc-transfer: GlassPanel {
                title: "TRANSFER"; accent: Theme.sec-transfer; icon: Icons.share;
                height: 106px;
                clicked => { root.open-section("transfer"); }
                VerticalLayout {
                    padding: 13px; spacing: 9px;
                    HorizontalLayout {
                        spacing: 8px; height: 17px;
                        AppIcon { source: Icons.share; tint: Theme.sec-transfer;
                            width: 13px; height: 13px; horizontal-stretch: 0; }
                        Text { text: "TRANSFER"; color: Theme.sec-transfer; font-size: 11px;
                            font-weight: 700; letter-spacing: 0.3px; vertical-alignment: center; }
                        Text { text: root.transfer-note; color: Theme.text-dim; font-size: 10px;
                            horizontal-alignment: right; vertical-alignment: center;
                            horizontal-stretch: 1; }
                    }
                    Rectangle {
                        height: 30px; border-radius: Surface.r(15px); horizontal-stretch: 0;
                        width: 128px;
                        background: @linear-gradient(140deg, Theme.transfer-accent, Theme.transfer-accent-2);
                        st := TouchArea { mouse-cursor: pointer; clicked => { root.start-sharing(); } }
                        HorizontalLayout {
                            spacing: 6px; alignment: center;
                            AppIcon { source: Icons.zap; tint: #231000; width: 13px; height: 13px;
                                y: (parent.height - self.height) / 2; }
                            Text { text: "Start sharing"; color: #231000; font-size: 11px;
                                font-weight: 700; vertical-alignment: center; }
                        }
                    }
                    Text {
                        text: root.transfer-inbox == "" ? "Files land in your inbox folder"
                            : "Inbox " + root.transfer-inbox;
                        color: Theme.text-dim; font-size: 10px; overflow: elide;
                    }
                }
            }
        }
    }

    // ── Shelf ───────────────────────────────────────────────────────────────
    if root.shelf-h > 0px: Rectangle {
        y: root.height - root.shelf-h; width: root.width; height: root.shelf-h;
        background: @linear-gradient(0deg, Theme.bg, Theme.bg.with-alpha(0.72) 62%,
            Theme.bg.with-alpha(0.0));
        VerticalLayout {
            padding-left: root.pad; padding-right: root.pad;
            padding-top: 18px; padding-bottom: 20px;
            spacing: 14px;

            if root.rail-on: VerticalLayout {
                spacing: 9px;
                HorizontalLayout {
                    height: 16px;
                    Text { text: "Continue"; color: Theme.text; font-size: 12.5px; font-weight: 700;
                        vertical-alignment: center; }
                    Text {
                        text: root.continue-rows.length + " in progress";
                        color: Theme.text-dim; font-size: 10.5px; vertical-alignment: center;
                        horizontal-alignment: right; horizontal-stretch: 1;
                    }
                }
                rsv := ScrollView {
                    height: 110px;
                    // Every page in this app opens at the top — and every rail at
                    // its left edge.
                    viewport-x: 0px;
                    HorizontalLayout {
                        spacing: 11px; alignment: start;
                        for c in root.continue-rows: RailTile {
                            data: c;
                            accent: c.kind == "video" ? Theme.sec-videos
                                : (c.kind == "podcast" ? Theme.sec-music
                                : (c.kind == "book" ? Theme.sec-books : Theme.sec-books));
                            open => { root.continue-open(c); }
                        }
                    }
                }
            }

            if root.keys > 0: HorizontalLayout {
                height: 62px; spacing: 9px;
                if root.hc-photos: SectionKey {
                    label: "Photos"; icon: Icons.image; accent: Theme.sec-photos;
                    stat: root.stats.photos + " items";
                    clicked => { root.open-section("photos"); }
                }
                if root.hc-videos: SectionKey {
                    label: "Videos"; icon: Icons.film; accent: Theme.sec-videos;
                    stat: root.stats.videos + " items";
                    clicked => { root.open-section("videos"); }
                }
                if root.hc-music: SectionKey {
                    label: "Music"; icon: Icons.music; accent: Theme.sec-music;
                    stat: root.stats.songs + " tracks";
                    clicked => { root.open-section("music"); }
                }
                if root.hc-books: SectionKey {
                    label: "Books"; icon: Icons.book-open; accent: Theme.sec-books;
                    stat: root.stats.books + " books";
                    clicked => { root.open-section("books"); }
                }
                if root.hc-cloud: SectionKey {
                    label: "Cloud"; icon: Icons.cloud; accent: Theme.sec-cloud;
                    stat: root.stats.cloud-remotes + " remotes";
                    clicked => { root.open-section("cloud"); }
                }
                if root.hc-tools: SectionKey {
                    label: "Tools"; icon: Icons.wrench; accent: Theme.sec-tools;
                    stat: root.stats.tools-note == "" ? "ready" : root.stats.tools-note;
                    clicked => { root.open-section("tools"); }
                }
            }
        }
    }
}
