// Home command center (np.p6.home) — bento dashboard, default landing page.
// Layout v4 (2026-07-05): embeds the ORIGINAL Music MusicMini (embedded mode)
// now that MusicTheme derives from the app Theme, explicit-width section tiles
// (nested layouts wouldn't distribute the leftover — only fixed widths fill),
// and a left/right swap for the music block driven by `music-left`.
import { Theme, Accent } from "tokens.slint";
import { AppIcon, Icons } from "icons.slint";
import { MusicMini, PodcastMini, MusicTab, LiveTabRing, VizView } from "page_music.slint";
import { MusicSongRow, MusicLyricLine, PodcastEpisodeRow } from "music_common.slint";

export struct HomeStats {
    photos: int, photos-albums: int, photos-scan: string,
    videos: int, videos-shows: int, videos-note: string,
    songs: int, podcasts: int, audiobooks: int, radio: int,
    books: int, books-reading: int,
    cloud-remotes: int, cloud-note: string,
    tools-jobs: int, tools-note: string,
    continue1: string, continue1-sub: string,
    continue2: string, continue2-sub: string,
    continue3: string, continue3-sub: string,
}

export struct HomeRemote { name: string, backend: string, usage: string }

// One in-progress item for the Home CONTINUE strip (design parity: cover +
// progress bar + resume click). kind: "book" | "podcast" | "audiobook" | "video".
export struct HomeContinue {
    kind: string,
    title: string,
    author: string,   // book author / podcast show / audiobook narrator line
    sub: string,
    frac: float,      // 0‥1 progress; < 0 = unknown (bar hidden)
    cover: image,
    id: int,          // book item id / podcast episode id
    path: string,     // book abs path (books only)
}

// Small uppercase section label.
component HomeCap inherits Text {
    font-size: 9px; font-weight: 800; letter-spacing: 1.2px;
    color: Theme.text-dim;
}

// 24px pill chip — one size everywhere.
component HomeChip inherits Rectangle {
    in property <string> label;
    in property <bool> emphasized: false;
    in property <bool> fill: false;              // stretch to share the row (tabs)
    in property <color> accent: Accent.color;
    callback clicked();
    height: 30px; border-radius: 15px;
    horizontal-stretch: fill ? 1 : 0; vertical-stretch: 0;
    // Active chip = SOLID accent fill + white text (translucent fill left the
    // accent-on-accent text unreadable).
    background: emphasized ? accent : (ta.has-hover ? Theme.panel : Theme.panel-2);
    border-width: 1px;
    border-color: emphasized ? accent : Theme.outline;
    animate background { duration: 120ms; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout { padding-left: 14px; padding-right: 14px;
        Text { text: label; color: emphasized ? #ffffff : Theme.text; horizontal-stretch: 1;
            font-size: 11px; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; overflow: elide; } }
}

// White accent-bordered title pill (the Photos/Videos card label made
// reusable): bare tinted icon | hairline | name (+ optional count). Sizes
// itself; callers position it (overlay) or drop it in a layout (header row).
component TitlePill inherits Rectangle {
    in property <image> icon;
    in property <color> accent;
    in property <string> name;
    in property <string> stat: "";
    width: prow.preferred-width; height: prow.preferred-height;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 10px; background: #ffffff;
    border-width: 1.5px; border-color: root.accent;
    drop-shadow-blur: 12px; drop-shadow-color: #00000055;
    prow := HorizontalLayout {
        padding-left: 11px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px; spacing: 9px;
        VerticalLayout { alignment: center;
            AppIcon { source: root.icon; tint: root.accent; width: 20px; height: 20px; } }
        Rectangle { width: 1px; background: root.accent.with-alpha(0.30); }
        Text { text: root.name; color: root.accent; font-size: 17px; font-weight: 800;
            vertical-alignment: center; overflow: elide; }
        if root.stat != "": Text { text: root.stat; color: root.accent; font-size: 12px; font-weight: 600;
            vertical-alignment: center; overflow: elide; }
    }
}

// Positioned card slot on the Home board — x/y are fractions of the free
// range (board minus card size), which reproduces the fixed bento grid.
component BoardSlot inherits Rectangle {
    in property <float> dfx: 0;
    in property <float> dfy: 0;
    in property <length> board-w;
    in property <length> board-h;
    x: dfx * Math.max(board-w - self.width, 0px);
    y: dfy * Math.max(board-h - self.height, 0px);
    @children
}

// Section tile — 80px icon chip top-left (200%), spring, big name/stat/footer
// at the bottom. Width is set explicitly by the caller (grid distribution).
component HomeTile inherits Rectangle {
    in property <image> icon;
    in property <color> accent;
    in property <string> name;
    in property <string> stat;
    in property <string> footer: "";
    in property <color> footer-color: Theme.text-dim.with-alpha(0.7);
    callback clicked();
    border-radius: 14px;
    background: accent.with-alpha(ta.has-hover ? 0.14 : 0.08);
    border-width: 1px; border-color: accent.with-alpha(0.24);
    animate background { duration: 120ms; easing: ease-out; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    VerticalLayout {
        padding: 16px; spacing: 5px;
        Rectangle {
            width: 80px; height: 80px; border-radius: 20px;
            horizontal-stretch: 0; vertical-stretch: 0;
            background: accent.with-alpha(0.15);
            AppIcon { source: root.icon; tint: accent; width: 40px; height: 40px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        Rectangle { vertical-stretch: 1; }   // spring
        Text { text: name; color: Theme.text; font-size: 24px; font-weight: 800; overflow: elide; }
        Text { text: stat; color: Theme.text-dim; font-size: 13px; overflow: elide; }
        if footer != "": Text { text: footer; color: footer-color; font-size: 13px; overflow: elide; }
    }
}

// Left-hand music card — MUSIC cap + the original MusicMini (embedded) + 5
// name-only tab chips. MusicMini now follows the app theme (MusicTheme derives
// from Theme), so the real player renders natively here instead of a clone.
component HomeMusicCard inherits Rectangle {
    in property <image> np-art;
    in property <color> np-accent: Theme.sec-music;
    in property <string> np-title; in property <string> np-sub; in property <string> np-album;
    in property <bool> playing;
    in property <float> pos; in property <float> dur;
    in property <string> pos-label; in property <string> dur-label;
    in property <bool> shuffle; in property <string> repeat;
    in property <float> volume; in property <bool> muted;
    // Content-type mode so the embedded player mirrors the Music section
    // (music | radio | book | podcast) — MusicMini for the first three, PodcastMini
    // for podcasts, plus radio/book/yt flags on MusicMini.
    in property <string> player-mode: "music";
    in property <float> player-scale: 1.0;
    in property <[MusicSongRow]> queue-rows: [];
    in property <[MusicLyricLine]> lyrics-rows: [];
    in property <int> lyrics-active: -1;
    in property <string> radio-initial: "";
    in property <bool> yt-now-video: false;
    in property <float> podcast-speed: 1.0;
    in property <[PodcastEpisodeRow]> podcast-episodes: [];
    in property <string> podcast-summary: "";
    callback playpause(); callback next(); callback prev();
    callback seek(float); callback set-volume(float);
    callback toggle-shuffle(); callback cycle-repeat(); callback toggle-mute();
    callback play-queue(int); callback watch-video();
    callback podcast-skip(int); callback podcast-set-speed(float); callback podcast-play(int);
    callback open-zen();
    callback open-music(string);
    callback open-now-album();            // click title in the mini → album page
    callback open-now-artist();           // click artist line → artist page
    // Which source is currently playing → drives the active tab + the title.
    property <string> active-tab:
        player-mode == "podcast" ? "podcasts"
      : player-mode == "book" ? "audiobooks"
      : player-mode == "radio" ? "radio"
      : yt-now-video ? "youtube" : "mymusic";
    border-radius: 14px;
    // Card body follows the uniform card style. Pink (#ec4899) is far
    // brighter than the other section accents, so the SAME 0.08 alpha the
    // dark cards use made this one glow — it sits at 0.03 to land at the
    // same perceived darkness. The player rect inside keeps its own pink.
    background: Theme.sec-music.with-alpha(musichov.has-hover ? 0.10 : 0.03);
    // Same chrome as the Photos/Videos cards: quiet 24%-accent hairline at
    // rest (NO glow — the always-on pink halo made this card look out of
    // place next to the dark cards), full accent outline + glow on hover.
    border-width: musichov.has-hover ? 2.5px : 1px;
    border-color: Theme.sec-music.with-alpha(musichov.has-hover ? 0.95 : 0.24);
    drop-shadow-blur: musichov.has-hover ? 22px : 0px;
    drop-shadow-color: Theme.sec-music.with-alpha(0.45);
    drop-shadow-offset-y: musichov.has-hover ? 6px : 0px;
    animate border-color, border-width, drop-shadow-blur, drop-shadow-offset-y { duration: 130ms; easing: ease-out; }
    musichov := TouchArea { }
    // Per-tab identity for the title pill (same hues as the tab chips below).
    property <color> tab-accent:
        active-tab == "podcasts" ? #8b5cf6
      : active-tab == "audiobooks" ? #3b82f6
      : active-tab == "radio" ? #14b8a6
      : active-tab == "youtube" ? #ef4444 : #ec4899;
    VerticalLayout {
        padding: 12px; spacing: 8px;
        // Centered title pill (Photos-card treatment) naming the source that's
        // playing — icon + accent follow the active tab, all 5 sources covered.
        HorizontalLayout {
            alignment: center;
            TitlePill {
                icon: root.active-tab == "podcasts" ? Icons.mic
                    : root.active-tab == "audiobooks" ? Icons.headphones
                    : root.active-tab == "radio" ? Icons.radio
                    : root.active-tab == "youtube" ? Icons.play : Icons.music;
                accent: root.tab-accent;
                name: root.active-tab == "podcasts" ? "Podcasts"
                    : root.active-tab == "audiobooks" ? "Audiobooks"
                    : root.active-tab == "radio" ? "Radio"
                    : root.active-tab == "youtube" ? "YouTube" : "My Music";
            }
        }
        // Stretchy wrapper so the embedded player fills the card (its root height
        // is fixed; height:100% here lets it grow, killing the blank gaps). This
        // rect carries the PINK player fill + a pink outline so the player
        // floats on the card's cream canvas — no shadow (read muddy-gray in
        // light themes), and a stronger wash so it stays clearly pink there.
        Rectangle {
            vertical-stretch: 1;
            border-radius: 12px;
            // Theme-aware player fill: white-cream on light themes (design
            // match), theme panel surface on dark — the fixed cream glared.
            background: Theme.dark ? Theme.panel-2 : #FAFAF7;
            border-width: 1px; border-color: Theme.sec-music.with-alpha(0.60);
            if root.player-mode != "podcast": MusicMini {
                embedded: true; width: 100%; height: 100%; uiscale: root.player-scale;
                art: np-art; accent: np-accent; title: np-title; sub: np-sub; album: np-album; playing: playing;
                pos: pos; dur: dur; pos-label: pos-label; dur-label: dur-label;
                shuffle: shuffle; repeat: repeat; volume: volume; muted: muted;
                queue-rows: root.queue-rows; lyrics-rows: root.lyrics-rows; lyrics-active: root.lyrics-active;
                radio-mode: root.player-mode == "radio"; radio-initial: root.radio-initial;
                book-mode: root.player-mode == "book";
                yt-now-video: root.yt-now-video; watch-video => { root.watch-video(); }
                playpause => { root.playpause(); }
                next => { root.next(); } prev => { root.prev(); }
                seek(s) => { root.seek(s); } set-volume(v) => { root.set-volume(v); }
                toggle-shuffle => { root.toggle-shuffle(); } cycle-repeat => { root.cycle-repeat(); }
                toggle-mute => { root.toggle-mute(); } play-queue(i) => { root.play-queue(i); }
                open-zen => { root.open-zen(); }
                open-now-album => { root.open-now-album(); }
                open-now-artist => { root.open-now-artist(); }
            }
            if root.player-mode == "podcast": PodcastMini {
                embedded: true; width: 100%; height: 100%; uiscale: root.player-scale;
                art: np-art; accent: np-accent; title: np-title; sub: np-sub; playing: playing;
                pos: pos; dur: dur; pos-label: pos-label; dur-label: dur-label;
                speed: podcast-speed; volume: volume; muted: muted;
                summary: podcast-summary; episodes: podcast-episodes;
                playpause => { root.playpause(); }
                skip(s) => { root.podcast-skip(s); } seek(s) => { root.seek(s); }
                set-speed(v) => { root.podcast-set-speed(v); } set-volume(v) => { root.set-volume(v); }
                toggle-mute => { root.toggle-mute(); } play-episode(id) => { root.podcast-play(id); }
                open-zen => { root.open-zen(); }
            }
        }
        // Source tabs — reuse the Music-section MusicTab (per-tab gradient colours)
        // + LiveTabRing (rotating halo on the source that's playing). `hollow`
        // drops the idle tint wash for a bare tinted outline, so the chips stay
        // visible on the unfilled card in every theme.
        // Row 1: 3 tabs; Row 2: 2 tabs (wider — stretch fills the row). Chips
        // run 10% shorter than the Music-section originals (32px vs 36px) and
        // the two rows sit tighter (4px) so the player above gets the slack.
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                LiveTabRing { live: root.active-tab == "mymusic"; tint: #ec4899;
                    MusicTab { height: 32px; horizontal-stretch: 1; min-width: 0px; label: "My Music"; has-grad: true; grad-always: true; tint: #ec4899; grad: @linear-gradient(120deg, #ec4899, #f43f5e); active: root.active-tab == "mymusic"; clicked => { root.open-music("mymusic"); } } }
                LiveTabRing { live: root.active-tab == "podcasts"; tint: #8b5cf6;
                    MusicTab { height: 32px; horizontal-stretch: 1; min-width: 0px; label: "Podcasts"; has-grad: true; grad-always: true; tint: #8b5cf6; grad: @linear-gradient(120deg, #8b5cf6, #6366f1); active: root.active-tab == "podcasts"; clicked => { root.open-music("podcasts"); } } }
                LiveTabRing { live: root.active-tab == "audiobooks"; tint: #3b82f6;
                    MusicTab { height: 32px; horizontal-stretch: 1; min-width: 0px; label: "Audiobooks"; has-grad: true; grad-always: true; tint: #3b82f6; grad: @linear-gradient(120deg, #3b82f6, #06b6d4); active: root.active-tab == "audiobooks"; clicked => { root.open-music("audiobooks"); } } }
            }
            HorizontalLayout {
                spacing: 6px;
                LiveTabRing { live: root.active-tab == "radio"; tint: #14b8a6;
                    MusicTab { height: 32px; horizontal-stretch: 1; min-width: 0px; label: "Radio"; has-grad: true; grad-always: true; tint: #14b8a6; grad: @linear-gradient(120deg, #14b8a6, #22c55e); active: root.active-tab == "radio"; clicked => { root.open-music("radio"); } } }
                LiveTabRing { live: root.active-tab == "youtube"; tint: #ef4444;
                    MusicTab { height: 32px; horizontal-stretch: 1; min-width: 0px; label: "YouTube"; has-grad: true; grad-always: true; tint: #ef4444; grad: @linear-gradient(120deg, #ef4444, #f59e0b); active: root.active-tab == "youtube"; clicked => { root.open-music("youtube"); } } }
            }
        }
    }
}

// One coverflow card — rounded, shadowed photo, letterboxed (no crop).
component FlowCard inherits Rectangle {
    in property <image> img;
    in property <bool> fill: false;       // cover-fill the tile vs letterbox-contain
    in property <bool> top-crop: false;   // anchor the cover crop to the TOP of the photo
    clip: true; border-radius: 12px;
    background: #14161f;
    border-width: 1.5px; border-color: #ffffff5c;
    drop-shadow-blur: 18px; drop-shadow-color: #00000055; drop-shadow-offset-y: 6px;
    Image {
        source: root.img; width: 100%; height: 100%;
        image-fit: root.fill ? ImageFit.cover : ImageFit.contain;
        vertical-alignment: root.top-crop ? ImageVerticalAlignment.top : ImageVerticalAlignment.center;
    }
}

// One fan slot at fixed offset `k` from centre. Geometry derives from the shared
// float `pos` (which eases one notch per tick), giving heavy overlap + a stacked
// look; `k == 0` is the centre card and is declared last so it paints on top.
component FanSlot inherits FlowCard {
    in property <[image]> photos;
    in property <int> n;
    in property <float> pos;
    in property <int> k;
    in property <length> step;
    in property <length> areaw;
    in property <length> areah;
    in property <float> aspect: 1.0;                                // 1 = square, >1 = landscape (video)
    property <float> frac: root.pos - Math.floor(root.pos);
    property <float> rel: root.k - root.frac;                       // signed distance from centre
    // Sharp falloff (÷2.1) so only 5 cards ever carry opacity — the 6th buffer
    // card stays fully hidden until it becomes the incoming edge card.
    property <float> prox: Math.max(0, 1 - Math.abs(root.rel) / 2.1);
    // Sub-linear horizontal offset (mild compression) so the 3rd layer hugs the
    // 2nd for a stacked-deck read while the fan still reaches both card edges.
    property <float> off: root.rel * (1 - 0.05 * Math.abs(root.rel));
    img: root.photos[Math.mod(Math.floor(root.pos) + root.k, Math.max(root.n, 1))];
    // Big square tiles — all 5 near-full-height so they fill the card edge-to-edge
    // (centre only a little larger). Upright, vertically centred, no tilt/crop.
    height: root.areah * (0.63 + 0.12 * root.prox);                // ~25% smaller tiles
    width: root.height * root.aspect;                              // square (1) or landscape (video)
    x: root.areaw / 2 + root.off * root.step - root.width / 2;
    y: (root.areah - root.height) / 2;
    // Hard 0 past the fan edge (no opacity floor) so the 6th buffer card stays
    // fully invisible until it actually slides in as the new edge card.
    opacity: (root.n > 0 && root.prox > 0) ? 0.35 + 0.65 * root.prox : 0;
}

// Photos-tile coverflow — icon chip + a stacked fan of the 10 most-recent photos
// (centre biggest, neighbours peeking behind) that holds each photo ~2s then
// eases one step to the next. Clipped so nothing spills. Same accent shell +
// click target as HomeTile so it drops into the grid.
component PhotoSlideshow inherits Rectangle {
    in property <[image]> photos;
    in property <image> icon;
    in property <color> accent;
    in property <string> name;
    in property <string> stat;
    in property <string> footer: "";
    in property <bool> show-play: false;                           // Videos: play badge on centre
    in property <float> tile-aspect: 1.0;                          // 1 = square (photos), >1 landscape (video)
    in property <bool> tile-top: false;                            // top-anchor the cover crop (photos)
    in property <duration> cycle: 4000ms;                          // per-tile dwell (videos offset from photos)
    in property <image> empty-icon: Icons.image-off;              // shown when the library is empty
    callback clicked();
    callback open-item(int);                                       // open the centred item (viewer/player)
    property <int> n: photos.length;
    // Continuous head; Timer bumps it by 1 every 4s and `animate` eases the slow
    // ~1.4s wheel roll, so each photo sits centred for the ~2.6s remainder.
    property <float> pos: 0;
    animate pos { duration: 1400ms; easing: ease-in-out; }
    border-radius: 14px; clip: true;
    background: accent.with-alpha(ta.has-hover ? 0.14 : 0.08);
    // Distinct accent outline on hover (Photos vs Videos differ by accent colour).
    border-width: ta.has-hover ? 2.5px : 1px;
    border-color: accent.with-alpha(ta.has-hover ? 0.95 : 0.24);
    drop-shadow-blur: ta.has-hover ? 22px : 0px;
    drop-shadow-color: accent.with-alpha(0.45); drop-shadow-offset-y: ta.has-hover ? 6px : 0px;
    animate background, border-color, border-width, drop-shadow-blur, drop-shadow-offset-y { duration: 130ms; easing: ease-out; }
    // Click routing: only a hit on the CENTRE fan tile opens that item — any
    // other spot on the card opens the section (otherwise the whole card is a
    // file-open target and the section is unreachable). Centre tile geometry
    // mirrors FanSlot k=0 at rest: height = 0.75 × strip, width = height × aspect.
    ta := TouchArea { mouse-cursor: pointer;
        clicked => {
            if (root.n > 0
                && Math.abs(self.mouse-x - strip.width / 2) <= strip.height * 0.75 * root.tile-aspect / 2
                && Math.abs(self.mouse-y - strip.height / 2) <= strip.height * 0.75 / 2) {
                root.open-item(Math.mod(Math.floor(root.pos), root.n));
            } else {
                root.clicked();
            }
        } }
    // Fan strip — raised off the bottom edge so the sliding tiles never sit
    // underneath the (single-line) title pill overlaid at the bottom-left.
    strip := Rectangle {
        x: 0; y: 0; width: 100%; height: parent.height - 34px; clip: true;
        property <length> step: self.width * 0.2;                  // fan spread (outer compressed in FanSlot)
        Timer { interval: root.cycle; running: root.n > 1; triggered => { root.pos += 1; } }
        // Empty library — one big muted off-glyph in the middle.
        if root.n == 0: AppIcon {
            source: root.empty-icon; tint: root.accent.with-alpha(0.55);
            width: Math.min(strip.height * 0.5, 96px); height: self.width;
            x: (strip.width - self.width) / 2; y: (strip.height - self.height) / 2;
        }
        // Declared far→near so the centre (k == 0) paints on top of the stack.
        FanSlot { k: 3;  photos: root.photos; n: root.n; pos: root.pos; step: strip.step; areaw: strip.width; areah: strip.height; aspect: root.tile-aspect; fill: true; top-crop: root.tile-top; }
        FanSlot { k: -2; photos: root.photos; n: root.n; pos: root.pos; step: strip.step; areaw: strip.width; areah: strip.height; aspect: root.tile-aspect; fill: true; top-crop: root.tile-top; }
        FanSlot { k: 2;  photos: root.photos; n: root.n; pos: root.pos; step: strip.step; areaw: strip.width; areah: strip.height; aspect: root.tile-aspect; fill: true; top-crop: root.tile-top; }
        FanSlot { k: -1; photos: root.photos; n: root.n; pos: root.pos; step: strip.step; areaw: strip.width; areah: strip.height; aspect: root.tile-aspect; fill: true; top-crop: root.tile-top; }
        FanSlot { k: 1;  photos: root.photos; n: root.n; pos: root.pos; step: strip.step; areaw: strip.width; areah: strip.height; aspect: root.tile-aspect; fill: true; top-crop: root.tile-top; }
        FanSlot { k: 0;  photos: root.photos; n: root.n; pos: root.pos; step: strip.step; areaw: strip.width; areah: strip.height; aspect: root.tile-aspect; fill: true; top-crop: root.tile-top; }
        // Play badge on the centre card (Videos).
        if root.show-play && root.n > 0: Rectangle {
            width: 56px; height: 56px; border-radius: 28px;
            x: (strip.width - self.width) / 2; y: (strip.height - self.height) / 2;
            background: #000000b0;
            border-width: 2px; border-color: #ffffffe0;
            drop-shadow-blur: 16px; drop-shadow-color: #000000aa;
            AppIcon { source: Icons.play; tint: #ffffff; width: 24px; height: 24px;
                x: (parent.width - self.width) / 2 + 2px; y: (parent.height - self.height) / 2; }
        }
    }
    // Title pill — bottom-left, solid white box outlined with the card's accent.
    lbl := TitlePill {
        x: 14px; y: parent.height - self.height - 14px;
        icon: root.icon; accent: root.accent; name: root.name; stat: root.stat;
    }
}

// "+N" overflow chip used at the end of the Books/Cloud/Tools rows.
component MoreChip inherits Rectangle {
    in property <int> count;
    min-width: 56px;
    border-radius: 10px; border-width: 1.5px; border-color: Theme.outline;
    background: Theme.panel.with-alpha(0.5);
    Text { text: "+" + root.count; color: Theme.text-dim; font-size: 15px; font-weight: 700;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}

// Inner tile with hover feedback (shadow + lift + accent border) used for every
// clickable tile in the Books/Cloud/Tools rows.
component HomeTileBox inherits Rectangle {
    in property <color> hilite: Theme.text-dim;
    callback clicked();
    border-radius: 10px;
    background: tta.has-hover ? Theme.panel : Theme.panel-2;
    border-width: tta.has-hover ? 1.5px : 1px;
    border-color: tta.has-hover ? root.hilite : Theme.outline;
    drop-shadow-blur: tta.has-hover ? 16px : 0px;
    drop-shadow-color: #00000077; drop-shadow-offset-y: tta.has-hover ? 5px : 0px;
    animate background, border-color, drop-shadow-blur, drop-shadow-offset-y { duration: 130ms; easing: ease-out; }
    tta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    @children
}

// Shared shell for the row-preview cards (Books/Cloud/Tools): full-bleed content
// (@children) below a title pill overlaid top-left — the pill carries the bare
// accent-tinted section icon inside it, matching the Photos/Videos cards. Hover
// gets the same accent outline + shadow glow as the Photos/Videos cards.
component RowCard inherits Rectangle {
    in property <image> icon;
    in property <color> accent;
    in property <string> name;
    in property <string> stat;
    callback clicked();
    border-radius: 14px; clip: true;
    background: accent.with-alpha(ta.has-hover ? 0.14 : 0.08);
    border-width: ta.has-hover ? 2.5px : 1px;
    border-color: accent.with-alpha(ta.has-hover ? 0.95 : 0.24);
    drop-shadow-blur: ta.has-hover ? 22px : 0px;
    drop-shadow-color: accent.with-alpha(0.45); drop-shadow-offset-y: ta.has-hover ? 6px : 0px;
    animate background, border-color, border-width, drop-shadow-blur, drop-shadow-offset-y { duration: 130ms; easing: ease-out; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    // Content area — dropped below the (single-line) top-left title pill so
    // tiles never underlap it; @children fill it.
    Rectangle {
        x: 16px; y: 62px;
        width: parent.width - 32px;
        height: parent.height - 62px - 16px;
        @children
    }
    // Title pill — top-left overlay. Some cards (Cloud/Tools) suppress the
    // count — the "+N" tile already shows it.
    TitlePill {
        x: 14px; y: 14px;
        icon: root.icon; accent: root.accent; name: root.name; stat: root.stat;
    }
}

// Books card — 3 cover thumbnails + a "+N" box, all as small 9:16 portrait
// tiles sized so exactly four fit the row (uniform pills, evenly spread).
component BookRow inherits RowCard {
    in property <[image]> covers;
    in property <int> total;
    callback open-book(int);      // open a specific recent book in the reader
    property <int> shown: root.covers.length;
    area := Rectangle {
        width: 100%; height: 100%;
        // 9:16 tile — as tall as fits while four across (3 covers + "+N") still fit.
        property <length> tile-h: Math.min(self.height, ((self.width - 24px) / 4) * 16 / 9);
        property <length> tile-w: self.tile-h * 9 / 16;
        // Even leftover spread so the four pills fill the row edge to edge.
        property <length> gap: root.shown + (root.total - root.shown > 0 ? 1 : 0) > 1
            ? (self.width - (root.shown + (root.total - root.shown > 0 ? 1 : 0)) * self.tile-w)
              / ((root.shown + (root.total - root.shown > 0 ? 1 : 0)) - 1)
            : 0px;
        if root.covers.length == 0: AppIcon {
            source: Icons.book-off; tint: root.accent.with-alpha(0.55);
            width: Math.min(area.height * 0.6, 72px); height: self.width;
            x: (area.width - self.width) / 2; y: (area.height - self.height) / 2; }
        for bc[i] in root.covers: HomeTileBox {
            width: area.tile-w; height: area.tile-h;
            x: i * (area.tile-w + area.gap); y: (area.height - self.height) / 2;
            hilite: root.accent; clip: true;
            clicked => { root.open-book(i); }
            Image { source: bc; image-fit: cover; width: 100%; height: 100%; }
        }
        // "+N" tile → opens the Books section (handled by RowCard.clicked).
        // Same 9:16 size as the cover tiles so all four pills read uniform.
        if root.total - root.shown > 0: HomeTileBox {
            width: area.tile-w; height: area.tile-h;
            x: root.shown * (area.tile-w + area.gap); y: (area.height - self.height) / 2;
            hilite: root.accent; clicked => { root.clicked(); }
            Text { text: "+" + (root.total - root.shown); color: Theme.text-dim; font-size: 15px; font-weight: 700;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
    }
}

// Backend → brand colour (rclone backend names). Keeps the cloud glyph consistent
// per provider without bundling trademarked logos.
component CloudGlyph inherits AppIcon {
    in property <string> backend;
    source: Icons.cloud; width: 27px; height: 27px;
    tint: root.backend == "onedrive" ? #2b7cd3
        : (root.backend == "drive" || root.backend == "googlecloudstorage" || root.backend == "google cloud storage") ? #1a9f57
        : root.backend == "dropbox" ? #0061ff
        : root.backend == "box" ? #0061d5
        : (root.backend == "s3" || root.backend == "amazon s3") ? #e77600
        : root.backend == "mega" ? #d9272e
        : root.backend == "pcloud" ? #21a0ed
        : root.backend == "yandex" ? #ff3333
        : (root.backend == "webdav" || root.backend == "sftp" || root.backend == "ftp") ? #8b5cf6
        : Theme.sec-cloud;
}

// Cloud card — 3 remote tiles (centred brand-tinted glyph + name + backend) + "+N",
// equal width to fill the card. Each remote opens that remote in the Cloud page.
component CloudRow inherits RowCard {
    in property <[HomeRemote]> remotes;
    in property <int> total;
    callback open-remote(string);
    property <int> shown: root.remotes.length;
    HorizontalLayout {
        width: 100%; height: 100%; spacing: 8px;
        if root.remotes.length == 0: Rectangle { horizontal-stretch: 1;
            AppIcon { source: Icons.cloud-off; tint: root.accent.with-alpha(0.55);
                width: Math.min(parent.height * 0.6, 72px); height: self.width;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } }
        for r in root.remotes: HomeTileBox {
            horizontal-stretch: 1; hilite: root.accent; clicked => { root.open-remote(r.name); }
            VerticalLayout {
                padding: 8px; spacing: 4px; alignment: center;
                HorizontalLayout { alignment: center; CloudGlyph { backend: r.backend; } }
                Text { text: r.name; color: Theme.text; font-size: 11px; font-weight: 700;
                    horizontal-alignment: center; overflow: elide; }
                Text { text: r.backend; color: Theme.text-dim; font-size: 9px;
                    horizontal-alignment: center; overflow: elide; }
                // Storage usage ("11 GB / 5 GB") — rclone about, cached backend-side.
                if r.usage != "": Text { text: r.usage; color: root.accent; font-size: 9px; font-weight: 700;
                    horizontal-alignment: center; overflow: elide; }
            }
        }
        if root.total - root.shown > 0: HomeTileBox {
            horizontal-stretch: 1; hilite: root.accent; clicked => { root.clicked(); }
            Text { text: "+" + (root.total - root.shown); color: Theme.text-dim; font-size: 15px; font-weight: 700;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
    }
}

// A single tool tile (vector icon + label) with hover feedback. Uses a themed
// AppIcon (not an emoji glyph, which renders invisible on dark/oled themes).
component ToolTileBox inherits HomeTileBox {
    in property <image> icon;
    in property <string> label;
    in property <length> icon-size: 26px;
    in property <length> label-size: 10px;
    VerticalLayout {
        padding: 6px; spacing: 4px; alignment: center;
        HorizontalLayout { alignment: center;
            AppIcon { source: root.icon; tint: root.hilite; width: root.icon-size; height: root.icon-size; } }
        Text { text: root.label; color: Theme.text; font-size: root.label-size; font-weight: 700;
            horizontal-alignment: center; overflow: elide; }
    }
}

// Tools card — one representative tool per category (5), laid out 3×2, plus a
// "+N" box for every other tool across all categories. Each tile opens that tool
// category in the Tools page.
component ToolRow inherits RowCard {
    callback open-tool(string);
    in property <int> total-tools: 23;                             // total ops across all 5 categories
    property <[{icon: image, label: string, cat: string}]> tools: [
        { icon: Icons.folder,         label: "File ops",  cat: "fileops" },
        { icon: Icons.film,           label: "Video",     cat: "video" },
        { icon: Icons.music,          label: "Audio",     cat: "audio" },
        { icon: Icons.image,          label: "Photo",     cat: "photo" },
        { icon: Icons.message-circle, label: "Subtitles", cat: "subs" }];
    GridLayout {
        width: 100%; height: 100%; spacing: 8px;
        Row {
            ToolTileBox { hilite: root.accent; icon: root.tools[0].icon; label: root.tools[0].label; clicked => { root.open-tool(root.tools[0].cat); } }
            ToolTileBox { hilite: root.accent; icon: root.tools[1].icon; label: root.tools[1].label; clicked => { root.open-tool(root.tools[1].cat); } }
            ToolTileBox { hilite: root.accent; icon: root.tools[2].icon; label: root.tools[2].label; clicked => { root.open-tool(root.tools[2].cat); } }
        }
        Row {
            ToolTileBox { hilite: root.accent; icon: root.tools[3].icon; label: root.tools[3].label; clicked => { root.open-tool(root.tools[3].cat); } }
            ToolTileBox { hilite: root.accent; icon: root.tools[4].icon; label: root.tools[4].label; clicked => { root.open-tool(root.tools[4].cat); } }
            HomeTileBox { hilite: root.accent; clicked => { root.clicked(); }
                Text { text: "+" + (root.total-tools - 5); color: Theme.text-dim; font-size: 15px; font-weight: 700;
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; } }
        }
    }
}

// Right-hand section grid — Photos+Videos over Books+Cloud+Tools. Every tile
// gets an explicit width (cell2/cell3) so the row fills; stretch factors alone
// leave the tiles at icon width.
component HomeSectionGrid inherits VerticalLayout {
    in property <HomeStats> stats;
    in property <[image]> recent-photos: [];
    in property <[image]> recent-videos: [];
    in property <[image]> book-covers: [];
    in property <[HomeRemote]> cloud-remotes: [];
    in property <length> cell2;
    in property <length> cell3;
    callback open-section(string);
    callback open-photo-item(int);
    callback open-video-item(int);
    callback open-book-item(int);
    callback open-tool(string);
    callback open-remote(string);
    spacing: 10px;
    // Force both rows to exactly half so Photos/Videos stay as big as the
    // Books/Cloud/Tools row (whose icon+labels otherwise inflate its preferred
    // height and steal space from row 1).
    property <length> row-h: (self.height - self.spacing) / 2;
    HorizontalLayout {
        spacing: 10px; height: root.row-h;
        PhotoSlideshow { width: cell2; icon: Icons.image; accent: Theme.sec-photos; name: "Photos";
            photos: root.recent-photos; tile-top: true;                       // fill square, crop from top
            empty-icon: Icons.image-off;
            stat: stats.photos + " items · " + stats.photos-albums + " albums";
            footer: stats.photos-scan; clicked => { root.open-section("photos"); }
            open-item(i) => { root.open-photo-item(i); } }
        PhotoSlideshow { width: cell2; icon: Icons.film; accent: Theme.sec-videos; name: "Videos";
            photos: root.recent-videos; show-play: true; tile-aspect: 1.6;     // landscape video tiles, centre crop
            cycle: 3000ms; empty-icon: Icons.video-off;                        // offset from Photos' 4s
            stat: stats.videos + " items · " + stats.videos-shows + " shows";
            footer: stats.videos-note; clicked => { root.open-section("videos"); }
            open-item(i) => { root.open-video-item(i); } }
    }
    HorizontalLayout {
        spacing: 10px; height: root.row-h;
        BookRow { width: cell3; icon: Icons.book-open; accent: Theme.sec-books; name: "Books";
            covers: root.book-covers; total: stats.books;
            stat: stats.books + " books · " + stats.books-reading + " reading";
            clicked => { root.open-section("books"); } open-book(i) => { root.open-book-item(i); } }
        CloudRow { width: cell3; icon: Icons.cloud; accent: Theme.sec-cloud; name: "Cloud";
            remotes: root.cloud-remotes; total: stats.cloud-remotes;
            stat: "";
            clicked => { root.open-section("cloud"); } open-remote(n) => { root.open-remote(n); } }
        ToolRow { width: cell3; icon: Icons.wrench; accent: Theme.sec-tools; name: "Tools";
            stat: "";
            clicked => { root.open-section("tools"); } open-tool(c) => { root.open-tool(c); } }
    }
}

export component HomePage inherits Rectangle {
    in property <HomeStats> stats;
    in property <[image]> recent-photos: [];       // 10 newest photo thumbs → Photos slideshow
    in property <[image]> recent-videos: [];       // 10 newest video thumbs → Videos slideshow
    in property <[image]> book-covers: [];         // recent book covers → Books row
    in property <[HomeRemote]> cloud-remotes: [];  // cloud remotes → Cloud row
    in property <string> greeting: "Welcome";
    in property <string> date-line: "";
    in property <int> logo-choice: 0;
    in property <string> user-secondary: "";
    in property <image> avatar-image;
    in property <string> avatar-emoji: "";
    in property <bool> music-left: false;          // music block on the left vs right
    // now-playing feed
    in property <string> np-title: ""; in property <string> np-sub: ""; in property <string> np-album: "";
    in property <image> np-art; in property <color> np-accent: Theme.sec-music;
    in property <bool> playing: false;
    in property <float> pos: 0; in property <float> dur: 1;
    in property <string> pos-label: ""; in property <string> dur-label: "";
    in property <bool> shuffle: false;
    in property <float> volume: 1; in property <bool> muted: false;
    in property <string> repeat: "off";
    // Content-type player switch (mirror the Music section) + queue/lyrics sync.
    in property <string> player-mode: "music";
    in property <[MusicSongRow]> queue-rows: [];
    in property <[MusicLyricLine]> lyrics-rows: [];
    in property <int> lyrics-active: -1;
    in property <string> radio-initial: "";
    in property <bool> yt-now-video: false;
    in property <float> podcast-speed: 1.0;
    in property <[PodcastEpisodeRow]> podcast-episodes: [];
    in property <string> podcast-summary: "";
    // Header spectrum (np.p6.home.header-viz) — zen-player VizView riding the
    // header canvas while anything plays; the waveform chip hides it.
    in property <[float]> vis-bars: [];
    in property <int> vis-style: 4;
    property <bool> header-viz: true;
    property <bool> viz-lyrics: true;      // active synced line rides the spectrum
    callback set-vis-style(int);           // persists via music-set-vis-style
    // Header spectrum only for My Music + Radio — podcasts/audiobooks/YouTube
    // don't drive it. Radio additionally has no synced lyrics to show.
    property <bool> viz-allowed: root.playing
        && (root.player-mode == "radio" || (root.player-mode == "music" && !root.yt-now-video));
    property <bool> viz-lyrics-ok: root.player-mode == "music" && !root.yt-now-video;

    callback open-section(string);
    callback open-photo-item(int);
    callback open-video-item(int);
    callback open-book-item(int);
    callback open-tool(string);
    callback open-remote(string);
    callback open-music(string);
    callback open-now-album();
    callback open-now-artist();
    callback open-profile();
    // CONTINUE strip v2 — model comes filtered from the backend; the chips just
    // report the wanted kind ("all" | "book" | "podcast" | "audiobook").
    in property <[HomeContinue]> continue-rows: [];
    property <string> cont-filter: "all";
    callback continue-filter(string);
    callback continue-open(HomeContinue);
    callback continue-remove(HomeContinue);
    // ⋮ menu + remove confirmation state.
    property <int> cont-menu-idx: -1;
    property <HomeContinue> cont-menu-item;
    property <bool> cont-confirm-open: false;
    callback playpause(); callback next(); callback prev();
    callback seek(float); callback set-volume(float);
    callback toggle-mute(); callback toggle-shuffle(); callback cycle-repeat();
    callback play-queue(int); callback watch-video();
    callback podcast-skip(int); callback podcast-set-speed(float); callback podcast-play(int);
    callback open-zen();
    callback open-search();
    callback add-folder();
    callback shuffle-all();
    callback open-download();
    callback random-radio();      // play a random Hindi radio station in the home player
    callback toggle-music-side(); // header button: flip the music card left/right

    background: transparent;

    // Grid geometry (pure, no layout feedback).
    property <length> grid-w: root.width - 32px;
    // No footer row anymore — reclaim its ~30px into the content area so the last
    // row grows to fill it (cards look complete, no dead strip at the bottom).
    property <length> content-h: root.height - 32px - 84px - 12px;
    property <length> row3-h: 244px;
    property <length> bento-h: content-h - row3-h - 10px;
    // Scale the embedded player up to fill the music column (design = big player).
    // ~112px of card chrome (padding + MUSIC cap + two tab rows); 488px is the
    // player's natural height at scale 1. Bias slightly under so the art-stretch
    // absorbs the residual instead of clipping the bottom controls.
    // Card chrome shrank (32px tabs, 4px row gap) but the embedded player grew
    // taller pills — natural height is now ~505px with ~104px of chrome.
    property <float> player-scale: Math.clamp((bento-h - 104px) / 505px, 1.0, 1.7);
    property <length> music-w: 300px * player-scale + 40px;
    property <length> right-area: grid-w - music-w - 10px;
    property <length> cell2: (right-area - 10px) / 2;
    property <length> cell3: (right-area - 20px) / 3;
    // CONTINUE pill geometry — pure root math (layout-derived widths loop).
    // Card width = grid minus the quick-actions column; 4 slots inside padding
    // (4 wider pills so the 3:4 cover thumb isn't a skinny sliver).
    property <length> cont-w: grid-w - (grid-w - 10px) / 3 - 10px;
    property <length> cont-slot-w: (cont-w - 28px - 24px) / 4;
    // Cover thumb inside a pill: pill height = row3 minus card padding (28)
    // + header row (35px title pill) + spacing (10); thumb height = pill minus
    // its padding (20). Narrower than 3:4 (×0.6) so four pills always fit
    // inside the card even on tighter windows.
    property <length> cont-thumb-w: (row3-h - 93px) * 3 / 5;

    VerticalLayout {
        padding: 16px; spacing: 10px;

        // ── Header (150%) ──────────────────────────────────────────
        HorizontalLayout {
            spacing: 16px; height: 84px;
            Rectangle {
                width: 84px; height: 84px; border-radius: 20px; clip: true;
                horizontal-stretch: 0; vertical-stretch: 0;
                Image {
                    source: root.logo-choice == 1 ? @image-url("../resources/appicons/sidebar-color.png")
                          : root.logo-choice == 2 ? @image-url("../resources/appicons/sidebar-dark.png")
                          : root.logo-choice == 3 ? @image-url("../resources/appicons/sidebar-white.png")
                          :                         @image-url("../resources/appicons/sidebar-default.png");
                    image-fit: cover; width: 100%; height: 100%;
                }
            }
            VerticalLayout {
                alignment: center; spacing: 5px; horizontal-stretch: 0; min-width: 0;
                Text { text: greeting; color: Theme.text; font-size: 30px; font-weight: 800; overflow: elide; }
                Text { text: date-line + (user-secondary == "" ? "" : " · " + user-secondary);
                    color: Theme.text-dim; font-size: 14px; overflow: elide; }
            }
            // Zen-player spectrum spanning the header gap — borderless so it
            // reads as part of the header, not a boxed card; only while playing.
            Rectangle {
                horizontal-stretch: 1; min-width: 0; clip: true;
                if root.viz-allowed && root.header-viz: VizView {
                    width: 100%; height: 100%;
                    bars: root.vis-bars; style: root.vis-style; active: true;
                }
                // Active synced-lyric line riding the spectrum — white pill,
                // dead center; single line only (no prev/next context).
                if root.viz-allowed && root.header-viz && root.viz-lyrics && root.viz-lyrics-ok
                    && root.lyrics-active >= 0 && root.lyrics-rows.length > 0: Rectangle {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: Math.min(hlyr.preferred-width + 28px, parent.width - 16px);
                    height: 30px; border-radius: 15px;
                    background: #ffffff; border-width: 1px; border-color: #00000022;
                    drop-shadow-blur: 12px; drop-shadow-color: #00000040;
                    hlyr := Text { x: 12px; width: parent.width - 24px; height: 100%;
                        text: root.lyrics-rows[root.lyrics-active].text;
                        color: #14141b; font-size: 13px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                }
            }
            // Waveform chip — opens the visualizer menu (5 styles like the
            // Music section, Off, and the lyric-pill toggle); only offered
            // while something plays (the spectrum is gone otherwise anyway).
            if root.viz-allowed: VerticalLayout { alignment: center;
                Rectangle {
                    width: 30px; height: 30px; border-radius: 15px;
                    background: root.header-viz ? Accent.color : (vt.has-hover ? Theme.panel : Theme.panel-2);
                    border-width: 1px; border-color: root.header-viz ? Accent.color : Theme.outline;
                    animate background { duration: 120ms; }
                    vt := TouchArea { mouse-cursor: pointer; clicked => { viz-menu.show(); } }
                    AppIcon { source: Icons.waveform; tint: root.header-viz ? #ffffff : Theme.text;
                        width: 15px; height: 15px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                    viz-menu := PopupWindow {
                        x: -110px; y: 36px; width: 140px; close-policy: close-on-click-outside;
                        Rectangle { width: 100%; border-radius: 10px; background: Theme.panel;
                            border-width: 1px; border-color: Theme.outline;
                            drop-shadow-blur: 24px; drop-shadow-color: #00000066;
                            // NOTE: viz-menu.close() must be the LAST statement in every
                            // row callback — closing first deletes the row mid-eval and
                            // panics the live-preview interpreter (slint issue #6426).
                            VerticalLayout { padding: 6px; spacing: 2px;
                                for n[i] in ["Bars", "Mirror", "Dots", "Levels", "Line"]: Rectangle {
                                    height: 26px; border-radius: 6px;
                                    background: (root.header-viz && root.vis-style == i) ? Accent.color.with-alpha(0.18) : (vmi.has-hover ? Theme.panel-2 : transparent);
                                    vmi := TouchArea { mouse-cursor: pointer;
                                        clicked => { root.header-viz = true; root.set-vis-style(i); viz-menu.close(); } }
                                    Text { text: n; color: (root.header-viz && root.vis-style == i) ? Accent.color : Theme.text; font-size: 12px;
                                        font-weight: (root.header-viz && root.vis-style == i) ? 700 : 500; x: 10px; vertical-alignment: center; height: 100%; } }
                                Rectangle { height: 1px; background: Theme.outline; }
                                Rectangle { height: 26px; border-radius: 6px;
                                    background: !root.header-viz ? Accent.color.with-alpha(0.18) : (vm0.has-hover ? Theme.panel-2 : transparent);
                                    vm0 := TouchArea { mouse-cursor: pointer; clicked => { root.header-viz = false; viz-menu.close(); } }
                                    Text { text: "Off Viz"; color: !root.header-viz ? Accent.color : Theme.text; font-size: 12px;
                                        font-weight: !root.header-viz ? 700 : 500; x: 10px; vertical-alignment: center; height: 100%; } }
                                // Radio has no synced lyrics — hide the toggle there.
                                if root.viz-lyrics-ok: Rectangle { height: 26px; border-radius: 6px;
                                    background: vml.has-hover ? Theme.panel-2 : transparent;
                                    vml := TouchArea { mouse-cursor: pointer; clicked => { root.viz-lyrics = !root.viz-lyrics; viz-menu.close(); } }
                                    Text { text: root.viz-lyrics ? "Lyrics · on" : "Lyrics · off";
                                        color: root.viz-lyrics ? Accent.color : Theme.text; font-size: 12px;
                                        font-weight: root.viz-lyrics ? 700 : 500; x: 10px; vertical-alignment: center; height: 100%; } }
                            } } }
                }
            }
            VerticalLayout { alignment: center;
                // Flip the music card to the other side of the board — the
                // toggle persists (home.music-left) and applies live.
                HomeChip { label: root.music-left ? "Music → Right" : "Music → Left";
                    clicked => { root.toggle-music-side(); } }
            }
            Rectangle {
                width: 64px; horizontal-stretch: 0;
                avatar := Rectangle {
                    width: av.has-hover ? 62px : 56px; height: self.width;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: self.width / 2; clip: true;
                    background: @linear-gradient(135deg, Theme.brand 0%, Theme.brand-2 100%);
                    border-width: av.has-hover ? 2px : 0px;
                    border-color: Theme.brand.with-alpha(0.6);
                    animate width, border-width { duration: 140ms; easing: ease-out; }
                    av := TouchArea { mouse-cursor: pointer; clicked => { root.open-profile(); } }
                    if avatar-image.width != 0: Image { source: avatar-image; image-fit: cover; width: 100%; height: 100%; }
                    if avatar-image.width == 0 && avatar-emoji != "": Text { text: avatar-emoji; font-size: 26px;
                        width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center; }
                    if avatar-image.width == 0 && avatar-emoji == "": AppIcon { source: Icons.user; tint: #ffffff;
                        width: 24px; height: 24px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
                }
                // Online-style status dot (design parity) — sits on the avatar edge.
                Rectangle {
                    width: 14px; height: 14px; border-radius: 7px;
                    x: avatar.x + avatar.width - self.width - 1px;
                    y: avatar.y + avatar.height - self.height - 1px;
                    background: #22c55e; border-width: 2px; border-color: Theme.panel;
                }
            }
        }

        // ── Card board (np.p6.home.edit-layout) — every card lives in a
        // movable EditWrap; defaults reproduce the old bento + row-3 grid.
        board := Rectangle {
            vertical-stretch: 1;
            property <length> rh: (root.bento-h - 10px) / 2;
            property <length> gx: root.music-left ? root.music-w + 10px : 0px;
            BoardSlot {
                width: root.cell2; height: board.rh;
                board-w: board.width; board-h: board.height;
                dfx: board.gx / Math.max(board.width - self.width, 1px); dfy: 0;
                PhotoSlideshow { width: 100%; height: 100%; icon: Icons.image; accent: Theme.sec-photos; name: "Photos";
                    photos: root.recent-photos; tile-top: true; empty-icon: Icons.image-off;
                    stat: root.stats.photos + " items · " + root.stats.photos-albums + " albums";
                    footer: root.stats.photos-scan; clicked => { root.open-section("photos"); }
                    open-item(i) => { root.open-photo-item(i); } }
            }
            BoardSlot {
                width: root.cell2; height: board.rh;
                board-w: board.width; board-h: board.height;
                dfx: (board.gx + root.cell2 + 10px) / Math.max(board.width - self.width, 1px); dfy: 0;
                PhotoSlideshow { width: 100%; height: 100%; icon: Icons.film; accent: Theme.sec-videos; name: "Videos";
                    photos: root.recent-videos; show-play: true; tile-aspect: 1.6;
                    cycle: 3000ms; empty-icon: Icons.video-off;
                    stat: root.stats.videos + " items · " + root.stats.videos-shows + " shows";
                    footer: root.stats.videos-note; clicked => { root.open-section("videos"); }
                    open-item(i) => { root.open-video-item(i); } }
            }
            BoardSlot {
                width: root.cell3; height: board.rh;
                board-w: board.width; board-h: board.height;
                dfx: board.gx / Math.max(board.width - self.width, 1px);
                dfy: (board.rh + 10px) / Math.max(board.height - self.height, 1px);
                BookRow { width: 100%; height: 100%; icon: Icons.book-open; accent: Theme.sec-books; name: "Books";
                    covers: root.book-covers; total: root.stats.books;
                    stat: root.stats.books + " books · " + root.stats.books-reading + " reading";
                    clicked => { root.open-section("books"); } open-book(i) => { root.open-book-item(i); } }
            }
            BoardSlot {
                width: root.cell3; height: board.rh;
                board-w: board.width; board-h: board.height;
                dfx: (board.gx + root.cell3 + 10px) / Math.max(board.width - self.width, 1px);
                dfy: (board.rh + 10px) / Math.max(board.height - self.height, 1px);
                CloudRow { width: 100%; height: 100%; icon: Icons.cloud; accent: Theme.sec-cloud; name: "Cloud";
                    remotes: root.cloud-remotes; total: root.stats.cloud-remotes; stat: "";
                    clicked => { root.open-section("cloud"); } open-remote(n) => { root.open-remote(n); } }
            }
            BoardSlot {
                width: root.cell3; height: board.rh;
                board-w: board.width; board-h: board.height;
                dfx: (board.gx + 2 * (root.cell3 + 10px)) / Math.max(board.width - self.width, 1px);
                dfy: (board.rh + 10px) / Math.max(board.height - self.height, 1px);
                ToolRow { width: 100%; height: 100%; icon: Icons.wrench; accent: Theme.sec-tools; name: "Tools"; stat: "";
                    clicked => { root.open-section("tools"); } open-tool(c) => { root.open-tool(c); } }
            }
            BoardSlot {
                width: root.music-w; height: root.bento-h;
                board-w: board.width; board-h: board.height;
                dfx: root.music-left ? 0 : 1; dfy: 0;
                HomeMusicCard {
                    width: 100%; height: 100%;
                    np-art: root.np-art; np-accent: root.np-accent; np-title: root.np-title; np-sub: root.np-sub; np-album: root.np-album;
                    playing: root.playing; pos: root.pos; dur: root.dur;
                    pos-label: root.pos-label; dur-label: root.dur-label;
                    shuffle: root.shuffle; repeat: root.repeat; volume: root.volume; muted: root.muted;
                    player-mode: root.player-mode; player-scale: root.player-scale;
                    queue-rows: root.queue-rows; lyrics-rows: root.lyrics-rows; lyrics-active: root.lyrics-active;
                    radio-initial: root.radio-initial; yt-now-video: root.yt-now-video;
                    podcast-speed: root.podcast-speed; podcast-episodes: root.podcast-episodes; podcast-summary: root.podcast-summary;
                    playpause => { root.playpause(); } next => { root.next(); } prev => { root.prev(); }
                    seek(s) => { root.seek(s); } set-volume(v) => { root.set-volume(v); }
                    toggle-shuffle => { root.toggle-shuffle(); } cycle-repeat => { root.cycle-repeat(); }
                    toggle-mute => { root.toggle-mute(); } open-zen => { root.open-zen(); }
                    play-queue(i) => { root.play-queue(i); } watch-video => { root.watch-video(); }
                    podcast-skip(s) => { root.podcast-skip(s); } podcast-set-speed(v) => { root.podcast-set-speed(v); }
                    podcast-play(id) => { root.podcast-play(id); }
                    open-music(v) => { root.open-music(v); }
                    open-now-album => { root.open-now-album(); }
                    open-now-artist => { root.open-now-artist(); }
                }
            }

            // ── Continue + quick actions (former row 3) ────────────
            BoardSlot {
                width: root.cont-w; height: root.row3-h;
                board-w: board.width; board-h: board.height;
                dfx: 0; dfy: 1;
            Rectangle {
                width: 100%; height: 100%; border-radius: 14px;
                // Pink reads brighter than the other accents — 0.03 matches the
                // dark cards' perceived fill; idle chrome matches Photos/Videos
                // (24% hairline, no glow) so the card sits flat until hovered.
                background: Theme.sec-music.with-alpha(conthov.has-hover ? 0.10 : 0.03);
                border-width: conthov.has-hover ? 2.5px : 1px;
                border-color: Theme.sec-music.with-alpha(conthov.has-hover ? 0.95 : 0.24);
                drop-shadow-blur: conthov.has-hover ? 22px : 0px;
                drop-shadow-color: Theme.sec-music.with-alpha(0.45);
                drop-shadow-offset-y: conthov.has-hover ? 6px : 0px;
                animate background, border-color, border-width, drop-shadow-blur, drop-shadow-offset-y { duration: 130ms; easing: ease-out; }
                conthov := TouchArea { }
                VerticalLayout {
                    padding: 14px; spacing: 10px;
                    // Title pill (Photos-card treatment) + kind filter chips.
                    HorizontalLayout {
                        spacing: 6px;
                        TitlePill { icon: Icons.rotate-ccw; accent: Theme.sec-music; name: "Continue"; }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout { alignment: center;
                            HorizontalLayout { spacing: 6px;
                                HomeChip { label: "All"; emphasized: root.cont-filter == "all"; accent: Theme.sec-music;
                                    clicked => { root.cont-menu-idx = -1; root.cont-filter = "all"; root.continue-filter("all"); } }
                                HomeChip { label: "Videos"; emphasized: root.cont-filter == "video"; accent: Theme.sec-videos;
                                    clicked => { root.cont-menu-idx = -1; root.cont-filter = "video"; root.continue-filter("video"); } }
                                HomeChip { label: "Books"; emphasized: root.cont-filter == "book"; accent: Theme.sec-books;
                                    clicked => { root.cont-menu-idx = -1; root.cont-filter = "book"; root.continue-filter("book"); } }
                                HomeChip { label: "Podcasts"; emphasized: root.cont-filter == "podcast"; accent: #8b5cf6;
                                    clicked => { root.cont-menu-idx = -1; root.cont-filter = "podcast"; root.continue-filter("podcast"); } }
                                HomeChip { label: "Audiobooks"; emphasized: root.cont-filter == "audiobook"; accent: #3b82f6;
                                    clicked => { root.cont-menu-idx = -1; root.cont-filter = "audiobook"; root.continue-filter("audiobook"); } }
                            }
                        }
                    }
                    // Rich resume cards — FIVE fixed pill slots (design parity), filled
                    // left→right with only as many items as exist; never stretched.
                    HorizontalLayout {
                        spacing: 8px; vertical-stretch: 1; alignment: start;
                        if root.continue-rows.length == 0: Text {
                            text: "Nothing in progress — resume points from books, podcasts and audiobooks show up here.";
                            color: Theme.text-dim; font-size: 10px; wrap: word-wrap;
                            vertical-alignment: center; }
                        for r[i] in root.continue-rows: ccard := Rectangle {
                            width: root.cont-slot-w; border-radius: 10px;
                            property <color> kaccent: r.kind == "book" ? Theme.sec-books
                                : r.kind == "video" ? Theme.sec-videos
                                : r.kind == "podcast" ? #8b5cf6 : #3b82f6;
                            background: cta.has-hover ? Theme.panel : Theme.panel.with-alpha(0.6);
                            border-width: 1px;
                            border-color: cta.has-hover ? ccard.kaccent.with-alpha(0.6) : Theme.outline;
                            animate background, border-color { duration: 120ms; easing: ease-out; }
                            cta := TouchArea { mouse-cursor: pointer; clicked => { root.continue-open(r); } }
                            HorizontalLayout {
                                padding: 10px; spacing: 10px;
                                // Cover — full-height 3:4 portrait; kind icon fallback.
                                Rectangle {
                                    width: root.cont-thumb-w; border-radius: 8px; clip: true;
                                    background: ccard.kaccent.with-alpha(0.15);
                                    if r.cover.width > 0: Image { source: r.cover; image-fit: cover; width: 100%; height: 100%; }
                                    if r.cover.width == 0: AppIcon {
                                        source: r.kind == "book" ? Icons.book-open : r.kind == "video" ? Icons.film : r.kind == "podcast" ? Icons.mic : Icons.headphones;
                                        tint: ccard.kaccent; width: 22px; height: 22px;
                                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                }
                                // Design order, top-down: big title → author → spring →
                                // progress text → fill bar pinned at the bottom.
                                VerticalLayout {
                                    spacing: 3px; horizontal-stretch: 1; min-width: 0;
                                    padding-right: 12px;   // keep the title clear of the ⋮ button
                                    // Spacer drops the title BELOW the kind tag + ⋮ button
                                    // (y 4‥24px) so long first lines never collide with them.
                                    Rectangle { height: 14px; }
                                    // Up-to-4-line wrapping title — max-height (not fixed) so
                                    // short titles keep the author snug underneath; elide trims
                                    // only what still overflows line 4.
                                    Text { text: r.title; color: Theme.text; font-size: 12px; font-weight: 800;
                                        max-height: 62px; wrap: word-wrap; overflow: elide; }
                                    // Up-to-2-line author/show line.
                                    if r.author != "": Text { text: r.author; color: Theme.text-dim; font-size: 10px;
                                        max-height: 27px; wrap: word-wrap; overflow: elide; }
                                    Rectangle { vertical-stretch: 1; }
                                    Text { text: r.sub; color: Theme.text-dim; font-size: 10px; font-weight: 600; overflow: elide; }
                                    if r.frac >= 0: Rectangle {
                                        height: 4px; border-radius: 2px; background: Theme.panel-2;
                                        Rectangle { x: 0; y: 0; width: parent.width * Math.clamp(r.frac, 0, 1);
                                            height: 100%; border-radius: 2px; background: ccard.kaccent; }
                                    }
                                }
                            }
                            // Kind tag — sits left of the ⋮ on every tab so each
                            // pill says where it comes from (kind-tinted mini chip).
                            Rectangle {
                                x: parent.width - self.width - 28px; y: 4px;
                                width: tagrow.preferred-width; height: 18px;
                                border-radius: 9px;
                                background: ccard.kaccent.with-alpha(0.15);
                                border-width: 1px; border-color: ccard.kaccent.with-alpha(0.55);
                                tagrow := HorizontalLayout {
                                    padding-left: 7px; padding-right: 7px;
                                    Text {
                                        text: r.kind == "book" ? "BOOK"
                                            : r.kind == "video" ? "VIDEO"
                                            : r.kind == "podcast" ? "PODCAST" : "AUDIOBOOK";
                                        color: ccard.kaccent; font-size: 8px; font-weight: 800;
                                        letter-spacing: 0.6px; vertical-alignment: center;
                                    }
                                }
                            }
                            // ⋮ menu button — top-right corner of the pill.
                            mta := TouchArea {
                                x: parent.width - 24px; y: 4px; width: 20px; height: 20px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.cont-menu-item = r;
                                    root.cont-menu-idx = root.cont-menu-idx == i ? -1 : i;
                                }
                                Rectangle {
                                    border-radius: 6px;
                                    background: mta.has-hover ? Theme.panel-2 : transparent;
                                    Text { text: "⋮"; color: Theme.text-dim; font-size: 13px; font-weight: 800;
                                        width: 100%; height: 100%;
                                        horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            // Context menu — single "Remove" action → confirmation box.
                            if root.cont-menu-idx == i: Rectangle {
                                x: parent.width - 108px; y: 26px; width: 102px; height: 32px;
                                border-radius: 8px; background: Theme.panel;
                                border-width: 1px; border-color: Theme.outline;
                                drop-shadow-blur: 14px; drop-shadow-color: #00000077;
                                TouchArea { mouse-cursor: pointer;
                                    clicked => { root.cont-menu-idx = -1; root.cont-confirm-open = true; } }
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 7px;
                                    VerticalLayout { alignment: center;
                                        AppIcon { source: Icons.trash; tint: #ef4444; width: 13px; height: 13px; } }
                                    Text { text: "Remove"; color: #ef4444; font-size: 11px; font-weight: 700;
                                        vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
            }
            BoardSlot {
                width: (root.grid-w - 10px) / 3; height: root.row3-h;
                board-w: board.width; board-h: board.height;
                dfx: (root.cont-w + 10px) / Math.max(board.width - self.width, 1px); dfy: 1;
            Rectangle {
                width: 100%; height: 100%; border-radius: 14px;
                background: Theme.sec-videos.with-alpha(qahov.has-hover ? 0.14 : 0.08);
                border-width: qahov.has-hover ? 2.5px : 1px;
                border-color: Theme.sec-videos.with-alpha(qahov.has-hover ? 0.95 : 0.24);
                drop-shadow-blur: qahov.has-hover ? 22px : 0px;
                drop-shadow-color: Theme.sec-videos.with-alpha(0.45);
                drop-shadow-offset-y: qahov.has-hover ? 6px : 0px;
                animate background, border-color, border-width, drop-shadow-blur, drop-shadow-offset-y { duration: 130ms; easing: ease-out; }
                qahov := TouchArea { }
                VerticalLayout {
                    padding: 14px; spacing: 10px;
                    // Title pill matching the other cards.
                    HorizontalLayout {
                        TitlePill { icon: Icons.zap; accent: Theme.sec-videos; name: "Quick Actions"; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    // 2×2 action grid — icon above name (ToolTileBox), each action
                    // tinted with its target section's hue.
                    GridLayout {
                        spacing: 8px; vertical-stretch: 1;
                        Row {
                            ToolTileBox { hilite: #ec4899; icon: Icons.download; label: "Music Downloader";
                                icon-size: 32px; label-size: 12px; clicked => { root.open-download(); } }
                            ToolTileBox { hilite: #8b5cf6; icon: Icons.shuffle; label: "Shuffle All";
                                icon-size: 32px; label-size: 12px; clicked => { root.shuffle-all(); } }
                        }
                        Row {
                            ToolTileBox { hilite: Theme.sec-videos; icon: Icons.folder-open; label: "Add Folder";
                                icon-size: 32px; label-size: 12px; clicked => { root.add-folder(); } }
                            ToolTileBox { hilite: #14b8a6; icon: Icons.radio; label: "Random Radio";
                                icon-size: 32px; label-size: 12px; clicked => { root.random-radio(); } }
                        }
                    }
                }
            }
            }
        }

    }

    // Remove-from-Continue confirmation — Enter removes, Escape cancels,
    // backdrop click cancels. Painted above the whole page.
    if root.cont-confirm-open: Rectangle {
        width: 100%; height: 100%; background: #00000088;
        TouchArea { clicked => { root.cont-confirm-open = false; } }
        FocusScope {
            width: 100%; height: 100%;
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Return) {
                    root.continue-remove(root.cont-menu-item);
                    root.cont-confirm-open = false;
                    return accept;
                }
                if (e.text == Key.Escape) { root.cont-confirm-open = false; return accept; }
                reject
            }
            Rectangle {
                width: 340px; height: dlg.preferred-height;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: 14px; background: Theme.panel;
                border-width: 1.5px; border-color: Theme.outline;
                drop-shadow-blur: 30px; drop-shadow-color: #000000aa;
                TouchArea { }   // eat clicks so the backdrop-cancel doesn't fire under the box
                dlg := VerticalLayout {
                    padding: 16px; spacing: 10px;
                    Text { text: "Remove from Continue?"; color: Theme.text; font-size: 14px; font-weight: 800; }
                    Text { text: root.cont-menu-item.title; color: Theme.text-dim; font-size: 11px; overflow: elide; }
                    Text { text: "Enter to remove · Esc to cancel"; color: Theme.text-dim.with-alpha(0.7); font-size: 9px; }
                    HorizontalLayout {
                        spacing: 8px; alignment: end;
                        HomeChip { label: "Cancel"; clicked => { root.cont-confirm-open = false; } }
                        HomeChip { label: "Remove"; emphasized: true; accent: #ef4444;
                            clicked => { root.continue-remove(root.cont-menu-item); root.cont-confirm-open = false; } }
                    }
                }
            }
        }
    }
}
