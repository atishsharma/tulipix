// Generic, data-driven settings rows. Each new Settings tab is just a
// `SettingsList` bound to a model of `SettingItem`s seeded in Rust, so adding
// a toggle / endpoint field / status line needs no new component.
import { Theme, Accent } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";
import { ScrollView } from "std-widgets.slint";

export struct SettingItem {
    key: string,
    kind: string,     // "toggle" | "text" | "status" | "action" | "header" | "status-action" | "model-choice"
    label: string,
    desc: string,
    value: string,    // text value · status value · action button label · chosen model key
    on: bool,         // toggle state
    state: string,    // status tint: "ok" | "warn" | "error" | "muted" | "busy"
    btn: string,      // status-action: trailing button label
    frac: float,      // busy rows: 0..1 determinate progress (<=0 = sweep)
}

component PillToggle inherits Skin {
    in property <bool> on;
    callback toggled(bool);
    width: 48px; height: 26px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: Surface.rr(13px, self.width, self.height);
    background: on ? Accent.color : Theme.outline;
    animate background { duration: 140ms; easing: ease-out; }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(!root.on); } }
    Rectangle {
        width: 20px; height: 20px; border-radius: Surface.rr(10px, self.width, self.height); background: #ffffff;
        x: on ? parent.width - self.width - 3px : 3px;
        y: (parent.height - self.height) / 2;
        animate x { duration: 140ms; easing: ease-out; }
    }
}

component StatusDot inherits Skin {
    in property <string> state;
    width: 9px; height: 9px; border-radius: Surface.rr(5px, self.width, self.height);
    horizontal-stretch: 0; vertical-stretch: 0;
    background:
        state == "ok"    ? Theme.ok :
        state == "warn"  ? #f59e0b :
        state == "error" ? #dc2626 :
                           Theme.text-dim;
}

component Btn inherits Skin {
    in property <string> label;
    callback clicked();
    height: 30px; min-width: 110px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: Surface.rr(8px, self.width, self.height);
    background: touch.has-hover ? Theme.brand : Theme.panel;
    border-color: Surface.hairline; border-width: 1px;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        text: label; color: touch.has-hover ? #ffffff : Theme.text;
        font-size: 11px; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

component Row inherits Skin {
    in property <SettingItem> item;
    callback toggle(bool);
    callback text-edited(string);
    callback action();
    height: item.kind == "header" ? 30px : 64px;
    border-radius: item.kind == "header" ? 0 : Theme.radius-md;
    background: item.kind == "header" ? transparent : Theme.panel-2;
    border-color: item.kind == "header" ? transparent : Theme.outline;
    border-width: item.kind == "header" ? 0 : 1px;

    if item.kind == "header": Text {
        x: 2px; text: item.label; color: Theme.text-dim;
        font-size: 11px; font-weight: 700; letter-spacing: 0.7px;
        vertical-alignment: bottom; height: 100%;
    }

    if item.kind != "header": HorizontalLayout {
        padding: 14px; spacing: 14px; alignment: stretch;
        VerticalLayout {
            alignment: center; spacing: 3px; horizontal-stretch: 1;
            Text { text: item.label; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
            if item.desc != "": Text { text: item.desc; color: Theme.text-dim; font-size: 11px; wrap: word-wrap; }
        }

        // Trailing control by kind.
        if item.kind == "toggle": PillToggle {
            on: item.on;
            toggled(v) => { root.toggle(v); }
        }
        if item.kind == "action" && item.state != "busy": Btn {
            label: item.value == "" ? "Run" : item.value;
            clicked => { root.action(); }
        }
        // Busy action: the button becomes a pill with a sweeping progress
        // stripe (indeterminate) until the task re-seeds the row.
        if item.kind == "action" && item.state == "busy": Rectangle {
            height: 30px; min-width: 110px;
            horizontal-stretch: 0; vertical-stretch: 0;
            border-radius: Surface.rr(8px, self.width, self.height); clip: true;
            background: Surface.body(Theme.panel);
            border-color: Accent.color.with-alpha(0.6); border-width: 1px;
            property <float> ph: Math.mod(animation-tick() / 1ms, 1100) / 1100;
            Rectangle {
                width: 44%; height: 100%;
                border-radius: Surface.rr(8px, self.width, self.height);
                background: Accent.color.with-alpha(0.30);
                x: (parent.width - self.width) * (ph < 0.5 ? ph * 2 : (1 - ph) * 2);
            }
            Text {
                text: "Working…"; color: Theme.text;
                font-size: 11px; font-weight: 600;
                width: 100%; height: 100%;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        if item.kind == "status": HorizontalLayout {
            spacing: 8px; alignment: end;
            horizontal-stretch: 0; vertical-stretch: 0;
            StatusDot { state: item.state; y: (parent.height - self.height) / 2; }
            Text { text: item.value; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
        }
        // Status + trailing button in ONE row (model downloads: state + a
        // Download / Verify button used to live on two separate rows).
        if item.kind == "status-action" && item.state != "busy": HorizontalLayout {
            spacing: 10px; alignment: end;
            horizontal-stretch: 0; vertical-stretch: 0;
            StatusDot { state: item.state; y: (parent.height - self.height) / 2; }
            Text { text: item.value; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
            Btn { label: item.btn == "" ? "Run" : item.btn; clicked => { root.action(); } }
        }
        // Downloading: the button becomes a determinate progress pill.
        if item.kind == "status-action" && item.state == "busy": HorizontalLayout {
            spacing: 10px; alignment: end;
            horizontal-stretch: 0; vertical-stretch: 0;
            Text { text: item.value; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
            Rectangle {
                height: 30px; min-width: 110px;
                horizontal-stretch: 0; vertical-stretch: 0;
                border-radius: Surface.rr(8px, self.width, self.height); clip: true;
                background: Surface.body(Theme.panel);
                border-color: Accent.color.with-alpha(0.6); border-width: 1px;
                Rectangle {
                    x: 0; width: parent.width * Math.max(0.02, Math.min(1, item.frac));
                    height: 100%;
                    background: Accent.color.with-alpha(0.35);
                }
                Text {
                    text: Math.round(Math.max(0, Math.min(1, item.frac)) * 100) + "%";
                    color: Theme.text; font-size: 11px; font-weight: 700;
                    width: 100%; height: 100%;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }
        // Spoken-language picker for voice search.
        if item.kind == "lang-choice": HorizontalLayout {
            spacing: 5px; alignment: end;
            horizontal-stretch: 0; vertical-stretch: 0;
            for opt in [
                { k: "en",   label: "English" },
                { k: "hi",   label: "हिंदी" },
                { k: "pa",   label: "ਪੰਜਾਬੀ" },
                { k: "auto", label: "Auto" },
            ]: Rectangle {
                width: 66px; height: 30px; border-radius: Surface.rr(8px, self.width, self.height);
                property <bool> sel: item.value == opt.k || (item.value == "" && opt.k == "en");
                background: sel ? Accent.color : Theme.panel;
                border-color: sel ? Accent.color : Theme.outline; border-width: 1px;
                TouchArea { mouse-cursor: pointer; clicked => { root.text-edited(opt.k); } }
                Text { text: opt.label; color: sel ? #ffffff : Theme.text;
                    font-size: 11px; font-weight: sel ? 700 : 500;
                    horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        // Segmented whisper-model picker: tiny · base · small · turbo.
        if item.kind == "model-choice": HorizontalLayout {
            spacing: 5px; alignment: end;
            horizontal-stretch: 0; vertical-stretch: 0;
            for opt in [
                { k: "tiny",  label: "Tiny" },
                { k: "base",  label: "Base" },
                { k: "small", label: "Small" },
                { k: "turbo", label: "Turbo" },
            ]: Rectangle {
                width: 62px; height: 30px; border-radius: Surface.rr(8px, self.width, self.height);
                property <bool> sel: item.value == opt.k || (item.value == "" && opt.k == "tiny");
                background: sel ? Accent.color : Theme.panel;
                border-color: sel ? Accent.color : Theme.outline; border-width: 1px;
                TouchArea { mouse-cursor: pointer; clicked => { root.text-edited(opt.k); } }
                Text { text: opt.label; color: sel ? #ffffff : Theme.text;
                    font-size: 11px; font-weight: sel ? 700 : 500;
                    horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        if item.kind == "text": Rectangle {
            width: 280px; height: 34px;
            horizontal-stretch: 0; vertical-stretch: 0;
            y: (parent.height - self.height) / 2;
            border-radius: Surface.rr(9px, self.width, self.height);
            background: Surface.body(Theme.panel); border-color: Surface.hairline; border-width: 1px;
            ti := TextInput {
                x: 12px; width: parent.width - 24px; height: parent.height;
                text: item.value;
                color: Theme.text; font-size: 12px;
                vertical-alignment: center;
                single-line: true;
                edited => { root.text-edited(self.text); }
            }
            if item.value == "": Text {
                x: 12px; text: item.desc == "" ? "default" : "custom override";
                color: Theme.text-dim; font-size: 12px; vertical-alignment: center; height: 100%;
                visible: !ti.has-focus && ti.text == "";
            }
        }
    }
}

// One scrollable list of setting rows. Title + blurb on top.
export component SettingsList inherits Rectangle {
    in property <string> title;
    in property <string> blurb;
    in property <[SettingItem]> rows;
    /// Optional action at the right edge of the title row. Empty = no button.
    in property <string> head-btn;
    callback head-clicked();
    callback toggle(string /*key*/, bool);
    callback text-edited(string /*key*/, string /*value*/);
    callback action(string /*key*/);
    background: transparent;

    VerticalLayout {
        spacing: 12px;
        if root.title != "": HorizontalLayout {
            spacing: 12px; vertical-stretch: 0;
            Text { text: root.title; color: Theme.text; font-size: 20px; font-weight: 700;
                horizontal-stretch: 1; vertical-alignment: center; }
            if root.head-btn != "": VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Btn { label: root.head-btn; clicked => { root.head-clicked(); } }
            }
        }
        if root.blurb != "": Text { text: root.blurb; color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                for r in root.rows: Row {
                    item: r;
                    toggle(v) => { root.toggle(r.key, v); }
                    text-edited(s) => { root.text-edited(r.key, s); }
                    action => { root.action(r.key); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}

// ── Style pickers (Profile & Style) ─────────────────────────────────────────
// One segmented control with a scaled silhouette above each label, used for
// both the desktop mini-player size class and the tray menu style. Read-only
// `choice` like DesignLangPicker: the click goes to Rust, which persists the
// name and pushes the new value back.
export struct StyleOption {
    label: string,
    value: string,   // also picks the schematic — see StyleThumb
    note: string,
}

// What each option actually looks like, drawn rather than outlined.
//
// Same idea as the Home layout thumbnails: an empty rounded rectangle in the
// right proportion tells you the widget's SHAPE and nothing about what is in
// it, and five of them side by side read as five empty boxes. These draw the
// furniture — art, title lines, transport, seek, menu rows — at the position
// the real surface puts it, so the choice is recognisable before the label is
// read. `on` swaps the ink to the accent, which is how the selected cell says
// so without a second badge.
component StyleThumb inherits Rectangle {
    in property <string> kind: "bar";
    in property <bool> on: false;

    // The body is the widget; the furniture sits on it.
    property <length> pad: 5px;
    property <color> ink: root.on ? Accent.color : Theme.text-dim;
    property <brush> art: root.on
        ? @linear-gradient(135deg, #ec4899, #8b5cf6 55%, #06b6d4)
        : Theme.outline-strong;

    background: Theme.dark ? #0d0f1a : #ffffff;
    border-radius: Surface.rr(6px, self.width, self.height);
    border-width: 1px;
    border-color: root.on ? Accent.color.with-alpha(0.55) : Theme.outline-strong;
    clip: true;

    // ── bar — square art at the left, titles and transport at the right ─────
    if root.kind == "bar": Rectangle {
        x: root.pad; y: root.pad;
        width: root.width - 2 * root.pad; height: root.height - 2 * root.pad;
        property <length> art-w: self.height;
        Rectangle {
            width: parent.art-w; height: parent.height;
            border-radius: 3px; background: root.art;
        }
        Rectangle {
            x: parent.art-w + 5px; y: parent.height * 0.16;
            width: (parent.width - parent.art-w - 5px) * 0.8; height: 3px;
            border-radius: 1.5px; background: root.ink.with-alpha(0.85);
        }
        Rectangle {
            x: parent.art-w + 5px; y: parent.height * 0.34;
            width: (parent.width - parent.art-w - 5px) * 0.5; height: 2px;
            border-radius: 1px; background: root.ink.with-alpha(0.45);
        }
        // Transport: three keys, the middle one filled.
        for k[i] in [0, 1, 2]: Rectangle {
            x: parent.art-w + 5px + i * 11px; y: parent.height * 0.58;
            width: 8px; height: 8px; border-radius: 4px;
            background: i == 1 ? root.art : root.ink.with-alpha(0.35);
        }
        Rectangle {
            x: parent.art-w + 5px; y: parent.height - 3px;
            width: parent.width - parent.art-w - 5px; height: 2px;
            border-radius: 1px; background: root.ink.with-alpha(0.3);
        }
    }

    // ── square — art on top, titles under it, transport at the foot ─────────
    if root.kind == "square": Rectangle {
        x: root.pad; y: root.pad;
        width: root.width - 2 * root.pad; height: root.height - 2 * root.pad;
        Rectangle {
            width: parent.width; height: parent.height * 0.5;
            border-radius: 3px; background: root.art;
        }
        Rectangle {
            y: parent.height * 0.58; width: parent.width * 0.72; height: 3px;
            border-radius: 1.5px; background: root.ink.with-alpha(0.85);
        }
        Rectangle {
            y: parent.height * 0.7; width: parent.width * 0.45; height: 2px;
            border-radius: 1px; background: root.ink.with-alpha(0.45);
        }
        for k[i] in [0, 1, 2]: Rectangle {
            x: parent.width / 2 - 13px + i * 11px; y: parent.height - 9px;
            width: 8px; height: 8px; border-radius: 4px;
            background: i == 1 ? root.art : root.ink.with-alpha(0.35);
        }
    }

    // ── pill — round art, one line, two keys ────────────────────────────────
    if root.kind == "pill": Rectangle {
        x: root.pad; y: root.pad;
        width: root.width - 2 * root.pad; height: root.height - 2 * root.pad;
        property <length> d: Math.min(self.height, 18px);
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: parent.d; height: parent.d;
            border-radius: parent.d / 2; background: root.art;
        }
        Rectangle {
            x: parent.d + 5px; y: parent.height / 2 - 4px;
            width: (parent.width - parent.d - 5px) * 0.62; height: 3px;
            border-radius: 1.5px; background: root.ink.with-alpha(0.85);
        }
        Rectangle {
            x: parent.d + 5px; y: parent.height / 2 + 2px;
            width: (parent.width - parent.d - 5px) * 0.38; height: 2px;
            border-radius: 1px; background: root.ink.with-alpha(0.45);
        }
        for k[i] in [0, 1]: Rectangle {
            x: parent.width - 19px + i * 11px; y: parent.height / 2 - 4px;
            width: 8px; height: 8px; border-radius: 4px;
            background: i == 0 ? root.art : root.ink.with-alpha(0.35);
        }
    }

    // ── popup tray — art, title, seek, volume ───────────────────────────────
    if root.kind == "popup": Rectangle {
        x: root.pad; y: root.pad;
        width: root.width - 2 * root.pad; height: root.height - 2 * root.pad;
        Rectangle {
            x: (parent.width - self.width) / 2;
            width: parent.height * 0.42; height: parent.height * 0.42;
            border-radius: 3px; background: root.art;
        }
        Rectangle {
            x: (parent.width - self.width) / 2; y: parent.height * 0.5;
            width: parent.width * 0.6; height: 3px;
            border-radius: 1.5px; background: root.ink.with-alpha(0.85);
        }
        // Seek: filled to a third.
        Rectangle {
            y: parent.height * 0.68; width: parent.width; height: 3px;
            border-radius: 1.5px; background: root.ink.with-alpha(0.25);
            Rectangle { width: parent.width * 0.35; height: parent.height;
                border-radius: 1.5px; background: root.art; }
        }
        Rectangle {
            y: parent.height * 0.86; width: parent.width; height: 3px;
            border-radius: 1.5px; background: root.ink.with-alpha(0.25);
            Rectangle { width: parent.width * 0.6; height: parent.height;
                border-radius: 1.5px; background: root.art; }
        }
    }

    // ── native tray — the OS menu: text rows and a rule ──────────────────────
    if root.kind == "native": Rectangle {
        x: root.pad; y: root.pad;
        width: root.width - 2 * root.pad; height: root.height - 2 * root.pad;
        for k[i] in [0, 1, 2, 3]: Rectangle {
            y: i * (parent.height / 4.2);
            width: parent.width * (i == 0 ? 0.8 : (i == 2 ? 0.55 : 0.68));
            height: 3px; border-radius: 1.5px;
            background: i == 0 ? root.art : root.ink.with-alpha(0.5);
        }
        Rectangle {
            y: parent.height - 3px; width: parent.width; height: 1px;
            background: root.ink.with-alpha(0.3);
        }
    }
}

export component StylePicker inherits Rectangle {
    in property <[StyleOption]> options: [];
    in property <string> choice: "";
    callback changed(string);

    // Equal square cells filling the row, whatever the option count. Stretch
    // factors would not do it: a BoxLayout splits only the LEFTOVER width, so a
    // cell whose note is "art · seek · volume" ends up wider than one that says
    // "588 × 246". The cells are sized off the picker's own width instead, and
    // the picker's height follows the cell so they come out square.
    property <length> gap: 6px;
    property <length> cell:
        (root.width - 12px - (root.options.length - 1) * root.gap)
        / Math.max(1, root.options.length);
    height: root.cell + 12px;
    border-radius: Theme.radius-md;
    background: Theme.panel-2;
    border-color: Theme.outline;
    border-width: 1px;

    HorizontalLayout {
        padding: 6px; spacing: root.gap;
        for o in root.options: Rectangle {
            width: root.cell;
            horizontal-stretch: 0;
            property <bool> on: root.choice == o.value;
            border-radius: Theme.radius-sm;
            background: on ? Accent.color.with-alpha(0.16) : (op.has-hover ? Theme.glass : transparent);
            border-width: on ? 1px : 0px;
            border-color: Accent.color.with-alpha(0.55);
            animate background { duration: 130ms; easing: ease-out; }
            op := TouchArea { mouse-cursor: pointer; clicked => { root.changed(o.value); } }
            VerticalLayout {
                alignment: center; spacing: 7px; padding: 6px;
                // The widget itself, drawn — see StyleThumb.
                StyleThumb {
                    kind: o.value; on: on;
                    width: root.cell - 24px;
                    height: (root.cell - 24px) * 0.62;
                    horizontal-stretch: 0; vertical-stretch: 0;
                }
                VerticalLayout {
                    spacing: 1px;
                    Text {
                        text: o.label; color: on ? Theme.text : Theme.text-dim;
                        font-size: 11.5px; font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: o.note; color: Theme.text-dim;
                        font-size: 9.5px; horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

// ── Profile & Home shared bits ───────────────────────────────────────────────
// Here rather than in main.slint so the You & Home page can use them: main
// imports that page, so the page cannot import back out of main.

export struct CreditEntry { icon: image, label: string, link: string }

/// One logo in the BUILT WITH wall.
export component CreditTile inherits Skin {
    in property <CreditEntry> entry;
    callback open();
    background: Surface.body(Theme.panel-2);
    border-radius: Surface.rr(10px, self.width, self.height);
    // Height comes from the grid (square cells), not from the tile.
    height: 74px;
    border-width: t.has-hover ? 2px : 1px;
    border-color: t.has-hover ? Accent.color : Surface.hairline;
    animate border-color, border-width { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
    VerticalLayout {
        padding: 10px; spacing: 8px; alignment: center;
        HorizontalLayout { alignment: center;
            // Scales with the cell: 22px was sized for a 74px-tall strip, and the
            // grid squares are nearly twice that.
            Image { source: entry.icon;
                width: Math.clamp(root.height * 0.30, 22px, 40px); height: self.width; } }
        Text { text: entry.label; color: Theme.text;
            font-size: root.height > 100px ? 11px : 10px;
            horizontal-alignment: center; overflow: elide; }
    }
}

/// Selectable sidebar-logo swatch.
export component LogoChip inherits Skin {
    in property <image> logo;
    in property <bool> selected: false;
    callback clicked();
    width: 46px; height: 46px; border-radius: Surface.rr(12px, self.width, self.height);
    clip: true;
    background: Surface.body(Theme.panel);
    border-width: selected ? 2px : 1px;
    border-color: selected ? Accent.color : Theme.outline;
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Image { source: logo; image-fit: cover; width: 100%; height: 100%; }
    // The selected mark wears the app's double ring — outer edge, a gap, then a
    // second line inside it. Drawn over the image rather than around the chip so
    // the mark itself stays exactly the size every other chip's does.
    if root.selected: Rectangle {
        x: 4px; y: 4px;
        width: parent.width - 8px; height: parent.height - 8px;
        border-radius: Math.max(2px, parent.border-radius - 4px);
        background: transparent;
        border-width: 1.5px;
        border-color: Accent.color.with-alpha(0.75);
    }
}
