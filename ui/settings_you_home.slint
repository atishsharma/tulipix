// Settings › PERSONAL › You & Home — the identity, the look, and the shape of
// Home, on one page. Spec: docs/home-layouts/README.md.
//
// "Profile & Style" and "Home Layout" were two nav entries answering the same
// question: what the app looks like when you open it. Choosing a layout and
// then theming it meant crossing the nav twice, so they are one page now.
//
// The page owns the Customize popup and the switch dialog, which is why the
// merge went this way round rather than embedding the layout picker as a card:
// both overlays cover the whole page, and an overlay inside a card is a
// card-sized overlay.
//
// Names shown here are display names: Poweruser (`classic`), Cinema (`cinema`),
// Timeline (`stream`), Focused (`welcome`, the default). The ids are what
// `home.layout` and `home.hidden.<layout>` hold on disk and never change.
//
// The previews are vector schematics (nested rectangles in the layout's real
// proportions, tinted with the section accents) rather than screenshots: they
// follow the theme and the design language for free, and ship no assets.
import { Theme, Accent } from "tokens.slint";
import { Surface, Rim, Skin, DesignLangPicker } from "surface.slint";
import { Icons, AppIcon } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { ThemePicker, ThemeChoice } from "theme_picker.slint";
import { UserState } from "user_card.slint";
import { StylePicker, CreditEntry, CreditTile, LogoChip } from "settings_panels.slint";

/// One card in the layout being customized. Built in Rust for the layout that
/// owns it — a layout never sees a card it has no place for.
export struct HomeCardRow {
    id: string,
    label: string,
    hint: string,
    on: bool,
    /// The last card standing cannot be switched off; Home would be blank.
    locked: bool,
}

// ── Schematic preview ───────────────────────────────────────────────────────
// Every layout draws from the same five-bar vocabulary so the tiles read as one
// family. The `hc-*` inputs default to true, so a tile with no bindings shows
// the layout at full strength and the popup's copy shows what you actually have.
export component LayoutThumb inherits Rectangle {
    in property <string> kind: "classic";
    in property <bool> hc-hero: true;
    in property <bool> hc-continue: true;
    in property <bool> hc-player: true;
    in property <bool> hc-quick: true;
    in property <bool> hc-photos: true;
    in property <bool> hc-videos: true;
    in property <bool> hc-music: true;
    in property <bool> hc-books: true;
    in property <bool> hc-cloud: true;
    in property <bool> hc-tools: true;
    in property <bool> hc-transfer: true;
    in property <bool> hc-finances: true;
    in property <bool> hc-library: true;
    in property <bool> hc-ticker: true;
    in property <bool> hc-hub: true;

    property <length> pad: 7px;
    property <length> gap: 4px;
    property <length> iw: root.width - 2 * root.pad;
    property <length> ih: root.height - 2 * root.pad;
    // Rows collapse rather than stretch, so a stripped layout looks stripped.
    property <int> row1: (root.hc-photos ? 1 : 0) + (root.hc-videos ? 1 : 0);
    property <int> row2: (root.hc-books ? 1 : 0) + (root.hc-cloud ? 1 : 0)
        + (root.hc-tools ? 1 : 0) + (root.hc-transfer ? 1 : 0);
    property <int> keys: (root.hc-photos ? 1 : 0) + (root.hc-videos ? 1 : 0)
        + (root.hc-music ? 1 : 0) + (root.hc-books ? 1 : 0)
        + (root.hc-cloud ? 1 : 0) + (root.hc-tools ? 1 : 0);
    property <int> panes: root.keys + (root.hc-transfer ? 1 : 0) + (root.hc-finances ? 1 : 0);
    property <int> rows: root.panes;
    property <int> rail: (root.hc-player ? 1 : 0) + (root.hc-finances ? 1 : 0)
        + (root.hc-transfer ? 1 : 0) + (root.hc-library ? 1 : 0);

    background: Theme.dark ? #06070f : #f4f2fb;
    border-radius: Surface.rr(9px, self.width, self.height);
    border-width: 1px;
    border-color: Surface.hairline;
    clip: true;

    // ── classic — two rows of tiles, a wide strip, a rail ───────────────────
    if root.kind == "classic": Rectangle {
        x: root.pad; y: root.pad; width: root.iw; height: root.ih;
        property <length> rail-w: root.rail > 0 ? root.iw * 0.29 : 0px;
        property <length> left-w: root.iw - (rail-w > 0px ? rail-w + root.gap : 0px);
        property <length> body-h: ih - 9px - root.gap;
        property <length> cont-h: root.hc-continue ? body-h * 0.31 : 0px;
        property <length> deck-h: body-h - (cont-h > 0px ? cont-h + root.gap : 0px);
        property <length> r1: root.row1 > 0 ? (root.row2 > 0 ? deck-h * 0.52 : deck-h) : 0px;
        property <length> r2: deck-h - (r1 > 0px ? r1 + root.gap : 0px);
        // header
        Rectangle { width: parent.width * 0.44; height: 6px; border-radius: 3px;
            background: Theme.text.with-alpha(0.32); }
        // row 1
        if root.row1 > 0: Rectangle {
            y: 9px + root.gap; width: parent.left-w; height: parent.r1;
            HorizontalLayout {
                spacing: root.gap;
                if root.hc-photos: Rectangle { border-radius: 3px; background: Theme.sec-photos.with-alpha(0.55); }
                if root.hc-videos: Rectangle { border-radius: 3px; background: Theme.sec-videos.with-alpha(0.55); }
            }
        }
        // row 2
        if root.row2 > 0: Rectangle {
            y: 9px + root.gap + (parent.r1 > 0px ? parent.r1 + root.gap : 0px);
            width: parent.left-w; height: parent.r2;
            HorizontalLayout {
                spacing: root.gap;
                if root.hc-books: Rectangle { border-radius: 3px; background: Theme.sec-books.with-alpha(0.5); }
                if root.hc-cloud: Rectangle { border-radius: 3px; background: Theme.sec-cloud.with-alpha(0.5); }
                if root.hc-tools: Rectangle { border-radius: 3px; background: Theme.sec-tools.with-alpha(0.5); }
                if root.hc-transfer: Rectangle { border-radius: 3px; background: Theme.sec-transfer.with-alpha(0.5); }
            }
        }
        // continue strip
        if root.hc-continue: Rectangle {
            y: parent.height - parent.cont-h; width: parent.left-w; height: parent.cont-h;
            border-radius: 3px; background: Theme.sec-music.with-alpha(0.42);
        }
        // rail
        if root.rail > 0: Rectangle {
            x: parent.width - parent.rail-w; y: 9px + root.gap;
            width: parent.rail-w; height: parent.height - 9px - root.gap;
            VerticalLayout {
                spacing: root.gap;
                if root.hc-player: Rectangle { border-radius: 3px; background: Theme.sec-music.with-alpha(0.6); }
                if root.hc-quick: Rectangle { height: parent.height * 0.32; border-radius: 3px;
                    background: Theme.sec-videos.with-alpha(0.45); }
            }
        }
    }

    // ── cinema — hero at full bleed, shelf at the bottom, player panel right ──
    // ── cinema — hero at full bleed, Continue at the bottom, player right ────
    if root.kind == "cinema": cin := Rectangle {
        x: 0; y: 0; width: root.width; height: root.height;
        // The shelf is the Continue strip and nothing else — My Hub came back as
        // one card in the right column, not a row down here.
        property <length> shelf-h: root.hc-continue ? root.height * 0.32 : 0px;
        // backdrop
        if root.hc-hero: Rectangle {
            width: parent.width; height: parent.height;
            background: @linear-gradient(150deg, Theme.sec-videos.with-alpha(0.5),
                Theme.brand.with-alpha(0.22), #00000000);
        }
        // header: wordmark, greeting pill, launcher pills right
        Rectangle {
            x: root.pad; y: root.pad; width: parent.width * 0.16; height: 5px;
            border-radius: 2px; background: Theme.text.with-alpha(0.7);
        }
        if root.hc-quick: Rectangle {
            x: parent.width - root.pad - parent.width * 0.34;
            y: root.pad - 1px; width: parent.width * 0.34; height: 7px;
            border-radius: 3px; background: Theme.text.with-alpha(0.22);
        }
        // hero title bars — two lines now
        if root.hc-hero: Rectangle {
            x: root.pad; y: parent.height * 0.28;
            width: parent.width * 0.40; height: 8px; border-radius: 4px;
            background: Theme.text.with-alpha(0.85);
        }
        if root.hc-hero: Rectangle {
            x: root.pad; y: parent.height * 0.28 + 11px;
            width: parent.width * 0.28; height: 8px; border-radius: 4px;
            background: Theme.text.with-alpha(0.85);
        }
        if root.hc-hero: Rectangle {
            x: root.pad; y: parent.height * 0.28 + 24px;
            width: parent.width * 0.14; height: 5px; border-radius: 3px;
            background: Theme.sec-videos;
        }
        // right stack — the player panel
        if root.hc-player: Rectangle {
            x: parent.width - root.pad - parent.width * 0.24;
            y: root.pad + 8px; width: parent.width * 0.24;
            height: parent.height * 0.56;
            border-radius: 3px;
            background: Theme.sec-music.with-alpha(0.5);
        }
        // hub carousel — one card, in the gap under the player
        if root.hc-hub: Rectangle {
            x: parent.width - root.pad - parent.width * 0.24;
            y: root.height - cin.shelf-h - 4px - parent.height * 0.14;
            width: parent.width * 0.24; height: parent.height * 0.14;
            border-radius: 3px;
            background: Theme.sec-photos.with-alpha(0.45);
        }
        // shelf — the Continue tab strip, 70% wide
        if cin.shelf-h > 0px: Rectangle {
            y: root.height - cin.shelf-h; width: parent.width; height: cin.shelf-h;
            background: Theme.dark ? #000000c0 : #ffffffcc;
            HorizontalLayout {
                x: root.pad; y: root.pad;
                width: parent.width * 0.7; height: parent.height - 2 * root.pad;
                spacing: root.gap;
                Rectangle { border-radius: 2px; background: Theme.sec-videos.with-alpha(0.5); }
                Rectangle { border-radius: 2px; background: Theme.sec-books.with-alpha(0.5); }
                Rectangle { border-radius: 2px; background: Theme.sec-music.with-alpha(0.5); }
                Rectangle { border-radius: 2px; background: Theme.sec-photos.with-alpha(0.5); }
            }
        }
    }

    // ── welcome — hero, launch bar, two cards, tiles, player bar ────────────
    if root.kind == "welcome": wel := Rectangle {
        x: root.pad; y: root.pad; width: root.iw; height: root.ih;
        VerticalLayout {
            spacing: root.gap;
            // top bar: mark + search pill
            Rectangle {
                height: 6px;
                Rectangle { width: 6px; height: 6px; border-radius: 2px; background: Theme.brand; }
                Rectangle { x: parent.width * 0.3; width: parent.width * 0.4; height: 6px;
                    border-radius: 3px; background: Theme.text.with-alpha(0.14); }
                Rectangle { x: parent.width - 6px; width: 6px; height: 6px; border-radius: 3px;
                    background: Theme.text.with-alpha(0.3); }
            }
            // hero: greeting left, collage right
            if root.hc-hero: Rectangle {
                height: root.ih * 0.24;
                Rectangle { y: 3px; width: parent.width * 0.4; height: 9px; border-radius: 4px;
                    background: Theme.text.with-alpha(0.72); }
                Rectangle { y: 16px; width: parent.width * 0.28; height: 4px; border-radius: 2px;
                    background: Theme.text.with-alpha(0.3); }
                Rectangle { x: parent.width * 0.52; y: 2px; width: 22px; height: 16px;
                    border-radius: 3px; background: Theme.sec-photos.with-alpha(0.5); }
                Rectangle { x: parent.width * 0.72; y: 0px; width: 16px; height: 16px;
                    border-radius: 8px; background: Theme.sec-music.with-alpha(0.55); }
                Rectangle { x: parent.width * 0.88; y: 6px; width: 12px; height: 17px;
                    border-radius: 3px; background: Theme.sec-books.with-alpha(0.5); }
            }
            // launch bar
            if root.hc-quick: Rectangle {
                height: 9px; border-radius: 4px;
                background: Theme.text.with-alpha(0.08);
                HorizontalLayout {
                    padding: 2px; spacing: 3px;
                    Rectangle { border-radius: 2px; background: Theme.sec-videos.with-alpha(0.55); }
                    Rectangle { border-radius: 2px; background: Theme.sec-transfer.with-alpha(0.55); }
                    Rectangle { border-radius: 2px; background: Theme.sec-books.with-alpha(0.55); }
                    Rectangle { border-radius: 2px; background: Theme.brand.with-alpha(0.55); }
                    Rectangle { border-radius: 2px; background: Theme.sec-music.with-alpha(0.55); }
                    Rectangle { border-radius: 2px; background: Theme.sec-tools.with-alpha(0.55); }
                }
            }
            // continue | recently added
            if root.hc-continue || root.hc-library: Rectangle {
                HorizontalLayout {
                    spacing: root.gap;
                    if root.hc-continue: Rectangle { border-radius: 3px;
                        background: Theme.sec-videos.with-alpha(0.32); }
                    if root.hc-library: Rectangle { border-radius: 3px;
                        background: Theme.sec-photos.with-alpha(0.32); }
                }
            }
            // my hub tiles
            if root.keys > 0 || root.hc-transfer || root.hc-finances: Rectangle {
                height: root.ih * 0.16;
                HorizontalLayout {
                    spacing: 2px;
                    if root.hc-photos: Rectangle { border-radius: 2px; background: Theme.sec-photos.with-alpha(0.45); }
                    if root.hc-videos: Rectangle { border-radius: 2px; background: Theme.sec-videos.with-alpha(0.45); }
                    if root.hc-books: Rectangle { border-radius: 2px; background: Theme.sec-books.with-alpha(0.45); }
                    if root.hc-music: Rectangle { border-radius: 2px; background: Theme.sec-music.with-alpha(0.45); }
                    if root.hc-cloud: Rectangle { border-radius: 2px; background: Theme.sec-cloud.with-alpha(0.45); }
                    if root.hc-tools: Rectangle { border-radius: 2px; background: Theme.sec-tools.with-alpha(0.45); }
                    if root.hc-transfer: Rectangle { border-radius: 2px; background: Theme.sec-transfer.with-alpha(0.45); }
                    if root.hc-finances: Rectangle { border-radius: 2px; background: Theme.sec-finances.with-alpha(0.45); }
                }
            }
            // player bar, pinned along the bottom
            if root.hc-player: Rectangle {
                height: 11px; border-radius: 4px;
                background: Theme.sec-music.with-alpha(0.32);
                Rectangle { x: 3px; y: 3px; width: 5px; height: 5px; border-radius: 2px;
                    background: Theme.sec-music; }
                Rectangle { x: parent.width / 2 - 4px; y: 3px; width: 9px; height: 5px;
                    border-radius: 2px; background: Theme.text.with-alpha(0.4); }
            }
        }
    }

    // ── stream — feed left, standing rail right ─────────────────────────────
    if root.kind == "stream": stm := Rectangle {
        x: root.pad; y: root.pad; width: root.iw; height: root.ih;
        property <length> rail-w: root.rail > 0 ? root.iw * 0.31 : 0px;
        Rectangle {
            width: parent.width - (stm.rail-w > 0px ? stm.rail-w + root.gap : 0px);
            height: parent.height;
            VerticalLayout {
                spacing: 4px;
                Rectangle { height: 6px; width: parent.width * 0.5; border-radius: 3px;
                    background: Theme.text.with-alpha(0.55); }
                for c in [
                    { on: root.hc-music,    tint: Theme.sec-music },
                    { on: root.hc-transfer, tint: Theme.sec-transfer },
                    { on: root.hc-finances, tint: Theme.sec-finances },
                    { on: root.hc-photos,   tint: Theme.sec-photos },
                    { on: root.hc-videos,   tint: Theme.sec-videos },
                    { on: root.hc-books,    tint: Theme.sec-books },
                    { on: root.hc-cloud,    tint: Theme.sec-cloud },
                    { on: root.hc-tools,    tint: Theme.sec-tools },
                ]: Rectangle {
                    height: c.on ? 6px : 0px;
                    Rectangle { width: 4px; height: 4px; border-radius: 2px; y: 1px; background: c.tint; }
                    Rectangle { x: 8px; y: 1px; width: parent.width * 0.62; height: 4px;
                        border-radius: 2px; background: Theme.text.with-alpha(0.3); }
                }
            }
        }
        if stm.rail-w > 0px: Rectangle {
            x: parent.width - stm.rail-w; width: stm.rail-w; height: parent.height;
            VerticalLayout {
                spacing: root.gap;
                if root.hc-player: Rectangle { border-radius: 3px; background: Theme.sec-music.with-alpha(0.5); }
                if root.hc-finances: Rectangle { border-radius: 3px; background: Theme.sec-finances.with-alpha(0.5); }
                if root.hc-transfer: Rectangle { border-radius: 3px; background: Theme.sec-transfer.with-alpha(0.5); }
                if root.hc-library: Rectangle { border-radius: 3px; background: Theme.sec-photos.with-alpha(0.4); }
            }
        }
    }
}

component Btn inherits Skin {
    in property <string> label;
    in property <bool> primary: false;
    // "There is something to save." Ink-black with white type in both themes —
    // it has to be the loudest thing on the card, and the brand violet is what
    // the button already wears when there is nothing to do.
    in property <bool> dirty: false;
    callback clicked();
    height: 29px;
    border-radius: Surface.rr(8px, self.width, self.height);
    background: root.dirty
        ? (touch.has-hover ? #1f2430 : (Theme.dark ? #05060b : #0b0e17))
        : (touch.has-hover
            ? (primary ? #6d28d9 : Theme.panel-2)
            : (primary ? Theme.brand : Theme.panel));
    border-color: root.dirty ? #000000 : Theme.outline; border-width: 1px;
    animate background { duration: 140ms; easing: ease-out; }
    horizontal-stretch: 0;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        Text { text: root.label;
            color: (root.primary || root.dirty) ? #ffffff : Theme.text;
            font-size: 11px; font-weight: 600;
            horizontal-alignment: center; vertical-alignment: center; }
    }
}

// A pill switch built from rectangles: the knob moves with an `x` binding rather
// than swapping components, so it is safe inside a repeater (slint#6426).
component Sw inherits Rectangle {
    in property <bool> on: false;
    in property <bool> locked: false;
    callback toggled();
    width: 38px; height: 21px; border-radius: 11px;
    background: root.on ? Theme.brand : Theme.text.with-alpha(0.16);
    opacity: root.locked ? 0.4 : 1.0;
    animate background { duration: 130ms; easing: ease-out; }
    TouchArea {
        mouse-cursor: root.locked ? MouseCursor.not-allowed : MouseCursor.pointer;
        clicked => { if (!root.locked) { root.toggled(); } }
    }
    Rectangle {
        y: 3px; width: 15px; height: 15px; border-radius: 8px; background: #ffffff;
        x: root.on ? root.width - self.width - 3px : 3px;
        animate x { duration: 130ms; easing: ease-out; }
    }
}

component OptionTile inherits Rectangle {
    in property <string> id;
    in property <string> name;
    in property <string> blurb;
    in property <bool> active: false;
    callback use();
    callback customize();

    border-radius: Surface.card-radius;
    background: Surface.body(Theme.panel-2);
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.brand : Surface.hairline;
    drop-shadow-blur: Surface.card-shadow;
    drop-shadow-color: Surface.shadow-ink;
    drop-shadow-offset-y: Surface.card-shadow-y;
    animate border-color, border-width { duration: 130ms; easing: ease-out; }
    if Surface.rim: Rim {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        radius: Surface.card-radius - 1px;
    }
    hov := TouchArea { mouse-cursor: pointer; clicked => { root.use(); } }

    VerticalLayout {
        padding: 14px; spacing: 10px;
        // The schematic draws a window, so it stays landscape at 16:9 whatever
        // the tile's width — stretching it to fill the tile made four portrait
        // previews of a shape that is never portrait.
        LayoutThumb {
            kind: root.id;
            height: self.width * 0.5625;
            vertical-stretch: 0;
        }
        HorizontalLayout {
            spacing: 6px; vertical-stretch: 0;
            VerticalLayout {
                spacing: 2px; horizontal-stretch: 1;
                Text { text: root.name; color: Theme.text; font-size: 13px; font-weight: 700; }
                Text {
                    text: root.blurb;
                    color: Theme.text-dim;
                    font-size: 10.5px; wrap: word-wrap;
                }
            }
            if root.active: Rectangle {
                width: 62px; height: 19px; border-radius: 10px; y: 1px;
                horizontal-stretch: 0;
                background: Theme.brand.with-alpha(0.2);
                Text { text: "IN USE"; color: Theme.brand; font-size: 8.5px; font-weight: 700;
                    letter-spacing: 0.9px;
                    width: 100%; height: 100%;
                    horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        // Slack collects here, so the copy stays under the schematic and the
        // buttons stay on the floor whatever a blurb wraps to.
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 6px; vertical-stretch: 0;
            Btn { label: root.active ? "In use" : "Use this layout";
                primary: !root.active;
                clicked => { root.use(); } }
            Btn { label: "Customize"; clicked => { root.customize(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// ── page furniture ──────────────────────────────────────────────────────────

/// A solid identity chip. `flat` ones are labels, the rest are buttons.
component Chip inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <color> fill;
    in property <color> ink;
    in property <bool> flat: false;
    callback clicked();
    height: 28px; horizontal-stretch: 0; vertical-stretch: 0;
    width: lay.preferred-width;
    border-radius: Surface.rr(14px, self.width, self.height);
    background: root.flat ? root.fill : (ct.has-hover ? root.fill.darker(0.15) : root.fill);
    animate background { duration: 120ms; easing: ease-out; }
    ct := TouchArea { mouse-cursor: root.flat ? default : pointer;
        clicked => { if (!root.flat) { root.clicked(); } } }
    lay := HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 6px;
        if root.icon.width > 0: VerticalLayout { alignment: center;
            AppIcon { source: root.icon; tint: root.ink; width: 12px; height: 12px; } }
        Text { text: root.label; color: root.ink; font-size: 11px; font-weight: 700;
            vertical-alignment: center; }
    }
}

/// A titled panel. Takes its body as children so each card stays readable.
component Card inherits Rectangle {
    in property <string> title;
    in property <image> glyph;
    in property <color> tint;
    // Optional button at the right edge of the title row. Empty label = no
    // button, which is every card but Appearance.
    in property <string> action;
    // Unsaved work: the button goes ink-black so it stops reading as furniture.
    in property <bool> action-dirty: false;
    callback action-clicked();
    border-radius: Surface.card-radius;
    background: Surface.body(Theme.panel-2);
    border-width: 1px; border-color: Surface.hairline;
    if Surface.rim: Rim {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        radius: Surface.card-radius - 1px;
    }
    VerticalLayout {
        padding: 16px; spacing: 12px;
        HorizontalLayout {
            spacing: 9px; vertical-stretch: 0;
            VerticalLayout { alignment: center; horizontal-stretch: 0;
                Rectangle {
                    width: 26px; height: 26px;
                    border-radius: Surface.rr(9px, self.width, self.height);
                    background: root.tint.with-alpha(0.16);
                    AppIcon { source: root.glyph; tint: root.tint; width: 14px; height: 14px;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
            }
            VerticalLayout { alignment: center; horizontal-stretch: 1;
                Text { text: root.title; color: Theme.text; font-size: 14.5px; font-weight: 700; }
            }
            if root.action != "": VerticalLayout { alignment: center; horizontal-stretch: 0;
                Btn { label: root.action; primary: true; dirty: root.action-dirty;
                    clicked => { root.action-clicked(); } }
            }
        }
        @children
    }
}

/// Setting name, with an optional one-line explanation under it.
component RowLabel inherits VerticalLayout {
    in property <string> title;
    in property <string> blurb;
    spacing: 2px;
    Text { text: root.title; color: Theme.text; font-size: 13px; font-weight: 600; }
    if root.blurb != "": Text { text: root.blurb; color: Theme.text-dim; font-size: 11px;
        wrap: word-wrap; }
}

/// App health, as a pill. Same three colours and the same breathing lamp as the
/// sidebar key — health has its own palette everywhere in the app and borrowing
/// a section accent here would make "everything is fine" read as an identity.
/// Unlike that key this one stays inside the app: it opens the Status tab.
component StatusPill inherits Rectangle {
    in property <string> level: "unknown";
    in property <string> note: "Starting…";
    callback clicked();

    property <color> lamp:
        root.level == "ok"      ? #22c55e :
        root.level == "busy"    ? #10b981 :
        root.level == "problem" ? #ef4444 :
                                  Theme.sec-settings;
    property <bool> pulse: true;
    Timer { interval: 900ms; triggered => { root.pulse = !root.pulse; } }

    height: 34px; horizontal-stretch: 0; vertical-stretch: 0;
    width: pl.preferred-width;
    border-radius: Surface.rr(17px, self.width, self.height);
    background: root.lamp.with-alpha(pt.has-hover ? 0.20 : 0.11);
    border-width: Surface.panel-border-w;
    border-color: root.lamp.with-alpha(pt.has-hover ? 0.62 : 0.38);
    animate background, border-color { duration: 140ms; easing: ease-out; }
    pt := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    pl := HorizontalLayout {
        padding-left: 12px; padding-right: 14px; spacing: 8px;
        VerticalLayout { alignment: center; horizontal-stretch: 0;
            Rectangle {
                width: 9px; height: 9px; border-radius: 5px;
                background: root.lamp.with-alpha(root.pulse ? 1.0 : 0.45);
                animate background { duration: 850ms; easing: ease-in-out; }
            }
        }
        VerticalLayout { alignment: center; horizontal-stretch: 0;
            Text { text: root.note == "" ? "Status" : root.note;
                color: Theme.text; font-size: 11.5px; font-weight: 600;
                overflow: elide; max-width: 190px; }
        }
        VerticalLayout { alignment: center; horizontal-stretch: 0;
            AppIcon { source: Icons.chevron-right; tint: Theme.text-dim;
                width: 13px; height: 13px; }
        }
    }
}

/// A labelled switch.
component SwitchRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> blurb;
    in property <bool> on;
    callback toggled();
    spacing: 12px;
    RowLabel { title: root.title; blurb: root.blurb; horizontal-stretch: 1; }
    VerticalLayout {
        alignment: center; horizontal-stretch: 0;
        Rectangle {
            width: 46px; height: 26px;
            border-radius: Surface.rr(13px, self.width, self.height);
            background: root.on ? Accent.color : Theme.outline;
            animate background { duration: 140ms; easing: ease-out; }
            TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
            Rectangle {
                width: 20px; height: 20px;
                border-radius: Surface.rr(10px, self.width, self.height);
                background: #ffffff;
                x: root.on ? parent.width - self.width - 3px : 3px;
                y: (parent.height - self.height) / 2;
                animate x { duration: 140ms; easing: ease-out; }
            }
        }
    }
}

export component SettingsYouHome inherits Rectangle {
    in property <string> layout: "classic";
    /// Cards of the layout being customized (always the active one — Customize
    /// applies the layout first, so the popup's preview is the real thing).
    in property <[HomeCardRow]> cards: [];
    in-out property <bool> popup-open: false;
    // Live card state of the active layout, for the popup preview.
    in property <bool> hc-hero: true;
    in property <bool> hc-continue: true;
    in property <bool> hc-player: true;
    in property <bool> hc-quick: true;
    in property <bool> hc-photos: true;
    in property <bool> hc-videos: true;
    in property <bool> hc-music: true;
    in property <bool> hc-books: true;
    in property <bool> hc-cloud: true;
    in property <bool> hc-tools: true;
    in property <bool> hc-transfer: true;
    in property <bool> hc-finances: true;
    in property <bool> hc-library: true;
    in property <bool> hc-ticker: true;
    in property <bool> hc-hub: true;

    callback use-layout(string);
    callback card-set(string /*card id*/, bool);
    callback cards-reset();

    // ── identity + style (was Settings › Profile & Style) ─────────────────
    in property <UserState> user;
    in property <string> app-version;
    in property <bool> festival;          // India mark is the seasonal default
    in property <int> logo-choice;
    in-out property <ThemeChoice> theme-choice;
    in property <int> design-lang;        // 0 Standard · 1 Clay · 2 Skeuo
    in property <string> mini-widget-style: "bar";
    in property <string> tray-menu-style: "popup";
    in-out property <bool> reduce-motion;
    in property <[CreditEntry]> credits: [];
    callback pick-cover-image();
    callback pick-avatar-image();
    callback open-url(string);
    callback theme-changed(ThemeChoice);
    callback setting-text(string, string);
    callback reduce-motion-changed(bool);
    // App health for the identity row's pill, and the jump to the Status tab.
    in property <string> status-level: "unknown";
    in property <string> status-note: "Starting…";
    callback open-status();
    callback profile-save(string /*name*/, string /*unused*/, int /*logo*/);

    // Sidebar logo being edited; starts from the saved value.
    property <int> sel-logo: root.logo-choice;
    // Save-button feedback — flips the pill for 2s.
    property <bool> just-saved: false;
    // Content width inside the page's 2% gutters. Cards that need a real
    // proportion (60:40) size off this rather than off stretch factors —
    // a BoxLayout splits only the LEFTOVER width by stretch, so 6:4 there
    // lands nowhere near 60:40 once both cards have content to fit.
    property <length> page-w: sv.visible-width * 0.96;
    // Appearance keeps half the middle 60%; the mini-player card is a quarter
    // narrower than that, and the row re-centres around the pair.
    property <length> card-a: (root.page-w * 0.6 - 18px) / 2;
    property <length> card-b: root.card-a * 0.75;
    // Set when the plain default mark is picked ON PURPOSE. The seasonal swap
    // owns slot 0 otherwise, which in a festival window left no way to ask for
    // the plain mark at all — every pick of it just showed India again. This
    // lives for the session only: the choice on disk is still `default`, so the
    // next launch inside the window puts the festival mark back.
    out property <bool> default-picked: false;
    // What the sidebar wears for the pending pick. Index 0 is the seasonal
    // slot: it follows the calendar, the other four are standing choices.
    property <image> active-logo:
        root.sel-logo == 1 ? @image-url("../resources/appicons/sidebar-color.png") :
        root.sel-logo == 2 ? @image-url("../resources/appicons/sidebar-dark.png") :
        root.sel-logo == 3 ? @image-url("../resources/appicons/sidebar-white.png") :
        root.sel-logo == 4 ? @image-url("../resources/appicons/logo_india.png") :
        (root.festival && !root.default-picked)
                      ? @image-url("../resources/appicons/logo_india.png")
                      : @image-url("../resources/appicons/sidebar-default.png");

    // Display names only. The stored ids stay `classic` / `stream` / `welcome`:
    // they are what `home.layout` and every `home.hidden.<layout>` key hold on
    // disk, and renaming them would silently reset everyone's card switches for
    // no gain the user can see.
    property <string> title:
        root.layout == "cinema" ? "Cinema" :
        root.layout == "stream" ? "Timeline" :
        root.layout == "welcome" ? "Focused" : "Poweruser";

    // Switching Home out from under someone is not a click to make by accident,
    // so `Use this layout` asks first. Empty means no dialog; otherwise this is
    // the layout id waiting on an answer.
    property <string> ask-id: "";
    property <string> ask-name: "";

    background: transparent;

    sv := ScrollView {
        width: parent.width; height: parent.height;
        // Every page in this app opens at the top.
        viewport-y: 0px;
        VerticalLayout {
            width: sv.visible-width;
            // 2% of the viewport breathes on both sides at every window width.
            padding-left: sv.visible-width * 0.02;
            padding-right: sv.visible-width * 0.02;
            padding-bottom: 28px; spacing: 18px;

            // ── Identity ──────────────────────────────────────────────────
            // Cover, avatar straddling the seam, and everything else on ONE
            // row beneath it: name, version, links, and the page's two actions
            // at the right edge. The name used to sit over the cover gradient,
            // where it was unreadable on every theme and every custom image.
            Rectangle {
                vertical-stretch: 0;
                border-radius: Surface.card-radius;
                background: Surface.body(Theme.panel-2);
                border-width: 1px; border-color: Surface.hairline;
                clip: true;
                VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 158px; clip: true; vertical-stretch: 0;
                        background: @linear-gradient(120deg, Theme.brand, Theme.brand-2, Accent.color);
                        if root.user.cover-image.width != 0: Image {
                            source: root.user.cover-image; image-fit: cover;
                            width: 100%; height: 100%;
                        }
                        if root.user.cover-image.width == 0: Rectangle {
                            x: parent.width - 150px; y: -55px; width: 190px; height: 190px;
                            border-radius: 95px; background: #ffffff2a;
                        }
                        if root.user.cover-image.width == 0: Rectangle {
                            x: -40px; y: 44px; width: 130px; height: 130px;
                            border-radius: 65px; background: #00000022;
                        }
                        Rectangle {
                            width: 110px; height: 28px;
                            border-radius: Surface.rr(8px, self.width, self.height);
                            x: parent.width - self.width - 12px; y: 12px;
                            background: cov-t.has-hover ? #000000aa : #00000077;
                            border-width: 1px; border-color: #ffffff55;
                            cov-t := TouchArea { mouse-cursor: pointer; clicked => { root.pick-cover-image(); } }
                            Text { text: "Change cover"; color: #ffffff; font-size: 11px; font-weight: 600;
                                width: 100%; height: 100%;
                                horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        padding: 16px; spacing: 16px; cross-axis-alignment: center;
                        // Only the avatar rides up over the seam. The row cannot
                        // carry it directly — a BoxLayout owns its children's
                        // cross-axis position and rejects an explicit `y` — so
                        // the layout child is a short box and the avatar hangs
                        // out of the top of it.
                        Rectangle {
                            width: 92px; height: 52px; horizontal-stretch: 0;
                            background: transparent;
                            Rectangle {
                            width: 92px; height: 92px;
                            y: -40px;
                            border-radius: Surface.rr(26px, self.width, self.height);
                            clip: true;
                            background: @linear-gradient(135deg, Theme.brand, Theme.brand-2);
                            border-width: 4px;
                            border-color: av-pick.has-hover ? Accent.color : Theme.panel-2;
                            animate border-color { duration: 140ms; easing: ease-out; }
                            if root.user.avatar-image.width != 0: Image {
                                source: root.user.avatar-image; image-fit: cover; width: 100%; height: 100%;
                            }
                            if root.user.avatar-image.width == 0: AppIcon { source: Icons.user; tint: #ffffff;
                                width: 38px; height: 38px;
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            Rectangle {
                                width: 100%; height: 100%;
                                background: #000000aa.with-alpha(av-pick.has-hover ? 0.42 : 0.0);
                                animate background { duration: 140ms; easing: ease-out; }
                                AppIcon { source: Icons.pencil; tint: #ffffff;
                                    width: 24px; height: 24px; opacity: av-pick.has-hover ? 1.0 : 0.0;
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    animate opacity { duration: 140ms; easing: ease-out; } }
                            }
                            av-pick := TouchArea { mouse-cursor: pointer; clicked => { root.pick-avatar-image(); } }
                            }
                        }
                        // Name. Capped at 12 characters: the Focused layout sizes
                        // its greeting off a width factor and wraps past that.
                        // Slint has no max-length and no substring, so the cap is
                        // a revert — the last accepted value is restored on
                        // overflow, which re-enters `edited` and then takes the
                        // accepted branch, so it terminates. Rust clamps again on
                        // save and on load.
                        namecol := VerticalLayout {
                            alignment: center; spacing: 3px; horizontal-stretch: 0;
                            property <string> name-ok: root.user.display-name;
                            // The ghost sits UNDER the input, not inside it:
                            // Slint's TextInput has no placeholder, and a real
                            // string in `text` would be a name the user has to
                            // clear before typing (and would save as one).
                            Rectangle {
                                height: 26px; width: 148px;
                                background: transparent;
                                if name-ti.text == "": Text {
                                    text: "Your name";
                                    color: Theme.text-dim.with-alpha(0.45);
                                    font-size: 19px; font-weight: 700;
                                    vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                                name-ti := TextInput {
                                    text: root.user.display-name;
                                    color: Theme.text; font-size: 19px; font-weight: 700;
                                    single-line: true; width: 100%; height: 100%;
                                    edited => {
                                        if (self.text.character-count > 12) { self.text = namecol.name-ok; }
                                        else { namecol.name-ok = self.text; }
                                    }
                                }
                            }
                            Rectangle {
                                height: 2px; width: 148px;
                                border-radius: Surface.rr(1px, self.width, self.height);
                                background: name-ti.has-focus ? Accent.color : Theme.outline;
                                animate background { duration: 140ms; easing: ease-out; }
                            }
                        }
                        Chip {
                            label: "Tulipix v" + root.app-version;
                            icon: Icons.link;
                            fill: #f97316; ink: #ffffff;
                            clicked => { root.open-url("https://tulipix.pro"); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        // App health, at the right edge of the same row. Goes to
                        // the Status TAB in settings, not the loopback dashboard
                        // the sidebar key opens.
                        StatusPill {
                            level: root.status-level;
                            note: root.status-note;
                            clicked => { root.open-status(); }
                        }
                        Timer { interval: 2s; running: root.just-saved;
                            triggered => { root.just-saved = false; } }
                    }
                }
            }

            // ── Appearance · Mini Player Widget ───────────────────────────
            // Two equal cards over the middle 60% of the page: a 20% gutter on
            // each outer edge, and each card half of what is left.
            HorizontalLayout {
                spacing: 18px; vertical-stretch: 0;
                // The pair stays centred as the mini card narrows: the gutters
                // are whatever the two cards and their gap leave over.
                padding-left: (root.page-w - root.card-a - root.card-b - 18px) / 2;
                padding-right: (root.page-w - root.card-a - root.card-b - 18px) / 2;
                Card {
                    width: root.card-a;
                    title: "Appearance";
                    glyph: Icons.contrast; tint: #ec4899;
                    // Save lives here now, not in the identity row: the name
                    // field and the marks are the two things it writes, and it
                    // is a click away from both.
                    action: root.just-saved ? "Saved ✓" : "Save changes";
                    // The two things Save writes: the name and the mark. Theme,
                    // design language and Reduce motion are NOT in here — those
                    // go to disk the moment they are clicked, so counting them
                    // as unsaved work would leave the button black forever.
                    action-dirty: !root.just-saved
                        && (name-ti.text != root.user.display-name
                            || root.sel-logo != root.logo-choice
                            || root.default-picked);
                    action-clicked => {
                        // The save consumes the deliberate-default flag — the
                        // window reads it in this call and switches the seasonal
                        // swap off, so leaving it set would keep the button
                        // black with nothing left to write.
                        root.profile-save(name-ti.text, "", root.sel-logo);
                        root.default-picked = false;
                        root.just-saved = true;
                    }
                    // One column. The spacers take the slack, so the four
                    // settings spread over whatever height the taller card sets
                    // rather than pooling dead space at the foot.
                    VerticalLayout {
                        spacing: 10px;
                        Rectangle { vertical-stretch: 1; }
                        RowLabel { title: "Theme"; }
                        ThemePicker {
                            choice <=> root.theme-choice;
                            changed(c) => { root.theme-changed(c); }
                        }
                        Rectangle { vertical-stretch: 1; }
                        RowLabel { title: "Design language"; }
                        DesignLangPicker {
                            choice: root.design-lang;
                            changed(v) => {
                                root.setting-text("ui.design-language",
                                    v == 1 ? "clay" : (v == 2 ? "skeuo" : "standard"));
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                        SwitchRow {
                            title: "Reduce motion";
                            on: root.reduce-motion;
                            toggled => { root.reduce-motion-changed(!root.reduce-motion); }
                        }
                        Rectangle { vertical-stretch: 1; }
                        RowLabel { title: "Sidebar logo"; }
                        // Six tiles: what the sidebar is wearing, then the five
                        // marks to pick from. Sized by a self-measuring box —
                        // six 46px chips do not fit a half-width card at every
                        // window size, and a layout would clip rather than
                        // shrink them.
                        lrow := Rectangle {
                            property <length> gap: 8px;
                            property <length> cell: Math.min((self.width - 6 * self.gap) / 6, 46px);
                            height: self.cell + 14px;
                            Text {
                                text: "ACTIVE"; color: Theme.text-dim;
                                font-size: 8px; font-weight: 700; letter-spacing: 0.8px;
                                width: lrow.cell; horizontal-alignment: center;
                            }
                            // Preview only — no TouchArea. The five below are
                            // what changes it.
                            Rectangle {
                                y: 14px; width: lrow.cell; height: lrow.cell;
                                border-radius: Surface.rr(12px, self.width, self.height);
                                clip: true;
                                background: Surface.body(Theme.panel);
                                border-width: 2px; border-color: Accent.color;
                                Image {
                                    source: root.active-logo;
                                    image-fit: cover; width: 100%; height: 100%;
                                }
                                // Same double ring the picked chip wears.
                                Rectangle {
                                    x: 4px; y: 4px;
                                    width: parent.width - 8px; height: parent.height - 8px;
                                    border-radius: Math.max(2px, parent.border-radius - 4px);
                                    background: transparent;
                                    border-width: 1.5px;
                                    border-color: Accent.color.with-alpha(0.75);
                                }
                            }
                            LogoChip { x: 1 * (lrow.cell + lrow.gap) + lrow.gap; y: 14px;
                                width: lrow.cell; height: lrow.cell;
                                // Always the plain mark, even in a festival
                                // window: this chip standing in for India made
                                // two identical India tiles in the row. The
                                // seasonal swap shows in ACTIVE instead.
                                logo: @image-url("../resources/appicons/sidebar-default.png");
                                selected: root.sel-logo == 0;
                                clicked => { root.sel-logo = 0; root.default-picked = true; } }
                            LogoChip { x: 2 * (lrow.cell + lrow.gap) + lrow.gap; y: 14px;
                                width: lrow.cell; height: lrow.cell;
                                logo: @image-url("../resources/appicons/sidebar-color.png");
                                selected: root.sel-logo == 1;
                                clicked => { root.sel-logo = 1; root.default-picked = false; } }
                            LogoChip { x: 3 * (lrow.cell + lrow.gap) + lrow.gap; y: 14px;
                                width: lrow.cell; height: lrow.cell;
                                logo: @image-url("../resources/appicons/sidebar-dark.png");
                                selected: root.sel-logo == 2;
                                clicked => { root.sel-logo = 2; root.default-picked = false; } }
                            LogoChip { x: 4 * (lrow.cell + lrow.gap) + lrow.gap; y: 14px;
                                width: lrow.cell; height: lrow.cell;
                                logo: @image-url("../resources/appicons/sidebar-white.png");
                                selected: root.sel-logo == 3;
                                clicked => { root.sel-logo = 3; root.default-picked = false; } }
                            // Pickable all year: the seasonal swap only moves
                            // the DEFAULT chip, choosing it here is standing.
                            LogoChip { x: 5 * (lrow.cell + lrow.gap) + lrow.gap; y: 14px;
                                width: lrow.cell; height: lrow.cell;
                                logo: @image-url("../resources/appicons/logo_india.png");
                                selected: root.sel-logo == 4;
                                clicked => { root.sel-logo = 4; root.default-picked = false; } }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Card {
                    width: root.card-b;
                    title: "Mini Player Widget";
                    glyph: Icons.pip; tint: #8b5cf6;
                    VerticalLayout {
                        spacing: 10px;
                        Rectangle { vertical-stretch: 1; }
                        RowLabel { title: "Desktop widget"; }
                        StylePicker {
                            choice: root.mini-widget-style;
                            options: [
                                { label: "Bar",    value: "bar",    note: "588 × 246" },
                                { label: "Square", value: "square", note: "392 × 694" },
                                { label: "Pill",   value: "pill",   note: "420 × 112" },
                            ];
                            changed(v) => { root.setting-text("ui.mini-widget.style", v); }
                        }
                        Rectangle { vertical-stretch: 1; }
                        RowLabel { title: "Tray menu"; }
                        StylePicker {
                            choice: root.tray-menu-style;
                            options: [
                                { label: "Popup",  value: "popup",  note: "art · seek · volume" },
                                { label: "Native", value: "native", note: "OS menu, text rows" },
                            ];
                            changed(v) => { root.setting-text("ui.tray-menu.style", v); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            // ── Home layout ───────────────────────────────────────────────
            HorizontalLayout {
                spacing: 10px; vertical-stretch: 0;
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: 30px; height: 30px;
                        border-radius: Surface.rr(10px, self.width, self.height);
                        background: Theme.brand.with-alpha(0.16);
                        AppIcon { source: Icons.layout-grid; tint: Theme.brand;
                            width: 15px; height: 15px;
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1;
                    Text { text: "Home Layouts"; color: Theme.text; font-size: 15px; font-weight: 700; }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 0;
                    Rectangle {
                        width: inuse.preferred-width + 22px; height: 24px;
                        border-radius: 12px; background: Theme.brand.with-alpha(0.18);
                        inuse := Text { text: "IN USE · " + root.title; color: Theme.brand;
                            font-size: 10px; font-weight: 700; letter-spacing: 0.6px;
                            x: 11px; height: 100%; vertical-alignment: center; }
                    }
                }
            }

            // ── The four layouts, one row ─────────────────────────────────
            // Placed by hand, no GridLayout: a grid sizes its columns from what
            // the tiles ask for, so the tile with the longest blurb widens its
            // column and the four stop matching. Each is handed `cell` as both
            // width and height, and an absolutely positioned child of a plain
            // Rectangle has nothing that can re-stretch it.
            cage := Rectangle {
                property <length> gap: 14px;
                property <length> cell: (self.width - 3 * self.gap) / 4;
                property <length> step: self.cell + self.gap;
                // The 16:9 schematic inside the tile's 14px padding, plus the
                // name, a wrapped blurb and the button row under it.
                height: (self.cell - 28px) * 0.5625 + 132px;
                vertical-stretch: 0;
                // Reading order is the order they matter in: the default first.
                OptionTile {
                    x: 0px; width: cage.cell; height: parent.height;
                    id: "welcome"; name: "Focused"; active: root.layout == "welcome";
                    blurb: "The default. A big hello, the six things you launch by name, "
                         + "player at the foot.";
                    use => { root.ask-id = "welcome"; root.ask-name = "Focused"; }
                    customize => { root.use-layout("welcome"); root.popup-open = true; } }
                OptionTile {
                    x: cage.step; width: cage.cell; height: parent.height;
                    id: "classic"; name: "Poweruser"; active: root.layout == "classic";
                    blurb: "Everything at once — cards in rows with the music rail.";
                    use => { root.ask-id = "classic"; root.ask-name = "Poweruser"; }
                    customize => { root.use-layout("classic"); root.popup-open = true; } }
                OptionTile {
                    x: 2 * cage.step; width: cage.cell; height: parent.height;
                    id: "stream"; name: "Timeline"; active: root.layout == "stream";
                    blurb: "A feed of what happened, plus a standing rail.";
                    use => { root.ask-id = "stream"; root.ask-name = "Timeline"; }
                    customize => { root.use-layout("stream"); root.popup-open = true; } }
                OptionTile {
                    x: 3 * cage.step; width: cage.cell; height: parent.height;
                    id: "cinema"; name: "Cinema"; active: root.layout == "cinema";
                    blurb: "A full-bleed hero of what you were watching, rails on a shelf.";
                    use => { root.ask-id = "cinema"; root.ask-name = "Cinema"; }
                    customize => { root.use-layout("cinema"); root.popup-open = true; } }
            }

            // ── Credits ───────────────────────────────────────────────────
            Rectangle { height: 8px; vertical-stretch: 0; }
            Rectangle { height: 1px; background: Theme.outline; vertical-stretch: 0; }
            Text {
                text: "Tulipix © 2026 — Developed by Atish Ak Sharma";
                color: Theme.text-dim; font-size: 11px;
                horizontal-alignment: center;
            }
            Text { text: "BUILT WITH"; color: Theme.text-dim; font-size: 10px; font-weight: 700;
                letter-spacing: 1px; horizontal-alignment: center; }
            // Sixteen logos as an 8 x 2 grid of equal SQUARES. Same reason as
            // the layout cage above: by hand, in a box that measures itself.
            cgrid := Rectangle {
                property <length> cell: Math.min((self.width - 7 * 10px) / 8, 118px);
                property <length> step: self.cell + 10px;
                property <length> left: (self.width - (8 * self.cell + 7 * 10px)) / 2;
                height: self.cell * 2 + 10px;
                vertical-stretch: 0;
                for e[i] in root.credits: CreditTile {
                    entry: e;
                    x: cgrid.left + Math.mod(i, 8) * cgrid.step;
                    y: (i < 8 ? 0 : 1) * cgrid.step;
                    width: cgrid.cell; height: cgrid.cell;
                    open => { root.open-url(e.link); } }
            }
        }
    }

    // ── Switch confirmation ────────────────────────────────────────────────
    if root.ask-id != "": Rectangle {
        width: 100%; height: 100%; background: #00000099;
        TouchArea { clicked => { root.ask-id = ""; } }
        FocusScope {
            width: 100%; height: 100%;
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.ask-id = ""; return accept; }
                reject
            }
            Rectangle {
                width: Math.min(400px, root.width - 60px);
                height: 172px;
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                border-radius: Surface.rr(16px, self.width, self.height);
                background: Surface.body(Theme.modal);
                border-width: 1px; border-color: Surface.hairline;
                drop-shadow-blur: 40px; drop-shadow-color: #00000088;
                TouchArea { }
                VerticalLayout {
                    padding: 18px; spacing: 10px;
                    Text { text: "Switch Home to " + root.ask-name + "?"; color: Theme.text;
                        font-size: 15px; font-weight: 700; wrap: word-wrap; }
                    Text { text: "Home is redrawn in the new arrangement. Your card switches for "
                             + "each layout are remembered separately, so switching back restores them.";
                        color: Theme.text-dim; font-size: 11px; wrap: word-wrap;
                        vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        Btn { label: "Cancel"; clicked => { root.ask-id = ""; } }
                        // ask-id is read by the callback above it, so it is
                        // cleared LAST — this component is gated on it.
                        Btn { label: "Switch"; primary: true;
                            clicked => { root.use-layout(root.ask-id); root.ask-id = ""; } }
                    }
                }
            }
        }
    }

    // ── Customize popup ────────────────────────────────────────────────────
    if root.popup-open: Rectangle {
        width: 100%; height: 100%; background: #00000099;
        TouchArea { clicked => { root.popup-open = false; } }
        FocusScope {
            width: 100%; height: 100%;
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { root.popup-open = false; return accept; }
                reject
            }
            Rectangle {
                width: Math.min(820px, root.width - 60px);
                height: Math.min(520px, root.height - 60px);
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                border-radius: Surface.rr(18px, self.width, self.height);
                background: Surface.body(Theme.modal);
                border-width: 1px; border-color: Surface.hairline;
                drop-shadow-blur: 40px; drop-shadow-color: #00000088;
                // Swallow backdrop clicks that land on the card.
                TouchArea { }

                VerticalLayout {
                    padding: 18px; spacing: 14px;

                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1;
                            Text { text: root.title + " — cards"; color: Theme.text;
                                font-size: 15px; font-weight: 700; }
                        }
                        Btn { label: "Done"; primary: true; clicked => { root.popup-open = false; } }
                    }

                    HorizontalLayout {
                        spacing: 16px; vertical-stretch: 1;

                        VerticalLayout {
                            width: 300px; horizontal-stretch: 0; spacing: 8px;
                            // The schematic rides the middle of the column, not
                            // its top — the card list beside it is taller.
                            Rectangle { vertical-stretch: 1; }
                            LayoutThumb {
                                kind: root.layout; height: 190px; vertical-stretch: 0;
                                hc-hero: root.hc-hero;
                                hc-continue: root.hc-continue;
                                hc-player: root.hc-player;
                                hc-quick: root.hc-quick;
                                hc-photos: root.hc-photos;
                                hc-videos: root.hc-videos;
                                hc-music: root.hc-music;
                                hc-books: root.hc-books;
                                hc-cloud: root.hc-cloud;
                                hc-tools: root.hc-tools;
                                hc-transfer: root.hc-transfer;
                                hc-finances: root.hc-finances;
                                hc-library: root.hc-library;
                                hc-ticker: root.hc-ticker;
                                hc-hub: root.hc-hub;
                            }
                            Text { text: "Live preview"; color: Theme.text-dim; font-size: 10px;
                                letter-spacing: 1.2px; }
                            Rectangle { vertical-stretch: 1; }
                            Btn { label: "Reset to default"; clicked => { root.cards-reset(); } }
                        }

                        csv := ScrollView {
                            horizontal-stretch: 1;
                            viewport-y: 0px;
                            VerticalLayout {
                                width: csv.visible-width;
                                spacing: 6px;
                                for c in root.cards: Rectangle {
                                    height: 46px;
                                    border-radius: Surface.rr(11px, self.width, self.height);
                                    background: Theme.glass;
                                    border-width: 1px; border-color: Surface.hairline;
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: 11px;
                                        VerticalLayout {
                                            alignment: center; spacing: 2px; horizontal-stretch: 1;
                                            Text { text: c.label; color: Theme.text;
                                                font-size: 12px; font-weight: 600; overflow: elide; }
                                            Text { text: c.locked
                                                    ? "Last card on — Home cannot be empty"
                                                    : c.hint;
                                                color: c.locked ? Theme.warn : Theme.text-dim;
                                                font-size: 10px; overflow: elide; }
                                        }
                                        VerticalLayout {
                                            alignment: center; horizontal-stretch: 0;
                                            Sw {
                                                on: c.on; locked: c.locked;
                                                toggled => { root.card-set(c.id, !c.on); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
