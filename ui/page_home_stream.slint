// Home layout 4 of 5 — STREAM. Spec: docs/home-layouts/04-stream.md.
//
// A time-ordered feed of what actually happened, and a standing rail of what is
// true right now. The feed is merged in Rust from the eight section databases
// plus the app's activity log (there is no events table — see the spec's §Data,
// option 1) and capped; this page only draws it.
import { Theme } from "tokens.slint";
import { Icons, AppIcon } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { HomeStats } from "page_home.slint";
import { HomeDue } from "page_home_cinema.slint";

/// One row of the feed. Built in Rust: the timestamp is already a clock string,
/// the group caption is already decided, and `head` says whether this row is the
/// first of its group — Slint cannot look at the previous row of a model.
export struct HomeEvent {
    at: string,          // "19:42"
    group: string,       // "NOW" | "TODAY" | "YESTERDAY" | "EARLIER"
    head: bool,          // draw the group caption above this row
    section: string,     // photos | videos | music | books | cloud | tools | transfer | finances | library
    kind: string,        // added | played | resumed | episode | job | sent | received | paid | note
    title: string,
    sub: string,
    action: string,      // pill label; "" = no pill
    alarm: bool,         // pill and dot in the error tint
    // What the pill acts on, where there is something concrete: a book id, a
    // podcast episode id, a video path. -1 / "" means the pill only opens the
    // section, which the row click already does — so those rows carry no pill.
    id: int,
    path: string,
    t1: image,
    t2: image,
    t3: image,
}

// ── Filter chip ─────────────────────────────────────────────────────────────
component FeedChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    height: 28px;
    width: lab.preferred-width + 26px;
    border-radius: 14px;
    background: root.active ? Theme.text : (t.has-hover ? Theme.glass-strong : Theme.glass);
    border-width: 1px;
    border-color: root.active ? Theme.text : Theme.glass-border;
    animate background { duration: 120ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    lab := Text {
        text: root.label;
        color: root.active ? Theme.text-inv : Theme.text-dim;
        font-size: 11.5px; font-weight: root.active ? 700 : 500;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}

// ── Action pill on a feed row ───────────────────────────────────────────────
component ActionPill inherits Rectangle {
    in property <string> label;
    in property <bool> alarm: false;
    in property <color> accent;
    callback clicked();
    height: 28px;
    // Never wraps: "Mark paid" on two lines was the mockup's one real bug.
    width: lab.preferred-width + 24px;
    border-radius: 14px;
    background: t.has-hover
        ? (root.alarm ? Theme.error.with-alpha(0.22) : root.accent.with-alpha(0.22))
        : (root.alarm ? Theme.error.with-alpha(0.12) : Theme.glass);
    border-width: 1px;
    border-color: root.alarm ? Theme.error.with-alpha(0.5) : Theme.glass-border;
    animate background { duration: 110ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    lab := Text {
        text: root.label; wrap: no-wrap;
        color: root.alarm ? Theme.error : Theme.text;
        font-size: 11px; font-weight: 600;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}

// ── Rail block caption ──────────────────────────────────────────────────────
component RailCap inherits Rectangle {
    in property <string> label;
    in property <color> accent;
    in property <string> note;
    height: 26px;
    background: transparent;
    HorizontalLayout {
        spacing: 8px; alignment: start;
        Text { text: root.label; color: root.accent; font-size: 10px; font-weight: 700;
            letter-spacing: 1.5px; vertical-alignment: center; horizontal-stretch: 0; }
        Rectangle { height: 1px; background: Theme.outline; horizontal-stretch: 1;
            y: (parent.height - self.height) / 2; }
        Text { text: root.note; color: Theme.text-dim; font-size: 10px;
            vertical-alignment: center; horizontal-stretch: 0; }
    }
}

// ── Transport button ────────────────────────────────────────────────────────
component StreamBtn inherits Rectangle {
    in property <image> icon;
    in property <bool> primary: false;
    callback clicked();
    width: root.primary ? 34px : 28px;
    height: self.width;
    border-radius: self.width / 2;
    background: root.primary
        ? (t.has-hover ? Theme.text : Theme.text.with-alpha(0.88))
        : (t.has-hover ? Theme.glass-strong : Theme.glass);
    animate background { duration: 110ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    AppIcon {
        source: root.icon;
        tint: root.primary ? Theme.text-inv : Theme.text-dim;
        width: root.primary ? 15px : 13px; height: self.width;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}

export component HomeStream inherits Rectangle {
    // ── Header ──────────────────────────────────────────────────────────────
    in property <string> greeting: "Welcome";
    in property <string> date-line: "";
    in property <string> library-line: "";
    // ── Feed ────────────────────────────────────────────────────────────────
    in property <[HomeEvent]> events: [];
    in property <string> filter: "all";       // all | media | money | devices
    in property <string> feed-note: "";       // "Nothing today — showing the last three days"
    // ── Rail ────────────────────────────────────────────────────────────────
    in property <HomeStats> stats;
    in property <string> np-title: "";
    in property <string> np-sub: "";
    in property <image> np-art;
    in property <color> np-accent: Theme.sec-music;
    in property <bool> playing: false;
    in property <string> pos-label: "";
    in property <string> dur-label: "";
    in property <string> fin-spent: "";
    in property <string> fin-month: "";
    in property <string> fin-liquid: "";
    in property <[float]> fin-months: [];
    in property <[HomeDue]> fin-dues: [];
    in property <string> transfer-inbox: "";
    in property <[HomeDue]> next-rows: [];    // reuses HomeDue: name · amount · when
    // ── Card visibility ─────────────────────────────────────────────────────
    // The eight section cards filter the feed; finances and transfer also own
    // their rail block, which is what the popup's hint line says.
    in property <bool> hc-photos: true;
    in property <bool> hc-videos: true;
    in property <bool> hc-music: true;
    in property <bool> hc-books: true;
    in property <bool> hc-cloud: true;
    in property <bool> hc-tools: true;
    in property <bool> hc-transfer: true;
    in property <bool> hc-finances: true;
    in property <bool> hc-player: true;
    in property <bool> hc-library: true;
    in property <bool> hc-next: true;

    callback open-section(string);
    callback open-search();
    callback set-filter(string);
    callback event-action(HomeEvent);
    callback playpause();
    callback next();
    callback prev();
    callback start-sharing();

    // ── Geometry (spec §Geometry) ───────────────────────────────────────────
    property <length> pad: 28px;
    property <int> rail-n: (root.hc-player ? 1 : 0) + (root.hc-finances ? 1 : 0)
        + (root.hc-transfer ? 1 : 0) + (root.hc-library ? 1 : 0) + (root.hc-next ? 1 : 0);
    // The rail keeps its width until every block is off, then it disappears and
    // the feed takes the whole page.
    property <length> rail-w: root.rail-n > 0 ? 396px : 0px;
    property <length> head-h: 96px;
    property <length> feed-w: root.width - 2 * root.pad - root.rail-w
        - (root.rail-w > 0px ? root.pad : 0px);
    property <bool> fin-late: root.fin-dues.length > 0 && root.fin-dues[0].late;

    function accent-of(section: string) -> color {
        section == "photos" ? Theme.sec-photos
            : section == "videos" ? Theme.sec-videos
            : section == "music" ? Theme.sec-music
            : section == "books" ? Theme.sec-books
            : section == "cloud" ? Theme.sec-cloud
            : section == "tools" ? Theme.sec-tools
            : section == "transfer" ? Theme.sec-transfer
            : section == "finances" ? Theme.sec-finances
            : Theme.brand
    }

    background: Theme.bg;
    clip: true;

    // ── Header ──────────────────────────────────────────────────────────────
    Rectangle {
        x: root.pad; y: 20px; width: root.width - 2 * root.pad; height: root.head-h - 24px;
        background: transparent;
        VerticalLayout {
            spacing: 12px; alignment: start;
            HorizontalLayout {
                height: 30px; spacing: 12px; alignment: start;
                VerticalLayout {
                    alignment: center; spacing: 1px; horizontal-stretch: 1;
                    Text { text: root.greeting; color: Theme.text; font-size: 24px;
                        font-weight: 700; letter-spacing: -0.9px; overflow: elide; }
                }
                Text {
                    text: root.date-line + (root.library-line == "" ? "" : " · " + root.library-line);
                    color: Theme.text-dim; font-size: 11px; horizontal-stretch: 0;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 30px; height: 30px; border-radius: 15px; horizontal-stretch: 0;
                    y: (parent.height - self.height) / 2;
                    background: sb.has-hover ? Theme.glass-strong : Theme.glass;
                    border-width: 1px; border-color: Theme.glass-border;
                    sb := TouchArea { mouse-cursor: pointer; clicked => { root.open-search(); } }
                    AppIcon { source: Icons.search; tint: Theme.text-dim; width: 14px; height: 14px;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
            }
            // Groups, not sections: the chips answer "what kind of thing", and
            // one only appears while a section behind it is still visible.
            HorizontalLayout {
                height: 28px; spacing: 8px; alignment: start;
                FeedChip { label: "Everything"; active: root.filter == "all";
                    horizontal-stretch: 0; clicked => { root.set-filter("all"); } }
                if root.hc-photos || root.hc-videos || root.hc-music || root.hc-books: FeedChip {
                    label: "Media"; active: root.filter == "media";
                    horizontal-stretch: 0; clicked => { root.set-filter("media"); } }
                if root.hc-finances: FeedChip {
                    label: "Money"; active: root.filter == "money";
                    horizontal-stretch: 0; clicked => { root.set-filter("money"); } }
                if root.hc-transfer || root.hc-cloud || root.hc-tools: FeedChip {
                    label: "Devices"; active: root.filter == "devices";
                    horizontal-stretch: 0; clicked => { root.set-filter("devices"); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }

    // ── Feed ────────────────────────────────────────────────────────────────
    Rectangle {
        x: root.pad; y: root.head-h;
        width: root.feed-w; height: root.height - root.head-h - root.pad;
        background: transparent;
        clip: true;

        // Empty is a state with something to say, not a blank column.
        if root.events.length == 0: VerticalLayout {
            alignment: start; spacing: 8px;
            Rectangle { height: 40px; }
            Text { text: "Nothing recorded yet"; color: Theme.text; font-size: 17px;
                font-weight: 700; }
            Text {
                text: "Play something, import a folder, or send a file — this column is "
                    + "the record of what the app did.";
                color: Theme.text-dim; font-size: 12px; wrap: word-wrap;
            }
        }

        if root.events.length > 0: fsv := ScrollView {
            width: 100%; height: 100%;
            // Every page opens at the top (ui-scroll-start-top).
            viewport-y: 0px;
            VerticalLayout {
                spacing: 0; alignment: start;
                if root.feed-note != "": Rectangle {
                    height: 34px;
                    Text { text: root.feed-note; color: Theme.text-dim; font-size: 11px;
                        vertical-alignment: center; }
                }
                for e[i] in root.events: Rectangle {
                    height: (e.head ? 30px : 0px) + 66px;
                    background: transparent;
                    VerticalLayout {
                        spacing: 0;
                        // Group caption. Zero-height when this row continues the
                        // previous group — a repeater with an `if` inside is the
                        // slint#6426 shape.
                        Rectangle {
                            height: e.head ? 30px : 0px;
                            opacity: e.head ? 1.0 : 0.0;
                            Text {
                                text: e.group; color: Theme.text-dim.with-alpha(0.7);
                                font-size: 9.5px; font-weight: 700; letter-spacing: 1.5px;
                                y: parent.height - self.height - 8px;
                            }
                        }
                        Rectangle {
                            height: 66px;
                            background: rt.has-hover ? Theme.glass : transparent;
                            border-radius: 10px;
                            animate background { duration: 110ms; easing: ease-out; }
                            rt := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-section(e.section); }
                            }
                            HorizontalLayout {
                                padding-right: 8px; spacing: 0; alignment: start;
                                // Time gutter.
                                Text {
                                    text: e.at; color: Theme.text-dim; font-size: 11px;
                                    width: 62px; horizontal-stretch: 0;
                                    vertical-alignment: center;
                                }
                                // Dot rail. The connecting line runs the full row
                                // height so consecutive rows join; the last row's
                                // tail is hidden by the layout's own clip.
                                Rectangle {
                                    width: 26px; horizontal-stretch: 0;
                                    background: transparent;
                                    Rectangle {
                                        width: 1px; height: parent.height;
                                        x: (parent.width - self.width) / 2;
                                        background: Theme.outline;
                                        opacity: i == root.events.length - 1 ? 0.0 : 1.0;
                                    }
                                    Rectangle {
                                        width: 9px; height: 9px; border-radius: 5px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        background: e.alarm ? Theme.error : root.accent-of(e.section);
                                        // Page-coloured ring so the dot sits on the
                                        // line rather than being crossed by it.
                                        border-width: 4px;
                                        border-color: Theme.bg;
                                    }
                                }
                                // Body.
                                VerticalLayout {
                                    alignment: center; spacing: 3px;
                                    horizontal-stretch: 1; min-width: 0;
                                    Text {
                                        // Collapsed runs already read as counts
                                        // ("34 photos added") — the fold happens
                                        // in Rust, where the plural is decided.
                                        text: e.title;
                                        color: Theme.text; font-size: 13px; font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text { text: e.sub; color: Theme.text-dim; font-size: 10.5px;
                                        overflow: elide; }
                                }
                                // Thumbnails, when the event has any.
                                HorizontalLayout {
                                    spacing: 5px; alignment: center; horizontal-stretch: 0;
                                    Rectangle {
                                        width: e.t1.width > 0 ? 62px : 0px; height: 44px; clip: true;
                                        border-radius: 6px; background: Theme.panel-2;
                                        y: (parent.height - self.height) / 2;
                                        if e.t1.width > 0: Image { source: e.t1; image-fit: cover;
                                            width: 100%; height: 100%; }
                                    }
                                    Rectangle {
                                        width: e.t2.width > 0 ? 62px : 0px; height: 44px; clip: true;
                                        border-radius: 6px; background: Theme.panel-2;
                                        y: (parent.height - self.height) / 2;
                                        if e.t2.width > 0: Image { source: e.t2; image-fit: cover;
                                            width: 100%; height: 100%; }
                                    }
                                    Rectangle {
                                        width: e.t3.width > 0 ? 62px : 0px; height: 44px; clip: true;
                                        border-radius: 6px; background: Theme.panel-2;
                                        y: (parent.height - self.height) / 2;
                                        if e.t3.width > 0: Image { source: e.t3; image-fit: cover;
                                            width: 100%; height: 100%; }
                                    }
                                }
                                // Action pill.
                                Rectangle {
                                    width: e.action == "" ? 0px : 100px; horizontal-stretch: 0;
                                    background: transparent;
                                    if e.action != "": ActionPill {
                                        label: e.action; alarm: e.alarm;
                                        accent: root.accent-of(e.section);
                                        x: parent.width - self.width;
                                        y: (parent.height - self.height) / 2;
                                        clicked => { root.event-action(e); }
                                    }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px; width: 100%; height: 1px;
                                background: Theme.outline.with-alpha(0.6);
                            }
                        }
                    }
                }
                Rectangle { height: 20px; }
            }
        }
    }

    // ── Rail ────────────────────────────────────────────────────────────────
    if root.rail-n > 0: Rectangle {
        x: root.width - root.pad - root.rail-w;
        y: root.head-h - 24px;
        width: root.rail-w; height: root.height - root.head-h - root.pad + 24px;
        background: transparent;
        // The 1 px rule that separates the rail from the feed.
        Rectangle { x: -root.pad / 2; width: 1px; height: 100%; background: Theme.outline; }
        VerticalLayout {
            spacing: 14px; alignment: start;

            // PLAYER — what is in your ears right now.
            if root.hc-player: VerticalLayout {
                spacing: 10px;
                RailCap { label: "PLAYING"; accent: root.np-accent;
                    note: root.pos-label + (root.dur-label == "" ? "" : " / " + root.dur-label); }
                HorizontalLayout {
                    height: 62px; spacing: 12px; alignment: start;
                    Rectangle {
                        width: 62px; height: 62px; border-radius: 12px; clip: true;
                        horizontal-stretch: 0;
                        background: root.np-accent.with-alpha(0.2);
                        if root.np-art.width > 0: Image { source: root.np-art; image-fit: cover;
                            width: 100%; height: 100%; }
                        if root.np-art.width == 0: AppIcon { source: Icons.music;
                            tint: root.np-accent; width: 20px; height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2; }
                    }
                    VerticalLayout {
                        alignment: center; spacing: 8px; horizontal-stretch: 1; min-width: 0;
                        Text { text: root.np-title == "" ? "Nothing playing" : root.np-title;
                            color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                        HorizontalLayout {
                            spacing: 7px; alignment: start; height: 34px;
                            StreamBtn { icon: Icons.skip-back; horizontal-stretch: 0;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.prev(); } }
                            StreamBtn { icon: root.playing ? Icons.pause : Icons.play;
                                primary: true; horizontal-stretch: 0;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.playpause(); } }
                            StreamBtn { icon: Icons.skip-forward; horizontal-stretch: 0;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.next(); } }
                            Text { text: root.np-sub; color: Theme.text-dim; font-size: 10.5px;
                                vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        }
                    }
                }
            }

            // STANDING — the money that is true regardless of today's feed.
            if root.hc-finances: VerticalLayout {
                spacing: 8px;
                RailCap { label: "STANDING"; accent: Theme.sec-finances; note: root.fin-month; }
                HorizontalLayout {
                    height: 40px; spacing: 10px;
                    Text {
                        text: root.fin-spent == "" ? "—" : root.fin-spent;
                        color: root.fin-late ? Theme.error : Theme.text;
                        font-size: 27px; font-weight: 700; letter-spacing: -1px;
                        vertical-alignment: center; horizontal-stretch: 0;
                    }
                    Text {
                        text: root.fin-liquid == "" ? "spent" : "spent · " + root.fin-liquid + " liquid";
                        color: Theme.text-dim; font-size: 10.5px;
                        vertical-alignment: bottom; overflow: elide; horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    height: 30px; spacing: 3px;
                    for m[i] in root.fin-months: Rectangle {
                        border-radius: 2px;
                        y: parent.height - self.height;
                        height: Math.max(2px, parent.height * Math.max(0.04, m));
                        background: i == root.fin-months.length - 1
                            ? Theme.sec-finances : Theme.sec-finances.with-alpha(0.32);
                    }
                }
                VerticalLayout {
                    spacing: 0;
                    for d in root.fin-dues: HorizontalLayout {
                        height: 28px; spacing: 8px;
                        Rectangle {
                            width: 6px; height: 6px; border-radius: 3px; horizontal-stretch: 0;
                            y: (parent.height - self.height) / 2;
                            background: d.late ? Theme.error : Theme.warn;
                        }
                        Text { text: d.name; color: Theme.text; font-size: 11.5px;
                            vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Text { text: d.amount; color: Theme.text; font-size: 11.5px;
                            font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
                        Text { text: d.when; color: d.late ? Theme.error : Theme.text-dim;
                            font-size: 10px; vertical-alignment: center; width: 56px;
                            horizontal-alignment: right; horizontal-stretch: 0; }
                    }
                }
            }

            // DEVICES — a door while the section is closed (the server only binds
            // while Transfer is open), so it offers the action and the inbox.
            if root.hc-transfer: VerticalLayout {
                spacing: 8px;
                RailCap { label: "DEVICES"; accent: Theme.sec-transfer; note: "local network"; }
                HorizontalLayout {
                    height: 34px; spacing: 10px; alignment: start;
                    Rectangle {
                        width: 134px; height: 34px; border-radius: 17px; horizontal-stretch: 0;
                        background: @linear-gradient(140deg, Theme.transfer-accent,
                            Theme.transfer-accent-2);
                        sh := TouchArea { mouse-cursor: pointer; clicked => { root.start-sharing(); } }
                        HorizontalLayout {
                            spacing: 7px; alignment: center;
                            AppIcon { source: Icons.zap; tint: #231000; width: 14px; height: 14px;
                                y: (parent.height - self.height) / 2; }
                            Text { text: "Start sharing"; color: #231000; font-size: 11.5px;
                                font-weight: 700; vertical-alignment: center; }
                        }
                    }
                    Text {
                        text: root.transfer-inbox == "" ? "Inbox not set yet"
                            : "Inbox " + root.transfer-inbox;
                        color: Theme.text-dim; font-size: 10.5px;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    }
                }
            }

            // LIBRARY — the counter table.
            if root.hc-library: VerticalLayout {
                spacing: 6px;
                RailCap { label: "LIBRARY"; accent: Theme.sec-photos; note: root.library-line; }
                for r in [
                    { label: "Photos", value: root.stats.photos, section: "photos",
                      tint: Theme.sec-photos },
                    { label: "Videos", value: root.stats.videos, section: "videos",
                      tint: Theme.sec-videos },
                    { label: "Tracks", value: root.stats.songs, section: "music",
                      tint: Theme.sec-music },
                    { label: "Books", value: root.stats.books, section: "books",
                      tint: Theme.sec-books },
                ]: Rectangle {
                    height: 26px;
                    background: lt.has-hover ? Theme.glass : transparent;
                    border-radius: 6px;
                    lt := TouchArea { mouse-cursor: pointer;
                        clicked => { root.open-section(r.section); } }
                    HorizontalLayout {
                        padding-left: 4px; padding-right: 4px; spacing: 8px;
                        Rectangle { width: 5px; height: 5px; border-radius: 3px;
                            horizontal-stretch: 0; y: (parent.height - self.height) / 2;
                            background: r.tint; }
                        Text { text: r.label; color: Theme.text-dim; font-size: 11.5px;
                            vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: r.value + ""; color: Theme.text; font-size: 11.5px;
                            font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
                    }
                }
            }

            // NEXT — what has not happened yet: dues coming up, and what you are
            // nearly finished with.
            if root.hc-next: VerticalLayout {
                spacing: 6px;
                RailCap { label: "NEXT"; accent: Theme.brand;
                    note: root.next-rows.length == 0 ? "clear" : root.next-rows.length + " items"; }
                if root.next-rows.length == 0: Text {
                    text: "Nothing scheduled. No dues in the next week, nothing nearly finished.";
                    color: Theme.text-dim; font-size: 10.5px; wrap: word-wrap;
                }
                for n in root.next-rows: HorizontalLayout {
                    height: 28px; spacing: 8px;
                    Rectangle { width: 5px; height: 5px; border-radius: 3px; horizontal-stretch: 0;
                        y: (parent.height - self.height) / 2;
                        background: n.late ? Theme.warn : Theme.brand; }
                    Text { text: n.name; color: Theme.text; font-size: 11.5px;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: n.amount; color: Theme.text-dim; font-size: 11px;
                        vertical-alignment: center; horizontal-stretch: 0; }
                    Text { text: n.when; color: Theme.text-dim; font-size: 10px;
                        vertical-alignment: center; width: 56px; horizontal-alignment: right;
                        horizontal-stretch: 0; }
                }
            }
        }
    }
}
