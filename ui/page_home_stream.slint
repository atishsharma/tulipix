// Home layout 4 of 5 — STREAM. Spec: docs/home-layouts/04-stream.md.
//
// A time-ordered feed of what actually happened, and a standing rail of what is
// true right now. The feed is merged in Rust from the eight section databases
// plus the app's activity log (there is no events table — see the spec's §Data,
// option 1) and capped; this page only draws it.
import { Theme } from "tokens.slint";
import { Surface } from "surface.slint";
import { Icons, AppIcon } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { HomeStats } from "page_home.slint";
import { HomeDue, TopPill, CineBtn } from "page_home_cinema.slint";
import { MusicSongRow, MusicLyricLine } from "music_common.slint";
import { WelMarquee } from "page_home_welcome.slint";

/// One row of the feed. Built in Rust: the timestamp is already a clock string,
/// the group caption is already decided, and `head` says whether this row is the
/// first of its group — Slint cannot look at the previous row of a model.
export struct HomeEvent {
    at: string,          // "19:42"
    day: string,         // "11-08-26" — the clock alone did not say which day
    group: string,       // "NOW" | "TODAY" | "YESTERDAY" | "EARLIER"
    head: bool,          // draw the group caption above this row
    section: string,     // photos | videos | music | books | cloud | tools | transfer | finances | library
    kind: string,        // added | played | resumed | episode | job | sent | received | paid | note
    title: string,
    sub: string,
    action: string,      // pill label; "" = no pill
    alarm: bool,         // pill and dot in the error tint
    // What the pill acts on, where there is something concrete: a book id, a
    // podcast episode id, a video path. -1 / "" means the pill only opens the
    // section, which the row click already does — so those rows carry no pill.
    id: int,
    path: string,
    t1: image,
    t2: image,
    t3: image,
}

// ── Filter key, in the floating bar ─────────────────────────────────────────
// Material's bottom bar: icon and label inside ONE pill, so the key reads as a
// single thing — a label hanging under a separate pill was two.
component FeedChip inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <color> accent: Theme.brand;
    in property <bool> active: false;
    callback clicked();
    height: 40px;
    width: lab.preferred-width + 54px;
    border-radius: 20px;
    background: root.active ? root.accent
        : (t.has-hover ? Theme.glass-strong : transparent);
    animate background { duration: 140ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 15px; padding-right: 15px; spacing: 8px; alignment: center;
        AppIcon {
            source: root.icon;
            tint: root.active ? #ffffff : Theme.text-dim;
            width: 15px; height: parent.height; horizontal-stretch: 0;
        }
        lab := Text {
            text: root.label;
            color: root.active ? #ffffff : Theme.text-dim;
            font-size: 11.5px; font-weight: root.active ? 700 : 500;
            vertical-alignment: center; horizontal-stretch: 0;
        }
    }
}

// ── Left-hand scrollbar ─────────────────────────────────────────────────────
// A `ScrollView` always draws its bar on the right, so the bar here is our own:
// the view keeps its own bar switched off and this one drives `viewport-y`.
// Track and thumb only, no arrows — drag it, or use the wheel over the view.
component SideScroll inherits Rectangle {
    in property <length> viewport-h;    // total content height
    in property <length> visible-h;     // window onto it
    in-out property <length> pos;       // the view's viewport-y (0 or negative)
    property <length> over: Math.max(0px, root.viewport-h - root.visible-h);
    property <length> thumb-h: root.over <= 0px ? 0px
        : Math.max(34px, root.visible-h * (root.visible-h / root.viewport-h));
    property <length> travel: Math.max(0px, root.visible-h - root.thumb-h);
    property <float> frac: root.over <= 0px ? 0 : Math.clamp(-root.pos / root.over, 0.0, 1.0);
    width: 6px;
    background: transparent;
    visible: root.over > 0px;
    Rectangle {
        width: 4px; x: (parent.width - self.width) / 2;
        height: 100%; border-radius: 2px;
        background: Theme.text.with-alpha(0.08);
    }
    knob := Rectangle {
        width: parent.width; x: 0;
        y: root.travel * root.frac;
        height: root.thumb-h; border-radius: 3px;
        background: t.pressed || t.has-hover
            ? Theme.text.with-alpha(0.55) : Theme.text.with-alpha(0.28);
        animate background { duration: 120ms; easing: ease-out; }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        // Wherever the pointer goes the middle of the thumb follows, so a click
        // on the track jumps and a drag scrubs with the same one line.
        function to(y: length) {
            root.pos = -root.over * Math.clamp(
                (y - root.thumb-h / 2) / Math.max(1px, root.travel), 0.0, 1.0);
        }
        moved => { if (self.pressed) { self.to(self.mouse-y); } }
        clicked => { self.to(self.mouse-y); }
    }
}

// ── Action pill on a feed row ───────────────────────────────────────────────
component ActionPill inherits Rectangle {
    in property <string> label;
    in property <bool> alarm: false;
    in property <color> accent;
    callback clicked();
    height: 28px;
    // Never wraps: "Mark paid" on two lines was the mockup's one real bug.
    width: lab.preferred-width + 24px;
    border-radius: 14px;
    background: t.has-hover
        ? (root.alarm ? Theme.error.with-alpha(0.22) : root.accent.with-alpha(0.22))
        : (root.alarm ? Theme.error.with-alpha(0.12) : Theme.glass);
    border-width: 1px;
    border-color: root.alarm ? Theme.error.with-alpha(0.5) : Theme.glass-border;
    animate background { duration: 110ms; easing: ease-out; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    lab := Text {
        text: root.label; wrap: no-wrap;
        color: root.alarm ? Theme.error : Theme.text;
        font-size: 11px; font-weight: 600;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}

// ── Rail block caption ──────────────────────────────────────────────────────
component RailCap inherits Rectangle {
    in property <string> label;
    in property <color> accent;
    in property <string> note;
    height: 26px;
    background: transparent;
    HorizontalLayout {
        spacing: 8px; alignment: start;
        Text { text: root.label; color: root.accent; font-size: 10px; font-weight: 700;
            letter-spacing: 1.5px; vertical-alignment: center; horizontal-stretch: 0; }
        Rectangle { height: 1px; background: Theme.outline; horizontal-stretch: 1;
            y: (parent.height - self.height) / 2; }
        Text { text: root.note; color: Theme.text-dim; font-size: 10px;
            vertical-alignment: center; horizontal-stretch: 0; }
    }
}

export component HomeStream inherits Rectangle {
    // ── Header ──────────────────────────────────────────────────────────────
    in property <string> greeting: "Welcome";
    in property <string> date-line: "";
    in property <string> library-line: "";
    in property <int> logo-choice: 0;
    in property <bool> festival: false;
    in property <int> tool-count: 0;
    // ── Feed ────────────────────────────────────────────────────────────────
    in property <[HomeEvent]> events: [];
    in property <string> filter: "all";       // all | media | money | devices
    in property <string> feed-note: "";       // "Nothing today — showing the last three days"
    // ── Rail ────────────────────────────────────────────────────────────────
    in property <HomeStats> stats;
    in property <string> np-title: "";
    in property <string> np-sub: "";
    in property <image> np-art;
    in property <color> np-accent: Theme.sec-music;
    in property <bool> playing: false;
    in property <float> pos: 0;
    in property <float> dur: 0;
    in property <string> pos-label: "";
    in property <string> dur-label: "";
    in property <bool> shuffle: false;
    in property <string> repeat: "off";
    in property <float> volume: 100;        // mpv's 0–130 percent, not a fraction
    in property <bool> muted: false;
    in property <[MusicSongRow]> queue-rows: [];
    in property <int> np-index: -1;         // playback position of what is playing
    in property <[MusicLyricLine]> lyrics-rows: [];
    in property <int> lyrics-active: -1;
    // Which tab the sound comes from — the rail's PLAYING caption names it, and
    // clicking the caption goes there.
    in property <string> player-mode: "music";   // music | podcast | radio | book
    in property <bool> yt-now-video: false;
    in property <string> fin-spent: "";
    in property <string> fin-month: "";
    in property <[float]> fin-months: [];
    // One label ("Jul 2026") and one amount per bar, same order as `fin-months`
    // — so picking a bar can restate the block without another backend round
    // trip. Slint structs cannot come from page_finances.slint without dragging
    // that 388 KB file in, so these travel as two plain string models.
    in property <[string]> fin-month-labels: [];
    in property <[string]> fin-month-spends: [];
    in property <[HomeDue]> fin-dues: [];
    in property <string> transfer-inbox: "";
    // ── Card visibility ─────────────────────────────────────────────────────
    // The eight section cards filter the feed; finances and transfer also own
    // their rail block, which is what the popup's hint line says.
    in property <bool> hc-photos: true;
    in property <bool> hc-videos: true;
    in property <bool> hc-music: true;
    in property <bool> hc-books: true;
    in property <bool> hc-cloud: true;
    in property <bool> hc-tools: true;
    in property <bool> hc-transfer: true;
    in property <bool> hc-finances: true;
    in property <bool> hc-player: true;
    in property <bool> hc-library: true;
    in property <bool> hc-quick: true;      // the launcher pills in the header

    callback open-section(string);
    callback set-filter(string);
    callback event-action(HomeEvent);
    callback playpause();
    callback next();
    callback prev();
    callback start-sharing();
    callback seek(float);
    callback shuffle-all();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-mute();
    callback set-volume(float);
    callback play-queue(int);
    // Home never asks for the Up-next list on its own — only the Music section's
    // panels do — so the queue is asked for when the drop-down opens, and again
    // whenever the track changes while it is open.
    callback refresh-queue();
    callback open-playing-tab();
    callback open-zen();
    // The header launcher pills, same six doors Cinema and Focused open.
    callback open-stream();
    callback open-youtube();
    callback open-download();
    callback open-genesis();
    callback random-radio();
    callback open-livetv();

    // ── Geometry (spec §Geometry) ───────────────────────────────────────────
    property <length> pad: 28px;
    property <int> rail-n: (root.hc-player ? 1 : 0) + (root.hc-finances ? 1 : 0)
        + (root.hc-transfer ? 1 : 0) + (root.hc-library ? 1 : 0);
    // The rail keeps its width until every block is off, then it disappears and
    // the feed takes the whole page.
    property <length> rail-w: root.rail-n > 0 ? 396px : 0px;
    // One header row tall: the filter chips went to the floating bar at the
    // bottom, so the header is Cinema's single 34 px line and nothing else.
    property <length> head-h: 74px;
    // The title pill's band, between the header row and the first feed row.
    property <length> title-h: 46px;
    property <length> feed-w: root.width - 2 * root.pad - root.rail-w
        - (root.rail-w > 0px ? root.pad : 0px);
    property <bool> fin-late: root.fin-dues.length > 0 && root.fin-dues[0].late;
    // Which bar STANDING is reading. −1 means "the newest", which is the month
    // `fin-spent` / `fin-month` already describe.
    property <int> mon-sel: -1;
    property <int> mon-i: root.mon-sel >= 0 && root.mon-sel < root.fin-months.length
        ? root.mon-sel : root.fin-months.length - 1;
    property <string> mon-spent: (root.mon-i >= 0 && root.mon-i < root.fin-month-spends.length)
        ? root.fin-month-spends[root.mon-i] : root.fin-spent;
    property <string> mon-label: (root.mon-i >= 0 && root.mon-i < root.fin-month-labels.length)
        ? root.fin-month-labels[root.mon-i] : root.fin-month;
    // The row is the feed column less the list's 3 % gutters, split 15 : 45 : 25 : 15.
    property <length> row-w: root.feed-w * 0.94;
    property <length> col1: root.row-w * 0.15;
    property <length> col2: root.row-w * 0.45;
    property <length> col3: root.row-w * 0.25;
    property <length> col4: root.row-w * 0.15;
    // The floating filter bar rides over the feed column, clear of the edge.
    property <length> bar-h: 56px;
    // How far the rail's scrollbar sits outside the rail, in the page margin.
    property <length> bar-gap: 14px;
    // Cover side = 30 % of the rail; the two lines and the transport take the 70 —
    // at 40 the five keys had to shrink to fit beside it.
    property <length> pl-art: Math.round(root.rail-w * 0.3 / 1px) * 1px;
    // ── Player state ────────────────────────────────────────────────────────
    // The queue drops DOWN out of the block — the rail is a column, so a panel
    // that pushes the blocks below it costs nothing and needs no popup.
    property <bool> qopen: false;
    changed np-title => { if (root.qopen) { root.refresh-queue(); } }
    // …and on the position too: a radio stream or a repeat keeps the title while
    // the queue underneath it has already moved on.
    changed np-index => { if (root.qopen) { root.refresh-queue(); } }
    // The playing tab, by name and by colour.
    property <string> src-name: root.player-mode == "podcast" ? "PODCASTS"
        : (root.player-mode == "radio" ? "RADIO"
        : (root.player-mode == "book" ? "AUDIOBOOKS"
        : (root.yt-now-video ? "YOUTUBE" : "MY MUSIC")));
    property <color> src-accent: root.player-mode == "podcast" ? #8b5cf6
        : (root.player-mode == "radio" ? Theme.sec-cloud
        : (root.player-mode == "book" ? Theme.sec-books
        : (root.yt-now-video ? #ef4444 : Theme.sec-music)));
    // Volume knob state: the drag moves a local value and a timer flushes it, so
    // a drag is not one mpv IPC command per mouse move.
    property <float> vol-drag: -1;
    property <bool> vol-dirty: false;
    property <float> vol-frac: root.vol-drag >= 0 ? root.vol-drag
        : (root.muted ? 0 : Math.clamp(root.volume / 100, 0.0, 1.0));
    // Three synced lyric lines under the seek bar, the same window Cinema draws.
    property <string> lyr-prev: root.lyrics-active > 0
        ? root.lyrics-rows[root.lyrics-active - 1].text : "";
    property <string> lyr-cur: (root.lyrics-active >= 0
        && root.lyrics-active < root.lyrics-rows.length)
        ? root.lyrics-rows[root.lyrics-active].text : "";
    property <string> lyr-next: (root.lyrics-active >= 0
        && root.lyrics-active + 1 < root.lyrics-rows.length)
        ? root.lyrics-rows[root.lyrics-active + 1].text : "";
    property <bool> lyr-on: root.playing
        && root.lyrics-rows.length > 0 && root.lyrics-active >= 0;

    function name-of(section: string) -> string {
        section == "photos" ? "Photos"
            : section == "videos" ? "Videos"
            : section == "music" ? "Music"
            : section == "books" ? "Books"
            : section == "cloud" ? "Clouds"
            : section == "tools" ? "Tools"
            : section == "transfer" ? "Transfers"
            : section == "finances" ? "Finances"
            : "Library"
    }

    function icon-of(section: string) -> image {
        section == "photos" ? Icons.image
            : section == "videos" ? Icons.film
            : section == "music" ? Icons.music
            : section == "books" ? Icons.book-open
            : section == "cloud" ? Icons.cloud
            : section == "tools" ? Icons.wrench
            : section == "transfer" ? Icons.share
            : section == "finances" ? Icons.wallet
            : Icons.info
    }

    function accent-of(section: string) -> color {
        section == "photos" ? Theme.sec-photos
            : section == "videos" ? Theme.sec-videos
            : section == "music" ? Theme.sec-music
            : section == "books" ? Theme.sec-books
            : section == "cloud" ? Theme.sec-cloud
            : section == "tools" ? Theme.sec-tools
            : section == "transfer" ? Theme.sec-transfer
            : section == "finances" ? Theme.sec-finances
            : Theme.brand
    }

    background: Theme.bg;
    clip: true;

    // ── Header ──────────────────────────────────────────────────────────────
    // Cinema's row, unchanged: wordmark, the greeting in a solid pill, then the
    // launcher bar pushed right. The date and the search key are gone — the
    // palette has its own shortcut, and the feed prints its own dates.
    HorizontalLayout {
        x: root.pad; y: 20px; width: root.width - 2 * root.pad; height: 34px;
        spacing: 10px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 22px; height: 22px; horizontal-stretch: 0;
                    y: (parent.height - self.height) / 2;
                    border-radius: Surface.rr(7px, self.width, self.height); clip: true;
                    Image {
                        source: root.logo-choice == 1 ? @image-url("../resources/appicons/sidebar-color.png")
                              : root.logo-choice == 2 ? @image-url("../resources/appicons/sidebar-dark.png")
                              : root.logo-choice == 3 ? @image-url("../resources/appicons/sidebar-white.png")
                              : root.festival        ? @image-url("../resources/appicons/logo_india.png")
                              :                        @image-url("../resources/appicons/sidebar-default.png");
                        image-fit: cover; width: 100%; height: 100%;
                    }
                }
                Text { text: "Tulipix"; color: Theme.text; font-size: 15px; font-weight: 700;
                    vertical-alignment: center; }
            }
        }
        Rectangle {
            horizontal-stretch: 0; y: (parent.height - self.height) / 2;
            width: gw.preferred-width + 26px; height: 26px; border-radius: 13px;
            // Black plate, white ink — the same pill the group captions in the
            // feed wear, inverted.
            background: #000000;
            gw := Text {
                text: root.greeting;
                color: #ffffff; font-size: 11.5px; font-weight: 700;
                width: 100%; height: 100%;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        if root.hc-quick: TopPill { solid: true; label: "Stream"; icon: Icons.monitor-play;
            accent: Theme.sec-videos; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            clicked => { root.open-stream(); } }
        if root.hc-quick: TopPill { solid: true; label: "YouTube"; icon: Icons.play;
            accent: #ef4444; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            clicked => { root.open-youtube(); } }
        if root.hc-quick: TopPill { solid: true; label: "Music D/L"; icon: Icons.download;
            accent: Theme.sec-music; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            clicked => { root.open-download(); } }
        if root.hc-quick: TopPill { solid: true; label: "Genesis"; icon: Icons.sparkles;
            accent: Theme.sec-books; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            clicked => { root.open-genesis(); } }
        if root.hc-quick: TopPill { solid: true; label: "Radio"; icon: Icons.radio;
            accent: Theme.brand; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            clicked => { root.random-radio(); } }
        if root.hc-quick: TopPill { solid: true; label: "Live TV"; icon: Icons.tv;
            accent: Theme.sec-cloud; horizontal-stretch: 0;
            y: (parent.height - self.height) / 2;
            clicked => { root.open-livetv(); } }
    }

    // ── Feed title ──────────────────────────────────────────────────────────
    // Names the column the way the rail's captions name their blocks. Text-width
    // pill, centred over the feed, white plate and black ink — the same marker
    // the day captions inside the feed wear.
    Rectangle {
        y: root.head-h;
        width: ftit.preferred-width + 34px; height: 32px;
        x: root.pad + (root.feed-w - self.width) / 2;
        border-radius: Surface.rr(16px, self.width, self.height);
        background: #ffffff;
        ftit := Text {
            text: "Tulipix : Events Timeline";
            color: #000000; font-size: 17px; font-weight: 800; letter-spacing: -0.2px;
            width: 100%; height: 100%;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }

    // ── Feed ────────────────────────────────────────────────────────────────
    Rectangle {
        x: root.pad; y: root.head-h + root.title-h;
        width: root.feed-w; height: root.height - root.head-h - root.title-h - root.pad;
        background: transparent;
        clip: true;

        // Empty is a state with something to say, not a blank column.
        if root.events.length == 0: VerticalLayout {
            alignment: start; spacing: 8px;
            Rectangle { height: 40px; }
            Text { text: "Nothing recorded yet"; color: Theme.text; font-size: 17px;
                font-weight: 700; }
            Text {
                text: "Play something, import a folder, or send a file — this column is "
                    + "the record of what the app did.";
                color: Theme.text-dim; font-size: 12px; wrap: word-wrap;
            }
        }

        // The feed's own bar lives to the LEFT of the column, in the page margin
        // — `SideScroll` drives the view, whose built-in right-hand bar is off.
        if root.events.length > 0: Rectangle {
            width: 100%; height: 100%; background: transparent;
            SideScroll {
                x: -18px; y: 0; height: 100%;
                viewport-h: fsv.viewport-height; visible-h: fsv.visible-height;
                pos <=> fsv.viewport-y;
            }
        fsv := ScrollView {
            width: 100%; height: 100%;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            // Every page opens at the top: SideScroll.pos starts at 0 and the
            // two-way binding carries that into the view (ui-scroll-start-top).
            VerticalLayout {
                // The 3 % a side is the LIST's, so the row plates themselves get
                // narrower — inside the row it only moved the text and left the
                // outline stretched edge to edge. Off `feed-w`, never
                // `parent.width`: a layout whose padding reads its own parent's
                // width is a binding loop (padding → layoutinfo → min-width).
                padding-left: root.feed-w * 0.03;
                padding-right: root.feed-w * 0.03;
                spacing: 0; alignment: start;
                if root.feed-note != "": Rectangle {
                    height: 34px;
                    Text { text: root.feed-note; color: Theme.text-dim; font-size: 11px;
                        vertical-alignment: center; }
                }
                for e[i] in root.events: Rectangle {
                    height: (e.head ? 34px : 0px) + 70px;
                    background: transparent;
                    VerticalLayout {
                        spacing: 0;
                        // Group caption, as a solid white pill with black ink —
                        // the day is a marker, not another dim line. Zero-height
                        // when this row continues the previous group: a repeater
                        // with an `if` inside is the slint#6426 shape.
                        Rectangle {
                            height: e.head ? 34px : 0px;
                            opacity: e.head ? 1.0 : 0.0;
                            Rectangle {
                                // Centred over the column: the day is a divider
                                // for the whole feed, not a label on its left edge.
                                x: (parent.width - self.width) / 2;
                                y: parent.height - self.height - 9px;
                                width: gcap.preferred-width + 22px; height: 20px;
                                border-radius: 10px;
                                background: #ffffff;
                                gcap := Text {
                                    text: e.group; color: #000000;
                                    font-size: 9.5px; font-weight: 800; letter-spacing: 1.5px;
                                    width: 100%; height: 100%;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                        }
                        // The row wears its own section's colour, at an alpha that
                        // reads as a tint on either theme rather than a block.
                        row := Rectangle {
                            property <color> tint: e.alarm ? Theme.error : root.accent-of(e.section);
                            property <float> wash: rt.has-hover
                                ? (Theme.dark ? 0.30 : 0.22)
                                : (Theme.dark ? 0.16 : 0.11);
                            // Mixed into the page colour rather than laid over it
                            // with alpha, so the fill is a solid the dot's ring can
                            // borrow — and it lands right on either theme.
                            property <color> fill: Theme.bg.mix(self.tint, 1.0 - self.wash);
                            height: 66px;
                            background: self.fill;
                            border-radius: 12px;
                            animate background { duration: 110ms; easing: ease-out; }
                            rt := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-section(e.section); }
                            }
                            // Four columns, 15 : 45 : 25 : 15 of the row — the
                            // feed reads as a table instead of as a queue of
                            // free-floating parts, and nothing lands on top of
                            // anything else. Widths come off `row-w`, a root
                            // property: a child sizing itself from its own
                            // layout's width is the binding loop the compiler
                            // catches (width → layoutinfo → min-width → width).
                            HorizontalLayout {
                                padding-left: 0px; padding-right: 0px; spacing: 0;
                                // ── 1 · when ──────────────────────────────────
                                // Clock over date, centred, and the timeline's own
                                // divider down the column's right edge. It is the
                                // only column that carries one.
                                Rectangle {
                                    width: root.col1; horizontal-stretch: 0;
                                    background: transparent;
                                    // The line runs the full row height so
                                    // consecutive rows join; the last row has no
                                    // tail to draw.
                                    Rectangle {
                                        width: 1px; height: parent.height;
                                        x: parent.width - 13px;
                                        background: Theme.outline;
                                        opacity: i == root.events.length - 1 ? 0.0 : 1.0;
                                    }
                                    Rectangle {
                                        width: 9px; height: 9px; border-radius: 5px;
                                        x: parent.width - 17px;
                                        y: (parent.height - self.height) / 2;
                                        background: e.alarm ? Theme.error : root.accent-of(e.section);
                                        // Ring in the ROW's own fill, so the dot
                                        // sits on the line rather than being
                                        // crossed by it — page colour would have
                                        // punched a hole in the tinted row.
                                        border-width: 4px;
                                        border-color: row.fill;
                                    }
                                    VerticalLayout {
                                        width: parent.width - 30px;
                                        alignment: center; spacing: 2px;
                                        Text {
                                            text: e.at; color: Theme.text; font-size: 12px;
                                            font-weight: 600; horizontal-alignment: center;
                                        }
                                        Text {
                                            text: e.day; color: Theme.text-dim; font-size: 9.5px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                                // ── 2 · what ──────────────────────────────────
                                // The only left-aligned column.
                                Rectangle {
                                    width: root.col2; horizontal-stretch: 0;
                                    background: transparent;
                                    VerticalLayout {
                                        x: 12px; width: parent.width - 20px;
                                        alignment: center; spacing: 3px;
                                        Text {
                                            // Collapsed runs already read as counts
                                            // ("34 photos added") — the fold happens
                                            // in Rust, where the plural is decided.
                                            text: e.title;
                                            color: Theme.text; font-size: 13px; font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text { text: e.sub; color: Theme.text-dim;
                                            font-size: 10.5px; overflow: elide; }
                                    }
                                }
                                // ── 3 · the things you can do with it ─────────
                                // Thumbnails and the action pill, centred.
                                Rectangle {
                                    width: root.col3; horizontal-stretch: 0;
                                    background: transparent; clip: true;
                                    HorizontalLayout {
                                        width: 100%; height: 100%;
                                        spacing: 6px; alignment: center;
                                        Rectangle {
                                            width: e.t1.width > 0 ? 54px : 0px; height: 40px;
                                            clip: true; horizontal-stretch: 0;
                                            border-radius: 6px; background: Theme.panel-2;
                                            y: (parent.height - self.height) / 2;
                                            if e.t1.width > 0: Image { source: e.t1;
                                                image-fit: cover; width: 100%; height: 100%; }
                                        }
                                        Rectangle {
                                            width: e.t2.width > 0 ? 54px : 0px; height: 40px;
                                            clip: true; horizontal-stretch: 0;
                                            border-radius: 6px; background: Theme.panel-2;
                                            y: (parent.height - self.height) / 2;
                                            if e.t2.width > 0: Image { source: e.t2;
                                                image-fit: cover; width: 100%; height: 100%; }
                                        }
                                        Rectangle {
                                            width: e.t3.width > 0 ? 54px : 0px; height: 40px;
                                            clip: true; horizontal-stretch: 0;
                                            border-radius: 6px; background: Theme.panel-2;
                                            y: (parent.height - self.height) / 2;
                                            if e.t3.width > 0: Image { source: e.t3;
                                                image-fit: cover; width: 100%; height: 100%; }
                                        }
                                        if e.action != "": ActionPill {
                                            label: e.action; alarm: e.alarm;
                                            accent: root.accent-of(e.section);
                                            horizontal-stretch: 0;
                                            y: (parent.height - self.height) / 2;
                                            clicked => { root.event-action(e); }
                                        }
                                    }
                                }
                                // ── 4 · where it came from ────────────────────
                                // The glyph at rest; hovering the row widens it
                                // into a named pill. One element, so the name can
                                // never land on top of the icon it names.
                                Rectangle {
                                    width: root.col4; horizontal-stretch: 0;
                                    background: transparent; clip: true;
                                    Rectangle {
                                        height: 34px;
                                        width: rt.has-hover
                                            ? Math.min(parent.width - 8px, snam.preferred-width + 52px)
                                            : 34px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: Surface.rr(11px, self.width, self.height);
                                        background: rt.has-hover
                                            ? row.tint : row.tint.with-alpha(Theme.dark ? 0.30 : 0.20);
                                        animate width, background { duration: 140ms; easing: ease-out; }
                                        HorizontalLayout {
                                            // No spacing at rest: the empty label
                                            // still costs a gap, which pushed the
                                            // lone icon off the pill's centre.
                                            spacing: rt.has-hover ? 6px : 0px;
                                            alignment: center;
                                            AppIcon {
                                                source: root.icon-of(e.section);
                                                tint: rt.has-hover ? #ffffff : row.tint;
                                                width: 16px; height: parent.height;
                                                horizontal-stretch: 0;
                                            }
                                            snam := Text {
                                                text: rt.has-hover ? root.name-of(e.section) : "";
                                                color: #ffffff; font-size: 10px; font-weight: 700;
                                                letter-spacing: 0.4px; wrap: no-wrap;
                                                vertical-alignment: center; horizontal-stretch: 0;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        // Filled rows need air between them, not a hairline.
                        Rectangle { height: 4px; }
                    }
                }
                // The floating bar hovers over the last rows, so the column ends
                // with its own height plus a gap.
                Rectangle { height: root.bar-h + 26px; }
            }
        }
        }
    }

    // ── Floating filter bar ─────────────────────────────────────────────────
    // The chips left the header for the bottom of the feed column, where a hand
    // already is: one raised container, centred, four keys inside it.
    Rectangle {
        width: Math.min(root.feed-w, bar.preferred-width + 20px);
        x: root.pad + (root.feed-w - self.width) / 2;
        y: root.height - root.pad - root.bar-h;
        height: root.bar-h;
        border-radius: Surface.rr(root.bar-h / 2, self.width, self.height);
        background: Theme.dark ? #14141ceb : #ffffffee;
        border-width: 1px; border-color: Theme.glass-border;
        drop-shadow-blur: 26px;
        drop-shadow-color: Theme.dark ? #00000099 : #0000002e;
        drop-shadow-offset-y: 6px;
        bar := HorizontalLayout {
            padding-left: 10px; padding-right: 10px; spacing: 2px; alignment: center;
            FeedChip { label: "Everything"; icon: Icons.layout-grid; accent: Theme.brand;
                active: root.filter == "all"; horizontal-stretch: 0;
                y: (parent.height - self.height) / 2;
                clicked => { root.set-filter("all"); } }
            if root.hc-photos || root.hc-videos || root.hc-music || root.hc-books: FeedChip {
                label: "Media"; icon: Icons.film; accent: Theme.sec-videos;
                active: root.filter == "media"; horizontal-stretch: 0;
                y: (parent.height - self.height) / 2;
                clicked => { root.set-filter("media"); } }
            if root.hc-finances: FeedChip {
                label: "Money"; icon: Icons.wallet; accent: Theme.sec-finances;
                active: root.filter == "money"; horizontal-stretch: 0;
                y: (parent.height - self.height) / 2;
                clicked => { root.set-filter("money"); } }
            if root.hc-transfer || root.hc-cloud || root.hc-tools: FeedChip {
                label: "Transfers"; icon: Icons.share; accent: Theme.sec-transfer;
                active: root.filter == "devices"; horizontal-stretch: 0;
                y: (parent.height - self.height) / 2;
                clicked => { root.set-filter("devices"); } }
        }
    }

    // ── Rail ────────────────────────────────────────────────────────────────
    if root.rail-n > 0: Rectangle {
        x: root.width - root.pad - root.rail-w;
        y: root.head-h;
        width: root.rail-w; height: root.height - root.head-h - root.pad;
        background: transparent;
        // The 1 px rule that separates the rail from the feed.
        Rectangle { x: -root.pad + 2px; width: 1px; height: 100%; background: Theme.outline; }
        // Scrolls: the queue drop-down and a long dues list can together outrun a
        // short window, and the rail had no way to reach what fell off the end.
        // …and its bar rides in the gutter to the LEFT of the blocks, drawn by
        // `SideScroll`: a `ScrollView` will only ever put its own bar on the
        // right, where it was cutting the rail's right edge.
        SideScroll {
            x: -root.bar-gap; y: 0; height: 100%;
            viewport-h: rsv.viewport-height; visible-h: rsv.visible-height;
            pos <=> rsv.viewport-y;
        }
        rsv := ScrollView {
        width: 100%; height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        VerticalLayout {
            width: rsv.visible-width;
            spacing: 14px; alignment: start;

            // PLAYER — what is in your ears right now. Cinema's panel, laid out
            // for a 396 px rail instead of a 300 px column: the artwork is a
            // thumbnail beside the title rather than a square above it, and the
            // queue drops DOWN out of the block instead of flipping the cover.
            if root.hc-player: VerticalLayout {
                spacing: 10px;
                // 3 % a side of the rail, so the card is not flush with the
                // blocks around it. Off `rail-w`, never `parent.width` — that
                // reads back into the layout's own width and loops.
                padding-left: root.rail-w * 0.03;
                padding-right: root.rail-w * 0.03;
                // The caption names the TAB the sound comes from, and is the door
                // back to it. Centred, and nothing else on the line — the note
                // said "open tab", which the hover already says.
                Rectangle {
                    height: 26px; vertical-stretch: 0;
                    border-radius: 8px;
                    background: capb.has-hover ? root.src-accent.with-alpha(0.14) : transparent;
                    animate background { duration: 120ms; easing: ease-out; }
                    capb := TouchArea { mouse-cursor: pointer;
                        clicked => { root.open-playing-tab(); } }
                    Text {
                        text: root.src-name; color: root.src-accent;
                        font-size: 10px; font-weight: 700; letter-spacing: 1.5px;
                        width: 100%; height: 100%;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                // 30 : 70 — the cover on the left, and everything about the track
                // on the right: two lines and the five keys, stacked.
                HorizontalLayout {
                    height: root.pl-art; spacing: 12px; alignment: start;
                    // The slot is the ring's box; the cover sits 7 px inside it, so
                    // the breathing outline stands OFF the artwork the way Cinema's
                    // stands off its panel — a border ON the cover looked welded to
                    // it. Slot, not the cover, owns the layout width.
                    Rectangle {
                        property <float> pulse:
                            Math.abs(Math.sin((animation-tick() / 1ms / 620) * 1rad));
                        property <length> inset: 7px;
                        width: root.pl-art; height: root.pl-art;
                        horizontal-stretch: 0;
                        background: transparent;
                        border-radius: Surface.rr(18px, self.width, self.height);
                        border-width: root.playing ? 3px : 0px;
                        border-color: root.np-accent
                            .mix(Theme.dark ? #ffffff : Theme.brand-2, 1.0 - self.pulse)
                            .with-alpha(0.4 + 0.6 * self.pulse);
                        Rectangle {
                            x: parent.inset; y: parent.inset;
                            width: parent.width - 2 * parent.inset;
                            height: parent.height - 2 * parent.inset;
                            clip: true;
                            border-radius: Surface.rr(12px, self.width, self.height);
                            background: root.np-accent.with-alpha(0.2);
                            if root.np-art.width > 0: Image { source: root.np-art;
                                image-fit: cover; width: 100%; height: 100%; }
                            if root.np-art.width == 0: AppIcon { source: Icons.music;
                                tint: root.np-accent; width: 34px; height: 34px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2; }
                        }
                    }
                    VerticalLayout {
                        alignment: center; spacing: 10px;
                        horizontal-stretch: 1; min-width: 0;
                        // Both lines RUN rather than elide — Focused's marquee, so
                        // a long title is readable in a 260 px column.
                        VerticalLayout {
                            spacing: 4px; vertical-stretch: 0;
                            WelMarquee {
                                height: 19px;
                                label: root.np-title == "" ? "Nothing playing" : root.np-title;
                                ink: Theme.text; size: 14px; weight: 800;
                            }
                            WelMarquee {
                                height: 15px;
                                label: root.np-title == "" ? "Press play for a shuffled library"
                                    : root.np-sub;
                                ink: Theme.text-dim; size: 11px; weight: 400;
                            }
                        }
                        // The five. With nothing loaded the middle key starts a
                        // shuffled library, so the block is never a dead control.
                        HorizontalLayout {
                            height: 53px; spacing: 5px; alignment: start; vertical-stretch: 0;
                            CineBtn { icon: Icons.shuffle; lit: root.shuffle; accent: root.np-accent;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.toggle-shuffle(); } }
                            CineBtn { icon: Icons.skip-back; accent: root.np-accent;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.prev(); } }
                            CineBtn { icon: root.playing ? Icons.pause : Icons.play;
                                primary: true; accent: root.np-accent;
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    if (root.np-title == "") { root.shuffle-all(); }
                                    else { root.playpause(); }
                                } }
                            CineBtn { icon: Icons.skip-forward; accent: root.np-accent;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.next(); } }
                            CineBtn { icon: root.repeat == "one" ? Icons.repeat-1 : Icons.repeat;
                                lit: root.repeat != "off"; accent: root.np-accent;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.cycle-repeat(); } }
                        }
                    }
                }
                // Seek bar with both times riding inside it. Click to jump; NOT
                // `moved` — every move event would be one more mpv IPC command.
                Rectangle {
                    height: 22px; border-radius: 11px;
                    background: Theme.text.with-alpha(0.13);
                    border-width: 1px; border-color: Theme.text.with-alpha(0.22);
                    clip: true;
                    Rectangle {
                        x: 0; height: 100%; border-radius: 11px;
                        width: parent.width
                            * Math.clamp(root.dur > 0 ? root.pos / root.dur : 0, 0.0, 1.0);
                        background: Theme.dark
                            ? @linear-gradient(90deg, root.np-accent 0%,
                                root.np-accent.brighter(0.45) 55%, #ffffff 100%)
                            : @linear-gradient(90deg, root.np-accent 0%, Theme.brand 100%);
                    }
                    Text { x: 10px; y: (parent.height - self.height) / 2;
                        text: root.pos-label;
                        color: (root.dur > 0 && root.pos / root.dur > 0.14)
                            ? #ffffff : Theme.text-dim;
                        font-size: 10px; font-weight: 700; }
                    Text { x: parent.width - self.width - 10px;
                        y: (parent.height - self.height) / 2;
                        text: root.dur-label; color: Theme.text-dim;
                        font-size: 10px; font-weight: 700; }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.seek(root.dur * Math.clamp(self.mouse-x / self.width, 0.0, 1.0));
                        }
                    }
                }
                // Three lyric lines, and only while there is a synced lyric to
                // show — an empty band under the seek bar was dead space.
                if root.lyr-on: VerticalLayout {
                    spacing: 2px;
                    Text { text: root.lyr-prev; color: Theme.text-dim.with-alpha(0.55);
                        font-size: 10.5px; height: 15px; horizontal-alignment: center;
                        overflow: elide; }
                    Text { text: root.lyr-cur; color: root.np-accent;
                        font-size: 13px; font-weight: 700; height: 19px;
                        horizontal-alignment: center; overflow: elide; }
                    Text { text: root.lyr-next; color: Theme.text-dim.with-alpha(0.55);
                        font-size: 10.5px; height: 15px; horizontal-alignment: center;
                        overflow: elide; }
                }
                // Queue, mute, the volume track, and Zen.
                HorizontalLayout {
                    height: 32px; spacing: 8px;
                    CineBtn { icon: Icons.list-music; accent: root.np-accent;
                        lit: root.qopen;
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            root.qopen = !root.qopen;
                            if (root.qopen) { root.refresh-queue(); }
                        } }
                    CineBtn { icon: root.muted ? Icons.volume-x : Icons.volume;
                        accent: root.np-accent;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.toggle-mute(); } }
                    Rectangle {
                        horizontal-stretch: 1; background: transparent;
                        Rectangle {
                            x: 8px; y: (parent.height - self.height) / 2;
                            width: Math.max(0px, parent.width - 16px);
                            height: 12px; border-radius: 6px;
                            background: Theme.text.with-alpha(0.13);
                            border-width: 1px; border-color: Theme.text.with-alpha(0.22);
                            Rectangle {
                                x: 0; height: 100%; border-radius: 6px;
                                width: parent.width * root.vol-frac;
                                background: Theme.dark
                                    ? @linear-gradient(90deg, root.np-accent 0%,
                                        root.np-accent.brighter(0.45) 100%)
                                    : @linear-gradient(90deg, root.np-accent 0%, Theme.brand 100%);
                            }
                            Rectangle {
                                width: 16px; height: 16px; border-radius: 8px;
                                x: Math.clamp(parent.width * root.vol-frac - 8px,
                                    0px, Math.max(0px, parent.width - 16px));
                                y: (parent.height - self.height) / 2;
                                background: #ffffff;
                                border-width: 2px; border-color: root.np-accent;
                            }
                        }
                        vol := TouchArea {
                            x: 8px; width: Math.max(0px, parent.width - 16px);
                            mouse-cursor: pointer;
                            property <bool> dragged: false;
                            moved => {
                                if (self.pressed) {
                                    self.dragged = true;
                                    root.vol-drag = Math.clamp(self.mouse-x / self.width, 0.0, 1.0);
                                    root.vol-dirty = true;
                                }
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) { self.dragged = false; }
                                if (e.kind == PointerEventKind.up) {
                                    if (self.dragged && root.vol-drag >= 0) {
                                        root.set-volume(100 * root.vol-drag);
                                    }
                                    root.vol-drag = -1;
                                    root.vol-dirty = false;
                                }
                            }
                            clicked => {
                                if (!self.dragged) {
                                    root.set-volume(100 * Math.clamp(self.mouse-x / self.width, 0.0, 1.0));
                                }
                            }
                        }
                        Timer {
                            interval: 90ms; running: root.vol-dirty;
                            triggered => {
                                if (root.vol-drag >= 0) { root.set-volume(100 * root.vol-drag); }
                                root.vol-dirty = false;
                            }
                        }
                    }
                    CineBtn { icon: Icons.maximize; accent: root.np-accent;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.open-zen(); } }
                }
                // The drop-down. It pushes the blocks under it down rather than
                // covering them — the rail is a column, and a column has room.
                if root.qopen: Rectangle {
                    height: 210px;
                    border-radius: Surface.rr(12px, self.width, self.height);
                    background: Theme.dark ? #0c0c14b3 : #ffffffcc;
                    border-width: 1px; border-color: Theme.glass-border;
                    VerticalLayout {
                        padding: 10px; spacing: 6px;
                        HorizontalLayout {
                            height: 16px; spacing: 8px; vertical-stretch: 0;
                            Text { text: "Up next"; color: Theme.text;
                                font-size: 12px; font-weight: 700;
                                horizontal-stretch: 1; vertical-alignment: center; }
                            Text { text: root.queue-rows.length + " tracks";
                                color: Theme.text-dim; font-size: 10px;
                                horizontal-stretch: 0; vertical-alignment: center; }
                        }
                        Text {
                            text: root.queue-rows.length == 0
                                ? "The queue is empty — press play and it fills up." : "";
                            color: Theme.text-dim; font-size: 10.5px;
                            height: root.queue-rows.length == 0 ? 34px : 0px;
                            vertical-stretch: 0; wrap: word-wrap;
                        }
                        qsv := ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                width: qsv.visible-width; spacing: 2px; alignment: start;
                                for q in root.queue-rows: Rectangle {
                                    // The lit row is the one whose PLAYBACK POSITION
                                    // is playing — not the n-th row.
                                    property <bool> now:
                                        q.index == root.np-index && root.np-index >= 0;
                                    height: 34px;
                                    border-radius: Surface.rr(9px, self.width, self.height);
                                    background: self.now
                                        ? root.np-accent.with-alpha(0.18)
                                        : (qr.has-hover ? Theme.glass-strong : transparent);
                                    qr := TouchArea { mouse-cursor: pointer;
                                        clicked => { root.play-queue(q.index); } }
                                    HorizontalLayout {
                                        padding-left: 5px; padding-right: 7px;
                                        padding-top: 3px; padding-bottom: 3px; spacing: 7px;
                                        Rectangle {
                                            width: 28px; horizontal-stretch: 0;
                                            border-radius: Surface.rr(7px, self.width, self.height);
                                            clip: true;
                                            background: root.np-accent.with-alpha(0.16);
                                            if q.thumb.width > 0: Image { source: q.thumb;
                                                image-fit: cover; width: 100%; height: 100%; }
                                        }
                                        VerticalLayout {
                                            alignment: center; spacing: 1px;
                                            horizontal-stretch: 1; min-width: 0;
                                            Text { text: q.title; color: Theme.text;
                                                font-size: 11px; overflow: elide; }
                                            Text { text: q.artist; color: Theme.text-dim;
                                                font-size: 9px; overflow: elide; }
                                        }
                                        Text { text: q.duration; color: Theme.text-dim;
                                            font-size: 9px; horizontal-stretch: 0;
                                            vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // STANDING — the money that is true regardless of today's feed.
            if root.hc-finances: VerticalLayout {
                spacing: 8px;
                // The caption names whichever month the bars are on, not always
                // this one.
                RailCap { label: "STANDING"; accent: Theme.sec-finances;
                    note: root.mon-label; }
                HorizontalLayout {
                    height: 46px; spacing: 10px;
                    Text {
                        // The number IS the block — liquid was a second figure
                        // competing with it, and a figure Home cannot act on.
                        text: root.mon-spent == "" ? "—" : root.mon-spent;
                        color: root.fin-late ? Theme.error : Theme.text;
                        font-size: 34px; font-weight: 800; letter-spacing: -1.2px;
                        vertical-alignment: center; horizontal-stretch: 0;
                    }
                    Text {
                        text: "spent";
                        color: Theme.text-dim; font-size: 11px;
                        vertical-alignment: bottom; horizontal-stretch: 1;
                    }
                }
                // Twelve months, and every one of them is a key: picking a bar
                // swaps the figure and the caption above it. The bar's own hit
                // box is the full column height, not the drawn height — a lean
                // month is 2 px tall and would be unclickable otherwise.
                HorizontalLayout {
                    height: 34px; spacing: 3px;
                    for m[i] in root.fin-months: Rectangle {
                        background: transparent;
                        Rectangle {
                            width: 100%;
                            y: parent.height - self.height;
                            height: Math.max(2px, parent.height * Math.max(0.04, m));
                            border-radius: 2px;
                            background: i == root.mon-sel
                                ? Theme.sec-finances
                                : (mb.has-hover ? Theme.sec-finances.with-alpha(0.6)
                                                : Theme.sec-finances.with-alpha(0.32));
                            animate background { duration: 110ms; easing: ease-out; }
                        }
                        mb := TouchArea { mouse-cursor: pointer;
                            clicked => { root.mon-sel = i; } }
                    }
                }
                VerticalLayout {
                    spacing: 0;
                    for d in root.fin-dues: HorizontalLayout {
                        // Right padding, so the date never runs under the rail's
                        // own right edge.
                        height: 28px; spacing: 8px; padding-right: 4px;
                        Rectangle {
                            width: 6px; height: 6px; border-radius: 3px; horizontal-stretch: 0;
                            y: (parent.height - self.height) / 2;
                            background: d.late ? Theme.error : Theme.warn;
                        }
                        Text { text: d.name; color: Theme.text; font-size: 11.5px;
                            vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        Text { text: d.amount; color: Theme.text; font-size: 11.5px;
                            font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
                        // 76 px: DD-MM-YY needs more than the 56 the old
                        // "in 3 days" wording did, and it was clipping.
                        Text { text: d.when; color: d.late ? Theme.error : Theme.text-dim;
                            font-size: 10px; vertical-alignment: center; width: 76px;
                            horizontal-alignment: right; horizontal-stretch: 0; }
                    }
                }
            }

            // TRANSFERS — a door while the section is closed (the server only binds
            // while Transfer is open), so it offers the action and the inbox.
            if root.hc-transfer: VerticalLayout {
                spacing: 8px;
                RailCap { label: "TRANSFERS"; accent: Theme.sec-transfer; note: "local network"; }
                HorizontalLayout {
                    height: 34px; spacing: 10px; alignment: start;
                    Rectangle {
                        width: 134px; height: 34px; border-radius: 17px; horizontal-stretch: 0;
                        background: @linear-gradient(140deg, Theme.transfer-accent,
                            Theme.transfer-accent-2);
                        sh := TouchArea { mouse-cursor: pointer; clicked => { root.start-sharing(); } }
                        HorizontalLayout {
                            spacing: 7px; alignment: center;
                            AppIcon { source: Icons.zap; tint: #231000; width: 14px; height: 14px;
                                y: (parent.height - self.height) / 2; }
                            Text { text: "Start sharing"; color: #231000; font-size: 11.5px;
                                font-weight: 700; vertical-alignment: center; }
                        }
                    }
                    Text {
                        text: root.transfer-inbox == "" ? "Inbox not set yet"
                            : "Inbox " + root.transfer-inbox;
                        color: Theme.text-dim; font-size: 10.5px;
                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    }
                }
            }

            // LIBRARY — the counter table.
            if root.hc-library: VerticalLayout {
                spacing: 6px;
                RailCap { label: "LIBRARY"; accent: Theme.sec-photos; note: root.library-line; }
                // All eight sections, not four: the table is the rail's map of
                // the app, and Clouds, Tools and Finances were missing from it.
                // The value is a string so the last three can print what they
                // actually count.
                for r in [
                    { label: "Photos", value: root.stats.photos + "", section: "photos",
                      tint: Theme.sec-photos },
                    { label: "Videos", value: root.stats.videos + "", section: "videos",
                      tint: Theme.sec-videos },
                    { label: "Tracks", value: root.stats.songs + "", section: "music",
                      tint: Theme.sec-music },
                    { label: "Books", value: root.stats.books + "", section: "books",
                      tint: Theme.sec-books },
                    { label: "Clouds", value: root.stats.cloud-remotes + "", section: "cloud",
                      tint: Theme.sec-cloud },
                    { label: "Tools", value: root.tool-count + "", section: "tools",
                      tint: Theme.sec-tools },
                    { label: "Finances", value: root.fin-spent == "" ? "—" : root.fin-spent,
                      section: "finances", tint: Theme.sec-finances },
                ]: Rectangle {
                    height: 26px;
                    background: lt.has-hover ? Theme.glass : transparent;
                    border-radius: 6px;
                    lt := TouchArea { mouse-cursor: pointer;
                        clicked => { root.open-section(r.section); } }
                    HorizontalLayout {
                        padding-left: 4px; padding-right: 4px; spacing: 8px;
                        Rectangle { width: 5px; height: 5px; border-radius: 3px;
                            horizontal-stretch: 0; y: (parent.height - self.height) / 2;
                            background: r.tint; }
                        Text { text: r.label; color: Theme.text-dim; font-size: 11.5px;
                            vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: r.value; color: Theme.text; font-size: 11.5px;
                            font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
                    }
                }
            }

            // NEXT is gone: STANDING already prints the dues it listed, and the
            // rest was progress the feed reports as it happens.
            Rectangle { height: 16px; }
        }
        }
    }
}
