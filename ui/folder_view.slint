import { Theme } from "tokens.slint";
import { Surface, Rim, Skin } from "surface.slint";

export enum FolderViewMode { library, folders, timeline }

export component ViewModeSwitcher inherits Rectangle {
    in-out property <FolderViewMode> mode: FolderViewMode.library;
    callback changed(FolderViewMode);
    height: 28px;
    border-radius: Surface.r(8px);
    background: Surface.body(Theme.panel-2);
    border-color: Surface.hairline; border-width: 1px;
    HorizontalLayout {
        padding: 3px; spacing: 3px;
        for entry in [
            { label: "Library", v: FolderViewMode.library },
            { label: "Folders", v: FolderViewMode.folders },
            { label: "Timeline", v: FolderViewMode.timeline },
        ]: Rectangle {
            horizontal-stretch: 1;
            border-radius: Surface.r(6px);
            background: mode == entry.v ? Theme.brand : transparent;
            TouchArea {
                clicked => { root.mode = entry.v; root.changed(entry.v); }
            }
            Text {
                text: entry.label;
                color: mode == entry.v ? #ffffff : Theme.text-dim;
                font-size: 11px; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}
